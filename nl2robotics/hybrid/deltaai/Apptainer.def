Bootstrap: docker
From: openmodelica/openmodelica:v1.27.0-ompython

%labels
    org.opencontainers.image.title nl2robotics-newton-deltaai
    org.opencontainers.image.version 0.1
    nl2robotics.newton.version 1.5.0
    nl2robotics.fmpy.version 0.3.29

%post
    apt-get update
    DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
        ca-certificates python3 python3-pip
    python3 -m pip install --no-cache-dir \
        FMPy==0.3.29 \
        "newton[sim,importers]==1.5.0" \
        newton-usd-schemas==0.5.0 \
        warp-lang==1.16.0 \
        usd-core==26.3 \
        mujoco==3.11.0 \
        mujoco-warp==3.11.0
    rm -rf /var/lib/apt/lists/*

%environment
    export PYTHONNOUSERSITE=1
    export PYTHONDONTWRITEBYTECODE=1

%test
    python3 -c "import fmpy, newton, warp; assert newton.__version__ == '1.5.0'; assert warp.__version__ == '1.16.0'"
    python3 -c "from pxr import Usd, UsdPhysics"
    omc --version
