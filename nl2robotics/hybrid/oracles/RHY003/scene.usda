#usda 1.0
(
    defaultPrim = "World"
    kilogramsPerUnit = 1
    metersPerUnit = 1
    timeCodesPerSecond = 100
    upAxis = "Z"
)

def Xform "World" (
    prepend apiSchemas = ["PhysicsArticulationRootAPI"]
)
{
    def PhysicsScene "PhysicsScene"
    {
        vector3f physics:gravityDirection = (0, 0, -1)
        float physics:gravityMagnitude = 9.81
    }

    def Xform "Base"
    {
        def Cube "Collision" (
            prepend apiSchemas = ["PhysicsCollisionAPI"]
        )
        {
            double size = 1
            float3 xformOp:scale = (0.6, 0.25, 0.1)
            uniform token[] xformOpOrder = ["xformOp:scale"]
        }
    }

    def Xform "Carriage" (
        prepend apiSchemas = ["PhysicsMassAPI", "PhysicsRigidBodyAPI"]
    )
    {
        float physics:mass = 3
        bool physics:kinematicEnabled = true
        double3 xformOp:translate = (0, 0, 0.25)
        uniform token[] xformOpOrder = ["xformOp:translate"]

        def Cube "Collision" (
            prepend apiSchemas = ["PhysicsCollisionAPI"]
        )
        {
            double size = 1
            float3 xformOp:scale = (0.2, 0.2, 0.2)
            uniform token[] xformOpOrder = ["xformOp:scale"]
        }
    }

    def PhysicsPrismaticJoint "SlideJoint"
    {
        rel physics:body0 = </World/Base>
        rel physics:body1 = </World/Carriage>
        token physics:axis = "X"
        float physics:lowerLimit = 0
        float physics:upperLimit = 0.8
    }
}
