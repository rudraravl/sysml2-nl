#usda 1.0
(
    defaultPrim = "World"
    kilogramsPerUnit = 1
    metersPerUnit = 1
    timeCodesPerSecond = 100
    upAxis = "Z"
)

def Xform "World"
{
    def PhysicsScene "PhysicsScene"
    {
        vector3f physics:gravityDirection = (0, 0, -1)
        float physics:gravityMagnitude = 0
    }

    def Xform "Base" (
        prepend apiSchemas = ["PhysicsRigidBodyAPI"]
    )
    {
        bool physics:kinematicEnabled = false
        double3 xformOp:translate = (0, 0, 0.8)
        uniform token[] xformOpOrder = ["xformOp:translate"]

        def Cube "Collision" (
            prepend apiSchemas = ["PhysicsCollisionAPI"]
        )
        {
            double size = 1
            float3 xformOp:scale = (0.2, 0.2, 0.1)
            uniform token[] xformOpOrder = ["xformOp:scale"]
        }
    }

    def Xform "Arm" (
        prepend apiSchemas = ["PhysicsMassAPI", "PhysicsRigidBodyAPI"]
    )
    {
        float physics:mass = 2
        bool physics:kinematicEnabled = false
        double3 xformOp:translate = (0, 0, 0.5)
        uniform token[] xformOpOrder = ["xformOp:translate"]

        def Cube "Collision" (
            prepend apiSchemas = ["PhysicsCollisionAPI"]
        )
        {
            double size = 1
            float3 xformOp:scale = (0.12, 0.12, 0.5)
            uniform token[] xformOpOrder = ["xformOp:scale"]
        }
    }

    def Xform "Slider" (
        prepend apiSchemas = ["PhysicsMassAPI", "PhysicsRigidBodyAPI"]
    )
    {
        float physics:mass = 1
        bool physics:kinematicEnabled = false
        double3 xformOp:translate = (0, 0, 0.1)
        uniform token[] xformOpOrder = ["xformOp:translate"]

        def Cube "Collision" (
            prepend apiSchemas = ["PhysicsCollisionAPI"]
        )
        {
            double size = 1
            float3 xformOp:scale = (0.1, 0.1, 0.3)
            uniform token[] xformOpOrder = ["xformOp:scale"]
        }
    }

    def PhysicsFixedJoint "WorldAnchor" (
        prepend apiSchemas = ["PhysicsArticulationRootAPI"]
    )
    {
        rel physics:body0 = </World/Base>
    }

    def PhysicsRevoluteJoint "Shoulder"
    {
        rel physics:body0 = </World/Base>
        rel physics:body1 = </World/Arm>
        token physics:axis = "Y"
        point3f physics:localPos0 = (0, 0, -0.05)
        point3f physics:localPos1 = (0, 0, 0.25)
        quatf physics:localRot0 = (1, 0, 0, 0)
        quatf physics:localRot1 = (1, 0, 0, 0)
        float physics:lowerLimit = -60
        float physics:upperLimit = 60
    }

    def PhysicsPrismaticJoint "Extension"
    {
        rel physics:body0 = </World/Arm>
        rel physics:body1 = </World/Slider>
        token physics:axis = "X"
        point3f physics:localPos0 = (0, 0, -0.25)
        point3f physics:localPos1 = (0, 0, 0.15)
        quatf physics:localRot0 = (1, 0, 0, 0)
        quatf physics:localRot1 = (1, 0, 0, 0)
        float physics:lowerLimit = -0.15
        float physics:upperLimit = 0.15
    }
}
