#usda 1.0
(
    defaultPrim = "World"
    kilogramsPerUnit = 1
    metersPerUnit = 1
    timeCodesPerSecond = 60
    upAxis = "Z"
)

def Xform "World" (
    prepend apiSchemas = ["PhysicsArticulationRootAPI"]
)
{
    def PhysicsScene "PhysicsScene"
    {
        vector3f physics:gravityDirection = (0, 0, -1)
        float physics:gravityMagnitude = 9.81
    }
    def Xform "Rail"
    {
        def Cube "Collision" (
            prepend apiSchemas = ["PhysicsCollisionAPI"]
        )
        {
            double size = 1
            float3 xformOp:scale = (0.8, 0.1, 0.1)
            uniform token[] xformOpOrder = ["xformOp:scale"]
        }
    }
    def Xform "InspectionHead" (
        prepend apiSchemas = ["PhysicsMassAPI", "PhysicsRigidBodyAPI"]
    )
    {
        float physics:mass = 7
        double3 xformOp:translate = (0, 0, 0.35)
        uniform token[] xformOpOrder = ["xformOp:translate"]
        def Cube "Collision" (
            prepend apiSchemas = ["PhysicsCollisionAPI"]
        )
        {
            double size = 1
            float3 xformOp:scale = (0.18, 0.18, 0.18)
            uniform token[] xformOpOrder = ["xformOp:scale"]
        }
    }
    def PhysicsPrismaticJoint "RailJoint"
    {
        rel physics:body0 = </World/Rail>
        rel physics:body1 = </World/InspectionHead>
        token physics:axis = "Y"
        float physics:lowerLimit = -0.2
        float physics:upperLimit = 0.7
    }
}
