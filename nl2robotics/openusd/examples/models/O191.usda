#usda 1.0
(
    defaultPrim = "World"
    kilogramsPerUnit = 1
    metersPerUnit = 1
    timeCodesPerSecond = 240
    upAxis = "Z"
)

def Xform "World" (
    prepend apiSchemas = ["PhysicsArticulationRootAPI"]
)
{
    def PhysicsScene "PhysicsScene"
    {
        vector3f physics:gravityDirection = (0, 0, -1)
        float physics:gravityMagnitude = 9.81
    }
    def Xform "UpperArm" (
        prepend apiSchemas = ["PhysicsMassAPI", "PhysicsRigidBodyAPI"]
    )
    {
        float physics:mass = 2
        double3 xformOp:translate = (0, 0, 0.8)
        uniform token[] xformOpOrder = ["xformOp:translate"]
        def Cube "Collision" (
            prepend apiSchemas = ["PhysicsCollisionAPI"]
        )
        {
            double size = 1
            float3 xformOp:scale = (0.3, 0.3, 0.3)
            uniform token[] xformOpOrder = ["xformOp:scale"]
        }
    }
    def Xform "Forearm" (
        prepend apiSchemas = ["PhysicsMassAPI", "PhysicsRigidBodyAPI"]
    )
    {
        float physics:mass = 1.5
        double3 xformOp:translate = (0, 0, 1.6)
        uniform token[] xformOpOrder = ["xformOp:translate"]
        def Cube "Collision" (
            prepend apiSchemas = ["PhysicsCollisionAPI"]
        )
        {
            double size = 1
            float3 xformOp:scale = (0.3, 0.3, 0.3)
            uniform token[] xformOpOrder = ["xformOp:scale"]
        }
    }
    def PhysicsRevoluteJoint "Shoulder"
    {
        rel physics:body1 = </World/UpperArm>
        token physics:axis = "Y"
        float physics:lowerLimit = -120
        float physics:upperLimit = 102
    }
    def PhysicsRevoluteJoint "Elbow"
    {
        rel physics:body0 = </World/UpperArm>
        rel physics:body1 = </World/Forearm>
        token physics:axis = "Y"
        float physics:lowerLimit = 0
        float physics:upperLimit = 150
    }
}
