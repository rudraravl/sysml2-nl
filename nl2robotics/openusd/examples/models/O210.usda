#usda 1.0
(
    defaultPrim = "World"
    kilogramsPerUnit = 1
    metersPerUnit = 1
    timeCodesPerSecond = 60
    upAxis = "Z"
)

def Xform "World" (
    prepend apiSchemas = ["PhysicsArticulationRootAPI"]
)
{
    def PhysicsScene "PhysicsScene"
    {
        vector3f physics:gravityDirection = (0, 0, -1)
        float physics:gravityMagnitude = 9.81
    }
    def Xform "Base"
    {
        def Cube "Collision" (
            prepend apiSchemas = ["PhysicsCollisionAPI"]
        )
        {
            double size = 1
            float3 xformOp:scale = (0.3, 0.3, 0.3)
            uniform token[] xformOpOrder = ["xformOp:scale"]
        }
    }
    def Xform "Link" (
        prepend apiSchemas = ["PhysicsMassAPI", "PhysicsRigidBodyAPI"]
    )
    {
        float physics:mass = 1.9
        double3 xformOp:translate = (0, 0, 0.7)
        uniform token[] xformOpOrder = ["xformOp:translate"]
        def Cube "Collision" (
            prepend apiSchemas = ["PhysicsCollisionAPI"]
        )
        {
            double size = 1
            float3 xformOp:scale = (0.3, 0.3, 0.3)
            uniform token[] xformOpOrder = ["xformOp:scale"]
        }
    }
    def PhysicsSphericalJoint "Joint"
    {
        rel physics:body0 = </World/Base>
        rel physics:body1 = </World/Link>
        token physics:axis = "Z"
        float physics:coneAngle0Limit = 30
        float physics:coneAngle1Limit = 20
    }
}
