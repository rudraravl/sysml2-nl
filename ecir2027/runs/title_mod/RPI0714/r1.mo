model AirStageTrackF "Fluid-power robotic actuator: pneumatic cylinder trajectory tracking under payload disturbance" / Physical constants constant Real R_air = 287.0 "J/(kg.K) specific gas constant for air"; constant Real T_air = 293.15 "K air temperature (isothermal assumption)"; constant Real g = 9.81 "m/s2 gravitational acceleration"; constant Real pi = 3.14159265358979; / Plant parameters parameter Real m_carriage = 42.0 "kg carriage mass"; parameter Real L_stroke = 0.70 "m cylinder stroke"; parameter Real A1 = 0.0050 "m2 cap-end piston area (larger)"; parameter Real A2 = 0.0030 "m2 rod-end piston area (smaller)"; parameter Real Vd1 = 1.0e-4 "m3 dead volume chamber 1"; parameter Real Vd2 = 1.0e-4 "m3 dead volume chamber 2"; parameter Real b_visc = 250.0 "N.s/m viscous friction coefficient"; parameter Real k_leak = 5.0e-10 "kg/(s.Pa) leakage conductance to atmosphere"; parameter Real k_relief = 1.0e-5 "kg/(s.Pa) relief valve conductance"; parameter Real P_supply = 7.0e5 "Pa supply pressure"; parameter Real P_atm = 1.01325e5 "Pa atmospheric/exhaust pressure"; parameter Real m_dot_max = 0.018 "kg/s maximum valve mass flow rate"; parameter Real F_payload = 319.0 "N payload disturbance step magnitude"; / Control parameters parameter Real Kp_pos = 15000.0 "N/m position feedback gain"; parameter Real Kd_pos = 800.0 "N.s/m velocity feedback gain"; parameter Real Kp_p1 = 1.5e-7 "kg/(s.Pa) pressure feedback gain chamber 1"; parameter Real Kp_p2 = 1.5e-7 "kg/(s.Pa) pressure feedback gain chamber 2"; parameter Real P_nom = 3.0e5 "Pa nominal chamber 2 reference pressure"; / Trajectory parameters parameter Real T_seg1 = 10.0 "s first segment duration"; parameter Real T_seg2 = 10.0 "s second segment duration"; parameter Real x_target1 = 0.35 "m first segment target position"; parameter Real x_target2 = 0.70 "m second segment target position"; parameter Real T_sim = 20.0 "s total simulation duration"; / Dynamic states Real x(start = 0.0, fixed = true) "m carriage position"; Real v(start = 0.0, fixed = true) "m/s carriage velocity"; Real a "m/s2 carriage acceleration"; Real P1(start = 262400.0, fixed = true) "Pa chamber 1 (cap end) pressure"; Real P2(start = 300000.0, fixed = true) "Pa chamber 2 (rod end) pressure"; / Chamber volumes Real V1 "m3 chamber 1 volume"; Real V2 "m3 chamber 2 volume"; / Disturbance Real F_dist "N payload disturbance force (downward)"; / Trajectory references Real x_ref "m reference position"; Real v_ref "m/s reference velocity"; Real a_ref "m/s2 reference acceleration"; / Tracking error Real e_track "m tracking error (reference minus actual)"; Real e_track_abs "m absolute tracking error"; / Control variables Real F_cmd "N commanded net force"; Real P1_ref "Pa reference pressure chamber 1"; Real P2_ref "Pa reference pressure chamber 2"; Real e_p1 "Pa pressure error chamber 1"; Real e_p2 "Pa pressure error chamber 2"; Real m_dot_ff1 "kg/s feedforward mass flow chamber 1"; Real m_dot_ff2 "kg/s feedforward mass flow chamber 2"; Real m_dot_fb1 "kg/s feedback mass flow chamber 1"; Real m_dot_fb2 "kg/s feedback mass flow chamber 2"; Real m_dot_cmd1 "kg/s total commanded mass flow chamber 1"; Real m_dot_cmd2 "kg/s total commanded mass flow chamber 2"; / Valve commands (0 to 1) Real u_fill1 "fill valve command chamber 1"; Real u_exh1 "exhaust valve command chamber 1"; Real u_fill2 "fill valve command chamber 2"; Real u_exh2 "exhaust valve command chamber 2"; / Mass flows Real m_dot_1 "kg/s net mass flow chamber 1 (positive = fill)"; Real m_dot_2 "kg/s net mass flow chamber 2 (positive = fill)"; Real m_dot_supply "kg/s total supply intake flow"; Real m_dot_leak1 "kg/s leakage flow chamber 1"; Real m_dot_leak2 "kg/s leakage flow chamber 2"; Real m_dot_relief1 "kg/s relief valve flow chamber 1"; Real m_dot_relief2 "kg/s relief valve flow chamber 2"; / Verification flags Boolean track_ok "tracking error below 0.014 m after 13 s"; Boolean bounds_ok "all physical bounds satisfied"; Boolean no_nan_inf "no NaN or infinite values"; equation / Chamber volumes as functions of position V1 = Vd1 + A1 * x; V2 = Vd2 + A2 * (L_stroke - x); / Smooth two-segment cosine trajectory (rest-to-rest each segment) if time <= T_seg1 then x_ref = x_target1 * (1.0 - cos(pi * time / T_seg1)) / 2.0; v_ref = x_target1 * (pi / T_seg1) * sin(pi * time / T_seg1) / 2.0; a_ref = x_target1 * (pi / T_seg1) ^ 2 * cos(pi * time / T_seg1) / 2.0; else x_ref = x_target1 + (x_target2 - x_target1) * (1.0 - cos(pi * (time - T_seg1) / T_seg2)) / 2.0; v_ref = (x_target2 - x_target1) * (pi / T_seg2) * sin(pi * (time - T_seg1) / T_seg2) / 2.0; a_ref = (x_target2 - x_target1) * (pi / T_seg2) ^ 2 * cos(pi * (time - T_seg1) / T_seg2) / 2.0; end if; / Payload disturbance: 319 N step during middle third of 20 s (6.667 s to 13.333 s) if time >= T_sim / 3.0 and time <= 2.0 * T_sim / 3.0 then F_dist = F_payload; else F_dist = 0.0; end if; / Tracking error e_track = x_ref - x; e_track_abs = abs(e_track); / Force command: feedforward (reference dynamics, gravity, known disturbance) plus PD position feedback F_cmd = m_carriage * a_ref + b_visc * v_ref + m_carriage * g + F_dist + Kp_pos * (x_ref - x) + Kd_pos * (v_ref - v); / Pressure references (split: chamber 2 nominal, chamber 1 computed from force balance) P2_ref = P_nom; P1_ref = (F_cmd + P2_ref * A2) / A1; / Pressure errors e_p1 = P1_ref - P1; e_p2 = P2_ref - P2; / Feedforward mass flow (isothermal ideal gas, volume-change term: dm/dt = (P*dV + V*dP)/(R*T)) m_dot_ff1 = (P1_ref * A1 * v_ref) / (R_air * T_air); m_dot_ff2 = (-P2_ref * A2 * v_ref) / (R_air * T_air); / Feedback mass flow (proportional on pressure error) m_dot_fb1 = Kp_p1 * e_p1; m_dot_fb2 = Kp_p2 * e_p2; / Total commanded mass flow per chamber m_dot_cmd1 = m_dot_ff1 + m_dot_fb1; m_dot_cmd2 = m_dot_ff2 + m_dot_fb2; / Valve command generation with saturation (independent fill and exhaust) u_fill1 = max(0.0, min(m_dot_cmd1 / m_dot_max, 1.0)); u_exh1 = max(0.0, min(-m_dot_cmd1 / m_dot_max, 1.0)); u_fill2 = max(0.0, min(m_dot_cmd2 / m_dot_max, 1.0)); u_exh2 = max(0.0, min(-m_dot_cmd2 / m_dot_max, 1.0)); / Actual mass flows through proportional valves (linear, saturated at m_dot_max) m_dot_1 = m_dot_max * (u_fill1 - u_exh1); m_dot_2 = m_dot_max * (u_fill2 - u_exh2); / Supply flow (total positive intake from supply manifold) m_dot_supply = m_dot_max * (u_fill1 + u_fill2); / Leakage flows to atmosphere m_dot_leak1 = k_leak * (P1 - P_atm); m_dot_leak2 = k_leak * (P2 - P_atm); / Relief valve flows (open when chamber pressure exceeds supply) m_dot_relief1 = k_relief * max(0.0, P1 - P_supply); m_dot_relief2 = k_relief * max(0.0, P2 - P_supply); / Chamber pressure dynamics (isothermal ideal gas: P*V = m*R*T) / dP/dt = (R*T/V)*(m_dot_net - m_dot_leak - m_dot_relief) - (P/V)*dV/dt der(P1) = (R_air * T_air / V1) * (m_dot_1 - m_dot_leak1 - m_dot_relief1) - (P1 / V1) * A1 * v; der(P2) = (R_air * T_air / V2) * (m_dot_2 - m_dot_leak2 - m_dot_relief2) + (P2 / V2) * A2 * v; / Force balance (upward positive; chamber 1 cap end pushes up, chamber 2 rod end pushes down) a = (P1 * A1 - P2 * A2 - b_visc * v - m_carriage * g - F_dist) / m_carriage; der(x) = v; der(v) = a; / Verification: primary tracking error below 0.014 m after 13 s track_ok = (time < 13.0) or (e_track_abs <= 0.014); / Verification: physical bounds (travel, pressure, flow, acceleration, trajectory-error, relief-valve) bounds_ok = (x >= -0.001) and (x <= L_stroke + 0.001) and (P1 >= 0.0) and (P1 <= P_supply * 1.05) and (P2 >= 0.0) and (P2 <= P_supply * 1.05) and (abs(a) <= 50.0) and (m_dot_supply >= 0.0) and (m_dot_supply <= 2.0 * m_dot_max + 1.0e-9) and (e_track_abs <= 0.10) and (m_dot_relief1 >= 0.0) and (m_dot_relief2 >= 0.0); / Verification: no NaN or infinite physical, control, or estimator values no_nan_inf = (x > -1.0e15) and (x < 1.0e15) and (v > -1.0e15) and (v < 1.0e15) and (a > -1.0e15) and (a < 1.0e15) and (P1 > -1.0e15) and (P1 < 1.0e15) and (P2 > -1.0e15) and (P2 < 1.0e15) and (F_cmd > -1.0e15) and (F_cmd < 1.0e15) and (m_dot_1 > -1.0e15) and (m_dot_1 < 1.0e15) and (m_dot_2 > -1.0e15) and (m_dot_2 < 1.0e15); annotation( experiment(StartTime = 0, StopTime = 20, Tolerance = 1e-6, Interval = 0.002), Documentation(info = "AirStageTrackF: Pneumatic robotic actuator tracking a smooth two-segment position trajectory under payload disturbance. Double-acting cylinder with unequal chamber areas (A1=0.005 m2 cap, A2=0.003 m2 rod), dead volumes, viscous friction, leakage, and relief valves. Independent fill/exhaust proportional valves (max 0.018 kg/s) with feedforward flow control and pressure-position feedback. 319 N payload step during middle third (6.667-13.333 s). 42 kg carriage, 0.70 m stroke, 500 Hz, 20 s.")); end AirStageTrackF;