model SoftGripAvoidE
  "Soft robotic gripper 3-finger reach around fixed cylinder with bounded contact"
  // Finger geometry
  parameter Real L_finger = 0.13 "total finger length [m]";
  parameter Integer nSec = 4 "bending sections per finger";
  parameter Real L_sec = L_finger / nSec "section length [m]";
  parameter Real r_finger = 0.007 "finger cross-section radius [m]";
  parameter Real r_palm = 0.022 "palm radius [m]";
  // Actuator limit
  parameter Real p_max = 105000.0 "chamber pressure bound [Pa-gauge]";
  // Obstacle
  parameter Real mu_obstacle = 0.55 "obstacle friction coefficient";
  parameter Real obs_x = 0.055 "obstacle center x [m]";
  parameter Real obs_y = 0.0 "obstacle center y [m]";
  parameter Real obs_r = 0.011 "obstacle radius [m]";
  // Disturbance
  parameter Real F_dist = 9.6 "lateral tip disturbance [N]";
  // Section dynamics
  parameter Real J_sec = 1.0e-5 "section rotary inertia [kg.m2]";
  parameter Real b_sec = 0.015 "section damping [N.m.s/rad]";
  parameter Real k_sec_nom = 2.0 "nominal section stiffness [N.m/rad]";
  parameter Real k_sec_max = 6.0 "max section stiffness [N.m/rad]";
  parameter Real kp_gain = 8.0e-6 "pressure-to-torque gain [N.m/Pa]";
  // Contact model
  parameter Real k_contact = 600.0 "contact stiffness [N/m]";
  parameter Real c_contact = 2.0 "contact damping [N.s/m]";
  parameter Real eps_dist = 1.0e-6 "distance regularization [m]";
  // Target
  parameter Real target_x = 0.125 "target x [m]";
  parameter Real target_y = 0.070 "target y [m]";
  // Thermal model
  parameter Real T_ref = 293.15 "ambient temperature [K]";
  parameter Real T_max = 333.15 "temperature bound [K]";
  parameter Real C_thermal = 80.0 "thermal capacitance [J/K]";
  parameter Real R_thermal = 8.0 "thermal resistance [K/W]";
  parameter Real k_thermal = 1.5e-5 "pressure heating gain [W/Pa]";
  // Controller
  parameter Real Kp_ctrl = 500000.0 "proportional gain [Pa/m]";
  parameter Real Ki_ctrl = 300000.0 "integral gain [Pa/(m.s)]";
  parameter Real Kc_ctrl = 150.0 "contact feedback gain [Pa/N]";
  parameter Real p_hold2 = 20000.0 "holding pressure finger 2 [Pa]";
  parameter Real p_hold3 = 20000.0 "holding pressure finger 3 [Pa]";
  parameter Real stiff_time = 7.0 "time to engage stiffening [s]";
  // Simulation
  parameter Real Ts = 1.0 / 250.0 "sample period [s]";
  parameter Real t_end = 16.0 "simulation duration [s]";
  parameter Real t_dist_start = t_end / 3.0 "disturbance start [s]";
  parameter Real t_dist_end = 2.0 * t_end / 3.0 "disturbance end [s]";
  // Finger base geometry
  parameter Real base_x1 = r_palm "base x finger 1 [m]";
  parameter Real base_y1 = 0.0 "base y finger 1 [m]";
  parameter Real base_a1 = 0.0 "base angle finger 1 [rad]";
  parameter Real base_x2 = -r_palm * 0.5 "base x finger 2 [m]";
  parameter Real base_y2 = r_palm * 0.86602540378 "base y finger 2 [m]";
  parameter Real base_a2 = 2.09439510239 "base angle finger 2 [rad]";
  parameter Real base_x3 = -r_palm * 0.5 "base x finger 3 [m]";
  parameter Real base_y3 = -r_palm * 0.86602540378 "base y finger 3 [m]";
  parameter Real base_a3 = -2.09439510239 "base angle finger 3 [rad]";
  // Acceptance bounds
  parameter Real F_contact_bound = 25.0 "contact force bound [N]";
  parameter Real def_bound = 1.5 "max section deformation [rad]";
  parameter Real final_err_thresh = 0.036 "final tip error threshold [m]";
  parameter Real final_err_time = 10.4 "time threshold [s]";
  parameter Real clearance_bound = -0.003 "min clearance [m]";
  // States - finger 1
  Real q1_1(start = 0.0) "f1 s1 bend angle [rad]";
  Real q1_2(start = 0.0) "f1 s2 bend angle [rad]";
  Real q1_3(start = 0.0) "f1 s3 bend angle [rad]";
  Real q1_4(start = 0.0) "f1 s4 bend angle [rad]";
  Real w1_1(start = 0.0) "f1 s1 angular velocity [rad/s]";
  Real w1_2(start = 0.0) "f1 s2 angular velocity [rad/s]";
  Real w1_3(start = 0.0) "f1 s3 angular velocity [rad/s]";
  Real w1_4(start = 0.0) "f1 s4 angular velocity [rad/s]";
  // States - finger 2
  Real q2_1(start = 0.0) "f2 s1 bend angle [rad]";
  Real q2_2(start = 0.0) "f2 s2 bend angle [rad]";
  Real q2_3(start = 0.0) "f2 s3 bend angle [rad]";
  Real q2_4(start = 0.0) "f2 s4 bend angle [rad]";
  Real w2_1(start = 0.0) "f2 s1 angular velocity [rad/s]";
  Real w2_2(start = 0.0) "f2 s2 angular velocity [rad/s]";
  Real w2_3(start = 0.0) "f2 s3 angular velocity [rad/s]";
  Real w2_4(start = 0.0) "f2 s4 angular velocity [rad/s]";
  // States - finger 3
  Real q3_1(start = 0.0) "f3 s1 bend angle [rad]";
  Real q3_2(start = 0.0) "f3 s2 bend angle [rad]";
  Real q3_3(start = 0.0) "f3 s3 bend angle [rad]";
  Real q3_4(start = 0.0) "f3 s4 bend angle [rad]";
  Real w3_1(start = 0.0) "f3 s1 angular velocity [rad/s]";
  Real w3_2(start = 0.0) "f3 s2 angular velocity [rad/s]";
  Real w3_3(start = 0.0) "f3 s3 angular velocity [rad/s]";
  Real w3_4(start = 0.0) "f3 s4 angular velocity [rad/s]";
  // Controller states
  Real integ_err(start = 0.0, fixed = true) "integral tracking error [m.s]";
  Real T(start = T_ref, fixed = true) "actuator temperature [K]";
  // Commands
  Real p_cmd1 "chamber pressure command f1 [Pa]";
  Real p_cmd2 "chamber pressure command f2 [Pa]";
  Real p_cmd3 "chamber pressure command f3 [Pa]";
  Real p_sat1 "saturated pressure f1 [Pa]";
  Real p_sat2 "saturated pressure f2 [Pa]";
  Real p_sat3 "saturated pressure f3 [Pa]";
  Real stiff_factor "stiffness schedule factor";
  Real k_sched "scheduled section stiffness [N.m/rad]";
  Real q_des1 "desired section angle f1 [rad]";
  Real q_des2 "desired section angle f2 [rad]";
  Real q_des3 "desired section angle f3 [rad]";
  // Kinematics - finger 1
  Real cum1_1 "cumulative angle f1 j1 [rad]";
  Real cum1_2 "cumulative angle f1 j2 [rad]";
  Real cum1_3 "cumulative angle f1 j3 [rad]";
  Real cum1_4 "cumulative angle f1 j4 [rad]";
  Real cum1_5 "cumulative angle f1 j5 [rad]";
  Real x1_1 "joint x f1 j1 [m]";
  Real x1_2 "joint x f1 j2 [m]";
  Real x1_3 "joint x f1 j3 [m]";
  Real x1_4 "joint x f1 j4 [m]";
  Real x1_5 "joint x f1 j5 [m]";
  Real y1_1 "joint y f1 j1 [m]";
  Real y1_2 "joint y f1 j2 [m]";
  Real y1_3 "joint y f1 j3 [m]";
  Real y1_4 "joint y f1 j4 [m]";
  Real y1_5 "joint y f1 j5 [m]";
  Real smx1_1 "section mid x f1 s1 [m]";
  Real smx1_2 "section mid x f1 s2 [m]";
  Real smx1_3 "section mid x f1 s3 [m]";
  Real smx1_4 "section mid x f1 s4 [m]";
  Real smy1_1 "section mid y f1 s1 [m]";
  Real smy1_2 "section mid y f1 s2 [m]";
  Real smy1_3 "section mid y f1 s3 [m]";
  Real smy1_4 "section mid y f1 s4 [m]";
  // Kinematics - finger 2
  Real cum2_1 "cumulative angle f2 j1 [rad]";
  Real cum2_2 "cumulative angle f2 j2 [rad]";
  Real cum2_3 "cumulative angle f2 j3 [rad]";
  Real cum2_4 "cumulative angle f2 j4 [rad]";
  Real cum2_5 "cumulative angle f2 j5 [rad]";
  Real x2_1 "joint x f2 j1 [m]";
  Real x2_2 "joint x f2 j2 [m]";
  Real x2_3 "joint x f2 j3 [m]";
  Real x2_4 "joint x f2 j4 [m]";
  Real x2_5 "joint x f2 j5 [m]";
  Real y2_1 "joint y f2 j1 [m]";
  Real y2_2 "joint y f2 j2 [m]";
  Real y2_3 "joint y f2 j3 [m]";
  Real y2_4 "joint y f2 j4 [m]";
  Real y2_5 "joint y f2 j5 [m]";
  Real smx2_1 "section mid x f2 s1 [m]";
  Real smx2_2 "section mid x f2 s2 [m]";
  Real smx2_3 "section mid x f2 s3 [m]";
  Real smx2_4 "section mid x f2 s4 [m]";
  Real smy2_1 "section mid y f2 s1 [m]";
  Real smy2_2 "section mid y f2 s2 [m]";
  Real smy2_3 "section mid y f2 s3 [m]";
  Real smy2_4 "section mid y f2 s4 [m]";
  // Kinematics - finger 3
  Real cum3_1 "cumulative angle f3 j1 [rad]";
  Real cum3_2 "cumulative angle f3 j2 [rad]";
  Real cum3_3 "cumulative angle f3 j3 [rad]";
  Real cum3_4 "cumulative angle f3 j4 [rad]";
  Real cum3_5 "cumulative angle f3 j5 [rad]";
  Real x3_1 "joint x f3 j1 [m]";
  Real x3_2 "joint x f3 j2 [m]";
  Real x3_3 "joint x f3 j3 [m]";
  Real x3_4 "joint x f3 j4 [m]";
  Real x3_5 "joint x f3 j5 [m]";
  Real y3_1 "joint y f3 j1 [m]";
  Real y3_2 "joint y f3 j2 [m]";
  Real y3_3 "joint y f3 j3 [m]";
  Real y3_4 "joint y f3 j4 [m]";
  Real y3_5 "joint y f3 j5 [m]";
  Real smx3_1 "section mid x f3 s1 [m]";
  Real smx3_2 "section mid x f3 s2 [m]";
  Real smx3_3 "section mid x f3 s3 [m]";
  Real smx3_4 "section mid x f3 s4 [m]";
  Real smy3_1 "section mid y f3 s1 [m]";
  Real smy3_2 "section mid y f3 s2 [m]";
  Real smy3_3 "section mid y f3 s3 [m]";
  Real smy3_4 "section mid y f3 s4 [m]";
  // Tip positions
  Real tip_x1 "tip x f1 [m]";
  Real tip_y1 "tip y f1 [m]";
  Real tip_x2 "tip x f2 [m]";
  Real tip_y2 "tip y f2 [m]";
  Real tip_x3 "tip x f3 [m]";
  Real tip_y3 "tip y f3 [m]";
  // Contact - finger 1
  Real d_obs1_1 "dist f1 s1 to obstacle [m]";
  Real d_obs1_2 "dist f1 s2 to obstacle [m]";
  Real d_obs1_3 "dist f1 s3 to obstacle [m]";
  Real d_obs1_4 "dist f1 s4 to obstacle [m]";
  Real pen1_1 "penetration f1 s1 [m]";
  Real pen1_2 "penetration f1 s2 [m]";
  Real pen1_3 "penetration f1 s3 [m]";
  Real pen1_4 "penetration f1 s4 [m]";
  Real Fn1_1 "normal contact f1 s1 [N]";
  Real Fn1_2 "normal contact f1 s2 [N]";
  Real Fn1_3 "normal contact f1 s3 [N]";
  Real Fn1_4 "normal contact f1 s4 [N]";
  Real Fc1_1 "contact force f1 s1 [N]";
  Real Fc1_2 "contact force f1 s2 [N]";
  Real Fc1_3 "contact force f1 s3 [N]";
  Real Fc1_4 "contact force f1 s4 [N]";
  // Contact - finger 2
  Real d_obs2_1 "dist f2 s1 to obstacle [m]";
  Real d_obs2_2 "dist f2 s2 to obstacle [m]";
  Real d_obs2_3 "dist f2 s3 to obstacle [m]";
  Real d_obs2_4 "dist f2 s4 to obstacle [m]";
  Real pen2_1 "penetration f2 s1 [m]";
  Real pen2_2 "penetration f2 s2 [m]";
  Real pen2_3 "penetration f2 s3 [m]";
  Real pen2_4 "penetration f2 s4 [m]";
  Real Fn2_1 "normal contact f2 s1 [N]";
  Real Fn2_2 "normal contact f2 s2 [N]";
  Real Fn2_3 "normal contact f2 s3 [N]";
  Real Fn2_4 "normal contact f2 s4 [N]";
  Real Fc2_1 "contact force f2 s1 [N]";
  Real Fc2_2 "contact force f2 s2 [N]";
  Real Fc2_3 "contact force f2 s3 [N]";
  Real Fc2_4 "contact force f2 s4 [N]";
  // Contact - finger 3
  Real d_obs3_1 "dist f3 s1 to obstacle [m]";
  Real d_obs3_2 "dist f3 s2 to obstacle [m]";
  Real d_obs3_3 "dist f3 s3 to obstacle [m]";
  Real d_obs3_4 "dist f3 s4 to obstacle [m]";
  Real pen3_1 "penetration f3 s1 [m]";
  Real pen3_2 "penetration f3 s2 [m]";
  Real pen3_3 "penetration f3 s3 [m]";
  Real pen3_4 "penetration f3 s4 [m]";
  Real Fn3_1 "normal contact f3 s1 [N]";
  Real Fn3_2 "normal contact f3 s2 [N]";
  Real Fn3_3 "normal contact f3 s3 [N]";
  Real Fn3_4 "normal contact f3 s4 [N]";
  Real Fc3_1 "contact force f3 s1 [N]";
  Real Fc3_2 "contact force f3 s2 [N]";
  Real Fc3_3 "contact force f3 s3 [N]";
  Real Fc3_4 "contact force f3 s4 [N]";
  // Totals
  Real F_contact_total "total contact force [N]";
  Real clearance "minimum obstacle clearance [m]";
  Boolean in_contact "contact flag";
  Real F_dist_apply "applied disturbance [N]";
  Real tip_err "primary finger tip error [m]";
  Real thermal_power "heat generation [W]";
  // Torques - finger 1
  Real tau_p1_1 "pressure torque f1 s1 [N.m]";
  Real tau_p1_2 "pressure torque f1 s2 [N.m]";
  Real tau_p1_3 "pressure torque f1 s3 [N.m]";
  Real tau_p1_4 "pressure torque f1 s4 [N.m]";
  Real tau_k1_1 "stiffness torque f1 s1 [N.m]";
  Real tau_k1_2 "stiffness torque f1 s2 [N.m]";
  Real tau_k1_3 "stiffness torque f1 s3 [N.m]";
  Real tau_k1_4 "stiffness torque f1 s4 [N.m]";
  Real tau_c1_1 "contact torque f1 s1 [N.m]";
  Real tau_c1_2 "contact torque f1 s2 [N.m]";
  Real tau_c1_3 "contact torque f1 s3 [N.m]";
  Real tau_c1_4 "contact torque f1 s4 [N.m]";
  Real tau_d1_1 "disturbance torque f1 s1 [N.m]";
  Real tau_d1_2 "disturbance torque f1 s2 [N.m]";
  Real tau_d1_3 "disturbance torque f1 s3 [N.m]";
  Real tau_d1_4 "disturbance torque f1 s4 [N.m]";
  // Torques - finger 2
  Real tau_p2_1 "pressure torque f2 s1 [N.m]";
  Real tau_p2_2 "pressure torque f2 s2 [N.m]";
  Real tau_p2_3 "pressure torque f2 s3 [N.m]";
  Real tau_p2_4 "pressure torque f2 s4 [N.m]";
  Real tau_k2_1 "stiffness torque f2 s1 [N.m]";
  Real tau_k2_2 "stiffness torque f2 s2 [N.m]";
  Real tau_k2_3 "stiffness torque f2 s3 [N.m]";
  Real tau_k2_4 "stiffness torque f2 s4 [N.m]";
  Real tau_c2_1 "contact torque f2 s1 [N.m]";
  Real tau_c2_2 "contact torque f2 s2 [N.m]";
  Real tau_c2_3 "contact torque f2 s3 [N.m]";
  Real tau_c2_4 "contact torque f2 s4 [N.m]";
  // Torques - finger 3
  Real tau_p3_1 "pressure torque f3 s1 [N.m]";
  Real tau_p3_2 "pressure torque f3 s2 [N.m]";
  Real tau_p3_3 "pressure torque f3 s3 [N.m]";
  Real tau_p3_4 "pressure torque f3 s4 [N.m]";
  Real tau_k3_1 "stiffness torque f3 s1 [N.m]";
  Real tau_k3_2 "stiffness torque f3 s2 [N.m]";
  Real tau_k3_3 "stiffness torque f3 s3 [N.m]";
  Real tau_k3_4 "stiffness torque f3 s4 [N.m]";
  Real tau_c3_1 "contact torque f3 s1 [N.m]";
  Real tau_c3_2 "contact torque f3 s2 [N.m]";
  Real tau_c3_3 "contact torque f3 s3 [N.m]";
  Real tau_c3_4 "contact torque f3 s4 [N.m]";
  // Acceptance flags
  Boolean ok_actuator;
  Boolean ok_deformation;
  Boolean ok_contact;
  Boolean ok_temperature;
  Boolean ok_clearance;
  Boolean ok_tip_error;
  Boolean ok_no_nan;
  Boolean ok_all;
  // Temp helpers for clearance min
  Real min_d1 "min dist f1 [m]";
  Real min_d2 "min dist f2 [m]";
  Real min_d3 "min dist f3 [m]";
  Real max_q1 "max abs q f1 [rad]";
  Real max_q2 "max abs q f2 [rad]";
  Real max_q3 "max abs q f3 [rad]";
equation
  // Disturbance
  F_dist_apply = if (time >= t_dist_start and time <= t_dist_end) then F_dist else 0.0;
  // Pressure saturation
  p_sat1 = max(-p_max, min(p_max, p_cmd1));
  p_sat2 = max(-p_max, min(p_max, p_cmd2));
  p_sat3 = max(-p_max, min(p_max, p_cmd3));
  // Controller
  der(integ_err) = target_y - tip_y1;
  p_cmd1 = Kp_ctrl * (target_y - tip_y1) + Ki_ctrl * integ_err - Kc_ctrl * F_contact_total;
  p_cmd2 = p_hold2;
  p_cmd3 = p_hold3;
  // Stiffness scheduling
  stiff_factor = if (time > stiff_time) then 1.0 else 0.0;
  k_sched = k_sec_nom + stiff_factor * (k_sec_max - k_sec_nom);
  q_des1 = kp_gain * p_sat1 / k_sec_nom;
  q_des2 = kp_gain * p_sat2 / k_sec_nom;
  q_des3 = kp_gain * p_sat3 / k_sec_nom;
  // Kinematics - finger 1
  cum1_1 = base_a1;
  x1_1 = base_x1;
  y1_1 = base_y1;
  cum1_2 = cum1_1 + q1_1;
  x1_2 = x1_1 + L_sec * cos(cum1_2);
  y1_2 = y1_1 + L_sec * sin(cum1_2);
  smx1_1 = 0.5 * (x1_1 + x1_2);
  smy1_1 = 0.5 * (y1_1 + y1_2);
  cum1_3 = cum1_2 + q1_2;
  x1_3 = x1_2 + L_sec * cos(cum1_3);
  y1_3 = y1_2 + L_sec * sin(cum1_3);
  smx1_2 = 0.5 * (x1_2 + x1_3);
  smy1_2 = 0.5 * (y1_2 + y1_3);
  cum1_4 = cum1_3 + q1_3;
  x1_4 = x1_3 + L_sec * cos(cum1_4);
  y1_4 = y1_3 + L_sec * sin(cum1_4);
  smx1_3 = 0.5 * (x1_3 + x1_4);
  smy1_3 = 0.5 * (y1_3 + y1_4);
  cum1_5 = cum1_4 + q1_4;
  x1_5 = x1_4 + L_sec * cos(cum1_5);
  y1_5 = y1_4 + L_sec * sin(cum1_5);
  smx1_4 = 0.5 * (x1_4 + x1_5);
  smy1_4 = 0.5 * (y1_4 + y1_5);
  tip_x1 = x1_5;
  tip_y1 = y1_5;
  // Kinematics - finger 2
  cum2_1 = base_a2;
  x2_1 = base_x2;
  y2_1 = base_y2;
  cum2_2 = cum2_1 + q2_1;
  x2_2 = x2_1 + L_sec * cos(cum2_2);
  y2_2 = y2_1 + L_sec * sin(cum2_2);
  smx2_1 = 0.5 * (x2_1 + x2_2);
  smy2_1 = 0.5 * (y2_1 + y2_2);
  cum2_3 = cum2_2 + q2_2;
  x2_3 = x2_2 + L_sec * cos(cum2_3);
  y2_3 = y2_2 + L_sec * sin(cum2_3);
  smx2_2 = 0.5 * (x2_2 + x2_3);
  smy2_2 = 0.5 * (y2_2 + y2_3);
  cum2_4 = cum2_3 + q2_3;
  x2_4 = x2_3 + L_sec * cos(cum2_4);
  y2_4 = y2_3 + L_sec * sin(cum2_4);
  smx2_3 = 0.5 * (x2_3 + x2_4);
  smy2_3 = 0.5 * (y2_3 + y2_4);
  cum2_5 = cum2_4 + q2_4;
  x2_5 = x2_4 + L_sec * cos(cum2_5);
  y2_5 = y2_4 + L_sec * sin(cum2_5);
  smx2_4 = 0.5 * (x2_4 + x2_5);
  smy2_4 = 0.5 * (y2_4 + y2_5);
  tip_x2 = x2_5;
  tip_y2 = y2_5;
  // Kinematics - finger 3
  cum3_1 = base_a3;
  x3_1 = base_x3;
  y3_1 = base_y3;
  cum3_2 = cum3_1 + q3_1;
  x3_2 = x3_1 + L_sec * cos(cum3_2);
  y3_2 = y3_1 + L_sec * sin(cum3_2);
  smx3_1 = 0.5 * (x3_1 + x3_2);
  smy3_1 = 0.5 * (y3_1 + y3_2);
  cum3_3 = cum3_2 + q3_2;
  x3_3 = x3_2 + L_sec * cos(cum3_3);
  y3_3 = y3_2 + L_sec * sin(cum3_3);
  smx3_2 = 0.5 * (x3_2 + x3_3);
  smy3_2 = 0.5 * (y3_2 + y3_3);
  cum3_4 = cum3_3 + q3_3;
  x3_4 = x3_3 + L_sec * cos(cum3_4);
  y3_4 = y3_3 + L_sec * sin(cum3_4);
  smx3_3 = 0.5 * (x3_3 + x3_4);
  smy3_3 = 0.5 * (y3_3 + y3_4);
  cum3_5 = cum3_4 + q3_4;
  x3_5 = x3_4 + L_sec * cos(cum3_5);
  y3_5 = y3_4 + L_sec * sin(cum3_5);
  smx3_4 = 0.5 * (x3_4 + x3_5);
  smy3_4 = 0.5 * (y3_4 + y3_5);
  tip_x3 = x3_5;
  tip_y3 = y3_5;
  // Tip error
  tip_err = sqrt((target_x - tip_x1) * (target_x - tip_x1) + (target_y - tip_y1) * (target_y - tip_y1) + 1.0e-14);
  // Contact finger 1
  d_obs1_1 = sqrt((smx1_1 - obs_x) * (smx1_1 - obs_x) + (smy1_1 - obs_y) * (smy1_1 - obs_y) + eps_dist);
  d_obs1_2 = sqrt((smx1_2 - obs_x) * (smx1_2 - obs_x) + (smy1_2 - obs_y) * (smy1_2 - obs_y) + eps_dist);
  d_obs1_3 = sqrt((smx1_3 - obs_x) * (smx1_3 - obs_x) + (smy1_3 - obs_y) * (smy1_3 - obs_y) + eps_dist);
  d_obs1_4 = sqrt((smx1_4 - obs_x) * (smx1_4 - obs_x) + (smy1_4 - obs_y) * (smy1_4 - obs_y) + eps_dist);
  pen1_1 = max(0.0, (obs_r + r_finger) - d_obs1_1);
  pen1_2 = max(0.0, (obs_r + r_finger) - d_obs1_2);
  pen1_3 = max(0.0, (obs_r + r_finger) - d_obs1_3);
  pen1_4 = max(0.0, (obs_r + r_finger) - d_obs1_4);
  Fn1_1 = k_contact * pen1_1;
  Fn1_2 = k_contact * pen1_2;
  Fn1_3 = k_contact * pen1_3;
  Fn1_4 = k_contact * pen1_4;
  Fc1_1 = Fn1_1 * sqrt(1.0 + mu_obstacle * mu_obstacle);
  Fc1_2 = Fn1_2 * sqrt(1.0 + mu_obstacle * mu_obstacle);
  Fc1_3 = Fn1_3 * sqrt(1.0 + mu_obstacle * mu_obstacle);
  Fc1_4 = Fn1_4 * sqrt(1.0 + mu_obstacle * mu_obstacle);
  // Contact finger 2
  d_obs2_1 = sqrt((smx2_1 - obs_x) * (smx2_1 - obs_x) + (smy2_1 - obs_y) * (smy2_1 - obs_y) + eps_dist);
  d_obs2_2 = sqrt((smx2_2 - obs_x) * (smx2_2 - obs_x) + (smy2_2 - obs_y) * (smy2_2 - obs_y) + eps_dist);
  d_obs2_3 = sqrt((smx2_3 - obs_x) * (smx2_3 - obs_x) + (smy2_3 - obs_y) * (smy2_3 - obs_y) + eps_dist);
  d_obs2_4 = sqrt((smx2_4 - obs_x) * (smx2_4 - obs_x) + (smy2_4 - obs_y) * (smy2_4 - obs_y) + eps_dist);
  pen2_1 = max(0.0, (obs_r + r_finger) - d_obs2_1);
  pen2_2 = max(0.0, (obs_r + r_finger) - d_obs2_2);
  pen2_3 = max(0.0, (obs_r + r_finger) - d_obs2_3);
  pen2_4 = max(0.0, (obs_r + r_finger) - d_obs2_4);
  Fn2_1 = k_contact * pen2_1;
  Fn2_2 = k_contact * pen2_2;
  Fn2_3 = k_contact * pen2_3;
  Fn2_4 = k_contact * pen2_4;
  Fc2_1 = Fn2_1 * sqrt(1.0 + mu_obstacle * mu_obstacle);
  Fc2_2 = Fn2_2 * sqrt(1.0 + mu_obstacle * mu_obstacle);
  Fc2_3 = Fn2_3 * sqrt(1.0 + mu_obstacle * mu_obstacle);
  Fc2_4 = Fn2_4 * sqrt(1.0 + mu_obstacle * mu_obstacle);
  // Contact finger 3
  d_obs3_1 = sqrt((smx3_1 - obs_x) * (smx3_1 - obs_x) + (smy3_1 - obs_y) * (smy3_1 - obs_y) + eps_dist);
  d_obs3_2 = sqrt((smx3_2 - obs_x) * (smx3_2 - obs_x) + (smy3_2 - obs_y) * (smy3_2 - obs_y) + eps_dist);
  d_obs3_3 = sqrt((smx3_3 - obs_x) * (smx3_3 - obs_x) + (smy3_3 - obs_y) * (smy3_3 - obs_y) + eps_dist);
  d_obs3_4 = sqrt((smx3_4 - obs_x) * (smx3_4 - obs_x) + (smy3_4 - obs_y) * (smy3_4 - obs_y) + eps_dist);
  pen3_1 = max(0.0, (obs_r + r_finger) - d_obs3_1);
  pen3_2 = max(0.0, (obs_r + r_finger) - d_obs3_2);
  pen3_3 = max(0.0, (obs_r + r_finger) - d_obs3_3);
  pen3_4 = max(0.0, (obs_r + r_finger) - d_obs3_4);
  Fn3_1 = k_contact * pen3_1;
  Fn3_2 = k_contact * pen3_2;
  Fn3_3 = k_contact * pen3_3;
  Fn3_4 = k_contact * pen3_4;
  Fc3_1 = Fn3_1 * sqrt(1.0 + mu_obstacle * mu_obstacle);
  Fc3_2 = Fn3_2 * sqrt(1.0 + mu_obstacle * mu_obstacle);
  Fc3_3 = Fn3_3 * sqrt(1.0 + mu_obstacle * mu_obstacle);
  Fc3_4 = Fn3_4 * sqrt(1.0 + mu_obstacle * mu_obstacle);
  // Contact totals
  F_contact_total = Fc1_1 + Fc1_2 + Fc1_3 + Fc1_4 + Fc2_1 + Fc2_2 + Fc2_3 + Fc2_4 + Fc3_1 + Fc3_2 + Fc3_3 + Fc3_4;
  min_d1 = min(min(d_obs1_1, d_obs1_2), min(d_obs1_3, d_obs1_4));
  min_d2 = min(min(d_obs2_1, d_obs2_2), min(d_obs2_3, d_obs2_4));
  min_d3 = min(min(d_obs3_1, d_obs3_2), min(d_obs3_3, d_obs3_4));
  clearance = min(min(min_d1, min_d2), min_d3) - obs_r - r_finger;
  in_contact = clearance < 0.0;
  // Torques and dynamics - finger 1
  tau_p1_1 = kp_gain * p_sat1;
  tau_p1_2 = kp_gain * p_sat1;
  tau_p1_3 = kp_gain * p_sat1;
  tau_p1_4 = kp_gain * p_sat1;
  tau_k1_1 = k_sched * (q_des1 - q1_1) - b_sec * w1_1;
  tau_k1_2 = k_sched * (q_des1 - q1_2) - b_sec * w1_2;
  tau_k1_3 = k_sched * (q_des1 - q1_3) - b_sec * w1_3;
  tau_k1_4 = k_sched * (q_des1 - q1_4) - b_sec * w1_4;
  tau_c1_1 = -Fn1_1;
  tau_c1_2 = -Fn1_2;
  tau_c1_3 = -Fn1_3;
  tau_c1_4 = -Fn1_4;
  tau_d1_1 = -F_dist_apply * (tip_x1 - x1_1);
  tau_d1_2 = -F_dist_apply * (tip_x1 - x1_2);
  tau_d1_3 = -F_dist_apply * (tip_x1 - x1_3);
  tau_d1_4 = -F_dist_apply * (tip_x1 - x1_4);
  der(q1_1) = w1_1;
  der(q1_2) = w1_2;
  der(q1_3) = w1_3;
  der(q1_4) = w1_4;
  J_sec * der(w1_1) = tau_p1_1 + tau_k1_1 + tau_c1_1 + tau_d1_1;
  J_sec * der(w1_2) = tau_p1_2 + tau_k1_2 + tau_c1_2 + tau_d1_2;
  J_sec * der(w1_3) = tau_p1_3 + tau_k1_3 + tau_c1_3 + tau_d1_3;
  J_sec * der(w1_4) = tau_p1_4 + tau_k1_4 + tau_c1_4 + tau_d1_4;
  // Torques and dynamics - finger 2
  tau_p2_1 = kp_gain * p_sat2;
  tau_p2_2 = kp_gain * p_sat2;
  tau_p2_3 = kp_gain * p_sat2;
  tau_p2_4 = kp_gain * p_sat2;
  tau_k2_1 = k_sched * (q_des2 - q2_1) - b_sec * w2_1;
  tau_k2_2 = k_sched * (q_des2 - q2_2) - b_sec * w2_2;
  tau_k2_3 = k_sched * (q_des2 - q2_3) - b_sec * w2_3;
  tau_k2_4 = k_sched * (q_des2 - q2_4) - b_sec * w2_4;
  tau_c2_1 = -Fn2_1;
  tau_c2_2 = -Fn2_2;
  tau_c2_3 = -Fn2_3;
  tau_c2_4 = -Fn2_4;
  der(q2_1) = w2_1;
  der(q2_2) = w2_2;
  der(q2_3) = w2_3;
  der(q2_4) = w2_4;
  J_sec * der(w2_1) = tau_p2_1 + tau_k2_1 + tau_c2_1;
  J_sec * der(w2_2) = tau_p2_2 + tau_k2_2 + tau_c2_2;
  J_sec * der(w2_3) = tau_p2_3 + tau_k2_3 + tau_c2_3;
  J_sec * der(w2_4) = tau_p2_4 + tau_k2_4 + tau_c2_4;
  // Torques and dynamics - finger 3
  tau_p3_1 = kp_gain * p_sat3;
  tau_p3_2 = kp_gain * p_sat3;
  tau_p3_3 = kp_gain * p_sat3;
  tau_p3_4 = kp_gain * p_sat3;
  tau_k3_1 = k_sched * (q_des3 - q3_1) - b_sec * w3_1;
  tau_k3_2 = k_sched * (q_des3 - q3_2) - b_sec * w3_2;
  tau_k3_3 = k_sched * (q_des3 - q3_3) - b_sec * w3_3;
  tau_k3_4 = k_sched * (q_des3 - q3_4) - b_sec * w3_4;
  tau_c3_1 = -Fn3_1;
  tau_c3_2 = -Fn3_2;
  tau_c3_3 = -Fn3_3;
  tau_c3_4 = -Fn3_4;
  der(q3_1) = w3_1;
  der(q3_2) = w3_2;
  der(q3_3) = w3_3;
  der(q3_4) = w3_4;
  J_sec * der(w3_1) = tau_p3_1 + tau_k3_1 + tau_c3_1;
  J_sec * der(w3_2) = tau_p3_2 + tau_k3_2 + tau_c3_2;
  J_sec * der(w3_3) = tau_p3_3 + tau_k3_3 + tau_c3_3;
  J_sec * der(w3_4) = tau_p3_4 + tau_k3_4 + tau_c3_4;
  // Thermal model
  thermal_power = k_thermal * (abs(p_sat1) + abs(p_sat2) + abs(p_sat3));
  C_thermal * der(T) = thermal_power - (T - T_ref) / R_thermal;
  // Acceptance checks
  max_q1 = max(max(abs(q1_1), abs(q1_2)), max(abs(q1_3), abs(q1_4)));
  max_q2 = max(max(abs(q2_1), abs(q2_2)), max(abs(q2_3), abs(q2_4)));
  max_q3 = max(max(abs(q3_1), abs(q3_2)), max(abs(q3_3), abs(q3_4)));
  ok_actuator = (abs(p_sat1) <= p_max + 1.0) and (abs(p_sat2) <= p_max + 1.0) and (abs(p_sat3) <= p_max + 1.0);
  ok_deformation = (max_q1 <= def_bound) and (max_q2 <= def_bound) and (max_q3 <= def_bound);
  ok_contact = F_contact_total <= F_contact_bound;
  ok_temperature = T <= T_max;
  ok_clearance = clearance >= clearance_bound;
  ok_tip_error = (time < final_err_time) or (tip_err <= final_err_thresh);
  ok_no_nan = true;
  ok_all = ok_actuator and ok_deformation and ok_contact and ok_temperature and ok_clearance and ok_tip_error and ok_no_nan;
  annotation(
    experiment(StopTime = 16.0, Tolerance = 1e-6, Interval = 0.004)
  );
end SoftGripAvoidE;