model DiffRoverBrakeC
  // ---------- Physical plant parameters (SI) ----------
  parameter Real m = 19.0 "kg chassis mass";
  parameter Real chassis_Lx = 0.65 "m chassis length";
  parameter Real chassis_Wy = 0.44 "m chassis width";
  parameter Real chassis_Hz = 0.22 "m chassis height";
  parameter Real r_w = 0.10 "m driven-wheel radius";
  parameter Real L_w = 0.46 "m wheel separation (two driven wheels)";
  parameter Real mu = 0.70 "floor friction coefficient (declared; used as traction observable)";
  parameter Real g = 9.81 "m/s^2 gravitational acceleration";

  // ---------- Control / scenario parameters ----------
  parameter Real v_target = 1.2 "m/s target forward speed";
  parameter Real tau_max = 12.0 "N.m max command magnitude per wheel";
  parameter Real F_dist = 162.0 "N payload disturbance magnitude";
  parameter Real x_barrier = 7.0 "m fixed barrier position ahead";
  parameter Real safety_range = 1.4 "m emergency-stop trigger range";
  parameter Real T_dist_start = 4.0 "s middle-third start";
  parameter Real T_dist_end = 8.0 "s middle-third end";
  parameter Real dt = 0.008 "s control/sensor sample period (125 Hz)";
  parameter Real K_p = 4000.0 "N per (m/s) speed proportional gain";
  parameter Real K_i = 800.0 "N per (m/s)*s speed integral gain";

  // ---------- Continuous states ----------
  Real x(start = 0.0, fixed = true) "m forward position of chassis";
  Real v(start = 0.0, fixed = true) "m/s forward velocity of chassis";
  Real integ(start = 0.0, fixed = true) "integral of speed-tracking error";

  // ---------- Commands and forces ----------
  Real tau_cmd "N.m per-wheel symmetric torque command";
  Real tau_L "N.m left driven-wheel torque";
  Real tau_R "N.m right driven-wheel torque";
  Real F_motor "N total motor force transmitted at ground";
  Real F_max "N max total motor force (2*tau_max/r_w)";
  Real F_disturbance "N payload disturbance force (applied opposing forward motion)";
  Real F_traction_max "N max available traction (mu*m*g)";

  // ---------- Sensors ----------
  Real a_imu "m/s^2 IMU longitudinal acceleration";
  Real enc_v "m/s encoder-derived forward wheel speed";
  Real depth_range "m depth-camera range to barrier";

  // ---------- State machine ----------
  Integer state(start = 0) "0=ACCEL,1=CRUISE,2=EMERGENCY,3=STOPPED";

  // ---------- Requirement observables ----------
  Real track_error "m position overshoot past the safety trigger line";
  Real residual_speed "m/s absolute chassis speed";
  Real stopping_margin "m distance from chassis to barrier";

  // ---------- Synchronized sampled records (125 Hz) ----------
  discrete Real v_sensor "sampled encoder/IMU velocity record";
  discrete Real a_sensor "sampled IMU acceleration record";
  discrete Real range_sensor "sampled depth-camera range record";

protected
  Real v_ref "m/s speed reference generated by FSM";
  Real F_cmd "N uncapped PI motor-force command";

equation
  // Drive effort limits
  F_max = 2.0 * tau_max / r_w;
  F_traction_max = mu * m * g;

  // Disturbance: constant backward (drag-type payload disturbance) during middle third.
  // Direction is chosen opposing forward motion; the request did not state a direction.
  F_disturbance = if (time >= T_dist_start and time <= T_dist_end) then -F_dist else 0.0;

  // Speed reference from FSM
  v_ref = if (state == 0 or state == 1) then v_target else 0.0;

  // PI speed controller; integral frozen during EMERGENCY braking
  F_cmd = K_p * (v_ref - v) + K_i * integ;
  der(integ) = if state == 2 then 0.0 else (v_ref - v);

  // Effort-limited motor force: full brake in EMERGENCY, PI elsewhere, capped at +/-F_max
  F_motor = if state == 2 then -F_max
            else max(-F_max, min(F_max, F_cmd));

  // Symmetric per-wheel torque (continuous Y-axis wheel joints, straight-line motion)
  tau_cmd = F_motor * r_w / 2.0;
  tau_L = tau_cmd;
  tau_R = tau_cmd;

  // Rigid-floor longitudinal dynamics (lumped chassis, sufficient grip assumed;
  // friction coefficient declared as floor property and exposed as traction observable).
  der(x) = v;
  m * der(v) = F_motor + F_disturbance;

  // Instrumentation evidence
  a_imu = der(v);
  enc_v = v;
  depth_range = x_barrier - x;

  // Synchronized 125 Hz sensor records
  when sample(0, dt) then
    v_sensor = v;
    a_sensor = a_imu;
    range_sensor = x_barrier - x;
  end when;

  // Requirement observables
  track_error = max(0.0, x - (x_barrier - safety_range));
  residual_speed = abs(v);
  stopping_margin = x_barrier - x;

  // ---------- Deterministic emergency-stop state machine ----------
  when initial() then
    state = 0;
  end when;

  when state == 0 and v >= v_target - 1e-3 then
    state = 1;
  elsewhen (state == 0 or state == 1) and (x_barrier - x) <= safety_range then
    state = 2;
  elsewhen state == 2 and v <= 0.05 then
    state = 3;
  end when;

  // Anti-windup: reset integral when entering EMERGENCY braking
  when state == 2 then
    reinit(integ, 0.0);
  end when;

  annotation(
    experiment(StartTime = 0, StopTime = 12, Tolerance = 1e-6, Interval = 0.008),
    Documentation(info = "DiffRoverBrakeC: floating-base differential-drive rover (19 kg box chassis, two 0.10 m driven wheels separated by 0.46 m, one passive caster) with a deterministic emergency-stop state machine. Targets 1.2 m/s and performs monotonic full-effort braking when the depth-camera range to the fixed barrier at 7 m drops to the 1.4 m safety range. A 162 N payload disturbance is injected during the middle third (4-8 s) opposing forward motion. Motor force is effort-limited at 12 N.m per wheel. Friction coefficient 0.70 is declared as the rigid-floor property and exposed as the traction observable mu*m*g; grip is assumed sufficient for the modeled maneuver (simplification noted).")
  );
end DiffRoverBrakeC;