#!/bin/bash
#SBATCH --job-name=abl-a5
#SBATCH --account=gts-CHANGEME
#SBATCH --partition=cpu-small
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=8
#SBATCH --mem=16G
#SBATCH --time=16:00:00
#SBATCH --array=1-5%5
#SBATCH --signal=B:TERM@300
#SBATCH --output=logs/a5_%A_%a.out
#SBATCH --error=logs/a5_%A_%a.err
#
# GENERATED by nl2solidity/ablation/gen_sbatch.py from profiles.py. Do not hand-edit:
# change the arm in profiles.py and regenerate, or the header below will lie.
#
# Ablation A5: full pipeline
# Adds over A4: Slither static analysis + twin-blind spec alignment
#
# Stages wired for this arm. Every feedback stage is *measured* on every arm, so
# all six carry the same metrics; "repair" marks the ones this arm may fix against.
#   [on     ] RAG_ENABLED
#   [on     ] MOE_ENABLED
#   [repair ] COMPILER_FEEDBACK_ENABLED
#   [repair ] KERNEL_FEEDBACK_ENABLED
#   [repair ] SECURITY_ANALYSIS_ENABLED
#   [repair ] SPEC_ALIGNMENT_ENABLED
#
# The array runs 5 independent shards of this arm. Shard k takes the seeds
# where (seed position % 5) == k, so the shards are disjoint by construction
# and no two tasks ever generate the same seed. Rerunning the identical
# submission resumes: completed seed directories are skipped.
#
# Submit from the repo root:   sbatch nl2solidity/ablation/pace/a5.sbatch
# Override the shard count:    ABLATION_SHARDS=6 sbatch --array=1-6%6 nl2solidity/ablation/pace/a5.sbatch
#
# Output: nl2solidity/dataset/ablation/A5/U###/

REPO="${REPO:-${SLURM_SUBMIT_DIR:-$PWD}}"
source "$REPO/nl2solidity/ablation/pace/common.sh"

run_arm A5
