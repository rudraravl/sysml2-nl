    transition initial_to_off first off;

    transition off_to_cranking
      first off
      accept ControlCommand
      if command.starterEnabled == true
      then cranking;

    transition cranking_to_idle
      first cranking
      if torqueOutput.torqueOutput.rotationalSpeed >= 700 [SI::rpm]
