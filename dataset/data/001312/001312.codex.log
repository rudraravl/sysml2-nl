  requirement def FlowRateMeasurementRequirement {
    subject meter : WaterMeter;

    require constraint {
      meter.sensor.minimumDetectableFlow <= 0.00003 [SI::litre / SI::second]
    }

    require constraint {
      meter.sensor.maximumMeasurableFlow >= 1.4 [SI::litre / SI::second]
    }

    doc
    /*
     The water meter shall measure instantaneous flow rate across
     the specified residential service flow range.
    */
  }

  requirement def ReadingReportingRequirement {
    subject meter : WaterMeter;

    require constraint {
      meter.controller.reportingPeriod_s <= 900.0
    }

    doc
    /*
     The water meter shall make cumulative volume, instantaneous flow,
     flow direction, timestamp, and battery charge available to local
     display and remote communication interfaces at least every 15 minutes.
    */
  }

  requirement def ReverseFlowDetectionRequirement {
    subject meter : WaterMeter;

    require constraint {
      meter.sensor.measuredDirection == FlowDirection::reverse implies
      meter.controller.activeAlarm.kind == AlarmKind::reverseFlowDetected
    }

    doc
    /*
     The water meter shall detect and report reverse flow when measured
     flow direction is opposite the normal inlet-to-outlet direction.
    */
  }

  requirement def LeakDetectionRequirement {
    subject meter : WaterMeter;

    require constraint {
      meter.controller.leakThreshold_L_per_h <= 5.0
    }

    doc
    /*
     The water meter shall identify sustained low-level continuous flow
     as a potential leak and generate a leak alarm.
    */
  }

  requirement def LowBatteryRequirement {
    subject meter : WaterMeter;

    require constraint {
      meter.battery.remainingCharge <= meter.battery.lowBatteryLimit implies
      meter.controller.activeAlarm.kind == AlarmKind::lowBattery
    }

    doc
    /*
     The water meter shall generate a low-battery alarm when remaining
     battery charge is at or below the configured service threshold.
    */
  }

  requirement def TamperDetectionRequirement {
    subject meter : WaterMeter;

    require constraint {
      meter.tamperDetector.enclosureOpen == true or
      meter.tamperDetector.magneticTamperPresent == true implies
      meter.tamperDetector.tamperAlarm.kind == AlarmKind::tamperDetected
    }

    doc
    /*
     The water meter shall detect enclosure opening or magnetic interference
     and produce a tamper alarm.
    */
  }

  satisfy MeasureWaterVolumeRequirement by WaterMeter::integrator;
  satisfy FlowRateMeasurementRequirement by WaterMeter::sensor;
  satisfy ReadingReportingRequirement by WaterMeter::controller;
  satisfy ReverseFlowDetectionRequirement by WaterMeter::controller;
  satisfy LeakDetectionRequirement by WaterMeter::controller;
  satisfy LowBatteryRequirement by WaterMeter::battery;
  satisfy TamperDetectionRequirement by WaterMeter::tamperDetector;

  action def MeasureAndReportWaterConsumption {
    in item inletFlow : WaterFlow;
    out item outletFlow : WaterFlow;
    out item reading : MeterReading;
    out item alarm : AlarmReport;

    action senseFlow {
      in item flow : WaterFlow;
      out attribute rate : FlowRate;
      out attribute direction : FlowDirection;
    }

    action accumulateVolume {
      in attribute rate : FlowRate;
      in attribute direction : FlowDirection;
      out attribute totalVolume : Volume;
    }

    action createReading {
      in attribute totalVolume : Volume;
      in attribute rate : FlowRate;
      in attribute direction : FlowDirection;
      out item meterReading : MeterReading;
    }

    action checkForAbnormalConditions {
      in item meterReading : MeterReading;
      out item generatedAlarm : AlarmReport;
    }

    action publishReading {
      in item meterReading : MeterReading;
      in item generatedAlarm : AlarmReport;
    }

    first start;
    then senseFlow;
    then accumulateVolume;
    then createReading;
    then checkForAbnormalConditions;
    then publishReading;
    then done;
  }

