    in item incomingWaterFlow : WaterFlow;
  }

  port def HydraulicOutletPort {
    out item outgoingWaterFlow : WaterFlow;
  }

  port def ReadingOutputPort {
    out item reading : MeterReading;
    out item alarm : AlarmReport;
  }

  port def CommandInputPort {
    in item command : ConfigurationCommand;
  }

  port def ElectricalPowerPort {
    in attribute supplyVoltage_V : ScalarValues::Real;
