    attribute samplingPeriod_s : ScalarValues::Real;
    attribute reportingPeriod_s : ScalarValues::Real;
    attribute leakThreshold_L_per_h : ScalarValues::Real;
    attribute reverseFlowEnabled : ScalarValues::Boolean;
  }

