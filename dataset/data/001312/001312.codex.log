      attribute accumulatedReverseVolume = 0.0 [SI::litre];
      attribute netVolume = 0.0 [SI::litre];
      attribute integrationPeriod_s = 1.0;
    }

    part temperatureSensor : TemperatureSensor {
      attribute measurementError_degC = 0.5;
    }

    part pressureSensor : PressureSensor {
      attribute measurementError_Pa = 5000.0;
    }

    part controller : MeterController;

    part radio : CommunicationModule {
      attribute signalStrength = -85.0 [SI::decibel];
      attribute reportingInterval_s = 900.0;
    }

    part display : RegisterDisplay;

    part battery : BatteryPack {
      attribute remainingCharge = 100.0 [SI::percent];
    }

    part tamperDetector : TamperDetector;

    connect waterIn to body.inlet;
    connect body.outlet to waterOut;
    connect body.inlet to sensor.sensedFlowIn;

    flow sensor.measuredFlowRate to integrator.flowRate;
    flow sensor.measuredDirection to integrator.flowDirection;

    flow sensor.measuredFlowRate to controller.flowRate;
    flow sensor.measuredDirection to controller.direction;
    flow integrator.netVolume to controller.cumulativeVolume;
    flow battery.remainingCharge to controller.batteryCharge;
    flow pressureSensor.measuredPressure to controller.pressure;
    flow temperatureSensor.measuredTemperature to controller.temperature;

    flow controller.currentReading to radio.readingToTransmit;
    flow controller.activeAlarm to radio.alarmToTransmit;
    flow controller.currentReading to readings.reading;
    flow controller.activeAlarm to readings.alarm;

    flow radio.receivedCommand to controller.applyConfiguration.command;
    connect commands to radio.commandIn;

    flow integrator.netVolume to display.displayedVolume;
    flow sensor.measuredFlowRate to display.displayedFlowRate;
    flow controller.activeAlarm to display.displayedAlarm;

    connect battery.powerOut to radio.power;

    objective primaryFunction {
      doc
      /*
       The WaterMeter measures water passing from its inlet to its outlet,
       determines instantaneous flow rate and cumulative consumed volume,
       detects abnormal conditions such as reverse flow, leakage, tamper,
       low battery, and sensor faults, and reports validated meter readings
       locally and remotely for billing, monitoring, and maintenance.
      */
    }
  }

  part def UtilityEndpoint {
    port meterDataIn : ReadingOutputPort;
    port meterCommandOut : CommandInputPort;

    in item receivedReading : MeterReading;
    in item receivedAlarm : AlarmReport;
    out item issuedCommand : ConfigurationCommand;

    attribute endpointIdentifier : ScalarValues::String;
  }

  part def ResidentialServiceLine {
    part installedMeter : WaterMeter;
    part utilitySystem : UtilityEndpoint;

    item suppliedWater : WaterFlow {
      attribute rate = 0.12 [SI::litre / SI::second];
      attribute direction = FlowDirection::forward;
      attribute pressure = 450000.0 [SI::pascal];
      attribute temperature = 12.0 [SI::degreeCelsius];
    }

    connect installedMeter.readings to utilitySystem.meterDataIn;
    connect utilitySystem.meterCommandOut to installedMeter.commands;
  }

  requirement def MeasureWaterVolumeRequirement {
    subject meter : WaterMeter;

    require constraint {
      meter.integrator.netVolume >= 0.0 [SI::litre]
    }

    doc
    /*
     The water meter shall calculate cumulative net water volume
     passing through the meter body from inlet to outlet.
    */
  }

  requirement def FlowRateMeasurementRequirement {
    subject meter : WaterMeter;

    require constraint {
      meter.sensor.minimumDetectableFlow <= 0.00003 [SI::litre / SI::second]
    }

    require constraint {
      meter.sensor.maximumMeasurableFlow >= 1.4 [SI::litre / SI::second]
    }

    doc
    /*
     The water meter shall measure instantaneous flow rate across
     the specified residential service flow range.
    */
  }

  requirement def ReadingReportingRequirement {
    subject meter : WaterMeter;

    require constraint {
      meter.controller.reportingPeriod_s <= 900.0
    }

    doc
    /*
     The water meter shall make cumulative volume, instantaneous flow,
     flow direction, timestamp, and battery charge available to local
     display and remote communication interfaces at least every 15 minutes.
    */
  }

  requirement def ReverseFlowDetectionRequirement {
    subject meter : WaterMeter;

    require constraint {
      meter.sensor.measuredDirection == FlowDirection::reverse implies
      meter.controller.activeAlarm.kind == AlarmKind::reverseFlowDetected
    }

    doc
    /*
     The water meter shall detect and report reverse flow when measured
     flow direction is opposite the normal inlet-to-outlet direction.
    */
  }

  requirement def LeakDetectionRequirement {
    subject meter : WaterMeter;

    require constraint {
      meter.controller.leakThreshold_L_per_h <= 5.0
    }

    doc
    /*
     The water meter shall identify sustained low-level continuous flow
     as a potential leak and generate a leak alarm.
    */
  }

  requirement def LowBatteryRequirement {
    subject meter : WaterMeter;

    require constraint {
      meter.battery.remainingCharge <= meter.battery.lowBatteryLimit implies
      meter.controller.activeAlarm.kind == AlarmKind::lowBattery
    }

    doc
    /*
     The water meter shall generate a low-battery alarm when remaining
     battery charge is at or below the configured service threshold.
    */
  }

  requirement def TamperDetectionRequirement {
    subject meter : WaterMeter;

    require constraint {
      meter.tamperDetector.enclosureOpen == true or
      meter.tamperDetector.magneticTamperPresent == true implies
      meter.tamperDetector.tamperAlarm.kind == AlarmKind::tamperDetected
    }

    doc
    /*
     The water meter shall detect enclosure opening or magnetic interference
     and produce a tamper alarm.
    */
  }

  satisfy MeasureWaterVolumeRequirement by WaterMeter::integrator;
  satisfy FlowRateMeasurementRequirement by WaterMeter::sensor;
  satisfy ReadingReportingRequirement by WaterMeter::controller;
  satisfy ReverseFlowDetectionRequirement by WaterMeter::controller;
  satisfy LeakDetectionRequirement by WaterMeter::controller;
  satisfy LowBatteryRequirement by WaterMeter::battery;
  satisfy TamperDetectionRequirement by WaterMeter::tamperDetector;

  action def MeasureAndReportWaterConsumption {
    in item inletFlow : WaterFlow;
    out item outletFlow : WaterFlow;
    out item reading : MeterReading;
    out item alarm : AlarmReport;

    action senseFlow {
      in item flow : WaterFlow;
      out attribute rate : FlowRate;
      out attribute direction : FlowDirection;
    }

    action accumulateVolume {
      in attribute rate : FlowRate;
      in attribute direction : FlowDirection;
      out attribute totalVolume : Volume;
    }

    action createReading {
      in attribute totalVolume : Volume;
      in attribute rate : FlowRate;
      in attribute direction : FlowDirection;
      out item meterReading : MeterReading;
    }

    action checkForAbnormalConditions {
      in item meterReading : MeterReading;
      out item generatedAlarm : AlarmReport;
    }

    action publishReading {
      in item meterReading : MeterReading;
      in item generatedAlarm : AlarmReport;
    }

    first start;
    then senseFlow;
    then accumulateVolume;
    then createReading;
    then checkForAbnormalConditions;
    then publishReading;
    then done;
  }

}
