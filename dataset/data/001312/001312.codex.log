  }

  part def WaterMeter {
    port waterIn : HydraulicInletPort;
    port waterOut : HydraulicOutletPort;
    port readings : ReadingOutputPort;
    port commands : CommandInputPort;

    part body : FlowBody {
      attribute nominalDiameter_mm = 20.0;
      attribute maximumWorkingPressure = 1600000.0 [SI::pascal];
      attribute pressureLossAtNominalFlow = 25000.0 [SI::pascal];
    }

    part sensor : FlowSensor {
      attribute minimumDetectableFlow = 0.00003 [SI::litre / SI::second];
      attribute maximumMeasurableFlow = 1.4 [SI::litre / SI::second];
      attribute measurementErrorPercent = 2.0;
      attribute pulseConstant_L_per_pulse = 1.0;
    }

    part integrator : VolumeIntegrator {
      attribute accumulatedForwardVolume = 0.0 [SI::litre];
      attribute accumulatedReverseVolume = 0.0 [SI::litre];
      attribute netVolume = 0.0 [SI::litre];
      attribute integrationPeriod_s = 1.0;
    }

    part temperatureSensor : TemperatureSensor {
      attribute measurementError_degC = 0.5;
    }

    part pressureSensor : PressureSensor {
      attribute measurementError_Pa = 5000.0;
    }

    part controller : MeterController;

    part radio : CommunicationModule {
      attribute signalStrength = -85.0 [SI::decibel];
      attribute reportingInterval_s = 900.0;
    }

    part display : RegisterDisplay;

    part battery : BatteryPack {
      attribute remainingCharge = 100.0 [SI::percent];
    }

    part tamperDetector : TamperDetector;

    connect waterIn to body.inlet;
    connect body.outlet to waterOut;
    connect body.inlet to sensor.sensedFlowIn;

    flow sensor.measuredFlowRate to integrator.flowRate;
    flow sensor.measuredDirection to integrator.flowDirection;

    flow sensor.measuredFlowRate to controller.flowRate;
    flow sensor.measuredDirection to controller.direction;
    flow integrator.netVolume to controller.cumulativeVolume;
    flow battery.remainingCharge to controller.batteryCharge;
    flow pressureSensor.measuredPressure to controller.pressure;
    flow temperatureSensor.measuredTemperature to controller.temperature;

    flow controller.currentReading to radio.readingToTransmit;
    flow controller.activeAlarm to radio.alarmToTransmit;
    flow controller.currentReading to readings.reading;
    flow controller.activeAlarm to readings.alarm;

    flow radio.receivedCommand to controller.applyConfiguration.command;
    connect commands to radio.commandIn;

    flow integrator.netVolume to display.displayedVolume;
    flow sensor.measuredFlowRate to display.displayedFlowRate;
    flow controller.activeAlarm to display.displayedAlarm;

    connect battery.powerOut to radio.power;

    objective primaryFunction {
      doc
      /*
       The WaterMeter measures water passing from its inlet to its outlet,
       determines instantaneous flow rate and cumulative consumed volume,
       detects abnormal conditions such as reverse flow, leakage, tamper,
