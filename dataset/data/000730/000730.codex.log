        port fabrication : FabricationPort;
        attribute hasGrindingEquipment : Boolean;
        attribute hasHeatMoldingEquipment : Boolean;
        attribute hasShoeModificationTools : Boolean;
        attribute averageFabricationTime : TimeDuration;
