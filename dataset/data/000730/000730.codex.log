        port measurement : MeasurementPort;
        attribute supportsVisualExam : Boolean;
        attribute supportsRangeOfMotionExam : Boolean;
        attribute supportsPressureMapping : Boolean;
        attribute supportsGaitObservation : Boolean;
    }

