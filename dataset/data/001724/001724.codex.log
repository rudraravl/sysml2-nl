    requirement def PrimaryFunctionRequirement {
        subject server : PlexMediaServer;

        doc /* The Plex-based system shall provide centralized personal media management and streaming by authenticating a client, locating requested media, enriching it with metadata, and delivering either a direct-play or transcoded stream suitable for the requesting device and network conditions. */
    }

