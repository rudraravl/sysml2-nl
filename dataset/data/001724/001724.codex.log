        }
    }

    part def MediaStorage {
        attribute mountPath : String;
        attribute capacity : StorageCapacity;
        attribute used : StorageCapacity;
        attribute averageReadBitRate : BitRate;

        action readMedia {
            in attribute mediaId : MediaIdentifier;
            out item stream : MediaStream;
        }
    }

    part def MetadataAgent {
        attribute providerName : String = "Plex Metadata Agent";
        attribute cacheHitRate : Percentage;

        port metadataAccess : LibraryPort;

        action enrichMetadata {
            in item sourceRecord : MetadataRecord;
            out item enrichedRecord : MetadataRecord;
        }

        action refreshArtwork {
            in attribute mediaId : MediaIdentifier;
            out attribute posterUri : String;
        }
    }

