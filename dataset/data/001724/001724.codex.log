    attribute def AccountIdentifier :> String;
    attribute def CodecName :> String;
    attribute def NetworkAddress :> String;

    item def MediaRequest {
        attribute requesterId : AccountIdentifier;
        attribute mediaId : MediaIdentifier;
        attribute targetDeviceId : String;
        attribute requestedQuality : BitRate;
        attribute allowTranscoding : Boolean;
    }

    item def MediaStream {
        attribute mediaId : MediaIdentifier;
        attribute videoCodec : CodecName;
        attribute audioCodec : CodecName;
        attribute streamBitRate : BitRate;
        attribute encrypted : Boolean;
