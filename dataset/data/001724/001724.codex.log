    requirement def AuthenticationRequirement {
        subject service : AccountService;

        doc /* The system shall validate each media request using an account token before allowing library access or stream delivery. */
    }

    requirement def LibraryManagementRequirement {
        subject manager : MediaLibraryManager;

        doc /* The system shall maintain indexed movie, series, and music libraries with metadata records that can be searched and resolved to playable media sources. */
    }

    requirement def AdaptiveStreamingRequirement {
        subject engine : StreamingEngine;

        doc /* The system shall select direct playback when the client supports the source media and shall request transcoding when codec, bit rate, or network constraints require adaptation. */
    }

    requirement def TranscodingRequirement {
        subject transcoder : Transcoder;

        doc /* The transcoder shall convert an incompatible source stream into a client-compatible stream while reporting job progress and failure conditions. */
    }

    requirement def AvailabilityRequirement {
        subject server : PlexMediaServer;

        doc /* The server shall remain available for media browsing while libraries are ready and shall enter degraded operation instead of immediate shutdown when resource pressure is detected during active sessions. */
    }

    requirement def ObservabilityRequirement {
        subject monitor : MonitoringAgent;

        doc /* The system shall emit health events for component failures, scan errors, resource pressure, and stream delivery failures. */
    }

    part plexHomeMediaSystem : PlexMediaServer {
        attribute serverName = "Home Plex";
        attribute localAddress = "192.168.1.10";
        attribute wanAddress = "media.example.net";
        attribute storageTotal = 24.0;
        attribute storageUsed = 15.5;
        attribute activeSessions = 0;
        attribute cpuLoad = 12.0;

        part accountService {
            attribute knownAccounts = 6;
            attribute failedLoginCount = 0;
        }

        part libraryManager {
            attribute movieCount = 1840;
            attribute episodeCount = 12600;
            attribute musicTrackCount = 38200;
            attribute lastScanDurationSeconds = 312.0;
        }

        part streamingEngine {
            attribute activeDirectPlaySessions = 0;
            attribute activeTranscodeSessions = 0;
            attribute aggregateOutboundBitRate = 0.0;
        }

        part transcoder {
            attribute hardwareAccelerationEnabled = true;
            attribute supportedInputCodecs = 14;
            attribute supportedOutputCodecs = 7;
            attribute currentJobs = 0;
        }

        part networkGateway {
            attribute lanAddress = "192.168.1.10";
            attribute remoteAccessEnabled = true;
            attribute tlsEnabled = true;
            attribute measuredRoundTripLatency = 18.0;
        }

        part monitoringAgent {
            attribute sampledCpuLoad = 12.0;
            attribute sampledMemoryLoad = 41.0;
            attribute sampledStorageLoad = 64.6;
        }
    }

    satisfy PrimaryFunctionRequirement by plexHomeMediaSystem;
    satisfy AuthenticationRequirement by plexHomeMediaSystem.accountService;
    satisfy LibraryManagementRequirement by plexHomeMediaSystem.libraryManager;
    satisfy AdaptiveStreamingRequirement by plexHomeMediaSystem.streamingEngine;
    satisfy TranscodingRequirement by plexHomeMediaSystem.transcoder;
    satisfy AvailabilityRequirement by plexHomeMediaSystem;
    satisfy ObservabilityRequirement by plexHomeMediaSystem.monitoringAgent;
}
