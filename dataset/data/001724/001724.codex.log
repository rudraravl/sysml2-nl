    port def StreamPort {
        out item stream : MediaStream;
    }

    port def LibraryPort {
        in item request : MediaRequest;
        out item metadata : MetadataRecord;
        out item sourceStream : MediaStream;
    }

    port def TranscodePort {
        in item sourceStream : MediaStream;
        in item job : TranscodeJob;
        out item transcodedStream : MediaStream;
    }

    port def HealthPort {
        out item event : HealthEvent;
    }

    part def PlexMediaServer {
        attribute serverName : String;
        attribute localAddress : NetworkAddress;
        attribute wanAddress : NetworkAddress;
        attribute storageTotal : StorageCapacity;
        attribute storageUsed : StorageCapacity;
        attribute activeSessions : Count;
        attribute cpuLoad : Percentage;
        attribute targetStartupLatency : Latency = 2500.0;
        attribute maxConcurrentStreams : Count = 12;

        port clientApi : RequestPort;
        port streamOutput : StreamPort;
        port healthOutput : HealthPort;

        part accountService : AccountService;
        part libraryManager : MediaLibraryManager;
        part metadataAgent : MetadataAgent;
        part streamingEngine : StreamingEngine;
        part transcoder : Transcoder;
        part networkGateway : NetworkGateway;
        part monitoringAgent : MonitoringAgent;

        connect clientApi to networkGateway.externalRequest;
        connect networkGateway.authRequest to accountService.authPort;
        connect networkGateway.libraryRequest to libraryManager.libraryAccess;
        connect libraryManager.metadataQuery to metadataAgent.metadataAccess;
        connect libraryManager.sourceMedia to streamingEngine.sourceInput;
        connect streamingEngine.transcodeRequest to transcoder.transcodeAccess;
        connect transcoder.transcodedOutput to streamingEngine.transcodedInput;
        connect streamingEngine.streamOutput to streamOutput;
        connect monitoringAgent.healthOutput to healthOutput;

        action serveMedia {
            in item request : MediaRequest;
            out item deliveredStream : MediaStream;

            first start;
            then authenticate;
            then authorizeAccess;
            then locateMedia;
            then selectDeliveryMode;

            action authenticate {
                in item request : MediaRequest;
                out item token : AuthenticationToken;
            }

            action authorizeAccess {
                in item token : AuthenticationToken;
                in item request : MediaRequest;
                out item authorizedRequest : MediaRequest;
            }

            action locateMedia {
                in item authorizedRequest : MediaRequest;
                out item metadata : MetadataRecord;
                out item sourceStream : MediaStream;
            }

            decision selectDeliveryMode;

            action directPlay {
                in item sourceStream : MediaStream;
                out item deliveredStream : MediaStream;
            }

            action transcodeForClient {
                in item sourceStream : MediaStream;
                out item deliveredStream : MediaStream;
            }

            then directPlay if request.allowTranscoding == false;
            then transcodeForClient if request.allowTranscoding == true;
            then finish;
