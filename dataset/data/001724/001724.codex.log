        subject server : PlexMediaServer;

        doc /* The server shall remain available for media browsing while libraries are ready and shall enter degraded operation instead of immediate shutdown when resource pressure is detected during active sessions. */
    }

    requirement def ObservabilityRequirement {
        subject monitor : MonitoringAgent;

        doc /* The system shall emit health events for component failures, scan errors, resource pressure, and stream delivery failures. */
    }

