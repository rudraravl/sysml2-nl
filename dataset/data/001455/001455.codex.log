        subject structure : StructuralThermalAssembly;

        require constraint {
            structure.operationalTemperatureLow <= -70.0 and
            structure.operationalTemperatureHigh >= 50.0
        }
    }

    requirement def SampleContainmentRequirement {
        subject carousel : SampleContainmentCarousel;

        require constraint {
            carousel.numberOfCups >= 10 and
            carousel.cupCapacity >= 0.010
        }
    }

    requirement def DeliveryAccuracyRequirement {
        subject delivery : DeliveryInterface;

        require constraint {
            delivery.deliveryAccuracy <= 0.005
        }
    }

    part planetarySampler : HoneybeeInspiredPlanetarySampler;

    satisfy PrimaryFunctionRequirement by planetarySampler;
    satisfy SampleMassRequirement by planetarySampler;
    satisfy DepthRequirement by planetarySampler;
    satisfy PowerRequirement by planetarySampler;
    satisfy ThermalSurvivalRequirement by planetarySampler.structure;
    satisfy SampleContainmentRequirement by planetarySampler.carousel;
    satisfy DeliveryAccuracyRequirement by planetarySampler.delivery;
}
