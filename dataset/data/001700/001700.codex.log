    require constraint {
      system.targetAvailability >= 99.95
    }
  }

  requirement def MessageAuthenticationRequirement {
    subject submission : SubmissionService;

    doc
      /* The submission service shall authenticate a sender before accepting a message for delivery. */

    require constraint {
      submission.requireMfaForExternalRelay == true
    }
  }

  requirement def MessageSizeRequirement {
    subject system : EmailSystem;

    doc
      /* The system shall reject submitted messages whose total encoded size exceeds the configured maximum inbound message size. */

    require constraint {
      system.maximumInboundMessageSize <= 36700160
    }
  }

  requirement def SecurityInspectionRequirement {
    subject gateway : SecurityGateway;

    doc
      /* The security gateway shall inspect every accepted message for malware, spam, and phishing indicators before the message is queued for delivery. */

    require constraint {
      gateway.virusScanEnabled == true and gateway.phishingDetectionEnabled == true
    }
  }

  requirement def DeliveryLatencyRequirement {
    subject system : EmailSystem;

    doc
      /* The system shall deliver or defer accepted messages within the target end-to-end latency under normal operating conditions. */

    require constraint {
      system.maximumEndToEndLatency <= 120.0
    }
  }

  requirement def MailboxQuotaRequirement {
    subject store : MailboxStore;

    doc
      /* The mailbox store shall enforce a finite per-user quota so that one mailbox cannot consume all shared storage capacity. */

    require constraint {
      store.perUserQuota < store.storageCapacity
    }
  }

  requirement def RetrievalRequirement {
    subject store : MailboxStore;

    doc
      /* The mailbox store shall return authorized mailbox queries with matching message metadata and message bodies. */

    require constraint {
      store.indexingLatencyTarget <= 10.0
    }
  }

  requirement def NotificationRequirement {
    subject notifier : NotificationService;

    doc
      /* The notification service shall notify users when delivery state changes for submitted messages and when new mail is stored in their mailbox. */

    require constraint {
      notifier.notificationLatencyTarget <= 3.0
    }
  }

  satisfy PrimaryEmailFunctionRequirement by EmailSystem;
  satisfy MessageAuthenticationRequirement by SubmissionService;
  satisfy MessageSizeRequirement by EmailSystem;
  satisfy SecurityInspectionRequirement by SecurityGateway;
  satisfy DeliveryLatencyRequirement by EmailSystem;
  satisfy MailboxQuotaRequirement by MailboxStore;
  satisfy RetrievalRequirement by MailboxStore;
  satisfy NotificationRequirement by NotificationService;

}
