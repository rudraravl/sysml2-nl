        port userSide : UserSupportPort;
        port leftSeatSide : SeatInterfacePort;
        port rightSeatSide : SeatInterfacePort;
    }

    part def StructuralCore {
        attribute boardMass : MassValue = 1.35 [kg];
        attribute ratedUserMass : MassValue = 150.0 [kg];
        attribute maximumDistributedLoad : ForceValue = 1471.0 [N];
        attribute maximumDeflection : LengthValue = 0.015 [m];
        attribute minimumSafetyFactor : Real = 2.0;

        port loadInput : UserSupportPort;
        port loadOutputA : SeatInterfacePort;
        port loadOutputB : SeatInterfacePort;
    }

    part def AntiSlipPads {
        attribute padCount : Integer = 4;
        attribute padFrictionCoefficient : Real = 0.75;
        attribute padCompressionLimit : LengthValue = 0.004 [m];

        port seatAContact : SeatInterfacePort;
        port seatBContact : SeatInterfacePort;
    }

    part def HandGripCutouts {
        attribute gripCount : Integer = 2;
        attribute gripOpeningLength : LengthValue = 0.11 [m];
        attribute gripOpeningWidth : LengthValue = 0.035 [m];
        attribute minimumGripClearance : LengthValue = 0.03 [m];
    }

    part def AlignmentGuide {
        attribute maximumSeatGap : LengthValue = 0.20 [m];
        attribute maximumHeightDifference : LengthValue = 0.10 [m];
        attribute maximumBoardAngle : AngleValue = 15.0 [deg];

        port seatA : SeatInterfacePort;
        port seatB : SeatInterfacePort;
        port safetyOut : SafetySignalPort;
    }

    part def LoadMonitor {
        attribute measuredLoad : ForceValue;
        attribute loadLimit : ForceValue = 1471.0 [N];
        attribute overloadDetected : Boolean;
        attribute responseTime : TimeValue = 0.10 [s];

        port sensedLoad : UserSupportPort;
        port safetyOut : SafetySignalPort;
    }

    part def CaregiverInterface {
        attribute readyIndicator : Boolean;
        attribute unsafeIndicator : Boolean;
        attribute transferCompleteIndicator : Boolean;

        port control : ControlPort;
        port safetyIn : SafetySignalPort;
    }

    action def PrepareTransfer {
        in user : User;
        in command : CaregiverCommand;
        out status : BoardStatus;

        first start;
        then verifyCommand;
        then verifyUserSeated;
        then reportReady;
        then done;

        action verifyCommand {
            in command : CaregiverCommand;
            out accepted : Boolean;
        }

        action verifyUserSeated {
            in user : User;
            out stable : Boolean;
        }

        action reportReady {
            out status : BoardStatus;
        }
    }

    action def BridgeSeatGap {
        in seatALoad : SupportLoad;
        in seatBLoad : SupportLoad;
        out status : BoardStatus;

        first positionBoard;
        then checkSeatOverlap;
        then checkAngle;
        then lockFrictionContact;
        then done;

        action positionBoard;
        action checkSeatOverlap;
        action checkAngle;
        action lockFrictionContact;
    }

    action def SupportLateralTransfer {
        in user : User;
        in appliedLoad : SupportLoad;
        out status : BoardStatus;

        first acceptUserLoad;
        then distributeLoadAcrossCore;
        then permitControlledSlide;
        then confirmArrival;
        then done;

        action acceptUserLoad;
        action distributeLoadAcrossCore;
        action permitControlledSlide;
        action confirmArrival;
    }

    action def StopTransferSafely {
        in command : CaregiverCommand;
        out status : BoardStatus;

        first detectStopCondition;
        then stabilizeUser;
        then reportStopped;
        then done;

        action detectStopCondition;
        action stabilizeUser;
        action reportStopped;
    }

    state def TransferBoardOperatingState {
        state idle;
        state positioned;
        state ready;
        state transferring;
        state complete;
        state unsafe;

        initial then idle;

        transition idle_to_positioned
            first idle
            accept CaregiverCommand
            if command.startTransfer
            then positioned;

        transition positioned_to_ready
            first positioned
            if status.locked and status.loadWithinLimit and status.surfaceDry
            then ready;

        transition ready_to_transferring
            first ready
            accept SupportLoad
            if appliedLoad.verticalForce <= 1471.0 [N]
            then transferring;

