            first idle
            accept CaregiverCommand
            if command.emergencyStop
            then unsafe;

        transition positioned_to_unsafe
            first positioned
            if not status.locked
            then unsafe;

        transition transferring_to_unsafe
            first transferring
            if not status.loadWithinLimit
            then unsafe;

        transition unsafe_to_idle
            first unsafe
            accept CaregiverCommand
            if command.stopTransfer
            then idle;
    }

    part def TransferBoardSystem {
        doc /* The TransferBoardSystem is a portable seated-transfer aid whose primary high-level function is to bridge the gap between two support surfaces and provide a stable, low-friction path so a seated user can move laterally from one surface to another with caregiver control and reduced lifting effort. */

        attribute systemMass : MassValue = 1.65 [kg];
        attribute ratedUserMass : MassValue = 150.0 [kg];
        attribute supportedSeatGap : LengthValue = 0.20 [m];
        attribute supportedHeightDifference : LengthValue = 0.10 [m];
        attribute nominalTransferTime : TimeValue = 20.0 [s];

        part surface : TransferSurface;
        part core : StructuralCore;
        part pads : AntiSlipPads;
        part grips : HandGripCutouts;
        part alignment : AlignmentGuide;
        part loadMonitor : LoadMonitor;
        part caregiverInterface : CaregiverInterface;

        port userPort : UserSupportPort;
        port originSeatPort : SeatInterfacePort;
        port destinationSeatPort : SeatInterfacePort;
        port caregiverPort : ControlPort;
        port safetyPort : SafetySignalPort;

        connect userPort to surface.userSide;
        connect surface.userSide to core.loadInput;
        connect surface.leftSeatSide to core.loadOutputA;
        connect surface.rightSeatSide to core.loadOutputB;
        connect originSeatPort to surface.leftSeatSide;
        connect destinationSeatPort to surface.rightSeatSide;
        connect originSeatPort to pads.seatAContact;
        connect destinationSeatPort to pads.seatBContact;
        connect originSeatPort to alignment.seatA;
        connect destinationSeatPort to alignment.seatB;
        connect userPort to loadMonitor.sensedLoad;
        connect alignment.safetyOut to safetyPort;
        connect loadMonitor.safetyOut to safetyPort;
        connect caregiverPort to caregiverInterface.control;
        connect safetyPort to caregiverInterface.safetyIn;

        perform action prepare : PrepareTransfer;
        perform action bridge : BridgeSeatGap;
        perform action support : SupportLateralTransfer;
        perform action stop : StopTransferSafely;

        exhibit state operatingState : TransferBoardOperatingState;
    }

    requirement def TransferFunctionRequirement {
        doc /* The system shall enable lateral seated transfer of a user between two adjacent support surfaces by bridging the gap and supporting the user load throughout the transfer. */
        subject board : TransferBoardSystem;
        require constraint {
            board.supportedSeatGap <= 0.20 [m]
        }
    }

    requirement def LoadCapacityRequirement {
        doc /* The transfer board shall support a user mass of at least 150 kg with a minimum structural safety factor of 2.0. */
        subject board : TransferBoardSystem;
        require constraint {
            board.ratedUserMass >= 150.0 [kg]
        }
    }

    requirement def StabilityRequirement {
        doc /* The board shall remain frictionally stable on both seat surfaces during transfer under normal caregiver-controlled use. */
        subject board : TransferBoardSystem;
        require constraint {
            board.pads.padFrictionCoefficient >= 0.70
        }
    }

    requirement def GapAndAngleRequirement {
        doc /* The board shall support transfers across a seat gap up to 0.20 m, a height difference up to 0.10 m, and an installed angle up to 15 degrees. */
        subject board : TransferBoardSystem;
        require constraint {
            board.supportedSeatGap <= 0.20 [m] and
            board.supportedHeightDifference <= 0.10 [m] and
            board.alignment.maximumBoardAngle <= 15.0 [deg]
        }
    }

    requirement def UsabilityRequirement {
        doc /* The board shall provide hand grip cutouts sized for caregiver placement, removal, and controlled positioning. */
        subject board : TransferBoardSystem;
        require constraint {
            board.grips.gripCount >= 2 and
            board.grips.minimumGripClearance >= 0.03 [m]
        }
    }

    requirement def SurfaceRequirement {
        doc /* The user-contact surface shall permit controlled sliding while avoiding sharp edges or abrupt discontinuities. */
        subject board : TransferBoardSystem;
        require constraint {
            board.surface.surfaceFrictionCoefficient <= 0.25 and
            board.surface.edgeRadius >= 0.01 [m]
        }
    }

    requirement def SafetyMonitoringRequirement {
        doc /* The board shall report unsafe conditions when user load exceeds the rated load or seat alignment is outside permitted limits. */
        subject board : TransferBoardSystem;
        require constraint {
            board.loadMonitor.loadLimit <= board.core.maximumDistributedLoad
        }
    }

    satisfy TransferFunctionRequirement by TransferBoardSystem;
    satisfy LoadCapacityRequirement by TransferBoardSystem::core;
    satisfy StabilityRequirement by TransferBoardSystem::pads;
    satisfy GapAndAngleRequirement by TransferBoardSystem::alignment;
    satisfy UsabilityRequirement by TransferBoardSystem::grips;
    satisfy SurfaceRequirement by TransferBoardSystem::surface;
    satisfy SafetyMonitoringRequirement by TransferBoardSystem::loadMonitor;
