    import SI::*;

    alias kg for SI::kilogram;
    alias m for SI::metre;
    alias deg for SI::degree;
    alias N for SI::newton;
    alias s for SI::second;

    attribute def MassValue :> ScalarValues::Real {
        unit = kg;
    }

    attribute def LengthValue :> ScalarValues::Real {
        unit = m;
    }

    attribute def AngleValue :> ScalarValues::Real {
        unit = deg;
    }

    attribute def ForceValue :> ScalarValues::Real {
        unit = N;
    }

    attribute def TimeValue :> ScalarValues::Real {
        unit = s;
    }

    item def User {
        attribute bodyMass : MassValue;
        attribute seatedPostureStable : Boolean;
        attribute requiresAssistance : Boolean;
    }

    item def CaregiverCommand {
        attribute startTransfer : Boolean;
        attribute stopTransfer : Boolean;
        attribute emergencyStop : Boolean;
    }

    item def BoardStatus {
        attribute ready : Boolean;
        attribute locked : Boolean;
        attribute loadWithinLimit : Boolean;
        attribute surfaceDry : Boolean;
        attribute transferComplete : Boolean;
    }

