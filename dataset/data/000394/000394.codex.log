    requirement def ObstacleAvoidanceRequirement {
        subject controller : ClosedLoopController;

        require constraint {
            controller.maximumWheelVelocity <= 0.35
        }
    }

    requirement def ElectrodeInterfaceRequirement {
        subject mea : MicroElectrodeArray;

        require constraint {
            mea.electrodeCount >= 60 and mea.samplingRate >= 20000
        }
    }

    requirement def SafetyStopRequirement {
        subject supervisor : SafetySupervisor;

        require constraint {
            supervisor.emergencyStopDistance >= 0.08 and supervisor.watchdogTimeout <= 0.200
        }
    }

    part def HybrotSystem {
        attribute primaryFunction : String =
            "Use a living neural culture interfaced through a micro-electrode array to transform environmental sensor patterns into adaptive mobile robot behavior.";

        attribute closedLoopLatency : Duration = 0.080;
        attribute missionDuration : Duration = 1800.0;
        attribute nominalOperatingTemperature : Temperature = 37.0;

        part neuralCulture : LivingNeuralCulture;
        part microElectrodeArray : MicroElectrodeArray;
        part signalProcessor : NeuralSignalProcessor;
        part sensoryEncoder : SensoryEncoder;
        part controller : ClosedLoopController;
        part robotPlatform : MobileRobotPlatform;
        part sensors : EnvironmentalSensorSuite;
        part cultureSupport : CultureSupportModule;
        part safetySupervisor : SafetySupervisor;

        port environmentObservations : SensorOutputPort;
        port robotPose : PoseOutputPort;
        port cultureHealth : HealthOutputPort;

        connection sensorToEncoder
            connect sensors.sensedEnvironment to sensoryEncoder.sensorFrame;

        connection sensorToController
            connect sensors.sensedEnvironment to controller.currentSensors;

        connection sensorToSafety
            connect sensors.sensedEnvironment to safetySupervisor.sensorFrame;

        connection encoderToMEA
            connect sensoryEncoder.encodedStimulation to microElectrodeArray.stimulation;

        connection meaStimulatesCulture
            connect microElectrodeArray.stimulation to neuralCulture.sensoryStimulus;

        connection cultureSpikesToMEA
            connect neuralCulture.spontaneousAndEvokedSpikes to microElectrodeArray.neuralSpikes;

        connection meaToSignalProcessor
            connect microElectrodeArray.neuralSpikes to signalProcessor.rawSpikes;

        connection decodedIntentToController
            connect signalProcessor.decodedIntent to controller.networkIntent;

        connection controllerToRobot
            connect controller.motorCommand to robotPlatform.motorCommand;

        connection cultureHealthToSupervisor
            connect neuralCulture.health to safetySupervisor.cultureHealth;

        connection supportHealthToSupervisor
            connect cultureSupport.healthStatus to safetySupervisor.cultureHealth;

        connection poseOut
            connect robotPlatform.pose to robotPose;

        connection healthOut
            connect neuralCulture.health to cultureHealth;

        perform action encodeSensors : EncodeSensorsAsNeuralStimulation;
        perform action decodeIntent : DecodeNeuralActivityToIntent;
        perform action generateMotorCommand : GenerateClosedLoopMotorCommand;
        perform action maintainCulture : MaintainCultureHomeostasis;

        exhibit state hybrotStates : HybrotOperationalStateMachine;
    }

    satisfy PrimaryFunctionRequirement by HybrotSystem;
    satisfy ClosedLoopLatencyRequirement by HybrotSystem;
    satisfy CultureViabilityRequirement by LivingNeuralCulture;
    satisfy ObstacleAvoidanceRequirement by ClosedLoopController;
    satisfy ElectrodeInterfaceRequirement by MicroElectrodeArray;
    satisfy SafetyStopRequirement by SafetySupervisor;

    part hybrotDemonstrator : HybrotSystem {
        attribute closedLoopLatency = 0.075;
        attribute missionDuration = 1200.0;

        part neuralCulture {
            attribute neuronPopulationEstimate = 65000;
            attribute nominalMeanSpikeRate = 10.0;
            attribute minimumViability = 0.78;
        }

        part microElectrodeArray {
            attribute electrodeCount = 60;
            attribute samplingRate = 25000;
            attribute spikeDetectionThreshold = 0.000035;
        }

        part controller {
            attribute commandUpdatePeriod = 0.050;
            attribute maximumWheelVelocity = 0.30;
            attribute avoidanceTurnGain = 0.90;
            attribute explorationDriveGain = 0.40;
        }

        part robotPlatform {
            attribute wheelBase = 0.18;
            attribute wheelRadius = 0.035;
            attribute maximumAcceleration = 0.60;
        }

        part safetySupervisor {
            attribute emergencyStopDistance = 0.10;
            attribute watchdogTimeout = 0.150;
            attribute minimumCultureViability = 0.70;
        }
    }
}
