        connection processor_to_diagnostics
            connect processor.measurementOutput.measurementOut to diagnostics.measurementMonitor.measurementOut;

        connection regulator_to_diagnostics
            connect regulator.regulatedPowerOutput.powerIn to diagnostics.powerMonitor.powerIn;

        connection diagnostics_to_external
            connect diagnostics.diagnosticOutput.diagnosticOut to diagnosticsOutput.diagnosticOut;

        connection measurement_to_interface
            connect processor.measurementOutput.measurementOut to interface.measurementInput.measurementOut;

        connection diagnostics_to_interface
            connect diagnostics.diagnosticOutput.diagnosticOut to interface.diagnosticInput.diagnosticOut;

        connection interface_to_external
            connect interface.digitalOutput.frameOut to digitalDataOutput.frameOut;

        exhibit state operationalState : SensingUnitOperationalState;
    }

    requirement def MeasurePositionRequirement {
        subject sensingUnit : PositionSensingUnit;

        require constraint {
            sensingUnit.processor.minimumPosition == 0.0 [m] and
            sensingUnit.processor.maximumPosition == 0.25 [m]
        }

        doc /* The sensing unit shall measure mechanical position using an integrated position sensor over the specified linear range. */
    }

    requirement def AccuracyRequirement {
        subject sensingUnit : PositionSensingUnit;

        require constraint {
            sensingUnit.endToEndAccuracy <= 0.001 [m]
        }

        doc /* The reported position measurement shall have an end-to-end absolute accuracy of 1 mm or better after calibration. */
    }

    requirement def LatencyRequirement {
        subject sensingUnit : PositionSensingUnit;

        require constraint {
            sensingUnit.latency <= 0.010 [s]
        }

        doc /* The sensing unit shall publish a valid position measurement within 10 ms of the sampled physical position. */
    }

    requirement def OutputRateRequirement {
        subject sensingUnit : PositionSensingUnit;

        require constraint {
            sensingUnit.processor.outputRate >= 100.0 [Hz]
        }

        doc /* The sensing unit shall provide digital position output at not less than 100 Hz. */
    }

    requirement def PowerRequirement {
        subject sensingUnit : PositionSensingUnit;

        require constraint {
            sensingUnit.totalPowerConsumption <= 1.0 [W]
        }

        doc /* The sensing unit shall consume no more than 1 W during nominal measurement operation. */
    }

    requirement def DiagnosticRequirement {
        subject sensingUnit : PositionSensingUnit;

        require constraint {
            sensingUnit.diagnostics.minimumSupplyVoltage == 4.75 [V] and
            sensingUnit.diagnostics.maximumSupplyVoltage == 5.25 [V]
        }

        doc /* The sensing unit shall report diagnostic health based on regulated supply voltage, electronics temperature, signal quality, and measurement validity. */
    }

    requirement def EnvironmentalRequirement {
        subject sensingUnit : PositionSensingUnit;

        require constraint {
            sensingUnit.operatingTemperatureMin <= 233.15 [K] and
            sensingUnit.operatingTemperatureMax >= 358.15 [K]
        }

        doc /* The sensing unit shall operate across the specified environmental temperature range. */
    }

    satisfy MeasurePositionRequirement by PositionSensingUnit::sensor;
    satisfy AccuracyRequirement by PositionSensingUnit::processor;
    satisfy LatencyRequirement by PositionSensingUnit::processor;
    satisfy OutputRateRequirement by PositionSensingUnit::interface;
    satisfy PowerRequirement by PositionSensingUnit::regulator;
    satisfy DiagnosticRequirement by PositionSensingUnit::diagnostics;
    satisfy EnvironmentalRequirement by PositionSensingUnit;

    part sensingUnitInstance : PositionSensingUnit {
        attribute unitMass = 0.085;
        attribute totalPowerConsumption = 0.85 [W];
        attribute endToEndAccuracy = 0.001 [m];
        attribute latency = 0.006 [s];

        part sensor {
            attribute kind = PositionSensorKind::magnetic;
            attribute measurementRangeMin = 0.0 [m];
            attribute measurementRangeMax = 0.25 [m];
            attribute excitationVoltage = 5.0 [V];
            attribute operatingCurrent = 0.018 [A];
        }

        part processor {
            attribute sampleRate = 500.0 [Hz];
            attribute outputRate = 100.0 [Hz];
            attribute resolution = 0.0001 [m];
            attribute accuracy = 0.0005 [m];
        }

        part interface {
            attribute dataRate = 1000000.0 ["bit/s"];
            attribute updatePeriod = 0.01 [s];
        }
    }
}
