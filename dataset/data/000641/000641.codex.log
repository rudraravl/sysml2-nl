    part def NeonatalIncubator {
        attribute targetTemperature : Temperature = 37.0;
        attribute allowedTemperatureDeviation : Temperature = 0.5;
        attribute targetHumidity : RelativeHumidity = 55.0;
        attribute allowedHumidityDeviation : RelativeHumidity = 10.0;
        attribute maximumNoiseLevel : SoundPressureLevel = 45.0;
        attribute observationLightLevel : LightIntensity = 300.0;
        attribute operational : Boolean;

        port powerIn : PowerPort;
        port operatorInterface : ControlPort;
        port ambientAirIn : AirPort;
        port conditionedAirOut : AirPort;
        port alarmOut : AlarmPort;

        part enclosure : ThermalEnclosure;
        part heater : HeatingSubsystem;
        part humidifier : HumidificationSubsystem;
        part fan : AirCirculationSubsystem;
        part sensors : MonitoringSubsystem;
        part controller : IncubatorController;
        part alarmUnit : AlarmSubsystem;
        part accessPanel : InfantAccessPanel;
        part mattressTray : InfantSupportTray;
        part lighting : ObservationLighting;

        connect powerIn to controller.powerIn;
        connect powerIn to heater.powerIn;
        connect powerIn to humidifier.powerIn;
        connect powerIn to fan.powerIn;
        connect powerIn to alarmUnit.powerIn;
        connect powerIn to lighting.powerIn;

        connect ambientAirIn to fan.airIn;
        connect fan.airOut to heater.airIn;
        connect heater.airOut to humidifier.airIn;
        connect humidifier.airOut to enclosure.conditionedAirIn;
        connect enclosure.airOut to conditionedAirOut;

        connect sensors.temperatureSensor to controller.temperatureInput;
        connect sensors.humiditySensor to controller.humidityInput;
        connect sensors.doorSensor to controller.accessPanelInput;
        connect sensors.airflowSensor to controller.airflowInput;

        connect controller.heaterCommand to heater.control;
        connect controller.humidifierCommand to humidifier.control;
        connect controller.fanCommand to fan.control;
        connect controller.alarmCommand to alarmUnit.control;
        connect controller.lightCommand to lighting.control;

        connect operatorInterface to controller.operatorInterface;
        connect alarmUnit.alarmOut to alarmOut;

        action maintainControlledMicroclimate {
            in item infantCompartmentAir : Air;
            out item conditionedAir : Air;

            first startMonitoring;
            then regulateTemperature;
            then regulateHumidity;
            then circulateAir;
            then reportStatus;

            action startMonitoring {
                out item temperatureReading : SensorReading;
                out item humidityReading : SensorReading;
            }

            action regulateTemperature {
                in item temperatureReading : SensorReading;
                out item heaterCommand : ControlSignal;
            }

            action regulateHumidity {
                in item humidityReading : SensorReading;
                out item humidifierCommand : ControlSignal;
            }

            action circulateAir {
                out item fanCommand : ControlSignal;
            }

            action reportStatus {
                out item statusReading : SensorReading;
            }
        }

        state incubatorOperatingState {
            entry action initializeController;

            state Off;
            state SelfTest;
            state WarmingUp;
            state StableControl;
            state AccessOpenCompensation;
            state AlarmCondition;
            state Shutdown;

