        attribute maximumHeatingPower : ElectricalPower = 450.0;
        attribute minimumHeatingPower : ElectricalPower = 0.0;
        attribute commandedPower : ElectricalPower;

        port powerIn : PowerPort;
        port control : ControlPort;
        port airIn : AirPort;
        port airOut : AirPort;

        action convertElectricalEnergyToHeat {
            in item supply : ElectricalEnergy;
            in item command : ControlSignal;
            out item warmedAir : Air;
        }
    }

