        attribute waterReservoirCapacity : Real = 1.2;
        attribute maximumHumidityOutput : RelativeHumidity = 90.0;
        attribute commandedHumidity : RelativeHumidity;

        port powerIn : PowerPort;
        port control : ControlPort;
        port airIn : AirPort;
        port airOut : AirPort;

        action addMoistureToAir {
            in item dryAir : Air;
            in item command : ControlSignal;
            out item humidifiedAir : Air;
        }
    }

    part def AirCirculationSubsystem {
        attribute nominalFlowRate : AirFlowRate = 12.0;
        attribute minimumFlowRate : AirFlowRate = 4.0;
        attribute maximumFlowRate : AirFlowRate = 20.0;

        port powerIn : PowerPort;
        port control : ControlPort;
        port airIn : AirPort;
        port airOut : AirPort;

        action moveAirThroughIncubator {
            in item inletAir : Air;
            out item circulatingAir : Air;
        }
    }

    part def MonitoringSubsystem {
        port temperatureSensor : SensorPort;
        port humiditySensor : SensorPort;
        port airflowSensor : SensorPort;
        port doorSensor : SensorPort;

        part airTemperatureProbe : TemperatureProbe;
        part skinTemperatureProbe : TemperatureProbe;
        part humidityProbe : HumidityProbe;
        part airflowProbe : AirflowProbe;
        part accessSwitch : AccessPanelSwitch;

        connect airTemperatureProbe.measurement to temperatureSensor;
        connect humidityProbe.measurement to humiditySensor;
        connect airflowProbe.measurement to airflowSensor;
        connect accessSwitch.measurement to doorSensor;
    }

    part def TemperatureProbe {
        attribute accuracy : Temperature = 0.1;
        attribute samplePeriod : TimeDuration = 1.0;
        port measurement : SensorPort;
    }

    part def HumidityProbe {
        attribute accuracy : RelativeHumidity = 3.0;
        attribute samplePeriod : TimeDuration = 2.0;
        port measurement : SensorPort;
    }

    part def AirflowProbe {
        attribute accuracy : AirFlowRate = 0.5;
        attribute samplePeriod : TimeDuration = 2.0;
        port measurement : SensorPort;
    }

    part def AccessPanelSwitch {
        attribute openDetected : Boolean;
        port measurement : SensorPort;
    }

    part def IncubatorController {
        attribute controlLoopPeriod : TimeDuration = 1.0;
        attribute temperatureSetpoint : Temperature = 37.0;
        attribute humiditySetpoint : RelativeHumidity = 55.0;
        attribute highTemperatureAlarmLimit : Temperature = 38.0;
        attribute lowTemperatureAlarmLimit : Temperature = 36.0;
        attribute highHumidityAlarmLimit : RelativeHumidity = 75.0;
        attribute lowHumidityAlarmLimit : RelativeHumidity = 35.0;

        port powerIn : PowerPort;
        port operatorInterface : ControlPort;
        port temperatureInput : SensorPort;
        port humidityInput : SensorPort;
        port airflowInput : SensorPort;
        port accessPanelInput : SensorPort;
        port heaterCommand : ControlPort;
        port humidifierCommand : ControlPort;
        port fanCommand : ControlPort;
        port alarmCommand : ControlPort;
        port lightCommand : ControlPort;

        action computeControlCommands {
            in item temperatureReading : SensorReading;
            in item humidityReading : SensorReading;
            in item airflowReading : SensorReading;
            out item heaterCommand : ControlSignal;
            out item humidifierCommand : ControlSignal;
            out item fanCommand : ControlSignal;
            out item alarmCommand : ControlSignal;
        }

        state controlMode {
            state Startup;
            state ClosedLoopTemperatureControl;
            state ClosedLoopHumidityControl;
            state AccessCompensation;
            state FaultResponse;

            transition first Startup;
            transition startupComplete first Startup then ClosedLoopTemperatureControl;
            transition humidityEnabled first ClosedLoopTemperatureControl then ClosedLoopHumidityControl;
            transition panelOpen first ClosedLoopHumidityControl then AccessCompensation;
            transition panelClosed first AccessCompensation then ClosedLoopHumidityControl;
            transition alarmLimitExceeded first ClosedLoopTemperatureControl then FaultResponse;
            transition alarmLimitExceededWithHumidity first ClosedLoopHumidityControl then FaultResponse;
            transition resetAfterFault first FaultResponse then ClosedLoopTemperatureControl;
        }
    }

    part def AlarmSubsystem {
        attribute audibleLevel : SoundPressureLevel = 60.0;
        attribute visualIndicatorActive : Boolean;

        port powerIn : PowerPort;
        port control : ControlPort;
        port alarmOut : AlarmPort;

        action generateAlarm {
            in item alarmCommand : ControlSignal;
            out item alarmEvent : AlarmEvent;
        }
    }

    part def InfantAccessPanel {
        attribute open : Boolean;
        attribute maximumOpenTimeWithoutAlarm : TimeDuration = 60.0;
        attribute sealIntegrity : Real = 0.95;
    }

    part def InfantSupportTray {
        attribute mattressSurfaceTemperature : Temperature = 36.8;
        attribute maximumInfantMass : Real = 8.0;
        attribute removableForCleaning : Boolean = true;
    }

    part def ObservationLighting {
        attribute maximumIlluminance : LightIntensity = 600.0;
        attribute commandedIlluminance : LightIntensity = 300.0;

        port powerIn : PowerPort;
        port control : ControlPort;

        action illuminateInfantCompartment {
            in item command : ControlSignal;
        }
    }

    requirement def MaintainThermalEnvironment {
        subject incubator : NeonatalIncubator;
        require constraint {
            incubator.targetTemperature >= 36.0 and incubator.targetTemperature <= 38.0
        }
    }

    requirement def MaintainHumidityEnvironment {
        subject incubator : NeonatalIncubator;
        require constraint {
            incubator.targetHumidity >= 40.0 and incubator.targetHumidity <= 70.0
        }
    }

    requirement def ProvidePrimaryFunction {
        subject incubator : NeonatalIncubator;
        doc /* The incubator shall provide a controlled, monitored microclimate that supports neonatal thermal stability by regulating temperature, humidity, and airflow within an enclosed infant compartment. */
    }

    requirement def AlarmOnUnsafeTemperature {
        subject controller : IncubatorController;
        require constraint {
            controller.highTemperatureAlarmLimit > controller.temperatureSetpoint and
            controller.lowTemperatureAlarmLimit < controller.temperatureSetpoint
        }
    }

    requirement def LimitOperationalNoise {
        subject incubator : NeonatalIncubator;
        require constraint {
            incubator.maximumNoiseLevel <= 45.0
        }
    }

    requirement def SupportClinicalAccess {
        subject panel : InfantAccessPanel;
        require constraint {
            panel.maximumOpenTimeWithoutAlarm <= 60.0
        }
    }

    part incubatorSystem : NeonatalIncubator {
        attribute targetTemperature = 37.0;
        attribute targetHumidity = 55.0;
        attribute operational = true;
    }

    satisfy ProvidePrimaryFunction by incubatorSystem;
    satisfy MaintainThermalEnvironment by incubatorSystem;
    satisfy MaintainHumidityEnvironment by incubatorSystem;
    satisfy LimitOperationalNoise by incubatorSystem;
}
