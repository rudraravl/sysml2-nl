        }
    }

    part incubatorSystem : NeonatalIncubator {
        attribute targetTemperature = 37.0;
        attribute targetHumidity = 55.0;
        attribute operational = true;
    }

    satisfy ProvidePrimaryFunction by incubatorSystem;
    satisfy MaintainThermalEnvironment by incubatorSystem;
    satisfy MaintainHumidityEnvironment by incubatorSystem;
    satisfy LimitOperationalNoise by incubatorSystem;
}
