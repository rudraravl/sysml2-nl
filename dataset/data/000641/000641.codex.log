                first WarmingUp
                then AlarmCondition;

            transition faultDetectedDuringStableControl
                first StableControl
                then AlarmCondition;

            transition faultCleared
                first AlarmCondition
                then StableControl;

            transition operatorShutdown
                first StableControl
                then Shutdown;

            transition powerRemoved
                first Shutdown
                then Off;
        }
    }

