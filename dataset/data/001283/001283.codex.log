        attribute inputVoltageMaximum : Voltage = 28.0;
        attribute analogRailVoltage : Voltage = 3.3;
        attribute digitalRailVoltage : Voltage = 3.3;
        attribute analogRailNoise : Voltage = 0.00001;
        attribute reversePolarityProtected : Boolean = true;
    }

    action def ConvertLaserPowerToHeat {
        in item incidentRadiation : LaserRadiation;
        in absorptance : Percent;
        out item generatedHeat : HeatFlow;

        attribute absorbedPower : OpticalPower =
            incidentRadiation.opticalPower * absorptance / 100.0;
    }

    action def GenerateThermopileVoltage {
        in item heat : HeatFlow;
        in responsivity : Real;
        in offset : Voltage;
        out item voltageSignal : AnalogVoltageSignal;

        attribute thermopileVoltage : Voltage =
            heat.thermalPower * responsivity + offset;
    }

