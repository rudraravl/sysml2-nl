        in item sensorVoltage : AnalogVoltageSignal;
        in amplifierGain : Real;
        out item conditionedVoltage : AnalogVoltageSignal;

        attribute outputVoltage : Voltage = sensorVoltage.voltage * amplifierGain;
    }

    action def DigitizeSignal {
        in item conditionedVoltage : AnalogVoltageSignal;
        in referenceVoltage : Voltage;
        in resolutionBits : Integer;
        out item rawFrame : DigitalMeasurementFrame;

        attribute fullScaleCounts : Integer = 16777215;
        attribute counts : DigitalCount =
            conditionedVoltage.voltage / referenceVoltage * fullScaleCounts;
    }

    action def CorrectMeasurement {
        in item rawFrame : DigitalMeasurementFrame;
        in zeroOffset : Voltage;
        in responsivityCorrection : Real;
        in temperatureCoefficient : Real;
        out item correctedFrame : DigitalMeasurementFrame;

        attribute correctedPower : OpticalPower =
            rawFrame.measuredPower * responsivityCorrection;
    }

    state def MeasurementControlStateMachine {
        state Off;
        state Initializing;
        state Warmup;
        state Zeroing;
        state Measuring;
        state Saturated;
        state Fault;

        transition initial then Off;

        transition PowerApplied
            first Off
            accept CommandMessage
            if command.commandId == 1
            then Initializing;

        transition InitializationComplete
            first Initializing
            if true
            then Warmup;

        transition WarmupComplete
            first Warmup
            if true
            then Measuring;

        transition ZeroCommanded
            first Measuring
            accept CommandMessage
            if command.zeroRequested == true
            then Zeroing;

        transition ZeroComplete
            first Zeroing
            if true
            then Measuring;

        transition SaturationDetected
            first Measuring
            if true
            then Saturated;

        transition SaturationCleared
            first Saturated
            if true
            then Measuring;

        transition FaultDetectedFromAnyActiveState
            first Initializing
            then Fault;

        transition FaultReset
            first Fault
            accept CommandMessage
            if command.commandId == 2
            then Initializing;
    }

    part def ThermopileLaserSensor {
        port opticalIn : OpticalInputPort;
        port analogOut : AnalogSignalPort;
        port temperatureOut : AnalogSignalPort;

        part entrance : OpticalEntranceAssembly;
        part absorber : BroadbandAbsorber;
        part thermopile : ThermopileElement;
        part temperatureSensor : TemperatureSensor;

        connection entranceOpticalPath connect opticalIn to entrance.opticalIn;
        connection absorberOpticalPath connect entrance.opticalOut to absorber.opticalIn;
        connection absorberThermalPath connect absorber.thermalOut to thermopile.thermalIn;
        connection thermopileSignalPath connect thermopile.analogOut to analogOut;
        connection temperatureSignalPath connect temperatureSensor.analogOut to temperatureOut;

        perform action ConvertLaserPowerToHeat {
            in incidentRadiation = opticalIn.radiation;
            in absorptance = absorber.absorptance;
            out generatedHeat = absorber.thermalOut.heat;
        }

        perform action GenerateThermopileVoltage {
            in heat = absorber.thermalOut.heat;
            in responsivity = thermopile.responsivity;
            in offset = thermopile.darkOffsetVoltage;
            out voltageSignal = thermopile.analogOut.signal;
        }
    }

    part def ThermopileLaserSensingUnit {
        port opticalInput : OpticalInputPort;
        port externalPowerInput : ElectricalPowerInputPort;
        port commandInput : CommandPort;
        port measurementOutput : DigitalMeasurementPort;
        port statusOutput : StatusPort;

        part sensor : ThermopileLaserSensor;
        part amplifier : LowNoiseAmplifier;
        part antiAliasFilter : AntiAliasFilter;
        part adc : AnalogToDigitalConverter;
        part processor : MeasurementProcessor;
        part communication : CommunicationInterface;
        part display : DisplayIndicator;
        part power : PowerConditioning;

        attribute measuredQuantity : String = "laser optical power";
        attribute nominalWavelengthRangeLow : Wavelength = 190.0;
        attribute nominalWavelengthRangeHigh : Wavelength = 20000.0;
        attribute measurementRangeMinimum : OpticalPower = 0.0001;
        attribute measurementRangeMaximum : OpticalPower = 10.0;
        attribute expandedAccuracy : Percent = 2.0;
        attribute responseTime90Percent : Time = 1.5;
        attribute operatingTemperatureMinimum : Temperature = 0.0;
        attribute operatingTemperatureMaximum : Temperature = 50.0;

        connection opticalPath connect opticalInput to sensor.opticalIn;
        connection thermopileAnalogPath connect sensor.analogOut to amplifier.analogIn;
        connection conditionedAnalogPath connect amplifier.analogOut to antiAliasFilter.analogIn;
        connection filteredAnalogPath connect antiAliasFilter.analogOut to adc.analogIn;
        connection rawDigitalPath connect adc.digitalOut to processor.rawMeasurementIn;
        connection processedMeasurementPath connect processor.measurementOut to measurementOutput;
        connection commandPath connect commandInput to processor.commandIn;
        connection statusPath connect processor.statusOut to statusOutput;
        connection communicationMeasurementPath connect processor.measurementOut to communication.measurementIn;
        connection communicationCommandPath connect communication.commandOut to processor.commandIn;
        connection communicationStatusPath connect processor.statusOut to communication.statusIn;
        connection displayMeasurementPath connect processor.measurementOut to display.measurementIn;
        connection displayStatusPath connect processor.statusOut to display.statusIn;
        connection externalPowerPath connect externalPowerInput to power.supplyIn;
        connection analogPowerPath connect power.analogSupplyOut to amplifier.powerIn;
        connection adcPowerPath connect power.analogSupplyOut to adc.powerIn;
        connection processorPowerPath connect power.digitalSupplyOut to processor.powerIn;

        perform action AmplifyAndFilterSignal {
            in sensorVoltage = sensor.analogOut.signal;
            in amplifierGain = amplifier.gain;
            out conditionedVoltage = antiAliasFilter.analogOut.signal;
        }

        perform action DigitizeSignal {
            in conditionedVoltage = antiAliasFilter.analogOut.signal;
            in referenceVoltage = adc.referenceVoltage;
            in resolutionBits = adc.resolutionBits;
            out rawFrame = adc.digitalOut.frame;
        }

        perform action CorrectMeasurement {
            in rawFrame = adc.digitalOut.frame;
            in zeroOffset = processor.calibration.zeroOffset;
            in responsivityCorrection = processor.calibration.responsivityCorrection;
            in temperatureCoefficient = processor.calibration.temperatureCoefficient;
            out correctedFrame = processor.measurementOut.frame;
        }

        exhibit state MeasurementControlStateMachine;
    }

    requirement def MeasureLaserOpticalPowerRequirement {
        subject unit : ThermopileLaserSensingUnit;

        require constraint {
            unit.measuredQuantity == "laser optical power"
        }
    }

    requirement def SensorTechnologyRequirement {
        subject unit : ThermopileLaserSensingUnit;

        require constraint {
            unit.sensor.thermopile.thermocoupleJunctionCount >= 64
        }
    }

    requirement def MeasurementRangeRequirement {
        subject unit : ThermopileLaserSensingUnit;

        require constraint {
            unit.measurementRangeMinimum <= 0.0001 and
            unit.measurementRangeMaximum >= 10.0
        }
    }

    requirement def AccuracyRequirement {
        subject unit : ThermopileLaserSensingUnit;

        require constraint {
            abs(unit.processor.reportedPower - unit.processor.appliedPower)
            <= unit.processor.appliedPower * unit.expandedAccuracy / 100.0
        }
    }

    requirement def SpectralCoverageRequirement {
        subject unit : ThermopileLaserSensingUnit;

        require constraint {
            unit.nominalWavelengthRangeLow <= 190.0 and
            unit.nominalWavelengthRangeHigh >= 20000.0
        }
    }

    requirement def ResponseTimeRequirement {
        subject unit : ThermopileLaserSensingUnit;

        require constraint {
            unit.responseTime90Percent <= 1.5
        }
    }

    requirement def SaturationProtectionRequirement {
        subject unit : ThermopileLaserSensingUnit;

        require constraint {
            unit.processor.saturated == true implies
            unit.statusOutput.status.saturated == true
        }
    }

    requirement def OperatingTemperatureRequirement {
        subject unit : ThermopileLaserSensingUnit;

        require constraint {
            unit.operatingTemperatureMinimum <= unit.processor.internalTemperature and
            unit.processor.internalTemperature <= unit.operatingTemperatureMaximum
        }
    }

    requirement def ElectricalPowerRequirement {
        subject unit : ThermopileLaserSensingUnit;

        require constraint {
            unit.power.inputVoltageMinimum <= unit.externalPowerInput.supply.voltage and
            unit.externalPowerInput.supply.voltage <= unit.power.inputVoltageMaximum
        }
    }

    requirement def DigitalReportingRequirement {
        subject unit : ThermopileLaserSensingUnit;

        require constraint {
            unit.measurementOutput.frame.correctedPower >= 0.0 and
            unit.measurementOutput.frame.statusCode >= 0
        }
    }

    satisfy MeasureLaserOpticalPowerRequirement by ThermopileLaserSensingUnit;
    satisfy SensorTechnologyRequirement by ThermopileLaserSensingUnit::sensor;
    satisfy MeasurementRangeRequirement by ThermopileLaserSensingUnit;
    satisfy AccuracyRequirement by ThermopileLaserSensingUnit::processor;
    satisfy SpectralCoverageRequirement by ThermopileLaserSensingUnit::sensor::entrance;
    satisfy ResponseTimeRequirement by ThermopileLaserSensingUnit::sensor::absorber;
    satisfy SaturationProtectionRequirement by ThermopileLaserSensingUnit::processor;
    satisfy OperatingTemperatureRequirement by ThermopileLaserSensingUnit::sensor::temperatureSensor;
    satisfy ElectricalPowerRequirement by ThermopileLaserSensingUnit::power;
    satisfy DigitalReportingRequirement by ThermopileLaserSensingUnit::measurementOutput;
}
