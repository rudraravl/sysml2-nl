    part def TotallyImplantableCochlearImplant {
        attribute primaryFunction : String =
            "Restore functional auditory perception by sensing sound inside the implanted body, processing the signal into frequency-specific stimulation patterns, and delivering charge-balanced electrical pulses to the auditory nerve through an intracochlear electrode array.";
        attribute designLife : Time = 10 [SI::year];
        attribute hermeticCaseTemperatureLimit : TemperatureC = 39.0 ["degC"];
        attribute waterIngressProtection : String = "Fully implanted hermetic titanium/ceramic enclosure";
        attribute externalDailyWearRequired : Boolean = false;

        port soundInput : AcousticInputPort;
        port auditoryNerveOutput : NeuralInterfacePort;
        port clinicalTelemetry : TelemetryPort;
        port implantPower : PowerPort;

        part implantedMicrophone : ImplantableMicrophone;
        part acousticFeedthrough : AcousticFeedthrough;
        part signalProcessor : SoundProcessor;
        part stimulator : NeuralStimulator;
        part electrodeArray : IntracochlearElectrodeArray;
        part rechargeableBattery : RechargeableImplantBattery;
        part wirelessPowerReceiver : TranscutaneousPowerReceiver;
        part telemetryController : ImplantTelemetryController;
        part hermeticEnclosure : HermeticEnclosure;
        part safetyManager : SafetyManager;

        connect soundInput.acousticWave to implantedMicrophone.externalSound.acousticWave;
        connect implantedMicrophone.internalSound.acousticSignal to acousticFeedthrough.microphoneSignal.acousticSignal;
        connect acousticFeedthrough.conditionedAudio.audioFrame to signalProcessor.audioIn.audioFrame;
        connect signalProcessor.features.spectralEnvelope to stimulator.featureInput.spectralEnvelope;
        connect stimulator.pulseOutput.stimulationPulse to electrodeArray.electrodeInput.stimulationPulse;
        connect electrodeArray.neuralOutput.excitation to auditoryNerveOutput.excitation;

        connect rechargeableBattery.powerOutput.energy to implantPower.energy;
        connect wirelessPowerReceiver.chargeOutput.energy to rechargeableBattery.chargeInput.energy;
        connect rechargeableBattery.powerOutput.energy to signalProcessor.power.energy;
        connect rechargeableBattery.powerOutput.energy to stimulator.power.energy;
        connect rechargeableBattery.powerOutput.energy to telemetryController.power.energy;
        connect rechargeableBattery.powerOutput.energy to safetyManager.power.energy;

        connect telemetryController.telemetryLink.telemetry to clinicalTelemetry.telemetry;
        connect clinicalTelemetry.programming to telemetryController.telemetryLink.programming;
        connect telemetryController.programmingOut.programming to signalProcessor.programmingIn.programming;
        connect safetyManager.stimulationLimit.stimulationCommand to stimulator.safetyLimit.stimulationCommand;
    }

    part def ImplantableMicrophone {
        attribute sensitivity : Real = -38.0;
        attribute sensitivityUnit : String = "dBV/Pa";
        attribute noiseFloor : SoundPressureLevel = 30.0 ["dB SPL"];
