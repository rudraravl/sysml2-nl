    out item outboundRadio : RadioMessage;
  }

  port def DispatchPort {
    in item dispatchOrder : DispatchMessage;
    out item statusUpdate : RadioMessage;
  }

  port def PatientCarePort {
    inout item patient : Patient;
    out item careReport : MedicalReport;
  }

  port def SupplyPort {
    in item replenishment : MedicalSupply;
    out item consumedSupply : MedicalSupply;
  }

  port def PowerPort {
    inout item power : ElectricPower;
  }

  port def FuelPort {
    inout item fuel : Fuel;
  }

  part def FireRescueSquad51 {
    attribute callSign : String = "Squad 51";
    attribute primaryFunction : String = "Rapid paramedic response, rescue support, patient stabilization, and coordination with fire and hospital resources.";
    attribute maximumCrew : ScalarValues::Integer = 2;
    attribute responseReady : Boolean;
    attribute operationalState : SquadOperationalState;
    attribute fuelRemaining : VolumeValue;
    attribute onboardOxygenPressure : PressureValue;
    attribute medicalInventoryReadiness : Percentage;

    port dispatchRadio : DispatchPort;
    port tacticalRadio : RadioPort;
    port hospitalRadio : RadioPort;
    port patientCare : PatientCarePort;
    port supplyInterface : SupplyPort;
    port electricalInterface : PowerPort;
    port fuelInterface : FuelPort;

    part cab : CrewCab {
      attribute seatingCapacity = 2;
    }

    part chassis : RescueVehicleChassis;
    part engine : VehicleEngine;
    part warningSystem : EmergencyWarningSystem;
    part communicationSuite : CommunicationSuite;
    part medicalBay : MedicalEquipmentCompartment;
    part rescueToolCompartment : RescueToolCompartment;
    part crew : ParamedicCrew;

    connection engineFuelLine connect fuelInterface to engine.fuelInput;
    connection alternatorPower connect engine.electricalOutput to electricalInterface;
    connection radioDispatchLink connect dispatchRadio to communicationSuite.dispatchInterface;
    connection radioTacticalLink connect tacticalRadio to communicationSuite.tacticalInterface;
    connection radioHospitalLink connect hospitalRadio to communicationSuite.hospitalInterface;
    connection patientTreatmentFlow connect patientCare to medicalBay.patientCareInterface;
    connection supplyFlow connect supplyInterface to medicalBay.supplyInterface;

    perform action respondToIncident;
    perform action stabilizePatient;
    perform action transmitHospitalReport;
  }

  part def CrewCab {
    attribute seatingCapacity : ScalarValues::Integer;
    attribute hasMapLight : Boolean = true;
    attribute hasMobileDataTerminal : Boolean = true;

    port electricalPower : PowerPort;
    port crewVoiceRadio : RadioPort;
  }

  part def RescueVehicleChassis {
    attribute grossVehicleMass : MassValue;
    attribute wheelBase : LengthValue;
    attribute roadSpeed : SpeedValue;
    attribute brakingDistance : LengthValue;
  }

  part def VehicleEngine {
    attribute ratedPower : PowerValue;
    attribute fuelConsumptionRate : VolumeFlowRateValue;
    attribute coolantTemperature : TemperatureValue;

    port fuelInput : FuelPort;
    port electricalOutput : PowerPort;
  }

  part def EmergencyWarningSystem {
    attribute sirenEnabled : Boolean;
    attribute warningLightsEnabled : Boolean;
    attribute publicAddressEnabled : Boolean;

    port electricalPower : PowerPort;
  }

  part def CommunicationSuite {
    attribute dispatchChannel : String = "LACoFD Dispatch";
    attribute tacticalChannel : String = "Fireground Tactical";
    attribute hospitalChannel : String = "Base Hospital";
    attribute radioPowerOutput : PowerValue;

    port dispatchInterface : DispatchPort;
    port tacticalInterface : RadioPort;
    port hospitalInterface : RadioPort;
    port electricalPower : PowerPort;
  }

  part def MedicalEquipmentCompartment {
    attribute oxygenCylinderCount : ScalarValues::Integer = 2;
    attribute drugBoxSealed : Boolean;
    attribute defibrillatorReady : Boolean;
    attribute traumaKitReady : Boolean;

    port patientCareInterface : PatientCarePort;
    port supplyInterface : SupplyPort;
    port electricalPower : PowerPort;

    part cardiacMonitor : CardiacMonitor;
    part oxygenSystem : OxygenDeliverySystem;
    part medicationKit : MedicationKit;
    part traumaKit : TraumaKit;
  }

  part def CardiacMonitor {
    attribute batteryCharge : Percentage;
    attribute ecgLeadCount : ScalarValues::Integer = 4;
    attribute defibrillationEnergy : EnergyValue;
    port patientConnection : PatientCarePort;
    port electricalPower : PowerPort;
  }

  part def OxygenDeliverySystem {
    attribute regulatorPressure : PressureValue;
    attribute flowRate : VolumeFlowRateValue;
    attribute maskAvailable : Boolean;
    port patientConnection : PatientCarePort;
  }

  part def MedicationKit {
    attribute epinephrineDoses : ScalarValues::Integer;
    attribute atropineDoses : ScalarValues::Integer;
    attribute analgesicDoses : ScalarValues::Integer;
    attribute ivFluidVolume : VolumeValue;
    port supplyInterface : SupplyPort;
  }

  part def TraumaKit {
    attribute bandageCount : ScalarValues::Integer;
    attribute splintCount : ScalarValues::Integer;
    attribute burnSheetCount : ScalarValues::Integer;
    attribute airwayAdjunctCount : ScalarValues::Integer;
    port patientConnection : PatientCarePort;
  }

  part def RescueToolCompartment {
    attribute forcibleEntryToolCount : ScalarValues::Integer;
    attribute ropeLength : LengthValue;
    attribute fireExtinguisherPressure : PressureValue;
    attribute sceneLightAvailable : Boolean;

    port electricalPower : PowerPort;
  }

  part def ParamedicCrew {
    attribute leadParamedicName : String;
    attribute partnerParamedicName : String;
    attribute certificationLevel : String = "Paramedic";
    attribute crewRested : Boolean;

    port crewRadio : RadioPort;
    port patientCare : PatientCarePort;
  }

  action def ReceiveDispatch {
    in item order : DispatchMessage;
    out item acknowledgement : RadioMessage;
  }

  action def NavigateToIncident {
    in item order : DispatchMessage;
    out attribute estimatedArrivalTimeMinutes : TimeValue;
  }

  action def SecureScene {
    in item order : DispatchMessage;
    out attribute sceneSafe : Boolean;
  }

  action def AssessPatient {
    inout item patient : Patient;
    out item assessedPatient : Patient;
  }

  action def StabilizePatient {
    inout item patient : Patient;
    in item supplies : MedicalSupply;
    out item treatedPatient : Patient;
  }

  action def CoordinateTransport {
    in item patient : Patient;
    out item report : MedicalReport;
  }

  action def ReturnToService {
    in item consumedSupply : MedicalSupply;
    out attribute readyForNextCall : Boolean;
  }

  action respondToIncident : ReceiveDispatch then NavigateToIncident then SecureScene;

  action stabilizePatient : AssessPatient then StabilizePatient then CoordinateTransport;

  action transmitHospitalReport {
    in item patient : Patient;
    out item report : MedicalReport;

    first start;
    then buildReport;
    then sendReport;
    then done;

    action buildReport {
      in item patient : Patient;
      out item report : MedicalReport;
    }

    action sendReport {
      in item report : MedicalReport;
      out item transmission : RadioMessage;
    }
  }

  state def Squad51Operations {
    attribute currentState : SquadOperationalState;

    entry; then InQuarters;

    state InQuarters;
    state Dispatched;
    state Responding;
    state OnScene;
    state TreatingPatient;
    state TransportCoordination;
    state Returning;
    state OutOfService;

    transition acceptDispatch
      first InQuarters
      accept DispatchMessage
      then Dispatched;

    transition beginResponse
      first Dispatched
      then Responding;

    transition arriveScene
      first Responding
      then OnScene;

    transition beginTreatment
      first OnScene
      then TreatingPatient;

    transition requestAmbulanceOrHospitalContact
      first TreatingPatient
      then TransportCoordination;

    transition patientReleasedToTransport
      first TransportCoordination
      then Returning;

    transition availableAgain
      first Returning
      then InQuarters;

    transition mechanicalOrSupplyFailure
      first InQuarters
      then OutOfService;

    transition restoredToService
      first OutOfService
      then InQuarters;
  }

  requirement def PrimaryMissionRequirement {
    subject squad : FireRescueSquad51;

    require constraint {
      squad.responseReady == true
    }

    doc /* Squad 51 shall provide a rapid two-person paramedic response capability for emergency incidents, with the primary high-level function of reaching the scene quickly, assessing patients, stabilizing life-threatening conditions, coordinating with fire companies and hospitals, and preparing the patient for transport by ambulance. */
  }

  requirement def CommunicationsRequirement {
    subject suite : CommunicationSuite;

    require constraint {
      suite.dispatchChannel != "" and suite.hospitalChannel != ""
    }

    doc /* The communication suite shall support dispatch coordination, fireground communication, and base hospital medical consultation. */
  }

  requirement def MedicalReadinessRequirement {
    subject compartment : MedicalEquipmentCompartment;

    require constraint {
      compartment.defibrillatorReady == true and compartment.traumaKitReady == true
    }

    doc /* The medical equipment compartment shall maintain ready access to cardiac monitoring, oxygen delivery, medications, trauma supplies, and patient assessment equipment. */
  }

  requirement def CrewRequirement {
