  }

  requirement def ResponseIntegrationRequirement {
    subject squad : FireRescueSquad51;

    require constraint {
      squad.maximumCrew == 2
    }

    doc /* Squad 51 shall operate as a compact rescue and paramedic unit that supplements engines, trucks, ambulances, hospitals, and dispatch rather than serving as the primary patient transport vehicle. */
  }

