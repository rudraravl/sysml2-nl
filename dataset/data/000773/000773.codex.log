    attribute vitalSigns : VitalSigns;
    attribute conditionSummary : String;
  }

  item def MedicalReport {
    attribute patientIdentifier : String;
    attribute incidentIdentifier : String;
    attribute assessmentText : String;
    attribute treatmentText : String;
    attribute destinationHospital : String;
  }

  item def DispatchMessage {
    attribute incidentIdentifier : String;
    attribute locationText : String;
    attribute incidentType : IncidentType;
    attribute priority : PriorityLevel;
    attribute requestedResources : String;
  }

  item def RadioMessage {
    attribute channelName : String;
    attribute senderCallSign : String;
    attribute receiverCallSign : String;
    attribute messageText : String;
  }

  item def MedicalSupply {
    attribute supplyName : String;
    attribute quantity : ScalarValues::Integer;
    attribute expirationDate : String;
  }

  item def ElectricPower {
    attribute voltage : ElectricPotential;
    attribute current : ElectricCurrent;
  }

  item def Fuel {
    attribute volume : VolumeValue;
  }

  item def VitalSigns {
    attribute heartRate : FrequencyValue;
    attribute respiratoryRate : FrequencyValue;
    attribute systolicPressure : PressureValue;
    attribute diastolicPressure : PressureValue;
    attribute oxygenSaturation : Percentage;
