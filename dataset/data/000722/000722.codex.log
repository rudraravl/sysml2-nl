    attribute def Temperature :> ISQ::thermodynamicTemperature {
        unit = SI::degreeCelsius;
    }

    attribute def TimeDuration :> ISQ::time {
        unit = SI::second;
    }

    attribute def Angle :> ISQ::planeAngle {
        unit = SI::degree;
    }

    enum def PowerMode {
        enum off;
        enum standby;
        enum examination;
        enum lowBattery;
        enum fault;
    }

    enum def SpeculumStatus {
