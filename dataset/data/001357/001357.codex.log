    }

    part def RefrigeratedStorageUnit {
        attribute currentTemperature : TemperatureCelsius = 4.0;
        attribute compressorDutyCycle : Percent = 35.0;
        attribute maximumAllowedTemperature : TemperatureCelsius = 8.0;
        attribute minimumAllowedTemperature : TemperatureCelsius = 1.0;

        port storagePort : EnvironmentControlPort;
        port environmentPort : EnvironmentControlPort;
        port powerPort : PowerPort;

        action regulateTemperature {
            in measuredTemperature : TemperatureCelsius;
            out coolingCommand : Boolean;
        }

        state machine refrigerationControl {
            state monitoring;
            state cooling;
            state temperatureAlarm;

            transition first monitoring;
            transition monitoring then cooling
                accept temperatureAboveTarget;
            transition cooling then monitoring
                accept temperatureAtTarget;
            transition monitoring then temperatureAlarm
                accept temperatureOutOfRange;
            transition cooling then temperatureAlarm
                accept coolingFailure;
            transition temperatureAlarm then monitoring
                accept serviceClearedAlarm;
        }
    }

    part def SecurityAccessUnit {
        attribute frontDoorState : DoorState = DoorState::locked;
        attribute serviceDoorState : DoorState = DoorState::locked;
        attribute tamperDetected : Boolean = false;

        port accessPort : AccessControlPort;

        action validateServiceAccess {
            in credential : CustomerCredential;
            out accessGranted : Boolean;
        }

        action lockAllDoors {
            out frontDoorState : DoorState;
            out serviceDoorState : DoorState;
        }
    }

    part def RemoteOperationsGateway {
        attribute cellularSignalStrength : Percent = 92.0;
        attribute telemetryUploadPeriod : TimeSecond = 60.0;
        attribute offlineBufferCapacity : Count = 1000;

        port localTelemetryPort : NetworkServicePort;
        port remoteNetworkPort : NetworkServicePort;
        port powerPort : PowerPort;

        action uploadTelemetry {
            in report : TelemetryReport;
            out uploadAccepted : Boolean;
        }

        action receiveMaintenanceCommand {
            out command : MaintenanceCommand;
        }

        action publishReceipt {
            in receipt : Receipt;
            out delivered : Boolean;
        }
    }

    part def PowerManagementUnit {
        attribute nominalInputVoltage : Real = 120.0;
        attribute peakPowerWatts : Real = 1500.0;
        attribute backupRuntime : TimeSecond = 900.0;
        attribute energyConsumedToday : EnergyKilowattHour = 0.0;

        port inputPowerPort : PowerPort;
        port controlledPowerPort : PowerPort;

        action shedNoncriticalLoads {
            in powerAvailable : Boolean;
            out displayEnabled : Boolean;
            out refrigerationEnabled : Boolean;
            out paymentEnabled : Boolean;
        }
    }

    requirement def PrimaryFunctionRequirement {
        doc /* The automated retail system shall autonomously sell stocked retail products by presenting a catalog, accepting customer selections, authorizing payment, dispensing purchased items, updating inventory, issuing a receipt, and reporting operational status. */
        subject kiosk : AutomatedRetailKiosk;
    }

    requirement def PaymentAuthorizationRequirement {
        doc /* The system shall authorize cashless payment before dispensing any selected product. */
        subject controller : RetailTransactionController;
        require constraint {
            controller.currentOrderStatus == OrderStatus::paymentAuthorized
        }
    }

    requirement def DispenseVerificationRequirement {
        doc /* The system shall confirm physical delivery of each purchased product using dispense sensors before completing the order. */
        subject dispenser : ProductDispensingUnit;
    }

    requirement def InventoryAccuracyRequirement {
        doc /* The system shall decrement inventory count for each successfully dispensed product and generate a low-stock alert when remaining quantity is below threshold. */
        subject inventory : InventoryManager;
    }

    requirement def RefrigerationRequirement {
        doc /* Products requiring refrigeration shall be stored between 1 degC and 8 degC during normal operation. */
        subject refrigeration : RefrigeratedStorageUnit;
        require constraint {
            refrigeration.currentTemperature >= refrigeration.minimumAllowedTemperature and
            refrigeration.currentTemperature <= refrigeration.maximumAllowedTemperature
        }
    }

    requirement def AvailabilityReportingRequirement {
        doc /* The system shall transmit availability, temperature, payment success, energy, alarm, and inventory telemetry to remote operations at least once every 60 seconds while network service is available. */
        subject gateway : RemoteOperationsGateway;
    }

    requirement def CustomerSafetyRequirement {
        doc /* Customer-accessible doors shall remain locked except during authorized product retrieval or approved maintenance access. */
        subject security : SecurityAccessUnit;
    }

    satisfy PrimaryFunctionRequirement by AutomatedRetailKiosk;
    satisfy PaymentAuthorizationRequirement by RetailTransactionController;
    satisfy DispenseVerificationRequirement by ProductDispensingUnit;
    satisfy InventoryAccuracyRequirement by InventoryManager;
    satisfy RefrigerationRequirement by RefrigeratedStorageUnit;
    satisfy AvailabilityReportingRequirement by RemoteOperationsGateway;
    satisfy CustomerSafetyRequirement by SecurityAccessUnit;

    package OperationalScenario {
        part kiosk : AutomatedRetailKiosk {
            attribute machineId : Identifier = "AR-KIOSK-CHICAGO-001";
            attribute availability : MachineAvailability = MachineAvailability::available;
        }

        item bottledWater : ProductItem {
            attribute sku : Identifier = "BEV-WATER-500";
            attribute name : String = "Still Water 500 mL";
            attribute category : ProductCategory = ProductCategory::beverage;
            attribute unitPrice : Money = 1.75;
            attribute mass : MassGram = 525.0;
            attribute volume : VolumeMilliliter = 500.0;
            attribute requiresRefrigeration : Boolean = true;
            attribute minimumStorageTemperature : TemperatureCelsius = 1.0;
            attribute maximumStorageTemperature : TemperatureCelsius = 8.0;
        }

        item proteinBar : ProductItem {
            attribute sku : Identifier = "SNK-PROTEIN-060";
            attribute name : String = "Protein Bar 60 g";
            attribute category : ProductCategory = ProductCategory::snack;
            attribute unitPrice : Money = 2.95;
            attribute mass : MassGram = 60.0;
            attribute volume : VolumeMilliliter = 120.0;
            attribute requiresRefrigeration : Boolean = false;
            attribute minimumStorageTemperature : TemperatureCelsius = 5.0;
            attribute maximumStorageTemperature : TemperatureCelsius = 30.0;
        }

        action customerPurchase {
            out finalStatus : OrderStatus;

            first start;
            then browseCatalog;
            then selectProducts;
            then calculateTotal;
            then authorizePayment;
            then reserveInventory;
            then dispenseItems;
            then verifyDispense;
            then decrementInventory;
            then issueReceipt;
            then reportTelemetry;
            then done;

            flow bottledWater to selectProducts;
            flow proteinBar to selectProducts;
