        attribute availability : MachineAvailability = MachineAvailability::available;
        attribute maximumBasketItems : Count = 12;
        attribute targetRefrigeratedTemperature : TemperatureCelsius = 4.0;
        attribute maximumTransactionDuration : TimeSecond = 180.0;

        port customerInterface : CustomerInteractionPort;
        port paymentService : PaymentPort;
        port productDispense : DispensePort;
        port inventoryService : InventoryPort;
        port environmentService : EnvironmentControlPort;
        port networkService : NetworkServicePort;
        port electricalPower : PowerPort;

        part userInterface : TouchscreenInterface;
        part cardReader : CashlessPaymentTerminal;
        part controller : RetailTransactionController;
        part inventory : InventoryManager;
        part dispenser : ProductDispensingUnit;
        part refrigeration : RefrigeratedStorageUnit;
        part security : SecurityAccessUnit;
        part telemetryGateway : RemoteOperationsGateway;
        part powerSubsystem : PowerManagementUnit;

        connect customerInterface to userInterface.customerPort;
        connect userInterface.transactionPort to controller.customerCommandPort;
        connect controller.paymentRequestPort to cardReader.paymentPort;
        connect cardReader.externalPaymentPort to paymentService;
        connect controller.dispenseCommandPort to dispenser.dispensePort;
        connect dispenser.externalDispensePort to productDispense;
        connect controller.inventoryCommandPort to inventory.inventoryPort;
        connect inventory.externalInventoryPort to inventoryService;
        connect inventory.storageConditionPort to refrigeration.storagePort;
        connect refrigeration.environmentPort to environmentService;
        connect controller.securityCommandPort to security.accessPort;
        connect controller.telemetryPort to telemetryGateway.localTelemetryPort;
        connect telemetryGateway.remoteNetworkPort to networkService;
        connect electricalPower to powerSubsystem.inputPowerPort;
        connect powerSubsystem.controlledPowerPort to controller.powerPort;
        connect powerSubsystem.controlledPowerPort to userInterface.powerPort;
        connect powerSubsystem.controlledPowerPort to cardReader.powerPort;
        connect powerSubsystem.controlledPowerPort to dispenser.powerPort;
        connect powerSubsystem.controlledPowerPort to refrigeration.powerPort;
        connect powerSubsystem.controlledPowerPort to telemetryGateway.powerPort;
    }

    part def TouchscreenInterface {
        attribute screenBrightness : Percent = 85.0;
        attribute supportsAudioPrompt : Boolean = true;
