            in updatedProduct : ProductItem;
            out catalogProduct : ProductItem;
        }
    }

    part def ProductDispensingUnit {
        attribute motorCount : Count = 24;
        attribute maximumDispenseMass : MassGram = 2500.0;
        attribute averageDispenseTime : TimeSecond = 6.0;

