    satisfy DisposalHygieneRequirement by DrainableClosure;

    assert constraint CapacityConstraint {
        CollectionPouch::capacity >= OstomySystem::minimumUsableCapacity
    }

    assert constraint PressureConstraint {
        CollectionPouch::internalPressure <= OstomySystem::maximumComfortPressure
    }

    assert constraint FilterConstraint {
        OdorFilter::odorPermeability <= 0.10
    }

    assert constraint SealConstraint {
        SkinBarrier::adhesiveStrength >= 8.0 implies SkinBarrier::sealState == SealIntegrity::intact
    }

    assert constraint DrainageConstraint {
        DrainableClosure::maxDrainRate >= 300.0
    }

