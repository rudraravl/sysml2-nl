    transition Measuring then Ready accept MeasurementStopped;
    transition Measuring then Fault accept SignalSaturated;
    transition Ready then Fault accept TemperatureOutOfRange;
    transition Fault then PowerOnSelfTest accept ResetRequested;
    transition Ready then Off accept PowerRemoved;
    transition Fault then Off accept PowerRemoved;
  }

  requirement def PrimaryFunctionRequirement {
    doc /* The accelerometer shall sense acceleration applied to its mounting port and output a calibrated digital acceleration sample representing the applied mechanical acceleration along the configured measurement axis. */
    subject sensor : PiezoelectricAccelerometer;

    require constraint {
      sensor.measurementPort.accelerationSample.valid == true
    }
  }

  requirement def BandwidthRequirement {
    doc /* The accelerometer shall measure dynamic acceleration over the usable frequency band from 0.5 Hz to 5000 Hz. */
    subject sensor : PiezoelectricAccelerometer;

    require constraint {
      sensor.usableBandwidthLow.value <= 0.5 and
      sensor.usableBandwidthHigh.value >= 5000.0
    }
  }

  requirement def SensitivityRequirement {
    doc /* The accelerometer shall provide nominal sensitivity of 100 mV/g for conversion of mechanical acceleration into electrical signal. */
    subject sensor : PiezoelectricAccelerometer;

    require constraint {
      sensor.nominalSensitivity.value == 100.0
    }
  }

  requirement def OperatingTemperatureRequirement {
    doc /* The accelerometer shall operate from -40 degC to 125 degC. */
    subject sensor : PiezoelectricAccelerometer;

    require constraint {
      sensor.operatingTemperatureLow.value <= -40.0 and
      sensor.operatingTemperatureHigh.value >= 125.0
    }
  }

  part accelerometerSystem : PiezoelectricAccelerometer;

