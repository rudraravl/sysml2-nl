    part mass : SeismicMass;
    part piezoStack : PiezoelectricElement;
    part amplifier : ChargeAmplifier;
    part filter : SignalFilter;
    part adc : AnalogToDigitalConverter;
    part temperatureSensor : TemperatureSensor;

