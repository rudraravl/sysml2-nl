    connect housing.mountingInterface to mass.motionInput;
    connect mass.motionInput to piezoStack.strainInput;
    connect piezoStack.chargeOutput to amplifier.chargeInput;
    connect amplifier.voltageOutput to filter.rawAnalogInput;
    connect filter.conditionedAnalogOutput to adc.analogInput;
    connect adc.digitalOutput to measurementPort;
    connect powerPort to amplifier.powerInput;
    connect powerPort to adc.powerInput;

    perform action convertAcceleration : ConvertMechanicalAccelerationToDigitalSample;
    exhibit state operatingState : AccelerometerOperationalState;
  }

  action def ConvertMechanicalAccelerationToDigitalSample {
    in item appliedAcceleration : MechanicalAccelerationSignal;
    in item supply : PowerInput;
    out item measuredAcceleration : DigitalAccelerationSample;

    first start;
    then generateCharge;
    then amplifyCharge;
    then filterSignal;
    then digitizeSignal;
    then compensateTemperature;
    then publishSample;

    action generateCharge {
      in item appliedAcceleration : MechanicalAccelerationSignal;
      out item chargeSignal : PiezoelectricChargeSignal;
    }

    action amplifyCharge {
      in item chargeSignal : PiezoelectricChargeSignal;
      out item voltageSignal : AnalogVoltageSignal;
    }

    action filterSignal {
      in item voltageSignal : AnalogVoltageSignal;
      out item conditionedVoltage : AnalogVoltageSignal;
    }

