    requirement def DistributedCoordinationRequirement {
        subject voxel : ProgrammableMatterVoxel;
        require constraint {
            voxel.maxBondForce >= 1.5 [N]
        }
    }

    requirement def EnergyContinuityRequirement {
        subject mesh : EnergyDistributionMesh;
        require constraint {
            mesh.minimumReserveEnergy >= 5000.0 [J]
        }
    }

    satisfy PrimaryFunctionRequirement by ProgrammableMatterAssembly;
    satisfy ShapeReconfigurationRequirement by ProgrammableMatterAssembly;
    satisfy VoxelResolutionRequirement by ProgrammableMatterAssembly;
    satisfy StructuralLoadRequirement by ProgrammableMatterAssembly;
    satisfy ThermalSafetyRequirement by ProgrammableMatterAssembly;
    satisfy DistributedCoordinationRequirement by ProgrammableMatterVoxel;
    satisfy EnergyContinuityRequirement by EnergyDistributionMesh;
}
