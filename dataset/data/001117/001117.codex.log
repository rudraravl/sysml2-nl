        }

        doc "The controller shall detect open-circuit, short-circuit, and saturated sensor voltage conditions outside the valid calibrated sensor range."
    }

    satisfy MeasureLeafWetnessRequirement by LeafSensingUnit;
    satisfy SamplingRequirement by LeafSensingUnit;
    satisfy AccuracyRequirement by LeafSensingUnit;
    satisfy StartupRequirement by LeafSensingUnit;
    satisfy PowerRequirement by LeafSensingUnit;
    satisfy FaultDetectionRequirement by ProcessingController;

    part leafWetnessSensingUnit : LeafSensingUnit;

