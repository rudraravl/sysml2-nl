        }

        doc "The sensing unit shall consume no more than 35 mA typical current at 3.3 V during periodic measurement operation."
    }

    requirement def FaultDetectionRequirement {
        subject controller : ProcessingController;

        require constraint {
            controller.faultVoltageLow < controller.dryCalibrationVoltage and
