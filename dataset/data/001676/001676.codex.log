    import SI::*;
    import ISQ::*;

    attribute def Temperature {
        :> ScalarValues::Real;
        unit = "degC";
    }

    attribute def Pressure {
        :> ScalarValues::Real;
        unit = "bar";
    }

    attribute def Power {
        :> ScalarValues::Real;
        unit = "kW";
    }

    attribute def Voltage {
        :> ScalarValues::Real;
        unit = "V";
    }

    attribute def Current {
        :> ScalarValues::Real;
        unit = "mA";
    }

    attribute def Percentage {
        :> ScalarValues::Real;
        unit = "%";
    }

    attribute def TimeDuration {
        :> ScalarValues::Real;
        unit = "s";
    }

    attribute def Frequency {
        :> ScalarValues::Real;
        unit = "Hz";
    }

    item def OpenThermFrame {
        attribute messageType : Integer;
        attribute dataId : Integer;
        attribute dataValue : Integer;
        attribute parityBit : Boolean;
        attribute validChecksum : Boolean;
