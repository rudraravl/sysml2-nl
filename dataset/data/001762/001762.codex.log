    requirement def UtilityContinuityRequirement {
        doc /* The system shall coordinate electricity, water, sanitation, and drainage services to support households, institutions, markets, and emergency operations. */
    }

    requirement def EconomicSupportRequirement {
        doc /* The system shall support agricultural, fishery, market, and small-industry flows between upazilas and regional trade corridors. */
    }

    satisfy DistrictPurposeRequirement by ComillaDistrictSystem;
    satisfy CitizenServiceRequirement by ComillaDistrictSystem.administration;
    satisfy EmergencyResponseRequirement by ComillaDistrictSystem.administration.disasterManagementCell;
    satisfy MobilityRequirement by ComillaDistrictSystem.transport;
    satisfy UtilityContinuityRequirement by ComillaDistrictSystem.utilities;
    satisfy EconomicSupportRequirement by ComillaDistrictSystem.economy;

    analysis def DistrictCapacityAnalysis {
        subject district : ComillaDistrictSystem;

        objective evaluateAdministrativeCoverage {
            doc /* Determine whether population, office capacity, transport capacity, utility reliability, and emergency resources are sufficient for daily district operation. */
        }

        constraint populationServedPerStaff {
            district.population / district.administration.administrativeStaff <= 1500;
        }

        constraint minimumUtilityReliability {
            district.utilities.electricDistributionNetwork.reliabilityRate >= 95.0;
        }

        constraint emergencyShelterCoverage {
            district.administration.disasterManagementCell.shelters >= 250;
        }

        constraint transportCapacityAdequacy {
            district.transport.dhakaChattogramHighwaySegment.dailyVehicleCapacity >= 75000;
        }
    }

}
