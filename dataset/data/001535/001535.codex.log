            attribute peakTorque = 100 [SI::newtonMetre];
            attribute continuousTorque = 45 [SI::newtonMetre];
            attribute maxSpeed = 420 [SI::degreePerSecond];
            attribute reflectedMass = 1.2 [SI::kilogram];
        }

        part leftAnkleActuator : JointActuator {
            attribute joint = JointName::leftAnkle;
            attribute peakTorque = 85 [SI::newtonMetre];
            attribute continuousTorque = 35 [SI::newtonMetre];
            attribute maxSpeed = 500 [SI::degreePerSecond];
            attribute reflectedMass = 1.0 [SI::kilogram];
        }

        part rightAnkleActuator : JointActuator {
            attribute joint = JointName::rightAnkle;
            attribute peakTorque = 85 [SI::newtonMetre];
            attribute continuousTorque = 35 [SI::newtonMetre];
            attribute maxSpeed = 500 [SI::degreePerSecond];
            attribute reflectedMass = 1.0 [SI::kilogram];
        }

        connect battery.powerOut to powerDistribution.batteryPowerIn;
        connect powerDistribution.controllerPowerOut to controller.batteryStatusIn;
        connect powerDistribution.hipPowerOut to leftHipActuator.powerIn;
        connect powerDistribution.hipPowerOut to rightHipActuator.powerIn;
        connect powerDistribution.kneePowerOut to leftKneeActuator.powerIn;
        connect powerDistribution.kneePowerOut to rightKneeActuator.powerIn;
        connect powerDistribution.anklePowerOut to leftAnkleActuator.powerIn;
        connect powerDistribution.anklePowerOut to rightAnkleActuator.powerIn;

        connect userInterface.intentOut to controller.userIntentIn;
        connect imu.intentContributionOut to controller.imuIntentIn;
        connect footSensors.contactOut to controller.groundContactIn;

        connect controller.leftHipCommandOut to leftHipActuator.commandIn;
        connect controller.rightHipCommandOut to rightHipActuator.commandIn;
        connect controller.leftKneeCommandOut to leftKneeActuator.commandIn;
        connect controller.rightKneeCommandOut to rightKneeActuator.commandIn;
        connect controller.leftAnkleCommandOut to leftAnkleActuator.commandIn;
        connect controller.rightAnkleCommandOut to rightAnkleActuator.commandIn;

        connect battery.faultOut to controller.faultIn;
        connect powerDistribution.faultOut to controller.faultIn;
        connect imu.faultOut to controller.faultIn;
        connect footSensors.faultOut to controller.faultIn;
        connect controller.faultOut to userInterface.faultIn;
    }

    action def EstimateUserIntent {
        in item userInput : BiomechanicalIntent;
        in item inertialInput : BiomechanicalIntent;
        in item groundContact : GroundContactTelemetry;
        out item fusedIntent : BiomechanicalIntent;
    }

    action def ComputeAssistiveJointCommands {
        in item fusedIntent : BiomechanicalIntent;
        in item jointFeedback : JointMotionTelemetry;
        out item hipCommand : JointMotionCommand;
        out item kneeCommand : JointMotionCommand;
        out item ankleCommand : JointMotionCommand;
    }

    action def ApplyPoweredAssistance {
        in item command : JointMotionCommand;
        in item electricalPower : ElectricalPower;
        out item telemetry : JointMotionTelemetry;
    }

    action def EnterFaultSafeMode {
        in item fault : SafetyFault;
        out item limitedCommand : JointMotionCommand;
    }

    action def AugmentLowerBodyMovement {
        part exoskeleton : PoweredExoskeleton;

        first start;
        then estimateIntent : EstimateUserIntent;
        then computeCommands : ComputeAssistiveJointCommands;
        then applyAssistance : ApplyPoweredAssistance;
        then monitorSafety;
        then done;

        flow estimateIntent.fusedIntent to computeCommands.fusedIntent;
        flow computeCommands.hipCommand to applyAssistance.command;
    }

    state def ExoskeletonOperationalState {
        entry action initializeController;
        exit action storeSessionSummary;

        state poweredOff;
        state selfTest;
        state standingIdle;
        state walkingAssist;
        state liftingAssist;
        state stairAssist;
        state sitStandAssist;
        state degradedAssist;
        state faultSafeShutdown;
        state maintenanceMode;

        transition first poweredOff;
        transition poweredOff then selfTest
            accept after 1 [SI::second];

        transition selfTest then standingIdle
            if batteryReady and sensorsReady and actuatorsReady;

        transition selfTest then faultSafeShutdown
            if not batteryReady or not sensorsReady or not actuatorsReady;

        transition standingIdle then walkingAssist
            accept item intent : BiomechanicalIntent
            if intent.desiredMode == OperatingMode::assistWalking;

        transition standingIdle then liftingAssist
            accept item intent : BiomechanicalIntent
            if intent.desiredMode == OperatingMode::assistLifting;

        transition standingIdle then stairAssist
            accept item intent : BiomechanicalIntent
            if intent.desiredMode == OperatingMode::stairClimb;

        transition standingIdle then sitStandAssist
            accept item intent : BiomechanicalIntent
            if intent.desiredMode == OperatingMode::sitStand;

        transition walkingAssist then standingIdle
            if userStopped and bothFeetStable;

        transition liftingAssist then standingIdle
            if loadReleased and postureStable;

        transition stairAssist then standingIdle
            if levelGroundDetected;

        transition sitStandAssist then standingIdle
            if uprightStable or seatedStable;

        transition walkingAssist then degradedAssist
            accept item fault : SafetyFault
            if fault.severity == FaultSeverity::degraded;

        transition liftingAssist then degradedAssist
            accept item fault : SafetyFault
            if fault.severity == FaultSeverity::degraded;

        transition degradedAssist then faultSafeShutdown
            accept item fault : SafetyFault
            if fault.severity == FaultSeverity::critical;

        transition walkingAssist then faultSafeShutdown
            accept item fault : SafetyFault
            if fault.severity == FaultSeverity::critical;

        transition liftingAssist then faultSafeShutdown
            accept item fault : SafetyFault
            if fault.severity == FaultSeverity::critical;

        transition stairAssist then faultSafeShutdown
            accept item fault : SafetyFault
            if fault.severity == FaultSeverity::critical;

        transition faultSafeShutdown then maintenanceMode
            accept after 5 [SI::second];
    }

    requirement def PrimaryFunctionRequirement {
        subject exoskeleton : PoweredExoskeleton;

        require constraint {
            exoskeleton.ratedAssistPower >= 500 [SI::watt]
        }

        doc /* The powered exoskeleton shall augment lower-body movement by sensing user intent and applying coordinated powered assistance at hip, knee, and ankle joints. */
    }

    requirement def WearableMassRequirement {
        subject exoskeleton : PoweredExoskeleton;

        require constraint {
            exoskeleton.totalMass <= 22 [SI::kilogram]
        }

        doc /* The complete wearable system shall remain light enough for practical donning, standing, walking, lifting, and stair-climb assistance. */
    }

    requirement def UserMassCompatibilityRequirement {
        subject exoskeleton : PoweredExoskeleton;

        require constraint {
            exoskeleton.supportedUserMassMin <= 50 [SI::kilogram] and
            exoskeleton.supportedUserMassMax >= 120 [SI::kilogram]
        }

        doc /* The system shall support adult users across the specified body-mass range. */
    }

    requirement def JointAssistanceRequirement {
        subject exoskeleton : PoweredExoskeleton;

        require constraint {
            exoskeleton.leftHipActuator.peakTorque >= 100 [SI::newtonMetre] and
            exoskeleton.rightHipActuator.peakTorque >= 100 [SI::newtonMetre] and
            exoskeleton.leftKneeActuator.peakTorque >= 85 [SI::newtonMetre] and
            exoskeleton.rightKneeActuator.peakTorque >= 85 [SI::newtonMetre]
        }

        doc /* Hip and knee actuators shall provide sufficient peak torque to assist gait, lifting, and sit-to-stand transitions. */
    }

    requirement def ContinuousOperationRequirement {
        subject battery : BatteryPack;

        require constraint {
            battery.capacity >= 1500000 [SI::joule] and
            battery.maxContinuousPower >= 750 [SI::watt]
        }

        doc /* The battery pack shall provide sufficient energy and power for sustained powered assistance under nominal duty cycles. */
    }

    requirement def SafetyFaultRequirement {
        subject controller : ExoskeletonController;

        require constraint {
            controller.faultTorqueLimit <= 5 [SI::newtonMetre]
        }

        doc /* Upon a critical fault, commanded assistive torque shall be reduced to a safe limited value and the system shall enter fault-safe behavior. */
    }

    satisfy PrimaryFunctionRequirement by PoweredExoskeleton;
    satisfy WearableMassRequirement by PoweredExoskeleton;
    satisfy UserMassCompatibilityRequirement by PoweredExoskeleton;
    satisfy JointAssistanceRequirement by PoweredExoskeleton;
    satisfy ContinuousOperationRequirement by BatteryPack;
    satisfy SafetyFaultRequirement by ExoskeletonController;
}
