                first Calibrating
                then Measuring
                accept after 5.0 [s];

            transition Measuring_to_Degraded
                first Measuring
                then Degraded
                accept when healthOutput.sensorContrast < 0.015;

            transition Degraded_to_Measuring
                first Degraded
                then Measuring
                accept when healthOutput.sensorContrast >= 0.025;

            transition Measuring_to_Faulted
                first Measuring
                then Faulted
                accept when healthOutput.laserLocked == false or healthOutput.microwaveLocked == false;
