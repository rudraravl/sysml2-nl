        out item conditionedOutput : PhotodiodeSignal;
    }

    part def AnalogToDigitalConverter {
        attribute resolutionBits : Integer;
        attribute conversionRate : FrequencyHz;
        attribute referenceVoltage : VoltageV;

        in item analogInput : PhotodiodeSignal;
        out attribute digitalOutput : DigitalCount;
    }

    part def QuantumSignalProcessor {
        attribute lockInReferenceFrequency : FrequencyHz;
        attribute averagingWindow : TimeS;
        attribute calibrationScale : Real { unit = "Hz/T"; }
        attribute noiseRejectBandwidth : FrequencyHz = 1000.0;

        in attribute sampleInput : DigitalCount;
        out item measurementOutput : DigitalMagneticMeasurement;
        out item healthOutput : HealthStatus;

        action def DemodulateAndEstimateField {
            in attribute samples : DigitalCount;
            in attribute calibrationScale : Real;
            out item measurement : DigitalMagneticMeasurement;

            first acquireWindow;
            then lockInDemodulate;
            then fitResonanceFrequencies;
            then convertFrequencyShiftToMagneticField;
            then estimateUncertainty;
            then publishMeasurement;

            action acquireWindow;
            action lockInDemodulate;
            action fitResonanceFrequencies;
            action convertFrequencyShiftToMagneticField;
            action estimateUncertainty;
            action publishMeasurement;
        }

