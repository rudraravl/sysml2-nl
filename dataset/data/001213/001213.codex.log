        action def ApplyBiasField {
            in attribute requestedBias : MagneticFluxDensity;
            out attribute coilCurrent : CurrentA;
            out attribute generatedBias : MagneticFluxDensity;
        }
    }

    requirement def MeasureMagneticFieldWithQuantumSensor {
        doc /* The sensing unit shall measure magnetic flux density using a quantum sensor based on optically detected magnetic resonance of nitrogen-vacancy centers in diamond. */
        subject sensingUnit : QuantumMagnetometerSensingUnit;

        require constraint {
            sensingUnit.quantumSensorHead.zeroFieldSplitting == 2.87e9
        }
    }

    requirement def SensitivityRequirement {
        doc /* The sensing unit shall achieve magnetic-field sensitivity no worse than 10 pT/sqrt(Hz) over the specified bandwidth. */
        subject sensingUnit : QuantumMagnetometerSensingUnit;

        require constraint {
            sensingUnit.sensitivity <= 1.0e-11
        }
    }

    requirement def BandwidthRequirement {
        doc /* The sensing unit shall provide valid magnetic-field measurements from DC through at least 1 kHz. */
        subject sensingUnit : QuantumMagnetometerSensingUnit;

        require constraint {
            sensingUnit.bandwidth >= 1000.0
        }
    }

    requirement def MeasurementRangeRequirement {
        doc /* The sensing unit shall measure magnetic flux density magnitude from 0 T to at least 10 mT without saturating. */
        subject sensingUnit : QuantumMagnetometerSensingUnit;

        require constraint {
            sensingUnit.measurementRange >= 0.01
        }
    }

    requirement def TemperatureStabilityRequirement {
        doc /* The sensing unit shall maintain the quantum sensor head temperature within 0.01 K of the configured setpoint during measurement. */
        subject controller : TemperatureControlModule;

        require constraint {
            controller.stability <= 0.01
        }
    }

    requirement def PowerRequirement {
        doc /* The sensing unit shall consume no more than 8 W during steady-state measurement operation. */
        subject sensingUnit : QuantumMagnetometerSensingUnit;

        require constraint {
            sensingUnit.maxPowerConsumption <= 8.0
        }
    }

    satisfy MeasureMagneticFieldWithQuantumSensor by QuantumMagnetometerSensingUnit;
    satisfy SensitivityRequirement by QuantumSignalProcessor;
    satisfy BandwidthRequirement by LowNoiseAnalogFrontEnd;
    satisfy MeasurementRangeRequirement by BiasFieldCoilDriver;
    satisfy TemperatureStabilityRequirement by TemperatureControlModule;
    satisfy PowerRequirement by QuantumMagnetometerSensingUnit;

    part quantumMagneticSensingUnit : QuantumMagnetometerSensingUnit;

}
