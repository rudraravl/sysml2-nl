    flow senseTemperature.exhaustTemperature to validateSample.convertedTemperature;
    flow validateSample.sample to commandDisplay.sample;
    flow commandDisplay.command.indicatedTemperature to indicatedTemperature;
    flow commandDisplay.command.showWarning to warningActive;
  }

  state def GaugeOperatingStateMachine {
