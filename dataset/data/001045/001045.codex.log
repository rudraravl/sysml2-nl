    subject gauge : ExhaustGasTemperatureGauge;

    require constraint {
      gauge.controller.samplePeriod <= 100.0;
    }
  }

  requirement def DisplayResolutionRequirement {
    subject gauge : ExhaustGasTemperatureGauge;

    require constraint {
