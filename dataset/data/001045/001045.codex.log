    }
  }

  part exhaustGasTemperatureGaugeSystem : ExhaustGasTemperatureGauge;

  satisfy PrimaryFunctionRequirement by exhaustGasTemperatureGaugeSystem;
  satisfy MeasurementRangeRequirement by exhaustGasTemperatureGaugeSystem;
