    connect vehiclePowerInput.power to warningIndicator.powerIn.power;

    perform action temperatureMeasurement : MeasureAndIndicateExhaustGasTemperature {
      in gas = exhaustGasInput.gas;
      out indicatedTemperature;
      out warningActive;
    }

    exhibit stateMachine : GaugeOperatingStateMachine;
  }

  requirement def PrimaryFunctionRequirement {
    subject gauge : ExhaustGasTemperatureGauge;

