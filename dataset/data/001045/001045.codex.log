    attribute minimumSupplyVoltage : VoltageV = 9.0;
    attribute maximumSupplyVoltage : VoltageV = 16.0;
    attribute normalOperatingTemperatureLow : TemperatureC = 100.0;
    attribute normalOperatingTemperatureHigh : TemperatureC = 750.0;
    attribute warningTemperature : TemperatureC = 850.0;
    attribute criticalTemperature : TemperatureC = 930.0;

