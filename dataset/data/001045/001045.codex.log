    part conditioner : SignalConditioner;
    part controller : Microcontroller;
    part display : GaugeDisplay;
    part warningIndicator : WarningIndicator;

    attribute primaryFunction : String =
      "Measure exhaust gas temperature from a thermocouple probe and present the temperature to the operator with warning indication when exhaust temperature approaches a damaging limit.";

