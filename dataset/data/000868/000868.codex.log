        connect dischargeFlowSensor.signal to controller.flowInput;
        connect reservoirLevelSensor.signal to controller.levelInput;
        connect motorCurrentSensor.signal to controller.currentInput;

        connect controller.driveControl to motorDrive.controlInput;
        connect controller.alarmOutput to annunciator.alarmInput;
        connect controller.alarmOutput to operatorAlarm;
    }

    requirement def DetectDryRunning {
        subject system : DryRunningProtectionSystem;

        doc /* The system shall detect dry running using at least flow, suction pressure, liquid level, and motor current evidence. */

        require constraint {
            system.controller.minimumFlowThreshold == 5.0 and
            system.controller.minimumSuctionPressure == 20.0 and
            system.controller.minimumLiquidLevel == 8.0 and
            system.controller.maximumDryRunCurrent == 7.0;
        }
    }

    requirement def StopPumpOnConfirmedDryRun {
        subject system : DryRunningProtectionSystem;

        doc /* The system shall command the motor drive to stop the pump when dry running remains confirmed for the allowed confirmation interval. */

        require constraint {
            system.controller.dryRunConfirmationTime <= system.allowedDryRunExposure;
        }
    }

