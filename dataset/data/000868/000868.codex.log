        doc /* The system shall enter lockout after repeated dry-run trips and require a manual reset before further operation. */

        require constraint {
            system.controller.maximumTripAttempts == 3 and
            system.manualResetRequiredAfterLockout == true;
        }
    }

    requirement def AnnunciateDryRunFault {
        subject system : DryRunningProtectionSystem;

        doc /* The system shall provide local audible and visual dry-run alarm indication whenever protective shutdown or lockout is active. */

        require constraint {
            system.annunciator.alarmLatchEnabled == true and
            system.annunciator.audibleLevel >= 80.0;
        }
    }

    requirement def FailSafeStop {
        subject system : DryRunningProtectionSystem;

        doc /* Loss of valid sensor evidence for liquid presence shall result in a stop command rather than continued pump operation. */

        require constraint {
            system.motorDrive.stopResponseTime <= 0.5;
        }
    }

    part dryRunningProtectionInstallation : DryRunningProtectionSystem {
        attribute siteSupplyVoltage : Voltage = 230.0;
        attribute normalOperatingFlow : FlowRate = 120.0;
        attribute normalSuctionPressure : Pressure = 80.0;
        attribute dryRunTripFlow : FlowRate = 5.0;
        attribute dryRunTripPressure : Pressure = 20.0;
        attribute dryRunTripCurrent : Current = 7.0;
    }

    satisfy DetectDryRunning by dryRunningProtectionInstallation;
    satisfy StopPumpOnConfirmedDryRun by dryRunningProtectionInstallation;
    satisfy PreventImmediateRestart by dryRunningProtectionInstallation;
    satisfy LockoutAfterRepeatedTrips by dryRunningProtectionInstallation;
    satisfy AnnunciateDryRunFault by dryRunningProtectionInstallation;
    satisfy FailSafeStop by dryRunningProtectionInstallation;
