    attribute sheaveRadius : Length;
    attribute bearingEfficiency : Efficiency;
    attribute ropeTensionIn : Force;
    attribute ropeTensionOut : Force;

    port ropeIn : RopePort;
    port ropeOut : RopePort;

    perform action transmitRopeForce {
      in inTension : Force;
      out outTension : Force;
      attribute localEfficiency : Efficiency = bearingEfficiency;
    }
  }

