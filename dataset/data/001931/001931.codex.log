      propulsion.nominalThrust >= 2200 [N] and
      propulsion.nominalSpecificImpulse >= 315 [s] and
      propulsion.primaryFunction != ""
    }
    doc /* The propulsion system shall provide controlled spacecraft delta-v and attitude-control thrust by conditioning propellant, initiating combustion, expanding exhaust through a nozzle, and directing the thrust vector. */
  }

  requirement def ThrottleRangeRequirement {
    subject propulsion : SpacecraftPropulsion;
    require constraint {
      propulsion.minimumThrottleThrust <= 0.20 * propulsion.nominalThrust and
      propulsion.maximumThrust >= 1.10 * propulsion.nominalThrust
    }
    doc /* The propulsion system shall throttle from no more than 20 percent nominal thrust to at least 110 percent nominal thrust. */
  }

  requirement def TankPressureSafetyRequirement {
    subject propulsion : SpacecraftPropulsion;
    require constraint {
      propulsion.fuelTank.burstPressure >= 2.0 * propulsion.fuelTank.maximumExpectedOperatingPressure and
      propulsion.oxidizerTank.burstPressure >= 2.0 * propulsion.oxidizerTank.maximumExpectedOperatingPressure
    }
    doc /* Each propellant tank shall maintain a burst pressure margin of at least 2.0 against maximum expected operating pressure. */
  }

  requirement def MixtureRatioRequirement {
    subject propulsion : SpacecraftPropulsion;
    require constraint {
      propulsion.mixtureRatio >= 1.55 and propulsion.mixtureRatio <= 1.75
    }
    doc /* The controller and injector shall maintain oxidizer-to-fuel mixture ratio within the operating band required for efficient combustion. */
  }

  requirement def FaultSafingRequirement {
    subject propulsion : SpacecraftPropulsion;
    require constraint {
      propulsion.controller.mode == EngineMode::faultSafed implies
      propulsion.fuelIsolationValve.commandedOpenFraction == 0 and
      propulsion.oxidizerIsolationValve.commandedOpenFraction == 0
    }
    doc /* On detected hazardous fault, the controller shall close propellant isolation valves and transition to a fault-safed engine state. */
  }

  requirement def ThermalLimitRequirement {
    subject propulsion : SpacecraftPropulsion;
    require constraint {
      propulsion.chamber.maximumWallTemperature <= 1000 [K]
    }
    doc /* The combustion chamber wall temperature shall remain within qualified material limits during nominal burns. */
  }

  requirement def TotalImpulseRequirement {
    subject propulsion : SpacecraftPropulsion;
    require constraint {
      propulsion.totalImpulseCapacity >= 650000 [N*s]
    }
    doc /* The propulsion system shall store and deliver sufficient propellant for mission total impulse. */
  }

  satisfy PrimaryFunctionRequirement by SpacecraftPropulsion;
  satisfy ThrottleRangeRequirement by SpacecraftPropulsion;
  satisfy TankPressureSafetyRequirement by SpacecraftPropulsion;
  satisfy MixtureRatioRequirement by SpacecraftPropulsion;
  satisfy FaultSafingRequirement by SpacecraftPropulsion;
  satisfy ThermalLimitRequirement by SpacecraftPropulsion;
  satisfy TotalImpulseRequirement by SpacecraftPropulsion;

  part missionPropulsionSystem : SpacecraftPropulsion;

}
