      attribute testCapacityPerQuarter = 24;
      attribute measurementConfidence = 9.0 [UtilityScore];
    }

    part universityPerformer {
      attribute name = "University Research Consortium";
      attribute availablePrincipalInvestigators = 42;
      attribute laboratoryCapacity = 8.0 [UtilityScore];
    }

    part industryPerformer {
      attribute name = "Advanced Systems Industry Team";
      attribute availablePrincipalInvestigators = 65;
      attribute laboratoryCapacity = 9.0 [UtilityScore];
    }

    part governmentLabPerformer {
      attribute name = "Government Laboratory Partner";
      attribute availablePrincipalInvestigators = 31;
