      attribute annualBudget = 1400000000.0 [MoneyUSD];
      attribute proposalReviewCapacityPerMonth = 80;
    }

    part informationInnovationOffice {
      attribute officeName = "Information Innovation Office";
      attribute missionFocus = "Cyber, artificial intelligence, information advantage, and secure computation";
      attribute annualBudget = 1100000000.0 [MoneyUSD];
      attribute proposalReviewCapacityPerMonth = 95;
    }

    part defenseSciencesOffice {
      attribute officeName = "Defense Sciences Office";
      attribute missionFocus = "Foundational science, materials, biology, mathematics, and breakthrough concepts";
      attribute annualBudget = 900000000.0 [MoneyUSD];
      attribute proposalReviewCapacityPerMonth = 70;
    }

    part contracting {
