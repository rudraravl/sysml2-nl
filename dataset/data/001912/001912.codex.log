package DARPA_InspiredResearchAgencyModel {

  import ScalarValues::*;
  import ISQ::*;

  item def ResearchProposal {
    attribute title : String;
    attribute technicalRisk : RiskScore;
    attribute expectedTransitionValue : UtilityScore;
    attribute requestedFunding : MoneyUSD;
    attribute proposedDuration : TimeMonth;
  }

