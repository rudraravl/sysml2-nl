    attribute periodOfPerformance : TimeMonth;
    attribute milestoneCount : Integer;
  }

  item def TechnicalReport {
    attribute maturityLevel : TechnologyReadinessLevel;
    attribute demonstratedPerformance : UtilityScore;
    attribute submittedAtMonth : TimeMonth;
  }

  item def TransitionPackage {
    attribute receivingOrganization : String;
    attribute validatedCapabilityGain : UtilityScore;
    attribute transitionReadiness : TechnologyReadinessLevel;
  }

  item def StrategicNeed {
    attribute missionArea : String;
    attribute urgency : UtilityScore;
    attribute capabilityGapSeverity : UtilityScore;
  }

  value def MoneyUSD {
    unit "$";
    quantity kind MonetaryAmount;
  }

  value def TimeMonth {
    unit "mo";
    quantity kind Time;
  }

  value def RiskScore {
    unit "score";
    quantity kind Dimensionless;
  }

  value def UtilityScore {
    unit "score";
    quantity kind Dimensionless;
  }

  value def TechnologyReadinessLevel {
    unit "TRL";
    quantity kind Dimensionless;
  }

  port def ProposalIntakePort {
    in item proposal : ResearchProposal;
  }

  port def ContractAwardPort {
    out item contract : ResearchContract;
  }

  port def ReportPort {
    in item report : TechnicalReport;
  }

  port def TransitionPort {
    out item package : TransitionPackage;
  }

  port def StrategicNeedPort {
    in item need : StrategicNeed;
  }

  port def FundingPort {
    out item contract : ResearchContract;
  }

  port def OversightPort {
    in item report : TechnicalReport;
    out item correctiveDirection : StrategicNeed;
  }

  part def PerformerOrganization {
    attribute name : String;
    attribute availablePrincipalInvestigators : Integer;
    attribute laboratoryCapacity : UtilityScore;

    port awards : ContractAwardPort;
    port reports : ReportPort;
  }

  part def DefenseCustomer {
    attribute organizationName : String;
    attribute operationalPriority : UtilityScore;

    port needs : StrategicNeedPort;
    port transitions : TransitionPort;
  }

  part def ProgramManager {
    attribute name : String;
    attribute activePrograms : Integer;
    attribute annualBudgetAuthority : MoneyUSD;
    attribute maximumAcceptedTechnicalRisk : RiskScore;

    port needIn : StrategicNeedPort;
    port proposalIn : ProposalIntakePort;
    port awardOut : ContractAwardPort;
    port reportIn : ReportPort;
    port transitionOut : TransitionPort;

    perform action defineProgram;
    perform action selectPortfolio;
    perform action monitorMilestones;
    perform action prepareTransition;
  }

  part def ResearchOffice {
    attribute officeName : String;
    attribute missionFocus : String;
    attribute annualBudget : MoneyUSD;
    attribute proposalReviewCapacityPerMonth : Integer;

    part manager[1..12] : ProgramManager;

    port needInput : StrategicNeedPort;
    port proposalInput : ProposalIntakePort;
    port contractOutput : ContractAwardPort;
    port reportInput : ReportPort;
    port transitionOutput : TransitionPort;
  }

  part def ContractingOffice {
    attribute staffCount : Integer;
    attribute awardCycleTime : TimeMonth;
    attribute complianceReviewThreshold : MoneyUSD;

    port selectedProposalInput : ProposalIntakePort;
    port fundingOutput : FundingPort;
  }

  part def IndependentTestTeam {
    attribute testCapacityPerQuarter : Integer;
    attribute measurementConfidence : UtilityScore;

    port reportInput : ReportPort;
    port validatedReportOutput : ReportPort;
  }

  part def AgencyLeadership {
    attribute strategicPlanningHorizon : TimeMonth;
    attribute portfolioRiskTolerance : RiskScore;
    attribute annualAppropriation : MoneyUSD;

    port needsInput : StrategicNeedPort;
    port oversightInput : OversightPort;
  }

  part def DARPAStyleResearchAgency {
    attribute agencyName : String = "Advanced Defense Research Projects Agency";
    attribute primaryFunction : String =
      "Create technological surprise by funding and managing high-risk, high-payoff research programs that address strategic defense capability gaps.";
    attribute annualResearchBudget : MoneyUSD;
    attribute targetAverageProgramDuration : TimeMonth;
    attribute minimumTransitionReadiness : TechnologyReadinessLevel;

    part leadership : AgencyLeadership;
    part tacticalTechnologyOffice : ResearchOffice;
    part informationInnovationOffice : ResearchOffice;
    part defenseSciencesOffice : ResearchOffice;
    part contracting : ContractingOffice;
    part independentTest : IndependentTestTeam;
    part universityPerformer : PerformerOrganization;
    part industryPerformer : PerformerOrganization;
    part governmentLabPerformer : PerformerOrganization;
    part combatantCommandCustomer : DefenseCustomer;
    part acquisitionCustomer : DefenseCustomer;

    port externalNeeds : StrategicNeedPort;
    port proposalGateway : ProposalIntakePort;
    port transitionGateway : TransitionPort;
    port oversightGateway : OversightPort;

    connection needFlow1 connect externalNeeds to leadership.needsInput;
    connection needFlow2 connect combatantCommandCustomer.needs to tacticalTechnologyOffice.needInput;
    connection needFlow3 connect acquisitionCustomer.needs to informationInnovationOffice.needInput;

    connection proposalFlow1 connect proposalGateway to tacticalTechnologyOffice.proposalInput;
    connection proposalFlow2 connect proposalGateway to informationInnovationOffice.proposalInput;
    connection proposalFlow3 connect proposalGateway to defenseSciencesOffice.proposalInput;

    connection awardFlow1 connect tacticalTechnologyOffice.contractOutput to universityPerformer.awards;
    connection awardFlow2 connect informationInnovationOffice.contractOutput to industryPerformer.awards;
    connection awardFlow3 connect defenseSciencesOffice.contractOutput to governmentLabPerformer.awards;

    connection contractFundingFlow connect contracting.fundingOutput to industryPerformer.awards;

    connection reportFlow1 connect universityPerformer.reports to independentTest.reportInput;
    connection reportFlow2 connect industryPerformer.reports to independentTest.reportInput;
    connection reportFlow3 connect governmentLabPerformer.reports to independentTest.reportInput;

    connection validatedReportFlow1 connect independentTest.validatedReportOutput to tacticalTechnologyOffice.reportInput;
    connection validatedReportFlow2 connect independentTest.validatedReportOutput to informationInnovationOffice.reportInput;
    connection validatedReportFlow3 connect independentTest.validatedReportOutput to defenseSciencesOffice.reportInput;

    connection transitionFlow1 connect tacticalTechnologyOffice.transitionOutput to combatantCommandCustomer.transitions;
    connection transitionFlow2 connect informationInnovationOffice.transitionOutput to acquisitionCustomer.transitions;
    connection transitionFlow3 connect defenseSciencesOffice.transitionOutput to transitionGateway;
  }

  action def DefineProgram {
    in item need : StrategicNeed;
    out item solicitation : ResearchProposal;

    constraint gapMustBeSignificant {
      need.capabilityGapSeverity >= 7.0
    }
  }

  action def SelectPortfolio {
    in item candidateProposal[1..*] : ResearchProposal;
    out item selectedProposal[1..*] : ResearchProposal;

    constraint highRiskHighPayoff {
      selectedProposal.technicalRisk >= 6.0 and
      selectedProposal.expectedTransitionValue >= 8.0
    }
  }

  action def AwardContract {
    in item selectedProposal : ResearchProposal;
    out item contract : ResearchContract;

    constraint fundingWithinRequest {
      contract.obligatedFunding <= selectedProposal.requestedFunding
    }
  }

  action def MonitorMilestones {
    in item report : TechnicalReport;
    out item correctiveDirection : StrategicNeed;

    constraint adequateProgress {
      report.maturityLevel >= 3.0 or
      report.demonstratedPerformance >= 6.0
    }
  }

  action def TransitionCapability {
    in item finalReport : TechnicalReport;
    out item transitionPackage : TransitionPackage;

    constraint readyForTransition {
      finalReport.maturityLevel >= 6.0 and
      finalReport.demonstratedPerformance >= 8.0
    }
  }

  state def ProgramLifecycle {
    entry action DefineProgram;

    state StrategicGapIdentified;
    state SolicitationReleased;
    state ProposalsEvaluated;
    state ContractAwarded;
    state ResearchExecution;
    state IndependentValidation;
    state TransitionPrepared;
    state ProgramClosed;
    state ProgramTerminated;

    transition first StrategicGapIdentified;
    transition StrategicGapIdentified to SolicitationReleased
      accept StrategicNeed
      then DefineProgram;

    transition SolicitationReleased to ProposalsEvaluated
      accept ResearchProposal
      then SelectPortfolio;

    transition ProposalsEvaluated to ContractAwarded
      accept ResearchProposal
      then AwardContract;

    transition ContractAwarded to ResearchExecution
      accept ResearchContract;

    transition ResearchExecution to IndependentValidation
      accept TechnicalReport
      then MonitorMilestones;

    transition IndependentValidation to ResearchExecution
      if report.maturityLevel < 6.0 and report.demonstratedPerformance >= 6.0;

    transition IndependentValidation to TransitionPrepared
      if report.maturityLevel >= 6.0 and report.demonstratedPerformance >= 8.0
      then TransitionCapability;

    transition IndependentValidation to ProgramTerminated
      if report.demonstratedPerformance < 4.0;

    transition TransitionPrepared to ProgramClosed
      accept TransitionPackage;
  }

  requirement def PrimaryFunctionRequirement {
    subject agency : DARPAStyleResearchAgency;

    require constraint {
      agency.primaryFunction ==
      "Create technological surprise by funding and managing high-risk, high-payoff research programs that address strategic defense capability gaps."
    }
  }

  requirement def HighRiskHighPayoffRequirement {
    subject proposal : ResearchProposal;

    require constraint {
      proposal.technicalRisk >= 6.0 and
      proposal.expectedTransitionValue >= 8.0
    }
  }

  requirement def ProgramDurationRequirement {
    subject agency : DARPAStyleResearchAgency;

    require constraint {
      agency.targetAverageProgramDuration <= 60.0 [TimeMonth]
    }
  }

  requirement def TransitionReadinessRequirement {
    subject package : TransitionPackage;

    require constraint {
      package.transitionReadiness >= 6.0 [TechnologyReadinessLevel] and
      package.validatedCapabilityGain >= 8.0 [UtilityScore]
    }
  }

  requirement def PortfolioBudgetRequirement {
    subject agency : DARPAStyleResearchAgency;

    require constraint {
      agency.annualResearchBudget <= agency.leadership.annualAppropriation
    }
  }

  part agencyInstance : DARPAStyleResearchAgency {
    attribute annualResearchBudget = 4250000000.0 [MoneyUSD];
    attribute targetAverageProgramDuration = 48.0 [TimeMonth];
    attribute minimumTransitionReadiness = 6.0 [TechnologyReadinessLevel];

    part leadership {
      attribute strategicPlanningHorizon = 120.0 [TimeMonth];
      attribute portfolioRiskTolerance = 8.0 [RiskScore];
      attribute annualAppropriation = 4500000000.0 [MoneyUSD];
    }

