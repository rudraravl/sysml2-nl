    part def IontophoresisTherapySystem {
        attribute primaryFunction : String = "Deliver ionized therapeutic drug molecules across the skin using a controlled low-level electric current.";
        attribute maximumCurrent : ElectricCurrent = 0.004 [A];
        attribute nominalCurrent : ElectricCurrent = 0.002 [A];
        attribute maximumVoltage : ElectricVoltage = 80 [V];
        attribute prescribedDuration : TimeDuration = 1200 [s];
        attribute deliveredCharge : ElectricCharge;
        attribute therapyMode : TherapyModeKind;

        port commandIn : CommandInputPort;
        port statusOut : StatusOutputPort;

        part controller : TherapyController;
        part powerModule : CurrentControlledPowerModule;
        part drugReservoir : DrugReservoir;
        part activeElectrode : ActiveDrugElectrode;
        part returnElectrode : ReturnElectrode;
        part skinInterface : PatientSkinInterface;
        part sensors : ContactAndSafetySensors;
        part userInterface : UserInterface;
        part battery : RechargeableBattery;

        connect userInterface.commandOut to commandIn;
        connect commandIn to controller.commandIn;
        connect controller.statusOut to statusOut;
        connect controller.statusOut to userInterface.statusIn;

        connect battery.powerOut to powerModule.powerIn;
        connect controller.currentControlOut to powerModule.controlIn;
        connect powerModule.stimulationOut to activeElectrode.powerIn;
        connect returnElectrode.powerOut to powerModule.returnIn;

        connect drugReservoir.drugOut to activeElectrode.drugIn;
        connect activeElectrode.drugOut to skinInterface.drugIn;
        connect activeElectrode.patientSide to skinInterface.activeContact;
        connect returnElectrode.patientSide to skinInterface.returnContact;

        connect skinInterface.conditionOut to sensors.conditionIn;
        connect sensors.sensedConditionOut to controller.sensorIn;

