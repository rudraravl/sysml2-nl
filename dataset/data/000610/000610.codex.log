    connection controllerToReagentPump connect controller.pumpCommandOut to reagentPump.commandIn;
    connection controllerToValve connect controller.valveCommandOut to injectionValve.commandIn;
    connection controllerToReactor connect controller.reactorCommandOut to reactor.commandIn;
    connection controllerToDetector connect controller.detectorCommandOut to detector.commandIn;

    connection carrierPumpStatus connect carrierPump.statusOut to analyzerStatus;
    connection reagentPumpStatus connect reagentPump.statusOut to analyzerStatus;
    connection valveStatus connect injectionValve.statusOut to analyzerStatus;
    connection reactorStatus connect reactor.statusOut to analyzerStatus;
    connection detectorStatus connect detector.statusOut to analyzerStatus;
  }

  requirement def PrimaryFunctionRequirement {
    subject analyzer : FlowInjectionAnalyzer;

    require constraint {
      analyzer.primaryFunction ==
      "Inject a precise liquid sample plug into a continuous carrier stream, merge it with reagent, transport it through a controlled reaction path, measure the resulting transient detector signal, and calculate analyte concentration."
    }
  }

  requirement def SampleVolumeAccuracyRequirement {
    subject analyzer : FlowInjectionAnalyzer;

    require constraint {
      analyzer.nominalSampleVolume >= 95 and analyzer.nominalSampleVolume <= 105
    }
  }

  requirement def ContinuousCarrierFlowRequirement {
    subject analyzer : FlowInjectionAnalyzer;

    require constraint {
      analyzer.nominalCarrierFlow >= 1.0 and analyzer.nominalCarrierFlow <= 1.4
    }
  }

  requirement def ReagentFlowRequirement {
    subject analyzer : FlowInjectionAnalyzer;

    require constraint {
      analyzer.nominalReagentFlow >= 0.30 and analyzer.nominalReagentFlow <= 0.50
    }
  }

  requirement def ReactionResidenceTimeRequirement {
    subject analyzer : FlowInjectionAnalyzer;

    require constraint {
      analyzer.nominalResidenceTime >= 30 and analyzer.nominalResidenceTime <= 60
    }
  }

  requirement def OpticalMeasurementRequirement {
    subject analyzer : FlowInjectionAnalyzer;

    require constraint {
      analyzer.detectorWavelength >= 530 and analyzer.detectorWavelength <= 550
    }
  }

  requirement def ThermalControlRequirement {
    subject analyzer : FlowInjectionAnalyzer;

    require constraint {
      analyzer.reactorTemperature >= 35 and analyzer.reactorTemperature <= 39
    }
  }

  requirement def WasteContainmentRequirement {
    subject analyzer : FlowInjectionAnalyzer;

    require constraint {
      analyzer.waste.capacity >= 1000000
    }
  }

  part fiaSystem : FlowInjectionAnalyzer;

  requirement primaryFunction : PrimaryFunctionRequirement {
    subject analyzer = fiaSystem;
  }

  requirement sampleVolumeAccuracy : SampleVolumeAccuracyRequirement {
    subject analyzer = fiaSystem;
  }

  requirement continuousCarrierFlow : ContinuousCarrierFlowRequirement {
    subject analyzer = fiaSystem;
  }

  requirement reagentFlow : ReagentFlowRequirement {
    subject analyzer = fiaSystem;
  }

  requirement reactionResidenceTime : ReactionResidenceTimeRequirement {
    subject analyzer = fiaSystem;
  }

  requirement opticalMeasurement : OpticalMeasurementRequirement {
    subject analyzer = fiaSystem;
  }

  requirement thermalControl : ThermalControlRequirement {
    subject analyzer = fiaSystem;
  }

  requirement wasteContainment : WasteContainmentRequirement {
    subject analyzer = fiaSystem;
  }

  satisfy primaryFunction by fiaSystem;
  satisfy sampleVolumeAccuracy by fiaSystem.injectionValve;
  satisfy continuousCarrierFlow by fiaSystem.carrierPump;
  satisfy reagentFlow by fiaSystem.reagentPump;
  satisfy reactionResidenceTime by fiaSystem.reactor;
  satisfy opticalMeasurement by fiaSystem.detector;
  satisfy thermalControl by fiaSystem.reactor;
  satisfy wasteContainment by fiaSystem.waste;
}
