    }
  }

  requirement def NonSystemicMechanicalActionRequirement {
    doc
      /* The system shall perform its primary function without expected systemic absorption or pharmacologic action. */

    subject safety : SafetyConstraintSignal;

    require constraint {
      safety.mechanicalActionOnly == true and
      safety.systemicAbsorptionExpected == false
    }
  }

  requirement def TransitAndEliminationRequirement {
    doc
      /* The hydrated material shall pass through the digestive tract and be substantially eliminated. */

    subject status : DigestiveTransitStatus;

    require constraint {
      status.excretedFraction >= 0.9
    }
  }

  satisfy PrimaryFunctionRequirement by Gelesis100System;
  satisfy AdministrationRequirement by AdministrationGuidance;
  satisfy HydrationRequirement by GastricHydrationSubsystem;
  satisfy NonSystemicMechanicalActionRequirement by SafetyControlSubsystem;
  satisfy TransitAndEliminationRequirement by DigestiveTransitSubsystem;

  /* System instance */

  part gelesis100WeightManagementAid : Gelesis100System {
    attribute primaryFunction =
      "Support weight management by forming a non-systemic, hydrated hydrogel matrix in the stomach that occupies volume and promotes fullness before digestive transit and elimination.";
  }
}
