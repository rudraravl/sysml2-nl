        part wristJoint2 {
            attribute rangeMin : Degree = -120;
            attribute rangeMax : Degree = 120;
            attribute ratedTorque : NewtonMeter = 70;
        }
        part wristJoint3 {
            attribute rangeMin : Degree = -350;
            attribute rangeMax : Degree = 350;
            attribute ratedTorque : NewtonMeter = 50;
