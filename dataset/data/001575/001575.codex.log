        in estimatedPose : Pose3D;
        in features : FeatureSet;
        in scan : LidarScan;
        in previousLandmarks : LandmarkMap;
        in previousGrid : OccupancyGridMap;
        out updatedLandmarks : LandmarkMap;
        out updatedGrid : OccupancyGridMap;
    }

    action def DetectLoopClosure {
        in currentFeatures : FeatureSet;
        in currentMap : LandmarkMap;
        out candidate : LoopClosureCandidate;
    }

    action def OptimizePoseGraph {
        in loopClosure : LoopClosureCandidate;
        in estimatedPose : Pose3D;
        in landmarkMap : LandmarkMap;
        out correctedTrajectory : CorrectedTrajectory;
        out optimizedLandmarks : LandmarkMap;
    }

    action def PublishNavigationState {
        in pose : Pose3D;
        in map : LandmarkMap;
        in trajectory : CorrectedTrajectory;
        out state : NavigationState;
    }

    state def SLAMOperatingState {
        entry action InitializeCoordinateFrames;
        state Initializing;
        state Tracking;
        state Mapping;
        state LoopClosing;
        state Relocalizing;
        state Degraded;
        state Shutdown;

        transition first Initializing;
        transition Initializing to Tracking
            accept initializationComplete
            if sensorTimeSynchronized == true and initialPoseAvailable == true;

        transition Tracking to Mapping
            accept poseEstimated
            if localizationConfidence >= 0.70;

        transition Mapping to Tracking
            accept localMapUpdated;

        transition Tracking to LoopClosing
            accept loopClosureCandidateDetected
            if loopClosureSimilarity >= 0.80;

        transition LoopClosing to Tracking
            accept poseGraphOptimized;

        transition Tracking to Relocalizing
            accept trackingLost
            if localizationConfidence < 0.35;

        transition Relocalizing to Tracking
            accept relocalizationSucceeded
            if localizationConfidence >= 0.70;

        transition Relocalizing to Degraded
            accept relocalizationTimedOut;

        transition Degraded to Tracking
            accept confidenceRecovered
            if localizationConfidence >= 0.65;

        transition Tracking to Shutdown
            accept shutdownRequested;

        transition Mapping to Shutdown
            accept shutdownRequested;

        transition Degraded to Shutdown
            accept shutdownRequested;
