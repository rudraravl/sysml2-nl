        attribute publishRate : UpdateRate = 20 [Hz];
        port poseInput : PosePort;
        port mapInput : MapPort;
        port trajectoryInput : TrajectoryPort;
        port navigationStateOutput : NavigationStateOut;
    }

    action def AcquireSensorData {
        in cameraFrame : CameraFrame;
        in lidarScan : LidarScan;
        in imuMeasurement : InertialMeasurement;
