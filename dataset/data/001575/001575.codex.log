    part def SLAMSystem {
        doc /* Primary function: estimate the robot pose while incrementally building and correcting a spatial map of an initially unknown environment from synchronized camera, lidar, inertial, and wheel-odometry data. */

        attribute minimumLocalizationConfidence : Confidence = 0.70;
        attribute maximumAllowedDriftPerTenMeters : Distance = 0.20 [m];
        attribute mapResolution : Distance = 0.05 [m];
        attribute nominalUpdateRate : UpdateRate = 20 [Hz];

        part camera : StereoCamera;
        part lidar : ScanningLidar;
        part imu : InertialMeasurementUnit;
        part wheelEncoders : WheelEncoderPair;
        part synchronizer : TimeSynchronizer;
        part featureExtractor : VisualFeatureExtractor;
        part lidarPreprocessor : LidarPreprocessor;
        part motionPredictor : MotionPredictor;
        part fusionEstimator : SensorFusionEstimator;
        part localMapper : LocalMapper;
        part loopClosureDetector : LoopClosureDetector;
        part poseGraphOptimizer : PoseGraphOptimizer;
        part statePublisher : NavigationStatePublisher;

        port navigationOutput : NavigationStateOut;

        connection camera.imageOutput.frame to synchronizer.synchronizedSensorInput.frame;
        connection lidar.scanOutput.scan to synchronizer.synchronizedSensorInput.scan;
        connection imu.imuOutput.measurement to synchronizer.synchronizedSensorInput.measurement;
        connection wheelEncoders.odomOutput.odometry to synchronizer.synchronizedSensorInput.odometry;

        connection synchronizer.synchronizedSensorOutput.frame to featureExtractor.cameraInput.frame;
        connection synchronizer.synchronizedSensorOutput.scan to lidarPreprocessor.lidarInput.scan;
        connection synchronizer.synchronizedSensorOutput.measurement to motionPredictor.inertialAndOdometryInput.measurement;
        connection synchronizer.synchronizedSensorOutput.odometry to motionPredictor.inertialAndOdometryInput.odometry;

        connection featureExtractor.featureOutput.features to fusionEstimator.featureInput.features;
        connection lidarPreprocessor.filteredScanOutput.scan to fusionEstimator.scanInput.scan;
        connection motionPredictor.predictedPoseOutput.pose to fusionEstimator.predictedPoseInput.pose;

        connection fusionEstimator.estimatedPoseOutput.pose to localMapper.poseInput.pose;
        connection featureExtractor.featureOutput.features to localMapper.featureInput.features;
        connection lidarPreprocessor.filteredScanOutput.scan to localMapper.scanInput.scan;

        connection featureExtractor.featureOutput.features to loopClosureDetector.featureInput.features;
        connection localMapper.localMapOutput.landmarks to loopClosureDetector.mapInput.landmarks;
        connection localMapper.localMapOutput.grid to loopClosureDetector.mapInput.grid;

        connection fusionEstimator.estimatedPoseOutput.pose to poseGraphOptimizer.poseInput.pose;
        connection localMapper.localMapOutput.landmarks to poseGraphOptimizer.mapInput.landmarks;
        connection localMapper.localMapOutput.grid to poseGraphOptimizer.mapInput.grid;
        connection loopClosureDetector.loopClosureOutput.candidate to poseGraphOptimizer.loopClosureInput.candidate;

        connection fusionEstimator.estimatedPoseOutput.pose to statePublisher.poseInput.pose;
        connection poseGraphOptimizer.optimizedMapOutput.landmarks to statePublisher.mapInput.landmarks;
        connection poseGraphOptimizer.optimizedMapOutput.grid to statePublisher.mapInput.grid;
        connection poseGraphOptimizer.correctedTrajectoryOutput.trajectory to statePublisher.trajectoryInput.trajectory;

        connection statePublisher.navigationStateOutput.state to navigationOutput.state;

        exhibit stateMachine : SLAMOperatingState;

        perform action mainLoop {
            action acquire : AcquireSensorData;
            action extract : ExtractVisualFeatures;
            action predict : PredictRobotMotion;
            action estimate : EstimatePoseAndUncertainty;
            action mapUpdate : UpdateMap;
            action closureDetect : DetectLoopClosure;
            action optimize : OptimizePoseGraph;
            action publish : PublishNavigationState;

            flow acquire.synchronizedFrame to extract.image;
            flow acquire.synchronizedImu to predict.imu;
            flow acquire.synchronizedOdometry to predict.odometry;
            flow predict.predictedPose to estimate.predictedPose;
            flow extract.features to estimate.features;
            flow acquire.synchronizedScan to estimate.scan;
            flow estimate.estimatedPose to mapUpdate.estimatedPose;
            flow extract.features to mapUpdate.features;
            flow acquire.synchronizedScan to mapUpdate.scan;
            flow extract.features to closureDetect.currentFeatures;
            flow mapUpdate.updatedLandmarks to closureDetect.currentMap;
            flow closureDetect.candidate to optimize.loopClosure;
            flow estimate.estimatedPose to optimize.estimatedPose;
            flow mapUpdate.updatedLandmarks to optimize.landmarkMap;
            flow estimate.estimatedPose to publish.pose;
            flow optimize.optimizedLandmarks to publish.map;
            flow optimize.correctedTrajectory to publish.trajectory;
        }
    }

    requirement def PrimaryFunctionRequirement {
        doc /* The system shall simultaneously estimate the mobile platform pose and maintain a consistent spatial map of the surrounding environment using onboard sensor data. */
        subject system : SLAMSystem;
        require constraint {
            system.nominalUpdateRate >= 20 [Hz]
        }
    }

    requirement def LocalizationAccuracyRequirement {
        doc /* The system shall keep pose drift below 0.20 m per 10 m of traveled distance after loop-closure correction in feature-rich indoor environments. */
        subject system : SLAMSystem;
        require constraint {
            system.maximumAllowedDriftPerTenMeters <= 0.20 [m]
        }
    }

    requirement def MapResolutionRequirement {
        doc /* The generated occupancy grid shall represent occupied and free space at 0.05 m resolution or finer. */
        subject system : SLAMSystem;
        require constraint {
            system.mapResolution <= 0.05 [m]
        }
    }

    requirement def RealTimeOperationRequirement {
        doc /* The navigation state shall be published at a rate sufficient for closed-loop navigation. */
        subject system : SLAMSystem;
        require constraint {
            system.nominalUpdateRate >= 20 [Hz]
        }
    }

    requirement def SensorSynchronizationRequirement {
        doc /* Camera, lidar, inertial, and wheel odometry measurements shall be synchronized within 0.01 s before fusion. */
        subject synchronizer : TimeSynchronizer;
        require constraint {
            synchronizer.maximumSkew <= 0.01 [s]
        }
    }

    requirement def LoopClosureRequirement {
        doc /* The system shall detect loop closures when the current observation strongly matches a previously mapped place and use them to reduce accumulated trajectory drift. */
        subject detector : LoopClosureDetector;
        require constraint {
            detector.minimumSimilarityScore >= 0.80
        }
    }

    requirement def ConfidenceRequirement {
        doc /* The system shall report localization confidence with each published navigation state and enter relocalization behavior when confidence drops below the operational threshold. */
        subject system : SLAMSystem;
        require constraint {
            system.minimumLocalizationConfidence >= 0.70
        }
    }

    satisfy PrimaryFunctionRequirement by SLAMSystem;
    satisfy LocalizationAccuracyRequirement by SLAMSystem;
    satisfy MapResolutionRequirement by SLAMSystem;
    satisfy RealTimeOperationRequirement by SLAMSystem;
    satisfy SensorSynchronizationRequirement by TimeSynchronizer;
    satisfy LoopClosureRequirement by LoopClosureDetector;
    satisfy ConfidenceRequirement by SLAMSystem;
}
