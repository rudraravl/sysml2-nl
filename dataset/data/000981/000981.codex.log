    port healthOut : HealthPort;
  }

  part def ImagePreprocessor {
    attribute maximumLatency : Duration_ms;
    port rawImageIn : ImagePort;
    port enhancedImageOut : ImagePort;
    port healthOut : HealthPort;
  }

  part def PlateDetector {
    attribute minimumPlateHeight : PixelCount;
    attribute detectionThreshold : ConfidenceScore;
    port imageIn : ImagePort;
    port candidateOut : CandidatePort;
    port healthOut : HealthPort;
  }

