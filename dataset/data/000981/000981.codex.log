  }

  part def OperatorConsole {
    port reportIn : ReportPort;
    port healthIn : HealthPort;
    port commandOut : CommandPort;
  }

  action def CaptureVehicleImage {
    in item presence : VehiclePresenceEvent;
    out item frame : ImageFrame;
  }

  action def EnhanceImage {
    in item rawFrame : ImageFrame;
    out item enhancedFrame : ImageFrame;
  }

