  action def RecognizeNumberPlate {
    in item presence : VehiclePresenceEvent;
    out item report : RecognitionReport;

    action capture : CaptureVehicleImage;
    action enhance : EnhanceImage;
    action locate : LocatePlate;
    action read : ReadPlateCharacters;
    action build : BuildRecognitionReport;

    flow presence to capture.presence;
    flow capture.frame to enhance.rawFrame;
    flow enhance.enhancedFrame to locate.enhancedFrame;
    flow locate.candidate to read.candidate;
    flow enhance.enhancedFrame to read.enhancedFrame;
    flow read.reading to build.reading;
    flow presence to build.presence;
    flow build.report to report;

    succession capture then enhance;
    succession enhance then locate;
    succession locate then read;
    succession read then build;
  }

  state def ANPROperatingStates {
    entry action initializeHardware;
    state idle;
    state monitoring;
    state acquiring;
    state processing;
    state reporting;
    state degraded;
    state faulted;

    transition initial then idle;
    transition idle then monitoring;
    transition monitoring then acquiring accept VehiclePresenceEvent;
    transition acquiring then processing;
    transition processing then reporting;
    transition reporting then monitoring;
    transition monitoring then degraded if cameraOnline == false or networkOnline == false;
    transition degraded then monitoring if cameraOnline == true and networkOnline == true;
    transition degraded then faulted if processorOnline == false;
    transition faulted then idle accept "reset";
  }

  part def AutomaticNumberPlateRecognitionSystem {
    attribute primaryFunction : String = "Automatically detect a vehicle, capture plate imagery, recognize the registration number, and publish a timestamped recognition report.";
    attribute targetRecognitionLatency : Duration_ms = 750.0;
    attribute minimumAcceptedConfidence : ConfidenceScore = 0.92;
    attribute operatingState : RecognitionStateKind;

    part detector : VehicleDetector {
      attribute detectionRange_m = 35.0;
      attribute maximumMeasuredSpeed = 180.0;
    }

    part illuminator : InfraredIlluminator {
      attribute peakWavelength_nm = 850.0;
      attribute maximumIlluminance = 12000.0;
      attribute pulseDuration = 4.0;
    }

    part camera : HighSpeedCamera {
      attribute sensorWidth = 4096;
      attribute sensorHeight = 2160;
      attribute maximumFrameRate_Hz = 120.0;
      attribute minimumExposureTime = 0.25;
    }

    part preprocessor : ImagePreprocessor {
      attribute maximumLatency = 80.0;
    }

    part plateDetector : PlateDetector {
      attribute minimumPlateHeight = 32;
      attribute detectionThreshold = 0.85;
    }

    part ocr : OpticalCharacterRecognizer {
      attribute supportedAlphabet = "A-Z,0-9,hyphen,space";
      attribute minimumOcrConfidence = 0.88;
    }

    part evaluator : ConfidenceEvaluator {
      attribute acceptanceThreshold = 0.92;
      attribute reviewThreshold = 0.75;
    }

    part store : EvidenceStore {
      attribute retainedCapacity = 2048.0;
      attribute retentionDays = 90;
    }

    part gateway : NetworkGateway {
      attribute uplinkBandwidth = 50.0;
      attribute retryWindow = 5000.0;
    }

    part console : OperatorConsole;

    perform action recognition : RecognizeNumberPlate;
    exhibit state behavior : ANPROperatingStates;

    connect detector.triggerOut to camera.triggerIn;
    connect camera.imageOut to preprocessor.rawImageIn;
    connect preprocessor.enhancedImageOut to plateDetector.imageIn;
    connect preprocessor.enhancedImageOut to ocr.imageIn;
    connect plateDetector.candidateOut to ocr.candidateIn;
    connect ocr.readingOut to evaluator.readingIn;
    connect evaluator.reportOut to store.reportIn;
    connect evaluator.reportOut to gateway.reportIn;
    connect evaluator.reportOut to console.reportIn;
    connect camera.imageOut to store.imageIn;
    connect console.commandOut to camera.commandIn;
    connect console.commandOut to illuminator.commandIn;
  }

  requirement def PrimaryFunctionRequirement {
    subject system : AutomaticNumberPlateRecognitionSystem;
    doc /* The system shall provide automatic number-plate recognition by detecting a vehicle, capturing an image of its number plate, extracting plate text, estimating confidence, storing evidence, and sending a recognition report to external users. */
  }

  requirement def RecognitionLatencyRequirement {
    subject system : AutomaticNumberPlateRecognitionSystem;
    require constraint { system.targetRecognitionLatency <= 750.0 }
  }

  requirement def RecognitionConfidenceRequirement {
    subject system : AutomaticNumberPlateRecognitionSystem;
    require constraint { system.minimumAcceptedConfidence >= 0.92 }
  }

  requirement def EvidenceRetentionRequirement {
    subject system : AutomaticNumberPlateRecognitionSystem;
    require constraint { system.store.retentionDays >= 90 }
  }

  requirement def CameraResolutionRequirement {
    subject system : AutomaticNumberPlateRecognitionSystem;
    require constraint {
      system.camera.sensorWidth >= 3840 and system.camera.sensorHeight >= 2160
    }
  }

  requirement def NetworkThroughputRequirement {
    subject system : AutomaticNumberPlateRecognitionSystem;
    require constraint { system.gateway.uplinkBandwidth >= 10.0 }
  }

  part anprSystem : AutomaticNumberPlateRecognitionSystem;

  satisfy PrimaryFunctionRequirement by anprSystem;
  satisfy RecognitionLatencyRequirement by anprSystem;
  satisfy RecognitionConfidenceRequirement by anprSystem;
  satisfy EvidenceRetentionRequirement by anprSystem;
  satisfy CameraResolutionRequirement by anprSystem;
  satisfy NetworkThroughputRequirement by anprSystem;
}
