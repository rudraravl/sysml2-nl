        subject engine : NutatingDiscEngine;
        require constraint {
            engine.controller.commandedFuelRate <= engine.fuelMeter.maximumFuelRate and
            engine.controller.commandedFuelRate >= engine.fuelMeter.minimumFuelRate
        }
    }

    satisfy PrimaryFunctionRequirement by NutatingDiscEngine;
    satisfy CompressionRequirement by NutatingDiscEngine;
    satisfy PressureContainmentRequirement by NutatingDiscEngine;
    satisfy ContinuousOutputRequirement by NutatingDiscEngine;
    satisfy ThermalManagementRequirement by NutatingDiscEngine;
    satisfy ControlRequirement by NutatingDiscEngine;
