            attribute oilPressure = 350000;
            attribute oilTemperature = 370;
            attribute pumpFlowRate = 0.025;
        }

        part cooling : CoolingSystem {
            attribute heatRejectionRate = 22000;
            attribute coolantPressure = 180000;
            attribute targetHousingTemperature = 385;
        }

        part shaft : OutputShaftAssembly {
            attribute outputSpeed = 3600;
            attribute outputTorque = 119.4;
            attribute bearingTemperature = 360;
            attribute mechanicalEfficiency = 0.92;
        }

        part controller : EngineController {
            attribute targetSpeed = 3600;
            attribute commandedSparkTiming = 18;
            attribute commandedFuelRate = 0.0026;
            attribute shutdownRequested = false;
        }

        connection fuelSupplyConnection connect fuelIn to fuelMeter.fuelIn;
        connection fuelMeterToIntake connect fuelMeter.mixtureOut to intake.mixtureOut;
        connection intakeToChambers connect intake.mixtureOut to chambers.mixtureIn;
        connection chambersToExhaust connect chambers.exhaustOut to exhaust.exhaustIn;
        connection exhaustOutlet connect exhaust.exhaustIn to exhaustOut;
        connection discToShaft connect disc.mechanicalOut to shaft.shaftIn;
        connection shaftOutput connect shaft.shaftOut to outputPower;
        connection oilServiceConnection connect oilService to lube.oilCircuit;
        connection coolantServiceConnection connect coolantService to cooling.coolantCircuit;
        connection telemetryConnection connect controller.sensed to telemetry;

        perform action engineCycle {
            action meter : MeterFuel;
            action admit : AdmitCharge;
            action compress : CompressCharge;
            action ignite : IgniteCharge;
            action expand : ExpandWorkingGas;
            action exhaustAction : ExhaustProducts;
            action convert : ConvertNutationToShaftRotation;
            action control : ControlEngine;

            flow meter.meteredMixture to admit.mixture;
            flow admit.trappedCharge to compress.trappedCharge;
            flow compress.compressedCharge to ignite.compressedCharge;
            flow ignite.combustionPressure to expand.combustionPressure;
            flow expand.shaftPower to convert.shaftPower;
            flow expand.exhaustGas to exhaustAction.exhaustGas;
        }

        exhibit state operatingMode : EngineOperatingState;
    }

    requirement def PrimaryFunctionRequirement {
        doc "The nutating disc engine shall convert fuel chemical energy and inducted air into rotary mechanical shaft power through controlled combustion in variable-volume chambers formed by a nutating disc and fixed housing.";
        subject engine : NutatingDiscEngine;
        require constraint {
            engine.ratedPower >= 40000 and
            engine.ratedSpeed <= 4200 and
            engine.brakeThermalEfficiency >= 0.28
        }
    }

    requirement def CompressionRequirement {
        doc "The engine shall compress the admitted air-fuel charge before ignition using the decreasing chamber volume created by disc nutation.";
        subject engine : NutatingDiscEngine;
        require constraint {
            engine.nominalCompressionRatio >= 8.0 and
            engine.nominalCompressionRatio <= 11.5
        }
    }

    requirement def PressureContainmentRequirement {
        doc "The housing, seals, and disc shall contain peak combustion pressure with margin above the maximum commanded operating pressure.";
        subject engine : NutatingDiscEngine;
        require constraint {
            engine.housing.maximumAllowablePressure >= 1.2 * engine.maximumChamberPressure
        }
    }

    requirement def ContinuousOutputRequirement {
        doc "The output shaft assembly shall deliver continuous rotary power by converting disc nutation into shaft rotation over repeated thermodynamic cycles.";
        subject engine : NutatingDiscEngine;
        require constraint {
            engine.shaft.mechanicalEfficiency >= 0.88 and
            engine.ratedTorque >= 100
        }
    }

    requirement def ThermalManagementRequirement {
        doc "The cooling and lubrication systems shall maintain housing, bearing, and seal temperatures within operating limits during rated operation.";
        subject engine : NutatingDiscEngine;
        require constraint {
            engine.cooling.targetHousingTemperature <= 400 and
            engine.shaft.bearingTemperature <= 390 and
            engine.seals.contactTemperature <= 450
        }
    }

    requirement def ControlRequirement {
        doc "The controller shall meter fuel and ignition timing based on speed, pressure, temperature, and requested power to maintain stable operation and protect the engine from overspeed, low oil pressure, excessive pressure, and excessive seal temperature.";
        subject engine : NutatingDiscEngine;
        require constraint {
            engine.controller.commandedFuelRate <= engine.fuelMeter.maximumFuelRate and
            engine.controller.commandedFuelRate >= engine.fuelMeter.minimumFuelRate
        }
    }

    satisfy PrimaryFunctionRequirement by NutatingDiscEngine;
    satisfy CompressionRequirement by NutatingDiscEngine;
    satisfy PressureContainmentRequirement by NutatingDiscEngine;
    satisfy ContinuousOutputRequirement by NutatingDiscEngine;
    satisfy ThermalManagementRequirement by NutatingDiscEngine;
    satisfy ControlRequirement by NutatingDiscEngine;
}
