package SuctionSystemSpecification {

  private import ScalarValues::*;
  private import SI::*;

  attribute def Pressure {
    :>> value : Real;
    unit : String = "Pa";
  }

  attribute def NegativePressure {
    :>> value : Real;
    unit : String = "Pa below ambient";
  }

  attribute def VolumetricFlowRate {
    :>> value : Real;
    unit : String = "L/s";
  }

  attribute def Power {
    :>> value : Real;
    unit : String = "W";
  }

  attribute def Mass {
    :>> value : Real;
    unit : String = "kg";
  }

  attribute def TimeDuration {
    :>> value : Real;
    unit : String = "s";
  }

  attribute def Efficiency {
    :>> value : Real;
    unit : String = "percent";
  }

  item def AmbientAir {
    attribute pressure : Pressure;
    attribute temperature : Real;
  }

