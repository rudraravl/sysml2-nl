    port materialInlet : MaterialCollectionPort;
  }

  part def SuctionDuct {
    attribute length : Real = 1.2;
    attribute insideDiameter : Real = 0.032;
    attribute pressureLossAtNominalFlow : Pressure = 850.0;
    attribute leakRateAtNominalPressure : VolumetricFlowRate = 0.25;

