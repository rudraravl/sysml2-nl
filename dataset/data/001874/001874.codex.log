    port outlet : AirIntakePort;
  }

  part def ImpellerBlower {
    attribute ratedSpeed : Real = 42000.0;
    attribute ratedPower : Power = 650.0;
    attribute maximumNegativePressure : NegativePressure = 22000.0;
    attribute nominalFlowRate : VolumetricFlowRate = 32.0;
