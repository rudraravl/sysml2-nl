      in item therapeuticSteam : TherapeuticSteam;
      out item status : StatusSignal;
    }

    first start;
    then validateWaterLevel;
    then preheatWater;
    then boilAndVaporize;
    then temperSteamForInhalation;
    then reportOperatingStatus;
    then done;
  }

