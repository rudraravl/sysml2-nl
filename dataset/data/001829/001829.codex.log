  requirement def FlowControlRequirement {
    attribute requiredNominalFlowRate : FlowRate = 4.0;
    attribute allowedFlowError : Percent = 5.0;

    doc
      /* The system shall regulate delivered flow to the commanded rate within the allowed flow error during steady pumping operation. */
  }

  requirement def FluidIsolationRequirement {
    doc
      /* The working fluid shall contact only the internal surface of the flexible transport tube and connected fluid fittings during normal operation. */
  }

  requirement def PressureProtectionRequirement {
    attribute maximumSafePressure : Pressure = 250.0;

    doc
      /* The system shall reduce or stop the compression wave when measured outlet pressure exceeds the maximum safe pressure. */
  }

  requirement def OcclusionRequirement {
    attribute minimumRequiredOcclusion : Percent = 92.0;

    doc
      /* The actuator shall compress the flexible tube sufficiently to create a sealed occlusion zone that minimizes backflow during wave propagation. */
  }

  requirement def PulsationRequirement {
    attribute maximumAllowedRipple : Percent = 8.0;

    doc
      /* The outlet compliance region shall limit cyclic flow ripple produced by discrete peristaltic compression events. */
  }

  requirement def RecoveryRequirement {
    attribute minimumRecoveryCompleteness : Percent = 98.0;

    doc
      /* The tube shall elastically recover after compression to refill from the inlet side and sustain repeated peristaltic cycles. */
  }

  requirement def SafetyMonitoringRequirement {
    attribute maximumSensorSamplePeriod : TimeDuration = 0.05;

    doc
      /* The sensor set shall provide pressure, flow, and occlusion telemetry quickly enough for closed-loop control and fault detection. */
  }

  satisfy PrimaryFunctionRequirement by PeristalticTransportSystem;
  satisfy FlowControlRequirement by WaveController;
  satisfy FluidIsolationRequirement by FlexibleTransportTube;
  satisfy PressureProtectionRequirement by WaveController;
  satisfy OcclusionRequirement by SequentialCompressionActuator;
  satisfy PulsationRequirement by OutletComplianceRegion;
  satisfy RecoveryRequirement by FlexibleTransportTube;
  satisfy SafetyMonitoringRequirement by FlowPressureSensorSet;

  assert constraint FlowRateConstraint {
    PeristalticTransportSystem::targetFlowRate >= 0.1 and
    PeristalticTransportSystem::targetFlowRate <= 25.0;
  }

  assert constraint PressureLimitConstraint {
    PeristalticTransportSystem::maximumOutletPressure <=
    FlexibleTransportTube::allowablePressure;
  }

  assert constraint OcclusionConstraint {
    PeristalticTransportSystem::minimumTubeOcclusion >=
    OcclusionRequirement::minimumRequiredOcclusion;
  }

  part peristalticPumpSystem : PeristalticTransportSystem {
    perform transportFluid : TransportFluidAction;
    exhibit lifecycle : PeristalticTransportLifecycle;
  }

}
