            robot.supervisor.emergencyStopLatency.value <= 0.050
        }
    }

    requirement def PayloadRequirement {
        subject robot : CableRobot;

        doc /* The cable robot shall accept, lift, translate, hold, and release a payload whose mass does not exceed the rated payload mass. */

        require constraint {
            robot.platform.maximumPayloadMass.value <= robot.ratedPayloadMass.value
        }
    }

    part cableRobotSystem : CableRobot;

    satisfy PrimaryFunctionRequirement by cableRobotSystem;
    satisfy WorkspaceRequirement by cableRobotSystem;
    satisfy CableTensionSafetyRequirement by cableRobotSystem;
    satisfy EmergencyStopRequirement by cableRobotSystem;
    satisfy PayloadRequirement by cableRobotSystem;
}
