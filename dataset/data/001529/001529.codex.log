    }
  }

  requirement def MobilitySafetyRequirement {
    doc
    /* The mobility base shall limit commanded motion to the robot platform's verified dynamic envelope. */

    subject base : MobilityBase;

    require constraint {
      base.maximumLinearSpeed <= 1.5 [m / s] and
      base.maximumAngularSpeed <= 120 [deg / s]
    }
  }

  requirement def MissionEnduranceRequirement {
    doc
    /* The robot shall support perceptual navigation missions for at least four hours under nominal sensing and compute load. */

    subject robot : PerceptualRobot;

    require constraint {
      robot.nominalMissionDuration >= 4 [h]
    }
  }

  requirement def SafeEnergyRequirement {
    doc
    /* The robot shall enter safe stop before battery state of charge reaches a critically low condition. */

    subject battery : BatteryPack;

    require constraint {
      battery.stateOfCharge > 5 [%]
    }
  }

  part perceptualInspectionRobot : PerceptualRobot {
    attribute nominalMissionDuration = 4 [h];
    attribute safeObstacleClearance = 0.40 [m];

    part camera {
      attribute nominalFrameRate = 30 [Hz];
      attribute maximumRange = 12.0 [m];
    }

    part perception {
      attribute currentComputeLoad = 62 [%];
    }

    part battery {
      attribute stateOfCharge = 100 [%];
    }

    part mapper {
      attribute maximumPoseError = 0.10 [m];
    }

    part executive {
      attribute minimumObjectConfidence = 0.80;
    }
  }

  satisfy PrimaryFunctionRequirement by perceptualInspectionRobot;
  satisfy MissionEnduranceRequirement by perceptualInspectionRobot;
  satisfy PerceptionLatencyRequirement by perceptualInspectionRobot.perception;
  satisfy DetectionConfidenceRequirement by perceptualInspectionRobot.executive;
  satisfy MappingAccuracyRequirement by perceptualInspectionRobot.mapper;
  satisfy MobilitySafetyRequirement by perceptualInspectionRobot.base;
  satisfy SafeEnergyRequirement by perceptualInspectionRobot.battery;
}
