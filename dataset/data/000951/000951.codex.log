  part def VacuumPumpingSubsystem {
    port processInlet : FluidInletPort;
    port exhaustOutlet : FluidOutletPort;
    port electricalSupply : ElectricalInputPort;
    port coolingSupply : CoolingPort;
    port condensateDrain : DrainPort;
    port remoteCommand : CommandPort;
    port subsystemStatus : StatusPort;

