        first off, starting, evacuating, holdingVacuum, stopping
        then faulted
        if cooling.coolantIn.volumetricFlow < minimumCoolingFlow
           or status.status.sealTemperature > maximumSealTemperature
           or electrical.supply.current > 1.25 * ratedCurrent
           or exhaust.gasOut.absolutePressure > maximumExhaustPressure;
    }

    exhibit state pumpState : PumpOperatingState;
  }

  part def KnockoutSeparator {
    port inlet : FluidInletPort;
    port gasOutlet : FluidOutletPort;
    port drain : DrainPort;
    port status : StatusPort;

    attribute internalVolume : Volume = 8.0 [SI::litre];
    attribute liquidHoldUp : Volume;
    attribute maximumLiquidHoldUp : Volume = 6.0 [SI::litre];
    attribute separationEfficiency : Percent = 98.0;
    attribute pressureDropAtRatedFlow : Pressure = 250.0 [SI::pascal];

    action def SeparateLiquid {
      in mixedStream : GasStream;
      out dryGas : GasStream;
      out removedLiquid : Condensate;

      constraint outletDryness {
        dryGas.vaporFraction <= 2.0;
      }
    }

    state def SeparatorState {
      state normal;
      state draining;
      state highLevelFault;

      transition first normal;

      transition normal_to_draining
        first normal
        then draining
        if liquidHoldUp >= 4.5 [SI::litre];

      transition draining_to_normal
        first draining
        then normal
        if liquidHoldUp <= 1.0 [SI::litre];

      transition normal_to_highLevelFault
        first normal
        then highLevelFault
        if liquidHoldUp >= maximumLiquidHoldUp;
    }

    exhibit state separatorState : SeparatorState;
  }

  part def VacuumReceiver {
    port processConnection : FluidInletPort;
    port pumpConnection : FluidOutletPort;
    port status : StatusPort;

    attribute receiverVolume : Volume = 120.0 [SI::litre];
    attribute targetPressure : Pressure = 500.0 [SI::pascal];
    attribute highPressureStartThreshold : Pressure = 2500.0 [SI::pascal];
    attribute lowPressureStopThreshold : Pressure = 300.0 [SI::pascal];
    attribute maximumAllowablePressure : Pressure = 150000.0 [SI::pascal];
    attribute currentPressure : Pressure;
    attribute gasTemperature : Temperature;
  }

  part def CheckValve {
    port pumpSide : FluidInletPort;
    port exhaustSide : FluidOutletPort;

    attribute crackingDifferentialPressure : Pressure = 500.0 [SI::pascal];
    attribute reverseLeakRate : FlowRate = 0.01 [SI::litre / SI::minute];

    state def CheckValveState {
      state closed;
      state open;

      transition first closed;

      transition closed_to_open
        first closed
        then open
        if pumpSide.gasIn.absolutePressure - exhaustSide.gasOut.absolutePressure
           >= crackingDifferentialPressure;

      transition open_to_closed
        first open
        then closed
        if pumpSide.gasIn.absolutePressure <= exhaustSide.gasOut.absolutePressure;
    }

    exhibit state checkValveState : CheckValveState;
  }

  part def ExhaustSilencer {
    port inlet : FluidInletPort;
    port outlet : FluidOutletPort;

    attribute insertionLoss : Real = 18.0;
    attribute ratedFlow : FlowRate = 300.0 [SI::litre / SI::minute];
    attribute pressureDropAtRatedFlow : Pressure = 800.0 [SI::pascal];
  }

  part def PressureSensor {
    port sensedFluid : FluidInletPort;
    port status : StatusPort;

    attribute measurementRangeLow : Pressure = 1.0 [SI::pascal];
    attribute measurementRangeHigh : Pressure = 120000.0 [SI::pascal];
    attribute accuracy : Percent = 0.5;
    attribute samplePeriod : Time = 0.1 [SI::second];
    attribute measuredPressure : Pressure;
  }

  part def TemperatureSensor {
    port sensedFluid : FluidInletPort;
    port status : StatusPort;

    attribute measurementRangeLow : Temperature = 273.15 [SI::kelvin];
    attribute measurementRangeHigh : Temperature = 423.15 [SI::kelvin];
    attribute accuracy : Percent = 1.0;
    attribute measuredTemperature : Temperature;
  }

  part def Controller {
    port receiverPressureStatus : StatusPort;
    port pumpStatus : StatusPort;
    port inletValveCommand : CommandPort;
    port pumpCommand : CommandPort;
    port outletValveCommand : CommandPort;

    attribute targetPressure : Pressure = 500.0 [SI::pascal];
    attribute startPressure : Pressure = 2500.0 [SI::pascal];
    attribute stopPressure : Pressure = 300.0 [SI::pascal];
    attribute emergencyStopActive : Boolean;
    attribute commandedSpeed : Percent;

    action def RegulateVacuum {
      in receiverPressure : Pressure;
      in pumpFaulted : Boolean;
      out runCommand : Boolean;
      out speedDemand : Percent;

      if receiverPressure > startPressure and not pumpFaulted and not emergencyStopActive {
        assign runCommand := true;
        assign speedDemand := 100.0;
      } else if receiverPressure <= stopPressure {
        assign runCommand := false;
        assign speedDemand := 0.0;
      } else {
        assign runCommand := true;
        assign speedDemand := 55.0;
      }
    }

    state def ControlState {
      state idle;
      state startRequest;
      state running;
      state hold;
      state shutdown;
      state lockout;

      transition first idle;

      transition idle_to_startRequest
        first idle
        then startRequest
        if receiverPressureStatus.status.inletPressure >= startPressure
           and not emergencyStopActive;

      transition startRequest_to_running
        first startRequest
        then running
        if pumpStatus.status.running;

      transition running_to_hold
        first running
        then hold
        if receiverPressureStatus.status.inletPressure <= targetPressure;

      transition hold_to_running
        first hold
        then running
        if receiverPressureStatus.status.inletPressure > startPressure;

      transition running_to_shutdown
        first running
        then shutdown
        if receiverPressureStatus.status.inletPressure <= stopPressure
           or emergencyStopActive;

      transition hold_to_shutdown
        first hold
        then shutdown
        if emergencyStopActive;

      transition shutdown_to_idle
        first shutdown
        then idle
        if not pumpStatus.status.running;

      transition any_to_lockout
        first idle, startRequest, running, hold, shutdown
        then lockout
        if pumpStatus.status.faulted;
    }

    exhibit state controllerState : ControlState;
  }

  part def VacuumPumpingSubsystem {
    port processInlet : FluidInletPort;
    port exhaustOutlet : FluidOutletPort;
    port electricalSupply : ElectricalInputPort;
    port coolingSupply : CoolingPort;
    port condensateDrain : DrainPort;
    port remoteCommand : CommandPort;
    port subsystemStatus : StatusPort;

    part receiver : VacuumReceiver;
    part inletIsolationValve : IsolationValve;
    part separator : KnockoutSeparator;
    part pump : VacuumPump;
    part dischargeCheckValve : CheckValve;
    part exhaustSilencer : ExhaustSilencer;
    part receiverPressureSensor : PressureSensor;
    part pumpInletPressureSensor : PressureSensor;
    part pumpSealTemperatureSensor : TemperatureSensor;
    part controller : Controller;

    connect processInlet to receiver.processConnection;
    connect receiver.pumpConnection to inletIsolationValve.upstream;
    connect inletIsolationValve.downstream to separator.inlet;
    connect separator.gasOutlet to pump.inlet;
    connect pump.exhaust to dischargeCheckValve.pumpSide;
    connect dischargeCheckValve.exhaustSide to exhaustSilencer.inlet;
    connect exhaustSilencer.outlet to exhaustOutlet;

    connect separator.drain to condensateDrain;
    connect electricalSupply to pump.electrical;
    connect coolingSupply to pump.cooling;

    connect remoteCommand to controller.pumpCommand;
    connect controller.inletValveCommand to inletIsolationValve.command;
    connect controller.pumpCommand to pump.command;
    connect controller.outletValveCommand to dischargeCheckValve.pumpSide;

    connect receiverPressureSensor.sensedFluid to receiver.processConnection;
    connect pumpInletPressureSensor.sensedFluid to pump.inlet;
    connect pumpSealTemperatureSensor.sensedFluid to pump.inlet;

    connect receiverPressureSensor.status to controller.receiverPressureStatus;
    connect pump.status to controller.pumpStatus;
    connect pump.status to subsystemStatus;

    attribute ratedEvacuationFlow : FlowRate = 250.0 [SI::litre / SI::minute];
    attribute normalOperatingPressure : Pressure = 500.0 [SI::pascal];
    attribute maximumProcessInletPressure : Pressure = 101325.0 [SI::pascal];
    attribute maximumContinuousRunTime : Time = 14400.0 [SI::second];
    attribute expectedReceiverPumpDownTime : Time = 240.0 [SI::second];

    constraint inletPressureLimit {
      processInlet.gasIn.absolutePressure <= maximumProcessInletPressure;
    }

    constraint pumpCapacityLimit {
      processInlet.gasIn.volumetricFlow <= ratedEvacuationFlow;
    }

    constraint exhaustBackPressureLimit {
      exhaustOutlet.gasOut.absolutePressure <= pump.maximumExhaustPressure;
    }

    constraint receiverVacuumPerformance {
      receiver.currentPressure <= normalOperatingPressure
      implies subsystemStatus.status.running == false or pump.status.status.running == true;
    }

    action def EvacuateReceiver {
      in initialPressure : Pressure;
      out finalPressure : Pressure;

      action openInletValve;
      action startVacuumPump;
      action removeGasFromReceiver;
      action holdTargetPressure;

      constraint evacuationGoal {
        finalPressure <= receiver.targetPressure;
      }

      constraint pumpDownTimeGoal {
        expectedReceiverPumpDownTime <= 300.0 [SI::second];
      }
    }
  }

  requirement def PumpingSubsystemRequirement {
    subject subsystem : VacuumPumpingSubsystem;
  }

  requirement vacuumPumpFunctionalRequirement : PumpingSubsystemRequirement {
    doc /* The subsystem shall move gas and vapor from the process inlet to the exhaust outlet by using a vacuum pump. */
    require constraint {
      subsystem.pump.nominalPumpingSpeed >= 200.0 [SI::litre / SI::minute];
    }
  }

  requirement targetVacuumRequirement : PumpingSubsystemRequirement {
    doc /* The subsystem shall reduce receiver pressure to 500 Pa or less during normal evacuation. */
    require constraint {
      subsystem.receiver.currentPressure <= 500.0 [SI::pascal];
    }
  }

  requirement inletProtectionRequirement : PumpingSubsystemRequirement {
    doc /* The subsystem shall prevent excessive liquid carryover into the vacuum pump. */
    require constraint {
      subsystem.separator.separationEfficiency >= 95.0;
      subsystem.separator.liquidHoldUp <= subsystem.separator.maximumLiquidHoldUp;
    }
  }

  requirement backflowPreventionRequirement : PumpingSubsystemRequirement {
    doc /* The subsystem shall prevent exhaust backflow into the vacuum receiver when the pump is stopped. */
    require constraint {
      subsystem.dischargeCheckValve.reverseLeakRate <= 0.05 [SI::litre / SI::minute];
    }
  }

  requirement electricalCompatibilityRequirement : PumpingSubsystemRequirement {
    doc /* The subsystem shall operate from a 230 V single phase electrical supply. */
    require constraint {
      subsystem.pump.ratedVoltage == 230.0 [SI::volt];
      subsystem.pump.ratedMotorPower <= 1000.0 [SI::watt];
    }
  }

  requirement thermalProtectionRequirement : PumpingSubsystemRequirement {
    doc /* The subsystem shall enter a faulted state when pump seal temperature exceeds its safe operating limit. */
    require constraint {
      subsystem.pump.maximumSealTemperature <= 363.15 [SI::kelvin];
    }
  }

  requirement controlRequirement : PumpingSubsystemRequirement {
    doc /* The controller shall start the pump above the high pressure threshold and stop it below the low pressure threshold. */
    require constraint {
      subsystem.controller.startPressure == 2500.0 [SI::pascal];
      subsystem.controller.stopPressure == 300.0 [SI::pascal];
    }
  }

  satisfy vacuumPumpFunctionalRequirement by VacuumPumpingSubsystem::pump;
  satisfy targetVacuumRequirement by VacuumPumpingSubsystem::receiver;
  satisfy inletProtectionRequirement by VacuumPumpingSubsystem::separator;
  satisfy backflowPreventionRequirement by VacuumPumpingSubsystem::dischargeCheckValve;
  satisfy electricalCompatibilityRequirement by VacuumPumpingSubsystem::pump;
  satisfy thermalProtectionRequirement by VacuumPumpingSubsystem::pump;
  satisfy controlRequirement by VacuumPumpingSubsystem::controller;
}
