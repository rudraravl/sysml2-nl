    }

    constraint pumpCapacityLimit {
      processInlet.gasIn.volumetricFlow <= ratedEvacuationFlow;
    }

    constraint exhaustBackPressureLimit {
      exhaustOutlet.gasOut.absolutePressure <= pump.maximumExhaustPressure;
    }

    constraint receiverVacuumPerformance {
      receiver.currentPressure <= normalOperatingPressure
      implies subsystemStatus.status.running == false or pump.status.status.running == true;
    }

    action def EvacuateReceiver {
      in initialPressure : Pressure;
      out finalPressure : Pressure;

      action openInletValve;
      action startVacuumPump;
      action removeGasFromReceiver;
      action holdTargetPressure;

      constraint evacuationGoal {
        finalPressure <= receiver.targetPressure;
      }

      constraint pumpDownTimeGoal {
        expectedReceiverPumpDownTime <= 300.0 [SI::second];
      }
    }
  }

  requirement def PumpingSubsystemRequirement {
    subject subsystem : VacuumPumpingSubsystem;
  }

  requirement vacuumPumpFunctionalRequirement : PumpingSubsystemRequirement {
    doc /* The subsystem shall move gas and vapor from the process inlet to the exhaust outlet by using a vacuum pump. */
    require constraint {
      subsystem.pump.nominalPumpingSpeed >= 200.0 [SI::litre / SI::minute];
    }
  }

  requirement targetVacuumRequirement : PumpingSubsystemRequirement {
    doc /* The subsystem shall reduce receiver pressure to 500 Pa or less during normal evacuation. */
    require constraint {
      subsystem.receiver.currentPressure <= 500.0 [SI::pascal];
    }
  }

  requirement inletProtectionRequirement : PumpingSubsystemRequirement {
    doc /* The subsystem shall prevent excessive liquid carryover into the vacuum pump. */
    require constraint {
      subsystem.separator.separationEfficiency >= 95.0;
      subsystem.separator.liquidHoldUp <= subsystem.separator.maximumLiquidHoldUp;
    }
  }

  requirement backflowPreventionRequirement : PumpingSubsystemRequirement {
    doc /* The subsystem shall prevent exhaust backflow into the vacuum receiver when the pump is stopped. */
    require constraint {
      subsystem.dischargeCheckValve.reverseLeakRate <= 0.05 [SI::litre / SI::minute];
    }
  }

  requirement electricalCompatibilityRequirement : PumpingSubsystemRequirement {
    doc /* The subsystem shall operate from a 230 V single phase electrical supply. */
    require constraint {
      subsystem.pump.ratedVoltage == 230.0 [SI::volt];
      subsystem.pump.ratedMotorPower <= 1000.0 [SI::watt];
    }
  }

  requirement thermalProtectionRequirement : PumpingSubsystemRequirement {
    doc /* The subsystem shall enter a faulted state when pump seal temperature exceeds its safe operating limit. */
    require constraint {
      subsystem.pump.maximumSealTemperature <= 363.15 [SI::kelvin];
    }
  }

  requirement controlRequirement : PumpingSubsystemRequirement {
    doc /* The controller shall start the pump above the high pressure threshold and stop it below the low pressure threshold. */
    require constraint {
      subsystem.controller.startPressure == 2500.0 [SI::pascal];
      subsystem.controller.stopPressure == 300.0 [SI::pascal];
    }
  }

  satisfy vacuumPumpFunctionalRequirement by VacuumPumpingSubsystem::pump;
  satisfy targetVacuumRequirement by VacuumPumpingSubsystem::receiver;
  satisfy inletProtectionRequirement by VacuumPumpingSubsystem::separator;
  satisfy backflowPreventionRequirement by VacuumPumpingSubsystem::dischargeCheckValve;
  satisfy electricalCompatibilityRequirement by VacuumPumpingSubsystem::pump;
  satisfy thermalProtectionRequirement by VacuumPumpingSubsystem::pump;
  satisfy controlRequirement by VacuumPumpingSubsystem::controller;
