        first hold
        then shutdown
        if emergencyStopActive;

      transition shutdown_to_idle
        first shutdown
        then idle
        if not pumpStatus.status.running;

      transition any_to_lockout
        first idle, startRequest, running, hold, shutdown
        then lockout
        if pumpStatus.status.faulted;
