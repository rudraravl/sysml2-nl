    requirement def OperatingRangeRequirement {
        id = "CIR-REQ-003";
        text = "The system shall decode valid remote-control commands at a line-of-sight distance of at least 8 m within a receiver incident angle of plus or minus 45 degrees.";
    }

    requirement def LatencyRequirement {
        id = "CIR-REQ-004";
        text = "The system shall deliver an accepted host command within 30 ms after the final pulse of a valid non-repeat IR frame.";
    }

    requirement def FalseCommandRequirement {
        id = "CIR-REQ-005";
        text = "The system shall limit false accepted commands caused by ambient light or invalid pulse timing to no more than one per one million received invalid frames.";
    }

    requirement def ProtocolSupportRequirement {
        id = "CIR-REQ-006";
        text = "The protocol decoder shall identify and decode NEC, RC5, RC6, and Sony SIRC consumer IR frame formats.";
    }

    requirement def IntegrityRequirement {
        id = "CIR-REQ-007";
        text = "The command mapper shall reject frames with invalid checksum, invalid toggle semantics, unsupported protocol, or unmapped command code.";
    }

    requirement def RepeatHandlingRequirement {
        id = "CIR-REQ-008";
        text = "The dispatcher shall suppress duplicate repeat frames inside the repeat suppression window unless the mapped command is explicitly repeatable.";
    }

    requirement def PowerRequirement {
        id = "CIR-REQ-009";
        text = "The Consumer IR control system shall operate from a 5 V input supply and regulate internal electronics to 3.3 V.";
    }

    requirement def DiagnosticsRequirement {
        id = "CIR-REQ-010";
        text = "The system shall emit diagnostic events for receiver saturation, timing rejection, unsupported protocol, integrity failure, and dispatch rejection.";
    }

    satisfy HighLevelFunctionRequirement by ConsumerIRControlSystem;
    satisfy CarrierCompatibilityRequirement by IRPhotodiodeReceiver;
    satisfy OperatingRangeRequirement by ConsumerIRControlSystem;
    satisfy LatencyRequirement by CommandDispatcher;
    satisfy FalseCommandRequirement by PulseTimingFilter;
    satisfy ProtocolSupportRequirement by ProtocolDecoder;
    satisfy IntegrityRequirement by CommandMapper;
    satisfy RepeatHandlingRequirement by CommandDispatcher;
    satisfy PowerRequirement by PowerRegulator;
    satisfy DiagnosticsRequirement by ConsumerIRControlSystem;
}
