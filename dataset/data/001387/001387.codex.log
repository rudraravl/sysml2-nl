                in item incomingIR;
            }

            action demodulateCarrier {
                in item incomingIR;
                out item pulses : DemodulatedPulseTrain;
            }

            action filterPulseTiming {
                in item pulses;
                out item cleanPulses : DemodulatedPulseTrain;
            }

            action decodeProtocolFrame {
                in item cleanPulses;
                out item frame : IRFrame;
            }

            action mapConsumerCommand {
                in item frame;
                out item command : ConsumerCommand;
            }

            action suppressInvalidRepeats {
                in item command;
                out item acceptedCommand : ConsumerCommand;
            }

            action deliverHostCommand {
                in item acceptedCommand;
                out item hostCommand;
            }
        }

        state def IRControlOperationalState {
            state Unpowered;
            state Initializing;
            state Idle;
            state ReceivingFrame;
            state DecodingFrame;
            state DispatchingCommand;
            state Fault;

