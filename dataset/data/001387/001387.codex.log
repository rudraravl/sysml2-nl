        part receiver : IRPhotodiodeReceiver;
        part filter : PulseTimingFilter;
        part decoder : ProtocolDecoder;
        part mapper : CommandMapper;
        part dispatcher : CommandDispatcher;
        part host : HostConsumerDevice;
        part regulator : PowerRegulator;

        connect opticalInput to irWindow.opticalIn;
        connect irWindow.opticalOut to receiver.opticalIn;
        connect receiver.pulseOut to filter.pulseIn;
        connect filter.pulseOut to decoder.pulseIn;
        connect decoder.frameOut to mapper.frameIn;
        connect mapper.commandOut to dispatcher.commandIn;
        connect dispatcher.commandOut to commandOutput;
        connect dispatcher.commandOut to host.commandIn;

        connect powerInput to regulator.powerIn;
        connect regulator.regulatedPowerOut to receiver.powerIn;

        connect receiver.diagnosticOut to diagnosticOutput;
        connect filter.diagnosticOut to diagnosticOutput;
        connect decoder.diagnosticOut to diagnosticOutput;
        connect mapper.diagnosticOut to diagnosticOutput;
        connect dispatcher.diagnosticOut to diagnosticOutput;

