        attribute biohazardLocked : Boolean = true;
    }

    part def MedicalLaboratoryInstrumentSystem {
        doc /* Primary function: receive patient laboratory specimens and electronic test orders, prepare and process specimens using medical laboratory instruments, generate clinically usable measurements, validate results, and transmit finalized results to the laboratory information system. */

        port specimenEntry : SpecimenInputPort;
        port orderEntry : OrderPort;
        port resultExit : ResultPort;
        port facilityPower : PowerPort;
        port lisNetwork : NetworkPort;

        part lis : LaboratoryInformationSystem;
        part barcodeReader : BarcodeReader;
        part specimenHandler : SpecimenHandler;
        part centrifuge : ClinicalCentrifuge;
        part reagentBay : RefrigeratedReagentBay;
        part chemistryAnalyzer : AutomatedChemistryAnalyzer;
        part hematologyAnalyzer : HematologyAnalyzer;
        part microscope : DigitalMicroscope;
        part incubator : LaboratoryIncubator;
        part resultProcessor : ResultProcessor;
        part wasteContainer : WasteContainer;

        item specimenFlow : Specimen;
        item preparedSpecimenFlow : Specimen;
        item separatedSpecimenFlow : Specimen;
        item opticalSignalFlow : MeasurementSignal;
        item resultFlow : TestResult;
        item reagentFlow : Reagent;
        item wasteFlow : Waste;
        item orderFlow : TestOrder;

        connect specimenEntry to barcodeReader.specimenIn;
        connect barcodeReader.specimenOut to specimenHandler.specimenIn;
        connect specimenHandler.specimenOut to centrifuge.specimenIn;
        connect centrifuge.specimenOut to chemistryAnalyzer.specimenIn;
        connect reagentBay.reagentIn to chemistryAnalyzer.reagentIn;
        connect chemistryAnalyzer.signalOut to resultProcessor.signalIn;
        connect orderEntry to resultProcessor.orderIn;
        connect resultProcessor.resultOut to resultExit;
        connect resultExit to lis.network;
        connect lisNetwork to lis.network;

        connect specimenHandler.wasteOut to wasteContainer.wasteIn;
        connect chemistryAnalyzer.wasteOut to wasteContainer.wasteIn;
        connect hematologyAnalyzer.wasteOut to wasteContainer.wasteIn;

        connect facilityPower to centrifuge.power;
        connect facilityPower to chemistryAnalyzer.power;
        connect facilityPower to hematologyAnalyzer.power;
        connect facilityPower to microscope.power;
        connect facilityPower to incubator.power;

        connection wholeBloodPath connect specimenHandler.specimenOut to hematologyAnalyzer.specimenIn;
        connection microscopyPath connect specimenHandler.specimenOut to microscope.specimenIn;
        connection culturePath connect specimenHandler.specimenOut to incubator.specimenIn;
        connection incubatedReviewPath connect incubator.specimenOut to microscope.specimenIn;
        connection hematologyResultPath connect hematologyAnalyzer.resultOut to resultExit;
        connection microscopyResultPath connect microscope.resultOut to resultExit;

        exhibit state systemState : InstrumentOperatingState;

        perform action highLevelDiagnosticWorkflow {
            first start;
            then receiveOrder;
            then verifySpecimen;
            then prepareSpecimen;
            then routeByTestKind;
            then acquireMeasurement;
            then computeAndValidateResult;
            then releaseToLIS;
            then archiveAndClean;

            action receiveOrder {
                in item order : TestOrder;
                out item acceptedOrder : TestOrder;
            }

            action verifySpecimen : VerifySpecimenIdentity {
                in item specimen = specimenEntry.specimen;
            }

            action prepareSpecimen : PrepareSpecimen;

            action routeByTestKind {
                in item order : TestOrder;
                in item specimen : Specimen;
                out item routedSpecimen : Specimen;
            }

            action acquireMeasurement {
                in item routedSpecimen : Specimen;
                out item measurement : MeasurementSignal;
            }

            action computeAndValidateResult : ComputeResult;

            action releaseToLIS : ReleaseResult;

            action archiveAndClean : CleanFluidPath;
        }
    }

    requirement def PrimaryFunctionRequirement {
        subject system : MedicalLaboratoryInstrumentSystem;
        doc /* The system shall provide a coordinated medical laboratory instrument capability that transforms accepted patient specimens and test orders into validated laboratory results for clinical use. */
        require constraint {
            system.lis.connected == true
        }
    }

    requirement def SpecimenIdentificationRequirement {
        subject reader : BarcodeReader;
        doc /* Each specimen shall be positively identified before automated processing begins. */
        require constraint {
            reader.scanTime <= 5 [SI::unit::second]
        }
    }

    requirement def ReagentStorageRequirement {
        subject bay : RefrigeratedReagentBay;
        doc /* Reagents shall be stored within controlled refrigerated limits to preserve analytical validity. */
        require constraint {
            bay.targetTemperature >= 2 [SI::unit::degreeCelsius] and
            bay.targetTemperature <= 8 [SI::unit::degreeCelsius]
        }
    }

    requirement def CentrifugePerformanceRequirement {
        subject centrifuge : ClinicalCentrifuge;
        doc /* The centrifuge shall support serum or plasma separation before chemistry analysis. */
        require constraint {
            centrifuge.maximumSpeed >= 3500
        }
    }

    requirement def ChemistryMeasurementRequirement {
        subject analyzer : AutomatedChemistryAnalyzer;
        doc /* The chemistry analyzer shall maintain reaction temperature and perform optical measurement for quantitative assays. */
        require constraint {
            analyzer.cuvetteTemperature >= 36 [SI::unit::degreeCelsius] and
            analyzer.cuvetteTemperature <= 38 [SI::unit::degreeCelsius]
        }
    }

    requirement def ResultReleaseRequirement {
        subject processor : ResultProcessor;
        doc /* The result processor shall release only results meeting confidence and validation rules. */
        require constraint {
            processor.minimumConfidenceForAutorelease >= 95 [SI::unit::percent]
        }
    }

    requirement def WasteContainmentRequirement {
        subject wasteContainer : WasteContainer;
        doc /* Biohazardous liquid waste shall be collected in a locked container with known capacity. */
        require constraint {
            wasteContainer.capacity >= 10 [SI::unit::litre] and
            wasteContainer.biohazardLocked == true
        }
    }

    requirement def InstrumentAvailabilityRequirement {
        subject system : MedicalLaboratoryInstrumentSystem;
        doc /* The system shall keep major analytical instruments powered and able to enter ready state during laboratory operation. */
        require constraint {
            system.facilityPower.supplyVoltage >= 110 [SI::unit::volt]
        }
    }

    satisfy PrimaryFunctionRequirement by MedicalLaboratoryInstrumentSystem;
    satisfy SpecimenIdentificationRequirement by BarcodeReader;
    satisfy ReagentStorageRequirement by RefrigeratedReagentBay;
    satisfy CentrifugePerformanceRequirement by ClinicalCentrifuge;
    satisfy ChemistryMeasurementRequirement by AutomatedChemistryAnalyzer;
    satisfy ResultReleaseRequirement by ResultProcessor;
    satisfy WasteContainmentRequirement by WasteContainer;
    satisfy InstrumentAvailabilityRequirement by MedicalLaboratoryInstrumentSystem;
}
