    satisfy MaximumPressureRequirement by hcngStationDispenser.pressureTemperatureSensor;
    satisfy EmergencyStopRequirement by hcngStationDispenser.controller;
    satisfy LeakCheckRequirement by hcngStationDispenser.nozzle;
}
