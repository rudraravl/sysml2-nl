            state preparing;
            state sterileReady;
            state navigating;
            state treating;
            state paused;
            state recovering;
            state faulted;
            state shutdown;

            transition first idle;
            transition idleToPreparing
                first idle
                accept OperatorCommand
                if operatorCommand.enableMotion
                then preparing;

