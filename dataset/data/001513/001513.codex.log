                then Cooling
                if currentTemperature > targetCoolSetpoint + 0.3;

            transition Heating_to_Idle
                first Heating
                then Idle
                if currentTemperature >= targetHeatSetpoint;

            transition Cooling_to_Idle
                first Cooling
                then Idle
                if currentTemperature <= targetCoolSetpoint;

            transition Idle_to_Heating
                first Idle
                then Heating
                if activeMode == HVACMode::heat or activeMode == HVACMode::heatCool;

            transition Idle_to_Cooling
                first Idle
                then Cooling
                if activeMode == HVACMode::cool or activeMode == HVACMode::heatCool;

            transition ScheduledComfort_to_OfflineSafeControl
                first ScheduledComfort
                then OfflineSafeControl
                if remoteNetwork.connectivity == ConnectivityState::offline;

            transition OfflineSafeControl_to_ScheduledComfort
                first OfflineSafeControl
                then ScheduledComfort
                if remoteNetwork.connectivity == ConnectivityState::cloudConnected;

