        part hvacInterface : HVACInterface;

        port powerInput : PowerPort;
        port hvacControl : HVACControlPort;
        port cloudNetwork : NetworkPort;
        port userCommands : UserInputPort;

        attribute primaryFunction : ScalarValues::String =
            "Automatically maintain comfortable indoor temperature while learning occupant preferences, optimizing energy use, and controlling heating, cooling, and fan equipment.";

        attribute enclosureTemperatureLimit : Temperature = 45.0;
        attribute nominalOperatingPower : ElectricalPower = 3.5;
        attribute expectedServiceVoltage : Voltage = 24.0;

        connect ambientSensor.temperaturePort to controller.temperatureInput;
        connect ambientSensor.humidityPort to controller.humidityInput;
        connect occupancySensor.occupancyPort to controller.occupancyInput;
        connect userInterface.userPort to controller.localUserInput;
        connect wirelessModule.networkPort to controller.remoteNetwork;
        connect controller.hvacOutput to hvacInterface.controlPort;
        connect hvacInterface.controlPort to hvacControl;
        connect hvacInterface.powerPort to powerInput;
        connect wirelessModule.networkPort to cloudNetwork;
        connect userInterface.userPort to userCommands;

        action regulateIndoorClimate {
            in item temperatureReading : TemperatureReading;
            in item humidityReading : HumidityReading;
            in item occupancyReading : OccupancyReading;
            in item localCommand : UserCommand;
            in item remoteCommand : UserCommand;
            out item hvacCommand : HVACCommand;

            first start;
            then sense;
            then updateLearning;
            then selectSetpoints;
            then commandEquipment;
            then reportEnergy;
            then done;

            action sense {
                out attribute indoorTemperature : Temperature;
                out attribute indoorHumidity : RelativeHumidity;
                out attribute occupancyConfidence : OccupancyConfidence;
            }

            action updateLearning {
                in item localCommand : UserCommand;
                in item remoteCommand : UserCommand;
                out item schedule : ScheduleProfile;
            }

            action selectSetpoints {
                in item schedule : ScheduleProfile;
                in attribute occupancyConfidence : OccupancyConfidence;
                out attribute heatSetpoint : Temperature;
                out attribute coolSetpoint : Temperature;
            }

            action commandEquipment {
                in attribute indoorTemperature : Temperature;
                in attribute heatSetpoint : Temperature;
                in attribute coolSetpoint : Temperature;
                out item hvacCommand : HVACCommand;
            }

            action reportEnergy {
                in item hvacCommand : HVACCommand;
                out item report : EnergyReport;
            }
        }
    }

    part def ResidenceHVACSystem {
        part thermostat : NestLearningThermostat;
        part heatingPlant {
            port commandInput : HVACControlPort;
            attribute maximumHeatOutput : ElectricalPower = 12000.0;
            attribute enabled : ScalarValues::Boolean;
        }
        part coolingPlant {
            port commandInput : HVACControlPort;
            attribute maximumCoolingPower : ElectricalPower = 3500.0;
            attribute enabled : ScalarValues::Boolean;
        }
        part indoorFan {
            port commandInput : HVACControlPort;
            attribute fanPower : ElectricalPower = 450.0;
            attribute enabled : ScalarValues::Boolean;
        }
        part conditionedSpace {
            attribute indoorTemperature : Temperature = 21.0;
            attribute indoorHumidity : RelativeHumidity = 45.0;
            attribute thermalLossRate : TemperatureRate = 0.03;
        }

        connect thermostat.hvacControl to heatingPlant.commandInput;
        connect thermostat.hvacControl to coolingPlant.commandInput;
        connect thermostat.hvacControl to indoorFan.commandInput;
    }

    requirement def PrimaryFunctionRequirement {
        doc /* The thermostat shall maintain indoor thermal comfort by sensing indoor conditions, learning occupant preferences and occupancy patterns, selecting appropriate setpoints, and commanding connected HVAC equipment. */

        subject thermostat : NestLearningThermostat;

        require constraint {
            thermostat.controller.currentTemperature >= thermostat.controller.targetHeatSetpoint - 1.0 and
            thermostat.controller.currentTemperature <= thermostat.controller.targetCoolSetpoint + 1.0
        }
    }

    requirement def LearningRequirement {
        doc /* The thermostat shall update its schedule profile from repeated manual adjustments and occupancy observations without requiring explicit schedule programming. */

        subject thermostat : NestLearningThermostat;

        require constraint {
            thermostat.controller.learnedProfile.ecoHeatSetpoint < thermostat.controller.learnedProfile.morningSetpoint and
            thermostat.controller.learnedProfile.ecoCoolSetpoint > thermostat.controller.learnedProfile.eveningSetpoint
        }
    }

    requirement def EnergyOptimizationRequirement {
        doc /* The thermostat shall reduce HVAC operation during unoccupied periods by entering Eco mode when occupancy confidence remains below 30 percent. */

        subject thermostat : NestLearningThermostat;

        require constraint {
            thermostat.controller.occupiedConfidence < 30.0 implies thermostat.controller.activeMode == HVACMode::eco
        }
    }

    requirement def SafetyRequirement {
        doc /* The thermostat shall prevent simultaneous heating and cooling commands and shall enforce compressor protection delay before restarting cooling. */

        subject thermostat : NestLearningThermostat;

        require constraint {
            not (thermostat.hvacInterface.heatRelayClosed and thermostat.hvacInterface.coolRelayClosed)
        }
    }

    requirement def ConnectivityRequirement {
        doc /* The thermostat shall continue local climate control using the learned schedule when cloud connectivity is unavailable. */

        subject thermostat : NestLearningThermostat;

        require constraint {
            thermostat.wirelessModule.connectivity == ConnectivityState::offline implies thermostat.controller.activeMode != HVACMode::off
        }
    }

    requirement def PowerRequirement {
        doc /* The thermostat shall operate from a nominal 24 volt HVAC control circuit and consume less than 5 watts during normal operation. */

        subject thermostat : NestLearningThermostat;

        require constraint {
            thermostat.expectedServiceVoltage == 24.0 and
            thermostat.nominalOperatingPower < 5.0
        }
    }

    satisfy PrimaryFunctionRequirement by NestLearningThermostat::regulateIndoorClimate;
    satisfy LearningRequirement by LearningController::learnSchedule;
    satisfy EnergyOptimizationRequirement by LearningController::applyEcoPolicy;
    satisfy SafetyRequirement by HVACInterface::energizeRelays;
    satisfy ConnectivityRequirement by LearningController::ControllerStateMachine;
    satisfy PowerRequirement by NestLearningThermostat;

    part residenceInstallation : ResidenceHVACSystem;

}
