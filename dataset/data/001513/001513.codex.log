            state Cooling;
            state Idle;
            state OfflineSafeControl;
            state Fault;

            initial then Initializing;

            transition Initializing_to_Learning
                first Initializing
                then Learning;

            transition Learning_to_ScheduledComfort
                first Learning
                then ScheduledComfort
                if learnedProfile.morningSetpoint > 0.0;

            transition ScheduledComfort_to_EcoAway
                first ScheduledComfort
                then EcoAway
                if occupiedConfidence < 30.0;

            transition EcoAway_to_ScheduledComfort
                first EcoAway
                then ScheduledComfort
                if occupiedConfidence >= 70.0;

            transition ScheduledComfort_to_ManualHold
                first ScheduledComfort
                then ManualHold
                accept UserCommand
                if command.intent == UserIntent::holdTemperature;

            transition ManualHold_to_ScheduledComfort
                first ManualHold
                then ScheduledComfort
