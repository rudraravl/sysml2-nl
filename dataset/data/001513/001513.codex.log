        part controller : LearningController;
        part hvacInterface : HVACInterface;

        port powerInput : PowerPort;
        port hvacControl : HVACControlPort;
        port cloudNetwork : NetworkPort;
        port userCommands : UserInputPort;

        attribute primaryFunction : ScalarValues::String =
            "Automatically maintain comfortable indoor temperature while learning occupant preferences, optimizing energy use, and controlling heating, cooling, and fan equipment.";

        attribute enclosureTemperatureLimit : Temperature = 45.0;
        attribute nominalOperatingPower : ElectricalPower = 3.5;
        attribute expectedServiceVoltage : Voltage = 24.0;

