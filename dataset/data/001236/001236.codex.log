                beam.opticalPower = nominalOpticalPower;
                beam.modulationFrequency = modulationFrequency;
                beam.beamDivergence_mrad = beamDivergence_mrad;
            }
            then done;
        }

        state def TransmitterState {
            entry action initializeDriver;
            state Off;
            state WarmUp;
            state Emitting;
