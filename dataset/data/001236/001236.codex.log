        satisfy healthReq;

    analysis def ScintillationMeasurementAnalysis {
        in item signal : PropagatedOpticalSignal;
        in item metData : MeteorologicalData;
        out item result : AtmosphericPathMeasurement;

        objective computeCn2 {
            doc
