        doc /* The system shall deliver radiographic contrast media and saline according to an operator-selected injection protocol for imaging support. */
        subject injector : MedradHighPressureInjectorSystem;

        require constraint {
            injector.maximumContrastVolume >= 100.0 and
            injector.maximumSalineVolume >= 50.0 and
            injector.maximumProgrammableFlowRate >= 5.0
        }
    }

    requirement def PressureSafetyRequirement {
        doc /* The system shall prevent injection when measured fluid pressure exceeds the programmed maximum pressure. */
        subject injector : MedradHighPressureInjectorSystem;

        require constraint {
            injector.maximumSystemPressure <= 325.0
        }
    }

    requirement def AirDetectionRequirement {
        doc /* The system shall stop or inhibit injection when air is detected in the disposable fluid path. */
        subject detector : AirDetector;

        require constraint {
            detector.sensitivityThreshold <= 0.1
        }
    }

    requirement def ProtocolValidationRequirement {
        doc /* The system shall reject protocols with nonpositive flow rates, negative volumes, or pressure limits above the system maximum. */
        subject controller : ProtocolController;

        require constraint {
            controller.activeProtocol.contrastVolume >= 0.0 and
            controller.activeProtocol.salineVolume >= 0.0 and
            controller.activeProtocol.contrastFlowRate > 0.0 and
            controller.activeProtocol.salineFlowRate > 0.0 and
            controller.activeProtocol.maximumPressure <= 325.0
        }
    }

    requirement def OperatorStatusRequirement {
        doc /* The system shall provide operating mode, active injection phase, delivered volumes, pressure, remaining time, and fault status to the operator. */
        subject status : InjectionStatus;

        require constraint {
            status.deliveredContrastVolume >= 0.0 and
            status.deliveredSalineVolume >= 0.0 and
            status.measuredPressure >= 0.0
        }
    }

    requirement def EmergencyStopRequirement {
        doc /* The system shall transition to emergency stopped mode when the operator requests an immediate stop. */
        subject controller : ProtocolController;

        require constraint {
            controller.currentMode != InjectorOperatingMode::injecting or
            controller.faultLatched == false
        }
    }

    satisfy PrimaryFunctionRequirement by MedradHighPressureInjectorSystem;
    satisfy PressureSafetyRequirement by MedradHighPressureInjectorSystem;
    satisfy AirDetectionRequirement by AirDetector;
    satisfy ProtocolValidationRequirement by ProtocolController;
    satisfy OperatorStatusRequirement by InjectionStatus;
    satisfy EmergencyStopRequirement by ProtocolController;

}
