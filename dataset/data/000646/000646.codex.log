        attribute widthPixels : Integer;
        attribute heightPixels : Integer;
        attribute frameRate : ImageFrameRateValue;
        attribute colorDepthBits : Integer;
    }

    item def IlluminationEnergy {
        attribute opticalPower : PowerValue;
        attribute wavelengthMinimum : LengthValue;
        attribute wavelengthMaximum : LengthValue;
    }

    item def InsufflationGas {
        attribute gasType : String;
        attribute flowRate : FlowRateValue;
        attribute pressure : PressureValue;
