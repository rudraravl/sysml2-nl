        attribute maximumVacuumPressure : PressureValue;
        attribute maximumAspirateFlow : FlowRateValue;
        port powerIn : PowerInputPort;
        port commandIn : CommandInputPort;
        port suctionIn : SuctionPort;

        action removeFluidAndDebris {
            in item aspirate : SuctionMaterial;
            first start;
            then applyVacuum;
            then collectAspirate;
            then stopVacuum;
        }
    }

