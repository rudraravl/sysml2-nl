        port lightIn : LightOutputPort;
        port gasIn : GasPort;
        port fluidIn : FluidPort;
        port suctionOut : SuctionPort;
        port imageOut : ImageOutputPort;
        port distalInterface : PatientInterfacePort;
        port toolChannel : WorkingChannelPort;
