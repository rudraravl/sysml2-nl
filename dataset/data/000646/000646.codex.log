        port gasOut : GasPort;
        port fluidOut : FluidPort;

        action regulateInsufflation {
            in item command : OperatorCommand;
            out item gas : InsufflationGas;
            first start;
            then measurePressure;
            then adjustPumpSpeed;
            then deliverGas;
        }

        action deliverIrrigation {
            in item command : OperatorCommand;
            out item fluid : IrrigationFluid;
            first start;
            then openFluidValve;
            then regulateFlow;
            then deliverFluid;
        }
    }

