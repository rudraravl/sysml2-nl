        port fluidOut : FluidPort;
        port imageOut : ImageOutputPort;
        port tissueInterface : PatientInterfacePort;
    }

    part def ImagingSensor {
        attribute widthPixels : Integer;
        attribute heightPixels : Integer;
        attribute frameRate : ImageFrameRateValue;
        attribute sensorTemperature : TemperatureValue;
        port powerIn : PowerInputPort;
        port imageOut : ImageOutputPort;

        action captureMucosalImage {
            in item tissue : PatientTissue;
            out item image : OpticalImage;
            first start;
            then exposeSensor;
            then digitizeSignal;
            then outputFrame;
        }
    }

    part def BiopsyForceps {
        attribute cupDiameter : DiameterValue;
        attribute usableLength : LengthValue;
        attribute jawOpenWidth : LengthValue;
        port channelInterface : WorkingChannelPort;

        action collectBiopsy {
            in item tissue : PatientTissue;
            out item sample : BiopsySample;
            first start;
            then advanceThroughChannel;
            then openJaws;
            then closeJawsOnTissue;
            then retrieveSample;
        }
    }

    part def HandControl {
        attribute upDownAngulationRange : AngleValue;
        attribute leftRightAngulationRange : AngleValue;
        port commandOut : CommandInputPort;
        port toolPort : WorkingChannelPort;

        action steerDistalTip {
            in item command : OperatorCommand;
            first start;
            then translateKnobMotion;
            then tensionControlWires;
            then holdBendPosition;
        }
    }

    part def EndoscopyCartPowerSupply {
        attribute nominalVoltage : VoltageValue;
        attribute maximumPower : PowerValue;
        port powerOut : PowerInputPort;
    }

    part def GastroenterologyVideoEndoscopeSystem {
        attribute systemName : String = "Flexible Video Endoscope System";
        attribute primaryFunction : String = "Provide direct visualization, insufflation, irrigation, suction, and biopsy access for diagnostic and therapeutic examination of the gastrointestinal tract.";

        port operatorCommandIn : CommandInputPort;
        port patientInterface : PatientInterfacePort;

        part powerSupply : EndoscopyCartPowerSupply {
            attribute nominalVoltage = 120 [V];
            attribute maximumPower = 900 [W];
        }

        part processor : VideoProcessor {
            attribute maximumFrameRate = 60;
            attribute latency = 80 [ms];
        }

        part display : MedicalDisplay {
            attribute diagonalSize = 686 [mm];
            attribute brightness = 700;
            attribute widthPixels = 1920;
            attribute heightPixels = 1080;
        }

        part lightSource : LightSource {
            attribute maximumOpticalPower = 120 [W];
            attribute minimumWavelength = 400 [nm];
            attribute maximumWavelength = 700 [nm];
            attribute operatingTemperature = 315 [K];
        }

        part pump : AirWaterPump {
            attribute maximumGasPressure = 6 [kPa];
            attribute maximumFluidFlow = 120 [ml/s];
            attribute maximumGasFlow = 45 [ml/s];
        }

        part suctionController : SuctionController {
            attribute maximumVacuumPressure = 60 [kPa];
            attribute maximumAspirateFlow = 800 [ml/min];
        }

        part handControl : HandControl {
            attribute upDownAngulationRange = 210 [deg];
            attribute leftRightAngulationRange = 160 [deg];
        }

        part insertionTube : InsertionTube {
            attribute workingLength = 1350 [mm];
            attribute outerDiameter = 9.8 [mm];
            attribute bendingSectionLength = 90 [mm];
            attribute minimumBendRadius = 35 [mm];
        }

        part distalTip : DistalTip {
            attribute tipOuterDiameter = 9.8 [mm];
            attribute fieldOfView = 140 [deg];
            attribute depthOfFieldNear = 3 [mm];
            attribute depthOfFieldFar = 100 [mm];
        }

        part imagingSensor : ImagingSensor {
            attribute widthPixels = 1920;
            attribute heightPixels = 1080;
            attribute frameRate = 60;
            attribute sensorTemperature = 310 [K];
        }

        part biopsyForceps : BiopsyForceps {
            attribute cupDiameter = 2.3 [mm];
            attribute usableLength = 1600 [mm];
            attribute jawOpenWidth = 7 [mm];
        }

        connection power_to_light
            connect powerSupply.powerOut to lightSource.powerIn;

        connection power_to_pump
            connect powerSupply.powerOut to pump.powerIn;

        connection power_to_suction
            connect powerSupply.powerOut to suctionController.powerIn;

        connection power_to_sensor
            connect powerSupply.powerOut to imagingSensor.powerIn;

        connection operator_to_processor
            connect operatorCommandIn to processor.commandIn;

        connection operator_to_light
            connect operatorCommandIn to lightSource.commandIn;

        connection operator_to_pump
            connect operatorCommandIn to pump.commandIn;

        connection operator_to_suction
            connect operatorCommandIn to suctionController.commandIn;

        connection operator_to_hand_control
            connect operatorCommandIn to handControl.commandOut;

        connection light_to_tube
            connect lightSource.lightOut to insertionTube.lightIn;

        connection gas_to_tube
            connect pump.gasOut to insertionTube.gasIn;

        connection fluid_to_tube
            connect pump.fluidOut to insertionTube.fluidIn;

        connection tube_to_distal_light
            connect insertionTube.lightIn to distalTip.lightIn;

        connection tube_to_distal_gas
            connect insertionTube.gasIn to distalTip.gasOut;

        connection tube_to_distal_fluid
            connect insertionTube.fluidIn to distalTip.fluidOut;

        connection distal_to_patient
            connect distalTip.tissueInterface to patientInterface;

        connection sensor_to_tube_image
            connect imagingSensor.imageOut to insertionTube.imageOut;

        connection tube_image_to_processor
            connect insertionTube.imageOut to processor.imageIn;

        connection processor_to_display
            connect processor.displayOut to display.imageIn;

        connection suction_from_tube
            connect insertionTube.suctionOut to suctionController.suctionIn;

        connection biopsy_to_hand_control
            connect biopsyForceps.channelInterface to handControl.toolPort;

        connection hand_control_to_tube_channel
            connect handControl.toolPort to insertionTube.toolChannel;

        action performEndoscopicExamination {
            in item command : OperatorCommand;
            in item tissue : PatientTissue;
            out item image : OpticalImage;
            out item sample : BiopsySample;

            first prepareSystem;
            then verifyPowerAndSelfTest;
            then enableIllumination;
            then insertAndSteerScope;
            then insufflateLumen;
            then irrigateAsNeeded;
            then captureAndDisplayImage;
            then aspirateFluidAndDebris;
            then collectBiopsyIfCommanded;
            then withdrawScope;
            then shutdownSystem;
        }

        state def EndoscopyProcedureState {
            state poweredOff;
            state selfTest;
            state ready;
            state insertion;
            state visualization;
            state therapy;
            state withdrawal;
            state cleaningRequired;
            state fault;

            transition first poweredOff;

            transition power_on
                first poweredOff
                then selfTest
                accept OperatorCommand
                if command.commandName == "PowerOn";

            transition self_test_passed
                first selfTest
                then ready
                accept OperatorCommand
                if command.commandName == "SelfTestPassed";

            transition begin_insertion
                first ready
                then insertion
                accept OperatorCommand
                if command.commandName == "BeginProcedure";

            transition image_available
                first insertion
                then visualization
                accept OpticalImage;

            transition therapeutic_access
                first visualization
                then therapy
                accept OperatorCommand
                if command.commandName == "UseWorkingChannel";

            transition therapy_complete
                first therapy
                then visualization
                accept OperatorCommand
                if command.commandName == "TherapyComplete";

            transition begin_withdrawal
                first visualization
                then withdrawal
                accept OperatorCommand
                if command.commandName == "Withdraw";

            transition procedure_complete
                first withdrawal
                then cleaningRequired
                accept OperatorCommand
                if command.commandName == "ProcedureComplete";

            transition fault_detected
                first visualization
                then fault
                accept OperatorCommand
                if command.commandName == "FaultDetected";
        }
    }

    requirement def PrimaryFunctionRequirement {
        subject system : GastroenterologyVideoEndoscopeSystem;
        require constraint {
            system.primaryFunction == "Provide direct visualization, insufflation, irrigation, suction, and biopsy access for diagnostic and therapeutic examination of the gastrointestinal tract."
        }
    }

    requirement def VisualizationRequirement {
        subject sensor : ImagingSensor;
        require constraint {
            sensor.widthPixels >= 1280 and sensor.heightPixels >= 720 and sensor.frameRate >= 30
        }
    }

    requirement def InsertionTubeRequirement {
        subject tube : InsertionTube;
        require constraint {
            tube.outerDiameter <= 12 [mm] and tube.workingLength >= 1000 [mm]
        }
    }

    requirement def IlluminationRequirement {
        subject source : LightSource;
        require constraint {
            source.minimumWavelength <= 420 [nm] and source.maximumWavelength >= 650 [nm]
        }
    }

    requirement def InsufflationSafetyRequirement {
        subject pump : AirWaterPump;
        require constraint {
            pump.maximumGasPressure <= 8 [kPa]
        }
    }

    requirement def SuctionCapabilityRequirement {
        subject suction : SuctionController;
        require constraint {
            suction.maximumAspirateFlow >= 500 [ml/min]
        }
    }

    requirement def BiopsyAccessRequirement {
        subject forceps : BiopsyForceps;
        require constraint {
            forceps.cupDiameter <= 2.8 [mm] and forceps.usableLength >= 1400 [mm]
        }
    }

    requirement def PatientInterfaceRequirement {
        subject system : GastroenterologyVideoEndoscopeSystem;
        require constraint {
            system.insertionTube.outerDiameter == system.distalTip.tipOuterDiameter
        }
    }

    satisfy PrimaryFunctionRequirement by GastroenterologyVideoEndoscopeSystem;
    satisfy VisualizationRequirement by ImagingSensor;
    satisfy InsertionTubeRequirement by InsertionTube;
    satisfy IlluminationRequirement by LightSource;
    satisfy InsufflationSafetyRequirement by AirWaterPump;
    satisfy SuctionCapabilityRequirement by SuctionController;
    satisfy BiopsyAccessRequirement by BiopsyForceps;
    satisfy PatientInterfaceRequirement by GastroenterologyVideoEndoscopeSystem;
}
