    }

    port def WorkingChannelPort {
        out item instrument;
        in item sample : BiopsySample;
    }

    port def PowerInputPort {
        in item power : ElectricalPower;
    }

    port def CommandInputPort {
        in item command : OperatorCommand;
    }

    port def PatientInterfacePort {
        out item light : IlluminationEnergy;
        out item gas : InsufflationGas;
        out item fluid : IrrigationFluid;
        in item tissue : PatientTissue;
        in item aspirate : SuctionMaterial;
        in item sample : BiopsySample;
    }

    part def VideoProcessor {
        attribute supportedResolution : ResolutionValue;
        attribute maximumFrameRate : ImageFrameRateValue;
        attribute latency : TimeValue;
        port imageIn : ImageOutputPort;
        port commandIn : CommandInputPort;
        port displayOut : ImageOutputPort;

        action processImage {
            in item rawImage : OpticalImage;
            out item enhancedImage : OpticalImage;
            first start;
            then validateFrame;
            then applyColorCorrection;
            then reduceNoise;
            then deliverFrame;
        }
    }

    part def MedicalDisplay {
        attribute diagonalSize : LengthValue;
        attribute brightness : IlluminationValue;
        attribute widthPixels : Integer;
        attribute heightPixels : Integer;
        port imageIn : ImageOutputPort;
    }

    part def LightSource {
        attribute maximumOpticalPower : PowerValue;
        attribute minimumWavelength : LengthValue;
        attribute maximumWavelength : LengthValue;
        attribute operatingTemperature : TemperatureValue;
        port powerIn : PowerInputPort;
        port commandIn : CommandInputPort;
        port lightOut : LightOutputPort;

        state def LightSourceState {
            state off;
            state standby;
            state illuminating;
            state fault;

            entry action initializeLamp;
            transition first off;
            transition off_to_standby
                first off
                then standby
                accept OperatorCommand
                if command.commandName == "PowerOn";
            transition standby_to_illuminating
                first standby
                then illuminating
                accept OperatorCommand
                if command.commandName == "EnableLight";
            transition illuminating_to_standby
                first illuminating
                then standby
                accept OperatorCommand
                if command.commandName == "DisableLight";
            transition any_to_fault
                first illuminating
                then fault
                accept OperatorCommand
                if command.commandName == "FaultDetected";
        }
    }

    part def AirWaterPump {
        attribute maximumGasPressure : PressureValue;
        attribute maximumFluidFlow : FlowRateValue;
