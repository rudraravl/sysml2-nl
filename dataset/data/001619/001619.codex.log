        first AutomatedLaneKeeping
        then DriverOverride
        accept DriverIntent
        if intent.emergencyOverride;

      transition AutomatedCruise_to_MinimumRiskManeuver
        first AutomatedCruise
        then MinimumRiskManeuver
        if sensorInput::objects[0].range_m < 12.0;

      transition AutomatedLaneKeeping_to_MinimumRiskManeuver
        first AutomatedLaneKeeping
        then MinimumRiskManeuver
        if sensorInput::objects[0].range_m < 12.0;

      transition MinimumRiskManeuver_to_Standby
        first MinimumRiskManeuver
        then Standby
        if localizationInput::pose.speed_mps <= 0.5;

