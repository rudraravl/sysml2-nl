    port power : PowerPort;
    port sensorInput : SensorDataPort;
    port poseInput {
      in item pose : VehiclePose;
    }
    port nominalCommandInput {
      in item command : VehicleMotionCommand;
    }
    port safeCommandOutput : MotionCommandPort;

    action validateCommand {
      in item nominalCommand : VehicleMotionCommand;
      in item nearestObject : PerceptionObject;
      in item currentPose : VehiclePose;
      out item safeCommand : VehicleMotionCommand;
    }

    state def SafetyState {
      state Nominal;
      state Degraded;
      state EmergencyBraking;
      state SafeStop;

      transition first Nominal;

      transition Nominal_to_Degraded
        first Nominal
        then Degraded
        if sensorInput::lanes.confidence < 0.5;

      transition Nominal_to_EmergencyBraking
        first Nominal
        then EmergencyBraking
        if sensorInput::objects[0].range_m < minimumObstacleRange_m;

      transition Degraded_to_SafeStop
        first Degraded
        then SafeStop
        if poseInput::pose.speed_mps < 1.0;

      transition EmergencyBraking_to_SafeStop
        first EmergencyBraking
        then SafeStop
        if poseInput::pose.speed_mps <= 0.1;
    }
  }

  part def HumanMachineInterface {
    attribute displayRefreshRate_Hz : Real = 10.0;
    attribute audibleWarningLevel_dBA : Real = 72.0;

    port driverPort : DriverInterfacePort;
    port intentOutput {
      out item intent : DriverIntent;
    }
    port statusInput {
      in item statusText : String;
      in item warningActive : Boolean;
    }

    action presentAutomationStatus {
      in item statusText : String;
      in item warningActive : Boolean;
      out item driverIntent : DriverIntent;
    }
  }

  part def CameraSensor {
    attribute fieldOfView_rad : Angle;
    attribute detectionRange_m : Distance;
    port power : PowerPort;
  }

  part def RadarSensor {
    attribute detectionRange_m : Distance;
    attribute rangeResolution_m : Distance;
    port power : PowerPort;
  }

  part def LidarSensor {
    attribute detectionRange_m : Distance;
    attribute angularResolution_rad : Angle;
    port power : PowerPort;
  }

  part def PositionSensor {
    attribute horizontalAccuracy_m : Distance = 0.5;
    port power : PowerPort;
  }

  part def InertialSensor {
    attribute biasStability_radps : Real = 0.002;
    port power : PowerPort;
  }

  part def WheelSpeedSensor {
    attribute speedAccuracy_mps : Speed = 0.1;
    port power : PowerPort;
  }

  part def PropulsionController {
    attribute maximumDriveTorque_Nm : Real = 320.0;
    port power : PowerPort;
  }

  part def BrakeController {
    attribute maximumBrakePressure_bar : Real = 160.0;
    port power : PowerPort;
  }

  part def SteeringController {
    attribute maximumSteeringRate_radps : Real = 0.8;
    port power : PowerPort;
  }

  action def AutomatedDrivingMission {
    objective {
      doc "Maintain a safe automated driving path by sensing the environment, estimating vehicle state, selecting an appropriate driving mode, planning motion, validating safety constraints, and commanding vehicle actuators."
    }

    first startAutomation;
    then perceiveEnvironment;
    then estimateVehicleState;
    then decideDrivingMode;
    then planVehicleMotion;
    then superviseSafety;
    then commandActuators;

    action startAutomation;
    action perceiveEnvironment;
    action estimateVehicleState;
    action decideDrivingMode;
    action planVehicleMotion;
    action superviseSafety;
    action commandActuators;
  }

  requirement def PrimaryFunctionRequirement {
    doc "The system shall provide vehicular automation that controls vehicle speed and lane position at a high level while monitoring the driving environment and preserving driver override authority."
  }

  requirement def PerceptionRequirement {
    doc "The system shall detect forward objects within 120 m and estimate lane geometry with confidence values for automated motion planning."
  }

  requirement def LocalizationRequirement {
    doc "The system shall estimate vehicle pose with lateral error less than or equal to 0.35 m during automated operation."
  }

  requirement def MotionPlanningRequirement {
    doc "The system shall generate a motion command at least every 0.05 s using current pose, detected objects, lane geometry, and desired speed."
  }

  requirement def SafetyRequirement {
    doc "The system shall replace a nominal command with a safe braking command when an obstacle is detected closer than 8 m in the vehicle path."
  }

  requirement def DriverOverrideRequirement {
    doc "The system shall transition to DriverOverride or Manual mode when the driver requests emergency override."
  }

  satisfy PrimaryFunctionRequirement by VehicularAutomationSystem;
  satisfy PerceptionRequirement by PerceptionSubsystem;
  satisfy LocalizationRequirement by LocalizationSubsystem;
  satisfy MotionPlanningRequirement by MotionPlanningSubsystem;
  satisfy SafetyRequirement by SafetySupervisionSubsystem;
  satisfy DriverOverrideRequirement by AutomationController;

  package OperationalScenario {
    part automatedPassengerVehicle : VehicularAutomationSystem {
      attribute maxAutomatedSpeed_mps = 31.0;
      attribute minimumFollowingGap_s = 2.2;
    }

    item egoPose : VehiclePose {
      attribute x_m = 0.0;
      attribute y_m = 0.0;
      attribute heading_rad = 0.0;
      attribute speed_mps = 22.0;
      attribute yawRate_radps = 0.0;
    }

    item leadingVehicle : PerceptionObject {
      attribute objectId = 101;
      attribute range_m = 42.0;
      attribute bearing_rad = 0.01;
      attribute relativeSpeed_mps = -1.5;
      attribute confidence = 0.92;
    }

    item detectedLane : LaneModel {
      attribute leftBoundaryOffset_m = 1.85;
      attribute rightBoundaryOffset_m = -1.85;
      attribute curvature_1pm = 0.0008;
      attribute confidence = 0.88;
    }
  }
}
