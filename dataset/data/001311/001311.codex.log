        attribute nominalVoltage : Voltage = 3.7 [SI::volt];
        attribute lowBatteryThreshold : Voltage = 3.2 [SI::volt];
        attribute maximumOutputCurrent : Current = 0.250 [SI::ampere];

        port powerOutput : PowerInputPort;

        perform action regulatePower {
            out attribute regulatedVoltage : Voltage;

            first start;
            then monitorCellVoltage;
            then regulateOutput;
            then protectAgainstOvercurrent;
            then done;

            action monitorCellVoltage;
            action regulateOutput;
            action protectAgainstOvercurrent;
        }
    }

    part def VoltageDetector {
        attribute detectorName : String = "Portable Voltage Detector";
        attribute operatingTemperatureMinimum : Temperature = 253.15 [SI::kelvin];
        attribute operatingTemperatureMaximum : Temperature = 323.15 [SI::kelvin];
        attribute detectionResponseTime : TimeDuration = 0.300 [SI::second];

        port sensedVoltage : ProbeTipPort;
        port groundReference : GroundReferencePort;
        port userAlert : AlertPort;
        port diagnosticStatus : DiagnosticPort;

        part probe : VoltageProbe;
        part isolation : IsolationBarrier;
        part processor : VoltageMeasurementProcessor;
        part alertController : AlertController;
        part indicators : IndicatorAssembly;
        part powerSupply : BatteryPowerSupply;

        connect sensedVoltage to probe.tip;
        connect groundReference to probe.reference;
        connect probe.conditionedOutput to isolation.input;
        connect isolation.output to processor.measurementInput;
        connect processor.decisionOutput to alertController.decisionInput;
        connect alertController.alertOutput to indicators.alertInput;
        connect alertController.alertOutput to userAlert;
        connect processor.diagnosticOutput to diagnosticStatus;
        connect powerSupply.powerOutput to processor.measurementInput;

        perform action detectVoltage {
            in item electricalPotential : ElectricalPotentialSignal;
            out item decision : DetectionDecision;
            out item alert : UserAlert;

            first start;
            then acquirePotentialAtProbe;
            then conditionAndIsolateSignal;
            then classifyElectricalHazard;
            then notifyUserOfVoltageCondition;
            then done;

            action acquirePotentialAtProbe;
            action conditionAndIsolateSignal;
            action classifyElectricalHazard;
            action notifyUserOfVoltageCondition;
        }
    }

    requirement def PrimaryFunctionRequirement {
        subject detector : VoltageDetector;

        doc /* The voltage detector shall sense electrical potential at its probe input, determine whether the measured voltage represents a safe, caution, hazardous, or faulted condition, and provide a clear user alert within the specified response time. */

        require constraint {
            detector.detectionResponseTime <= 0.300 [SI::second]
        }
    }

    requirement def DetectionThresholdRequirement {
        subject processor : VoltageMeasurementProcessor;

        doc /* The voltage detector shall classify voltage below 30 V as safe, voltage from 50 V to below 120 V as caution, voltage from 120 V to 1000 V as hazardous, and voltage above 1000 V as a fault or over-range condition. */

        require constraint {
            processor.safeThreshold == 30 [SI::volt] and
            processor.cautionThreshold == 50 [SI::volt] and
            processor.hazardousThreshold == 120 [SI::volt] and
            processor.overRangeThreshold == 1000 [SI::volt]
        }
    }

    requirement def IsolationRequirement {
        subject barrier : IsolationBarrier;

        doc /* The voltage detector shall electrically isolate the measurement path from the user-accessible electronics for input voltages up to the rated isolation voltage. */

        require constraint {
            barrier.ratedIsolationVoltage >= 1500 [SI::volt] and
            barrier.leakageCurrentLimit <= 0.000001 [SI::ampere]
        }
    }

    requirement def AlertRequirement {
        subject controller : AlertController;

        doc /* The voltage detector shall provide visual indication for safe and caution conditions and both audible and visual indication for hazardous conditions. */

        require constraint {
            controller.visualSafeIntensity > 0.0 and
            controller.visualCautionIntensity > controller.visualSafeIntensity and
            controller.visualHazardIntensity >= controller.visualCautionIntensity and
            controller.audibleHazardLevel > 0.0
        }
    }

    requirement def DiagnosticRequirement {
        subject processor : VoltageMeasurementProcessor;

        doc /* The voltage detector shall report diagnostic status for battery voltage, probe continuity, isolation health, sensor saturation, and internal temperature. */

        require constraint {
            processor.samplePeriod <= 0.010 [SI::second]
        }
    }

    requirement def LowPowerRequirement {
        subject supply : BatteryPowerSupply;

        doc /* The voltage detector shall monitor battery voltage and identify a low-battery condition before regulated supply voltage becomes insufficient for detection processing. */

        require constraint {
            supply.lowBatteryThreshold >= 3.2 [SI::volt] and
            supply.nominalVoltage > supply.lowBatteryThreshold
        }
    }

    satisfy PrimaryFunctionRequirement by VoltageDetector::detectVoltage;
    satisfy DetectionThresholdRequirement by VoltageMeasurementProcessor::classifyVoltage;
    satisfy IsolationRequirement by IsolationBarrier::isolateMeasurementPath;
    satisfy AlertRequirement by AlertController::generateUserAlert;
    satisfy DiagnosticRequirement by VoltageMeasurementProcessor::runSelfDiagnostics;
    satisfy LowPowerRequirement by BatteryPowerSupply::regulatePower;

    part voltageDetectorSystem : VoltageDetector {
        attribute detectorName = "Handheld AC/DC Voltage Detector";
        attribute detectionResponseTime = 0.250 [SI::second];

        part redefines processor {
            attribute safeThreshold = 30 [SI::volt];
            attribute cautionThreshold = 50 [SI::volt];
            attribute hazardousThreshold = 120 [SI::volt];
            attribute overRangeThreshold = 1000 [SI::volt];
            attribute samplePeriod = 0.010 [SI::second];
            attribute decisionHoldTime = 0.250 [SI::second];
        }

        part redefines probe {
            attribute inputImpedance = 10000000 [SI::ohm];
            attribute maximumInputVoltage = 1000 [SI::volt];
            attribute minimumDetectableVoltage = 12 [SI::volt];
        }

        part redefines isolation {
            attribute ratedIsolationVoltage = 1500 [SI::volt];
            attribute leakageCurrentLimit = 0.000001 [SI::ampere];
        }

        part redefines powerSupply {
            attribute nominalVoltage = 3.7 [SI::volt];
            attribute lowBatteryThreshold = 3.2 [SI::volt];
            attribute maximumOutputCurrent = 0.250 [SI::ampere];
        }
    }

}
