        connect modulator.rfOutput to amplifier.rfInput;
        connect amplifier.rfOutput to antenna.transmitPort;
        connect antenna.receivePort to airInterfaceOut;
        connect airInterfaceIn to lowNoiseAmplifier.rfInput;
        connect lowNoiseAmplifier.rfOutput to demodulator.rfInput;
        connect demodulator.dataOutput to userDataOutput;
        connect userControl to controller.controlInterface;
        connect controller.controlInterface to synthesizer.control;

        action performPrimaryFunction {
            in item inputData : BasebandData;
            in item command : ControlCommand;
            out item recoveredData : DemodulatedData;
            out item status : StatusReport;

            first start;
            then controller.manageRadioLink;
            then synthesizer.tuneCarrier;
            then modulator.modulateBaseband;
            then amplifier.amplifySignal;
            then antenna.radiateRF;
            then channel.propagate;
            then antenna.captureRF;
            then lowNoiseAmplifier.boostWeakSignal;
            then demodulator.demodulateRF;
            then complete;

            action complete;
        }
    }

    requirement def OperateInRadioFrequencyBand {
        subject system : RFTransceiverSystem;

        doc /* The system shall operate with a carrier frequency between 300 MHz and 3 GHz. */

        require constraint {
            system.nominalCarrierFrequency >= 300000000.0 and
            system.nominalCarrierFrequency <= 3000000000.0
        }
    }

    requirement def ProvideWirelessInformationTransfer {
        subject system : RFTransceiverSystem;

        doc /* The system shall convert baseband data into a modulated RF signal for wireless propagation and shall recover demodulated data from received RF signals. */

        require constraint {
            system.operatingBandwidth > 0.0 and
            system.nominalTransmitPower > 0.0
        }
    }

    requirement def LimitTransmitPower {
        subject system : RFTransceiverSystem;

        doc /* The system shall limit conducted RF transmit power to no more than 5 W. */

        require constraint {
            system.nominalTransmitPower <= system.maximumTransmitPower
        }
    }

    requirement def MaintainReceiverSensitivity {
        subject system : RFTransceiverSystem;

        doc /* The receiver chain shall support detection of RF signals at or above -100 dBm equivalent received power. */

        require constraint {
            system.receiverSensitivity <= 0.0000000000001
        }
    }

    requirement def SupportCommandAndStatus {
        subject system : RFTransceiverSystem;

        doc /* The system shall accept frequency and power control commands and provide operating status reports. */

        require constraint {
            system.controller.desiredCarrierFrequency == system.nominalCarrierFrequency and
            system.controller.desiredTransmitPower <= system.maximumTransmitPower
        }
    }

    satisfy OperateInRadioFrequencyBand by RFTransceiverSystem;
    satisfy ProvideWirelessInformationTransfer by RFTransceiverSystem.performPrimaryFunction;
    satisfy LimitTransmitPower by RFTransceiverSystem.amplifier;
    satisfy MaintainReceiverSensitivity by RFTransceiverSystem.lowNoiseAmplifier;
    satisfy SupportCommandAndStatus by RFTransceiverSystem.controller;
