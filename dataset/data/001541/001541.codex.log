        part modulator : Modulator;
        part amplifier : PowerAmplifier;
        part antenna : Antenna;
        part channel : RFChannel;
        part lowNoiseAmplifier : LowNoiseAmplifier;
        part demodulator : Demodulator;
        part controller : LinkController;

