        attribute operatingBandwidth : Frequency = 200000.0;
        attribute nominalTransmitPower : Power = 1.0;
        attribute maximumTransmitPower : Power = 5.0;
        attribute receiverSensitivity : Power = 0.0000000000001;
        attribute primaryFunction : String = "Transmit and receive information by modulating baseband data onto a radio-frequency carrier and recovering data from received RF energy.";

        port userDataInput : DataInputPort;
        port userDataOutput : DataOutputPort;
