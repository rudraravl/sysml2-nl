package RectalDilatorSystemSpecification {

  import ScalarValues::*;
  import ISQ::*;
  import SI::*;

  value type Millimeter specializes SI::LengthUnit;
  value type Newton specializes SI::ForceUnit;
  value type Celsius specializes SI::TemperatureUnit;
