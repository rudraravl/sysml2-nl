    attribute nominalCoolantFlow : MassFlowRate = 0.12 [SI::kilogramPerSecond];
    attribute maximumOutletTemperature : Temperature = 323.15 [SI::kelvin];

    port heatInput : HeatTransferPort;
    port coolantInterface : CoolingPort;

    part pump : CoolantPump;
    part heatExchanger : HeatExchanger;

    connect pump.coolantOutlet to heatExchanger.coolantInlet;
  }

  part def CoolantPump {
    attribute ratedFlow : MassFlowRate = 0.15 [SI::kilogramPerSecond];
    attribute motorPower : Power = 180 [SI::watt];
    port coolantOutlet : CoolingPort;
  }

  part def HeatExchanger {
    attribute heatRemovalCapacity : Power = 1500 [SI::watt];
    port coolantInlet : CoolingPort;
  }

  part def SensorSuite {
    port telemetryOutput : TelemetryPort;

    part temperatureSensor : InfraredTemperatureSensor;
    part voltageProbe : RFVoltageProbe;
    part currentProbe : RFCurrentProbe;
    part powerMeter : DirectionalPowerMeter;
    part doorSwitch : InterlockSwitch;
  }

  part def InfraredTemperatureSensor {
    attribute rangeMinimum : Temperature = 273.15 [SI::kelvin];
    attribute rangeMaximum : Temperature = 473.15 [SI::kelvin];
    attribute responseTime : TimeDuration = 0.25 [SI::second];
  }

  part def RFVoltageProbe {
    attribute maximumVoltage : Voltage = 15000 [SI::volt];
  }

  part def RFCurrentProbe {
    attribute maximumCurrent : Current = 50 [SI::ampere];
  }

  part def DirectionalPowerMeter {
    attribute maximumForwardPower : Power = 6000 [SI::watt];
    attribute reflectedPowerTripLevel : Power = 750 [SI::watt];
  }

  part def InterlockSwitch {
    attribute closed : Boolean = true;
  }

  part def HeatingController {
    attribute controlPeriod : TimeDuration = 0.1 [SI::second];
    attribute targetTemperature : Temperature = 363.15 [SI::kelvin];
    attribute maximumRampRate : Real = 2.0;

    port commandInput : CommandPort;
    port sensorInput : TelemetryPort;
    port rfCommandOutput : CommandPort;
    port matchCommandOutput : CommandPort;
    port transportCommandOutput : CommandPort;
    port safetyInput : CommandPort;

    perform action ClosedLoopTemperatureControl {
      in item command : ControlCommand;
      in item telemetry : SensorTelemetry;
      out item rfCommand : ControlCommand;

      first readSetpoint;
      then compareTemperature;
      then calculatePowerDemand;
      then limitPowerAndRampRate;
      then issueRFCommand;
      then done;

      action readSetpoint;
      action compareTemperature;
      action calculatePowerDemand;
      action limitPowerAndRampRate;
      action issueRFCommand;
    }

    state def ControllerStateMachine {
      entry action InitializeController;

      state Off;
      state Standby;
      state Precheck;
      state Heating;
      state Holding;
      state Fault;
      state Shutdown;

      transition first Off then Standby;
      transition Standby then Precheck accept ControlCommand;
      transition Precheck then Heating if interlocksValid;
      transition Heating then Holding if targetTemperatureReached;
      transition Holding then Heating if temperatureBelowDeadband;
      transition Heating then Fault if reflectedPowerHigh;
      transition Heating then Fault if productOverTemperature;
      transition Precheck then Fault if interlockOpen;
      transition Fault then Shutdown;
      transition Shutdown then Standby accept ControlCommand;

      attribute interlocksValid : Boolean;
      attribute targetTemperatureReached : Boolean;
      attribute temperatureBelowDeadband : Boolean;
      attribute reflectedPowerHigh : Boolean;
      attribute productOverTemperature : Boolean;
      attribute interlockOpen : Boolean;
    }
  }

  part def SafetyInterlockSystem {
    attribute maximumReflectedPower : Power = 750 [SI::watt];
    attribute maximumCavityTemperature : Temperature = 333.15 [SI::kelvin];
    attribute shutdownLatency : TimeDuration = 0.05 [SI::second];

    port telemetryInput : TelemetryPort;
    port shutdownOutput : SafetyPort;

    perform action EvaluateSafetyInterlocks {
      in item telemetry : SensorTelemetry;
      out item shutdownCommand : ControlCommand;

      first checkDoorInterlock;
      then checkReflectedPower;
      then checkOverTemperature;
      then checkCurrentLimit;
      then commandShutdownWhenUnsafe;
      then done;

      action checkDoorInterlock;
      action checkReflectedPower;
      action checkOverTemperature;
      action checkCurrentLimit;
      action commandShutdownWhenUnsafe;
    }
  }

  action def PrimaryHeatingFunction {
    in item unheatedMaterial : ProcessMaterial;
    in item utilityPower : ElectricalEnergy;
    out item heatedMaterial : ProcessMaterial;
    out item telemetry : SensorTelemetry;

    first receiveMaterialAndPower;
    then convertUtilityPowerToRadioFrequencyEnergy;
    then applyAlternatingElectricFieldAcrossMaterial;
    then dissipateDielectricLossesWithinMaterial;
    then regulateTemperatureToSetpoint;
    then dischargeHeatedMaterial;
    then reportOperatingTelemetry;
    then done;

    action receiveMaterialAndPower;
    action convertUtilityPowerToRadioFrequencyEnergy;
    action applyAlternatingElectricFieldAcrossMaterial;
    action dissipateDielectricLossesWithinMaterial;
    action regulateTemperatureToSetpoint;
    action dischargeHeatedMaterial;
    action reportOperatingTelemetry;
  }

  requirement def PrimaryFunctionRequirement {
    doc
    /*
     * The dielectric heating system shall raise the temperature of a dielectric process material
     * by applying a controlled alternating electric field that causes molecular polarization losses
     * inside the material, converting RF electrical energy directly into volumetric heat.
     */

    subject heatingSystem : DielectricHeatingSystem;

    require constraint {
      heatingSystem.maximumRFPower >= 5000 [SI::watt]
    }
  }

  requirement def FrequencyRequirement {
    doc
    /*
     * The system shall operate at an industrial radio-frequency dielectric heating band centered
     * on 27.12 MHz to provide controlled volumetric heating of compatible dielectric materials.
     */

    subject heatingSystem : DielectricHeatingSystem;

    require constraint {
      heatingSystem.nominalFrequency == 27.12 [SI::megahertz]
    }
  }

  requirement def TemperatureControlRequirement {
    doc
    /*
     * The system shall control outlet material temperature to the commanded target temperature
     * without exceeding the defined maximum product temperature.
     */

    subject heatingSystem : DielectricHeatingSystem;

    require constraint {
      heatingSystem.maximumProductTemperature <= 393.15 [SI::kelvin]
    }
  }

  requirement def EfficiencyRequirement {
    doc
    /*
     * The dielectric heating system shall transfer at least 72 percent of accepted RF power into
     * useful heat within the dielectric load during normal tuned operation.
     */

    subject heatingSystem : DielectricHeatingSystem;

    require constraint {
      heatingSystem.minimumEfficiency >= 0.72
    }
  }

  requirement def SafetyRequirement {
    doc
    /*
     * The system shall disable RF output when a door interlock opens, reflected power exceeds
     * the trip threshold, or product temperature exceeds the allowed limit.
     */

    subject protectionSystem : SafetyInterlockSystem;

    require constraint {
      protectionSystem.shutdownLatency <= 0.05 [SI::second]
    }
  }

  requirement def CoolingRequirement {
    doc
    /*
     * The system shall remove waste heat from electrodes, RF components, and cavity structures
     * so that coolant outlet temperature remains below the specified limit during continuous operation.
     */

    subject coolingSystem : CoolingSubsystem;

    require constraint {
      coolingSystem.maximumOutletTemperature <= 323.15 [SI::kelvin]
    }
  }

  satisfy PrimaryFunctionRequirement by DielectricHeatingSystem;
  satisfy FrequencyRequirement by DielectricHeatingSystem;
  satisfy TemperatureControlRequirement by DielectricHeatingSystem;
  satisfy EfficiencyRequirement by DielectricHeatingSystem;
  satisfy SafetyRequirement by SafetyInterlockSystem;
  satisfy CoolingRequirement by CoolingSubsystem;

  part dielectricHeater : DielectricHeatingSystem;

}
