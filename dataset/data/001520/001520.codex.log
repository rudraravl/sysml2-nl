        attribute flexibleLoadPower : Kilowatt;

        constraint energyBalance {
            solarPower + batteryPower + gridPower == criticalLoadPower + flexibleLoadPower;
        }
    }

    verification def BackupReserveVerification {
        subject battery : BatteryStorage;
        objective requirement BackupReserveRequirement;

        action verifyReserve {
            in attribute observedStateOfCharge : Percent;
            assert observedStateOfCharge >= BackupReserveRequirement::minimumReserve;
        }
    }

    verification def DashboardFreshnessVerification {
        subject dashboard : OperatorDashboard;
        objective requirement OperatorVisibilityRequirement;

        action verifyFreshTelemetry {
            in item telemetry : TelemetryFrame;
            assert telemetry.sampleAge <= OperatorVisibilityRequirement::maximumDashboardAge;
        }
    }
}
