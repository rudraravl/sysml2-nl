            transition resetTrip from emergencyTrip to unavailable;
        }

        action def RegulateDischargePressure {
            in measuredPressure : Pressure;
            in measuredFlow : MassFlowRate;
            out driveSpeedDemand : ScalarValues::Real;
            out recirculationDemand : ValvePosition;

            first comparePressure;
            then computeSpeedCorrection;
            then enforceMinimumFlow;
            then issueCommands;

            action comparePressure;
            action computeSpeedCorrection;
            action enforceMinimumFlow;
            action issueCommands;
        }

        perform controlMode : PumpControlStateMachine;
        perform pressureControl : RegulateDischargePressure;
    }

    part def BoilerFeedwaterPumpAssembly {
        port suctionHeader : FluidPort;
        port dischargeHeader : FluidPort;
        port recirculationReturn : FluidPort;
        port electricalSupply : PowerPort;
        port operatorInterface : ControlPort;
        port drainOutlet : DrainPort;

        part strainer : SuctionStrainer;
        part pump : CentrifugalPumpHydraulics;
        part motor : Motor;
        part coupling : MechanicalCoupling;
        part drive : VariableFrequencyDrive;
        part dischargeCheckValve : CheckValve;
        part dischargeValve : DischargeIsolationValve;
        part minimumFlowValve : MinimumFlowRecirculationValve;
        part lubeOil : LubeOilSkid;
        part seals : SealSystem;
        part instruments : Instrumentation;
        part controller : PumpController;

        connect suctionHeader to strainer.inlet;
        connect strainer.outlet to pump.suction;
        connect pump.discharge to dischargeCheckValve.inlet;
        connect dischargeCheckValve.outlet to dischargeValve.inlet;
        connect dischargeValve.outlet to dischargeHeader;
        connect pump.discharge to minimumFlowValve.pumpDischarge;
        connect minimumFlowValve.recirculationOutlet to recirculationReturn;
        connect electricalSupply to drive.powerIn;
        connect drive.powerOut to motor.electricalIn;
        connect operatorInterface to controller.operatorCommand;
        connect controller.driveCommand to drive.control;
        connect controller.driveCommand to motor.control;
        connect controller.valveCommand to dischargeValve.control;
        connect controller.recircCommand to minimumFlowValve.control;
        connect controller.lubeOilCommand to lubeOil.control;
        connect controller.instrumentation to instruments.control;
        connect lubeOil.oilToPump to lubeOil.oilReturn;
        connect seals.sealInjection to pump.discharge;
        connect seals.sealLeakoff to drainOutlet;
        connect pump.casingDrain to drainOutlet;

        attribute assemblyAvailable : ScalarValues::Boolean;
        attribute totalElectricalPower : Power;
        attribute deliveredFlow : MassFlowRate;
        attribute deliveredPressure : Pressure;
    }

    part def FeedwaterPumpingSubsystem {
        port deaeratorOutlet : FluidPort;
        port boilerEconomizerInlet : FluidPort;
        port condensateStorageReturn : FluidPort;
        port incomingElectricalPower : PowerPort;
        port plantControlSystem : ControlPort;
        port drainCollection : DrainPort;

        part mainFeedPump : BoilerFeedwaterPumpAssembly;
        part standbyFeedPump : BoilerFeedwaterPumpAssembly;

        connect deaeratorOutlet to mainFeedPump.suctionHeader;
        connect deaeratorOutlet to standbyFeedPump.suctionHeader;
        connect mainFeedPump.dischargeHeader to boilerEconomizerInlet;
        connect standbyFeedPump.dischargeHeader to boilerEconomizerInlet;
        connect mainFeedPump.recirculationReturn to condensateStorageReturn;
        connect standbyFeedPump.recirculationReturn to condensateStorageReturn;
        connect incomingElectricalPower to mainFeedPump.electricalSupply;
        connect incomingElectricalPower to standbyFeedPump.electricalSupply;
        connect plantControlSystem to mainFeedPump.operatorInterface;
        connect plantControlSystem to standbyFeedPump.operatorInterface;
        connect mainFeedPump.drainOutlet to drainCollection;
        connect standbyFeedPump.drainOutlet to drainCollection;

        attribute requiredBoilerFlow : MassFlowRate = 90 [SI::kilogramPerSecond];
        attribute normalDischargePressure : Pressure = 16200000 [SI::pascal];
        attribute suctionTemperature : Temperature = 423.15 [SI::kelvin];
        attribute activePumpCount : ScalarValues::Integer;
        attribute standbyAvailable : ScalarValues::Boolean;

        action def SupplyBoilerFeedwater {
            in item sourceWater : Feedwater;
            out item boilerFeedwater : Feedwater;

            first validateSuctionConditions;
            then selectAvailablePump;
            then startOrMaintainPump;
            then regulatePressureAndFlow;
            then protectMinimumFlow;
            then deliverToEconomizer;

            action validateSuctionConditions;
            action selectAvailablePump;
            action startOrMaintainPump;
            action regulatePressureAndFlow;
            action protectMinimumFlow;
            action deliverToEconomizer;
        }

        perform feedwaterSupply : SupplyBoilerFeedwater;
    }

    requirement def FeedwaterFlowRequirement {
        subject subsystem : FeedwaterPumpingSubsystem;

        require constraint {
            subsystem.requiredBoilerFlow >= 90 [SI::kilogramPerSecond]
        }

        doc /* The pumping subsystem shall deliver not less than 90 kg/s of feedwater to the boiler economizer inlet during normal boiler load. */
    }

    requirement def DischargePressureRequirement {
        subject subsystem : FeedwaterPumpingSubsystem;

        require constraint {
            subsystem.normalDischargePressure >= 16000000 [SI::pascal]
        }

        doc /* The pumping subsystem shall maintain feedwater discharge pressure sufficient to overcome boiler drum pressure, economizer losses, and control valve pressure drop. */
    }

    requirement def MinimumFlowProtectionRequirement {
        subject pumpAssembly : BoilerFeedwaterPumpAssembly;

        require constraint {
            pumpAssembly.pump.flow >= pumpAssembly.pump.minimumContinuousStableFlow
            or pumpAssembly.minimumFlowValve.position > 0.0
        }

        doc /* The boiler feedwater pump shall be protected from operation below minimum continuous stable flow by automatic recirculation. */
    }

    requirement def LowSuctionPressureTripRequirement {
        subject pumpAssembly : BoilerFeedwaterPumpAssembly;

        require constraint {
            pumpAssembly.instruments.suctionPressureMeasured > pumpAssembly.instruments.suctionLowPressureTrip
            or pumpAssembly.controller.tripRequired == true
        }

        doc /* The pump controller shall trip the pump when suction pressure falls below the configured protective limit. */
    }

    requirement def HighDischargePressureTripRequirement {
        subject pumpAssembly : BoilerFeedwaterPumpAssembly;

        require constraint {
            pumpAssembly.instruments.dischargePressureMeasured < pumpAssembly.instruments.dischargeHighPressureTrip
            or pumpAssembly.controller.tripRequired == true
        }

        doc /* The pump controller shall trip the pump when discharge pressure exceeds the configured protective limit. */
    }

    requirement def LubeOilProtectionRequirement {
        subject pumpAssembly : BoilerFeedwaterPumpAssembly;

        require constraint {
            pumpAssembly.lubeOil.supplyPressure > pumpAssembly.lubeOil.lowPressureTripSetpoint
            or pumpAssembly.controller.tripRequired == true
        }

        doc /* The pump shall not run without adequate bearing lubrication oil pressure. */
    }

    requirement def StandbyCapacityRequirement {
        subject subsystem : FeedwaterPumpingSubsystem;

        require constraint {
            subsystem.standbyAvailable == true
        }

        doc /* The subsystem shall include a standby boiler feedwater pump assembly capable of supplying the required boiler feedwater flow if the main pump is unavailable. */
    }

    requirement def ReverseFlowPreventionRequirement {
        subject pumpAssembly : BoilerFeedwaterPumpAssembly;

        require constraint {
            pumpAssembly.dischargeCheckValve.reverseFlowDetected == false
        }

        doc /* The discharge check valve shall prevent reverse flow from the boiler feedwater header through an idle pump. */
    }

    satisfy FeedwaterFlowRequirement by FeedwaterPumpingSubsystem::feedwaterSupply;
    satisfy DischargePressureRequirement by FeedwaterPumpingSubsystem::mainFeedPump::controller::pressureControl;
    satisfy MinimumFlowProtectionRequirement by BoilerFeedwaterPumpAssembly::minimumFlowValve;
    satisfy LowSuctionPressureTripRequirement by BoilerFeedwaterPumpAssembly::controller;
    satisfy HighDischargePressureTripRequirement by BoilerFeedwaterPumpAssembly::controller;
    satisfy LubeOilProtectionRequirement by BoilerFeedwaterPumpAssembly::lubeOil;
    satisfy StandbyCapacityRequirement by FeedwaterPumpingSubsystem::standbyFeedPump;
    satisfy ReverseFlowPreventionRequirement by BoilerFeedwaterPumpAssembly::dischargeCheckValve;

    part feedwaterPumpingSubsystem : FeedwaterPumpingSubsystem;
}
