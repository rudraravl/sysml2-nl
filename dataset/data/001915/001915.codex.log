      first WorksiteOperations
      then Ingress
      if plannedTasksComplete or consumableReserveReached;

    transition Any_to_Contingency
      first Standby
      then Contingency
      if criticalFaultDetected;

    transition Contingency_to_Ingress
      first Contingency
      then Ingress
      if emergencyReturnPathEstablished;

    transition Ingress_to_Repressurization
      first Ingress
      then Repressurization
      if crewInsideAirlock and hatchClosed;

    transition Repressurization_to_Complete
      first Repressurization
      then Complete
      if airlockPressureNominal and suitDoffAuthorized;
  }

  requirement def ProvidePrimaryEvaFunction {
    doc /* The system shall enable one suited crew member to perform external mission tasks outside a pressurized spacecraft while preserving life, maintaining communication, supporting mobility, and enabling return to the airlock. */
  }

  requirement def MaintainCrewLifeSupport {
    doc /* The system shall maintain breathable oxygen, carbon dioxide removal, pressure control, and thermal control for at least six hours of external activity. */

    attribute requiredDuration : Duration = 21600 [s];
    attribute minimumSuitPressure : Pressure = 27000 [Pa];
    attribute maximumSuitPressure : Pressure = 32000 [Pa];
    attribute maximumCarbonDioxidePartialPressure : Pressure = 1000 [Pa];
  }

  requirement def MaintainCommunication {
    doc /* The system shall provide continuous two-way voice and telemetry communication between the crew member and mission control during nominal EVA operations. */

    attribute minimumTelemetryRate : DataRate = 64000 [bit/s];
    attribute maximumVoiceLatency : Duration = 1 [s];
    attribute requiredCoverageFraction : Percent = 0.90;
  }

  requirement def SupportCrewMobility {
    doc /* The system shall allow controlled translation from the airlock to the external worksite and back while keeping the crew member physically restrained to the vehicle. */

    attribute maximumRangeFromAirlock : Distance = 120 [m];
    attribute minimumTetherLoadRating : Force = 2000 [N];
  }

  requirement def ProvideEmergencyReturn {
    doc /* The system shall provide an emergency return capability when communication loss, tether failure, excessive drift, or life-support critical fault is detected. */

    attribute maximumActivationTime : Duration = 5 [s];
    attribute minimumDeltaVCapability : Real = 2.5;
  }

  requirement def ManageConsumableReserves {
    doc /* The system shall preserve consumable reserves sufficient for safe return before oxygen, battery, cooling water, or carbon dioxide removal capacity reaches a critical limit. */

    attribute minimumOxygenReserve : Percent = 0.18;
    attribute minimumBatteryReserve : Percent = 0.20;
    attribute minimumCoolingWaterReserve : Percent = 0.15;
  }

  requirement def EnableExternalTaskExecution {
    doc /* The system shall provide restrained tool access, powered tool support, sample containment, and worksite interface capability for maintenance or exploration tasks. */

    attribute minimumToolRetentionIntegrity : Percent = 0.99;
    attribute minimumPoweredToolEnergy : Energy = 90000 [J];
  }

  satisfy ProvidePrimaryEvaFunction by ExtravehicularActivitySystem;
  satisfy MaintainCrewLifeSupport by PortableLifeSupportSystem;
  satisfy MaintainCrewLifeSupport by PressureSuit;
  satisfy MaintainCommunication by CommunicationSubsystem;
  satisfy SupportCrewMobility by SafetyTether;
  satisfy SupportCrewMobility by NavigationSubsystem;
  satisfy ProvideEmergencyReturn by EmergencyReturnSubsystem;
  satisfy ManageConsumableReserves by PortableLifeSupportSystem;
  satisfy EnableExternalTaskExecution by ToolCarrier;
  satisfy EnableExternalTaskExecution by ExternalWorksite;

  concern def CrewSurvival;
  concern def MissionTaskCompletion;
  concern def VehicleSafety;
  concern def EmergencyRecovery;

  view def EvaOperationalView {
    expose ExtravehicularActivitySystem;
    expose PressureSuit;
    expose PortableLifeSupportSystem;
    expose CommunicationSubsystem;
    expose NavigationSubsystem;
    expose SafetyTether;
    expose EmergencyReturnSubsystem;
    expose ProvidePrimaryEvaFunction;
    expose MaintainCrewLifeSupport;
    expose MaintainCommunication;
