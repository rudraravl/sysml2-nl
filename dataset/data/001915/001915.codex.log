  part def BiomedicalSensorSet {
    attribute heartRateAccuracy : Percent = 0.98;
    attribute oxygenSaturation : Percent = 0.97;
    attribute sensorOperational : Boolean = true;
  }

  part def PortableLifeSupportSystem {
    attribute oxygenMass : Mass = 1.2 [kg];
    attribute oxygenReserveFraction : Percent = 0.30;
    attribute batteryEnergy : Energy = 2200000 [J];
    attribute batteryStateOfCharge : Percent = 1.0;
    attribute carbonDioxidePartialPressure : Pressure = 350 [Pa];
    attribute waterInventory : Mass = 4.0 [kg];
    attribute fanPower : Power = 18 [W];
    attribute pumpPower : Power = 22 [W];

    port oxygenSupply : OxygenPort;
    port co2Inlet : VentPort;
    port coolingLoop : CoolingPort;
    port powerBus : PowerPort;
    port telemetryBus : DataPort;

    part oxygenTank : OxygenStorageTank;
    part pressureRegulator : OxygenPressureRegulator;
    part carbonDioxideRemoval : CarbonDioxideRemovalAssembly;
    part thermalControl : ThermalControlAssembly;
    part battery : BatteryAssembly;
    part controller : LifeSupportController;
  }

  part def OxygenStorageTank {
    attribute storagePressure : Pressure = 20600000 [Pa];
    attribute usableOxygenMass : Mass = 1.2 [kg];
    attribute tankTemperature : Temperature = 293.15 [K];
  }

  part def OxygenPressureRegulator {
    attribute outletPressure : Pressure = 29600 [Pa];
    attribute regulationTolerance : Percent = 0.03;
  }

  part def CarbonDioxideRemovalAssembly {
    attribute removalEfficiency : Percent = 0.96;
    attribute sorbentCapacity : Mass = 0.42 [kg];
    attribute bedTemperature : Temperature = 298.15 [K];
  }

  part def ThermalControlAssembly {
    attribute heatRejectionCapacity : Power = 520 [W];
    attribute sublimatorWaterRate : FlowRate = 0.00009 [kg/s];
    attribute coolantSetpoint : Temperature = 288.15 [K];
  }

  part def BatteryAssembly {
    attribute nominalVoltage : Real = 28.0;
    attribute capacity : Energy = 2200000 [J];
    attribute maximumContinuousPower : Power = 650 [W];
  }

  part def LifeSupportController {
    attribute controlCyclePeriod : Duration = 1 [s];
    attribute faultDetected : Boolean = false;
    attribute autonomousModeEnabled : Boolean = true;
  }

  part def CommunicationSubsystem {
    attribute primaryLinkAvailable : Boolean = true;
    attribute backupLinkAvailable : Boolean = true;
    attribute voiceLatency : Duration = 0.4 [s];
    attribute telemetryRate : DataRate = 128000 [bit/s];

    port telemetryInterface : DataPort;
    port voiceInterface : VoicePort;
    port externalData : DataPort;

    part radio : RadioTransceiver;
    part antenna : SuitAntenna;
    part audio : AudioInterface;
  }

  part def RadioTransceiver {
    attribute transmitPower : Power = 8 [W];
    attribute receiveSensitivity : Real = -112.0;
    attribute encryptionEnabled : Boolean = true;
  }

  part def SuitAntenna {
    attribute gain : Real = 4.5;
    attribute coverageFraction : Percent = 0.92;
  }

  part def AudioInterface {
    attribute microphoneOperational : Boolean = true;
    attribute speakerOperational : Boolean = true;
    attribute noiseSuppressionEnabled : Boolean = true;
  }

  part def NavigationSubsystem {
    attribute relativePositionError : Distance = 0.6 [m];
    attribute inertialDriftRate : Real = 0.02;
    attribute hazardProximityWarningDistance : Distance = 2.0 [m];

    port navData : DataPort;

    part inertialUnit : InertialMeasurementUnit;
    part visualMarkers : VisualNavigationMarkerTracker;
    part rangeFinder : RangeFinder;
  }

  part def InertialMeasurementUnit {
    attribute updateRate : Real = 100.0;
    attribute operational : Boolean = true;
  }

  part def VisualNavigationMarkerTracker {
    attribute markerLock : Boolean = true;
    attribute fieldOfView : Real = 120.0;
  }

  part def RangeFinder {
    attribute maximumRange : Distance = 150 [m];
    attribute rangeAccuracy : Distance = 0.15 [m];
  }

  part def ToolCarrier {
    attribute totalToolMass : Mass = 18 [kg];
    attribute retainedToolCount : Integer = 8;
    attribute poweredToolEnergyBudget : Energy = 180000 [J];

    port toolInterface : ToolPort;
    port worksiteToolPort : ToolPort;

    part tetheredPowerDriver : PoweredTool;
    part sampleBag : SampleContainerAssembly;
    part restraintHook : RestraintTool;
  }

  part def PoweredTool {
    attribute toolId : String = "EVA-DRV-01";
    attribute outputTorque : Real = 18.0;
    attribute batteryEnergy : Energy = 90000 [J];
    attribute tethered : Boolean = true;
  }

  part def SampleContainerAssembly {
    attribute containerCount : Integer = 4;
    attribute totalSampleCapacity : Mass = 2.5 [kg];
    attribute contaminationSealIntegrity : Percent = 0.995;
  }

  part def RestraintTool {
    attribute ratedLoad : Force = 890 [N];
    attribute locked : Boolean = false;
  }

  part def SafetyTether {
    attribute length : Distance = 26 [m];
    attribute ratedLoad : Force = 2200 [N];
    attribute reelLocked : Boolean = true;
    attribute integrityVerified : Boolean = true;

    port crewAnchor : TetherPort;
    port vehicleAnchor : TetherPort;
  }

  part def AirlockInterface {
    attribute hatchClosed : Boolean = true;
    attribute depressurized : Boolean = false;
    attribute prebreatheComplete : Boolean = false;
    attribute repressurizationAvailable : Boolean = true;

    port tetherAnchor : TetherPort;
  }

  part def ExternalWorksite {
    attribute worksiteId : String = "ORBITAL-SERVICE-PANEL-A";
    attribute taskCompletionFraction : Percent = 0.0;
    attribute illuminationLevel : Real = 650.0;
    attribute handrailAvailable : Boolean = true;

    port toolPort : ToolPort;
  }

  part def EmergencyReturnSubsystem {
    attribute enabled : Boolean = true;
    attribute deltaVCapability : Real = 3.0;
    attribute propellantMass : Mass = 1.4 [kg];
    attribute activationTime : Duration = 2 [s];

    port commandInterface : DataPort;
    port propulsiveLoadPath : TetherPort;
  }

  action def ConductEvaAction {
    in crew : EvaCrewMember;
    inout evaSuit : PressureSuit;
    inout plss : PortableLifeSupportSystem;
    inout comm : CommunicationSubsystem;
    inout nav : NavigationSubsystem;
    inout tools : ToolCarrier;
    inout tether : SafetyTether;
    inout worksite : ExternalWorksite;
    inout returnSystem : EmergencyReturnSubsystem;

    first start;
    then prepareAirlock;
    then verifyLifeSupport;
    then exitAirlock;
    then translateToWorksite;
    then performExternalTask;
    then returnToAirlock;
    then repressurize;
    then end;

    action prepareAirlock {
      out prebreatheComplete : Boolean = true;
    }

    action verifyLifeSupport {
      out goForEva : Boolean;
    }

    action exitAirlock {
      out hatchClear : Boolean = true;
    }

    action translateToWorksite {
      out arrived : Boolean = true;
    }

    action performExternalTask {
      out taskCompletionFraction : Percent = 1.0;
    }

    action returnToAirlock {
      out crewInside : Boolean = true;
    }

    action repressurize {
      out safeToDoffSuit : Boolean = true;
    }
  }

  state def EvaSystemStateMachine {
    entry action initializeTelemetry;

    state Standby;
    state Prebreathe;
    state AirlockDepressurization;
    state Egress;
    state Translation;
    state WorksiteOperations;
    state Contingency;
    state Ingress;
    state Repressurization;
    state Complete;

    transition first Standby;
    transition Standby_to_Prebreathe
      first Standby
      then Prebreathe
      accept CommandData
      if command.authorized;

    transition Prebreathe_to_Depressurization
      first Prebreathe
      then AirlockDepressurization
      if prebreatheTimerExpired and suitPressureStable;

    transition Depressurization_to_Egress
      first AirlockDepressurization
      then Egress
      if airlockPressureBelowThreshold and tether.integrityVerified;

    transition Egress_to_Translation
      first Egress
      then Translation
      if crewClearOfHatch;

    transition Translation_to_WorksiteOperations
      first Translation
      then WorksiteOperations
      if worksiteReached and communicationLinkValid;

    transition WorksiteOperations_to_Ingress
      first WorksiteOperations
      then Ingress
      if plannedTasksComplete or consumableReserveReached;

    transition Any_to_Contingency
      first Standby
      then Contingency
      if criticalFaultDetected;

    transition Contingency_to_Ingress
      first Contingency
      then Ingress
      if emergencyReturnPathEstablished;

    transition Ingress_to_Repressurization
      first Ingress
      then Repressurization
      if crewInsideAirlock and hatchClosed;

    transition Repressurization_to_Complete
      first Repressurization
      then Complete
      if airlockPressureNominal and suitDoffAuthorized;
  }

  requirement def ProvidePrimaryEvaFunction {
    doc /* The system shall enable one suited crew member to perform external mission tasks outside a pressurized spacecraft while preserving life, maintaining communication, supporting mobility, and enabling return to the airlock. */
  }

  requirement def MaintainCrewLifeSupport {
    doc /* The system shall maintain breathable oxygen, carbon dioxide removal, pressure control, and thermal control for at least six hours of external activity. */

    attribute requiredDuration : Duration = 21600 [s];
    attribute minimumSuitPressure : Pressure = 27000 [Pa];
    attribute maximumSuitPressure : Pressure = 32000 [Pa];
    attribute maximumCarbonDioxidePartialPressure : Pressure = 1000 [Pa];
  }

  requirement def MaintainCommunication {
    doc /* The system shall provide continuous two-way voice and telemetry communication between the crew member and mission control during nominal EVA operations. */

    attribute minimumTelemetryRate : DataRate = 64000 [bit/s];
    attribute maximumVoiceLatency : Duration = 1 [s];
    attribute requiredCoverageFraction : Percent = 0.90;
  }

  requirement def SupportCrewMobility {
    doc /* The system shall allow controlled translation from the airlock to the external worksite and back while keeping the crew member physically restrained to the vehicle. */

    attribute maximumRangeFromAirlock : Distance = 120 [m];
    attribute minimumTetherLoadRating : Force = 2000 [N];
  }

  requirement def ProvideEmergencyReturn {
    doc /* The system shall provide an emergency return capability when communication loss, tether failure, excessive drift, or life-support critical fault is detected. */

    attribute maximumActivationTime : Duration = 5 [s];
    attribute minimumDeltaVCapability : Real = 2.5;
  }

  requirement def ManageConsumableReserves {
    doc /* The system shall preserve consumable reserves sufficient for safe return before oxygen, battery, cooling water, or carbon dioxide removal capacity reaches a critical limit. */

    attribute minimumOxygenReserve : Percent = 0.18;
    attribute minimumBatteryReserve : Percent = 0.20;
    attribute minimumCoolingWaterReserve : Percent = 0.15;
  }

  requirement def EnableExternalTaskExecution {
    doc /* The system shall provide restrained tool access, powered tool support, sample containment, and worksite interface capability for maintenance or exploration tasks. */

    attribute minimumToolRetentionIntegrity : Percent = 0.99;
    attribute minimumPoweredToolEnergy : Energy = 90000 [J];
  }

  satisfy ProvidePrimaryEvaFunction by ExtravehicularActivitySystem;
  satisfy MaintainCrewLifeSupport by PortableLifeSupportSystem;
  satisfy MaintainCrewLifeSupport by PressureSuit;
  satisfy MaintainCommunication by CommunicationSubsystem;
  satisfy SupportCrewMobility by SafetyTether;
  satisfy SupportCrewMobility by NavigationSubsystem;
  satisfy ProvideEmergencyReturn by EmergencyReturnSubsystem;
  satisfy ManageConsumableReserves by PortableLifeSupportSystem;
  satisfy EnableExternalTaskExecution by ToolCarrier;
  satisfy EnableExternalTaskExecution by ExternalWorksite;

  concern def CrewSurvival;
  concern def MissionTaskCompletion;
  concern def VehicleSafety;
  concern def EmergencyRecovery;

  view def EvaOperationalView {
    expose ExtravehicularActivitySystem;
    expose PressureSuit;
    expose PortableLifeSupportSystem;
    expose CommunicationSubsystem;
    expose NavigationSubsystem;
    expose SafetyTether;
    expose EmergencyReturnSubsystem;
    expose ProvidePrimaryEvaFunction;
    expose MaintainCrewLifeSupport;
    expose MaintainCommunication;
    expose SupportCrewMobility;
    expose ProvideEmergencyReturn;
  }

}
