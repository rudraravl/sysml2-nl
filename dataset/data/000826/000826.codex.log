            in occlusionDetected = occlusionDetector.occlusionDetected;
            in canisterFull = canister.floatValveClosed;
            in pumpFault = filter.fluidBreakthroughDetected;
        }

        constraint patientVacuumLimit {
            appliedVacuumAtPatient >= patient.allowableVacuumAtPatient;
        }

        constraint regulatorAccuracy {
            regulator.measuredVacuum >= regulator.setPoint - regulator.tolerance and
            regulator.measuredVacuum <= regulator.setPoint + regulator.tolerance;
        }

        constraint collectionIsolation {
            canister.isSealed == true and filter.fluidBreakthroughDetected == false;
        }

        constraint operatingFlowRange {
            nominalFlow >= 1.0 [L/min] and nominalFlow <= 8.0 [L/min];
        }
    }

    requirement def ControlledGastricSuctionRequirement {
        subject system : WangensteenSuctionSystem;

        doc /*
