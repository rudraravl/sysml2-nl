            first idle
            accept pumpFault == true
            then fault;

        transition fault_to_shutdown
            first fault
            accept shutdownCommand == true
            then shutdown;

        transition any_to_shutdown
            first suctioning
            accept shutdownCommand == true
            then shutdown;
    }

    part def WangensteenSuctionSystem {
        doc /*
        Primary high-level function: provide controlled, continuous, low-pressure gastrointestinal suction through a nasogastric tube so gastric contents are removed from the patient, separated from the vacuum air path, and retained in a sealed collection canister while limiting applied vacuum and alarming on unsafe conditions.
        */

        port patientConnection : FluidPort;
        port exhaust : AirVacuumPort;
        port mainsInput : PowerPort;
        port operatorControl : ControlPort;
        port alarmOutput : AlarmPort;

        part patient : PatientInterface;
        part ngTube : NasogastricTube;
        part suctionLine : SuctionTubing;
        part canister : CollectionCanister;
        part filter : HydrophobicFilter;
        part regulator : VacuumRegulator;
        part pump : VacuumPump;
        part gauge : VacuumGauge;
        part occlusionDetector : OcclusionDetector;
        part levelSensor : CanisterLevelSensor;
        part userInterface : UserInterface;
        part alarmModule : AlarmModule;
        part powerSupply : PowerSupply;

        attribute commandedVacuum : VacuumPressure = -12000 [Pa];
        attribute appliedVacuumAtPatient : VacuumPressure;
        attribute nominalFlow : FlowRate = 4.0 [L/min];
        attribute mode : OperatingMode;
        attribute startupTimeLimit : TimeValue = 20 [s];

        connect patientConnection to patient.gastricAccess;
        connect patient.gastricAccess to ngTube.patientEnd;
        connect ngTube.pumpEnd to suctionLine.inlet;
        connect suctionLine.outlet to canister.inlet;
        connect canister.vacuumOutlet to filter.canisterSide;
        connect filter.pumpSide to regulator.regulatedVacuum;
        connect regulator.sourceVacuum to pump.suctionPort;
        connect pump.exhaustPort to exhaust;

        connect mainsInput to powerSupply.output;
        connect powerSupply.output to pump.electricalInput;

        connect operatorControl to userInterface.control;
        connect userInterface.control to regulator.controller;
        connect userInterface.control to pump.command;
        connect userInterface.alarm to alarmOutput;

        connect regulator.regulatedVacuum to gauge.sensedVacuum;
        connect suctionLine.inlet to occlusionDetector.sensedLine;
        connect canister.inlet to levelSensor.sensedCanister;

        connect gauge.indication to alarmModule.input;
        connect occlusionDetector.status to alarmModule.input;
        connect levelSensor.status to alarmModule.input;
        connect alarmModule.annunciator to alarmOutput;

        perform action primaryFunction : RemoveGastricContents {
            in sourceFluid = patient.gastricAccess.fluid;
            in targetVacuum = commandedVacuum;
            out collectedFluid = canister.inlet.fluid;
        }

        exhibit state controllerBehavior : SuctionControllerStateMachine {
            in startCommand = userInterface.startRequested;
            in pauseCommand = userInterface.pauseRequested;
            in shutdownCommand = userInterface.shutdownRequested;
            in measuredVacuum = regulator.measuredVacuum;
            in occlusionDetected = occlusionDetector.occlusionDetected;
            in canisterFull = canister.floatValveClosed;
            in pumpFault = filter.fluidBreakthroughDetected;
        }

        constraint patientVacuumLimit {
            appliedVacuumAtPatient >= patient.allowableVacuumAtPatient;
        }

        constraint regulatorAccuracy {
            regulator.measuredVacuum >= regulator.setPoint - regulator.tolerance and
            regulator.measuredVacuum <= regulator.setPoint + regulator.tolerance;
        }

        constraint collectionIsolation {
            canister.isSealed == true and filter.fluidBreakthroughDetected == false;
        }

        constraint operatingFlowRange {
            nominalFlow >= 1.0 [L/min] and nominalFlow <= 8.0 [L/min];
        }
    }

    requirement def ControlledGastricSuctionRequirement {
        subject system : WangensteenSuctionSystem;

        doc /*
        The system shall remove gastric contents from a patient through a nasogastric tube using controlled low-pressure suction and collect the removed material in a sealed canister.
        */

        require constraint {
            system.commandedVacuum >= -16000 [Pa] and
            system.commandedVacuum <= -5000 [Pa]
        }
    }

    requirement def PatientSafetyVacuumLimitRequirement {
        subject system : WangensteenSuctionSystem;

        doc /*
        The system shall prevent vacuum at the patient connection from exceeding the configured safe gastric suction limit.
        */

        require constraint {
            system.appliedVacuumAtPatient >= system.patient.allowableVacuumAtPatient
        }
    }

    requirement def FluidContainmentRequirement {
        subject system : WangensteenSuctionSystem;

        doc /*
        The system shall retain suctioned fluid in the canister and prevent liquid carryover into the vacuum pump.
        */

        require constraint {
            system.canister.isSealed == true and
            system.filter.fluidBreakthroughDetected == false
        }
    }

    requirement def CanisterFullAlarmRequirement {
        subject system : WangensteenSuctionSystem;

        doc /*
        The system shall stop effective suction and generate an alarm when the collection canister reaches its full threshold.
        */

        require constraint {
            system.canister.collectedVolume >= system.canister.fullThreshold implies
            system.canister.floatValveClosed == true and
            system.alarmModule.activeAlarm == true
        }
    }

    requirement def OcclusionAlarmRequirement {
        subject system : WangensteenSuctionSystem;

        doc /*
        The system shall detect a blocked or kinked suction path and alarm when the occlusion threshold is exceeded.
        */

        require constraint {
            system.occlusionDetector.occlusionIndex >= system.occlusionDetector.occludedThreshold implies
            system.occlusionDetector.occlusionDetected == true and
            system.alarmModule.activeAlarm == true
        }
    }

    requirement def UsabilityRequirement {
        subject system : WangensteenSuctionSystem;

        doc /*
        The system shall provide operator controls for start, pause, shutdown, and vacuum set point selection.
        */

        require constraint {
            system.userInterface.requestedVacuum >= -16000 [Pa] and
            system.userInterface.requestedVacuum <= -5000 [Pa]
        }
    }

    satisfy ControlledGastricSuctionRequirement by WangensteenSuctionSystem;
    satisfy PatientSafetyVacuumLimitRequirement by WangensteenSuctionSystem;
    satisfy FluidContainmentRequirement by WangensteenSuctionSystem;
    satisfy CanisterFullAlarmRequirement by WangensteenSuctionSystem;
    satisfy OcclusionAlarmRequirement by WangensteenSuctionSystem;
    satisfy UsabilityRequirement by WangensteenSuctionSystem;
}
