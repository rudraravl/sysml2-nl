        action conveyFluid {
            in item sourceFluid : SuctionedFluid;
            out item transportedFluid : SuctionedFluid;
        }

        action separateAndCollect {
            in item transportedFluid : SuctionedFluid;
            out item collectedFluid : SuctionedFluid;
        }

        action verifySafeOperation;
    }

