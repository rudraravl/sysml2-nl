    requirement def UsabilityRequirement {
        subject system : WangensteenSuctionSystem;

        doc /*
        The system shall provide operator controls for start, pause, shutdown, and vacuum set point selection.
        */

        require constraint {
            system.userInterface.requestedVacuum >= -16000 [Pa] and
            system.userInterface.requestedVacuum <= -5000 [Pa]
        }
    }

    satisfy ControlledGastricSuctionRequirement by WangensteenSuctionSystem;
    satisfy PatientSafetyVacuumLimitRequirement by WangensteenSuctionSystem;
    satisfy FluidContainmentRequirement by WangensteenSuctionSystem;
    satisfy CanisterFullAlarmRequirement by WangensteenSuctionSystem;
    satisfy OcclusionAlarmRequirement by WangensteenSuctionSystem;
    satisfy UsabilityRequirement by WangensteenSuctionSystem;
