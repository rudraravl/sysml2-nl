        then ignition;
        then liftoff;
        then solidRocketBoosterSeparation;
        then externalTankSeparation;
        then mainEngineCutoff;
        then orbitInsertion;
        then done;
    }

    action def RendezvousAndDock {
        in item stateVectorCommand : CommandMessage;
        out item dockingLoad : DockingLoad;

        first phaseAdjust;
        then terminalInitiation;
        then proximityOperations;
        then stationKeeping;
        then finalApproach;
        then softCapture;
        then hardMate;
        then done;
    }

    action def TransferKiboLogisticsModule {
        in item modulePayload : ExternalPayload;
        out item installedCargo : PressurizedCargo;

        first grappleModule;
        then unberthFromPayloadBay;
        then maneuverToStationPort;
        then berthToHarmony;
        then connectPowerDataThermal;
        then leakCheckVestibule;
        then activateModule;
        then done;
    }

    action def InstallDextreManipulator {
        in item manipulatorPayload : ExternalPayload;
        out item activationTelemetry : TelemetryPacket;

        first removeLaunchRestraints;
        then grappleManipulator;
        then positionOnStationWorksite;
        then attachStructuralInterfaces;
        then connectPowerData;
        then performJointCheckout;
        then confirmOperational;
        then done;
    }

    action def ConductEVAOperations {
        in item evaCrew1 : CrewMember;
        in item evaCrew2 : CrewMember;
        out item evaTelemetry : TelemetryPacket;

        first suitPrep;
        then airlockDepress;
        then translateToWorksite;
        then externalAssemblyTasks;
        then toolStowage;
        then airlockIngress;
        then repressurize;
        then done;
    }

    action def UndockAndReturn {
        out item landingTelemetry : TelemetryPacket;

        first hatchClosure;
        then undock;
        then separationBurn;
        then lateInspection;
        then deorbitBurn;
        then atmosphericEntry;
        then runwayLanding;
        then safing;
        then done;
    }

    state def STS123MissionStateMachine {
        entry action initializeMission;

        state PreLaunch;
        state Ascent;
        state OrbitPhasing;
        state DockedAssembly;
        state RoboticsTransfer;
        state EVAOperations;
        state Checkout;
        state UndockedFreeFlight;
        state EntryLanding;
        state MissionComplete;
        state MissionAbort;

        transition first PreLaunch;

        transition launch from PreLaunch to Ascent
            accept CommandMessage
            if commandName == "GO_FOR_LAUNCH";

        transition orbitAchieved from Ascent to OrbitPhasing;

        transition abortDuringAscent from Ascent to MissionAbort
            if currentMissionPhase == MissionPhase::abort;

        transition docked from OrbitPhasing to DockedAssembly;

        transition beginRobotics from DockedAssembly to RoboticsTransfer;

        transition beginEVA from RoboticsTransfer to EVAOperations;

        transition evaComplete from EVAOperations to Checkout;

        transition readyToUndock from Checkout to UndockedFreeFlight;

        transition deorbit from UndockedFreeFlight to EntryLanding;

        transition wheelsStop from EntryLanding to MissionComplete;
    }

    requirement def PrimaryFunctionRequirement {
        doc /* The STS-123 integrated system shall transport crew and station assembly payloads to the International Space Station, support docked installation and activation operations, and return the orbiter crew safely to Earth. */
    }

    requirement def RendezvousRequirement {
        doc /* The system shall provide controlled rendezvous and docking with the International Space Station while maintaining relative velocity and alignment within docking interface limits. */
    }

    requirement def CargoDeliveryRequirement {
        doc /* The system shall deliver the Kibo Logistics Module and Special Purpose Dexterous Manipulator to station interfaces and support their mechanical, electrical, data, and thermal integration. */
    }

    requirement def CrewSafetyRequirement {
        doc /* The system shall maintain habitable cabin conditions, authenticated command capability, emergency abort modes, and safe entry and landing capability for all assigned crew members. */
    }

    requirement def TelemetryRequirement {
        doc /* The system shall provide continuous health, trajectory, payload, life support, robotics, and EVA telemetry to mission control during critical mission phases. */
    }

    requirement def EVARequirement {
        doc /* The system shall support external crew operations needed to remove launch restraints, configure payloads, connect utilities, and verify station assembly readiness. */
    }

    satisfy PrimaryFunctionRequirement by STS123IntegratedSystem;
    satisfy RendezvousRequirement by STS123IntegratedSystem::orbiter;
    satisfy CargoDeliveryRequirement by STS123IntegratedSystem::kiboLogisticsModule;
    satisfy CargoDeliveryRequirement by STS123IntegratedSystem::dextre;
    satisfy CrewSafetyRequirement by STS123IntegratedSystem::orbiter;
    satisfy TelemetryRequirement by STS123IntegratedSystem::missionControl;
    satisfy EVARequirement by STS123IntegratedSystem::crew;

    exhibit state STS123MissionStateMachine by STS123IntegratedSystem;

    perform action LaunchAndAscent by STS123IntegratedSystem::orbiter;
    perform action RendezvousAndDock by STS123IntegratedSystem;
    perform action TransferKiboLogisticsModule by STS123IntegratedSystem;
    perform action InstallDextreManipulator by STS123IntegratedSystem;
    perform action ConductEVAOperations by STS123IntegratedSystem::crew;
    perform action UndockAndReturn by STS123IntegratedSystem::orbiter;
}
