  part def ObGynInstrumentSystem {
    attribute primaryFunction : String =
      "Provide sterile mechanical, visualization, monitoring, sampling, and suction-assisted clinical interfaces for high-level obstetric and gynecologic examination, diagnosis, fetal assessment, and procedural support.";
    attribute activeMode : ClinicalModeKind;
    attribute maximumPermittedContactForce : Force_N = (value = 80.0);
    attribute maximumProbeSurfaceTemperature : Temperature_C = (value = 41.0);

    port operatorCommands : CommandPort;
    port clinicalAlerts : AlertPort;

    part speculum : VaginalSpeculum;
    part tenaculum : Tenaculum;
    part deliveryForceps : ObstetricForceps;
    part ultrasoundProbe : UltrasoundProbe;
    part fetalDoppler : FetalDoppler;
    part biopsyPipelle : EndometrialBiopsyPipelle;
    part aspirationCannula : VacuumAspirationCannula;
    part sterilizationTray : SterilizationTray;

    connect operatorCommands to ultrasoundProbe.commandIn;
    connect operatorCommands to fetalDoppler.commandIn;
    connect speculum.safety to clinicalAlerts;
    connect tenaculum.safety to clinicalAlerts;
    connect deliveryForceps.safety to clinicalAlerts;
    connect ultrasoundProbe.safety to clinicalAlerts;
    connect fetalDoppler.safety to clinicalAlerts;
    connect biopsyPipelle.safety to clinicalAlerts;
    connect aspirationCannula.safety to clinicalAlerts;
    connect sterilizationTray.safety to clinicalAlerts;

    action def PerformPelvicExamination {
      in item canal : VaginalCanal;
      out item cervixVisible : Cervix;
      attribute mode : ClinicalModeKind = ClinicalModeKind::pelvicExamination;

      first start;
      then positionSpeculum : speculum.PositionAndOpen;
      then stabilize : tenaculum.StabilizeCervix;
      then done;

      flow canal to positionSpeculum.canal;
      flow positionSpeculum.exposedCervix to stabilize.cervix;
      flow stabilize.stabilizedCervix to cervixVisible;
    }

    action def PerformFetalAssessment {
      in item maternalSurface : PatientAnatomy;
      out item fetalHeartSignal : FetalSignal;
      out item imageFrame : UltrasoundImageFrame;
      attribute mode : ClinicalModeKind = ClinicalModeKind::fetalMonitoring;

      first start;
      then image : ultrasoundProbe.AcquirePelvicImage;
      then doppler : fetalDoppler.DetectFetalHeartRate;
      then done;

      flow maternalSurface to image.anatomy;
      flow maternalSurface to doppler.maternalSurface;
      flow image.imageFrame to imageFrame;
      flow doppler.fetalSignal to fetalHeartSignal;
    }

    action def PerformEndometrialSampling {
      in item cavity : UterineCavity;
      out item diagnosticSample : TissueSample;
      attribute mode : ClinicalModeKind = ClinicalModeKind::tissueSampling;

      first start;
      then collect : biopsyPipelle.CollectEndometrialSample;
      then done;

      flow cavity to collect.cavity;
      flow collect.endometrialSample to diagnosticSample;
    }

    action def PerformUterineEvacuation {
      in item cavity : UterineCavity;
      out item collectedAspirate : FluidOrTissueAspirate;
      attribute mode : ClinicalModeKind = ClinicalModeKind::uterineEvacuation;

      first start;
      then evacuate : aspirationCannula.EvacuateUterineContents;
      then done;

      flow cavity to evacuate.cavity;
      flow evacuate.aspirate to collectedAspirate;
    }

    action def ReprocessReusableInstruments {
      in item usedInstrument : SterileInstrument;
      out item readyInstrument : SterileInstrument;
      attribute mode : ClinicalModeKind = ClinicalModeKind::sterilization;

      first start;
      then cycle : sterilizationTray.ProcessReusableInstrument;
      then done;

      flow usedInstrument to cycle.contaminatedInstrument;
      flow cycle.sterilizedInstrument to readyInstrument;
    }

    state def SystemClinicalState {
      state Shutdown;
      state InventoryCheck;
      state SterileReady;
      state ExaminationMode;
      state MonitoringMode;
      state ProcedureMode;
      state ReprocessingMode;
      state FaultHold;

      transition first then Shutdown;
      transition Shutdown then InventoryCheck accept OperatorCommand
        if command.enabled;
      transition InventoryCheck then SterileReady;
      transition SterileReady then ExaminationMode
        if command.requestedMode == ClinicalModeKind::pelvicExamination or command.requestedMode == ClinicalModeKind::cervicalAssessment;
      transition SterileReady then MonitoringMode
        if command.requestedMode == ClinicalModeKind::fetalMonitoring;
      transition SterileReady then ProcedureMode
        if command.requestedMode == ClinicalModeKind::deliveryAssistance or command.requestedMode == ClinicalModeKind::tissueSampling or command.requestedMode == ClinicalModeKind::uterineEvacuation;
      transition ExaminationMode then ReprocessingMode;
      transition MonitoringMode then ReprocessingMode;
      transition ProcedureMode then ReprocessingMode;
      transition ReprocessingMode then SterileReady;
      transition ExaminationMode then FaultHold accept SafetyAlert
        if alert.severity >= 3;
      transition MonitoringMode then FaultHold accept SafetyAlert
        if alert.severity >= 3;
      transition ProcedureMode then FaultHold accept SafetyAlert
        if alert.severity >= 3;
      transition FaultHold then InventoryCheck accept OperatorCommand
        if command.enabled;
    }
  }

  requirement def PrimaryFunctionRequirement {
    subject system : ObGynInstrumentSystem;

    doc
      /* The obstetrics and gynecology instrument system shall provide a coordinated set of sterile clinical instruments whose primary high-level function is to support examination, visualization, fetal monitoring, sampling, delivery assistance, uterine evacuation, and reprocessing workflows. */

    require constraint {
      system.primaryFunction != ""
    }
  }

  requirement def SterilityRequirement {
    subject system : ObGynInstrumentSystem;

    doc
      /* Instruments that contact mucosa, cervix, uterus, tissue, or aspirated material shall be sterile before patient use and shall enter reprocessing or disposal after use. */

    require constraint {
      system.speculum.sterilityState == SterilityStateKind::sterile and
      system.tenaculum.sterilityState == SterilityStateKind::sterile and
      system.deliveryForceps.sterilityState == SterilityStateKind::sterile and
      system.biopsyPipelle.sterilityState == SterilityStateKind::sterile and
      system.aspirationCannula.sterilityState == SterilityStateKind::sterile
    }
  }

  requirement def MechanicalSafetyRequirement {
    subject system : ObGynInstrumentSystem;

    doc
      /* Mechanical instruments shall limit contact or traction forces to values appropriate for clinical use and shall emit an alert when commanded force exceeds the configured limit. */

    require constraint {
      system.deliveryForceps.maximumTractionForce.value <= system.maximumPermittedContactForce.value and
      system.tenaculum.maximumGripForce.value <= system.maximumPermittedContactForce.value
    }
  }

  requirement def ThermalSafetyRequirement {
    subject system : ObGynInstrumentSystem;

    doc
      /* Active electronic probes used for imaging or Doppler monitoring shall maintain patient-contact surface temperature at or below the configured limit. */

    require constraint {
      system.ultrasoundProbe.surfaceTemperatureLimit.value <= system.maximumProbeSurfaceTemperature.value
    }
  }

  requirement def FetalMonitoringRequirement {
    subject system : ObGynInstrumentSystem;

    doc
      /* The fetal Doppler instrument shall detect and report fetal heart-rate signals within the expected clinical monitoring range. */

    require constraint {
      system.fetalDoppler.minimumDetectableHeartRate.value <= 60.0 and
      system.fetalDoppler.maximumDetectableHeartRate.value >= 200.0
    }
  }

  requirement def SamplingTraceabilityRequirement {
    subject system : ObGynInstrumentSystem;

    doc
      /* Tissue sampling instruments shall output a preserved tissue sample with source-site identification for diagnostic workflow traceability. */

    require constraint {
      system.biopsyPipelle.sampleCapacity.value > 0.0
    }
  }

  part obGynInstrumentSystem : ObGynInstrumentSystem;

  satisfy PrimaryFunctionRequirement by obGynInstrumentSystem;
  satisfy SterilityRequirement by obGynInstrumentSystem;
  satisfy MechanicalSafetyRequirement by obGynInstrumentSystem;
  satisfy ThermalSafetyRequirement by obGynInstrumentSystem;
  satisfy FetalMonitoringRequirement by obGynInstrumentSystem;
  satisfy SamplingTraceabilityRequirement by obGynInstrumentSystem;
}
