    connect humidifier.conditionedAir to flowSensor.airIn;
    connect flowSensor.airOut to pressureSensor.airIn;
    connect pressureSensor.airOut to patientCircuit.deviceEnd;
    connect patientCircuit.patientEnd to mask.circuitPort;
    connect mask.patientPort to patientConnection.inspiration;

    connect patientConnection.exhalation to mask.exhaledAir;
    connect mask.ventedAir to patientCircuit.exhaustFlow;

