  }

  part def LeakEstimator {
    in item measuredSample : SensorSample;
    out item leakSampleOut : SensorSample;
    attribute estimatedLeak : FlowRate;
    attribute intentionalVentFlowModel : FlowRate = 24.0;
  }

  part def TherapyController {
    in item commandInput : TherapyCommand;
    in item flowSampleInput : SensorSample;
    in item pressureSampleInput : SensorSample;
    in item leakInput : SensorSample;
    in attribute powerInput : ElectricalPower;
    out attribute blowerCommand : Real;
    out attribute regulatorCommand : Pressure;
    out attribute humidifierCommand : RelativeHumidity;
    out item alarmRequest : AlarmSignal;
    out item statusOutput : SensorSample;
    out item loggedSample : SensorSample;

    attribute currentMode : TherapyMode = TherapyMode::Standby;
    attribute currentPressureTarget : Pressure = 4.0;
    attribute apneaDetectionWindow : TimeDuration = 10.0;
    attribute pressureAdjustmentStep : Pressure = 0.5;

    state def TherapyControlStateMachine {
      state standby;
      state ramping;
      state deliveringCPAP;
      state deliveringAutoCPAP;
      state deliveringBiLevel;
      state faultSafe;

      transition standby_to_ramping
        first standby
        accept TherapyCommand
        if commandInput.mode == TherapyMode::Ramp
        then ramping;

      transition standby_to_cpap
        first standby
        accept TherapyCommand
        if commandInput.mode == TherapyMode::CPAP
        then deliveringCPAP;

      transition standby_to_autocpap
        first standby
        accept TherapyCommand
        if commandInput.mode == TherapyMode::AutoCPAP
        then deliveringAutoCPAP;

      transition standby_to_bilevel
        first standby
        accept TherapyCommand
        if commandInput.mode == TherapyMode::BiLevel
        then deliveringBiLevel;

      transition therapy_to_fault
        first deliveringCPAP
        if pressureSampleInput.measuredPressure > 25.0 or leakInput.leakFlow > 60.0
        then faultSafe;

      transition auto_to_fault
        first deliveringAutoCPAP
        if pressureSampleInput.measuredPressure > 25.0 or leakInput.leakFlow > 60.0
        then faultSafe;

      transition bilevel_to_fault
        first deliveringBiLevel
        if pressureSampleInput.measuredPressure > 25.0 or leakInput.leakFlow > 60.0
        then faultSafe;

      transition fault_to_standby
        first faultSafe
        accept TherapyCommand
        if commandInput.mode == TherapyMode::Standby
        then standby;
    }

