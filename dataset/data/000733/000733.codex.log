    connect flowSensor.sampleOut to therapyController.flowSampleInput;
    connect pressureSensor.sampleOut to therapyController.pressureSampleInput;
    connect leakEstimator.leakSampleOut to therapyController.leakInput;
    connect therapyController.blowerCommand to blower.speedCommand;
    connect therapyController.regulatorCommand to pressureRegulator.pressureCommand;
    connect therapyController.humidifierCommand to humidifier.humidityCommand;
    connect therapyController.statusOutput to userInterface.statusInput;
    connect therapyController.alarmRequest to alarmManager.alarmInput;
    connect alarmManager.alarmOutput to userAlarm.alarm;
    connect mainsPower.availablePower to powerSupply.inputPower;
    connect powerSupply.devicePower to blower.powerInput;
    connect powerSupply.devicePower to humidifier.powerInput;
    connect powerSupply.devicePower to therapyController.powerInput;
    connect therapyController.loggedSample to dataLogger.sampleInput;

    constraint pressureSafety {
      pressureSensor.measuredPressure <= maximumAllowedPressure
    }

    constraint therapeuticPressureWindow {
      minAutoPressure <= cpapPressureSetpoint and cpapPressureSetpoint <= maxAutoPressure
    }

    constraint leakTolerance {
      leakEstimator.estimatedLeak <= maximumContinuousLeak
    }

    perform action providePositiveAirwayPressure;
  }

