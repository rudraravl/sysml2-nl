    doc
      /* Primary high-level function: provide controlled positive airway pressure therapy to a sleeping or resting patient by drawing ambient air, filtering it, pressurizing it, optionally humidifying it, delivering it through a patient interface, monitoring therapy quality, and alerting the user when safe or effective therapy cannot be maintained. */

    attribute activeMode : TherapyMode = TherapyMode::Standby;
    attribute cpapPressureSetpoint : Pressure = 10.0;
    attribute minAutoPressure : Pressure = 5.0;
    attribute maxAutoPressure : Pressure = 16.0;
    attribute inspiratoryPressureSetpoint : Pressure = 14.0;
    attribute expiratoryPressureSetpoint : Pressure = 8.0;
    attribute rampStartPressure : Pressure = 4.0;
    attribute rampDuration : TimeDuration = 1200.0;
    attribute maximumAllowedPressure : Pressure = 25.0;
    attribute maximumContinuousLeak : FlowRate = 35.0;
    attribute minimumTherapeuticFlow : FlowRate = 5.0;
    attribute maximumSoundLevel : SoundPressureLevel = 30.0;
    attribute nominalPowerUse : ElectricalPower = 65.0;

    port airIntake : AirInletPort;
    port patientConnection : PatientInterfacePort;
    port clinicianCommand : CommandPort;
    port userAlarm : AlarmPort;
    port mainsPower : PowerPort;

    part enclosure : Enclosure;
    part inletFilter : AirFilter;
    part blower : VariableSpeedBlower;
    part pressureRegulator : PressureRegulator;
    part humidifier : HeatedHumidifier;
    part flowSensor : FlowSensor;
    part pressureSensor : PressureSensor;
    part leakEstimator : LeakEstimator;
