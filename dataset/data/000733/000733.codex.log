      state faultSafe;

      transition standby_to_ramping
        first standby
        accept TherapyCommand
        if commandInput.mode == TherapyMode::Ramp
        then ramping;

      transition standby_to_cpap
        first standby
        accept TherapyCommand
        if commandInput.mode == TherapyMode::CPAP
        then deliveringCPAP;

      transition standby_to_autocpap
        first standby
        accept TherapyCommand
        if commandInput.mode == TherapyMode::AutoCPAP
        then deliveringAutoCPAP;

      transition standby_to_bilevel
        first standby
        accept TherapyCommand
        if commandInput.mode == TherapyMode::BiLevel
        then deliveringBiLevel;

      transition therapy_to_fault
        first deliveringCPAP
        if pressureSampleInput.measuredPressure > 25.0 or leakInput.leakFlow > 60.0
        then faultSafe;

      transition auto_to_fault
        first deliveringAutoCPAP
        if pressureSampleInput.measuredPressure > 25.0 or leakInput.leakFlow > 60.0
        then faultSafe;

      transition bilevel_to_fault
        first deliveringBiLevel
        if pressureSampleInput.measuredPressure > 25.0 or leakInput.leakFlow > 60.0
        then faultSafe;

      transition fault_to_standby
        first faultSafe
        accept TherapyCommand
        if commandInput.mode == TherapyMode::Standby
        then standby;
    }

    action def ComputePressureTarget {
      in attribute mode : TherapyMode;
      in attribute measuredPressure : Pressure;
      in attribute measuredFlow : FlowRate;
      in attribute estimatedLeak : FlowRate;
      out attribute targetPressure : Pressure;

      constraint targetLimit {
        targetPressure >= 4.0 and targetPressure <= 25.0
      }
    }

    action def DetectTherapyFault {
      in attribute measuredPressure : Pressure;
      in attribute estimatedLeak : FlowRate;
      in attribute deliveredFlow : FlowRate;
      out item alarm : AlarmSignal;
    }
  }

  part def UserInterface {
    in item statusInput : SensorSample;
    attribute displayPressure : Pressure;
    attribute displayLeak : FlowRate;
    attribute therapyHours : TimeDuration;
    attribute clinicianLockEnabled : Boolean = true;
  }

  part def AlarmManager {
    in item alarmInput : AlarmSignal;
    out item alarmOutput : AlarmSignal;
    attribute audibleLevel : SoundPressureLevel = 65.0;
    attribute visualIndicatorActive : Boolean;
  }

  part def PowerSupply {
    in attribute inputPower : ElectricalPower;
    out attribute devicePower : ElectricalPower;
    attribute backupShutdownTime : TimeDuration = 5.0;
    attribute isolationProvided : Boolean = true;
  }

  part def TherapyDataLogger {
    in item sampleInput : SensorSample;
    attribute complianceHoursStored : TimeDuration;
    attribute leakEventsStored : Integer;
    attribute apneaHypopneaIndexEstimate : Real;
    attribute retentionPeriod : TimeDuration = 31536000.0;
  }

  part def PatientBreathingCircuit {
    in item deviceEnd : PressurizedAir;
    out item patientEnd : PressurizedAir;
    in item exhaustFlow : ExhaledAir;
    attribute tubeLength : Real = 1.8;
    attribute tubeDiameter : Real = 15.0;
    attribute pressureDropAtNominalFlow : Pressure = 0.4;
  }

  part def PatientMask {
    in item circuitPort : PressurizedAir;
    out item patientPort : PressurizedAir;
    in item exhaledAir : ExhaledAir;
    out item ventedAir : ExhaledAir;
    attribute maskType : String = "nasal";
    attribute intentionalVentFlowAt10cmH2O : FlowRate = 24.0;
    attribute fitLeakThreshold : FlowRate = 35.0;
  }

  action def ProvidePositiveAirwayPressure {
    in item ambientAir : AmbientAir;
    in item therapyCommand : TherapyCommand;
    out item deliveredAir : PressurizedAir;
    out item alarm : AlarmSignal;

    first start;
    then filterAmbientAir;
    then pressurizeAir;
    then regulatePressure;
    then humidifyAir;
    then deliverToPatient;
    then monitorTherapy;
    then logTherapyData;

    action filterAmbientAir;
    action pressurizeAir;
    action regulatePressure;
    action humidifyAir;
    action deliverToPatient;
    action monitorTherapy;
    action logTherapyData;
  }

  requirement def PrimaryFunctionRequirement {
    subject system : RespironicsInspiredPositiveAirwayPressureSystem;

    require constraint {
      system.patientConnection.inspiration.pressure >= 4.0 and
      system.patientConnection.inspiration.pressure <= system.maximumAllowedPressure
    }

    doc
      /* The system shall deliver prescribed positive airway pressure therapy to maintain patient airway patency during sleep or rest. */
  }

  requirement def PressureControlRequirement {
    subject system : RespironicsInspiredPositiveAirwayPressureSystem;

    require constraint {
      abs(system.pressureSensor.measuredPressure - system.therapyController.currentPressureTarget) <= 1.0
    }

    doc
      /* The system shall regulate delivered airway pressure within 1 cmH2O of the active therapeutic target during stable breathing. */
  }

  requirement def AutoAdjustmentRequirement {
    subject system : RespironicsInspiredPositiveAirwayPressureSystem;

    require constraint {
      system.minAutoPressure >= 4.0 and
      system.maxAutoPressure <= 20.0 and
      system.minAutoPressure < system.maxAutoPressure
    }

    doc
      /* In AutoCPAP mode, the system shall adjust therapeutic pressure within configured minimum and maximum limits based on measured flow limitation, leak, and pressure response. */
  }

  requirement def BiLevelRequirement {
    subject system : RespironicsInspiredPositiveAirwayPressureSystem;

    require constraint {
      system.inspiratoryPressureSetpoint > system.expiratoryPressureSetpoint and
      system.inspiratoryPressureSetpoint <= system.maximumAllowedPressure
    }

    doc
      /* In bilevel mode, inspiratory pressure shall be greater than expiratory pressure while remaining below the maximum allowed airway pressure. */
  }

  requirement def LeakAlarmRequirement {
    subject system : RespironicsInspiredPositiveAirwayPressureSystem;

    require constraint {
      system.leakEstimator.estimatedLeak <= system.maximumContinuousLeak
    }

    doc
      /* The system shall detect excessive unintentional leak and generate an alarm when leak prevents effective therapy delivery. */
  }

  requirement def OverPressureSafetyRequirement {
    subject system : RespironicsInspiredPositiveAirwayPressureSystem;

    require constraint {
      system.pressureSensor.measuredPressure <= system.maximumAllowedPressure
    }

    doc
      /* The system shall enter a fault-safe state and alarm if measured airway pressure exceeds the allowed pressure limit. */
  }

  requirement def HumidificationRequirement {
    subject system : RespironicsInspiredPositiveAirwayPressureSystem;

    require constraint {
      system.humidifier.humidityOutput >= 40.0 and system.humidifier.humidityOutput <= 90.0
    }

    doc
      /* When enabled, the humidifier shall condition delivered air to a comfortable therapeutic humidity range. */
  }

  requirement def DataLoggingRequirement {
    subject system : RespironicsInspiredPositiveAirwayPressureSystem;

    require constraint {
      system.dataLogger.retentionPeriod >= 31536000.0
    }

    doc
      /* The system shall retain therapy usage, leak, pressure, and event summary data for at least one year. */
  }

  satisfy PrimaryFunctionRequirement by RespironicsInspiredPositiveAirwayPressureSystem;
  satisfy PressureControlRequirement by PressureRegulator;
  satisfy AutoAdjustmentRequirement by TherapyController;
  satisfy BiLevelRequirement by TherapyController;
  satisfy LeakAlarmRequirement by LeakEstimator;
  satisfy OverPressureSafetyRequirement by AlarmManager;
  satisfy HumidificationRequirement by HeatedHumidifier;
  satisfy DataLoggingRequirement by TherapyDataLogger;
}
