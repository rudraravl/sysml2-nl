    in attribute humidityCommand : RelativeHumidity;
    in attribute powerInput : ElectricalPower;
    attribute waterChamberVolume : Volume = 325.0;
    attribute heaterPlateTemperature : Temperature;
    attribute humidityOutput : RelativeHumidity;
  }

  part def FlowSensor {
    in item airIn : PressurizedAir;
    out item airOut : PressurizedAir;
    out item sampleOut : SensorSample;
    attribute measuredFlow : FlowRate;
