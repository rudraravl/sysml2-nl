    requirement def ProvideSafeReliableWater {
        subject network : WaterSupplyNetwork;

        doc
        /* The water supply network shall abstract, treat, store, pressurize, distribute,
           and deliver potable water from a raw water source to connected customers. */

        require constraint {
            network.treatment.outletTurbidity <= network.scada.maximumAllowedTurbidity;
        }

        require constraint {
            network.clearwell.storedVolume >= network.clearwell.minimumOperatingVolume;
        }

        require constraint {
            network.highLiftPumps.dischargePressure <= network.transmissionMain.designPressure;
        }

        require constraint {
            network.northPressureZone.deliveredPressure >= network.residentialConnection.minimumServicePressure;
        }

        require constraint {
            network.southPressureZone.deliveredPressure >= network.industrialConnection.minimumServicePressure;
        }
    }

    requirement def MaintainPotableWaterQuality {
        subject treatmentPlant : TreatmentPlant;

        require constraint {
            treatmentPlant.outletTurbidity <= 1.0;
        }

        require constraint {
            treatmentPlant.chlorineDose >= 0.5 and treatmentPlant.chlorineDose <= 4.0;
        }
    }

    requirement def MaintainDistributionPressure {
        subject network : WaterSupplyNetwork;

        require constraint {
            network.northPressureZone.deliveredPressure >= 280000.0;
        }

        require constraint {
            network.southPressureZone.deliveredPressure >= 350000.0;
        }
    }

    requirement def ProvideOperationalMonitoring {
        subject network : WaterSupplyNetwork;

        doc
        /* The system shall continuously monitor source intake, treatment performance,
           storage level, pumping pressure, distribution flow, and pressure zone delivery. */

        require constraint {
            network.scada.networkPressureSetpoint > 0.0;
        }

        require constraint {
            network.scada.tankLevelSetpoint >= 40.0 and network.scada.tankLevelSetpoint <= 90.0;
        }
    }

    satisfy ProvideSafeReliableWater by WaterSupplyNetwork;
    satisfy MaintainPotableWaterQuality by TreatmentPlant;
    satisfy MaintainDistributionPressure by WaterSupplyNetwork;
    satisfy ProvideOperationalMonitoring by SupervisoryControlAndDataAcquisition;
}
