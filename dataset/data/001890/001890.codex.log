        connect scada.treatmentCommand to treatment.control;
        connect scada.pumpCommand to highLiftPumps.control;

        connect intake.telemetry to scada.intakeTelemetry;
        connect treatment.telemetry to scada.treatmentTelemetry;
        connect highLiftPumps.telemetry to scada.pumpTelemetry;
        connect clearwell.telemetry to scada.tankTelemetry;
        connect transmissionMain.telemetry to scada.distributionTelemetry;
        connect northPressureZone.telemetry to scada.zoneTelemetry;
        connect southPressureZone.telemetry to scada.zoneTelemetry;

        action providePotableWater {
            in item rawWater : RawWater;
            out item deliveredWater : TreatedWater;

            action intakeRawWater : intake.liftRawWater;
            action treatWater : treatment.disinfect;
            action storeTreatedWater : clearwell.storeWater;
            action pressurize : highLiftPumps.pressurizeWater;
            action distribute : transmissionMain.conveyWater;
            action regulateNorth : northPressureZone.regulatePressure;
            action regulateSouth : southPressureZone.regulatePressure;
            action deliverResidential : residentialConnection.deliverPotableWater;
            action deliverIndustrial : industrialConnection.deliverPotableWater;
        }

        state def NetworkOperatingState {
            state normalSupply;
            state peakDemand;
            state lowStorage;
            state waterQualityHold;
            state emergencyIsolation;

            transition first normalSupply;

            transition normal_to_peak
                first normalSupply then peakDemand
                if northPressureZone.customerDemand + southPressureZone.customerDemand > 1.3;

            transition peak_to_normal
                first peakDemand then normalSupply
                if northPressureZone.customerDemand + southPressureZone.customerDemand <= 1.1;

            transition normal_to_lowStorage
                first normalSupply then lowStorage
                if clearwell.waterLevelPercent < 35.0;

            transition lowStorage_to_normal
                first lowStorage then normalSupply
                if clearwell.waterLevelPercent >= 60.0;

            transition any_to_qualityHold
                first normalSupply then waterQualityHold
                if treatment.outletTurbidity > scada.maximumAllowedTurbidity;

            transition qualityHold_to_normal
                first waterQualityHold then normalSupply
                if treatment.outletTurbidity <= scada.maximumAllowedTurbidity;

            transition any_to_emergency
                first normalSupply then emergencyIsolation
                if highLiftPumps.dischargePressure > transmissionMain.designPressure;
        }
    }

    requirement def ProvideSafeReliableWater {
        subject network : WaterSupplyNetwork;

        doc
        /* The water supply network shall abstract, treat, store, pressurize, distribute,
           and deliver potable water from a raw water source to connected customers. */

        require constraint {
            network.treatment.outletTurbidity <= network.scada.maximumAllowedTurbidity;
        }

        require constraint {
            network.clearwell.storedVolume >= network.clearwell.minimumOperatingVolume;
        }

        require constraint {
            network.highLiftPumps.dischargePressure <= network.transmissionMain.designPressure;
        }

        require constraint {
            network.northPressureZone.deliveredPressure >= network.residentialConnection.minimumServicePressure;
        }

        require constraint {
            network.southPressureZone.deliveredPressure >= network.industrialConnection.minimumServicePressure;
        }
    }

    requirement def MaintainPotableWaterQuality {
        subject treatmentPlant : TreatmentPlant;

        require constraint {
            treatmentPlant.outletTurbidity <= 1.0;
        }

        require constraint {
            treatmentPlant.chlorineDose >= 0.5 and treatmentPlant.chlorineDose <= 4.0;
        }
    }

    requirement def MaintainDistributionPressure {
        subject network : WaterSupplyNetwork;

        require constraint {
            network.northPressureZone.deliveredPressure >= 280000.0;
        }

        require constraint {
            network.southPressureZone.deliveredPressure >= 350000.0;
        }
    }

    requirement def ProvideOperationalMonitoring {
        subject network : WaterSupplyNetwork;

        doc
        /* The system shall continuously monitor source intake, treatment performance,
           storage level, pumping pressure, distribution flow, and pressure zone delivery. */

        require constraint {
            network.scada.networkPressureSetpoint > 0.0;
        }

        require constraint {
            network.scada.tankLevelSetpoint >= 40.0 and network.scada.tankLevelSetpoint <= 90.0;
        }
    }

    satisfy ProvideSafeReliableWater by WaterSupplyNetwork;
    satisfy MaintainPotableWaterQuality by TreatmentPlant;
    satisfy MaintainDistributionPressure by WaterSupplyNetwork;
    satisfy ProvideOperationalMonitoring by SupervisoryControlAndDataAcquisition;
}
