            attribute patientIdentifier = "identified-patient";
            attribute allergyScreenComplete = true;
            attribute veinSelected = true;
        }

        part clinician : Clinician {
            attribute trainedForVenousAccess = true;
            attribute handHygieneComplete = true;
        }

        part skinSite : SkinSite;
        part targetVein : PeripheralVein;
        part accessDevice : VenousAccessDevice;
        part infusionSource : InfusionSource;

        item antiseptic : Antiseptic {
            attribute agentName = "chlorhexidine-alcohol";
            attribute wetContactTime = 30 [s];
        }

        item salineFlush : FlushSolution {
            attribute volume = 10 [mL];
            attribute temperature = 293.15 [K];
            attribute salineConcentration = 9 [mg/mL];
            attribute preservativeFree = true;
