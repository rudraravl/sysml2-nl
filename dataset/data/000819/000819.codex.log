            attribute sterile = true;
            attribute singleUse = true;
            attribute gauge.value = 20;
            attribute outerDiameter = 1.1 [mm];
            attribute usableLength = 32 [mm];
            attribute primingVolume = 0.12 [mL];
            attribute maxRatedFlow = 0.09 [L/min];
            attribute radioOpaque = true;
        }

        part introducer : NeedleIntroducer {
            attribute sterile = true;
            attribute singleUse = true;
            attribute gauge.value = 20;
            attribute bevelLength = 3.0 [mm];
