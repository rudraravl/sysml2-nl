        item maintenanceInfusate : Infusate {
            attribute volume = 250 [mL];
            attribute temperature = 293.15 [K];
            attribute concentration = 1 [mg/mL];
            attribute medicationName = "compatible intravenous therapy";
            attribute compatibleWithPeripheralVein = true;
        }

        connect clinician to accessDevice.visualPort.operator;
        connect infusionSource.outlet to accessDevice.therapyEnd;
        connect accessDevice.patientEnd to targetVein.lumen;
        connect skinSite.puncturePath to targetVein.lumen;
    }

    action def PrepareVenousAccess {
        in item clinician : Clinician;
        inout part skinSite : SkinSite;
        in item antiseptic : Antiseptic;
        out attribute prepared : Boolean;

        first start;
        then verifyIdentity;
        then performHandHygiene;
        then applyAntiseptic;
        then waitForDryTime;
        then done;

        action verifyIdentity {
            assert clinician.trainedForVenousAccess == true;
        }

        action performHandHygiene {
            assert clinician.handHygieneComplete == true;
        }

        action applyAntiseptic {
            skinSite.disinfected := true;
        }

        action waitForDryTime {
            assert antiseptic.wetContactTime >= 30 [s];
            skinSite.dry := true;
            prepared := skinSite.disinfected and skinSite.dry;
        }
    }

    action def InsertCatheter {
        in part vein : PeripheralVein;
        inout part skinSite : SkinSite;
        inout part device : VenousAccessDevice;
        out attribute inserted : Boolean;

        first alignDevice;
        then punctureSkin;
        then enterVein;
        then advanceCatheter;
        then retractIntroducer;
        then done;

        action alignDevice {
            assert vein.diameter >= 2.0 [mm];
        }

        action punctureSkin {
            assert skinSite.disinfected == true;
            assert skinSite.dry == true;
        }

        action enterVein {
            assert vein.baselinePressure > 0 [kPa];
        }

        action advanceCatheter {
            device.state := AccessStateKind::inserted;
            inserted := true;
        }

        action retractIntroducer {
            assert device.introducer.retractableSharp == true;
        }
    }

    action def ConfirmPatency {
        inout part device : VenousAccessDevice;
        in item flush : FlushSolution;
        out attribute patent : Boolean;

        first aspirateBloodReturn;
        then flushWithoutResistance;
        then assessSite;
        then done;

        action aspirateBloodReturn {
            assert device.state == AccessStateKind::inserted or device.state == AccessStateKind::flushed;
        }

        action flushWithoutResistance {
            assert flush.volume >= 3 [mL];
            assert device.extensionSet.maxPressure >= 200 [kPa];
        }

        action assessSite {
            device.patencyConfirmed := true;
            device.state := AccessStateKind::patent;
            patent := true;
        }
    }

    action def DeliverInfusate {
        in part source : InfusionSource;
        inout part device : VenousAccessDevice;
        in item infusate : Infusate;
        out attribute deliveredVolume : Volume;

        first verifyCompatibility;
        then startFlow;
        then monitorPressure;
        then completeDelivery;
        then done;

        action verifyCompatibility {
            assert infusate.compatibleWithPeripheralVein == true;
            assert device.patencyConfirmed == true;
        }

        action startFlow {
            device.state := AccessStateKind::infusing;
            assert source.programmedRate <= device.catheter.maxRatedFlow;
        }

        action monitorPressure {
            assert source.pressureLimit <= device.extensionSet.maxPressure;
        }

        action completeDelivery {
            deliveredVolume := infusate.volume;
            device.state := AccessStateKind::flushed;
        }
    }

    action def ObtainBloodSample {
        inout part device : VenousAccessDevice;
        out item sample : Blood;

        first pauseInfusion;
        then discardDeadSpace;
        then collectSample;
        then restoreAccess;
        then done;

        action pauseInfusion {
            assert device.state == AccessStateKind::patent or device.state == AccessStateKind::infusing;
            device.state := AccessStateKind::sampling;
        }

        action discardDeadSpace {
            assert device.extensionSet.internalVolume <= 1 [mL];
        }

        action collectSample {
            sample.volume := 5 [mL];
            sample.temperature := 310.15 [K];
            sample.oxygenSaturation.value := 70;
            sample.hemolyzed := false;
        }

        action restoreAccess {
            device.state := AccessStateKind::patent;
        }
    }

    action def RemoveVenousAccess {
        inout part device : VenousAccessDevice;
        out attribute removed : Boolean;

        first stopTherapy;
        then releaseDressing;
        then withdrawCatheter;
        then applyPressure;
        then documentRemoval;
        then done;

        action stopTherapy {
            assert device.state != AccessStateKind::removed;
        }

        action releaseDressing {
            device.securementIntegrity.value := 0;
        }

        action withdrawCatheter {
            device.state := AccessStateKind::removed;
            removed := true;
        }

