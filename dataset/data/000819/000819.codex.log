        }

        action documentRemoval {
        }
    }

    state def VenousAccessLifecycle {
        entry action initialize {
        }

        state Idle;
        state SitePrepared;
        state DeviceInserted;
        state Patent;
        state Infusing;
        state Sampling;
        state Flushed;
        state Secured;
        state Occluded;
        state Infiltrated;
        state Removed;

