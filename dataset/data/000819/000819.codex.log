            first DeviceInserted
            accept PatencyConfirmed
            then Patent;

        transition Patent_to_Infusing
            first Patent
            accept StartInfusion
            then Infusing;

        transition Infusing_to_Flushed
            first Infusing
            accept InfusionComplete
            then Flushed;

        transition Flushed_to_Patent
            first Flushed
            accept PatencyConfirmed
            then Patent;

        transition Patent_to_Sampling
            first Patent
            accept SampleRequested
            then Sampling;

        transition Sampling_to_Patent
            first Sampling
            accept SampleComplete
            then Patent;

        transition Patent_to_Secured
            first Patent
            accept DressingApplied
            then Secured;

        transition Secured_to_Patent
            first Secured
            accept AccessNeeded
            then Patent;

        transition Patent_to_Occluded
            first Patent
            accept ResistanceDetected
            then Occluded;

        transition Infusing_to_Infiltrated
            first Infusing
            accept SwellingOrPainDetected
            then Infiltrated;

        transition Occluded_to_Removed
            first Occluded
            accept RemoveDevice
            then Removed;

        transition Infiltrated_to_Removed
            first Infiltrated
            accept RemoveDevice
            then Removed;

        transition Patent_to_Removed
            first Patent
            accept TherapyComplete
            then Removed;
    }

    requirement def PrimaryFunctionRequirement {
        doc /* The venous access system shall provide temporary, controlled access to a patient's venous circulation for administration of compatible fluids or medications, withdrawal of blood samples, and maintenance of vascular patency while minimizing tissue injury, contamination, leakage, occlusion, and infiltration. */

        subject system : VenousAccessDevice;

        require constraint {
            system.catheter.sterile == true and
            system.catheter.singleUse == true and
            system.extensionSet.maxPressure >= 200 [kPa] and
            system.catheter.maxRatedFlow >= 0.02 [L/min]
        }
    }

    requirement def PatencyRequirement {
        doc /* The device shall permit confirmation of venous patency before therapy delivery. */

        subject system : VenousAccessDevice;

        require constraint {
            system.patencyConfirmed == true implies
            (system.state == AccessStateKind::patent or
             system.state == AccessStateKind::infusing or
             system.state == AccessStateKind::sampling or
             system.state == AccessStateKind::flushed)
        }
    }

    requirement def FlowControlRequirement {
        doc /* The system shall deliver compatible infusate at a programmed flow rate that does not exceed the rated catheter flow capacity. */

        subject system : VenousAccessDevice;
        subject source : InfusionSource;

        require constraint {
            source.programmedRate <= system.catheter.maxRatedFlow
        }
    }

    requirement def PressureSafetyRequirement {
        doc /* Infusion pressure shall remain below the pressure rating of the extension tubing. */

        subject system : VenousAccessDevice;
        subject source : InfusionSource;

        require constraint {
            source.pressureLimit <= system.extensionSet.maxPressure
        }
    }

    requirement def AsepticAccessRequirement {
        doc /* Insertion shall occur only after skin disinfection and drying. */

        subject site : SkinSite;

        require constraint {
            site.disinfected == true and site.dry == true
        }
    }

    requirement def SecurementRequirement {
        doc /* After placement, the catheter shall be stabilized by a transparent sterile dressing that supports site visibility. */

        subject system : VenousAccessDevice;

        require constraint {
            system.dressing.sterile == true and
            system.dressing.transparent == true and
            system.securementIntegrity >= 90 [%]
        }
    }

    requirement def SamplingRequirement {
        doc /* When used for blood sampling, the system shall provide a sample volume sufficient for laboratory analysis without hemolysis indication. */

        subject sample : Blood;

        require constraint {
            sample.volume >= 3 [mL] and sample.hemolyzed == false
        }
    }

    part venousAccessSystem : VenousAccessProcedureEnvironment {
        metadata ClinicalModelMetadata {
            purpose = "High-level model of temporary venous access for controlled fluid delivery and blood sampling.";
            domain = "clinical vascular access";
            riskClass = "invasive temporary access device";
        }
    }

    satisfy PrimaryFunctionRequirement by venousAccessSystem.accessDevice;
    satisfy PatencyRequirement by venousAccessSystem.accessDevice;
    satisfy FlowControlRequirement by venousAccessSystem.infusionSource;
    satisfy PressureSafetyRequirement by venousAccessSystem.infusionSource;
    satisfy AsepticAccessRequirement by venousAccessSystem.skinSite;
    satisfy SecurementRequirement by venousAccessSystem.accessDevice;
