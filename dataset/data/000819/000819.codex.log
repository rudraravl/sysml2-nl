            attribute sterile = true;
            attribute singleUse = true;
            attribute transparent = true;
            attribute adhesiveIntegrity = 100 [%];
            attribute changeInterval = 604800 [s];
        }

        port patientEnd : BloodPort;
        port therapyEnd : FluidPort;
        port commandPort : ControlPort;
        port visualPort : HumanInterfacePort;

        connect extensionSet to catheter;
        connect therapyEnd to extensionSet;
        connect catheter to patientEnd;
    }

