package VenousAccessSystemModel {

    import ScalarValues::*;
    import ISQ::*;
    import SI::*;
    import Time::*;

    metadata def ClinicalModelMetadata {
        attribute purpose : String;
        attribute domain : String;
        attribute riskClass : String;
    }

    attribute def FlowRate :> ISQ::volumeFlowRate {
        unit = L/min;
