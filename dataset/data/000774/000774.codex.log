        part panel : ControlPanel;
        part processor : MeasurementProcessor;
        part power : PowerSubsystem;
        part dataInterface : DataInterface;

        port subjectPort : SubjectInterfacePort;
        port operatorPort : OperatorControlPort;
        port dataPort : DataOutputPort;
        port powerPort : PowerPort;

        connect subjectPort to base.subjectInterface;
        connect operatorPort to panel.operatorPort;
        connect dataPort to dataInterface.dataOut;
        connect powerPort to power.powerIn;

        perform action initialize : InitializeDevice {
            inout processor = processor;
        }

        perform action positionHeadpiece : PositionHeadpieceAction {
            in subject = subjectPort.subject;
            inout headpiece = headpiece;
            in contactSensor = contactSensor;
        }

        perform action measureHeight : MeasureStandingHeight {
            in subject = subjectPort.subject;
            in sensor = positionSensor;
            in processor = processor;
            out measurement = processor.lastMeasurement;
        }

        exhibit state operationalBehavior : StadiometerOperationalStateMachine {
            inout processor = processor;
            in subject = subjectPort.subject;
            in command = operatorPort.command;
            in sensor = positionSensor;
            in contactSensor = contactSensor;
            in power = power;
        }
    }

    requirement def MeasureStandingHeightRequirement {
        subject stadiometer : DigitalStadiometer;

        require constraint {
            stadiometer.processor.lastMeasurement.valid implies
            stadiometer.processor.lastMeasurement.measuredHeight.value >= 0.60 and
            stadiometer.processor.lastMeasurement.measuredHeight.value <= 2.20
        }

        doc /* The stadiometer shall measure standing human height over the supported clinical range. */
    }

    requirement def AccuracyRequirement {
        subject stadiometer : DigitalStadiometer;

        require constraint {
            stadiometer.positionSensor.accuracy.value <= 0.001
        }

        doc /* The stadiometer shall provide height measurement accuracy within plus or minus 1 mm under calibrated operating conditions. */
    }

    requirement def ResolutionRequirement {
        subject stadiometer : DigitalStadiometer;

        require constraint {
            stadiometer.positionSensor.resolution.value <= 0.0005 and
            stadiometer.column.graduationResolution.value <= 0.001
        }

        doc /* The stadiometer shall resolve height changes of 1 mm or better. */
    }

    requirement def ContactForceRequirement {
        subject stadiometer : DigitalStadiometer;

        require constraint {
            stadiometer.headpiece.contactForceMinimum.value >= 1.0 and
            stadiometer.headpiece.contactForceMaximum.value <= 5.0
        }

        doc /* The headpiece shall contact the subject with enough force to confirm contact without excessive compression or discomfort. */
    }

    requirement def PostureValidationRequirement {
        subject subject : HumanSubject;

        require constraint {
            subject.postureStable and
            subject.heelsAgainstBase and
            subject.headInFrankfortPlane
        }

        doc /* A valid height measurement shall require stable posture, heel placement on the base platform, and head alignment in the Frankfort plane. */
    }

    requirement def CalibrationRequirement {
        subject stadiometer : DigitalStadiometer;

        require constraint {
            stadiometer.processor.calibrationValid
        }

        doc /* The stadiometer shall use a valid calibration record before reporting clinical height measurements. */
    }

    requirement def ResultOutputRequirement {
        subject stadiometer : DigitalStadiometer;

        require constraint {
            stadiometer.processor.lastMeasurement.valid implies
            stadiometer.processor.lastMeasurement.confidence.value >= 95.0
        }

        doc /* The stadiometer shall display and export a validated height result with measurement confidence. */
    }

    requirement def SafetyRequirement {
        subject stadiometer : DigitalStadiometer;

        require constraint {
            stadiometer.base.maximumSubjectMass.value >= 250.0 and
            stadiometer.power.minimumOperatingVoltage <= stadiometer.power.nominalVoltage
        }

        doc /* The stadiometer shall support expected subject loading and enter a safe state if power is insufficient. */
    }

    requirement def ErrorHandlingRequirement {
        subject stadiometer : DigitalStadiometer;

        require constraint {
            stadiometer.processor.currentError != ErrorCode::none implies
            stadiometer.processor.activeState == DeviceState::error
        }

        doc /* The stadiometer shall report an error state when measurement, sensor, calibration, or power faults are detected. */
    }

    satisfy MeasureStandingHeightRequirement by DigitalStadiometer;
    satisfy AccuracyRequirement by DigitalStadiometer;
    satisfy ResolutionRequirement by DigitalStadiometer;
    satisfy ContactForceRequirement by DigitalStadiometer;
    satisfy CalibrationRequirement by DigitalStadiometer;
    satisfy ResultOutputRequirement by DigitalStadiometer;
    satisfy SafetyRequirement by DigitalStadiometer;
    satisfy ErrorHandlingRequirement by DigitalStadiometer;

    part stadiometerSystem : DigitalStadiometer {
        attribute primaryFunction =
            "High-level primary function: determine and communicate a person's standing height using a stable base, vertical reference column, movable headpiece, position sensing, validation logic, display, and data output.";
    }
