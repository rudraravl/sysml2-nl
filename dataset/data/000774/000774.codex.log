    action def InitializeDevice {
        inout processor : MeasurementProcessor;
        out status : StatusMessage;

        first start;
        then checkPower;
        then checkSensors;
        then loadCalibration;
        then setReady;
        then done;

        action checkPower;
        action checkSensors;
        action loadCalibration;
        action setReady {
            processor.activeState = DeviceState::ready;
            processor.currentError = ErrorCode::none;
            status.state = DeviceState::ready;
            status.error = ErrorCode::none;
            status.messageText = "Ready for height measurement";
        }
    }

    action def PositionHeadpieceAction {
        in subject : HumanSubject;
        inout headpiece : SlidingHeadpiece;
        in contactSensor : ContactSensor;
        out positioned : Boolean;

        first releaseLock;
        then lowerHeadpiece;
        then confirmContact;
        then lockHeadpiece;
        then done;

        action releaseLock {
            headpiece.locked = false;
        }

        action lowerHeadpiece;
        action confirmContact {
            positioned =
                subject.postureStable and
                subject.heelsAgainstBase and
                subject.headInFrankfortPlane and
                contactSensor.contactConfirmed;
            headpiece.contactDetected = positioned;
        }

        action lockHeadpiece {
            headpiece.locked = positioned;
        }
    }

    action def MeasureStandingHeight {
        in subject : HumanSubject;
        in sensor : PositionSensor;
        in processor : MeasurementProcessor;
        out measurement : HeightMeasurement;

        first acquirePosition;
        then applyCalibration;
        then calculateConfidence;
        then validateRange;
        then publishMeasurement;
        then done;

        action acquirePosition;
        action applyCalibration;
        action calculateConfidence;
        action validateRange;
        action publishMeasurement {
            measurement.measuredHeight.value =
                sensor.measuredPosition.value + processor.calibrationOffset.value;
            measurement.measuredHeight.unit = "m";
            measurement.measurementTime.unit = "s";
            measurement.mode = MeasurementMode::assisted;
            measurement.valid =
                sensor.healthy and
                subject.postureStable and
                measurement.measuredHeight.value >= 0.60 and
                measurement.measuredHeight.value <= 2.20;
            measurement.confidence.value = if measurement.valid then 98.0 else 0.0;
        }
    }

    action def CalibrateStadiometer {
        in referenceRecord : CalibrationRecord;
        inout processor : MeasurementProcessor;
        out completedRecord : CalibrationRecord;

        first placeReferenceRod;
        then readSensor;
        then computeOffset;
        then verifyTolerance;
        then storeCalibration;
        then done;

        action placeReferenceRod;
        action readSensor;
        action computeOffset {
            completedRecord.referenceHeight = referenceRecord.referenceHeight;
            completedRecord.measuredReferenceHeight = referenceRecord.measuredReferenceHeight;
            completedRecord.error.value =
                referenceRecord.referenceHeight.value -
                referenceRecord.measuredReferenceHeight.value;
            completedRecord.error.unit = "m";
        }

        action verifyTolerance {
            completedRecord.passed = abs(completedRecord.error.value) <= 0.002;
        }

        action storeCalibration {
            processor.calibrationOffset = completedRecord.error;
            processor.calibrationValid = completedRecord.passed;
        }
    }

    state def StadiometerOperationalStateMachine {
        inout processor : MeasurementProcessor;
        in subject : HumanSubject;
        in command : MeasurementCommand;
        in sensor : PositionSensor;
        in contactSensor : ContactSensor;
        in power : PowerSubsystem;

        state poweredOff;
        state initializing;
        state ready;
        state positioningHeadpiece;
        state measuring;
        state validating;
        state displayingResult;
        state calibration;
        state diagnostic;
        state cleaning;
        state error;

        initial then poweredOff;

        transition powerOn
            first poweredOff
            accept command
            if power.powerHealthy
            then initializing;

        transition initialized
            first initializing
            if sensor.healthy and contactSensor.healthy and processor.calibrationValid
            then ready;

        transition initializationFailed
            first initializing
            if not sensor.healthy or not contactSensor.healthy or not processor.calibrationValid
            then error;

        transition startMeasurement
            first ready
            accept command
            if command.requestedMode == MeasurementMode::assisted
            then positioningHeadpiece;

        transition headpiecePositioned
            first positioningHeadpiece
            if contactSensor.contactConfirmed and subject.postureStable
            then measuring;

        transition subjectMoved
            first positioningHeadpiece
            if not subject.postureStable
            then error;

        transition measurementAcquired
            first measuring
            if sensor.healthy
            then validating;

        transition measurementValid
            first validating
            if processor.lastMeasurement.valid
            then displayingResult;

        transition measurementInvalid
            first validating
            if not processor.lastMeasurement.valid
            then error;

        transition resultAcknowledged
            first displayingResult
            accept command
            then ready;

        transition requestCalibration
            first ready
            accept command
            if command.requestedMode == MeasurementMode::calibration
            then calibration;

        transition calibrationComplete
            first calibration
            if processor.calibrationValid
            then ready;

        transition requestDiagnostic
            first ready
            accept command
            if command.requestedMode == MeasurementMode::diagnostic
            then diagnostic;

        transition diagnosticComplete
            first diagnostic
            then ready;

        transition requestCleaning
            first ready
            then cleaning;

        transition cleaningComplete
            first cleaning
            then ready;

        transition recover
            first error
            accept command
            if power.powerHealthy and sensor.healthy and contactSensor.healthy
            then ready;

        transition powerLoss
            first ready
            if not power.powerHealthy
            then poweredOff;
