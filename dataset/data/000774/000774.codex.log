        in item subject : HumanSubject;
    }

    port def OperatorControlPort {
        in item command : MeasurementCommand;
        out item status : StatusMessage;
        out item result : HeightMeasurement;
    }

    port def DataOutputPort {
        out item result : HeightMeasurement;
        out item calibrationRecord : CalibrationRecord;
    }

    port def PowerPort {
        in attribute supplyVoltage : Real;
        in attribute availablePower : Real;
    }

    part def BasePlatform {
        attribute width : LengthValue = (value = 0.45, unit = "m");
        attribute depth : LengthValue = (value = 0.45, unit = "m");
        attribute flatnessTolerance : LengthValue = (value = 0.001, unit = "m");
        attribute maximumSubjectMass : MassValue = (value = 250.0, unit = "kg");

