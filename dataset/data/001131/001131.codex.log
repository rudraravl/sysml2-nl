        connection light_to_optics
            connect lighting.opticalOut to optics.opticalIn;

        connection optics_to_camera
            connect optics.opticalOut to camera.opticalIn;

        connection camera_to_preprocessor
            connect camera.imageOut to preprocessor.imageIn;

        connection preprocessor_to_extractor
            connect preprocessor.imageOut to extractor.imageIn;

        connection extractor_to_classifier
            connect extractor.featureOut to classifier.featureIn;

        connection classifier_to_decision
            connect classifier.decisionOut to decisionManager.decisionIn;

        connection classifier_to_operator
            connect classifier.decisionOut to operatorInterface.decisionIn;

        connection decision_to_reject
            connect decisionManager.commandOut to rejectActuator.commandIn;

        connection operator_to_lighting
            connect operatorInterface.commandOut to lighting.commandIn;

        connection operator_to_camera
            connect operatorInterface.commandOut to camera.commandIn;

        action performPrimaryInspectionFunction {
            in item sceneImage : OpticalImage;
            out item result : InspectionDecision;

            action capture {
                in item sceneImage : OpticalImage;
                out item rawFrame : ImageFrame;
            }

            action preprocess {
                in item rawFrame : ImageFrame;
                out item cleanFrame : ImageFrame;
            }

            action analyze {
                in item cleanFrame : ImageFrame;
                out item features : FeatureVector;
            }

            action decide {
                in item features : FeatureVector;
                out item result : InspectionDecision;
            }

            flow capture.rawFrame to preprocess.rawFrame;
            flow preprocess.cleanFrame to analyze.cleanFrame;
            flow analyze.features to decide.features;
        }

        state inspectionCellState {
            state poweredOff;
            state initializing;
            state ready;
            state inspecting;
            state rejecting;
            state maintenance;
            state fault;

            initial then poweredOff;

            transition power_on
                first poweredOff
                then initializing
                accept ControlCommand
                if command.commandName == "POWER_ON";

            transition initialization_complete
                first initializing
                then ready
                after 2 [s];

            transition begin_inspection
                first ready
                then inspecting
                accept ControlCommand
                if command.commandName == "START_INSPECTION";

            transition inspection_accept
                first inspecting
                then ready
                accept InspectionDecision
                if decision.accepted == true;

            transition inspection_reject
                first inspecting
                then rejecting
                accept InspectionDecision
                if decision.accepted == false;

            transition reject_complete
                first rejecting
                then ready
                after 75 [ms];

            transition ready_to_maintenance
                first ready
                then maintenance
                accept ControlCommand
                if command.commandName == "ENTER_MAINTENANCE";

            transition maintenance_to_ready
                first maintenance
                then ready
                accept ControlCommand
                if command.commandName == "EXIT_MAINTENANCE";

            transition any_fault
                first ready
                then fault
                accept ControlCommand
                if command.commandName == "SYSTEM_FAULT";
        }
    }

    requirement def PrimaryFunctionRequirement {
        doc /* The machine vision inspection system shall acquire optical images of manufactured parts, process the images, classify visible defects, and produce an accept/reject decision for each inspected part. */

        subject system : MachineVisionInspectionCell;

        require constraint {
            system.inspectedPartRate >= 20 [frame/s]
        }

        require constraint {
            system.maximumEndToEndLatency <= 100 [ms]
        }

        require constraint {
            system.minimumDetectionAccuracy >= 99.5 [%]
        }
    }

    requirement def ImageAcquisitionRequirement {
        doc /* The camera subsystem shall capture each inspected part at sufficient resolution and frame rate to support reliable defect detection. */

        subject camera : CameraSensor;

        require constraint {
            camera.sensorWidth >= 4096
        }

        require constraint {
            camera.sensorHeight >= 3000
        }

        require constraint {
            camera.maximumFrameRate >= 60 [frame/s]
        }
    }

    requirement def IlluminationRequirement {
        doc /* The illumination subsystem shall provide stable, uniform lighting over the entire field of view during image exposure. */

        subject lighting : IlluminationSubsystem;

        require constraint {
            lighting.nominalIllumination >= 12000 [lx]
        }

        require constraint {
            lighting.uniformity >= 90 [%]
        }

        require constraint {
            lighting.strobePulseWidth <= 2 [ms]
        }
    }

    requirement def ClassificationRequirement {
        doc /* The classifier shall identify known defect classes and provide a confidence score for every inspection decision. */

        subject classifier : DefectClassifier;

        require constraint {
            classifier.minimumAcceptConfidence >= 0.93
        }

        require constraint {
            classifier.inferenceLatencyLimit <= 20 [ms]
        }

        require constraint {
            classifier.trainedDefectClasses >= 8
        }
    }

    requirement def RejectControlRequirement {
        doc /* The reject actuator shall divert rejected parts within the conveyor timing window without affecting accepted parts. */

        subject actuator : RejectActuator;

        require constraint {
            actuator.actuationDelay <= 75 [ms]
        }

        require constraint {
            actuator.placementAccuracy <= 1 [mm]
        }
    }

    satisfy PrimaryFunctionRequirement by MachineVisionInspectionCell;
    satisfy ImageAcquisitionRequirement by CameraSensor;
    satisfy IlluminationRequirement by IlluminationSubsystem;
    satisfy ClassificationRequirement by DefectClassifier;
    satisfy RejectControlRequirement by RejectActuator;

    part inspectionCell : MachineVisionInspectionCell;

}
