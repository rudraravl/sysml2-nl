            bind measuredHeatFlux = sensingFace.thermalContact.normalHeatFlux;
            bind saturated = measuredHeatFlux > maxHeatFlux or measuredHeatFlux < minHeatFlux;
            bind analogOut.signal.voltage = generatedVoltage;
            bind analogOut.signal.sourceImpedance = sensorResistance;
