        state def UnitOperationalState {
            state off;
            state startup;
            state standby;
            state measuring;
            state calibrating;
            state alarm;
            state fault;

            transition initial then off;

            transition powerApplied
                first off
                accept when powerInput.power.voltage >= 4.5
                then startup;

            transition startupComplete
                first startup
                accept after startupTime
                do initialize
                then standby;

            transition beginContinuousMeasurement
                first standby
                accept when mode == MeasurementMode::continuous
                then measuring;

            transition performMeasurementCycle
                first measuring
                accept after 1.0 / requiredSampleRate
                do acquireMeasurement
                then measuring;

            transition enterCalibration
                first standby
                accept when mode == MeasurementMode::calibration
                then calibrating;

            transition calibrationComplete
                first calibrating
                accept after 5.0
                then standby;

            transition thresholdExceeded
                first measuring
                accept when abs(processor.filteredHeatFlux) >= processor.alarmThreshold
                then alarm;

            transition thresholdCleared
                first alarm
                accept when abs(processor.filteredHeatFlux) < processor.alarmThreshold * 0.95
                then measuring;

            transition signalSaturated
                first measuring
                accept when sensor.saturated or amplifier.saturated or not processor.measurementValid
                then fault;

            transition resetFault
                first fault
                accept when mode == MeasurementMode::standby
                then standby;

            transition powerRemoved
                first standby
                accept when powerInput.power.voltage < 4.0
                then off;
        }

        exhibit state UnitOperationalState;
    }

    requirement def HeatFluxMeasurementRequirement {
        subject unit : HeatFluxSensingUnit;

        require constraint {
            unit.measurementRangeMin <= -20000.0 and
            unit.measurementRangeMax >= 20000.0
        }

        require constraint {
            unit.requiredSampleRate >= 100.0
        }

        require constraint {
            unit.processor.uncertainty <= 50.0
        }
    }

    requirement def HeatFluxSensorUseRequirement {
        subject unit : HeatFluxSensingUnit;

        require constraint {
            unit.sensor.sensitivity > 0.0
        }

        require constraint {
            unit.sensor.activeArea >= 0.00005
        }
    }

    requirement def OutputValidityRequirement {
        subject unit : HeatFluxSensingUnit;

        require constraint {
            unit.heatFluxOutput.measurement.valid implies
            unit.heatFluxOutput.measurement.heatFlux >= unit.measurementRangeMin and
            unit.heatFluxOutput.measurement.heatFlux <= unit.measurementRangeMax
        }
    }

    requirement def PowerRequirement {
        subject unit : HeatFluxSensingUnit;

        require constraint {
            unit.totalPowerConsumption <= 0.25
        }

        require constraint {
            unit.powerInput.power.voltage >= 4.5 and unit.powerInput.power.voltage <= 5.5
        }
    }

    requirement def EnvironmentalRequirement {
        subject unit : HeatFluxSensingUnit;

        require constraint {
            unit.sensor.surfaceTemperature >= unit.operatingTemperatureMin and
            unit.sensor.surfaceTemperature <= unit.operatingTemperatureMax
        }
    }

    requirement def AlarmRequirement {
        subject unit : HeatFluxSensingUnit;

        require constraint {
            abs(unit.processor.filteredHeatFlux) >= unit.processor.alarmThreshold implies
            unit.healthOutput.health == SensorHealthStatus::nominal or
            unit.healthOutput.health == SensorHealthStatus::saturated
        }
    }

    part heatFluxSensingUnit : HeatFluxSensingUnit;

    satisfy HeatFluxMeasurementRequirement by heatFluxSensingUnit;
    satisfy HeatFluxSensorUseRequirement by heatFluxSensingUnit;
    satisfy OutputValidityRequirement by heatFluxSensingUnit;
    satisfy PowerRequirement by heatFluxSensingUnit;
    satisfy EnvironmentalRequirement by heatFluxSensingUnit;
    satisfy AlarmRequirement by heatFluxSensingUnit;
}
