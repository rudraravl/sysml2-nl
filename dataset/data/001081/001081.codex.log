        port analogOut : AnalogOutputPort;

        action amplify {
            in item analogIn.signal;
            out item analogOut.signal;

            bind outputVoltage = analogIn.signal.voltage * gain;
            bind saturated = outputVoltage > maxOutputVoltage or outputVoltage < minOutputVoltage;
            bind analogOut.signal.voltage =
                if outputVoltage > maxOutputVoltage then maxOutputVoltage
                else if outputVoltage < minOutputVoltage then minOutputVoltage
                else outputVoltage;
            bind analogOut.signal.sourceImpedance = 100.0;
            bind analogOut.signal.noiseRms = outputNoiseRms;
