    import SI::*;

    attribute def HeatFlux :> Real {
        unit = "W/m^2";
    }

    attribute def Temperature :> Real {
        unit = "K";
    }

    attribute def Voltage :> Real {
        unit = "V";
    }

    attribute def Current :> Real {
        unit = "A";
    }

    attribute def Resistance :> Real {
        unit = "Ohm";
    }

    attribute def Power :> Real {
        unit = "W";
    }

    attribute def TimeDuration :> Real {
        unit = "s";
    }

    attribute def Frequency :> Real {
        unit = "Hz";
    }

    attribute def DigitalCount :> Integer;

    attribute def Percent :> Real {
        unit = "%";
    }

    attribute def HeatFluxSensitivity :> Real {
        unit = "uV/(W/m^2)";
    }

    attribute def SampleIndex :> Integer;

    item def ThermalContact {
        attribute contactTemperature : Temperature;
        attribute normalHeatFlux : HeatFlux;
        attribute contactPressure : Real {
            unit = "kPa";
        }
    }

    item def AnalogSignal {
        attribute voltage : Voltage;
        attribute sourceImpedance : Resistance;
        attribute noiseRms : Voltage;
    }

    item def DigitalSample {
        attribute sampleIndex : SampleIndex;
        attribute rawCounts : DigitalCount;
        attribute timestamp : TimeDuration;
    }

    item def HeatFluxMeasurement {
        attribute heatFlux : HeatFlux;
        attribute sensorTemperature : Temperature;
        attribute uncertainty : HeatFlux;
        attribute timestamp : TimeDuration;
        attribute valid : Boolean;
    }

    item def ElectricalPower {
        attribute voltage : Voltage;
        attribute current : Current;
        attribute availablePower : Power;
    }

    item def ConfigurationData {
        attribute sensitivity : HeatFluxSensitivity;
        attribute zeroOffsetVoltage : Voltage;
        attribute sampleRate : Frequency;
        attribute averagingWindow : Integer;
        attribute alarmThreshold : HeatFlux;
    }

    port def ThermalSurfacePort {
        in item thermalContact : ThermalContact;
    }

    port def AnalogOutputPort {
        out item signal : AnalogSignal;
    }

    port def AnalogInputPort {
        in item signal : AnalogSignal;
    }

    port def DigitalSamplePort {
        out item sample : DigitalSample;
    }

    port def MeasurementPort {
        out item measurement : HeatFluxMeasurement;
    }

    port def PowerInputPort {
        in item power : ElectricalPower;
    }

    port def ConfigPort {
        in item configuration : ConfigurationData;
    }

    port def StatusPort {
        out item health : SensorHealthStatus;
    }

    enum def SensorHealthStatus {
        nominal;
        warmingUp;
        calibrating;
