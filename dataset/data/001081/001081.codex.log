        attribute zeroOffsetVoltage : Voltage = 0.0;
        attribute amplifierGain : Real = 500.0;
        attribute referenceVoltage : Voltage = 3.3;
        attribute adcFullScaleCounts : DigitalCount = 65535;
        attribute averagingWindow : Integer = 16;
        attribute alarmThreshold : HeatFlux = 15000.0;
        attribute calculatedVoltage : Voltage;
        attribute compensatedSensorVoltage : Voltage;
        attribute calculatedHeatFlux : HeatFlux;
        attribute filteredHeatFlux : HeatFlux;
        attribute uncertainty : HeatFlux = 25.0;
        attribute measurementValid : Boolean = false;
        attribute overThreshold : Boolean = false;

        port digitalIn : DigitalSamplePort;
        port configIn : ConfigPort;
        port measurementOut : MeasurementPort;
        port statusOut : StatusPort;

        action applyConfiguration {
            in item configIn.configuration;

            bind sensitivity = configIn.configuration.sensitivity;
            bind zeroOffsetVoltage = configIn.configuration.zeroOffsetVoltage;
            bind averagingWindow = configIn.configuration.averagingWindow;
            bind alarmThreshold = configIn.configuration.alarmThreshold;
        }

        action computeHeatFlux {
            in item digitalIn.sample;
            out item measurementOut.measurement;

            bind calculatedVoltage = (Real(digitalIn.sample.rawCounts) / Real(adcFullScaleCounts)) * referenceVoltage;
            bind compensatedSensorVoltage = (calculatedVoltage / amplifierGain) - zeroOffsetVoltage;
            bind calculatedHeatFlux = compensatedSensorVoltage / (sensitivity * 0.000001);
            bind filteredHeatFlux = ((filteredHeatFlux * Real(averagingWindow - 1)) + calculatedHeatFlux) / Real(averagingWindow);
            bind measurementValid = digitalIn.sample.rawCounts > 16 and digitalIn.sample.rawCounts < adcFullScaleCounts - 16;
            bind overThreshold = abs(filteredHeatFlux) >= alarmThreshold;
            bind measurementOut.measurement.heatFlux = filteredHeatFlux;
            bind measurementOut.measurement.uncertainty = uncertainty;
            bind measurementOut.measurement.timestamp = digitalIn.sample.timestamp;
            bind measurementOut.measurement.valid = measurementValid;
            bind statusOut.health =
                if not measurementValid then SensorHealthStatus::saturated
                else SensorHealthStatus::nominal;
        }
    }

    part def PowerRegulator {
        attribute inputVoltage : Voltage;
        attribute regulatedVoltage : Voltage = 3.3;
        attribute loadCurrent : Current = 0.045;
        attribute efficiency : Percent = 88.0;
        attribute powerGood : Boolean = false;

        port powerIn : PowerInputPort;
        port sensorPowerOut : PowerInputPort;
        port electronicsPowerOut : PowerInputPort;
        port statusOut : StatusPort;

        action regulate {
            in item powerIn.power;
            out item sensorPowerOut.power;
            out item electronicsPowerOut.power;

