            bind sensorPowerOut.power.voltage = regulatedVoltage;
            bind sensorPowerOut.power.current = 0.005;
            bind sensorPowerOut.power.availablePower = 0.0165;
            bind electronicsPowerOut.power.voltage = regulatedVoltage;
            bind electronicsPowerOut.power.current = loadCurrent;
            bind electronicsPowerOut.power.availablePower = regulatedVoltage * loadCurrent;
            bind statusOut.health =
                if powerGood then SensorHealthStatus::nominal
                else SensorHealthStatus::powerLow;
        }
    }

    part def HeatFluxSensingUnit {
        attribute mode : MeasurementMode = MeasurementMode::standby;
        attribute requiredSampleRate : Frequency = 100.0;
        attribute operatingTemperatureMin : Temperature = 233.15;
        attribute operatingTemperatureMax : Temperature = 358.15;
        attribute measurementRangeMin : HeatFlux = -20000.0;
        attribute measurementRangeMax : HeatFlux = 20000.0;
        attribute totalPowerConsumption : Power = 0.18;
        attribute startupTime : TimeDuration = 2.0;

        port measuredSurface : ThermalSurfacePort;
        port powerInput : PowerInputPort;
        port configurationInput : ConfigPort;
        port heatFluxOutput : MeasurementPort;
        port healthOutput : StatusPort;

        part sensor : HeatFluxSensor {
            sensitivity = 62.0;
        }

        part amplifier : LowNoiseAmplifier {
            gain = 500.0;
        }

        part adc : AnalogToDigitalConverter {
            resolutionBits = 16;
            sampleRate = requiredSampleRate;
        }

        part processor : MeasurementProcessor {
            sensitivity = sensor.sensitivity;
            amplifierGain = amplifier.gain;
            referenceVoltage = adc.referenceVoltage;
        }

        part temperatureSensor : TemperatureSensor;

        part regulator : PowerRegulator;

        connect measuredSurface to sensor.sensingFace;
        connect measuredSurface to temperatureSensor.thermalIn;
        connect sensor.analogOut to amplifier.analogIn;
        connect amplifier.analogOut to adc.analogIn;
        connect adc.digitalOut to processor.digitalIn;
        connect processor.measurementOut to heatFluxOutput;
        connect configurationInput to processor.configIn;
        connect powerInput to regulator.powerIn;
        connect regulator.statusOut to healthOutput;
        connect processor.statusOut to healthOutput;

        action initialize {
            first regulator.regulate;
            then processor.applyConfiguration;
            then assign mode = MeasurementMode::continuous;
        }

        action acquireMeasurement {
            first sensor.sense;
            then amplifier.amplify;
            then adc.sampleAnalogSignal;
            then processor.computeHeatFlux;
        }

        state def UnitOperationalState {
            state off;
            state startup;
            state standby;
            state measuring;
            state calibrating;
            state alarm;
            state fault;

            transition initial then off;

            transition powerApplied
                first off
                accept when powerInput.power.voltage >= 4.5
                then startup;

            transition startupComplete
                first startup
                accept after startupTime
                do initialize
                then standby;

            transition beginContinuousMeasurement
                first standby
                accept when mode == MeasurementMode::continuous
                then measuring;

            transition performMeasurementCycle
                first measuring
                accept after 1.0 / requiredSampleRate
                do acquireMeasurement
                then measuring;

            transition enterCalibration
                first standby
                accept when mode == MeasurementMode::calibration
                then calibrating;

            transition calibrationComplete
                first calibrating
                accept after 5.0
                then standby;

            transition thresholdExceeded
                first measuring
                accept when abs(processor.filteredHeatFlux) >= processor.alarmThreshold
                then alarm;

            transition thresholdCleared
                first alarm
                accept when abs(processor.filteredHeatFlux) < processor.alarmThreshold * 0.95
                then measuring;

            transition signalSaturated
                first measuring
                accept when sensor.saturated or amplifier.saturated or not processor.measurementValid
                then fault;

            transition resetFault
                first fault
                accept when mode == MeasurementMode::standby
                then standby;

            transition powerRemoved
                first standby
                accept when powerInput.power.voltage < 4.0
                then off;
        }

        exhibit state UnitOperationalState;
    }

    requirement def HeatFluxMeasurementRequirement {
        subject unit : HeatFluxSensingUnit;

        require constraint {
            unit.measurementRangeMin <= -20000.0 and
            unit.measurementRangeMax >= 20000.0
        }

        require constraint {
            unit.requiredSampleRate >= 100.0
        }

        require constraint {
            unit.processor.uncertainty <= 50.0
        }
    }

    requirement def HeatFluxSensorUseRequirement {
        subject unit : HeatFluxSensingUnit;

        require constraint {
            unit.sensor.sensitivity > 0.0
        }

        require constraint {
            unit.sensor.activeArea >= 0.00005
        }
    }

    requirement def OutputValidityRequirement {
        subject unit : HeatFluxSensingUnit;

        require constraint {
            unit.heatFluxOutput.measurement.valid implies
            unit.heatFluxOutput.measurement.heatFlux >= unit.measurementRangeMin and
            unit.heatFluxOutput.measurement.heatFlux <= unit.measurementRangeMax
        }
    }

    requirement def PowerRequirement {
        subject unit : HeatFluxSensingUnit;

        require constraint {
            unit.totalPowerConsumption <= 0.25
        }

        require constraint {
            unit.powerInput.power.voltage >= 4.5 and unit.powerInput.power.voltage <= 5.5
        }
    }

    requirement def EnvironmentalRequirement {
        subject unit : HeatFluxSensingUnit;

        require constraint {
            unit.sensor.surfaceTemperature >= unit.operatingTemperatureMin and
            unit.sensor.surfaceTemperature <= unit.operatingTemperatureMax
        }
    }

    requirement def AlarmRequirement {
        subject unit : HeatFluxSensingUnit;

        require constraint {
            abs(unit.processor.filteredHeatFlux) >= unit.processor.alarmThreshold implies
            unit.healthOutput.health == SensorHealthStatus::nominal or
            unit.healthOutput.health == SensorHealthStatus::saturated
        }
    }

    part heatFluxSensingUnit : HeatFluxSensingUnit;

    satisfy HeatFluxMeasurementRequirement by heatFluxSensingUnit;
    satisfy HeatFluxSensorUseRequirement by heatFluxSensingUnit;
    satisfy OutputValidityRequirement by heatFluxSensingUnit;
    satisfy PowerRequirement by heatFluxSensingUnit;
    satisfy EnvironmentalRequirement by heatFluxSensingUnit;
    satisfy AlarmRequirement by heatFluxSensingUnit;
}
