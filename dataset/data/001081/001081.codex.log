        attribute responseTime : TimeDuration = 0.35;
        attribute minHeatFlux : HeatFlux = -20000.0;
        attribute maxHeatFlux : HeatFlux = 20000.0;
        attribute sensorResistance : Resistance = 180.0;
        attribute surfaceTemperature : Temperature;
        attribute measuredHeatFlux : HeatFlux;
        attribute generatedVoltage : Voltage;
        attribute offsetVoltage : Voltage = 0.0;
        attribute saturated : Boolean = false;

        port sensingFace : ThermalSurfacePort;
        port analogOut : AnalogOutputPort;

        action def ConvertHeatFluxToVoltage {
            in flux : HeatFlux;
            in sensitivity : HeatFluxSensitivity;
            in offset : Voltage;
            out voltage : Voltage;

            calc voltage = offset + flux * sensitivity * 0.000001;
        }

        action sense {
            in item sensingFace.thermalContact;
            out item analogOut.signal;

            then ConvertHeatFluxToVoltage(
                flux = sensingFace.thermalContact.normalHeatFlux,
                sensitivity = sensitivity,
                offset = offsetVoltage,
                voltage = generatedVoltage
