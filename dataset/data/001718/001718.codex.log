        connect playback.streamOutput.liveStream to mediaOutput.liveStream;
        connect playback.streamOutput.recordedProgram to mediaOutput.recordedProgram;
        connect frontendStatus.status to ui.statusDisplay.status;
    }

    part def MythTVPersonalVideoRecorderSystem {
        attribute primaryFunction : String =
