        part livingRoomFrontend : MythTVFrontend;
        part remoteFrontend : RemoteFrontend;

        port antennaInput : BroadcastInputPort;
        port programGuideFeed : GuideInputPort;
        port userPlaybackControl : PlaybackControlPort;
        port userRecordingControl : ScheduleCommandPort;
        port displayedMedia : MediaStreamPort;
        port systemStatus : StatusPort;
        port homeNetwork : NetworkPort;

        connect antennaInput.broadcast to backend.broadcastInput.broadcast;
        connect programGuideFeed.guideEntry to backend.guideInput.guideEntry;
        connect userRecordingControl.request to backend.userScheduleInput.request;
        connect userPlaybackControl.command to livingRoomFrontend.frontendControls.command;
        connect userPlaybackControl.selection to livingRoomFrontend.frontendControls.selection;
        connect backend.backendMediaOutput.recordedProgram to livingRoomFrontend.mediaInput.storedProgram;
        connect livingRoomFrontend.mediaOutput.liveStream to displayedMedia.liveStream;
        connect livingRoomFrontend.mediaOutput.recordedProgram to displayedMedia.recordedProgram;
        connect backend.backendStatus.status to systemStatus.status;
        connect homeNetwork.remoteCommand to backend.remoteAccess.remoteCommand;
        connect homeNetwork.remoteSchedule to backend.remoteAccess.remoteSchedule;
        connect backend.remoteAccess.streamOut to homeNetwork.streamOut;
        connect backend.remoteAccess.statusOut to homeNetwork.statusOut;
    }

    action def EndToEndRecordingAndPlayback {
        in item guideEntry : ProgramGuideEntry;
        in item request : RecordingRequest;
        in item broadcast : TelevisionBroadcast;
        in item playbackCommand : PlaybackCommand;
        out item displayedProgram : RecordedProgram;

        action updateGuide;
        action scheduleProgram;
        action tuneBroadcast;
        action captureProgram;
        action storeProgram;
        action retrieveProgram;
        action playProgram;

        flow guideEntry to updateGuide;
        flow updateGuide to scheduleProgram;
        flow request to scheduleProgram;
        flow scheduleProgram to tuneBroadcast;
        flow broadcast to tuneBroadcast;
        flow tuneBroadcast to captureProgram;
        flow captureProgram to storeProgram;
        flow storeProgram to retrieveProgram;
        flow playbackCommand to playProgram;
        flow retrieveProgram to playProgram;
        flow playProgram to displayedProgram;
    }

    requirement def PrimaryFunctionRequirement {
        doc /* The system shall provide a MythTV-based personal video recorder capability that receives television broadcasts, maintains program guide information, records scheduled programs, stores media, and plays live or recorded television through user frontends. */
    }

    requirement def ScheduledRecordingRequirement {
        doc /* The system shall allow a user to schedule a television program for recording from program guide data or manual channel/time selection. */
        require constraint {
            MythTVPersonalVideoRecorderSystem::backend::scheduler::maximumConcurrentRecordings >= 1
        }
    }

    requirement def MultiTunerRequirement {
        doc /* The backend shall support concurrent capture from at least two tuner sources to reduce recording conflicts. */
        require constraint {
            MythTVPersonalVideoRecorderSystem::backend::scheduler::maximumConcurrentRecordings >= 2
        }
    }

    requirement def StorageCapacityRequirement {
        doc /* The media storage subsystem shall provide sufficient capacity for long-term retention of recorded television programs. */
        require constraint {
            MythTVPersonalVideoRecorderSystem::backend::storage::totalCapacity >= 4000 [GByte]
        }
    }

    requirement def LowStorageProtectionRequirement {
        doc /* The storage subsystem shall preserve a minimum amount of free space by expiring eligible old recordings before storage exhaustion. */
        require constraint {
            MythTVPersonalVideoRecorderSystem::backend::storage::minimumFreeCapacity >= 50 [GByte]
        }
    }

    requirement def PlaybackRequirement {
        doc /* The frontend shall support playback control for live and recorded media, including play, pause, stop, and seek commands. */
    }

    requirement def RemoteAccessRequirement {
        doc /* The system shall expose status, scheduling, and streaming functions over a home network for remote frontends. */
    }

    requirement def GuideUpdateRequirement {
        doc /* The electronic program guide shall refresh guide data at least every twenty-four hours. */
        require constraint {
            MythTVPersonalVideoRecorderSystem::backend::guide::updateInterval <= 86400 [s]
        }
    }

    satisfy PrimaryFunctionRequirement by MythTVPersonalVideoRecorderSystem;
    satisfy ScheduledRecordingRequirement by MythTVPersonalVideoRecorderSystem::backend::scheduler;
    satisfy MultiTunerRequirement by MythTVPersonalVideoRecorderSystem::backend;
    satisfy StorageCapacityRequirement by MythTVPersonalVideoRecorderSystem::backend::storage;
    satisfy LowStorageProtectionRequirement by MythTVPersonalVideoRecorderSystem::backend::storage;
    satisfy PlaybackRequirement by MythTVPersonalVideoRecorderSystem::livingRoomFrontend::playback;
    satisfy RemoteAccessRequirement by MythTVPersonalVideoRecorderSystem::remoteFrontend;
    satisfy GuideUpdateRequirement by MythTVPersonalVideoRecorderSystem::backend::guide;
}
