    }

    requirement def TamperDetectionRequirement {
        subject meter : SmartMeter;

        require constraint {
            meter.tamperSensor.coverOpen == false implies meter.diagnostics.alarm.active == false
        }

        doc
        /*
         * The smart meter shall detect and report physical tamper conditions including
         * enclosure opening and magnetic interference.
         */
    }

    requirement def PrimaryFunctionRequirement {
        subject meter : SmartMeter;

        require constraint {
            meter.billingInterval == 900 [SI::second]
        }

        doc
        /*
         * The primary high-level function of the smart meter is to continuously sense
         * electrical service quantities, compute accumulated energy consumption over
         * billing intervals, securely store the readings, and transmit them to the utility
         * for monitoring, billing, and service management.
         */
    }

    satisfy MeasureEnergyRequirement by SmartMeter::primaryMeteringFunction;
    satisfy CommunicationRequirement by SmartMeter::communications;
    satisfy RemoteDisconnectRequirement by SmartMeter::switch;
    satisfy IntervalStorageRequirement by SmartMeter::memory;
    satisfy TamperDetectionRequirement by SmartMeter::tamperSensor;
    satisfy PrimaryFunctionRequirement by SmartMeter::primaryMeteringFunction;
}
