    part def DistributionService {
        port serviceOutput : ACLinePort;
        attribute nominalServiceVoltage : Voltage = 240 [SI::volt];
        attribute nominalFrequency : Frequency = 60 [SI::hertz];
    }

    part def SmartMeter {
        port utilityLine : ACLinePort;
        port premisesLine : ACLinePort;
        port amiNetwork : CommunicationPort;
        port diagnostics : DiagnosticPort;

        attribute identity : MeterIdentifier;
        attribute operatingMode : MeterOperatingMode = MeterOperatingMode::initializing;
        attribute serviceVoltageNominal : Voltage = 240 [SI::volt];
        attribute serviceFrequencyNominal : Frequency = 60 [SI::hertz];
        attribute maximumServiceCurrent : Current = 200 [SI::ampere];
        attribute billingInterval : TimeDuration = 900 [SI::second];

        part voltageSensor : VoltageSensor;
        part currentSensor : CurrentSensor;
        part processor : MeteringProcessor;
        part memory : SecureMemory;
        part communications : CommunicationModule;
        part switch : RemoteServiceSwitch;
        part tamperSensor : TamperSensor;
        part supply : PowerSupply;

        connect utilityLine to switch.lineSide;
        connect switch.loadSide to premisesLine;
        connect utilityLine to supply.acInput;
        connect utilityLine to voltageSensor.measuredLine;
        connect utilityLine to currentSensor.measuredLine;
        connect voltageSensor.measuredLine to processor.measurementIn;
        connect currentSensor.measuredLine to processor.measurementIn;
        connect processor.diagnosticsOut to diagnostics;
        connect tamperSensor.diagnostic to diagnostics;
        connect communications.network to amiNetwork;
        connect amiNetwork.inboundCommand to switch.control.serviceCommand;
        connect processor.measurementIn.measuredReading to communications.network.outboundReading;
        connect diagnostics.alarm to communications.network.outboundAlarm;

        perform action primaryMeteringFunction {
            in item servicePower : LinePower = utilityLine.incomingPower;
            out item billedUsage : EnergyReading = amiNetwork.outboundReading;

            first start;
            then sample : SampleElectricalQuantities {
                in lineInput = servicePower;
            }
            then integrate : ComputeEnergyInterval {
                in sampledInput = sample.sampledOutput;
                in integrationPeriod = billingInterval;
            }
            then persist : StoreReading {
                in readingToStore = integrate.intervalReading;
            }
            then report : TransmitReading {
                in readingToTransmit = integrate.intervalReading;
            }
            then done;

            return billedUsage = integrate.intervalReading;
        }

        state machine smartMeterLifeCycle {
            state installedInactive;
            state initializing;
            state serviceConnected;
            state intervalMetering;
            state communicatingUsage;
            state serviceDisconnected;
            state tamperAlarm;
            state maintenance;
            state terminalFault;

            entry;
            transition install from entry to installedInactive;

            transition energize
                from installedInactive to initializing
                accept utilityLine.incomingPower;

            transition initialized
                from initializing to serviceConnected
                accept after 10 [SI::second];

            transition beginMetering
                from serviceConnected to intervalMetering;

            transition intervalReady
                from intervalMetering to communicatingUsage
                accept after billingInterval
                do primaryMeteringFunction;

            transition reported
                from communicatingUsage to intervalMetering;

            transition remoteDisconnect
                from intervalMetering to serviceDisconnected
                accept amiNetwork.inboundCommand
                if amiNetwork.inboundCommand.commandType == CommandKind::disconnectService;

            transition remoteReconnect
                from serviceDisconnected to serviceConnected
                accept amiNetwork.inboundCommand
                if amiNetwork.inboundCommand.commandType == CommandKind::reconnectService;

            transition tamperDetected
                from intervalMetering to tamperAlarm
                accept diagnostics.alarm
                if diagnostics.alarm.active == true;

            transition tamperCleared
                from tamperAlarm to intervalMetering
                if diagnostics.alarm.active == false;

            transition enterMaintenance
                from intervalMetering to maintenance
                accept amiNetwork.inboundCommand
                if amiNetwork.inboundCommand.commandType == CommandKind::firmwareUpdate;

            transition exitMaintenance
                from maintenance to initializing;

            transition unrecoverableFault
                from intervalMetering to terminalFault;

            transition faultFromAlarm
                from tamperAlarm to terminalFault
                if diagnostics.alarm.severity >= 5;
        }
    }

    part smartMeterDeployment {
        part gridService : DistributionService;
        part meter : SmartMeter;
        part residenceLoad : CustomerLoad;
        part utilityOperations : UtilityHeadEndSystem;

        connect gridService.serviceOutput to meter.utilityLine;
        connect meter.premisesLine to residenceLoad.serviceInput;
        connect meter.amiNetwork to utilityOperations.meterNetwork;
    }

    requirement def MeasureEnergyRequirement {
        subject meter : SmartMeter;

        require constraint {
            meter.primaryMeteringFunction.billedUsage.deliveredEnergy >= 0 [SI::wattHour]
        }

        doc
        /*
         * The smart meter shall measure electrical energy delivered to and received from
         * the customer premises and produce interval readings suitable for billing.
         */
    }

    requirement def CommunicationRequirement {
        subject meter : SmartMeter;

        require constraint {
            meter.communications.nominalUplinkRate >= 9600 [SI::bitPerSecond]
        }

        doc
        /*
         * The smart meter shall communicate validated interval readings and active alarms
         * to the utility head-end system through the advanced metering infrastructure network.
         */
    }

    requirement def RemoteDisconnectRequirement {
        subject meter : SmartMeter;

        require constraint {
            meter.switch.ratedCurrent >= meter.maximumServiceCurrent
        }

        doc
        /*
         * The smart meter shall support authorized remote disconnection and reconnection
         * of customer service using an internal service switch rated for the installed service.
         */
    }

    requirement def IntervalStorageRequirement {
        subject meter : SmartMeter;

        require constraint {
            meter.memory.retainedReadingsCapacity >= 35040
        }

        doc
        /*
         * The smart meter shall retain at least one year of fifteen-minute interval readings
         * in nonvolatile secure storage.
         */
    }

    requirement def TamperDetectionRequirement {
        subject meter : SmartMeter;

        require constraint {
            meter.tamperSensor.coverOpen == false implies meter.diagnostics.alarm.active == false
        }

        doc
        /*
         * The smart meter shall detect and report physical tamper conditions including
         * enclosure opening and magnetic interference.
         */
    }

    requirement def PrimaryFunctionRequirement {
        subject meter : SmartMeter;

        require constraint {
            meter.billingInterval == 900 [SI::second]
        }

        doc
        /*
         * The primary high-level function of the smart meter is to continuously sense
         * electrical service quantities, compute accumulated energy consumption over
         * billing intervals, securely store the readings, and transmit them to the utility
         * for monitoring, billing, and service management.
         */
    }

    satisfy MeasureEnergyRequirement by SmartMeter::primaryMeteringFunction;
    satisfy CommunicationRequirement by SmartMeter::communications;
    satisfy RemoteDisconnectRequirement by SmartMeter::switch;
    satisfy IntervalStorageRequirement by SmartMeter::memory;
    satisfy TamperDetectionRequirement by SmartMeter::tamperSensor;
    satisfy PrimaryFunctionRequirement by SmartMeter::primaryMeteringFunction;
}
