    }

    requirement def RemoteDisconnectRequirement {
        subject meter : SmartMeter;

        require constraint {
            meter.switch.ratedCurrent >= meter.maximumServiceCurrent
        }

        doc
        /*
         * The smart meter shall support authorized remote disconnection and reconnection
         * of customer service using an internal service switch rated for the installed service.
         */
    }

    requirement def IntervalStorageRequirement {
        subject meter : SmartMeter;

        require constraint {
            meter.memory.retainedReadingsCapacity >= 35040
        }

        doc
        /*
         * The smart meter shall retain at least one year of fifteen-minute interval readings
         * in nonvolatile secure storage.
