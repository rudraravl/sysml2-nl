            then decide;
            if enable then supplyThermalEnergy;
            else remainOff;
            then done;

            action supplyThermalEnergy {
                out item producedHeat : ThermalEnergy {
                    :>> heatFlow = ratedPower * dutyCycle / 100;
                    :>> sourceTemperature = maximumSurfaceTemperature;
                }
            }

            action remainOff {
                out item producedHeat : ThermalEnergy {
                    :>> heatFlow = 0 [W];
