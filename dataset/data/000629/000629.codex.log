            in item command : UserCommand;
            in item load : OvenLoad;
            out item conditionedLoad : OvenLoad;
            out item status : OvenStatus;

            first receiveCommand;
            then verifyDoorClosed;
            then preheatChamber;
            then maintainSetpoint;
            then heatLoad;
            then completeCycle;
            then done;

