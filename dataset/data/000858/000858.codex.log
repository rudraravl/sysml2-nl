    }

    part def CheckValve {
        attribute crackingPressure : Pressure = (value = 12.0; unit = "kPa");
        attribute reverseLeakageLimit : FlowRate = (value = 0.02; unit = "L/min");

        port inlet : FluidInletPort;
        port outlet : FluidOutletPort;
    }

    part def ReliefValve {
        attribute setPressure : Pressure = (value = 480.0; unit = "kPa");
        attribute reseatPressure : Pressure = (value = 430.0; unit = "kPa");

        port inlet : FluidInletPort;
        port outlet : FluidOutletPort;
    }

    part def SensorSet {
        port flowTap : FluidOutletPort;
        port pressureTap : FluidOutletPort;
        port temperatureTap : TelemetryOutputPort;
        port telemetryPort : TelemetryOutputPort;

        part flowSensor : FlowSensor;
        part pressureSensor : PressureSensor;
        part temperatureSensor : TemperatureSensor;
        part vibrationSensor : VibrationSensor;
    }

    part def FlowSensor {
        attribute range : FlowRate = (value = 200.0; unit = "L/min");
        attribute accuracyPercentOfReading : Real = 1.0;
    }

    part def PressureSensor {
        attribute range : Pressure = (value = 700.0; unit = "kPa");
        attribute accuracyPercentFullScale : Real = 0.5;
    }

    part def TemperatureSensor {
        attribute rangeMinimum : Temperature = (value = -10.0; unit = "degC");
        attribute rangeMaximum : Temperature = (value = 90.0; unit = "degC");
    }

    part def VibrationSensor {
        attribute alarmThreshold : Real = 7.1;
        attribute unit : String = "mm/s RMS";
    }

    part def PumpController {
        attribute minimumStartLevel : Real = 0.35;
        attribute levelUnit : String = "m";
        attribute lowFlowTripDelay : Real = 10.0;
        attribute delayUnit : String = "s";

        port commandPort : ControlInputPort;
        port motorCommandPort : ControlInputPort;

        perform behavior controlBehavior : PumpControlStateMachine;
    }

    part def LubricationSystem {
        attribute reservoirVolume : Real = 0.75;
        attribute reservoirVolumeUnit : String = "L";
        attribute serviceIntervalHours : Real = 1000.0;

        port lubeOutlet : LubricantPort;
    }

    action def StartPump {
        in attribute requestedSpeed : RotationalSpeed;
        out attribute startAccepted : Boolean;
    }

    action def StopPump {
        out attribute stopped : Boolean;
    }

    action def RegulateSpeed {
        in attribute flowSetpoint : FlowRate;
        in attribute measuredFlow : FlowRate;
        out attribute commandedSpeed : RotationalSpeed;
    }

    action def DetectFaults {
        in attribute measuredPressure : Pressure;
        in attribute measuredFlow : FlowRate;
        in attribute measuredTemperature : Temperature;
        out attribute faultPresent : Boolean;
        out attribute faultCode : String;
    }

    action def MoveFluidByChainBuckets {
        in item inletFluid : WorkingFluid;
        in attribute shaftSpeed : RotationalSpeed;
        out item outletFluid : WorkingFluid;
        out attribute deliveredFlow : FlowRate;
        out attribute developedPressure : Pressure;
    }

    behavior def PumpingOperation {
        in item sourceFluid : WorkingFluid;
        out item deliveredFluid : WorkingFluid;

        action start : StartPump;
        action lift : MoveFluidByChainBuckets;
        action regulate : RegulateSpeed;
        action detect : DetectFaults;

        flow start.startAccepted to lift;
        flow lift.deliveredFlow to regulate.measuredFlow;
        flow lift.developedPressure to detect.measuredPressure;
        flow sourceFluid to lift.inletFluid;
        flow lift.outletFluid to deliveredFluid;
    }

    state def PumpControlStateMachine {
        entry action initialize {
            attribute initialized : Boolean = true;
        }

        state Off;
        state Ready;
        state Priming;
        state Running;
        state LowFlowRecovery;
        state Faulted;
        state MaintenanceLockout;

        initial then Off;

        transition Off_to_Ready
            first Off
            then Ready
            accept ControlSignal
            if command == "ENABLE" and enable == true;

        transition Ready_to_Priming
            first Ready
            then Priming
            accept ControlSignal
            if command == "START";

        transition Priming_to_Running
            first Priming
            then Running
            if true;

        transition Running_to_LowFlowRecovery
            first Running
            then LowFlowRecovery
            accept SensorSignal
            if measuredFlow.value < 80.0 and faultActive == false;

        transition LowFlowRecovery_to_Running
            first LowFlowRecovery
            then Running
            accept SensorSignal
            if measuredFlow.value >= 100.0;

        transition Running_to_Faulted
            first Running
            then Faulted
            accept SensorSignal
            if faultActive == true or measuredPressure.value > 500.0 or measuredTemperature.value > 60.0;

        transition LowFlowRecovery_to_Faulted
            first LowFlowRecovery
            then Faulted
            accept SensorSignal
            if faultActive == true;

        transition Faulted_to_Ready
            first Faulted
            then Ready
            accept ControlSignal
            if command == "RESET" and enable == true;

        transition Ready_to_Off
            first Ready
            then Off
            accept ControlSignal
            if command == "DISABLE" or enable == false;

        transition Running_to_Ready
            first Running
            then Ready
            accept ControlSignal
            if command == "STOP";

        transition Ready_to_MaintenanceLockout
            first Ready
            then MaintenanceLockout
            accept ControlSignal
            if command == "LOCKOUT";

        transition MaintenanceLockout_to_Off
            first MaintenanceLockout
            then Off
            accept ControlSignal
            if command == "UNLOCK";
    }

    requirement def FlowCapacityRequirement {
        subject subsystem : ChainPumpSubsystem;
        require constraint {
            subsystem.outlet.deliveredFlow.value >= 120.0
        }
    }

    requirement def DischargePressureRequirement {
        subject subsystem : ChainPumpSubsystem;
        require constraint {
            subsystem.outlet.dischargePressure.value >= 350.0
        }
    }

    requirement def OverpressureProtectionRequirement {
        subject valve : ReliefValve;
        require constraint {
            valve.setPressure.value <= 480.0
        }
    }

    requirement def ChainSpeedLimitRequirement {
        subject pump : ChainPump;
        require constraint {
            pump.nominalSpeed.value <= pump.maximumSpeed.value
        }
    }

    requirement def SealLeakageRequirement {
        subject seal : ShaftSeal;
        require constraint {
            seal.maximumLeakage.value <= 0.05
        }
    }

    requirement def GuardingRequirement {
        subject guard : GuardAssembly;
        require constraint {
            guard.removableWithToolOnly == true and guard.interlockInstalled == true
        }
    }

    requirement def TemperatureRequirement {
        subject subsystem : ChainPumpSubsystem;
        require constraint {
            subsystem.maximumFluidTemperature.value <= 60.0
        }
    }

    requirement def EfficiencyRequirement {
        subject subsystem : ChainPumpSubsystem;
        require constraint {
            subsystem.nominalEfficiency.value >= 70.0
        }
    }

    requirement def MaintenanceRequirement {
        subject lubrication : LubricationSystem;
        require constraint {
            lubrication.serviceIntervalHours >= 1000.0
        }
    }

    part chainPumpSubsystem : ChainPumpSubsystem;

    satisfy FlowCapacityRequirement by chainPumpSubsystem;
    satisfy DischargePressureRequirement by chainPumpSubsystem;
    satisfy TemperatureRequirement by chainPumpSubsystem;
    satisfy EfficiencyRequirement by chainPumpSubsystem;
    satisfy OverpressureProtectionRequirement by chainPumpSubsystem.pressureReliefValve;
    satisfy ChainSpeedLimitRequirement by chainPumpSubsystem.chainPump;
    satisfy SealLeakageRequirement by chainPumpSubsystem.chainPump.shaftSeal;
    satisfy GuardingRequirement by chainPumpSubsystem.chainGuard;
    satisfy MaintenanceRequirement by chainPumpSubsystem.lubricationSystem;
}
