                then AtPressure
                if nominalPressure <= maximumSafePressure;

            transition AtPressure_to_OverPressure
                first AtPressure
                then OverPressure
                if nominalPressure > maximumSafePressure;

            transition OverPressure_to_Shutdown
                first OverPressure
                then Shutdown
                accept SafetyTrip;

            transition AtPressure_to_Shutdown
                first AtPressure
                then Shutdown
                accept StopCommand;
        }
