        inout item motion : ReciprocatingMotion;
    }

    part def Firebox {
        port fuelIn : FuelInPort;
        port exhaustOut : ExhaustOutPort;

        attribute combustionTemperature : Temperature = 1300 [K];
        attribute thermalOutput : Power;

