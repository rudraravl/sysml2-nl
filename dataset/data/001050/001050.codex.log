        enum upstream;
        enum downstream;
        enum unknown;
    }

    enum def CounterOperatingMode {
        enum initializing;
        enum monitoring;
        enum calibrating;
        enum degraded;
        enum maintenance;
        enum offline;
    }

    enum def SensorHealth {
        enum nominal;
        enum obstructed;
        enum saturated;
        enum failed;
    }

    value type CountValue specializes Natural;
    value type ConfidenceValue specializes Real {
