    attribute temperature : Temperature;
    attribute coolingPower : Power;
    attribute thermalMass : Real;
  }

  part def TemperatureController {
    attribute proportionalGain : Real = 12.0;
    attribute integralGain : Real = 0.4;
    attribute heaterPowerLimit : Power = 2.0e-5 [W];

    action regulateTemperature {
      in measuredTemperature : Temperature;
      in setpoint : Temperature;
      out heaterPower : Power;
    }
  }

  part def VacuumSystem {
    attribute nominalPressure : Pressure = 1.0e-6 [Pa];
    attribute maximumPressure : Pressure = 1.0e-4 [Pa];

    port vacuumInterface : StatusPort;
    port statusOutput : StatusPort;

    part turbomolecularPump : VacuumPump;
    part ionPump : VacuumPump;
    part cryopanel : Cryopanel;
  }

