    attribute baseTemperature : Temperature = 0.010 [K];
    attribute coolingPowerAt100mK : Power = 4.0e-4 [W];
    attribute heliumMixturePressure : Pressure = 85000 [Pa];

    port coldThermalInterface : ThermalPort;
    port commandInput : CommandPort;
    port statusOutput : StatusPort;

    part pulseTubeCooler : PulseTubeCooler;
    part stillStage : CryogenicStage;
    part mixingChamber : CryogenicStage;
    part temperatureController : TemperatureController;

    state def RefrigeratorState {
      state off;
      state cooldown;
      state stableOperation;
      state regeneration;
      state fault;

      initial then off;

      transition off_to_cooldown
        first off
        accept ControlCommand
        if command.acquisitionEnabled == true
        then cooldown;

      transition cooldown_to_stable
        first cooldown
        if mixingChamber.temperature <= 0.015 [K]
        then stableOperation;

      transition stable_to_regeneration
        first stableOperation
        if heliumMixturePressure < 60000 [Pa]
        then regeneration;

      transition any_to_fault
        first stableOperation
        if mixingChamber.temperature > 0.080 [K]
        then fault;
    }
  }

  part def PulseTubeCooler {
    attribute firstStageTemperature : Temperature = 45 [K];
    attribute secondStageTemperature : Temperature = 3.2 [K];
    attribute inputPower : Power = 7200 [W];
  }

