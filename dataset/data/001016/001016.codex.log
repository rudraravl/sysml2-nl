    port cryogenicCommand : CommandPort;
    port biasCommand : CommandPort;
    port calibrationCommand : CommandPort;
    port cryostatStatus : StatusPort;
    port vacuumStatus : StatusPort;
    port electronicsStatus : StatusPort;
    port systemStatus : StatusPort;

    action evaluateHealth {
      in cryostat : HealthStatus;
      in vacuum : HealthStatus;
      in electronics : HealthStatus;
      out system : HealthStatus;
    }

    action issueSafeShutdown {
      out command : ControlCommand;
    }
  }

  action def DetectCryogenicParticleEvents {
    in incomingParticle : ParticleEvent;
    out measuredEvent : DigitizedEvent;

    first start;
    then absorbEnergy;
    then generatePhononsAndCharge;
    then amplifyLowTemperatureSignals;
    then digitizeWaveforms;
    then reconstructAndClassifyEvent;
    then publishValidatedEvent;
    then done;

    action absorbEnergy {
      in particle : ParticleEvent;
      out depositedEnergy : Energy;
    }

    action generatePhononsAndCharge {
      in depositedEnergy : Energy;
      out phonon : PhononSignal;
      out charge : ChargeSignal;
    }

    action amplifyLowTemperatureSignals {
      in phonon : PhononSignal;
      in charge : ChargeSignal;
      out amplifiedPhonon : PhononSignal;
      out amplifiedCharge : ChargeSignal;
    }

    action digitizeWaveforms {
      in amplifiedPhonon : PhononSignal;
      in amplifiedCharge : ChargeSignal;
      out rawEvent : DigitizedEvent;
    }

    action reconstructAndClassifyEvent {
      in rawEvent : DigitizedEvent;
      out measuredEvent : DigitizedEvent;
    }

    action publishValidatedEvent {
      in measuredEvent : DigitizedEvent;
    }
  }

  requirement def PrimaryFunctionRequirement {
    doc /* The cryogenic particle detector system shall maintain an ultra-low-temperature detector array and convert individual particle interactions into validated digital events containing time, energy, and particle classification. */
    subject detector : CryogenicParticleDetector;

    require constraint {
      detector.detectorArray.numberOfDetectorModules >= 64
    }
  }

  requirement def OperatingTemperatureRequirement {
    doc /* The detector array shall operate at or below 15 mK during science acquisition to enable calorimetric measurement of minute particle energy depositions. */
    subject detector : CryogenicParticleDetector;

    require constraint {
      detector.cryostat.baseTemperature <= 0.015 [K]
    }
  }

  requirement def EnergyThresholdRequirement {
    doc /* The system shall detect particle interactions with deposited energy at or above 1.602e-17 J. */
    subject detector : CryogenicParticleDetector;

    require constraint {
      detector.minimumDetectableEnergy <= 1.602e-17 [J]
    }
  }

  requirement def VacuumRequirement {
    doc /* The detector payload shall be maintained below 1.0e-4 Pa to reduce convective heat transfer and contamination of cryogenic surfaces. */
    subject detector : CryogenicParticleDetector;

    require constraint {
      detector.vacuumSystem.maximumPressure <= 1.0e-4 [Pa]
    }
  }

  requirement def MagneticShieldingRequirement {
    doc /* The residual magnetic flux density at the detector array shall not exceed 1.0e-6 T to preserve transition-edge sensor stability. */
    subject detector : CryogenicParticleDetector;

    require constraint {
      detector.magneticShield.residualFieldLimit <= 1.0e-6 [T]
    }
  }

  requirement def EventThroughputRequirement {
    doc /* The acquisition and processing chain shall sustain a validated event throughput of 1000 events per second without data loss. */
    subject detector : CryogenicParticleDetector;

    require constraint {
      detector.maximumEventRate >= 1000 [Hz]
    }
  }

  requirement def SafeShutdownRequirement {
    doc /* The supervisory controller shall disable detector bias and acquisition if the cold stage exceeds 80 mK or the vacuum pressure exceeds 1.0e-4 Pa. */
    subject controller : SupervisoryController;

    require constraint {
      controller.shutdownTemperature == 0.080 [K]
    }

    require constraint {
      controller.shutdownPressure == 1.0e-4 [Pa]
    }
  }

  satisfy PrimaryFunctionRequirement by CryogenicParticleDetector;
  satisfy OperatingTemperatureRequirement by DilutionRefrigerator;
  satisfy EnergyThresholdRequirement by DetectorArray;
  satisfy VacuumRequirement by VacuumSystem;
  satisfy MagneticShieldingRequirement by MagneticShield;
  satisfy EventThroughputRequirement by ReadoutElectronics;
  satisfy SafeShutdownRequirement by SupervisoryController;
}
