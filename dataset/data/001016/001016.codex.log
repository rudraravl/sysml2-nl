  }

  part def ReadoutElectronics {
    attribute samplingFrequency : Frequency = 2.0e6 [Hz];
    attribute adcResolutionBits : Integer = 18;
    attribute inputNoise : Voltage = 2.0e-9 [V];

    port analogInput : AnalogInputPort;
    port commandInput : CommandPort;
    port rawEventOutput : DigitalEventPort;
    port statusOutput : StatusPort;

    part squidAmplifiers[128] : SQUIDAmplifier;
    part analogFilters[128] : AntiAliasFilter;
    part digitizers[128] : Digitizer;

    action digitizeSignals {
      in phonon : PhononSignal;
      in charge : ChargeSignal;
      out rawEvent : DigitizedEvent;
    }
  }

  part def SQUIDAmplifier {
    attribute gain : Real = 5000.0;
    attribute bandwidth : Frequency = 500000 [Hz];
    attribute fluxNoise : Real = 3.0e-6;
  }

  part def AntiAliasFilter {
    attribute cutoffFrequency : Frequency = 250000 [Hz];
    attribute order : Integer = 6;
  }

  part def Digitizer {
    attribute sampleRate : Frequency = 2.0e6 [Hz];
    attribute resolutionBits : Integer = 18;
  }

  part def EventProcessor {
    attribute triggerThreshold : Energy = 1.602e-17 [J];
    attribute pileupRejectionWindow : Time = 0.002 [s];
    attribute classificationConfidenceMinimum : Real = 0.95;

    port rawEventInput : DigitalEventPort;
    port validatedEventOutput : DigitalEventPort;

    action reconstructEnergy {
      in rawEvent : DigitizedEvent;
      out calibratedEnergy : Energy;
    }

    action classifyEvent {
      in rawEvent : DigitizedEvent;
      in calibratedEnergy : Energy;
      out particleKind : ParticleKind;
      out confidence : Real;
    }

    action rejectNoiseAndPileup {
      in rawEvent : DigitizedEvent;
      out valid : Boolean;
    }

    state def ProcessingState {
      state idle;
      state armed;
      state triggered;
      state reconstructing;
      state publishing;

      initial then idle;

      transition idle_to_armed
        first idle
        accept ControlCommand
        if command.acquisitionEnabled == true
        then armed;

      transition armed_to_triggered
        first armed
        accept DigitizedEvent
        if event.reconstructedEnergy >= triggerThreshold
        then triggered;

      transition triggered_to_reconstructing
        first triggered
        then reconstructing;

      transition reconstructing_to_publishing
        first reconstructing
        if classificationConfidenceMinimum <= 0.95
        then publishing;

      transition publishing_to_armed
        first publishing
        then armed;
    }
  }

  part def CalibrationSystem {
    attribute calibrationInterval : Time = 3600 [s];
    attribute referenceXrayEnergy : Energy = 9.72e-16 [J];

    port commandInput : CommandPort;

    part sealedXraySource : CalibrationSource;
    part opticalPulser : OpticalPulser;

    action injectCalibrationEvent {
      out referenceEvent : ParticleEvent;
    }
  }

  part def CalibrationSource {
    attribute isotopeName : String = "Fe-55";
    attribute activity : Real = 37000.0;
    attribute emittedParticleKind : ParticleKind = ParticleKind::xray;
  }

  part def OpticalPulser {
    attribute wavelength : Length = 6.35e-7 [m];
    attribute pulseEnergy : Energy = 1.0e-15 [J];
    attribute repetitionRate : Frequency = 10 [Hz];
  }

