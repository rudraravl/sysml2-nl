    attribute coolingPowerAt100mK : Power = 4.0e-4 [W];
    attribute heliumMixturePressure : Pressure = 85000 [Pa];

    port coldThermalInterface : ThermalPort;
    port commandInput : CommandPort;
    port statusOutput : StatusPort;

    part pulseTubeCooler : PulseTubeCooler;
    part stillStage : CryogenicStage;
    part mixingChamber : CryogenicStage;
    part temperatureController : TemperatureController;

    state def RefrigeratorState {
      state off;
      state cooldown;
      state stableOperation;
      state regeneration;
      state fault;

      initial then off;

      transition off_to_cooldown
        first off
        accept ControlCommand
        if command.acquisitionEnabled == true
        then cooldown;

      transition cooldown_to_stable
        first cooldown
        if mixingChamber.temperature <= 0.015 [K]
        then stableOperation;

      transition stable_to_regeneration
        first stableOperation
        if heliumMixturePressure < 60000 [Pa]
        then regeneration;

      transition any_to_fault
        first stableOperation
        if mixingChamber.temperature > 0.080 [K]
        then fault;
    }
  }

  part def PulseTubeCooler {
    attribute firstStageTemperature : Temperature = 45 [K];
    attribute secondStageTemperature : Temperature = 3.2 [K];
    attribute inputPower : Power = 7200 [W];
  }

  part def CryogenicStage {
    attribute temperature : Temperature;
    attribute coolingPower : Power;
    attribute thermalMass : Real;
  }

  part def TemperatureController {
    attribute proportionalGain : Real = 12.0;
    attribute integralGain : Real = 0.4;
    attribute heaterPowerLimit : Power = 2.0e-5 [W];

    action regulateTemperature {
      in measuredTemperature : Temperature;
      in setpoint : Temperature;
      out heaterPower : Power;
    }
  }

  part def VacuumSystem {
    attribute nominalPressure : Pressure = 1.0e-6 [Pa];
    attribute maximumPressure : Pressure = 1.0e-4 [Pa];

    port vacuumInterface : StatusPort;
    port statusOutput : StatusPort;

    part turbomolecularPump : VacuumPump;
    part ionPump : VacuumPump;
    part cryopanel : Cryopanel;
  }

  part def VacuumPump {
    attribute pumpingSpeed : Real;
    attribute operatingPower : Power;
  }

  part def Cryopanel {
    attribute surfaceTemperature : Temperature = 4 [K];
    attribute sorptionCapacity : Real = 0.15;
  }

  part def MagneticShield {
    attribute residualFieldLimit : MagneticFluxDensity = 1.0e-6 [T];
    attribute shieldingFactor : Real = 100000.0;

    port shieldedVolume : StatusPort;

    part outerMuMetalShield : ShieldLayer;
    part superconductingLeadShield : ShieldLayer;
  }

  part def ShieldLayer {
    attribute thickness : Length;
    attribute attenuationFactor : Real;
  }

  part def ReadoutElectronics {
    attribute samplingFrequency : Frequency = 2.0e6 [Hz];
    attribute adcResolutionBits : Integer = 18;
    attribute inputNoise : Voltage = 2.0e-9 [V];

    port analogInput : AnalogInputPort;
    port commandInput : CommandPort;
    port rawEventOutput : DigitalEventPort;
    port statusOutput : StatusPort;

    part squidAmplifiers[128] : SQUIDAmplifier;
    part analogFilters[128] : AntiAliasFilter;
    part digitizers[128] : Digitizer;

    action digitizeSignals {
      in phonon : PhononSignal;
      in charge : ChargeSignal;
      out rawEvent : DigitizedEvent;
    }
  }

  part def SQUIDAmplifier {
    attribute gain : Real = 5000.0;
    attribute bandwidth : Frequency = 500000 [Hz];
    attribute fluxNoise : Real = 3.0e-6;
  }

  part def AntiAliasFilter {
    attribute cutoffFrequency : Frequency = 250000 [Hz];
    attribute order : Integer = 6;
  }

  part def Digitizer {
    attribute sampleRate : Frequency = 2.0e6 [Hz];
    attribute resolutionBits : Integer = 18;
  }

  part def EventProcessor {
    attribute triggerThreshold : Energy = 1.602e-17 [J];
    attribute pileupRejectionWindow : Time = 0.002 [s];
    attribute classificationConfidenceMinimum : Real = 0.95;

    port rawEventInput : DigitalEventPort;
    port validatedEventOutput : DigitalEventPort;

    action reconstructEnergy {
      in rawEvent : DigitizedEvent;
      out calibratedEnergy : Energy;
    }

    action classifyEvent {
      in rawEvent : DigitizedEvent;
      in calibratedEnergy : Energy;
      out particleKind : ParticleKind;
      out confidence : Real;
    }

    action rejectNoiseAndPileup {
      in rawEvent : DigitizedEvent;
      out valid : Boolean;
    }

    state def ProcessingState {
      state idle;
      state armed;
      state triggered;
      state reconstructing;
      state publishing;

      initial then idle;

      transition idle_to_armed
        first idle
        accept ControlCommand
        if command.acquisitionEnabled == true
        then armed;

      transition armed_to_triggered
        first armed
        accept DigitizedEvent
        if event.reconstructedEnergy >= triggerThreshold
        then triggered;

      transition triggered_to_reconstructing
        first triggered
        then reconstructing;

      transition reconstructing_to_publishing
        first reconstructing
        if classificationConfidenceMinimum <= 0.95
        then publishing;

      transition publishing_to_armed
        first publishing
        then armed;
    }
  }

  part def CalibrationSystem {
    attribute calibrationInterval : Time = 3600 [s];
    attribute referenceXrayEnergy : Energy = 9.72e-16 [J];

    port commandInput : CommandPort;

    part sealedXraySource : CalibrationSource;
    part opticalPulser : OpticalPulser;

    action injectCalibrationEvent {
      out referenceEvent : ParticleEvent;
    }
  }

  part def CalibrationSource {
    attribute isotopeName : String = "Fe-55";
    attribute activity : Real = 37000.0;
    attribute emittedParticleKind : ParticleKind = ParticleKind::xray;
  }

  part def OpticalPulser {
    attribute wavelength : Length = 6.35e-7 [m];
    attribute pulseEnergy : Energy = 1.0e-15 [J];
    attribute repetitionRate : Frequency = 10 [Hz];
  }

  part def SupervisoryController {
    attribute nominalSetpoint : Temperature = 0.015 [K];
    attribute shutdownTemperature : Temperature = 0.080 [K];
    attribute shutdownPressure : Pressure = 1.0e-4 [Pa];

    port commandInput : CommandPort;
    port cryogenicCommand : CommandPort;
    port biasCommand : CommandPort;
    port calibrationCommand : CommandPort;
    port cryostatStatus : StatusPort;
    port vacuumStatus : StatusPort;
    port electronicsStatus : StatusPort;
    port systemStatus : StatusPort;

    action evaluateHealth {
      in cryostat : HealthStatus;
      in vacuum : HealthStatus;
      in electronics : HealthStatus;
      out system : HealthStatus;
    }

    action issueSafeShutdown {
      out command : ControlCommand;
    }
  }

  action def DetectCryogenicParticleEvents {
    in incomingParticle : ParticleEvent;
    out measuredEvent : DigitizedEvent;

    first start;
    then absorbEnergy;
    then generatePhononsAndCharge;
    then amplifyLowTemperatureSignals;
    then digitizeWaveforms;
    then reconstructAndClassifyEvent;
    then publishValidatedEvent;
    then done;

    action absorbEnergy {
      in particle : ParticleEvent;
      out depositedEnergy : Energy;
    }

    action generatePhononsAndCharge {
      in depositedEnergy : Energy;
      out phonon : PhononSignal;
      out charge : ChargeSignal;
    }

    action amplifyLowTemperatureSignals {
      in phonon : PhononSignal;
      in charge : ChargeSignal;
      out amplifiedPhonon : PhononSignal;
      out amplifiedCharge : ChargeSignal;
    }

    action digitizeWaveforms {
      in amplifiedPhonon : PhononSignal;
      in amplifiedCharge : ChargeSignal;
      out rawEvent : DigitizedEvent;
    }

    action reconstructAndClassifyEvent {
      in rawEvent : DigitizedEvent;
      out measuredEvent : DigitizedEvent;
    }

    action publishValidatedEvent {
      in measuredEvent : DigitizedEvent;
    }
  }

  requirement def PrimaryFunctionRequirement {
    doc /* The cryogenic particle detector system shall maintain an ultra-low-temperature detector array and convert individual particle interactions into validated digital events containing time, energy, and particle classification. */
    subject detector : CryogenicParticleDetector;

    require constraint {
      detector.detectorArray.numberOfDetectorModules >= 64
    }
  }

  requirement def OperatingTemperatureRequirement {
    doc /* The detector array shall operate at or below 15 mK during science acquisition to enable calorimetric measurement of minute particle energy depositions. */
    subject detector : CryogenicParticleDetector;

    require constraint {
      detector.cryostat.baseTemperature <= 0.015 [K]
    }
  }

  requirement def EnergyThresholdRequirement {
    doc /* The system shall detect particle interactions with deposited energy at or above 1.602e-17 J. */
    subject detector : CryogenicParticleDetector;

    require constraint {
      detector.minimumDetectableEnergy <= 1.602e-17 [J]
    }
  }

  requirement def VacuumRequirement {
    doc /* The detector payload shall be maintained below 1.0e-4 Pa to reduce convective heat transfer and contamination of cryogenic surfaces. */
    subject detector : CryogenicParticleDetector;

    require constraint {
      detector.vacuumSystem.maximumPressure <= 1.0e-4 [Pa]
    }
  }

  requirement def MagneticShieldingRequirement {
    doc /* The residual magnetic flux density at the detector array shall not exceed 1.0e-6 T to preserve transition-edge sensor stability. */
    subject detector : CryogenicParticleDetector;

    require constraint {
      detector.magneticShield.residualFieldLimit <= 1.0e-6 [T]
    }
  }

  requirement def EventThroughputRequirement {
    doc /* The acquisition and processing chain shall sustain a validated event throughput of 1000 events per second without data loss. */
    subject detector : CryogenicParticleDetector;

    require constraint {
      detector.maximumEventRate >= 1000 [Hz]
    }
  }

  requirement def SafeShutdownRequirement {
    doc /* The supervisory controller shall disable detector bias and acquisition if the cold stage exceeds 80 mK or the vacuum pressure exceeds 1.0e-4 Pa. */
    subject controller : SupervisoryController;

    require constraint {
      controller.shutdownTemperature == 0.080 [K]
    }

    require constraint {
      controller.shutdownPressure == 1.0e-4 [Pa]
    }
  }

  satisfy PrimaryFunctionRequirement by CryogenicParticleDetector;
  satisfy OperatingTemperatureRequirement by DilutionRefrigerator;
  satisfy EnergyThresholdRequirement by DetectorArray;
  satisfy VacuumRequirement by VacuumSystem;
  satisfy MagneticShieldingRequirement by MagneticShield;
  satisfy EventThroughputRequirement by ReadoutElectronics;
  satisfy SafeShutdownRequirement by SupervisoryController;
}
