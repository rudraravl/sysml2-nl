                first Off, Starting, Running
                then Faulted
                accept ControlSignal
                if command.emergencyStop == true;

            transition Faulted_to_Off
                first Faulted
                then Off
                accept ControlSignal
                if command.emergencyStop == false and command.enableCommand == false;
        }
    }

    part def ShaftAssembly {
