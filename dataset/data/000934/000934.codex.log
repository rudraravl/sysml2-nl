        attribute shaftLength : ISQ::length = 0.72 [SI::metre];
        attribute torsionalStiffness : Real;
        attribute allowableRunout : ISQ::length = 0.00025 [SI::metre];

        action def TransmitTorque {
            in item motorRotation : MechanicalRotation;
            out item impellerRotation : MechanicalRotation;

            objective {
                impellerRotation.speed == motorRotation.speed and
                impellerRotation.shaftTorque <= motorRotation.shaftTorque
            }
        }
    }

    part def RushtonImpeller {
        port hubInput : RotationPort;
        port liquidInterface : MixingInterfacePort;

        attribute impellerDiameter : ISQ::length = 0.20 [SI::metre];
