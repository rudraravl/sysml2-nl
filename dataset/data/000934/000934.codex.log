                first Discharging
                then Shutdown
                if vessel.workingVolume <= 5 [SI::litre];

            transition Shutdown_to_Idle
                first Shutdown
                then Idle
                if command.enableCommand == false;

            transition Operational_to_Fault
                first Filling, Mixing, Holding, Discharging
                then Fault
                if command.emergencyStop == true or feedback.vibrationLevel > controller.maximumVibrationLevel;
        }
    }

    requirement def PrimarySystemFunctionRequirement {
        subject mixer : RushtonTurbineMixer;

        doc /* The Rushton turbine mixer shall convert electrical input power into controlled impeller rotation that drives a six-blade radial-flow turbine in a baffled vessel, producing turbulent radial jets and circulation patterns that mix, suspend, and disperse the process liquid at a high level. */

        require constraint {
            mixer.impeller.bladeCount == 6 and
            mixer.impeller.powerNumber >= 4.5 and
            mixer.impeller.powerNumber <= 6.0
        }
    }

    requirement def PrimaryMixingRequirement {
        subject impeller : RushtonImpeller;

        doc /* The Rushton impeller shall generate radial turbulent flow sufficient to increase liquid homogeneity during commanded operation. */

        require constraint {
            impeller.impellerDiameter > 0 [SI::metre] and
            impeller.clearanceFromTankBottom >= 0.5 * impeller.impellerDiameter and
            impeller.clearanceFromTankBottom <= 1.5 * impeller.impellerDiameter
        }
    }

    requirement def DriveConversionRequirement {
        subject drive : ElectricDrive;

        doc /* The electric drive shall provide controlled rotational mechanical power to the turbine shaft over the commanded operating speed range. */

        require constraint {
            drive.ratedPower >= 1000 [SI::watt] and
            drive.efficiency >= 0.80
        }
    }

    requirement def VesselBafflingRequirement {
        subject vessel : MixingVessel;

        doc /* The vessel shall include four vertical baffles to suppress bulk vortex formation and promote axial circulation driven by the radial Rushton turbine discharge. */

        require constraint {
            vessel.baffle1.width == 0.1 * vessel.tankDiameter and
            vessel.baffle2.width == vessel.baffle1.width and
            vessel.baffle3.width == vessel.baffle1.width and
            vessel.baffle4.width == vessel.baffle1.width
        }
    }

    requirement def OperatingSafetyRequirement {
        subject mixer : RushtonTurbineMixer;

        doc /* The mixer shall transition to a fault or stopped condition when emergency stop is commanded, excessive torque is detected, or excessive vibration is detected. */

        require constraint {
            mixer.controller.overloadTorqueLimit <= mixer.drive.maximumTorque and
            mixer.controller.maximumVibrationLevel <= 4.5
        }
    }

    requirement def ProcessPerformanceRequirement {
        subject mixer : RushtonTurbineMixer;

        doc /* The system shall produce a mixed liquid with a homogeneity index of at least 0.90 during normal batch operation at nominal speed. */

        require constraint {
            mixer.controller.nominalCommandedSpeed == 600 [SI::revolutionPerMinute]
        }
    }

    satisfy PrimarySystemFunctionRequirement by RushtonTurbineMixer::PerformPrimaryMixingFunction;
    satisfy PrimaryMixingRequirement by RushtonImpeller::GenerateRadialFlowAndTurbulence;
    satisfy DriveConversionRequirement by ElectricDrive::ConvertElectricalToMechanical;
    satisfy VesselBafflingRequirement by MixingVessel;
    satisfy OperatingSafetyRequirement by RushtonTurbineMixer::MixerLifecycle;
    satisfy ProcessPerformanceRequirement by RushtonTurbineMixer::PerformPrimaryMixingFunction;

    part rushtonTurbineMixingSystem : RushtonTurbineMixer {
        attribute systemName : String = "Baffled Rushton Turbine Mixing System";
        attribute primaryFunction : String = "Convert controlled shaft rotation into turbulent radial flow for high-level liquid mixing, dispersion, and suspension.";
    }
