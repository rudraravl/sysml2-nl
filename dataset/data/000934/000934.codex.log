        in item incomingLiquid : ProcessLiquid;
    }

    port def LiquidOutletPort {
        out item outgoingLiquid : MixedLiquid;
    }

    port def MixingInterfacePort {
        inout item vesselContents : ProcessLiquid;
    }

    part def ElectricDrive {
        port electricalInput : ElectricalPowerPort;
        port controlInterface : ControlPort;
        port shaftOutput : RotationPort;

        attribute ratedPower : power = 1500 [SI::watt];
        attribute ratedSpeed : rotationalSpeed = 1750 [SI::revolutionPerMinute];
        attribute maximumTorque : torque = 12 [SI::newtonMetre];
        attribute efficiency : Real = 0.88;

        action def ConvertElectricalToMechanical {
            in item suppliedPower : ElectricalPower;
            in item speedDemand : ControlSignal;
            out item shaftRotation : MechanicalRotation;

            objective {
                suppliedPower.voltage > 0 [SI::volt] and
                speedDemand.enableCommand == true
            }

            satisfy requirement DriveConversionRequirement;
        }

        state def DriveOperatingState {
            entry action initializeDrive;
            state Off;
            state Starting;
            state Running;
            state Faulted;

