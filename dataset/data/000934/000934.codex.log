                then Accelerating
                if rotation.speed > 0 [SI::revolutionPerMinute];

            transition Accelerating_to_Agitating
                first Accelerating
                then Agitating
                if rotation.speed >= 300 [SI::revolutionPerMinute];

            transition Agitating_to_Coasting
                first Agitating
                then Coasting
                if rotation.speed < 300 [SI::revolutionPerMinute];

            transition Coasting_to_Stationary
                first Coasting
                then Stationary
                if rotation.speed == 0 [SI::revolutionPerMinute];
        }
    }

    part def MixingVessel {
        port liquidFeed : LiquidInletPort;
        port liquidDischarge : LiquidOutletPort;
        port impellerInteraction : MixingInterfacePort;

        attribute workingVolume : ISQ::volume = 250 [SI::litre];
        attribute tankDiameter : ISQ::length = 0.65 [SI::metre];
        attribute liquidHeight : ISQ::length = 0.75 [SI::metre];
        attribute operatingPressure : pressure = 101325 [SI::pascal];
        attribute operatingTemperature : temperature = 298.15 [SI::kelvin];

        part baffle1 : Baffle {
            attribute angularPosition : Real = 0;
        }

        part baffle2 : Baffle {
            attribute angularPosition : Real = 90;
        }

        part baffle3 : Baffle {
            attribute angularPosition : Real = 180;
        }

        part baffle4 : Baffle {
            attribute angularPosition : Real = 270;
        }

        action def ContainAndDirectFlow {
            in item feed : ProcessLiquid;
