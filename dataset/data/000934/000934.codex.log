        attribute height : ISQ::length = 0.70 [SI::metre];
        attribute thickness : ISQ::length = 0.004 [SI::metre];
        attribute angularPosition : Real;
    }

    part def SpeedController {
        port controlOutput : ControlPort;

        attribute minimumCommandedSpeed : rotationalSpeed = 100 [SI::revolutionPerMinute];
        attribute maximumCommandedSpeed : rotationalSpeed = 1200 [SI::revolutionPerMinute];
        attribute nominalCommandedSpeed : rotationalSpeed = 600 [SI::revolutionPerMinute];
        attribute overloadTorqueLimit : torque = 10 [SI::newtonMetre];
        attribute maximumVibrationLevel : Real = 4.5;

        action def RegulateImpellerSpeed {
            in item feedback : SpeedFeedback;
            out item command : ControlSignal;

            objective {
                command.demandedSpeed >= minimumCommandedSpeed and
                command.demandedSpeed <= maximumCommandedSpeed
            }
        }

        state def ControlState {
            state Disabled;
            state SpeedControl;
            state TorqueLimited;
            state EmergencyStopped;

            transition first Disabled;
            transition Disabled_to_SpeedControl
                first Disabled
                then SpeedControl
                if command.enableCommand == true and command.emergencyStop == false;

            transition SpeedControl_to_TorqueLimited
                first SpeedControl
                then TorqueLimited
                if feedback.measuredTorque > overloadTorqueLimit;

            transition TorqueLimited_to_SpeedControl
                first TorqueLimited
                then SpeedControl
                if feedback.measuredTorque <= overloadTorqueLimit;

            transition SpeedControl_to_EmergencyStopped
                first SpeedControl
                then EmergencyStopped
                if command.emergencyStop == true or feedback.vibrationLevel > maximumVibrationLevel;

            transition EmergencyStopped_to_Disabled
                first EmergencyStopped
                then Disabled
                if command.emergencyStop == false and command.enableCommand == false;
        }
    }

    part def RushtonTurbineMixer {
        port electricalSupply : ElectricalPowerPort;
        port processInlet : LiquidInletPort;
        port processOutlet : LiquidOutletPort;
        port operatorControl : ControlPort;

        part drive : ElectricDrive;
        part shaft : ShaftAssembly;
        part impeller : RushtonImpeller;
        part vessel : MixingVessel;
        part controller : SpeedController;

        connect electricalSupply to drive.electricalInput;
        connect operatorControl to controller.controlOutput;
        connect controller.controlOutput to drive.controlInterface;
        connect drive.shaftOutput to shaft.shaftInput;
        connect shaft.impellerDrive to impeller.hubInput;
        connect impeller.liquidInterface to vessel.impellerInteraction;
        connect processInlet to vessel.liquidFeed;
        connect vessel.liquidDischarge to processOutlet;

        action def PerformPrimaryMixingFunction {
            in item unmixedFeed : ProcessLiquid;
            in item electricalEnergy : ElectricalPower;
            in item requestedOperation : ControlSignal;
            out item mixedProduct : MixedLiquid;

            first startDrive;
            then transmitRotation;
            then generateRadialJet;
            then disperseMomentum;
            then dischargeMixedProduct;

            action startDrive : ElectricDrive::ConvertElectricalToMechanical;
            action transmitRotation : ShaftAssembly::TransmitTorque;
            action generateRadialJet : RushtonImpeller::GenerateRadialFlowAndTurbulence;
            action disperseMomentum : MixingVessel::ContainAndDirectFlow;

            action dischargeMixedProduct {
                in item agitatedLiquid : MixedLiquid;
                out item product : MixedLiquid;
                objective {
                    product.homogeneityIndex >= agitatedLiquid.homogeneityIndex
                }
            }

            objective {
                mixedProduct.homogeneityIndex >= 0.90
            }

            satisfy requirement PrimarySystemFunctionRequirement;
        }

        state def MixerLifecycle {
            state Idle;
            state Filling;
            state Mixing;
            state Holding;
            state Discharging;
            state Shutdown;
            state Fault;

            transition first Idle;

            transition Idle_to_Filling
                first Idle
                then Filling
