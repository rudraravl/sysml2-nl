                then Starting
                accept ControlSignal
                if command.enableCommand == true and command.emergencyStop == false;

            transition Starting_to_Running
                first Starting
                then Running
                if feedback.measuredSpeed >= 0.95 * command.demandedSpeed;

            transition Running_to_Off
                first Running
                then Off
                accept ControlSignal
                if command.enableCommand == false;

