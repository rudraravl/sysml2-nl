      attribute referenceMassFlowRate = 0.125;
      attribute measuredMassFlowRate = meter.dataOut.measurement.measuredMassFlowRate;
    }

    assert requirement PressureDropRequirement {
      subject meter = airFlowMeterSystem.meter;
      attribute inletPressure = 101325.0;
      attribute outletPressure = 101300.0;
    }

    assert requirement DiagnosticRequirement {
      subject meter = airFlowMeterSystem.meter;
    }

    assert requirement UpdateRateRequirement {
      subject meter = airFlowMeterSystem.meter;
    }
  }
}
