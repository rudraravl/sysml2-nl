package OptodeMeasurementSystem {

    import ScalarValues::*;
    import ISQ::*;
    import SI::*;

    attribute def Concentration {
        :> scalar;
        unit = "umol/L";
    }

    attribute def LightIntensity {
        :> scalar;
        unit = "mW/cm^2";
    }

    attribute def Wavelength {
        :> scalar;
        unit = "nm";
    }

    attribute def Temperature {
        :> scalar;
        unit = "degC";
    }

    attribute def Voltage {
        :> scalar;
        unit = "V";
    }

    attribute def Current {
        :> scalar;
        unit = "mA";
