        attribute deviceId : String;
        attribute mode : DeviceMode;
        attribute availableLoad : RealPower;
        attribute controllableLoad : RealPower;
        attribute localOverride : Boolean;
        attribute faultPresent : Boolean;
        attribute lastHeartbeat : Time;
    }

    item def ControlCommand {
        attribute targetDeviceId : String;
        attribute requestedMode : DeviceMode;
        attribute powerLimit : RealPower;
        attribute validUntil : Time;
        attribute priority : MessagePriority;
    }

