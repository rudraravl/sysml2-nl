    attribute def VoltageRMS :> ElectricPotential;
    attribute def CurrentRMS :> ElectricCurrent;
    attribute def RealPower :> Power;
    attribute def ApparentPower :> Power;
    attribute def EnergyKWh :> Energy;
    attribute def FrequencyHz :> Frequency;
    attribute def TimeInterval :> Time;
