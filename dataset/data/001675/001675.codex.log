    item def MeterReading {
        attribute timestamp : Time;
        attribute voltage : VoltageRMS;
        attribute current : CurrentRMS;
        attribute realPower : RealPower;
        attribute apparentPower : ApparentPower;
        attribute cumulativeEnergy : EnergyKWh;
        attribute frequency : FrequencyHz;
        attribute qualityPercent : Percent;
    }

    item def PriceSignal {
        attribute effectiveStart : Time;
        attribute effectiveDuration : TimeInterval;
        attribute energyPrice : EnergyPrice;
        attribute criticalPeak : Boolean;
        attribute priority : MessagePriority;
    }

    item def DemandResponseCommand {
        attribute eventId : String;
        attribute eventType : DemandResponseEventType;
        attribute requestedCurtailment : RealPower;
        attribute startTime : Time;
        attribute duration : TimeInterval;
        attribute optOutAllowed : Boolean;
        attribute priority : MessagePriority;
    }

