        attribute subjectId : String;
        attribute commandId : String;
        attribute decision : AuthorizationDecision;
        attribute reason : String;
    }

    item def NetworkHealth {
        attribute linkAvailable : Boolean;
        attribute signalStrength : SignalStrength;
        attribute dataRate : DataRate;
        attribute packetLossPercent : Percent;
        attribute lastSuccessfulExchange : Time;
