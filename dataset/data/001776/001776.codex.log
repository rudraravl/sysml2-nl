        port audioCommandIn : AudioOutputPort;
        port audioOut : AudioOutputPort;
        port diagnosticOut : DiagnosticOutputPort;

        action synthesizeSirenTone {
            in item commandSignal : AudioSignal;
            out item amplifiedSignal : AudioSignal;
        }
    }

    part def SpeakerArray {
        attribute speakerCount : Integer = 2;
        attribute nominalSoundLevelAt3m : DecibelA = 124.0;

