    port def VisualOutputPort {
        out item visual : VisualSignal;
    }

    port def DiagnosticOutputPort {
        out item report : DiagnosticReport;
    }

    part def EmergencyWarningVehicleSystem {
        attribute systemName : String = "Federal Signal Inspired Integrated Emergency Warning System";
        attribute primaryFunction : String =
            "Provide coordinated audible and visible warning from an emergency vehicle so nearby traffic and pedestrians are alerted to the vehicle's presence, direction, and operational priority.";
        attribute nominalVoltage : VoltDC = 12.0;
        attribute minimumOperatingVoltage : VoltDC = 10.5;
