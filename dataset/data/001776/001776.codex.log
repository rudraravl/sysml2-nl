    }

    part def ProtectedPowerModule {
        attribute fuseRating : CurrentValue = 40 [A];
        attribute batteryCapacityReserve : AmpereHour = 18.0;
        attribute lowVoltageCutoff : VoltDC = 10.5;

        port externalPowerIn : PowerInputPort;
        port protectedPowerOut : PowerInputPort;
        port diagnosticOut : DiagnosticOutputPort;

        action distributeProtectedPower {
            in item rawPower : ElectricalPower;
            out item protectedPower : ElectricalPower;
        }
    }

    part def DiagnosticsModule {
        attribute lastFaultCode : String = "NONE";
        attribute faultPresent : Boolean = false;
        attribute reportingInterval : TimeValue = 1 [s];

        port controllerDiagnosticIn : DiagnosticOutputPort;
        port audioDiagnosticIn : DiagnosticOutputPort;
        port visualDiagnosticIn : DiagnosticOutputPort;
        port powerDiagnosticIn : DiagnosticOutputPort;
