        language "SysML v2 textual notation";
        purpose
            /* Describe the high-level function, interfaces, behavior, and requirements of a Federal Signal inspired emergency warning system. */
    }

    view def EmergencyVehicleWarningSystemView {
        viewpoint EmergencyVehicleOperatorViewpoint;
        expose EmergencyWarningVehicleSystem;
        expose PrimaryFunctionRequirement;
        expose AudibleWarningRequirement;
        expose VisualWarningRequirement;
        expose PowerProtectionRequirement;
        expose ResponseTimeRequirement;
        expose DiagnosticRequirement;
    }
}
