        action aggregateHealthStatus {
            in item controllerReport : DiagnosticReport;
            in item audioReport : DiagnosticReport;
            in item visualReport : DiagnosticReport;
            in item powerReport : DiagnosticReport;
            out item systemReport : DiagnosticReport;
        }
    }

    action def CoordinateEmergencyWarning {
        in item operatorCommand : ControlCommand;
        in item vehicleStatus : VehicleStatus;
        in item electricalPower : ElectricalPower;
        out item audioWarning : AudioSignal;
        out item visualWarning : VisualSignal;
        out item diagnosticReport : DiagnosticReport;

        first start;
        then validateCommand;
        then evaluateVehicleContext;
        then selectAudiblePattern;
        then selectVisualPattern;
        then energizeOutputs;
        then monitorHealth;
        then done;

        action validateCommand;
        action evaluateVehicleContext;
        action selectAudiblePattern;
        action selectVisualPattern;
        action energizeOutputs;
        action monitorHealth;
    }

    state def WarningSystemStates {
        entry action initializeSelfTest;

        state standby;
        state normalPatrol;
        state emergencyResponse;
        state intersectionClearance;
        state publicAddress;
        state degradedFault;
        state shutdown;

        transition initial then standby;

        transition standby_to_normal
            first standby
            accept ControlCommand
            if command.requestedMode == AlertModeKind::normal
            then normalPatrol;

        transition normal_to_response
            first normalPatrol
            accept ControlCommand
            if command.requestedMode == AlertModeKind::response
            then emergencyResponse;

        transition response_to_intersection
            first emergencyResponse
            accept VehicleStatus
            if status.speed < 25.0
            then intersectionClearance;

        transition intersection_to_response
            first intersectionClearance
            accept VehicleStatus
            if status.speed >= 25.0
            then emergencyResponse;

        transition any_to_publicAddress
            first standby
            accept ControlCommand
            if command.requestedMode == AlertModeKind::publicAddress
            then publicAddress;

        transition response_to_standby
            first emergencyResponse
            accept ControlCommand
            if command.requestedMode == AlertModeKind::standby
            then standby;

        transition fault_detected
            first emergencyResponse
            accept DiagnosticReport
            if report.faultPresent == true and report.degradedOperationAllowed == true
            then degradedFault;

        transition critical_fault_shutdown
            first degradedFault
            accept DiagnosticReport
            if report.faultPresent == true and report.degradedOperationAllowed == false
            then shutdown;

        state emergencyResponse {
            entry action enableWailOrYelpSiren;
            do action maintainAlternatingWarningLights;
            exit action silenceSirenIfCommanded;
        }

        state intersectionClearance {
            entry action enablePriorityTone;
            do action enableIntersectionSweepLighting;
        }

        state publicAddress {
            entry action muteSirenTone;
            do action amplifyMicrophoneAudio;
        }

        state degradedFault {
            entry action notifyOperatorOfFault;
            do action preserveAvailableWarningChannels;
        }
    }

    requirement def PrimaryFunctionRequirement {
        doc
            /* The system shall provide coordinated audible and visual emergency warning for an authorized emergency vehicle at a high level comparable to Federal Signal Corporation warning products. */
    }

    requirement def AudibleWarningRequirement {
        attribute requiredSoundLevelAt3m : DecibelA = 118.0;
        doc
            /* The system shall emit an audible warning pattern with a sound level of at least 118 dBA at 3 meters during emergency response mode. */
    }

    requirement def VisualWarningRequirement {
        attribute requiredPeakIntensity : Candela = 500.0;
        doc
            /* The system shall emit visible warning flashes with peak luminous intensity of at least 500 cd from roof and auxiliary warning lamps during emergency response mode. */
    }

    requirement def PowerProtectionRequirement {
        attribute minimumVoltage : VoltDC = 10.5;
        doc
            /* The system shall protect warning loads from undervoltage operation by reporting low voltage and disabling nonessential outputs below 10.5 VDC. */
    }

    requirement def ResponseTimeRequirement {
        attribute maximumLatency : Millisecond = 100.0;
        doc
            /* The system shall respond to a valid operator mode command within 100 ms. */
    }

    requirement def DiagnosticRequirement {
        doc
            /* The system shall continuously report controller, power, audio, and visual subsystem health to support operator awareness and maintenance. */
    }

    satisfy PrimaryFunctionRequirement by EmergencyWarningVehicleSystem;
    satisfy AudibleWarningRequirement by SpeakerArray;
    satisfy VisualWarningRequirement by RoofLightbar;
    satisfy VisualWarningRequirement by AuxiliaryWarningLights;
    satisfy PowerProtectionRequirement by ProtectedPowerModule;
    satisfy ResponseTimeRequirement by WarningController;
    satisfy DiagnosticRequirement by DiagnosticsModule;

    concern def PublicSafetyWarningConcern {
        doc
            /* Nearby drivers and pedestrians need rapid recognition that an emergency vehicle is approaching or operating in a hazardous traffic environment. */
    }

    viewpoint def EmergencyVehicleOperatorViewpoint {
        concern PublicSafetyWarningConcern;
        language "SysML v2 textual notation";
        purpose
            /* Describe the high-level function, interfaces, behavior, and requirements of a Federal Signal inspired emergency warning system. */
    }

    view def EmergencyVehicleWarningSystemView {
        viewpoint EmergencyVehicleOperatorViewpoint;
        expose EmergencyWarningVehicleSystem;
        expose PrimaryFunctionRequirement;
        expose AudibleWarningRequirement;
        expose VisualWarningRequirement;
        expose PowerProtectionRequirement;
        expose ResponseTimeRequirement;
        expose DiagnosticRequirement;
    }
