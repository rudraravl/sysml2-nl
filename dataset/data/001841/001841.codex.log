    transition priming then emergencyStopped
      accept ControlSignal
      if command == PumpCommandKind::emergencyStop;

    transition running then emergencyStopped
      accept ControlSignal
      if command == PumpCommandKind::emergencyStop;

    transition regulating then emergencyStopped
      accept ControlSignal
      if command == PumpCommandKind::emergencyStop;

    transition faulted then emergencyStopped
      accept ControlSignal
      if command == PumpCommandKind::emergencyStop;
  }

  requirement def PrimaryFunctionRequirement {
    doc /* The pumping system shall transfer liquid from a low-pressure inlet to a higher-pressure outlet at a controlled flow rate. */
    subject pumpingSystem : PumpingSystem;
    require constraint {
      pumpingSystem.designFlowRate >= 0.025 and
      pumpingSystem.designOutletPressure >= 600000.0
    }
  }

  requirement def FlowControlRequirement {
    doc /* The pumping system shall maintain delivered flow within plus or minus five percent of the commanded flow during normal regulating operation. */
    subject pumpingSystem : PumpingSystem;
    require constraint {
      pumpingSystem.designFlowRate >= 0.02375 and
      pumpingSystem.designFlowRate <= 0.02625
    }
  }

  requirement def PressureSafetyRequirement {
    doc /* The pumping system shall prevent outlet pressure from exceeding the maximum safe pressure by opening a relief path back to the suction side. */
    subject pumpingSystem : PumpingSystem;
    require constraint {
      pumpingSystem.maximumOutletPressure <= 750000.0 and
      pumpingSystem.pressureReliefValve.openingPressure <= 720000.0
    }
  }

  requirement def DryRunProtectionRequirement {
    doc /* The pumping system shall stop pumping and enter a faulted state when inlet pressure indicates insufficient liquid supply. */
    subject pumpingSystem : PumpingSystem;
    require constraint {
      pumpingSystem.minimumInletPressure >= 120000.0
    }
  }

  requirement def ThermalProtectionRequirement {
    doc /* The pumping system shall identify excessive liquid or motor temperature and prevent continued operation outside thermal limits. */
    subject pumpingSystem : PumpingSystem;
    require constraint {
      pumpingSystem.maximumLiquidTemperature <= 353.15 and
      pumpingSystem.pumpAssembly.motor.maximumWindingTemperature <= 403.15
    }
  }

  requirement def EfficiencyRequirement {
    doc /* The pumping system shall convert electrical input power to hydraulic output power with a minimum nominal hydraulic efficiency of seventy-two percent. */
    subject pumpingSystem : PumpingSystem;
    require constraint {
      pumpingSystem.minimumHydraulicEfficiency >= 0.72
    }
  }

  requirement def TelemetryRequirement {
    doc /* The pumping system shall provide flow, inlet pressure, outlet pressure, motor speed, motor current, and fault status telemetry to supervisory equipment. */
    subject pumpingSystem : PumpingSystem;
    require constraint {
      pumpingSystem.controller.controlCycleTimeSeconds <= 0.05
    }
  }

  requirement def BackflowPreventionRequirement {
    doc /* The pumping system shall limit reverse flow from the outlet to the inlet when the pump is stopped. */
    subject pumpingSystem : PumpingSystem;
    require constraint {
      pumpingSystem.checkValve.reverseLeakageLimit <= 0.00002
    }
  }

  requirement def MaintainabilityRequirement {
    doc /* The pumping system shall use a serviceable inlet filter and mechanical seal to support inspection and replacement without replacing the complete pump assembly. */
    subject pumpingSystem : PumpingSystem;
    require constraint {
      pumpingSystem.inletFilter.meshRatingMicrometre <= 250.0 and
      pumpingSystem.pumpAssembly.seal.leakageLimitLitresPerHour <= 0.05
    }
  }

  part pumpingStation : PumpingSystem;

  satisfy PrimaryFunctionRequirement by pumpingStation;
  satisfy FlowControlRequirement by pumpingStation.controller;
  satisfy PressureSafetyRequirement by pumpingStation.pressureReliefValve;
  satisfy DryRunProtectionRequirement by pumpingStation.controller;
  satisfy ThermalProtectionRequirement by pumpingStation.sensorSet;
  satisfy EfficiencyRequirement by pumpingStation.pumpAssembly;
  satisfy TelemetryRequirement by pumpingStation.sensorSet;
  satisfy BackflowPreventionRequirement by pumpingStation.checkValve;
  satisfy MaintainabilityRequirement by pumpingStation.inletFilter;

}
