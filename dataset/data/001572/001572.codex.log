        attribute degreesOfFreedom : Integer = 6;
        attribute reach : Distance = 0.85 [m];
        attribute ratedPayload : Mass = 5 [kg];
        attribute maximumGripForce : Force = 80 [N];
        attribute positioningAccuracy : Distance = 0.005 [m];

