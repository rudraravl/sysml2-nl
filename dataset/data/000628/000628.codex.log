        port patientStatusInput : StatusPort;
        port systemStatusOutput : StatusPort;

        part handPendant : CaregiverHandPendant;
        part motionController : MotionController;
        part safetyInterlockController : SafetyInterlockController;

        action processCaregiverCommand {
            in command : CaregiverCommand;
            out request : MotionRequest;
            first validateCommand;
            then checkSafetyInterlocks;
            then dispatchMotionRequest;
            then publishStatus;
        }
    }

    part def CaregiverHandPendant {
        attribute backrestControlsEnabled : BooleanValue = true;
        attribute heightControlsEnabled : BooleanValue = true;
        attribute cprButtonGuarded : BooleanValue = true;

        port commandOutput : CommandPort;
    }

    part def MotionController {
        attribute closedLoopControlEnabled : BooleanValue = true;
        attribute maximumMotionTime : Time = 30.0;

        action stopAllMotion {
            then removeActuatorPower;
            then commandBrakeHold;
            then reportStopped;
        }
    }

    part def SafetyInterlockController {
        attribute preventsMotionWhenOverloaded : BooleanValue = true;
        attribute preventsHeightMotionWhenBrakeReleased : BooleanValue = true;
        attribute requiresRailLatchConfirmation : BooleanValue = true;

        action evaluateMotionPermission {
            in requestedMotion : MotionRequest;
            out permitted : BooleanValue;
        }
    }

    part def BedPowerSystem {
        attribute mainsConnected : BooleanValue = true;
        attribute batteryBackupAvailable : BooleanValue = true;
        attribute batteryVoltage : ElectricPotential = 24.0;
        attribute batteryCapacityAmpHours : ElectricCurrent = 12.0;

        port supplyInput : PowerPort;
        port controlPowerOutput : PowerPort;
        port actuatorPowerOutput : PowerPort;

        part batteryPack : BatteryPack;
        part powerDistributionUnit : PowerDistributionUnit;
    }

    part def BatteryPack {
        attribute nominalVoltage : ElectricPotential = 24.0;
        attribute reserveOperatingTime : Time = 45.0;
        attribute chargeLevelPercent : ScalarValues::Real = 95.0;
    }

    part def PowerDistributionUnit {
        attribute overCurrentProtected : BooleanValue = true;
        attribute isolationProvided : BooleanValue = true;
        attribute maximumOutputPower : Power = 360.0;
    }

    part def PatientMonitoringSystem {
        attribute weightSensingEnabled : BooleanValue = true;
        attribute bedExitDetectionEnabled : BooleanValue = true;
        attribute overloadDetected : BooleanValue = false;

        port patientStatusOutput : StatusPort;

        part loadCells : LoadCell[4];
        part bedExitSensor : BedExitSensor;
    }

    part def LoadCell {
        attribute measuredLoad : Force = 0.0;
        attribute maximumLoad : Force = 1200.0;
    }

    part def BedExitSensor {
        attribute patientInBed : BooleanValue = false;
        attribute exitAlarmArmed : BooleanValue = true;
    }

    part def AlarmSystem {
        attribute audibleAlarmEnabled : BooleanValue = true;
        attribute visualAlarmEnabled : BooleanValue = true;
        attribute currentAlarmActive : BooleanValue = false;

        port alarmInput : CommandPort;
        port statusInput : StatusPort;
        port alarmOutput : AlarmPort;

        action announceAlarm {
            in status : BedStatus;
            then activateVisualIndicator;
            then soundAudibleAlarm;
            then publishAlarmStatus;
        }

        action silenceAlarm {
            then muteAudibleAlarm;
            then retainVisualIndicatorIfFaultPersists;
        }
    }

    action def SupportAndPositionPatient {
        in patient : Patient;
        in command : CaregiverCommand;
        out status : BedStatus;

        first acceptPatientLoad;
        then monitorPatientPresence;
        then interpretCaregiverCommand;
        then verifySafetyInterlocks;
        then repositionSleepDeckOrHeight;
        then stabilizeBed;
        then reportBedStatus;
    }

    action supportAndPositionPatient : SupportAndPositionPatient;

    state def BedOperation {
        entry action initializeControlSystem;

        state unoccupied;
        state occupiedReady;
        state repositioning;
        state transportLocked;
        state alarmActive;
        state emergencyCPRMode;
        state faulted;

        transition first unoccupied;

        transition unoccupied_to_occupiedReady
            first unoccupied
            accept patientDetected
            then occupiedReady;

        transition occupiedReady_to_repositioning
            first occupiedReady
            accept validMotionCommand
            then repositioning;

        transition repositioning_to_occupiedReady
            first repositioning
            accept targetPositionReached
            then occupiedReady;

        transition occupiedReady_to_transportLocked
            first occupiedReady
            accept brakesReleasedForTransport
            then transportLocked;

        transition transportLocked_to_occupiedReady
            first transportLocked
            accept brakesApplied
            then occupiedReady;

        transition occupiedReady_to_alarmActive
            first occupiedReady
            accept bedExitOrOverloadDetected
            then alarmActive;

        transition alarmActive_to_occupiedReady
            first alarmActive
            accept alarmCleared
            then occupiedReady;

        transition occupiedReady_to_emergencyCPRMode
            first occupiedReady
            accept emergencyCPRCommand
            then emergencyCPRMode;

        transition emergencyCPRMode_to_occupiedReady
            first emergencyCPRMode
            accept cprModeReset
            then occupiedReady;

        transition any_to_faulted
            first occupiedReady
            accept unrecoverableFaultDetected
            then faulted;
    }

    state bedOperation : BedOperation;

    requirement def PrimaryFunctionRequirement {
        doc /* The hospital bed shall support a patient safely and enable caregivers to position the patient and bed height for care, transfer, rest, transport preparation, and emergency access. */
        attribute requiredMaxPatientMass : Mass = 250.0;
        attribute requiredLowTransferHeight : Length = 0.40;
        attribute requiredHighCareHeight : Length = 0.75;
        attribute requiredHeadElevation : Angle = 65.0;

        require constraint {
            requiredMaxPatientMass <= 250.0 and
            requiredLowTransferHeight >= 0.36 and
            requiredHighCareHeight <= 0.78 and
            requiredHeadElevation <= 70.0
        }
    }

    requirement def PatientSupportRequirement {
        doc /* The hospital bed shall continuously support the patient load through the frame, sleep deck, mattress platform, and lift system without exceeding rated static load. */
        attribute requiredRatedStaticLoad : Force = 3200.0;
    }

    requirement def PositioningRequirement {
        doc /* The hospital bed shall articulate the head and knee sections and raise or lower the deck under caregiver command while maintaining controlled motion and status feedback. */
        attribute maximumHeadAngle : Angle = 70.0;
        attribute maximumKneeAngle : Angle = 35.0;
        attribute minimumDeckHeight : Length = 0.36;
        attribute maximumDeckHeight : Length = 0.78;
    }

    requirement def SafetyRequirement {
        doc /* The hospital bed shall inhibit unsafe motion, apply brakes during stationary care, detect patient exit or overload conditions, and provide audible and visual alarm indications. */
        attribute overloadProtectionRequired : BooleanValue = true;
        attribute brakeInterlockRequired : BooleanValue = true;
        attribute alarmRequired : BooleanValue = true;
    }

    requirement def EmergencyCPRRequirement {
        doc /* The hospital bed shall provide an emergency CPR mode that returns the sleep deck to a flat configuration and stops nonessential motion commands. */
        attribute cprHeadAngle : Angle = 0.0;
        attribute cprKneeAngle : Angle = 0.0;
        attribute maximumCPRTransitionTime : Time = 10.0;
    }

    requirement primaryFunction : PrimaryFunctionRequirement;
    requirement patientSupport : PatientSupportRequirement;
    requirement positioning : PositioningRequirement;
    requirement safety : SafetyRequirement;
    requirement emergencyCPR : EmergencyCPRRequirement;

    satisfy primaryFunction by HospitalBed;
    satisfy patientSupport by BedFrame;
    satisfy patientSupport by ArticulatingSleepDeck;
    satisfy positioning by ArticulatingSleepDeck;
    satisfy positioning by HeightLiftSystem;
    satisfy safety by BedControlSystem;
    satisfy safety by CasterBrakeSystem;
    satisfy safety by AlarmSystem;
    satisfy emergencyCPR by BedControlSystem;
    satisfy emergencyCPR by ArticulatingSleepDeck;

}
