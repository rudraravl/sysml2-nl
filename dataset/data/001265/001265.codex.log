            first initializing
            accept after 30 [SI::second]
            then monitoring;

        transition monitoring_to_transmitting
            first monitoring
            accept when telemetryDue
            then transmitting;

        transition transmitting_to_monitoring
            first transmitting
            accept when transmissionAcknowledged
            then monitoring;

