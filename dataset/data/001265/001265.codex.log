        out item stage : StageMeasurement;

        first start;
        then sampleRange;
        then compensateDatum;
        then classifyQuality;
        then done;

        action sampleRange;
        action compensateDatum;
        action classifyQuality;
    }

    action def AcquireVelocity {
        in item water : RiverWater;
        out item velocity : VelocityMeasurement;

        first start;
        then emitAcousticPulse;
        then estimateTransitTime;
        then computeMeanVelocity;
        then validateSignal;
        then done;

        action emitAcousticPulse;
        action estimateTransitTime;
        action computeMeanVelocity;
        action validateSignal;
    }

    action def ComputeDischarge {
        in item stage : StageMeasurement;
        in item velocity : VelocityMeasurement;
        in attribute ratingCurveCoefficientA : ScalarValues::Real;
        in attribute ratingCurveCoefficientB : ScalarValues::Real;
        out item flow : FlowComputation;

        first start;
        then computeCrossSectionArea;
        then applyRatingCurve;
        then reconcileVelocityObservation;
        then assignQuality;
        then done;

        action computeCrossSectionArea;
        action applyRatingCurve;
        action reconcileVelocityObservation;
        action assignQuality;
    }

    action def EvaluateAlerts {
        in item stage : StageMeasurement;
        in item flow : FlowComputation;
        in attribute floodStageThreshold : LengthValue;
        in attribute emergencyStageThreshold : LengthValue;
        out item alert : AlertMessage;

        first start;
        then compareFloodThresholds;
        then setPriority;
        then publishWhenExceeded;
        then done;

        action compareFloodThresholds;
        action setPriority;
        action publishWhenExceeded;
    }

    action def TransmitTelemetry {
        in item telemetry : GaugeTelemetryPacket;
        in item alert : AlertMessage;
        out attribute acknowledged : ScalarValues::Boolean;

        first start;
        then openNetworkSession;
        then sendRoutinePacket;
        then sendAlertIfPresent;
        then confirmReceipt;
        then closeNetworkSession;
        then done;

        action openNetworkSession;
        action sendRoutinePacket;
        action sendAlertIfPresent;
        action confirmReceipt;
        action closeNetworkSession;
    }

    action def ManageEnergy {
        in attribute solarPower : PowerValue;
        in attribute batteryStateOfCharge : PercentValue;
        out attribute regulatedVoltage : VoltageValue;
        out attribute lowPowerModeRequested : ScalarValues::Boolean;

        first start;
        then chargeBatteryWhenAvailable;
        then regulateOutputBus;
        then evaluateLowPowerThreshold;
        then done;

        action chargeBatteryWhenAvailable;
        action regulateOutputBus;
        action evaluateLowPowerThreshold;
    }

    action def MeasureAndReport {
        in item water : RiverWater;
        out item telemetry : GaugeTelemetryPacket;
        out item alert : AlertMessage;

        first start;
        then acquireStage;
        then acquireVelocity;
        then computeDischarge;
        then evaluateAlerts;
        then storeRecord;
        then transmitTelemetry;
        then done;

        action acquireStage : AcquireStage;
        action acquireVelocity : AcquireVelocity;
        action computeDischarge : ComputeDischarge;
        action evaluateAlerts : EvaluateAlerts;
        action storeRecord;
        action transmitTelemetry : TransmitTelemetry;
    }

    state def GaugeOperatingState {
        entry action initializeStation;
        exit action persistShutdownRecord;

        state initializing;
        state monitoring;
        state transmitting;
        state lowPower;
        state alerting;
        state maintenance;
        state faulted;

        initial then initializing;

        transition initializing_to_monitoring
            first initializing
            accept after 30 [SI::second]
            then monitoring;

        transition monitoring_to_transmitting
            first monitoring
            accept when telemetryDue
            then transmitting;

        transition transmitting_to_monitoring
            first transmitting
            accept when transmissionAcknowledged
            then monitoring;

        transition monitoring_to_alerting
            first monitoring
            accept when stageExceedsFloodThreshold
            then alerting;

        transition alerting_to_monitoring
            first alerting
            accept when alertAcknowledged and stageBelowFloodThreshold
            then monitoring;

        transition monitoring_to_lowPower
            first monitoring
            accept when batteryStateOfChargeBelowMinimum
            then lowPower;

        transition lowPower_to_monitoring
            first lowPower
            accept when batteryStateOfChargeRecovered
            then monitoring;

        transition monitoring_to_maintenance
            first monitoring
            accept when maintenanceCommandReceived
            then maintenance;

        transition maintenance_to_monitoring
            first maintenance
            accept when maintenanceComplete
            then monitoring;

        transition any_to_faulted
            first monitoring
            accept when criticalSensorFailure
            then faulted;

        transition faulted_to_maintenance
            first faulted
            accept when technicianResetReceived
            then maintenance;
    }

    requirement def PrimaryFunctionRequirement {
        subject gauge : StreamGaugeSystem;

        require constraint {
            gauge shall continuously measure stream stage, estimate discharge, detect flood threshold exceedance, and communicate time-stamped hydrologic telemetry to remote operators.
        }
    }

    requirement def StageAccuracyRequirement {
        subject sensor : RadarStageSensor;

        require constraint {
            sensor.stageAccuracy <= 0.005 [SI::metre]
        }
    }

    requirement def DischargeReportingRequirement {
        subject gauge : StreamGaugeSystem;

        require constraint {
            gauge.telemetryPeriod <= 900 [SI::second]
        }
    }

    requirement def FloodAlertRequirement {
        subject gauge : StreamGaugeSystem;

        require constraint {
            gauge.floodStageThreshold < gauge.emergencyStageThreshold
        }
    }

    requirement def PowerAutonomyRequirement {
        subject power : SolarBatteryPowerSubsystem;

        require constraint {
            power.batteryStateOfCharge >= power.lowPowerThreshold
        }
    }

    requirement def EnvironmentalProtectionRequirement {
        subject enclosure : WeatherproofEnclosure;

        require constraint {
            enclosure.enclosurePressureEqualized == true
        }
    }

    requirement def LocalRecordRetentionRequirement {
        subject controller : GaugeController;

        require constraint {
            controller.localStorageCapacityDays >= 30
        }
    }

    satisfy PrimaryFunctionRequirement by StreamGaugeSystem;
    satisfy StageAccuracyRequirement by RadarStageSensor;
    satisfy DischargeReportingRequirement by StreamGaugeSystem;
    satisfy FloodAlertRequirement by StreamGaugeSystem;
    satisfy PowerAutonomyRequirement by SolarBatteryPowerSubsystem;
    satisfy EnvironmentalProtectionRequirement by WeatherproofEnclosure;
    satisfy LocalRecordRetentionRequirement by GaugeController;

    part streamGauge : StreamGaugeSystem {
        attribute stationIdentifier = "SG-CH-017";
        attribute samplePeriod = 300 [SI::second];
        attribute telemetryPeriod = 900 [SI::second];
        attribute floodStageThreshold = 4.5 [SI::metre];
        attribute emergencyStageThreshold = 5.7 [SI::metre];
    }

}
