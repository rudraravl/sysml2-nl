            first monitoring
            accept when batteryStateOfChargeBelowMinimum
            then lowPower;

        transition lowPower_to_monitoring
            first lowPower
            accept when batteryStateOfChargeRecovered
            then monitoring;

        transition monitoring_to_maintenance
            first monitoring
            accept when maintenanceCommandReceived
            then maintenance;

        transition maintenance_to_monitoring
            first maintenance
            accept when maintenanceComplete
            then monitoring;

        transition any_to_faulted
            first monitoring
            accept when criticalSensorFailure
            then faulted;

        transition faulted_to_maintenance
            first faulted
            accept when technicianResetReceived
            then maintenance;
