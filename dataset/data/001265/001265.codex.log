        subject gauge : StreamGaugeSystem;

        require constraint {
            gauge.telemetryPeriod <= 900 [SI::second]
        }
    }

    requirement def FloodAlertRequirement {
        subject gauge : StreamGaugeSystem;

        require constraint {
            gauge.floodStageThreshold < gauge.emergencyStageThreshold
        }
    }

    requirement def PowerAutonomyRequirement {
        subject power : SolarBatteryPowerSubsystem;

        require constraint {
            power.batteryStateOfCharge >= power.lowPowerThreshold
        }
    }

    requirement def EnvironmentalProtectionRequirement {
        subject enclosure : WeatherproofEnclosure;

        require constraint {
            enclosure.enclosurePressureEqualized == true
        }
    }

    requirement def LocalRecordRetentionRequirement {
        subject controller : GaugeController;

        require constraint {
            controller.localStorageCapacityDays >= 30
        }
    }

    satisfy PrimaryFunctionRequirement by StreamGaugeSystem;
    satisfy StageAccuracyRequirement by RadarStageSensor;
    satisfy DischargeReportingRequirement by StreamGaugeSystem;
    satisfy FloodAlertRequirement by StreamGaugeSystem;
    satisfy PowerAutonomyRequirement by SolarBatteryPowerSubsystem;
    satisfy EnvironmentalProtectionRequirement by WeatherproofEnclosure;
    satisfy LocalRecordRetentionRequirement by GaugeController;

