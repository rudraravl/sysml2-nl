    connection utilityPowerToObservatories
      connect utilities.observatoryPower to observatories.power;

    connection utilityPowerToCompute
      connect utilities.computePower to compute.power;

    connection utilityCoolingToLabs
      connect utilities.labThermal to labs.thermal;

    connection utilityCoolingToObservatories
      connect utilities.observatoryThermal to observatories.thermal;

    connection utilityCoolingToCompute
      connect utilities.computeThermal to compute.thermal;

    connection labSafetyToContinuity
      connect labs.safety to safety.labSafety;

    connection observatorySafetyToContinuity
      connect observatories.safety to safety.observatorySafety;

    connection continuityToExternalAlert
      connect safety.campusAlert to externalSafetyAlerts;
  }

  requirement def PrimaryFunctionRequirement {
    doc /* The institute system shall produce validated scientific and engineering knowledge while educating researchers. */
    subject system: CaltechResearchAndEducationSystem;

    require constraint {
      system.annualValidatedDiscoveries >= 120
    }
  }

  requirement def ResearchThroughputRequirement {
    subject system: CaltechResearchAndEducationSystem;

    require constraint {
      system.publicationOutputPerYear >= 2500
    }
  }

  requirement def EducationRequirement {
    subject system: CaltechResearchAndEducationSystem;

    require constraint {
      system.annualGraduates >= 450
    }
  }

  requirement def AvailabilityRequirement {
    subject system: CaltechResearchAndEducationSystem;

    require constraint {
      system.campusAvailability >= 99.5
    }
  }

  requirement def DataCapacityRequirement {
    subject system: CaltechResearchAndEducationSystem;

    require constraint {
      system.totalResearchDataPerYear >= 25000
    }
  }

  requirement def ComputeCenterStorageRequirement {
    subject hpc: HighPerformanceComputingCenter;

    require constraint {
      hpc.storageCapacity >= 50000
    }
  }

  requirement def UtilityCapacityRequirement {
    subject plant: CampusUtilityPlant;

    require constraint {
      plant.electricalCapacity >=
        plant.labPower.consumedPower +
        plant.observatoryPower.consumedPower +
        plant.computePower.consumedPower
    }
  }

  requirement def SafetyResponseRequirement {
    subject continuity: SafetyAndContinuitySystem;

    require constraint {
      continuity.responseTimeTarget <= 0.1
    }
  }

  part caltechSystem: CaltechResearchAndEducationSystem {
    attribute annualValidatedDiscoveries = 160;
    attribute annualGraduates = 520;
    attribute publicationOutputPerYear = 3200;
    attribute campusAvailability = 99.92;
    attribute totalResearchDataPerYear = 41000;

    satisfy PrimaryFunctionRequirement by caltechSystem;
    satisfy ResearchThroughputRequirement by caltechSystem;
    satisfy EducationRequirement by caltechSystem;
    satisfy AvailabilityRequirement by caltechSystem;
    satisfy DataCapacityRequirement by caltechSystem;
    satisfy ComputeCenterStorageRequirement by compute;
    satisfy UtilityCapacityRequirement by utilities;
    satisfy SafetyResponseRequirement by safety;
  }
}
