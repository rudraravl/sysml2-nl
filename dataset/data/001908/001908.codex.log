    attribute computeHoursRequired: Duration_hr;
  }

  item def PeerReviewedPublication {
    attribute title: ScalarValues::String;
    attribute doi: ScalarValues::String;
    attribute citationCount: Count;
  }

  item def EducationRecord {
    attribute studentId: ScalarValues::String;
    attribute program: ScalarValues::String;
    attribute completedResearchUnits: Count;
  }

  item def GrantFunding {
    attribute sponsor: ScalarValues::String;
    attribute awardId: ScalarValues::String;
    attribute amountUSD: ScalarValues::Real;
  }

  item def EmergencyAlert {
    attribute alertType: ScalarValues::String;
    attribute severity: ScalarValues::Integer;
    attribute location: ScalarValues::String;
  }

  port def ResearchQuestionPort {
    in item question: ResearchQuestion;
  }

  port def SamplePort {
    in item sampleIn: ExperimentalSample;
    out item sampleOut: ExperimentalSample;
  }

  port def DataPort {
    in item dataIn: ObservationData;
    out item dataOut: ObservationData;
  }

  port def SimulationPort {
    in item modelIn: SimulationModel;
    out item resultData: ObservationData;
  }

  port def PublicationPort {
    out item publication: PeerReviewedPublication;
  }

  port def EducationPort {
    in item studentRecordIn: EducationRecord;
    out item studentRecordOut: EducationRecord;
  }

  port def FundingPort {
    in item grant: GrantFunding;
  }

  port def SafetyPort {
    out item alert: EmergencyAlert;
  }

  port def ElectricalPowerPort {
    in attribute suppliedPower: Power_kW;
    out attribute consumedPower: Power_kW;
  }

  port def ThermalPort {
    in attribute ambientTemperature: Temperature_C;
    out attribute rejectedHeat: Power_kW;
  }

  action def FormResearchProgram {
    in item question: ResearchQuestion;
    in item grant: GrantFunding;
    out item approvedQuestion: ResearchQuestion;
  }

  action def ConductExperiment {
    in item question: ResearchQuestion;
    in item sample: ExperimentalSample;
    out item rawData: ObservationData;
  }

  action def RunComputation {
    in item model: SimulationModel;
    in item rawData: ObservationData;
    out item analyzedData: ObservationData;
  }

  action def ValidateFindings {
    in item analyzedData: ObservationData;
    out item validatedData: ObservationData;
  }

  action def PublishKnowledge {
    in item validatedData: ObservationData;
    out item publication: PeerReviewedPublication;
  }

  action def EducateResearcher {
    in item studentRecordIn: EducationRecord;
    in item validatedData: ObservationData;
    out item studentRecordOut: EducationRecord;
  }

  state def InstituteOperatingState {
    entry action InitializeInfrastructure;
    exit action ArchiveOperationalRecord;

    state AcademicTermActive;
    state ProposalReview;
    state ResearchExecution;
    state DataAnalysis;
    state PublicationAndTransfer;
    state EmergencyResponse;
    state MaintenanceShutdown;

    transition first AcademicTermActive;

