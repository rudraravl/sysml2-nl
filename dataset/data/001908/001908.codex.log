    transition Any_to_EmergencyResponse
      first AcademicTermActive
      then EmergencyResponse;

    transition EmergencyResponse_to_MaintenanceShutdown
      first EmergencyResponse
      then MaintenanceShutdown;

    transition MaintenanceShutdown_to_AcademicTermActive
      first MaintenanceShutdown
      then AcademicTermActive;
  }

