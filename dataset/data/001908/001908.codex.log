    attribute floorArea: Area_m2;
    attribute activeLabs: Count;
    attribute maximumSamples: Count;
    attribute nominalPowerDemand: Power_kW;
    attribute targetTemperature: Temperature_C;

    port samples: SamplePort;
    port researchQuestions: ResearchQuestionPort;
    port data: DataPort;
    port power: ElectricalPowerPort;
    port thermal: ThermalPort;
    port safety: SafetyPort;

    action experiment: ConductExperiment;
  }

  part def ObservatoryNetwork {
    attribute telescopeCount: Count;
    attribute maximumBaseline: Length_m;
    attribute nightlyDataVolume: DataVolume_TB;
    attribute domeTemperatureLimit: Temperature_C;
    attribute nominalPowerDemand: Power_kW;

    port researchQuestions: ResearchQuestionPort;
    port observations: DataPort;
    port power: ElectricalPowerPort;
    port thermal: ThermalPort;
    port safety: SafetyPort;
  }

  part def HighPerformanceComputingCenter {
    attribute computeNodeCount: Count;
    attribute storageCapacity: DataVolume_TB;
    attribute internalNetworkRate: DataRate_Gbps;
    attribute nominalPowerDemand: Power_kW;
    attribute coolingSetPoint: Temperature_C;

    port simulation: SimulationPort;
    port data: DataPort;
    port power: ElectricalPowerPort;
    port thermal: ThermalPort;

    action compute: RunComputation;
  }

  part def AcademicDivision {
    attribute facultyCount: Count;
    attribute graduateStudentCount: Count;
    attribute undergraduateStudentCount: Count;
    attribute annualCourseOfferings: Count;

    port questions: ResearchQuestionPort;
    port education: EducationPort;
    port publications: PublicationPort;

    action trainResearcher: EducateResearcher;
  }

  part def TechnologyTransferOffice {
    attribute activePatents: Count;
    attribute startupLicensesPerYear: Count;

    port publications: PublicationPort;
    port data: DataPort;
  }

  part def SponsoredResearchOffice {
    attribute annualGrantCount: Count;
    attribute annualFundingUSD: ScalarValues::Real;

    port funding: FundingPort;
    port questions: ResearchQuestionPort;

    action approveProgram: FormResearchProgram;
  }

  part def CampusUtilityPlant {
    attribute electricalCapacity: Power_kW;
    attribute coolingCapacity: Power_kW;
    attribute backupEnergyStorage: Energy_J;
    attribute availability: Availability_percent;

    port labPower: ElectricalPowerPort;
    port observatoryPower: ElectricalPowerPort;
    port computePower: ElectricalPowerPort;
    port labThermal: ThermalPort;
    port observatoryThermal: ThermalPort;
    port computeThermal: ThermalPort;
  }

  part def SafetyAndContinuitySystem {
    attribute monitoredZones: Count;
    attribute responseTimeTarget: Duration_hr;
    attribute operationalAvailability: Availability_percent;

    port labSafety: SafetyPort;
    port observatorySafety: SafetyPort;
    port campusAlert: SafetyPort;
  }

  part def CaltechResearchAndEducationSystem {
    doc /* The system's primary high-level function is to generate new scientific and engineering knowledge by combining focused education, frontier research facilities, computation, validation, publication, and technology transfer. */

    attribute annualValidatedDiscoveries: Count;
    attribute annualGraduates: Count;
    attribute publicationOutputPerYear: Count;
    attribute campusAvailability: Availability_percent;
    attribute totalResearchDataPerYear: DataVolume_TB;

    port externalQuestions: ResearchQuestionPort;
    port externalFunding: FundingPort;
    port externalPublications: PublicationPort;
    port externalEducation: EducationPort;
    port externalSafetyAlerts: SafetyPort;

    part labs: LaboratoryComplex {
      attribute floorArea = 85000;
      attribute activeLabs = 320;
      attribute maximumSamples = 200000;
      attribute nominalPowerDemand = 18000;
      attribute targetTemperature = 21;
    }

    part observatories: ObservatoryNetwork {
      attribute telescopeCount = 6;
      attribute maximumBaseline = 1200;
      attribute nightlyDataVolume = 95;
      attribute domeTemperatureLimit = 5;
      attribute nominalPowerDemand = 4200;
    }

    part compute: HighPerformanceComputingCenter {
      attribute computeNodeCount = 18000;
      attribute storageCapacity = 62000;
      attribute internalNetworkRate = 800;
      attribute nominalPowerDemand = 26000;
      attribute coolingSetPoint = 24;
    }

    part academics: AcademicDivision {
      attribute facultyCount = 310;
      attribute graduateStudentCount = 1500;
      attribute undergraduateStudentCount = 1050;
      attribute annualCourseOfferings = 780;
    }

    part sponsoredResearch: SponsoredResearchOffice {
      attribute annualGrantCount = 1450;
      attribute annualFundingUSD = 520000000;
    }

    part transferOffice: TechnologyTransferOffice {
      attribute activePatents = 900;
      attribute startupLicensesPerYear = 25;
    }

    part utilities: CampusUtilityPlant {
      attribute electricalCapacity = 65000;
      attribute coolingCapacity = 44000;
      attribute backupEnergyStorage = 190000000000;
      attribute availability = 99.95;
    }

    part safety: SafetyAndContinuitySystem {
      attribute monitoredZones = 540;
      attribute responseTimeTarget = 0.08;
      attribute operationalAvailability = 99.99;
    }

    perform action formProgram: FormResearchProgram;
    perform action labExperiment: ConductExperiment;
    perform action computationalAnalysis: RunComputation;
    perform action validate: ValidateFindings;
    perform action publish: PublishKnowledge;
    perform action educate: EducateResearcher;

    exhibit state operations: InstituteOperatingState;

    connection fundingToSponsoredResearch
      connect externalFunding to sponsoredResearch.funding;

    connection sponsoredQuestionsToAcademicDivision
      connect sponsoredResearch.questions to academics.questions;

    connection academicQuestionsToLabs
      connect academics.questions to labs.researchQuestions;

    connection academicQuestionsToObservatories
      connect academics.questions to observatories.researchQuestions;

    connection labDataToCompute
      connect labs.data to compute.data;

    connection observatoryDataToCompute
      connect observatories.observations to compute.data;

    connection computeResultsToAcademics
      connect compute.data to academics.publications;

    connection academicPublicationsToTransfer
      connect academics.publications to transferOffice.publications;

    connection transferPublicationsToExternal
      connect transferOffice.publications to externalPublications;

    connection academicEducationToExternal
      connect academics.education to externalEducation;

    connection utilityPowerToLabs
      connect utilities.labPower to labs.power;

    connection utilityPowerToObservatories
      connect utilities.observatoryPower to observatories.power;

    connection utilityPowerToCompute
      connect utilities.computePower to compute.power;

    connection utilityCoolingToLabs
      connect utilities.labThermal to labs.thermal;

    connection utilityCoolingToObservatories
      connect utilities.observatoryThermal to observatories.thermal;

    connection utilityCoolingToCompute
      connect utilities.computeThermal to compute.thermal;

    connection labSafetyToContinuity
      connect labs.safety to safety.labSafety;

    connection observatorySafetyToContinuity
      connect observatories.safety to safety.observatorySafety;

    connection continuityToExternalAlert
      connect safety.campusAlert to externalSafetyAlerts;
  }

  requirement def PrimaryFunctionRequirement {
    doc /* The institute system shall produce validated scientific and engineering knowledge while educating researchers. */
    subject system: CaltechResearchAndEducationSystem;

    require constraint {
      system.annualValidatedDiscoveries >= 120
    }
  }

  requirement def ResearchThroughputRequirement {
    subject system: CaltechResearchAndEducationSystem;

    require constraint {
      system.publicationOutputPerYear >= 2500
    }
  }

  requirement def EducationRequirement {
    subject system: CaltechResearchAndEducationSystem;

    require constraint {
      system.annualGraduates >= 450
    }
  }

  requirement def AvailabilityRequirement {
    subject system: CaltechResearchAndEducationSystem;

    require constraint {
      system.campusAvailability >= 99.5
    }
  }

  requirement def DataCapacityRequirement {
    subject system: CaltechResearchAndEducationSystem;

    require constraint {
      system.totalResearchDataPerYear >= 25000
    }
  }

  requirement def ComputeCenterStorageRequirement {
    subject hpc: HighPerformanceComputingCenter;

    require constraint {
      hpc.storageCapacity >= 50000
    }
  }

  requirement def UtilityCapacityRequirement {
    subject plant: CampusUtilityPlant;

    require constraint {
      plant.electricalCapacity >=
        plant.labPower.consumedPower +
        plant.observatoryPower.consumedPower +
        plant.computePower.consumedPower
    }
  }

  requirement def SafetyResponseRequirement {
    subject continuity: SafetyAndContinuitySystem;

    require constraint {
      continuity.responseTimeTarget <= 0.1
    }
  }

  part caltechSystem: CaltechResearchAndEducationSystem {
    attribute annualValidatedDiscoveries = 160;
    attribute annualGraduates = 520;
    attribute publicationOutputPerYear = 3200;
    attribute campusAvailability = 99.92;
    attribute totalResearchDataPerYear = 41000;

    satisfy PrimaryFunctionRequirement by caltechSystem;
    satisfy ResearchThroughputRequirement by caltechSystem;
    satisfy EducationRequirement by caltechSystem;
    satisfy AvailabilityRequirement by caltechSystem;
    satisfy DataCapacityRequirement by caltechSystem;
    satisfy ComputeCenterStorageRequirement by compute;
    satisfy UtilityCapacityRequirement by utilities;
    satisfy SafetyResponseRequirement by safety;
  }
}
