    part def PhaseProcessor {
        attribute phaseAlgorithm : String = "four-step phase shifting with spatial unwrap";
        attribute minimumFringeContrast : Ratio = 0.25;
        attribute unwrapReliabilityThreshold : Ratio = 0.85;
        attribute processingLatency : Time = 0.25 [s];

        port imageIn : ImageInputPort;
        port calibration : CalibrationPort;
        port phaseOut : PhaseOutputPort;

        action def ComputePhaseMap {
            in frame0 : FringeImage;
            in frame1 : FringeImage;
            in frame2 : FringeImage;
            in frame3 : FringeImage;
            out phase : PhaseMap;

            first normalizeIllumination;
            then computeWrappedPhase;
            then maskLowContrastPixels;
            then unwrapPhase;
            then publishPhase;

            action normalizeIllumination;
            action computeWrappedPhase;
            action maskLowContrastPixels;
            action unwrapPhase;
            action publishPhase;
        }
    }

    part def DeflectionSolver {
        attribute slopeSensitivity : Angle = 1.0 [urad];
        attribute maximumMeasurableDeflection : Angle = 3 [deg];
        attribute spatialResolution : Length = 0.25 [mm];

        port phaseIn : PhaseInputPort;
        port calibration : CalibrationPort;
        port deflectionOut : DeflectionOutputPort;

        action def ConvertPhaseToDeflection {
            in phase : PhaseMap;
            in calibration : CalibrationData;
            out field : DeflectionField;

            first applyGeometricScale;
            then computeXSlope;
            then computeYSlope;
            then estimateUncertainty;
            then publishDeflectionField;

            action applyGeometricScale;
            action computeXSlope;
            action computeYSlope;
            action estimateUncertainty;
            action publishDeflectionField;
        }
    }

    part def SurfaceReconstructionProcessor {
        attribute integrationMethod : String = "regularized least squares slope integration";
        attribute lowFrequencyConstraintEnabled : Boolean = true;
        attribute maximumRmsResidual : Length = 30 [nm];

        port deflectionIn : DeflectionInputPort;
        port profileOut : ProfileOutputPort;

        action def ReconstructSurfaceProfile {
            in field : DeflectionField;
            out profile : SurfaceProfile;

            first removeGlobalTilt;
            then integrateDeflectionSlopes;
            then enforceBoundaryCondition;
            then computeSurfaceMetrics;
            then publishSurfaceProfile;

            action removeGlobalTilt;
            action integrateDeflectionSlopes;
            action enforceBoundaryCondition;
            action computeSurfaceMetrics;
            action publishSurfaceProfile;
        }
    }

    part def MeasurementSupervisor {
        attribute nominalMeasurementCycleTime : Time = 3 [s];
        attribute framesPerMeasurement : Integer = 4;
        attribute automaticRecalibrationEnabled : Boolean = true;

        port commandOut : CommandInputPort;
        port profileIn : ProfileInputPort;
        port reportOut : ReportOutputPort;

        action def ExecuteMoireDeflectometryMeasurement {
            out report : MeasurementReport;

            first initializeOptics;
            then acquirePhaseShiftedFringeSet;
            then computeOpticalDeflection;
            then reconstructMeasuredSurface;
            then assessAgainstLimits;
            then publishMeasurementReport;

            action initializeOptics;
            action acquirePhaseShiftedFringeSet;
            action computeOpticalDeflection;
            action reconstructMeasuredSurface;
            action assessAgainstLimits;
            action publishMeasurementReport;
        }

        state def MeasurementStateMachine {
            state Standby;
            state Calibrating;
            state Acquiring;
            state Processing;
            state Reporting;
            state FaultRecovery;

            initial then Standby;

            transition Standby_to_Calibrating
                first Standby
                if automaticRecalibrationEnabled
                then Calibrating;

            transition Calibrating_to_Acquiring
                first Calibrating
                then Acquiring;

            transition Standby_to_Acquiring
                first Standby
                accept command : ControlCommand
                then Acquiring;

            transition Acquiring_to_Processing
                first Acquiring
                if framesPerMeasurement == 4
                then Processing;

            transition Processing_to_Reporting
                first Processing
                then Reporting;

            transition Reporting_to_Standby
                first Reporting
                then Standby;

            transition Acquiring_to_FaultRecovery
                first Acquiring
                if acquisitionInvalid
                then FaultRecovery;

            transition FaultRecovery_to_Standby
                first FaultRecovery
                then Standby;
        }

        attribute acquisitionInvalid : Boolean;
    }

    part def DataArchive {
        attribute storageCapacity : Real = 2.0;
        attribute sustainedWriteRate : DataRate = 250 [MB_per_s];
        attribute retentionTime : Time = 365 [d];

        port imageIn : ImageInputPort;
        port phaseIn : PhaseInputPort;
        port deflectionIn : DeflectionInputPort;
        port profileIn : ProfileInputPort;
        port reportIn : ReportOutputPort;
    }

    part def MoireDeflectometer {
        attribute primaryFunction : String =
            "Measure optical wavefront or reflective surface slope by observing moire fringe displacement produced by two precision gratings, converting phase shifts into angular deflection fields, and reconstructing high-resolution surface profile errors.";

        attribute fieldOfViewDiameter : Length = 100 [mm];
        attribute targetSlopeResolution : Angle = 2 [urad];
        attribute targetHeightResolution : Length = 20 [nm];
        attribute measurementCycleTime : Time = 3 [s];
        attribute operatingTemperatureMin : Temperature = 18 [degC];
        attribute operatingTemperatureMax : Temperature = 24 [degC];

        port powerIn : PowerInputPort;
        port reportOut : ReportOutputPort;

        part bench : StableOpticalBench;
        part illumination : IlluminationModule;
        part sourceGrating : SourceGratingAssembly;
        part surfaceFixture : TestSurfaceFixture;
        part analyzerGrating : AnalyzerGratingAssembly;
        part camera : ImagingCamera;
        part calibrationController : CalibrationController;
        part phaseProcessor : PhaseProcessor;
        part deflectionSolver : DeflectionSolver;
        part reconstructionProcessor : SurfaceReconstructionProcessor;
        part supervisor : MeasurementSupervisor;
        part archive : DataArchive;

        connect powerIn to bench.powerIn;
        connect powerIn to illumination.powerIn;
        connect powerIn to camera.powerIn;

        connect illumination.opticalOut to sourceGrating.opticalIn;
        connect sourceGrating.opticalOut to surfaceFixture.opticalIn;
        connect surfaceFixture.opticalOut to analyzerGrating.opticalIn;
        connect analyzerGrating.opticalOut to camera.opticalIn;

        connect supervisor.commandOut to illumination.commandIn;
        connect supervisor.commandOut to analyzerGrating.commandIn;
        connect supervisor.commandOut to camera.commandIn;

        connect camera.imageOut to phaseProcessor.imageIn;
        connect camera.imageOut to archive.imageIn;

        connect calibrationController.calibration to sourceGrating.calibration;
        connect calibrationController.calibration to analyzerGrating.calibration;
        connect calibrationController.calibration to phaseProcessor.calibration;
        connect calibrationController.calibration to deflectionSolver.calibration;

        connect phaseProcessor.phaseOut to deflectionSolver.phaseIn;
        connect phaseProcessor.phaseOut to archive.phaseIn;

        connect deflectionSolver.deflectionOut to reconstructionProcessor.deflectionIn;
        connect deflectionSolver.deflectionOut to archive.deflectionIn;

        connect reconstructionProcessor.profileOut to supervisor.profileIn;
        connect reconstructionProcessor.profileOut to archive.profileIn;

        connect supervisor.reportOut to reportOut;
        connect supervisor.reportOut to archive.reportIn;
    }

    requirement def PrimaryFunctionRequirement {
        doc /* The moire deflectometer shall determine surface or wavefront deflection by acquiring phase-shifted moire fringe images and converting fringe phase into calibrated angular slope data. */

        subject system : MoireDeflectometer;

        require constraint {
            system.targetSlopeResolution <= 2 [urad]
        }
    }

    requirement def SurfaceReconstructionRequirement {
        doc /* The system shall reconstruct a surface profile over the full measurement aperture using the calibrated deflection field. */

        subject system : MoireDeflectometer;

        require constraint {
            system.targetHeightResolution <= 20 [nm] and
            system.fieldOfViewDiameter >= 100 [mm]
        }
    }

    requirement def MeasurementCycleRequirement {
        doc /* The system shall complete one four-frame phase-shifted moire deflectometry measurement within the allocated cycle time. */

        subject system : MoireDeflectometer;

        require constraint {
            system.measurementCycleTime <= 3 [s]
        }
    }

    requirement def OperatingEnvironmentRequirement {
        doc /* The system shall maintain specified metrology performance within a controlled laboratory temperature range. */

        subject system : MoireDeflectometer;

        require constraint {
            system.operatingTemperatureMin >= 18 [degC] and
            system.operatingTemperatureMax <= 24 [degC]
        }
    }

    requirement def FringeQualityRequirement {
        doc /* The imaging chain shall provide sufficient fringe contrast for reliable phase extraction. */

        subject processor : PhaseProcessor;

        require constraint {
            processor.minimumFringeContrast >= 0.25
        }
    }

    requirement def CalibrationRequirement {
        doc /* The geometric scale factor used for deflection computation shall be derived from grating pitch, grating separation, camera focal length, and pixel pitch. */

        subject calibrationController : CalibrationController;

        require constraint {
            calibrationController.referenceFlatError <= 25 [nm]
        }
    }

    satisfy PrimaryFunctionRequirement by MoireDeflectometer;
    satisfy SurfaceReconstructionRequirement by MoireDeflectometer;
    satisfy MeasurementCycleRequirement by MoireDeflectometer;
    satisfy OperatingEnvironmentRequirement by MoireDeflectometer;
    satisfy FringeQualityRequirement by PhaseProcessor;
    satisfy CalibrationRequirement by CalibrationController;

    part moireDeflectometryInstrument : MoireDeflectometer {
        attribute fieldOfViewDiameter = 100 [mm];
        attribute targetSlopeResolution = 2 [urad];
        attribute targetHeightResolution = 20 [nm];
        attribute measurementCycleTime = 3 [s];
    }
}
