    }

    part def IsolationValve {
        attribute commandedOpen : Boolean;
        attribute positionOpen : Boolean;
        attribute fullOpenPressureDrop : Pressure = 3000.0;

        port inlet : FluidInletPort;
        port outlet : FluidOutletPort;

        action openValve {
            positionOpen := true;
            commandedOpen := true;
        }

        action closeValve {
            positionOpen := false;
            commandedOpen := false;
        }
    }

    part def PressureSensor {
        attribute rangeMin : Pressure = 0.0;
        attribute rangeMax : Pressure = 700000.0;
        attribute accuracy : Pressure = 1000.0;
        attribute measuredPressure : Pressure;

