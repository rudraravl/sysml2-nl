            action dryRunFault {
                faultActive := true;
                faultCode := "PUMP_DRY_RUN_OR_BLOCKED_SUCTION";
            }
            action casingLimitFault {
                faultActive := true;
                faultCode := "PUMP_CASING_PRESSURE_LIMIT_EXCEEDED";
            }
            status.faultActive := faultActive;
            status.faultCode := faultCode;
