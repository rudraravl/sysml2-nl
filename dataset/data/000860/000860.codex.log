        :> scalar;
        unit = "W";
    }

    attribute def Voltage {
        :> scalar;
        unit = "V";
    }

    attribute def Current {
        :> scalar;
        unit = "A";
    }

    attribute def Efficiency {
        :> scalar;
        unit = "1";
    }

    attribute def Duration {
        :> scalar;
        unit = "s";
    }

    item def WorkingFluid {
        attribute temperature : Temperature;
        attribute staticPressure : Pressure;
        attribute volumetricFlow : VolumeFlowRate;
        attribute contaminationIndex : Real;
    }

    item def ElectricalPower {
        attribute voltage : Voltage;
        attribute current : Current;
        attribute realPower : Power;
    }

    item def ControlSignal {
        attribute commandSpeed : RotationalSpeed;
        attribute enable : Boolean;
        attribute resetFault : Boolean;
    }

    item def PumpStatus {
        attribute actualSpeed : RotationalSpeed;
        attribute dischargePressure : Pressure;
