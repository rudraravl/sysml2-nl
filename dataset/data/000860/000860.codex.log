    }

    port def FluidInletPort {
        in item fluidIn : WorkingFluid;
        attribute allowablePressure : Pressure;
    }

    port def FluidOutletPort {
        out item fluidOut : WorkingFluid;
        attribute ratedPressure : Pressure;
    }

    port def PowerInputPort {
        in item powerIn : ElectricalPower;
    }

    port def CommandInputPort {
        in item commandIn : ControlSignal;
    }

    port def StatusOutputPort {
        out item statusOut : PumpStatus;
    }

    part def CirculatorPump {
        attribute ratedFlow : VolumeFlowRate = 0.012;
        attribute ratedDifferentialPressure : Pressure = 180000.0;
        attribute maximumDifferentialPressure : Pressure = 240000.0;
        attribute minimumFlow : VolumeFlowRate = 0.0015;
        attribute maximumFlow : VolumeFlowRate = 0.018;
        attribute ratedSpeed : RotationalSpeed = 3600.0;
        attribute minimumSpeed : RotationalSpeed = 900.0;
        attribute maximumSpeed : RotationalSpeed = 4200.0;
        attribute hydraulicEfficiency : Efficiency = 0.68;
        attribute motorEfficiency : Efficiency = 0.91;
        attribute nominalPower : Power = 2200.0;
        attribute casingPressureLimit : Pressure = 600000.0;
        attribute dryRunDetectionTime : Duration = 3.0;
        attribute inletPressure : Pressure;
        attribute outletPressure : Pressure;
        attribute differentialPressure : Pressure;
        attribute actualFlow : VolumeFlowRate;
        attribute actualSpeed : RotationalSpeed;
        attribute enabled : Boolean;
        attribute running : Boolean;
        attribute faultActive : Boolean;
        attribute faultCode : String;

        port suction : FluidInletPort;
        port discharge : FluidOutletPort;
        port electricalSupply : PowerInputPort;
        port speedCommand : CommandInputPort;
        port pumpStatus : StatusOutputPort;

        constraint pressureRise {
            differentialPressure == outletPressure - inletPressure;
        }

        constraint operatingEnvelope {
            actualFlow >= minimumFlow and actualFlow <= maximumFlow;
            actualSpeed >= minimumSpeed and actualSpeed <= maximumSpeed;
            differentialPressure <= maximumDifferentialPressure;
            outletPressure <= casingPressureLimit;
        }

        action startPump {
            in command : ControlSignal;
            out status : PumpStatus;
            first startCheck;
            then rampMotor;
            then establishFlow;
            action startCheck {
                assert command.enable == true;
                assert faultActive == false;
            }
            action rampMotor {
                actualSpeed := command.commandSpeed;
                running := true;
            }
            action establishFlow {
                actualFlow := ratedFlow * actualSpeed / ratedSpeed;
                differentialPressure := ratedDifferentialPressure * (actualSpeed / ratedSpeed) * (actualSpeed / ratedSpeed);
                status.running := running;
                status.actualSpeed := actualSpeed;
                status.measuredFlow := actualFlow;
                status.dischargePressure := outletPressure;
            }
        }

        action stopPump {
            out status : PumpStatus;
            first removeTorque;
            then confirmStopped;
            action removeTorque {
                actualSpeed := 0.0;
                actualFlow := 0.0;
                running := false;
            }
            action confirmStopped {
                status.running := false;
                status.actualSpeed := 0.0;
                status.measuredFlow := 0.0;
            }
        }

        action detectFault {
            out status : PumpStatus;
            if differentialPressure > maximumDifferentialPressure then overPressureFault;
            if actualFlow < minimumFlow and running == true then dryRunFault;
            if outletPressure > casingPressureLimit then casingLimitFault;
            action overPressureFault {
                faultActive := true;
                faultCode := "PUMP_OVER_DIFFERENTIAL_PRESSURE";
