        port fluidSupply : FluidInletPort;
        port fluidDelivery : FluidOutletPort;
        port electricalInput : PowerInputPort;
        port controlInput : CommandInputPort;
        port healthStatus : StatusOutputPort;

        part suctionIsolationValve : IsolationValve {
            commandedOpen = true;
            positionOpen = true;
        }

        part inletStrainer : SuctionStrainer;

        part circulator : CirculatorPump;

        part dischargeCheckValve : CheckValve;

