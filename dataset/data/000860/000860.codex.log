            state ready;
            state starting;
            state runningState;
            state stopping;
            state faulted;

            entry; then off;

            transition off_to_ready first off accept ControlSignal
                if commandIn.enable == false and faultActive == false
                then ready;

            transition ready_to_starting first ready accept ControlSignal
                if commandIn.enable == true and commandIn.commandSpeed >= minimumSpeed
                then starting;

            transition starting_to_running first starting
                if actualSpeed >= minimumSpeed and actualFlow >= minimumFlow
                then runningState;

            transition running_to_stopping first runningState accept ControlSignal
                if commandIn.enable == false
                then stopping;

            transition stopping_to_ready first stopping
                if actualSpeed == 0.0
                then ready;

            transition any_to_fault first off then faulted
                if faultActive == true;

            transition ready_to_fault first ready then faulted
                if faultActive == true;

            transition starting_to_fault first starting then faulted
                if faultActive == true;

            transition running_to_fault first runningState then faulted
                if faultActive == true;

            transition fault_to_ready first faulted accept ControlSignal
                if commandIn.resetFault == true and commandIn.enable == false
                then ready;
