            out command : ControlSignal;
            attribute flowError : VolumeFlowRate;
            flowError := targetFlow - measured.measuredFlow;
            commandedSpeed := measured.actualSpeed + proportionalGain * flowError;
            if commandedSpeed < minimumCommandSpeed then commandedSpeed := minimumCommandSpeed;
            if commandedSpeed > maximumCommandSpeed then commandedSpeed := maximumCommandSpeed;
            command.commandSpeed := commandedSpeed;
            command.enable := enableRequest and not faultLatched;
            command.resetFault := resetRequest;
        }

        action latchFault {
            in measured : PumpStatus;
            if measured.faultActive == true then faultLatched := true;
            if resetRequest == true and enableRequest == false then faultLatched := false;
        }

        state def ControllerState {
            state disabled;
            state enabled;
            state regulating;
            state shutdown;
            state faultLockout;

            entry; then disabled;

            transition disabled_to_enabled first disabled
                if enableRequest == true and faultLatched == false
                then enabled;

            transition enabled_to_regulating first enabled
                if commandedSpeed >= minimumCommandSpeed
                then regulating;

            transition regulating_to_shutdown first regulating
                if enableRequest == false
                then shutdown;

            transition shutdown_to_disabled first shutdown
                if commandedSpeed == 0.0
                then disabled;

            transition regulating_to_fault first regulating
                if faultLatched == true
                then faultLockout;

            transition fault_to_disabled first faultLockout
                if resetRequest == true and enableRequest == false
                then disabled;
        }
    }

    part def PumpingSubsystem {
        attribute requiredFlow : VolumeFlowRate = 0.010;
        attribute minimumDeliveredFlow : VolumeFlowRate = 0.008;
        attribute maximumDeliveredFlow : VolumeFlowRate = 0.014;
        attribute requiredDifferentialPressure : Pressure = 150000.0;
        attribute maximumDischargePressure : Pressure = 550000.0;
        attribute nominalSupplyVoltage : Voltage = 480.0;
        attribute maximumSupplyCurrent : Current = 8.0;
        attribute subsystemAvailable : Boolean;
        attribute deliveredFlow : VolumeFlowRate;
        attribute dischargePressure : Pressure;

        port fluidSupply : FluidInletPort;
        port fluidDelivery : FluidOutletPort;
        port electricalInput : PowerInputPort;
        port controlInput : CommandInputPort;
        port healthStatus : StatusOutputPort;

        part suctionIsolationValve : IsolationValve {
            commandedOpen = true;
            positionOpen = true;
        }

        part inletStrainer : SuctionStrainer;

        part circulator : CirculatorPump;

        part dischargeCheckValve : CheckValve;

        part dischargeIsolationValve : IsolationValve {
            commandedOpen = true;
            positionOpen = true;
        }

        part suctionPressureSensor : PressureSensor;

        part dischargePressureSensor : PressureSensor;

        part deliveredFlowSensor : FlowSensor;

        part controller : PumpController {
            targetFlow = requiredFlow;
        }

        connect fluidSupply to suctionIsolationValve.inlet;
        connect suctionIsolationValve.outlet to inletStrainer.inlet;
        connect inletStrainer.outlet to circulator.suction;
        connect circulator.discharge to dischargeCheckValve.inlet;
        connect dischargeCheckValve.outlet to dischargeIsolationValve.inlet;
        connect dischargeIsolationValve.outlet to fluidDelivery;

        connect electricalInput to controller.powerInput;
        connect electricalInput to circulator.electricalSupply;
        connect controlInput to controller.pumpCommand;
        connect controller.pumpCommand to circulator.speedCommand;
        connect circulator.pumpStatus to controller.pumpFeedback;
        connect circulator.pumpStatus to healthStatus;

        connect inletStrainer.outlet to suctionPressureSensor.processPort;
        connect dischargeIsolationValve.outlet to dischargePressureSensor.processPort;
        connect dischargeIsolationValve.outlet to deliveredFlowSensor.processPort;

        constraint deliveredFlowRange {
            deliveredFlow >= minimumDeliveredFlow and deliveredFlow <= maximumDeliveredFlow;
        }

        constraint pressureCapability {
            dischargePressure <= maximumDischargePressure;
            circulator.differentialPressure >= requiredDifferentialPressure;
        }

        constraint electricalLimit {
            electricalInput.powerIn.voltage == nominalSupplyVoltage;
            electricalInput.powerIn.current <= maximumSupplyCurrent;
        }

        action startSubsystem {
            first verifyValvesOpen;
            then energizeController;
            then startCirculator;
            then validateDelivery;
            action verifyValvesOpen {
                assert suctionIsolationValve.positionOpen == true;
                assert dischargeIsolationValve.positionOpen == true;
                assert inletStrainer.clogged == false;
            }
            action energizeController {
                controller.enableRequest := true;
                controller.faultLatched := false;
            }
            action startCirculator {
                circulator.startPump;
            }
            action validateDelivery {
                assert deliveredFlow >= minimumDeliveredFlow;
                assert dischargePressure <= maximumDischargePressure;
                subsystemAvailable := true;
            }
        }

        action stopSubsystem {
            first disableController;
            then stopCirculator;
            action disableController {
                controller.enableRequest := false;
            }
            action stopCirculator {
                circulator.stopPump;
                subsystemAvailable := false;
            }
        }

        action protectSubsystem {
            first evaluateStrainer;
            then evaluatePump;
            then isolateIfRequired;
            action evaluateStrainer {
                if inletStrainer.clogged == true then controller.faultLatched := true;
            }
            action evaluatePump {
                circulator.detectFault;
                if circulator.faultActive == true then controller.faultLatched := true;
            }
            action isolateIfRequired {
                if controller.faultLatched == true then dischargeIsolationValve.closeValve;
            }
        }
    }

    requirement def MoveFluidRequirement {
        subject subsystem : PumpingSubsystem;
        require constraint {
            subsystem.deliveredFlow >= subsystem.minimumDeliveredFlow and
            subsystem.deliveredFlow <= subsystem.maximumDeliveredFlow
        }
    }

    requirement def CirculatorPumpRequirement {
        subject pump : CirculatorPump;
        require constraint {
            pump.ratedFlow >= 0.010 and
            pump.ratedDifferentialPressure >= 150000.0 and
            pump.maximumDifferentialPressure >= 180000.0
        }
    }

    requirement def PressureContainmentRequirement {
        subject subsystem : PumpingSubsystem;
        require constraint {
            subsystem.dischargePressure <= subsystem.maximumDischargePressure and
            subsystem.circulator.outletPressure <= subsystem.circulator.casingPressureLimit
        }
    }

    requirement def FaultProtectionRequirement {
        subject subsystem : PumpingSubsystem;
        require constraint {
            subsystem.inletStrainer.clogged == false implies subsystem.controller.faultLatched == false
        }
    }

    requirement def ElectricalSupplyRequirement {
        subject subsystem : PumpingSubsystem;
        require constraint {
            subsystem.electricalInput.powerIn.voltage == subsystem.nominalSupplyVoltage and
            subsystem.electricalInput.powerIn.current <= subsystem.maximumSupplyCurrent
        }
    }

    requirement def CheckValveRequirement {
        subject valve : CheckValve;
        require constraint {
            valve.reverseLeakageFlow <= 0.00002
        }
    }

    requirement def InstrumentationRequirement {
        subject subsystem : PumpingSubsystem;
        require constraint {
            subsystem.deliveredFlowSensor.rangeMax >= subsystem.maximumDeliveredFlow and
            subsystem.dischargePressureSensor.rangeMax >= subsystem.maximumDischargePressure
        }
    }

    part circulatingWaterPumpingSubsystem : PumpingSubsystem {
        requiredFlow = 0.010;
        minimumDeliveredFlow = 0.008;
        maximumDeliveredFlow = 0.014;
        requiredDifferentialPressure = 150000.0;
        maximumDischargePressure = 550000.0;
        nominalSupplyVoltage = 480.0;
        maximumSupplyCurrent = 8.0;
    }

    satisfy MoveFluidRequirement by circulatingWaterPumpingSubsystem;
    satisfy PressureContainmentRequirement by circulatingWaterPumpingSubsystem;
    satisfy ElectricalSupplyRequirement by circulatingWaterPumpingSubsystem;
    satisfy InstrumentationRequirement by circulatingWaterPumpingSubsystem;
    satisfy CirculatorPumpRequirement by circulatingWaterPumpingSubsystem.circulator;
    satisfy CheckValveRequirement by circulatingWaterPumpingSubsystem.dischargeCheckValve;
}
