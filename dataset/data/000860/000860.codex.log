        port statusPort : StatusOutputPort;
    }

    part def FlowSensor {
        attribute rangeMin : VolumeFlowRate = 0.0;
        attribute rangeMax : VolumeFlowRate = 0.025;
        attribute accuracy : VolumeFlowRate = 0.0002;
        attribute measuredFlow : VolumeFlowRate;

        port processPort : FluidOutletPort;
        port statusPort : StatusOutputPort;
    }

