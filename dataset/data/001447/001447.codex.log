                first rinse
                then sanitize
                after 15.0 [min];

            transition sanitize_to_dry
                first sanitize
                then dry
                if currentDishLoad.sanitized == true;

            transition dry_to_completed
                first dry
                then completed
                after 25.0 [min];

            transition fault_on_low_water
                first prewash
                then fault
                if waterPerCycle < 8.0;
        }
    }

    part def ElectricOven {
        port powerIn : PowerInPort;
        port commandIn : CommandPort;
        port statusOut : StatusPort;

        attribute cavityTemperature : TemperatureCelsius = 22.0;
        attribute targetCookingTemperature : TemperatureCelsius = 180.0;
        attribute maximumSafeTemperature : TemperatureCelsius = 260.0;
        attribute ratedPower : PowerWatt = 3000.0;
        attribute timerDuration : TimeMinute = 45.0;

        part controller : ApplianceController;

        action def Preheat {
            in attribute targetTemperature : TemperatureCelsius;
            out attribute achievedTemperature : TemperatureCelsius;
        }

        action def MaintainHeat {
            in attribute currentTemperature : TemperatureCelsius;
            in attribute targetTemperature : TemperatureCelsius;
            out attribute heaterPower : PowerWatt;
        }

        action def ShutDownHeating {
            out attribute heaterPower : PowerWatt;
        }

        state def OvenOperation {
            state idle;
            state preheating;
            state cooking;
            state keepWarm;
            state completed;
            state fault;

            transition first idle;
            transition idle_to_preheating
                first idle
                then preheating
                accept UserCommand
                if command.requestedMode == ApplianceMode::cooking;

            transition preheating_to_cooking
                first preheating
                then cooking
                if cavityTemperature >= targetCookingTemperature;

            transition cooking_to_keepWarm
                first cooking
                then keepWarm
                after timerDuration;

            transition keepWarm_to_completed
                first keepWarm
                then completed
                after 30.0 [min];

            transition overtemperature_fault
                first cooking
                then fault
                if cavityTemperature > maximumSafeTemperature;
        }
    }

    part def ClothesDryer {
        port powerIn : PowerInPort;
        port airOut : AirOutPort;
        port commandIn : CommandPort;
        port statusOut : StatusPort;

        attribute drumCapacityKg : Real = 8.0;
        attribute dryingAirTemperature : TemperatureCelsius = 62.0;
        attribute exhaustHumidity : Percent = 70.0;
        attribute targetMoistureLevel : Percent = 5.0;
        attribute ratedPower : PowerWatt = 2400.0;
        attribute cycleDuration : TimeMinute = 60.0;

        item currentLoad : LaundryLoad;

        part controller : ApplianceController;

        action def HeatAir {
            in attribute targetTemperature : TemperatureCelsius;
            out item heatedAir : HeatedAir;
        }

        action def TumbleDry {
            in item wetLoad : LaundryLoad;
            in item air : HeatedAir;
            out item dryLoad : LaundryLoad;
        }

        state def DryerCycle {
            state idle;
            state heating;
            state drying;
            state coolDown;
            state completed;
            state fault;

            transition first idle;
            transition idle_to_heating
                first idle
                then heating
                accept UserCommand
                if command.requestedMode == ApplianceMode::drying;

            transition heating_to_drying
                first heating
                then drying
                if dryingAirTemperature >= 55.0;

            transition drying_to_coolDown
                first drying
                then coolDown
                if currentLoad.moistureLevel <= targetMoistureLevel;

            transition coolDown_to_completed
                first coolDown
                then completed
                after 8.0 [min];

            transition fault_on_overload
                first idle
                then fault
                if currentLoad.dryMassKg > drumCapacityKg;
        }
    }

    part def HomeApplianceSystem {
        port homePower : PowerInPort;
        port homeWater : WaterInPort;
        port userCommands : CommandPort;
        port systemStatus : StatusPort;

        attribute primaryFunction : String = "Coordinate home appliances to preserve food, clean laundry, sanitize dishes, cook meals, and dry clothing while managing energy, water, safety, and user commands.";
        attribute maximumSimultaneousPower : PowerWatt = 7200.0;
        attribute dailyEnergyBudget : EnergyKiloWattHour = 18.0;
        attribute dailyWaterBudget : WaterLiter = 220.0;

        part refrigerator : SmartRefrigerator;
        part washer : WashingMachine;
        part dishwasher : Dishwasher;
        part oven : ElectricOven;
        part dryer : ClothesDryer;
        part centralController : ApplianceController;

        connection power_to_refrigerator connect homePower to refrigerator.powerIn;
        connection power_to_washer connect homePower to washer.powerIn;
        connection power_to_dishwasher connect homePower to dishwasher.powerIn;
        connection power_to_oven connect homePower to oven.powerIn;
        connection power_to_dryer connect homePower to dryer.powerIn;

        connection water_to_washer connect homeWater to washer.waterIn;
        connection water_to_dishwasher connect homeWater to dishwasher.waterIn;

        connection commands_to_controller connect userCommands to centralController.commandIn;
        connection controller_status_to_system connect centralController.statusOut to systemStatus;

        connection controller_to_refrigerator connect userCommands to refrigerator.commandIn;
        connection controller_to_washer connect userCommands to washer.commandIn;
        connection controller_to_dishwasher connect userCommands to dishwasher.commandIn;
        connection controller_to_oven connect userCommands to oven.commandIn;
        connection controller_to_dryer connect userCommands to dryer.commandIn;

        action def AllocateEnergy {
            in item requestedStatus[5] : ApplianceStatus;
            in attribute energyBudget : EnergyKiloWattHour;
            out attribute approvedPowerLimit : PowerWatt;
        }

        action def ScheduleApplianceCycle {
            in item command : UserCommand;
            in attribute availablePower : PowerWatt;
            in attribute availableWater : WaterLiter;
            out item acceptedCommand : UserCommand;
        }

        action def MonitorSafety {
            in item refrigeratorStatus : ApplianceStatus;
            in item washerStatus : ApplianceStatus;
            in item dishwasherStatus : ApplianceStatus;
            in item ovenStatus : ApplianceStatus;
            in item dryerStatus : ApplianceStatus;
            out attribute emergencyShutdown : Boolean;
        }
    }

    requirement def PrimaryFunctionRequirement {
        subject system : HomeApplianceSystem;
        doc /* The home appliance system shall provide coordinated domestic food preservation, cooking, laundry cleaning, dish sanitization, and clothes drying functions through electrically powered appliances under centralized command and monitoring. */
    }

    requirement def EnergyManagementRequirement {
        subject system : HomeApplianceSystem;
        require constraint {
            system.refrigerator.ratedPower
            + system.washer.ratedPower
            + system.dishwasher.ratedPower
            + system.oven.ratedPower
            + system.dryer.ratedPower <= system.maximumSimultaneousPower;
        }
    }

    requirement def WaterUseRequirement {
        subject system : HomeApplianceSystem;
        require constraint {
            system.washer.washWaterVolume + system.dishwasher.waterPerCycle <= system.dailyWaterBudget;
        }
    }

    requirement def RefrigeratorPreservationRequirement {
        subject refrigerator : SmartRefrigerator;
        require constraint {
            refrigerator.compartmentTemperature <= 5.0 and refrigerator.freezerTemperature <= -15.0;
        }
    }

    requirement def LaundryCleaningRequirement {
        subject washer : WashingMachine;
        require constraint {
            washer.currentLoad.dryMassKg <= washer.drumCapacityKg;
        }
    }

    requirement def DishSanitizationRequirement {
        subject dishwasher : Dishwasher;
        require constraint {
            dishwasher.sanitizeTemperature >= 70.0;
        }
    }

    requirement def OvenSafetyRequirement {
        subject oven : ElectricOven;
        require constraint {
            oven.cavityTemperature <= oven.maximumSafeTemperature;
        }
    }

    requirement def DryerSafetyRequirement {
        subject dryer : ClothesDryer;
        require constraint {
            dryer.currentLoad.dryMassKg <= dryer.drumCapacityKg and dryer.dryingAirTemperature <= 75.0;
        }
    }

    requirement def UserCommandRequirement {
        subject system : HomeApplianceSystem;
        doc /* The system shall accept user commands for appliance operating modes, target temperatures, and delayed start scheduling, then publish operating status including active mode, energy consumed, faults, and remaining time. */
    }

    satisfy PrimaryFunctionRequirement by HomeApplianceSystem;
    satisfy EnergyManagementRequirement by HomeApplianceSystem;
    satisfy WaterUseRequirement by HomeApplianceSystem;
    satisfy RefrigeratorPreservationRequirement by SmartRefrigerator;
    satisfy LaundryCleaningRequirement by WashingMachine;
    satisfy DishSanitizationRequirement by Dishwasher;
    satisfy OvenSafetyRequirement by ElectricOven;
    satisfy DryerSafetyRequirement by ClothesDryer;
    satisfy UserCommandRequirement by ApplianceController;
}
