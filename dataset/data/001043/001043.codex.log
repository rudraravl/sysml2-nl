            then transmitFrames;

            action receiveProcessedMeasurement;
            action packageMeasurementFrame;
            action packageDiagnosticFrame;
            action transmitFrames;
        }
    }

    part def RegulatedPowerSupply {
        attribute inputVoltageNominal : Voltage = 12.0;
        attribute outputVoltageNominal : Voltage = 5.0;
        attribute outputVoltageTolerance : Percent = 2.0;
        attribute maximumOutputCurrent : Current = 100.0;

        port inputPower : PowerPort;
        port sensorPower : PowerPort;
        port conditioningPower : PowerPort;
        port adcPower : PowerPort;
        port processorPower : PowerPort;
        port interfacePower : PowerPort;
        port ground : GroundPort;
    }

    part def EngineCoolantTemperatureSensingUnit {
        attribute measuredQuantity : String = "engine coolant temperature";
        attribute measurementRangeLow : Temperature = -40.0;
        attribute measurementRangeHigh : Temperature = 150.0;
        attribute totalAccuracy : Temperature = 3.0;
        attribute outputUpdatePeriod : TimeDuration = 10.0;
        attribute startupTimeMaximum : TimeDuration = 100.0;

        port coolantInterface : CoolantInterface;
        port vehiclePowerInput : PowerPort;
        port chassisGround : GroundPort;
        port ecuOutput : DigitalDataPort;

        part ectSensor : EngineCoolantTemperatureSensor;
        part conditioning : SignalConditioningCircuit;
        part adc : AnalogToDigitalConverter;
        part processor : TemperatureLinearizationProcessor;
        part ecuInterface : EngineControlUnitInterface;
        part powerSupply : RegulatedPowerSupply;

        connect coolantInterface to ectSensor.coolantPort;
        connect ectSensor.analogOut to conditioning.sensorAnalogIn;
        connect conditioning.conditionedAnalogOut to adc.analogIn;
        connect adc.digitalOut to processor.rawDataIn;
        connect processor.processedDataOut to ecuInterface.temperatureDataIn;
        connect ecuInterface.temperatureDataOut to ecuOutput;

        connect vehiclePowerInput to powerSupply.inputPower;
        connect chassisGround to powerSupply.ground;
        connect powerSupply.sensorPower to ectSensor.power;
        connect powerSupply.conditioningPower to conditioning.power;
        connect powerSupply.adcPower to adc.power;
        connect powerSupply.processorPower to processor.power;
        connect powerSupply.interfacePower to ecuInterface.power;

        connect chassisGround to ectSensor.ground;
        connect chassisGround to conditioning.ground;
        connect chassisGround to adc.ground;
        connect chassisGround to processor.ground;
        connect chassisGround to ecuInterface.ground;

        action measureEngineCoolantTemperature {
            in item coolantIn : Coolant;
            out item temperatureOut : DigitalTemperatureSample;
            out item diagnosticOut : DiagnosticStatus;

            first powerStabilization;
            then acquireThermalSignal;
            then conditionAnalogSignal;
            then convertToDigitalSample;
            then linearizeTemperature;
            then evaluateDiagnostics;
            then transmitMeasurement;

            action powerStabilization;
            action acquireThermalSignal;
            action conditionAnalogSignal;
            action convertToDigitalSample;
            action linearizeTemperature;
            action evaluateDiagnostics;
            action transmitMeasurement;
        }

        state sensingUnitOperationalState {
            state unpowered;
            state powerOnSelfTest;
            state sensing;
            state reportingFault;
            state shutdown;

            entry; then unpowered;

            transition unpowered_to_self_test
                first unpowered
                if vehiclePowerInput::supplyVoltage >= 9.0 and vehiclePowerInput::supplyVoltage <= 16.0
                then powerOnSelfTest;

            transition self_test_to_sensing
                first powerOnSelfTest
                accept after 100.0 [ms]
                if not ecuOutput::diagnostic::sensorOpenCircuit and not ecuOutput::diagnostic::sensorShortToGround
                then sensing;

            transition sensing_to_fault
                first sensing
                if ecuOutput::diagnostic::sensorOpenCircuit or ecuOutput::diagnostic::sensorShortToGround or ecuOutput::diagnostic::sensorShortToSupply or ecuOutput::diagnostic::outOfRange
                then reportingFault;

            transition fault_to_sensing
                first reportingFault
                accept after 1000.0 [ms]
                if not ecuOutput::diagnostic::sensorOpenCircuit and not ecuOutput::diagnostic::sensorShortToGround and not ecuOutput::diagnostic::sensorShortToSupply and not ecuOutput::diagnostic::outOfRange
                then sensing;

            transition any_to_shutdown
                first sensing
                if vehiclePowerInput::supplyVoltage < 6.0
                then shutdown;
        }
    }

    requirement def MeasureCoolantTemperatureRequirement {
        doc /* The sensing unit shall measure engine coolant temperature using an engine coolant temperature sensor. */
        subject sensingUnit : EngineCoolantTemperatureSensingUnit;

        require constraint {
            sensingUnit.measuredQuantity == "engine coolant temperature"
        }
    }

    requirement def MeasurementRangeRequirement {
        doc /* The sensing unit shall report coolant temperature over the range from -40 degC to 150 degC. */
        subject sensingUnit : EngineCoolantTemperatureSensingUnit;

        require constraint {
            sensingUnit.measurementRangeLow <= -40.0 and sensingUnit.measurementRangeHigh >= 150.0
        }
    }

    requirement def AccuracyRequirement {
        doc /* The sensing unit shall provide coolant temperature measurement accuracy within +/-3 degC over the operating measurement range. */
        subject sensingUnit : EngineCoolantTemperatureSensingUnit;

        require constraint {
            sensingUnit.totalAccuracy <= 3.0
        }
    }

    requirement def UpdateRateRequirement {
        doc /* The sensing unit shall update the reported coolant temperature at least every 10 ms during normal operation. */
        subject sensingUnit : EngineCoolantTemperatureSensingUnit;

        require constraint {
            sensingUnit.outputUpdatePeriod <= 10.0
        }
    }

    requirement def StartupRequirement {
        doc /* The sensing unit shall begin reporting valid coolant temperature samples within 100 ms after valid vehicle power is applied. */
        subject sensingUnit : EngineCoolantTemperatureSensingUnit;

        require constraint {
            sensingUnit.startupTimeMaximum <= 100.0
        }
    }

    requirement def DiagnosticRequirement {
        doc /* The sensing unit shall detect sensor open circuit, short to ground, short to supply, and out-of-range coolant temperature conditions. */
        subject sensingUnit : EngineCoolantTemperatureSensingUnit;

        require constraint {
            sensingUnit.ecuOutput::diagnostic::sensorOpenCircuit == true or
            sensingUnit.ecuOutput::diagnostic::sensorShortToGround == true or
            sensingUnit.ecuOutput::diagnostic::sensorShortToSupply == true or
            sensingUnit.ecuOutput::diagnostic::outOfRange == true or
            sensingUnit.ecuOutput::sample::valid == true
        }
    }

    requirement def PowerRequirement {
        doc /* The sensing unit shall operate from a vehicle power input between 9 V and 16 V. */
        subject sensingUnit : EngineCoolantTemperatureSensingUnit;

        require constraint {
            sensingUnit.vehiclePowerInput::supplyVoltage >= 9.0 and sensingUnit.vehiclePowerInput::supplyVoltage <= 16.0
        }
    }

    satisfy MeasureCoolantTemperatureRequirement by EngineCoolantTemperatureSensingUnit;
    satisfy MeasurementRangeRequirement by EngineCoolantTemperatureSensingUnit;
    satisfy AccuracyRequirement by EngineCoolantTemperatureSensingUnit;
    satisfy UpdateRateRequirement by EngineCoolantTemperatureSensingUnit;
    satisfy StartupRequirement by EngineCoolantTemperatureSensingUnit;
    satisfy DiagnosticRequirement by EngineCoolantTemperatureSensingUnit;
    satisfy PowerRequirement by EngineCoolantTemperatureSensingUnit;
}
