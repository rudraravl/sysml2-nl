      first Standby
      accept UserCommand
      then Warming;

    transition warmupComplete
      first Warming
      if tipTemperature >= targetTipTemperature
      then Ready;

    transition contactDetected
      first Ready
      accept SurfaceContact
      then Writing;

    transition contactReleased
      first Writing
      then Ready;

    transition powerOffFromReady
      first Ready
      accept UserCommand
      then Cooling;

    transition cooled
      first Cooling
      if tipTemperature <= 35.0
      then Off;

