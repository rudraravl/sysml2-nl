    }
  }

  requirement def GripSafetyRequirement {
    subject pen: HeatPen;

    require constraint {
      pen.grip.maximumOuterSurfaceTemperature <= 38.0
    }
  }

  requirement def PortablePowerRequirement {
    subject pen: HeatPen;

    require constraint {
