        attribute gasPrechargePressure : PressureValue = 70 [Bar];
        attribute maximumWorkingPressure : PressureValue = 350 [Bar];
        attribute dampeningEfficiency : EfficiencyValue = 0.75;

        port inlet : MudInletPort;
        port outlet : MudOutletPort;
    }

    part def PressureReliefValve {
        attribute setPressure : PressureValue = 325 [Bar];
        attribute reseatPressure : PressureValue = 290 [Bar];
        attribute ratedReliefFlow : FlowRateValue = 2600 [Litre / Minute];
        attribute open : Boolean;

        port inlet : MudInletPort;
        port normalOutlet : MudOutletPort;
        port reliefOutlet : ReliefReturnPort;

        state machine ReliefValveStates {
            state Closed;
            state Open;
            initial then Closed;

            transition OpenOnHighPressure
                first Closed
                if inlet.mudIn.pressure >= setPressure
                then Open;

            transition CloseAfterPressureRecovery
                first Open
                if inlet.mudIn.pressure <= reseatPressure
                then Closed;
        }
    }

    part def FlowMeter {
        attribute measurementRange : FlowRateValue = 3000 [Litre / Minute];
        attribute accuracy : EfficiencyValue = 0.01;

        port inlet : MudInletPort;
        port outlet : MudOutletPort;
        port statusOutput : StatusPort;
    }

    part def PressureTransmitter {
        attribute range : PressureValue = 400 [Bar];
        attribute accuracy : EfficiencyValue = 0.005;

        port processConnection : MudTransferPort;
        port statusOutput : StatusPort;
    }

    part def PumpController {
        attribute targetFlowRate : FlowRateValue;
        attribute targetPressure : PressureValue;
        attribute lowSuctionPressureTrip : PressureValue = 1.5 [Bar];
        attribute highDischargePressureTrip : PressureValue = 330 [Bar];
        attribute maximumMudTemperature : TemperatureValue = 85 [SI::degreeCelsius];

        port operatorCommand : CommandPort;
        port pumpCommand : CommandPort;
        port driveCommand : CommandPort;
        port statusInput : StatusPort;
        port statusOutput : StatusPort;

        action computeSpeedCommand {
            in requestedFlowRate : FlowRateValue;
            in measuredFlowRate : FlowRateValue;
            out requestedStrokeRate : RotationalSpeedValue;
        }

        action tripOnUnsafeCondition {
            in suctionPressure : PressureValue;
            in dischargePressure : PressureValue;
            in mudTemperature : TemperatureValue;
            out emergencyStop : Boolean;
        }

        state machine ControllerStates {
            state Idle;
            state Ready;
            state CommandingStart;
            state Controlling;
            state Shutdown;
            state Trip;

            initial then Idle;

            transition Idle_to_Ready
                first Idle
                if operatorCommand.command.enable and not operatorCommand.command.emergencyStop
                then Ready;

            transition Ready_to_CommandingStart
                first Ready
                then CommandingStart;

            transition CommandingStart_to_Controlling
                first CommandingStart
                if statusInput.status.pumpRunning
                then Controlling;

            transition Controlling_to_Shutdown
                first Controlling
                if not operatorCommand.command.enable
                then Shutdown;

            transition Shutdown_to_Idle
                first Shutdown
                after 30 [SI::second]
                then Idle;

            transition Controlling_to_Trip
                first Controlling
                if statusInput.status.suctionPressure < lowSuctionPressureTrip
                   or statusInput.status.dischargePressure > highDischargePressureTrip
                   or statusInput.status.mudTemperature > maximumMudTemperature
                   or operatorCommand.command.emergencyStop
                then Trip;

            transition Trip_to_Idle
                first Trip
                if not operatorCommand.command.enable
                then Idle;
        }
    }

    part def MudPumpSubsystem {
        attribute subsystemRatedFlowRate : FlowRateValue = 2400 [Litre / Minute];
        attribute subsystemRatedPressure : PressureValue = 300 [Bar];
        attribute normalOperatingFlowRate : FlowRateValue = 1800 [Litre / Minute];
        attribute normalOperatingPressure : PressureValue = 220 [Bar];
        attribute maximumStartTime : TimeValue = 45 [SI::second];

        port electricalSupply : ElectricalPowerInputPort;
        port operatorCommand : CommandPort;
        port subsystemStatus : StatusPort;
        port mudReturnToTank : MudInletPort;
        port mudDischargeToStandpipe : MudOutletPort;

        part mudTank : MudTank;
        part suctionManifold : SuctionManifold;
        part drive : VariableFrequencyDrive;
        part motor : ElectricMotor;
        part gearbox : GearReducer;
        part mudPump : TriplexMudPump;
        part dampener : PulsationDampener;
        part reliefValve : PressureReliefValve;
        part flowMeter : FlowMeter;
        part suctionPressureTransmitter : PressureTransmitter;
        part dischargePressureTransmitter : PressureTransmitter;
        part controller : PumpController;
        part dischargeManifold : DischargeManifold;

        connect electricalSupply to drive.powerInput;
        connect drive.motorPowerOutput to motor.electricalInput;
        connect motor.shaftOutput to gearbox.highSpeedShaft;
        connect gearbox.lowSpeedShaft to mudPump.shaftInput;

        connect mudTank.outlet to suctionManifold.tankConnection;
        connect suctionManifold.pumpConnection to mudPump.suctionInlet;
        connect mudPump.dischargeOutlet to dampener.inlet;
        connect dampener.outlet to dischargeManifold.pumpConnection;
        connect dischargeManifold.standpipeConnection to flowMeter.inlet;
        connect flowMeter.outlet to mudDischargeToStandpipe;
        connect dischargeManifold.reliefConnection to reliefValve.inlet;
        connect reliefValve.reliefOutlet to mudReturnToTank;
        connect mudReturnToTank to mudTank.returnInlet;

        connect operatorCommand to controller.operatorCommand;
        connect controller.pumpCommand to mudPump.commandInput;
        connect controller.driveCommand to drive.commandInput;
        connect mudPump.statusOutput to controller.statusInput;
        connect flowMeter.statusOutput to controller.statusInput;
        connect suctionPressureTransmitter.statusOutput to controller.statusInput;
        connect dischargePressureTransmitter.statusOutput to controller.statusInput;
        connect controller.statusOutput to subsystemStatus;
    }

    requirement def PumpingSubsystemRequirement {
        subject subsystem : MudPumpSubsystem;
    }

    requirement FlowCapacityRequirement specializes PumpingSubsystemRequirement {
        doc
        /* The mud pumping subsystem shall deliver drilling mud at a continuous flow rate of at least 1800 L/min at normal operating pressure. */

        require constraint {
            subsystem.normalOperatingFlowRate >= 1800 [Litre / Minute]
        }
    }

    requirement PressureCapabilityRequirement specializes PumpingSubsystemRequirement {
        doc
        /* The mud pumping subsystem shall sustain a discharge pressure of 300 bar without exceeding rated component limits. */

        require constraint {
            subsystem.subsystemRatedPressure >= 300 [Bar]
            and subsystem.mudPump.ratedDischargePressure >= subsystem.subsystemRatedPressure
            and subsystem.dischargeManifold.ratedPressure >= subsystem.subsystemRatedPressure
            and subsystem.dampener.maximumWorkingPressure >= subsystem.subsystemRatedPressure
        }
    }

    requirement OverPressureProtectionRequirement specializes PumpingSubsystemRequirement {
        doc
        /* The subsystem shall open the relief path before discharge pressure exceeds 350 bar. */

        require constraint {
            subsystem.reliefValve.setPressure <= 325 [Bar]
            and subsystem.reliefValve.setPressure < subsystem.mudPump.maximumAllowablePressure
        }
    }

    requirement LowSuctionPressureTripRequirement specializes PumpingSubsystemRequirement {
        doc
        /* The controller shall trip the pump when suction pressure falls below the minimum safe suction pressure. */

        require constraint {
            subsystem.controller.lowSuctionPressureTrip == subsystem.mudPump.minimumSuctionPressure
        }
    }

    requirement StartTimeRequirement specializes PumpingSubsystemRequirement {
        doc
        /* The subsystem shall transition from enabled command to stable running status within 45 seconds when mud volume and suction pressure are available. */

        require constraint {
            subsystem.maximumStartTime <= 45 [SI::second]
        }
    }

    requirement TemperatureProtectionRequirement specializes PumpingSubsystemRequirement {
        doc
        /* The controller shall command shutdown when measured mud temperature exceeds 85 degC. */

        require constraint {
            subsystem.controller.maximumMudTemperature <= 85 [SI::degreeCelsius]
        }
    }

    requirement StatusReportingRequirement specializes PumpingSubsystemRequirement {
        doc
        /* The subsystem shall report actual flow rate, suction pressure, discharge pressure, mud temperature, running state, and active fault state. */
    }

    requirement PrimeVolumeRequirement specializes PumpingSubsystemRequirement {
        doc
        /* The mud tank shall maintain at least 8000 L usable volume for pump priming and cavitation avoidance. */

        require constraint {
            subsystem.mudTank.minimumOperatingVolume >= 8000 [Litre]
        }
    }

    requirement PowerMarginRequirement specializes PumpingSubsystemRequirement {
        doc
        /* The motor and drive shall provide at least 1200 kW rated power to support rated mud pump operation. */

        require constraint {
            subsystem.motor.ratedPower >= 1200 [SI::kilowatt]
            and subsystem.drive.maximumOutputPower >= subsystem.motor.ratedPower
        }
    }

    satisfy FlowCapacityRequirement by MudPumpSubsystem::mudPump;
    satisfy PressureCapabilityRequirement by MudPumpSubsystem::mudPump;
    satisfy PressureCapabilityRequirement by MudPumpSubsystem::dischargeManifold;
    satisfy OverPressureProtectionRequirement by MudPumpSubsystem::reliefValve;
    satisfy LowSuctionPressureTripRequirement by MudPumpSubsystem::controller;
    satisfy StartTimeRequirement by MudPumpSubsystem::controller;
    satisfy TemperatureProtectionRequirement by MudPumpSubsystem::controller;
    satisfy StatusReportingRequirement by MudPumpSubsystem::subsystemStatus;
    satisfy PrimeVolumeRequirement by MudPumpSubsystem::mudTank;
    satisfy PowerMarginRequirement by MudPumpSubsystem::motor;
    satisfy PowerMarginRequirement by MudPumpSubsystem::drive;
}
