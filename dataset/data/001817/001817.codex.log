                first Off
                accept PumpCommand
                if command.emergencyStop
                then EmergencyStopped;

            transition Running_to_EmergencyStopped
                first Running
                accept PumpCommand
                if command.emergencyStop
                then EmergencyStopped;

            transition Priming_to_EmergencyStopped
                first Priming
                accept PumpCommand
                if command.emergencyStop
                then EmergencyStopped;

            transition FlowRegulation_to_EmergencyStopped
                first FlowRegulation
                accept PumpCommand
                if command.emergencyStop
                then EmergencyStopped;
