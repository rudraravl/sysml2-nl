        unit = SI::second;
    }

    enum def VestOperatingMode {
        enum idle;
        enum assist;
        enum stabilize;
        enum alert;
        enum emergencyShutdown;
        enum charging;
    }

    enum def AlertSeverity {
        enum advisory;
        enum caution;
        enum warning;
        enum critical;
    }

    enum def PostureClass {
        enum upright;
        enum leaningForward;
        enum leaningBackward;
        enum lateralLean;
        enum fallDetected;
        enum unknown;
    }

