        attribute normalOperatingTemperatureMin: Temperature_C = 15.0;
        attribute normalOperatingTemperatureMax: Temperature_C = 35.0;

        connect fluidInlet to reservoir.outlet;
        connect reservoir.outlet to inletFilter.inlet;
        connect inletFilter.outlet to inletCheckValve.inlet;
        connect inletCheckValve.outlet to pump.inlet;
        connect pump.outlet to outletCheckValve.inlet;
        connect outletCheckValve.outlet to flowSensor.sensedPort;
        connect flowSensor.sensedPort to pressureSensor.sensedPort;
        connect pressureSensor.sensedPort to outletAssembly.inlet;
        connect outletAssembly.patientLine to injectionOutlet;
        connect pump.outlet to reliefValve.inlet;
        connect reliefValve.drain to reliefDrain;
        connect electricalInput to pump.power;
        connect commandInput to pump.command;
        connect pump.status to statusOutput;

        perform action prime: PrimePump {
            in pump = pump;
            in primeVolume = 2.0;
        }

        perform action inject: InjectDose {
            in pump = pump;
            in requestedDose = commandedDose;
            in requestedFlowRate = pump.commandedFlowRate;
            out deliveredDose = deliveredDose;
        }

        perform action faultDetection: DetectPumpFault {
            in pump = pump;
            in outletPressure = pressureSensor.measuredPressure;
            in measuredFlow = flowSensor.measuredFlowRate;
        }

        exhibit state operatingState: PumpOperatingState;

        satisfy MoveFluidRequirement by this;
        satisfy InjectionAccuracyRequirement by this;
        satisfy OverPressureProtectionRequirement by this;
        satisfy BackflowPreventionRequirement by this;
        satisfy PrimeBeforeInjectionRequirement by this;

        constraint operatingTemperature {
            reservoir.fluidTemperature >= normalOperatingTemperatureMin and
            reservoir.fluidTemperature <= normalOperatingTemperatureMax
        }

        constraint deliveredFlowMatchesCommand {
            abs(flowSensor.measuredFlowRate - pump.commandedFlowRate) <= pump.commandedFlowRate * 0.03
        }

        constraint outletPressureLimited {
            pressureSensor.measuredPressure <= maximumAllowedOutletPressure
        }

        constraint reservoirFeedsPump {
            reservoir.currentVolume > reservoir.minimumVolume implies pump.inlet.flowRate >= minimumRequiredFlowRate
        }
    }

    part injectionPumpPumpingSubsystem: PumpingSubsystem {
        attribute commandedDose = 10.0;
        attribute deliveredDose = 0.0;

        part reservoir {
            attribute currentVolume = 250.0;
            attribute fluidTemperature = 22.0;
            attribute outletPressure = 101.0;
        }

        part pump {
            attribute commandedFlowRate = 25.0;
            attribute deliveredVolume = 0.0;
            attribute motorSpeed = 600.0;
            attribute primed = false;
            attribute enabled = false;
            attribute faulted = false;
        }

        part inletCheckValve {
            attribute crackingPressure = 5.0;
        }

        part outletCheckValve {
            attribute crackingPressure = 10.0;
        }

        part pressureSensor {
            attribute measuredPressure = 250.0;
        }

        part flowSensor {
            attribute measuredFlowRate = 25.0;
        }
    }
}
