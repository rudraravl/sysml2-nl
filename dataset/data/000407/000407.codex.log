        doc /* The system shall transmit maps, hazard reports, and diagnostics to the operator base station during the mission. */
        subject system : RoboticInspectionSystem;
        require constraint {
            system.baseStation.communicationRange >= 250.0 and
            system.baseStation.minimumLinkQuality >= 65.0
        }
    }

    requirement def CoverageRequirement {
        doc /* The robotic inspection system shall cover at least 95 percent of the assigned inspection area before mission completion unless a critical fault occurs. */
        subject system : RoboticInspectionSystem;
        require constraint {
            system.requiredCoverage >= 95.0
        }
    }

    satisfy PrimaryTaskRequirement by RoboticInspectionSystem;
    satisfy HexapodLocomotionRequirement by InsectoidRobot;
    satisfy ConfinedSpaceIngressRequirement by InsectoidRobot;
    satisfy HazardDetectionRequirement by PerceptionComputer;
    satisfy MissionEnduranceRequirement by BatteryPack;
    satisfy OperatorCommunicationRequirement by WirelessBaseStation;
    satisfy CoverageRequirement by MissionComputer;
}
