    action def MonitorSafety {
        in item shape : ContinuumShapeEstimate;
        out item status : SafetyStatus;

        first sampleSensors;
        then checkPressureLimits;
        then checkTendonTensionLimits;
        then checkCollisionEnvelope;
        then checkEmergencyStop;
        then publishSafetyStatus;
    }

    state def ContinuumRobotOperationalState {
        entry action InitializeSystem;

        state Off;
        state Initializing;
        state Ready;
        state Planning;
        state Shaping;
        state Grasping;
        state Transporting;
        state Releasing;
        state Fault;
        state EmergencyStopped;

        transition first Off then Initializing;
        transition Initializing then Ready
            accept after 6 [s];

        transition Ready then Planning
            accept taskRequested;

        transition Planning then Shaping
            accept planValid;

        transition Shaping then Grasping
            accept tipAtPregraspPose;

        transition Grasping then Transporting
            accept objectSecured;

        transition Transporting then Releasing
            accept objectAtTargetPose;

        transition Releasing then Ready
            accept objectReleased;

        transition Ready then Fault
            accept faultDetected;

        transition Planning then Fault
            accept faultDetected;

        transition Shaping then Fault
            accept faultDetected;

        transition Grasping then Fault
            accept faultDetected;

        transition Transporting then Fault
            accept faultDetected;

        transition Releasing then Fault
            accept faultDetected;

        transition Fault then Initializing
            accept resetCommand;

        transition Off then EmergencyStopped
            accept emergencyStop;

        transition Initializing then EmergencyStopped
            accept emergencyStop;

        transition Ready then EmergencyStopped
            accept emergencyStop;

        transition Planning then EmergencyStopped
            accept emergencyStop;

        transition Shaping then EmergencyStopped
            accept emergencyStop;

        transition Grasping then EmergencyStopped
            accept emergencyStop;

        transition Transporting then EmergencyStopped
            accept emergencyStop;

        transition Releasing then EmergencyStopped
            accept emergencyStop;

        transition Fault then EmergencyStopped
            accept emergencyStop;
    }

    requirement def PrimaryContinuumTaskRequirement {
        subject system : ContinuumRoboticWorkcell;
        doc
        /*
         * The robotic system shall perform its primary manipulation task using the continuum robot as the only robot that contacts, grasps, transports, and releases the task object.
         */
    }

    requirement def ShapeControlRequirement {
        subject robot : ContinuumRobot;
        attribute maxTipPositionError : LengthValue = 0.006 [m];
        attribute maxCurvatureError : Real = 0.08;
        doc
        /*
         * The continuum robot shall regulate its backbone shape so that commanded tip position error remains no greater than maxTipPositionError during approach, grasp, transport, and release.
         */
    }

    requirement def SafetyRequirement {
        subject supervisor : SafetySupervisor;
        attribute maxPressure : PressureValue = 350000 [Pa];
        attribute maxTension : ForceValue = 45 [N];
        doc
        /*
         * The safety supervisor shall command a fault response when pressure, tendon tension, collision distance, temperature, or emergency stop limits are violated.
         */
    }

    requirement def PayloadRequirement {
        subject robot : ContinuumRobot;
        attribute requiredPayloadForce : ForceValue = 10 [N];
        doc
        /*
         * The continuum robot and gripper shall securely manipulate task objects requiring up to requiredPayloadForce without exceeding allowable tip force or gripper contact pressure limits.
         */
    }

    requirement def ConstrainedAccessRequirement {
        subject robot : ContinuumRobot;
        attribute passageDiameter : LengthValue = 0.07 [m];
        attribute passageLength : LengthValue = 0.45 [m];
        doc
        /*
         * The continuum robot shall reach through a constrained passage with diameter no greater than passageDiameter and length no less than passageLength while maintaining obstacle clearance.
         */
    }

    part def ContinuumRoboticWorkcell {
        attribute workEnvelopeRadius : LengthValue = 0.9 [m];
        attribute primaryTaskCycleTime : TimeValue = 28 [s];

        port externalPowerIn : ElectricPowerPort;
        port compressedAirIn : PneumaticInputPort;
        port taskObjectPort : ObjectTransferPort;

        part power : PowerSubsystem;
        part pneumatics : PneumaticSubsystem;
        part controller : RobotController;
        part continuumRobot : ContinuumRobot;
        part perception : PerceptionSubsystem;
        part shapeSensing : ShapeSensingSubsystem;
        part safety : SafetySupervisor;
        part hmi : HumanMachineInterface;

        connect externalPowerIn to power.mainsIn;
        connect power.controllerOut to controller.powerIn;
        connect power.actuatorOut to continuumRobot.powerIn;
        connect power.sensorOut to perception.powerIn;
        connect power.sensorOut to shapeSensing.powerIn;
        connect power.controllerOut to safety.powerIn;
        connect power.controllerOut to hmi.powerIn;

        connect compressedAirIn to pneumatics.airIn;
        connect power.actuatorOut to pneumatics.electricalIn;
        connect pneumatics.chamberSupplyOut to continuumRobot.pneumaticIn;

        connect perception.dataOut to controller.perceptionIn;
        connect shapeSensing.shapeEstimateOut to controller.shapeFeedbackIn;
        connect shapeSensing.shapeEstimateOut to safety.shapeFeedbackIn;
        connect safety.controllerDataOut to controller.safetyIn;

        connect controller.continuumCommandOut to continuumRobot.shapeCommandIn;
        connect controller.gripperCommandOut to continuumRobot.endEffector.commandIn;
        connect controller.chamberCommandOut to continuumRobot.baseSection.chamberCommandIn;
        connect controller.chamberCommandOut to continuumRobot.middleSection.chamberCommandIn;
        connect controller.chamberCommandOut to continuumRobot.distalSection.chamberCommandIn;
        connect controller.tendonCommandOut to continuumRobot.baseSection.tendonCommandIn;
        connect controller.tendonCommandOut to continuumRobot.middleSection.tendonCommandIn;
        connect controller.tendonCommandOut to continuumRobot.distalSection.tendonCommandIn;

        connect continuumRobot.objectInterface to taskObjectPort;
    }

    satisfy PrimaryContinuumTaskRequirement by ContinuumRoboticWorkcell.continuumRobot;
    satisfy ShapeControlRequirement by ContinuumRoboticWorkcell.controller;
    satisfy SafetyRequirement by ContinuumRoboticWorkcell.safety;
    satisfy PayloadRequirement by ContinuumRoboticWorkcell.continuumRobot.endEffector;
    satisfy ConstrainedAccessRequirement by ContinuumRoboticWorkcell.continuumRobot;

    perform action InitializeSystem by ContinuumRoboticWorkcell;
    perform action PlanContinuumMotion by ContinuumRoboticWorkcell.controller;
    perform action ExecutePrimaryManipulationTask by ContinuumRoboticWorkcell.continuumRobot;
    perform action MonitorSafety by ContinuumRoboticWorkcell.safety;
}
