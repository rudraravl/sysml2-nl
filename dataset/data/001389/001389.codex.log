        connect power.actuatorOut to pneumatics.electricalIn;
        connect pneumatics.chamberSupplyOut to continuumRobot.pneumaticIn;

        connect perception.dataOut to controller.perceptionIn;
        connect shapeSensing.shapeEstimateOut to controller.shapeFeedbackIn;
        connect shapeSensing.shapeEstimateOut to safety.shapeFeedbackIn;
        connect safety.controllerDataOut to controller.safetyIn;

        connect controller.continuumCommandOut to continuumRobot.shapeCommandIn;
        connect controller.gripperCommandOut to continuumRobot.endEffector.commandIn;
        connect controller.chamberCommandOut to continuumRobot.baseSection.chamberCommandIn;
        connect controller.chamberCommandOut to continuumRobot.middleSection.chamberCommandIn;
        connect controller.chamberCommandOut to continuumRobot.distalSection.chamberCommandIn;
        connect controller.tendonCommandOut to continuumRobot.baseSection.tendonCommandIn;
        connect controller.tendonCommandOut to continuumRobot.middleSection.tendonCommandIn;
        connect controller.tendonCommandOut to continuumRobot.distalSection.tendonCommandIn;

        connect continuumRobot.objectInterface to taskObjectPort;
    }

    satisfy PrimaryContinuumTaskRequirement by ContinuumRoboticWorkcell.continuumRobot;
    satisfy ShapeControlRequirement by ContinuumRoboticWorkcell.controller;
    satisfy SafetyRequirement by ContinuumRoboticWorkcell.safety;
    satisfy PayloadRequirement by ContinuumRoboticWorkcell.continuumRobot.endEffector;
    satisfy ConstrainedAccessRequirement by ContinuumRoboticWorkcell.continuumRobot;

    perform action InitializeSystem by ContinuumRoboticWorkcell;
    perform action PlanContinuumMotion by ContinuumRoboticWorkcell.controller;
    perform action ExecutePrimaryManipulationTask by ContinuumRoboticWorkcell.continuumRobot;
    perform action MonitorSafety by ContinuumRoboticWorkcell.safety;
