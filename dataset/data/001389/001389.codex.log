        part pneumatics : PneumaticSubsystem;
        part controller : RobotController;
        part continuumRobot : ContinuumRobot;
        part perception : PerceptionSubsystem;
        part shapeSensing : ShapeSensingSubsystem;
        part safety : SafetySupervisor;
        part hmi : HumanMachineInterface;

        connect externalPowerIn to power.mainsIn;
        connect power.controllerOut to controller.powerIn;
        connect power.actuatorOut to continuumRobot.powerIn;
        connect power.sensorOut to perception.powerIn;
        connect power.sensorOut to shapeSensing.powerIn;
        connect power.controllerOut to safety.powerIn;
        connect power.controllerOut to hmi.powerIn;

