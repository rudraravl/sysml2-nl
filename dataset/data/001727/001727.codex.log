    port power : InternalPowerPort;
  }

  part def ThermalManagementSystem {
    attribute vaporChamberArea : Real = 3895.0;
    attribute nominalSkinTemperatureLimit : TemperatureValue = 43.0;
    port processorPowerTelemetry : InternalPowerPort;
    port systemData : InternalDataPort;
  }

  action def AuthenticateUser {
    in item command : UserCommand;
    out item authenticatedCommand : UserCommand;
    attribute allowed : Boolean;
  }

  action def CaptureAndProcessImage {
    in item rawFrame : ImageFrame;
    out item processedFrame : ImageFrame;
