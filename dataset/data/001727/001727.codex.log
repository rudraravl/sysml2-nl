    attribute chargingMode : ChargingMode;
    attribute throttleProcessor : Boolean;
  }

  action def PresentInteractiveExperience {
    in item applicationData : DigitalData;
    out item displayFrame : ImageFrame;
    in item userCommand : UserCommand;
    out item responseData : DigitalData;
  }

  state def SmartDeviceOperatingState {
    entry action initializeTelemetry;
    state off;
    state booting;
    state locked;
    state active;
    state cameraMode;
    state communicationMode;
    state charging;
    state lowPower;
    state thermalProtection;
    state fault;

    transition first off;
    transition off_to_booting
      first off
      then booting
      accept UserCommand
      if commandName == "powerButtonLongPress";

    transition booting_to_locked
      first booting
      then locked
      if authenticated == false;

    transition locked_to_active
      first locked
      then active
      accept UserCommand
      if authenticated == true;

    transition active_to_camera
      first active
      then cameraMode
      accept UserCommand
      if commandName == "openCamera";

    transition camera_to_active
      first cameraMode
      then active
      accept UserCommand
      if commandName == "closeCamera";

    transition active_to_communication
      first active
      then communicationMode
      accept UserCommand
      if commandName == "placeCall" or commandName == "sendData";

    transition communication_to_active
      first communicationMode
      then active
      accept UserCommand
      if commandName == "endCommunication";

    transition active_to_charging
      first active
      then charging
      if chargingMode != ChargingMode::unplugged;

    transition charging_to_active
      first charging
      then active
      if chargingMode == ChargingMode::unplugged;

    transition active_to_lowPower
      first active
      then lowPower
      if stateOfCharge < 15.0;

    transition lowPower_to_active
      first lowPower
      then active
      if stateOfCharge > 25.0;

    transition active_to_thermalProtection
      first active
      then thermalProtection
      if operatingTemperature > 43.0;

    transition thermalProtection_to_active
      first thermalProtection
      then active
      if operatingTemperature < 38.0;

    transition any_to_fault
      first active
      then fault
      if operatingTemperature > 60.0;
  }

  requirement def PrimaryFunctionRequirement {
    subject device : GalaxySmartphoneSystem;
    require constraint {
      device.providesMobileComputing == true
    }
    doc /* The system shall provide portable mobile computing by integrating communication, imaging, media, secure user interaction, application execution, and managed battery power in a handheld Samsung Electronics smartphone architecture. */
  }

  requirement def BatteryLifeRequirement {
    subject battery : BatteryPack;
    require constraint {
      battery.capacity >= 18.0
    }
  }

  requirement def SecureAccessRequirement {
    subject secureElement : SecureElement;
    require constraint {
      secureElement.trustedExecutionEnabled == true
    }
  }

  requirement def WirelessCommunicationRequirement {
    subject modem : CellularWifiBluetoothModem;
    require constraint {
      modem.wifiMaxRate >= 5.0 and modem.bluetoothVersion >= 5.0
    }
  }

  requirement def ImagingRequirement {
    subject camera : CameraSubsystem;
    require constraint {
      camera.wideCameraResolution >= 50.0 and camera.opticalStabilizationAvailable == true
    }
  }

  part def GalaxySmartphoneSystem {
    attribute brand : String = "Samsung Electronics";
    attribute productFamily : String = "Galaxy smartphone";
    attribute providesMobileComputing : Boolean = true;
    attribute mass : MassValue = 196.0;
    attribute thickness : LengthValue = 8.6;
    attribute ingressProtectionRated : Boolean = true;

    port usbC : UsbCPort;
    port wirelessChargingCoil : WirelessPowerPort;
    port cellularWifiBluetoothAntenna : RadioPort;
    port speakerMicrophoneArray : AudioPort;
    port displayAndTouchSurface : DisplayTouchPort;
    port cameraApertures : CameraPort;

    part battery : BatteryPack;
    part powerManager : PowerManagementIntegratedCircuit;
    part processor : ApplicationProcessor;
    part memory : MemorySubsystem;
    part display : DisplayAssembly;
    part cameras : CameraSubsystem;
    part modem : CellularWifiBluetoothModem;
    part audio : AudioSubsystem;
    part secureElement : SecureElement;
    part thermalSystem : ThermalManagementSystem;

    connection usb_to_powerManager connect usbC to powerManager.usbInput;
    connection wireless_to_battery connect wirelessChargingCoil to battery.wirelessChargeInput;
    connection battery_to_powerManager connect battery.powerBus to powerManager.batteryPower;
    connection powerManager_to_processor connect powerManager.systemPower to processor.power;
    connection powerManager_to_memory connect powerManager.systemPower to memory.power;
    connection powerManager_to_display connect powerManager.systemPower to display.power;
    connection powerManager_to_camera connect powerManager.systemPower to cameras.power;
    connection powerManager_to_modem connect powerManager.systemPower to modem.power;
    connection powerManager_to_audio connect powerManager.systemPower to audio.power;
    connection powerManager_to_secureElement connect powerManager.systemPower to secureElement.power;

    connection processor_to_memory connect processor.dataFabric to memory.dataFabric;
    connection processor_to_display connect processor.dataFabric to display.dataFabric;
    connection processor_to_camera connect processor.dataFabric to cameras.dataFabric;
    connection processor_to_modem connect processor.dataFabric to modem.dataFabric;
    connection processor_to_audio connect processor.dataFabric to audio.dataFabric;
    connection processor_to_secureElement connect processor.dataFabric to secureElement.dataFabric;
    connection processor_to_thermal connect processor.dataFabric to thermalSystem.systemData;

    connection display_external connect displayAndTouchSurface to display.userInterface;
    connection camera_external connect cameraApertures to cameras.cameraOut;
    connection modem_external connect cellularWifiBluetoothAntenna to modem.antenna;
    connection audio_external connect speakerMicrophoneArray to audio.acousticInterface;

    perform action authenticate : AuthenticateUser;
    perform action powerThermalControl : ManagePowerAndThermals;
    perform action mobileExperience : PresentInteractiveExperience;
    perform action imagePipeline : CaptureAndProcessImage;
    perform action communications : RouteCommunication;

    exhibit state lifecycle : SmartDeviceOperatingState;

    satisfy PrimaryFunctionRequirement by this;
    satisfy BatteryLifeRequirement by battery;
    satisfy SecureAccessRequirement by secureElement;
    satisfy WirelessCommunicationRequirement by modem;
    satisfy ImagingRequirement by cameras;
  }

  part samsungGalaxyDevice : GalaxySmartphoneSystem;

