        attribute alarmUncertaintyLimit : MeasurementUncertainty = 5.0;

        port commandOut : DigitalCommandPort;
        port dataIn : DigitalDataPort;

        action presentMeasurement {
            in item estimate : TemperatureEstimate;
            in item status : HealthStatus;

            first updateNumericDisplay;
            then evaluateAlarms;
            then logMeasurement;
            then done;

