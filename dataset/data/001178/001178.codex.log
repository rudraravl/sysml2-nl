        unit = K;
    }

    item def ExcitationPulse {
        attribute wavelength : Wavelength;
        attribute pulseEnergy : OpticalPower;
        attribute pulseWidth : TimeDuration;
        attribute repetitionRate : Frequency;
    }

    item def PhosphorescentEmission {
        attribute peakWavelength : Wavelength;
        attribute intensity : OpticalPower;
        attribute decayLifetime : TimeDuration;
        attribute backgroundLevel : OpticalPower;
    }

    item def RawDetectorSignal {
        attribute sampleCount : DigitalCount;
        attribute sampleRate : Frequency;
