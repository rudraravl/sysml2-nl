        port excitationOut : ExcitationOpticalPort;
        port emissionIn : EmissionOpticalPort;
        port emissionOut : EmissionOpticalPort;

        action routeOpticalSignals {
            in item pulse : ExcitationPulse;
            in item emissionFromTarget : PhosphorescentEmission;
            out item deliveredPulse : ExcitationPulse;
            out item filteredEmission : PhosphorescentEmission;

            first collimateExcitation;
            then rejectExcitationLeakage;
            then collectEmission;
            then passLongWavelengthEmission;
            then done;

