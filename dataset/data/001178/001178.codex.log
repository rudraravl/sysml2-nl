    part def PhosphorThermometrySystem {
        attribute primaryFunction : String =
            "Measure surface temperature without physical contact by exciting a phosphor coating with short optical pulses, collecting the temperature-dependent phosphorescent decay, and converting decay lifetime into a calibrated temperature estimate.";

        attribute measurementRangeLow : CelsiusTemperature = -40.0;
        attribute measurementRangeHigh : CelsiusTemperature = 1000.0;
        attribute targetAccuracy : MeasurementUncertainty = 2.0;
        attribute nominalMeasurementRate : Frequency = 10.0;

        part powerSupply : PowerSupply;
        part excitationSource : ExcitationSource;
        part optics : OpticalAssembly;
        part detector : Photodetector;
        part processor : SignalProcessor;
        part interface : UserInterface;
        part target : HeatedTarget;

        port externalCommandIn : DigitalCommandPort;
        port externalDataOut : DigitalDataPort;

        connect powerSupply.laserPowerOut to excitationSource.powerIn;
        connect powerSupply.detectorPowerOut to detector.powerIn;
        connect interface.commandOut to excitationSource.commandIn;
        connect interface.commandOut to processor.commandIn;
        connect externalCommandIn to excitationSource.commandIn;
        connect externalCommandIn to processor.commandIn;

        connect excitationSource.opticalOut to optics.excitationIn;
        connect optics.excitationOut to target.phosphor.excitationIn;
        connect target.phosphor.emissionOut to optics.emissionIn;
        connect optics.emissionOut to detector.emissionIn;
        connect detector.signalOut to processor.processingIn;
        connect optics.emissionOut to processor.processingIn;
        connect processor.dataOut to interface.dataIn;
        connect processor.dataOut to externalDataOut;

        action performTemperatureMeasurement {
            in item command : ControlCommand;
            out item estimate : TemperatureEstimate;
            out item status : HealthStatus;

            first acceptMeasurementCommand;
            then energizeExcitationSource;
            then deliverExcitationPulse;
            then generatePhosphorescentDecay;
            then collectFilteredEmission;
            then detectOpticalDecay;
            then computeTemperatureEstimate;
            then outputMeasurement;
            then done;

            action acceptMeasurementCommand;
            action energizeExcitationSource;
            action deliverExcitationPulse;
            action generatePhosphorescentDecay;
            action collectFilteredEmission;
            action detectOpticalDecay;
            action computeTemperatureEstimate;
            action outputMeasurement;
        }
    }

    requirement def PrimaryFunctionRequirement {
        subject system : PhosphorThermometrySystem;

        doc /* The system shall determine the temperature of a surface coated with phosphor by optically exciting the coating and processing the resulting phosphorescent decay lifetime. */

        require constraint {
            system.measurementRangeLow <= -40.0 and
            system.measurementRangeHigh >= 1000.0 and
            system.targetAccuracy <= 2.0
        }
    }

    requirement def NonContactMeasurementRequirement {
        subject system : PhosphorThermometrySystem;

        doc /* The system shall perform temperature measurement without requiring electrical or mechanical contact with the heated target surface. */

        require constraint {
            system.optics.workingDistance >= 25.0
        }
    }

    requirement def ExcitationRequirement {
        subject source : ExcitationSource;

        doc /* The excitation source shall provide short optical pulses near the phosphor absorption wavelength. */

        require constraint {
            source.centerWavelength >= 395.0 and
            source.centerWavelength <= 415.0 and
            source.maximumPulseWidth <= 0.00001
        }
    }

    requirement def EmissionDetectionRequirement {
        subject detector : Photodetector;

        doc /* The photodetector shall resolve phosphorescent decay fast enough to support lifetime-based temperature estimation. */

        require constraint {
            detector.bandwidth >= 1000000.0 and
            detector.darkNoiseRms <= 0.005
        }
    }

    requirement def SignalQualityRequirement {
        subject processor : SignalProcessor;

        doc /* The signal processor shall report normal measurements only when the detected decay signal meets the minimum signal-to-noise threshold. */

        require constraint {
            processor.minimumAcceptableSnr >= 20.0
        }
    }

    requirement def CalibrationRequirement {
        subject processor : SignalProcessor;

        doc /* The system shall convert measured phosphorescence lifetime to temperature using stored calibration coefficients for the selected phosphor material. */

        require constraint {
            processor.calibrationPolynomialC0 != 0.0 and
            processor.averagingCount >= 8
        }
    }

    requirement def SafetyRequirement {
        subject system : PhosphorThermometrySystem;

        doc /* The system shall enter a fault or degraded state when detector saturation, invalid calibration, poor signal quality, or power anomalies prevent reliable temperature reporting. */

        require constraint {
            system.detector.saturationVoltage <= 5.0 and
            system.processor.minimumAcceptableSnr >= 20.0 and
            system.powerSupply.maximumOutputPower <= 60.0
        }
    }

    satisfy PrimaryFunctionRequirement by PhosphorThermometrySystem;
    satisfy NonContactMeasurementRequirement by PhosphorThermometrySystem;
    satisfy ExcitationRequirement by ExcitationSource;
    satisfy EmissionDetectionRequirement by Photodetector;
    satisfy SignalQualityRequirement by SignalProcessor;
    satisfy CalibrationRequirement by SignalProcessor;
    satisfy SafetyRequirement by PhosphorThermometrySystem;

    part phosphorThermometer : PhosphorThermometrySystem {
        target.actualSurfaceTemperature = 650.0;
        processor.averagingCount = 32;
        nominalMeasurementRate = 10.0;
    }
}
