        attribute noiseRms : Voltage;
    }

    item def TemperatureEstimate {
        attribute temperature : CelsiusTemperature;
        attribute uncertainty : MeasurementUncertainty;
        attribute confidence : Real;
        attribute timestamp : TimeDuration;
    }

    item def ControlCommand {
        attribute enableExcitation : Boolean;
        attribute requestedSampleRate : Frequency;
        attribute requestedAveragingCount : Integer;
    }

    item def HealthStatus {
        attribute laserReady : Boolean;
        attribute detectorReady : Boolean;
        attribute calibrationValid : Boolean;
        attribute signalToNoiseRatio : SignalToNoiseRatio;
        attribute faultActive : Boolean;
    }

    port def ExcitationOpticalPort {
        out item pulse : ExcitationPulse;
    }

    port def EmissionOpticalPort {
        in item emission : PhosphorescentEmission;
    }

    port def ElectricalPowerPort {
        in attribute supplyVoltage : Voltage;
        in attribute supplyCurrent : Current;
    }

    port def DigitalCommandPort {
        in item command : ControlCommand;
    }

    port def DigitalDataPort {
        out item estimate : TemperatureEstimate;
        out item status : HealthStatus;
    }

    port def DetectorSignalPort {
        out item signal : RawDetectorSignal;
    }

    port def ProcessingInputPort {
        in item signal : RawDetectorSignal;
        in item emissionMetadata : PhosphorescentEmission;
    }

    part def PhosphorCoating {
        attribute materialName : String = "YAG:Dy phosphor";
        attribute nominalThickness : Real = 25.0;
        attribute maximumServiceTemperature : CelsiusTemperature = 1100.0;
        attribute minimumServiceTemperature : CelsiusTemperature = -40.0;
        attribute referenceLifetimeAt25C : TimeDuration = 0.0012;
        attribute activationWavelength : Wavelength = 405.0;

        port excitationIn : ExcitationOpticalPort;
        port emissionOut : EmissionOpticalPort;

        action emitTemperatureDependentLight {
            in item excitation : ExcitationPulse;
            in attribute surfaceTemperature : CelsiusTemperature;
            out item emission : PhosphorescentEmission;

            first start;
            then absorbExcitation;
            then decayEmission;
            then outputEmission;
            then done;

            action absorbExcitation;
            action decayEmission;
            action outputEmission;
        }
    }

    part def ExcitationSource {
        attribute sourceType : String = "pulsed violet diode laser";
        attribute centerWavelength : Wavelength = 405.0;
        attribute maximumPulseWidth : TimeDuration = 0.00001;
        attribute nominalRepetitionRate : Frequency = 1000.0;
        attribute nominalOpticalPower : OpticalPower = 35.0;

