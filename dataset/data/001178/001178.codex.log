            then outputVoltageTrace;
            then done;

            action receivePhotons;
            action amplifyPhotoCurrent;
            action applyAnalogFilter;
            action outputVoltageTrace;
        }
    }

    part def SignalProcessor {
        attribute adcResolutionBits : Integer = 16;
        attribute nominalSampleRate : Frequency = 1000000.0;
        attribute averagingCount : Integer = 32;
        attribute minimumAcceptableSnr : SignalToNoiseRatio = 20.0;
        attribute calibrationPolynomialC0 : Real = 650.0;
        attribute calibrationPolynomialC1 : Real = -210000.0;
        attribute calibrationPolynomialC2 : Real = 18000000.0;

        port processingIn : ProcessingInputPort;
        port commandIn : DigitalCommandPort;
        port dataOut : DigitalDataPort;

        action estimateTemperatureFromDecay {
            in item signal : RawDetectorSignal;
            in item emissionMetadata : PhosphorescentEmission;
            out item estimate : TemperatureEstimate;
            out item status : HealthStatus;

            first acquireSamples;
            then subtractBackground;
            then fitExponentialDecay;
            then convertLifetimeToTemperature;
            then assessUncertainty;
            then publishResult;
            then done;

            action acquireSamples;
            action subtractBackground;
            action fitExponentialDecay;
            action convertLifetimeToTemperature;
            action assessUncertainty;
            action publishResult;
        }

        state def MeasurementStateMachine {
            state idle;
            state armed;
            state acquiring;
            state processing;
            state reporting;
            state degraded;
            state fault;

            initial then idle;

            transition idle_to_armed first idle
                accept ControlCommand
                if command.enableExcitation
                then armed;

            transition armed_to_acquiring first armed
                then acquiring;

            transition acquiring_to_processing first acquiring
                if signal.sampleCount >= 1024
                then processing;

            transition processing_to_reporting first processing
                if status.signalToNoiseRatio >= minimumAcceptableSnr
                then reporting;

            transition processing_to_degraded first processing
                if status.signalToNoiseRatio < minimumAcceptableSnr and status.signalToNoiseRatio >= 10.0
                then degraded;

            transition degraded_to_reporting first degraded
                then reporting;

            transition reporting_to_armed first reporting
                accept ControlCommand
                if command.enableExcitation
                then armed;

            transition reporting_to_idle first reporting
                accept ControlCommand
                if not command.enableExcitation
                then idle;

            transition processing_to_fault first processing
                if signal.peakAmplitude >= 4.5 or not status.calibrationValid
                then fault;

            transition fault_to_idle first fault
                accept ControlCommand
                if not command.enableExcitation
                then idle;
        }
    }

    part def UserInterface {
