            attribute mountingHeight = 1500.0;
        }

        port rainInput : RainCollectionPort;
        port environmentInput : EnvironmentPort;
        port telemetryOutput : TelemetryOutputPort;
        port servicePort : LocalServicePort;

        connect rainInput to funnel.rainIn;
        connect funnel.waterOut to bucketSensor.waterIn;
        connect bucketSensor.tipOut to conditioner.rawTipIn;
        connect conditioner.cleanTipOut to processor.tipIn;
        connect processor.measurementOut to telemetry.measurementIn;
        connect telemetry.telemetryOut to telemetryOutput;
        connect environmentInput to environmentUnit.environmentIn;
        connect enclosure.service to servicePort;
        connect power.powerOut to processor.tipIn;

        action measureRainfall {
            in rain : RainWater;
            out measurement : RainfallMeasurement;

            first receivePrecipitation;
            then collectRainThroughFunnel;
            then convertWaterVolumeToTipEvents;
            then filterTipSignals;
            then computeRainfallDepthAndRate;
            then reportMeasurement;
            then done;

            action receivePrecipitation;
            action collectRainThroughFunnel;
            action convertWaterVolumeToTipEvents;
            action filterTipSignals;
            action computeRainfallDepthAndRate;
            action reportMeasurement;
        }

        state operatingState {
            state standby;
            state measuring;
            state reporting;
            state maintenance;
            state fault;

            transition first standby;
            transition standby then measuring accept RainWater;
            transition measuring then reporting accept RainfallMeasurement;
            transition reporting then standby;
            transition standby then maintenance accept Boolean if serviceRequested;
            transition measuring then fault if sensorFaultDetected;
            transition reporting then fault if telemetryFailureDetected;
            transition fault then standby accept Boolean if resetCommandAccepted;
            transition maintenance then standby accept Boolean if serviceComplete;
        }

        constraint serviceRequested {
            enclosure.enclosureOpen == true;
        }

        constraint sensorFaultDetected {
            processor.health == SensorHealthKind::failed or processor.health == SensorHealthKind::blocked;
        }

        constraint telemetryFailureDetected {
            telemetry.messagesSent >= 0;
        }

        constraint resetCommandAccepted {
            operational == true;
        }

        constraint serviceComplete {
            enclosure.enclosureOpen == false;
        }
    }

    requirement def PrimaryFunctionRequirement {
        subject system : RainGaugeSystem;

        doc
        /* The rain gauge system shall collect falling rain, convert the collected water volume into calibrated tip events, compute accumulated rainfall depth and rainfall intensity, and provide a timestamped rainfall measurement for local or remote monitoring. */

        require constraint {
            system.operational == true;
        }
    }

    requirement def CollectionRequirement {
        subject funnel : CollectionFunnel;

        doc
        /* The collection funnel shall direct rain entering the gauge inlet toward the tipping bucket sensor while reducing debris entry through a screen. */

        require constraint {
            funnel.debrisScreenInstalled == true and funnel.inletDiameter > 0.0;
        }
    }

    requirement def MeasurementResolutionRequirement {
        subject sensor : TippingBucketSensor;

        doc
        /* The tipping bucket sensor shall generate one tip event for each calibrated bucket volume corresponding to 0.2 millimeters of rainfall depth. */

        require constraint {
            sensor.depthPerTip.depth == 0.2 and sensor.calibrated == true;
        }
    }

    requirement def AccumulationRequirement {
        subject processor : MeasurementProcessor;

        doc
        /* The processor shall accumulate rainfall depth from accepted tip events and shall never report a negative rainfall total. */

        require constraint {
            processor.rainfallSinceReset.depth >= 0.0;
        }
    }

    requirement def IntensityRequirement {
        subject processor : MeasurementProcessor;

        doc
        /* The processor shall estimate rainfall intensity over a rolling time window using debounced tip events. */

        require constraint {
            processor.rollingWindow > 0.0[s] and processor.currentIntensity.rate >= 0.0;
        }
    }

    requirement def EnvironmentalOperatingRequirement {
        subject environmentUnit : EnvironmentalCompensationUnit;

        doc
        /* The rain gauge shall operate within the configured outdoor temperature and humidity envelope. */

        require constraint {
            environmentUnit.temperatureRangeLow.temperature <= -20.0 and
            environmentUnit.temperatureRangeHigh.temperature >= 60.0 and
            environmentUnit.humidityLimit.humidity >= 95.0;
        }
    }

    requirement def TelemetryRequirement {
        subject telemetry : TelemetryUnit;

        doc
        /* The telemetry unit shall produce messages containing station identity, rainfall measurement, battery voltage, enclosure status, and message time. */

        require constraint {
            telemetry.stationId != "";
        }
    }

    requirement def EnclosureRequirement {
        subject enclosure : Enclosure;

        doc
        /* The enclosure shall protect the electronics and sensing mechanism from outdoor ingress while allowing service access. */

        require constraint {
            enclosure.ingressProtectionRating == "IP65";
        }
    }

    satisfy PrimaryFunctionRequirement by RainGaugeSystem::measureRainfall;
    satisfy CollectionRequirement by CollectionFunnel::collectAndFocusRain;
    satisfy MeasurementResolutionRequirement by TippingBucketSensor::emitTipEvent;
    satisfy AccumulationRequirement by MeasurementProcessor::computeRainfallMeasurement;
    satisfy IntensityRequirement by MeasurementProcessor::computeRainfallMeasurement;
    satisfy EnvironmentalOperatingRequirement by EnvironmentalCompensationUnit::assessOperatingEnvironment;
    satisfy TelemetryRequirement by TelemetryUnit::packageTelemetry;
    satisfy EnclosureRequirement by Enclosure::protectComponents;

}
