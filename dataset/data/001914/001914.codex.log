        part intake {
            attribute queueDepth = 0;
            attribute rejectionThreshold = 100;
        }

        part designRepository {
            attribute storedModelCount = 12500;
            attribute maximumStorage = 750000 [MB];
            attribute currentStorageUse = 420000 [MB];
        }

        part analysisEngine {
            attribute processingLoad = 35.0 [%];
            attribute nominalPower = 6.5 [kW];
            attribute maximumPower = 11.5 [kW];
            attribute maximumThermalMargin = 45.0 [degC];
        }

        part verificationController {
            attribute minimumCoverage = 95.0 [%];
            attribute minimumConfidence = 90.0 [%];
        }

        part reportingService {
            attribute reportGenerationTime = 30 [s];
        }

        part operatorConsole {
            attribute activeUsers = 4;
            attribute displayRefreshTime = 2 [s];
        }
    }

    satisfy PrimaryFunctionRequirement by engineeringSystem;
    satisfy ThroughputRequirement by engineeringSystem;
    satisfy TimelinessRequirement by engineeringSystem;
    satisfy VerificationCoverageRequirement by engineeringSystem.verificationController;
    satisfy PowerRequirement by engineeringSystem.analysisEngine;
    satisfy StorageRequirement by engineeringSystem.designRepository;
