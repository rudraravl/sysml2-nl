    requirement def AuditCompletenessRequirement {
        doc /* The system shall record user identity, node identity, patient context, event type, timestamp, outcome, and message integrity metadata for each security-relevant transaction. */
    }

    requirement def TimeSynchronizationRequirement {
        doc /* All nodes shall maintain synchronized time with maximum drift no greater than 1000 ms to support reliable audit event ordering. */
    }

    requirement def AuditRetentionRequirement {
        doc /* The audit repository shall retain audit events for no less than 2190 days and protect stored events from unauthorized modification or deletion. */
    }

    requirement def SecureTransportRequirement {
        doc /* All clinical exchange traffic shall use encrypted transport with TLS 1.3 or a stronger approved protocol and shall reject unauthenticated peers. */
    }

    part def ATNAA_SecureClinicalExchangeSystem {
        attribute systemName : String = "Audit Trail and Node Authentication Architecture";
        attribute primaryFunction : String = "Authenticate trusted nodes, protect clinical data in transit, and maintain a complete audit trail of protected information exchanges.";

        part clinicalClient : ClinicalApplicationNode {
            attribute nodeId = "ClinicalClientNode";
            attribute organizationId = "Hospital-A";
        }

        part clinicalServer : ClinicalApplicationNode {
            attribute nodeId = "ClinicalServerNode";
            attribute organizationId = "Hospital-B";
        }

        part securityGateway : SecurityGatewayNode {
            attribute nodeId = "ATNAA-Security-Gateway";
            attribute policyVersion = "2026.06";
            attribute maximumConcurrentSessions = 5000;
        }

        part auditRepository : AuditRepository {
            attribute repositoryId = "Enterprise-Audit-Repository";
            attribute retentionPeriodDays = 2190;
            attribute availabilityTarget.value = 99.95;
        }

        part certificateAuthority : CertificateAuthority {
            attribute authorityId = "Healthcare-Trust-Anchor-CA";
            attribute certificateValidityDays = 397;
        }

        connection clientToGateway
            connect clinicalClient.secureExchange to securityGateway.secureExchange;

        connection gatewayToServer
            connect securityGateway.secureExchange to clinicalServer.secureExchange;

        connection clientAuditToRepository
            connect clinicalClient.auditSource to auditRepository.auditIngest;

        connection serverAuditToRepository
            connect clinicalServer.auditSource to auditRepository.auditIngest;

        connection gatewayAuditToRepository
            connect securityGateway.auditSource to auditRepository.auditIngest;

        connection clientCertificateValidation
            connect clinicalClient.certificateValidation to certificateAuthority.validationService;

        connection serverCertificateValidation
            connect clinicalServer.certificateValidation to certificateAuthority.validationService;

        connection gatewayCertificateValidation
            connect securityGateway.certificateValidation to certificateAuthority.validationService;

        connection clientTimeSync
            connect clinicalClient.timeSynchronization to auditRepository.timeSynchronization;

        connection serverTimeSync
            connect clinicalServer.timeSynchronization to auditRepository.timeSynchronization;

        connection gatewayTimeSync
            connect securityGateway.timeSynchronization to auditRepository.timeSynchronization;

        perform action secureExchangeBehavior : ProcessClinicalExchange;

        satisfy PrimaryFunctionRequirement by ATNAA_SecureClinicalExchangeSystem;
        satisfy MutualNodeAuthenticationRequirement by securityGateway;
        satisfy MutualNodeAuthenticationRequirement by clinicalClient;
        satisfy MutualNodeAuthenticationRequirement by clinicalServer;
        satisfy AuditCompletenessRequirement by auditRepository;
        satisfy TimeSynchronizationRequirement by clinicalClient.clock;
        satisfy TimeSynchronizationRequirement by clinicalServer.clock;
        satisfy TimeSynchronizationRequirement by securityGateway.clock;
        satisfy AuditRetentionRequirement by auditRepository.immutableLogStore;
        satisfy SecureTransportRequirement by securityGateway.tlsEndpoint;
