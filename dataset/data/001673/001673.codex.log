        then Idle
        if connectivity == ConnectivityState::connected;

      transition Idle
        then Fault
        if power.supplyVoltage < 18.0;

      transition Heating
        then Fault
        if power.supplyVoltage < 18.0;

      transition Cooling
        then Fault
        if power.supplyVoltage < 18.0;
    }
  }

  part def ClimateControlProcessor {
    attribute processorTemperature : Temperature;
    attribute controlLoopPeriod : Duration = 5.0;
    attribute commandLatency : Duration;
    port sensorTemperature : TemperatureSensorPort;
    port sensorHumidity : HumiditySensorPort;
    port sensorOccupancy : OccupancySensorPort;
    port commandOutput : HVACEquipmentPort;
  }

  part def ScheduleLearningEngine {
    attribute observationWindow : Duration = 1209600.0;
    attribute learnedScheduleConfidence : OccupancyConfidence;
    attribute ecoThresholdAwayDuration : Duration = 1800.0;
    port occupancyInput : OccupancySensorPort;
    port cloudSchedulePort : CloudServicePort;
  }

  part def ConnectivityModule {
    attribute wifiSignalStrength : Real;
    attribute encryptedTransportEnabled : Boolean = true;
    attribute reconnectInterval : Duration = 30.0;
    attribute state : ConnectivityState;
    port cloudPort : CloudServicePort;
  }

  part def UserDisplay {
    attribute displayBrightness : Real;
    attribute touchEnabled : Boolean = true;
    attribute farSightEnabled : Boolean = true;
    port uiPort : UserInterfacePort;
  }

  part def EquipmentSafetySupervisor {
    attribute compressorShortCycleProtection : Boolean = true;
    attribute furnaceOverrunProtection : Boolean = true;
    attribute maxContinuousHeatRunTime : Duration = 14400.0;
    attribute maxContinuousCoolRunTime : Duration = 14400.0;
    port hvacSafetyPort : HVACEquipmentPort;
  }

  part def IndoorTemperatureSensor {
    attribute accuracy : Temperature = 0.2;
    attribute samplePeriod : Duration = 2.0;
    port sampleOut : TemperatureSensorPort;
  }

  part def IndoorHumiditySensor {
    attribute accuracy : RelativeHumidity = 3.0;
    attribute samplePeriod : Duration = 10.0;
    port sampleOut : HumiditySensorPort;
  }

  part def PresenceDetector {
    attribute infraredRangeMeters : Real = 6.0;
    attribute confidenceThreshold : OccupancyConfidence = 75.0;
    port occupancyOut : OccupancySensorPort;
  }

  part def NestProtectAirSafetySensor {
    attribute smokeAlarmIntegrated : Boolean = true;
    attribute carbonMonoxideAlarmIntegrated : Boolean = true;
    port airQualityOut : AirQualitySensorPort;
  }

  part def ResidentialHVACPlant {
    attribute heatCapacity : Power = 10000.0;
    attribute coolingCapacity : Power = 9000.0;
    attribute fanPower : Power = 500.0;
    attribute humidifierPower : Power = 250.0;
    port equipmentControl : HVACEquipmentPort;
    port powerInput : PowerPort;

    part furnace;
    part airConditionerCompressor;
    part blowerFan;
    part humidifier;
  }

  part def NestCloudService {
    attribute remoteAccessAvailable : Boolean = true;
    attribute analyticsRetentionDays : Integer = 395;
    attribute encryptedAtRest : Boolean = true;
    port thermostatCloudPort : CloudServicePort;
  }

  part def MobileApplication {
    attribute authenticatedUser : Boolean;
    attribute geofenceEnabled : Boolean;
    attribute pushNotificationsEnabled : Boolean;
    port cloudAccess : CloudServicePort;
    port userPreferencePort : UserInterfacePort;
  }

  part def HomeElectricalSupply {
    attribute nominalVoltage : Voltage = 24.0;
    attribute maxCurrent : Current = 1.0;
    port thermostatPower : PowerPort;
    port equipmentPower : PowerPort;
  }

  part def NestLabsHomeClimateSystem {
    doc /* Primary function: maintain residential comfort and energy efficiency by sensing indoor conditions and occupancy, learning occupant preferences, commanding HVAC equipment, and enabling local and cloud-based user control. */

    attribute desiredComfortBandLow : Temperature = 19.0;
    attribute desiredComfortBandHigh : Temperature = 24.0;
    attribute dailyEnergyBudget : Energy = 35.0;
    attribute remoteControlEnabled : Boolean = true;

    part thermostat : NestLearningThermostat;
    part temperatureSensor : IndoorTemperatureSensor;
    part humiditySensor : IndoorHumiditySensor;
    part presenceDetector : PresenceDetector;
    part safetySensor : NestProtectAirSafetySensor;
    part hvacPlant : ResidentialHVACPlant;
    part cloudService : NestCloudService;
    part mobileApp : MobileApplication;
    part electricalSupply : HomeElectricalSupply;

    connect temperatureSensor.sampleOut to thermostat.temperatureIn;
    connect humiditySensor.sampleOut to thermostat.humidityIn;
    connect presenceDetector.occupancyOut to thermostat.occupancyIn;
    connect safetySensor.airQualityOut to thermostat.airQualityIn;
    connect thermostat.hvacOut to hvacPlant.equipmentControl;
    connect thermostat.cloud to cloudService.thermostatCloudPort;
    connect mobileApp.cloudAccess to cloudService.thermostatCloudPort;
    connect thermostat.userInterface to mobileApp.userPreferencePort;
    connect electricalSupply.thermostatPower to thermostat.power;
    connect electricalSupply.equipmentPower to hvacPlant.powerInput;
  }

  requirement def MaintainComfort {
    subject system : NestLabsHomeClimateSystem;
    require constraint {
      system.thermostat.currentTemperature >= system.desiredComfortBandLow and
      system.thermostat.currentTemperature <= system.desiredComfortBandHigh
    }
  }

  requirement def ReduceEnergyUseWhenAway {
    subject system : NestLabsHomeClimateSystem;
    require constraint {
      system.thermostat.occupied == false implies
      system.thermostat.activeMode == HVACMode::eco
    }
  }

  requirement def ProtectHVACEquipment {
    subject thermostat : NestLearningThermostat;
    require constraint {
      thermostat.minimumCompressorOffTime >= 300.0
    }
  }

  requirement def EnableRemoteControl {
    subject system : NestLabsHomeClimateSystem;
    require constraint {
      system.remoteControlEnabled implies
      system.thermostat.connectivity == ConnectivityState::connected
    }
  }

  requirement def UseEncryptedCloudCommunication {
    subject module : ConnectivityModule;
    require constraint {
      module.encryptedTransportEnabled == true
    }
  }

  requirement def ProvideEnergyFeedback {
    subject system : NestLabsHomeClimateSystem;
    require constraint {
      system.dailyEnergyBudget > 0.0
    }
  }

  satisfy MaintainComfort by NestLabsHomeClimateSystem::thermostat;
  satisfy ReduceEnergyUseWhenAway by NestLabsHomeClimateSystem::thermostat;
  satisfy ProtectHVACEquipment by NestLearningThermostat::safetySupervisor;
  satisfy EnableRemoteControl by NestLabsHomeClimateSystem::cloudService;
  satisfy UseEncryptedCloudCommunication by ConnectivityModule;
  satisfy ProvideEnergyFeedback by NestLearningThermostat::PublishEnergySummary;
}
