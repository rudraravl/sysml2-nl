  requirement def ProtectHVACEquipment {
    subject thermostat : NestLearningThermostat;
    require constraint {
      thermostat.minimumCompressorOffTime >= 300.0
    }
  }

  requirement def EnableRemoteControl {
    subject system : NestLabsHomeClimateSystem;
    require constraint {
      system.remoteControlEnabled implies
      system.thermostat.connectivity == ConnectivityState::connected
    }
  }

  requirement def UseEncryptedCloudCommunication {
    subject module : ConnectivityModule;
    require constraint {
      module.encryptedTransportEnabled == true
    }
  }

  requirement def ProvideEnergyFeedback {
    subject system : NestLabsHomeClimateSystem;
    require constraint {
      system.dailyEnergyBudget > 0.0
    }
  }

  satisfy MaintainComfort by NestLabsHomeClimateSystem::thermostat;
  satisfy ReduceEnergyUseWhenAway by NestLabsHomeClimateSystem::thermostat;
  satisfy ProtectHVACEquipment by NestLearningThermostat::safetySupervisor;
  satisfy EnableRemoteControl by NestLabsHomeClimateSystem::cloudService;
  satisfy UseEncryptedCloudCommunication by ConnectivityModule;
  satisfy ProvideEnergyFeedback by NestLearningThermostat::PublishEnergySummary;
}
