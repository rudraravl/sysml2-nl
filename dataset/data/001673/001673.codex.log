  item def TemperatureSample {
    attribute measuredTemperature : Temperature;
    attribute sampleAge : Duration;
    attribute sensorHealth : Real;
  }

  item def HumiditySample {
    attribute measuredHumidity : RelativeHumidity;
    attribute sampleAge : Duration;
  }

  item def OccupancySample {
    attribute occupied : Boolean;
    attribute confidence : OccupancyConfidence;
    attribute sampleAge : Duration;
  }

  item def AirQualitySample {
    attribute index : AirQualityIndex;
    attribute volatileOrganicCompoundsPresent : Boolean;
    attribute smokeDetected : Boolean;
  }

  item def UserPreference {
    attribute targetHeatTemperature : Temperature;
    attribute targetCoolTemperature : Temperature;
    attribute selectedMode : HVACMode;
    attribute selectedFanMode : FanMode;
    attribute ecoEnabled : Boolean;
  }

  item def ScheduleProfile {
    attribute weekdayWakeTemperature : Temperature;
    attribute weekdayAwayTemperature : Temperature;
    attribute weekdaySleepTemperature : Temperature;
    attribute weekendWakeTemperature : Temperature;
    attribute weekendAwayTemperature : Temperature;
    attribute weekendSleepTemperature : Temperature;
  }

  item def HVACControlSignal {
    attribute command : EquipmentCommand;
    attribute requestedMode : HVACMode;
    attribute requestedFanMode : FanMode;
    attribute minimumRunTime : Duration;
  }

  item def EnergyReport {
    attribute heatingEnergyUsed : Energy;
    attribute coolingEnergyUsed : Energy;
    attribute fanEnergyUsed : Energy;
    attribute ecoSavingsEstimate : Energy;
  }

  item def CloudMessage {
    attribute messageId : String;
    attribute encrypted : Boolean;
    attribute payloadValid : Boolean;
  }

  port def TemperatureSensorPort {
    out item temperatureSample : TemperatureSample;
  }

  port def HumiditySensorPort {
    out item humiditySample : HumiditySample;
  }

  port def OccupancySensorPort {
    out item occupancySample : OccupancySample;
  }

  port def AirQualitySensorPort {
    out item airQualitySample : AirQualitySample;
  }

  port def UserInterfacePort {
    in item preferenceInput : UserPreference;
    out item displayedTemperature : TemperatureSample;
    out item displayedEnergyReport : EnergyReport;
  }

  port def HVACEquipmentPort {
    out item controlSignal : HVACControlSignal;
    in item equipmentStatus : HVACControlSignal;
  }

  port def CloudServicePort {
    in item outboundMessage : CloudMessage;
    out item inboundPreference : UserPreference;
    out item inboundSchedule : ScheduleProfile;
  }

  port def PowerPort {
    in attribute supplyVoltage : Voltage;
    in attribute supplyCurrent : Current;
    out attribute consumedPower : Power;
  }

  part def NestLearningThermostat {
    attribute currentTemperature : Temperature;
    attribute currentHumidity : RelativeHumidity;
    attribute targetHeatTemperature : Temperature;
    attribute targetCoolTemperature : Temperature;
    attribute activeMode : HVACMode;
    attribute fanMode : FanMode;
    attribute occupied : Boolean;
    attribute learnedScheduleValid : Boolean;
    attribute connectivity : ConnectivityState;
    attribute controlDeadband : Temperature = 0.5;
    attribute minimumCompressorOffTime : Duration = 300.0;
    attribute nominalPowerDraw : Power = 3.0;

    port temperatureIn : TemperatureSensorPort;
    port humidityIn : HumiditySensorPort;
    port occupancyIn : OccupancySensorPort;
    port airQualityIn : AirQualitySensorPort;
    port userInterface : UserInterfacePort;
    port hvacOut : HVACEquipmentPort;
    port cloud : CloudServicePort;
    port power : PowerPort;

    part embeddedController : ClimateControlProcessor;
    part learningEngine : ScheduleLearningEngine;
    part wirelessModule : ConnectivityModule;
    part displayAssembly : UserDisplay;
    part safetySupervisor : EquipmentSafetySupervisor;

    action def SenseIndoorEnvironment {
      in item temperatureSample : TemperatureSample;
      in item humiditySample : HumiditySample;
      in item occupancySample : OccupancySample;
      out attribute sensedTemperature : Temperature;
      out attribute sensedHumidity : RelativeHumidity;
      out attribute sensedOccupied : Boolean;
    }

    action def SelectComfortTarget {
      in item preference : UserPreference;
      in item schedule : ScheduleProfile;
      in attribute occupied : Boolean;
      out attribute heatTarget : Temperature;
      out attribute coolTarget : Temperature;
      out attribute mode : HVACMode;
    }

    action def ComputeHVACCommand {
      in attribute sensedTemperature : Temperature;
      in attribute heatTarget : Temperature;
      in attribute coolTarget : Temperature;
      in attribute selectedMode : HVACMode;
      out item command : HVACControlSignal;
    }

    action def PublishEnergySummary {
      in item command : HVACControlSignal;
      in attribute runtime : Duration;
      out item report : EnergyReport;
    }

    state def ThermostatOperatingState {
      state initial Provisioning;
      state Idle;
      state Heating;
      state Cooling;
      state Eco;
      state EquipmentProtection;
      state OfflineControl;
      state Fault;

      transition first Provisioning
        then Idle
        accept CloudMessage
        if inboundPreference.payloadValid;

      transition Idle
        then Heating
        if activeMode == HVACMode::heat and currentTemperature < targetHeatTemperature - controlDeadband;

      transition Idle
        then Cooling
        if activeMode == HVACMode::cool and currentTemperature > targetCoolTemperature + controlDeadband;

      transition Idle
        then Eco
        if activeMode == HVACMode::eco or occupied == false;

      transition Heating
        then Idle
        if currentTemperature >= targetHeatTemperature;

      transition Cooling
        then Idle
        if currentTemperature <= targetCoolTemperature;

      transition Cooling
        then EquipmentProtection
        if minimumCompressorOffTime > 0.0;

      transition EquipmentProtection
        then Idle
        after minimumCompressorOffTime;

      transition Idle
        then OfflineControl
        if connectivity == ConnectivityState::disconnected;

