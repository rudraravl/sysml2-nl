        port flowInput : SignalPort;
        port temperatureInput : SignalPort;

        attribute pressureSetpoint : Pressure = 1.2e7;
        attribute flowSetpoint : FlowRate = 0.001;
        attribute overTemperatureLimit : Temperature = 353.15;
        attribute lowFlowLimit : FlowRate = 0.0002;
        attribute activeFault : Boolean;
        attribute subsystemRunning : Boolean;

        constraint commandPropagation {
            motorCommand.startCommand == commandInterface.startCommand;
            pumpCommand.startCommand == commandInterface.startCommand;
            motorCommand.stopCommand == commandInterface.stopCommand;
            pumpCommand.stopCommand == commandInterface.stopCommand;
            pumpCommand.demandedFlow == flowSetpoint;
            pumpCommand.demandedPressure == pressureSetpoint;
        }

        state def ControllerState {
            state idle;
            state starting;
            state regulating;
            state shutdown;
            state fault;

            transition first idle;

            transition start
                first idle
                then starting
                accept commandInterface.startCommand;

            transition regulate
                first starting
                then regulating
                if pressureInput.pressureSignal >= pressureSetpoint * 0.9;

            transition commandedStop
                first regulating
                then shutdown
                accept commandInterface.stopCommand;

            transition stopped
                first shutdown
                then idle
                if flowInput.flowSignal <= 1.0e-5;

            transition overTemperature
                first regulating
                then fault
                if temperatureInput.temperatureSignal >= overTemperatureLimit;

            transition lowFlow
                first regulating
                then fault
                if flowInput.flowSignal <= lowFlowLimit;

            transition faultReset
                first fault
                then idle
                accept commandInterface.stopCommand;
        }

        action def regulatePump {
            in measuredPressure : Pressure;
            in measuredFlow : FlowRate;
            in requestedPressure : Pressure;
            in requestedFlow : FlowRate;
            out startMotor : Boolean;
            out faultDetected : Boolean;
        }
    }

    part def HydraulicLoad {
        port inlet : FluidPort;
        port returnOutlet : FluidPort;

        attribute requiredPressure : Pressure = 1.0e7;
        attribute nominalDemandFlow : FlowRate = 0.0009;
        attribute loadRestriction : Real { unit = "Pa/(m^3/s)"; } = 1.1e10;

        constraint demandPressure {
            inlet.pressure - returnOutlet.pressure == loadRestriction * inlet.flowRate;
        }
    }

    part def PumpingSubsystem {
        port electricalSupply : PowerPort;
        port command : ControlPort;
        port processFluidOutlet : FluidPort;
        port returnFluidInlet : FluidPort;

        part reservoir : SuctionReservoir;
        part inletFilter : Filter;
        part driveMotor : ElectricMotor;
        part pump : HydraulicPump;
        part dischargeCheckValve : CheckValve;
        part manifold : DischargeManifold;
        part reliefValve : ReliefValve;
        part pressureSensor : PressureSensor;
        part flowSensor : FlowSensor;
        part temperatureSensor : TemperatureSensor;
        part controller : PumpController;
        part hydraulicLoad : HydraulicLoad;

        attribute subsystemRatedPressure : Pressure = 1.6e7;
        attribute subsystemRatedFlow : FlowRate = 0.00125;
        attribute maximumAllowablePressure : Pressure = 1.84e7;
        attribute minimumSuctionPressure : Pressure = 1.0e5;
        attribute maximumFluidTemperature : Temperature = 353.15;
        attribute normalElectricalVoltage : Real { unit = "V"; } = 480.0;

        connect electricalSupply to driveMotor.electricalInput;
        connect command to controller.commandInterface;
        connect controller.motorCommand to driveMotor.command;
        connect controller.pumpCommand to pump.command;
        connect driveMotor.shaftOutput to pump.shaft;

        connect reservoir.outlet to inletFilter.inlet;
        connect inletFilter.outlet to pump.suction;
        connect pump.discharge to dischargeCheckValve.inlet;
        connect dischargeCheckValve.outlet to manifold.inlet;
        connect manifold.serviceOutlet to processFluidOutlet;
        connect manifold.serviceOutlet to hydraulicLoad.inlet;
        connect hydraulicLoad.returnOutlet to returnFluidInlet;
        connect manifold.reliefReturn to reliefValve.inlet;
        connect reliefValve.returnPort to reservoir.outlet;

        connect manifold.inlet to pressureSensor.sensedPort;
        connect manifold.serviceOutlet to flowSensor.sensedPort;
        connect pump.discharge to temperatureSensor.sensedPort;

        connect pressureSensor.signal to controller.pressureInput;
        connect flowSensor.signal to controller.flowInput;
        connect temperatureSensor.signal to controller.temperatureInput;

        constraint ratedPerformance {
            pump.ratedFlow >= subsystemRatedFlow;
            pump.ratedPressureRise >= subsystemRatedPressure;
        }

        constraint pressureProtection {
            reliefValve.crackingPressure <= maximumAllowablePressure;
        }

        constraint suctionProtection {
            pump.suction.pressure >= minimumSuctionPressure;
        }

        constraint temperatureProtection {
            pump.discharge.temperature <= maximumFluidTemperature;
        }

        action def startSubsystem {
            in startRequest : Boolean;
            out running : Boolean;
        }

        action def stopSubsystem {
            in stopRequest : Boolean;
            out stopped : Boolean;
        }

        action def deliverHydraulicFlow {
            in commandedFlow : FlowRate;
            in commandedPressure : Pressure;
            out deliveredFlow : FlowRate;
            out deliveredPressure : Pressure;
        }

        state def PumpingSubsystemState {
            state deenergized;
            state standby;
            state priming;
            state pressurizing;
            state deliveringFlow;
            state controlledShutdown;
            state protectiveTrip;

            transition first deenergized;

            transition powerAvailable
                first deenergized
                then standby
                if electricalSupply.powerIn.voltage >= normalElectricalVoltage * 0.9;

            transition startCommanded
                first standby
                then priming
                accept command.startCommand;

            transition primeComplete
                first priming
                then pressurizing
                if pump.suction.pressure >= minimumSuctionPressure;

            transition pressureAvailable
                first pressurizing
                then deliveringFlow
                if manifold.serviceOutlet.pressure >= controller.pressureSetpoint * 0.9;

            transition stopCommanded
                first deliveringFlow
                then controlledShutdown
                accept command.stopCommand;

            transition shutdownComplete
                first controlledShutdown
                then standby
                if manifold.serviceOutlet.flowRate <= 1.0e-5;

            transition tripOnOverpressure
                first deliveringFlow
                then protectiveTrip
                if manifold.inlet.pressure >= maximumAllowablePressure;

            transition tripOnHighTemperature
                first deliveringFlow
                then protectiveTrip
                if pump.discharge.temperature >= maximumFluidTemperature;

            transition tripOnLowSuction
                first deliveringFlow
                then protectiveTrip
                if pump.suction.pressure < minimumSuctionPressure;

            transition resetTrip
                first protectiveTrip
                then standby
                accept command.stopCommand;
        }
    }

    requirement def MoveFluidRequirement {
        subject subsystem : PumpingSubsystem;

        require constraint {
            subsystem.processFluidOutlet.flowRate >= 0.001;
        }

        require constraint {
            subsystem.processFluidOutlet.pressure >= 1.0e7;
        }
    }

    requirement def HydraulicPumpRequirement {
        subject pump : HydraulicPump;

        require constraint {
            pump.ratedFlow >= 0.00125;
        }

        require constraint {
            pump.ratedPressureRise >= 1.6e7;
        }

        require constraint {
            pump.volumetricEfficiency >= 0.90;
        }
    }

    requirement def SafetyProtectionRequirement {
        subject subsystem : PumpingSubsystem;

        require constraint {
            subsystem.reliefValve.crackingPressure <= subsystem.maximumAllowablePressure;
        }

        require constraint {
            subsystem.pump.suction.pressure >= subsystem.minimumSuctionPressure;
        }

        require constraint {
            subsystem.pump.discharge.temperature <= subsystem.maximumFluidTemperature;
        }
    }

    requirement def ControlRequirement {
        subject controller : PumpController;

        require constraint {
            controller.pressureSetpoint <= 1.6e7;
        }

        require constraint {
            controller.flowSetpoint <= 0.00125;
        }

        require constraint {
            controller.activeFault == true implies controller.subsystemRunning == false;
        }
    }

    satisfy MoveFluidRequirement by PumpingSubsystem;
    satisfy HydraulicPumpRequirement by HydraulicPump;
    satisfy SafetyProtectionRequirement by PumpingSubsystem;
    satisfy ControlRequirement by PumpController;

    part pumpingSubsystem : PumpingSubsystem {
        attribute subsystemRatedPressure = 1.6e7;
        attribute subsystemRatedFlow = 0.00125;
        attribute maximumAllowablePressure = 1.84e7;
        attribute minimumSuctionPressure = 1.0e5;
        attribute maximumFluidTemperature = 353.15;
    }
}
