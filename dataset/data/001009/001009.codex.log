            in width = outputWidth;
            in height = outputHeight;
            out frame = imageOut.frame;
        }
    }

    part def ChargeCoupledDeviceCamera {
        attribute primaryFunction : String = "Convert an optical image into an ordered digital image frame by accumulating photo-generated charge in an array of pixels, transferring that charge through coupled potential wells, sensing it as analog voltage, and digitizing the result.";
        attribute nominalWidth : PixelCount = 4096;
        attribute nominalHeight : PixelCount = 3072;
        attribute nominalFrameRate : FrameRate;
        attribute nominalIntegrationTime : TimeDuration;
        attribute operatingTemperature : Temperature;

        port opticalInput : OpticalInputPort;
        port controlInput : ControlInputPort;
        port powerInput : PowerInputPort;
        port digitalImageOutput : DigitalImageOutputPort;
        port thermalPort : ThermalPort;

        part microlenses : MicrolensArray {
            attribute lensCount = 12582912;
        }

        part filters : ColorFilterArray;

        part imagingArray : ImagingArray {
            attribute rowCount = 3072;
            attribute columnCount = 4096;
            attribute pixelPitch = 4.5;
            attribute activeAreaWidth = 18.432;
            attribute activeAreaHeight = 13.824;
        }

        part verticalRegister : VerticalShiftRegister;
        part serialRegister : HorizontalSerialRegister;
        part outputNode : FloatingDiffusionOutputNode {
            attribute capacitance = 0.00000000000002;
            attribute conversionGain = 0.000006;
        }

        part sampler : CorrelatedDoubleSampler;
        part adc : AnalogToDigitalConverter {
            attribute bitDepth = 14;
        }

        part controller : TimingAndClockController;
        part powerConditioner : BiasAndPowerConditioner;
        part thermalControl : ThermalControl;

        part frameFormatter : ImageFrameFormatter {
            attribute outputWidth = 4096;
            attribute outputHeight = 3072;
            attribute bitDepth = 14;
        }

        connect opticalInput to microlenses.opticalIn;
        connect microlenses.opticalOut to filters.opticalIn;
        connect filters.opticalOut to imagingArray.opticalIn;

        connect controlInput to controller.controlIn;
        connect powerInput to powerConditioner.powerIn;
        connect powerConditioner.thermalOut to thermalControl.thermalInterface;
        connect thermalControl.thermalInterface to thermalPort;

        connect controller.clockOut.verticalPhase1 to verticalRegister.verticalClock1;
        connect controller.clockOut.verticalPhase2 to verticalRegister.verticalClock2;
        connect controller.clockOut.horizontalPhase1 to serialRegister.horizontalClock1;
        connect controller.clockOut.horizontalPhase2 to serialRegister.horizontalClock2;

        connect imagingArray.parallelChargePackets to verticalRegister.arrayChargePackets;
        connect verticalRegister.serialRegisterPackets to serialRegister.serialRegisterPackets;
        connect serialRegister.outputChargePacket to outputNode.inputChargePacket;
        connect outputNode.analogPixelSignal to sampler.rawAnalogPixelSignal;
        connect sampler.correctedAnalogPixelSignal to adc.analogPixelSignal;
        connect adc.digitalPixelSample to frameFormatter.digitalSamples;
        connect frameFormatter.imageOut to digitalImageOutput;
    }

    requirement def CCDPrimaryFunctionRequirement {
        subject ccd : ChargeCoupledDeviceCamera;

        require constraint {
            ccd.primaryFunction == "Convert an optical image into an ordered digital image frame by accumulating photo-generated charge in an array of pixels, transferring that charge through coupled potential wells, sensing it as analog voltage, and digitizing the result."
        }

        doc /* The charge-coupled device system shall perform high-level image acquisition by converting incident optical energy into spatially ordered digital pixel values. */
    }

    requirement def PhotonToChargeRequirement {
        subject pixel : PhotodiodePixel;

        require constraint {
            pixel.quantumEfficiency >= 0.35 and pixel.fullWellCapacity.value >= 0.000000000008
        }

        doc /* Each active pixel shall accumulate photoelectron charge proportional to incident photon flux during the exposure interval. */
    }

    requirement def ChargeTransferRequirement {
        subject register : VerticalShiftRegister;

        require constraint {
            register.transferEfficiency >= 0.99999
        }

        doc /* The charge transfer structure shall move accumulated charge packets with sufficiently high efficiency to preserve image information. */
    }

    requirement def DigitizationRequirement {
        subject converter : AnalogToDigitalConverter;

        require constraint {
            converter.bitDepth >= 12
        }

        doc /* The analog-to-digital converter shall digitize sensed pixel voltages with enough resolution for scientific or imaging use. */
    }

    requirement def ThermalOperatingRequirement {
        subject thermalControl : ThermalControl;

        require constraint {
            thermalControl.maximumAllowedTemperature.value <= 313.15
        }

        doc /* The CCD system shall monitor and control thermal conditions to limit dark current and protect device operation. */
    }

    requirement def FrameFormationRequirement {
        subject formatter : ImageFrameFormatter;

        require constraint {
            formatter.outputWidth.value == 4096 and formatter.outputHeight.value == 3072 and formatter.bitDepth == 14
        }

        doc /* The system shall assemble digitized samples into a complete ordered image frame matching the sensor geometry. */
    }

    satisfy CCDPrimaryFunctionRequirement by ChargeCoupledDeviceCamera;
    satisfy PhotonToChargeRequirement by PhotodiodePixel;
    satisfy ChargeTransferRequirement by VerticalShiftRegister;
    satisfy DigitizationRequirement by AnalogToDigitalConverter;
    satisfy ThermalOperatingRequirement by ThermalControl;
    satisfy FrameFormationRequirement by ImageFrameFormatter;

}
