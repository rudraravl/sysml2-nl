        connect imageProcessor.imageFrame to studyStorage.frameInput;
        connect display.videoOutput to imageOut.frame;
        connect safetyMonitor.safetyStatus to safetyOut.status;
        connect safetyMonitor.outputLimitCommand to imagingController.safetyLimitCommand;
