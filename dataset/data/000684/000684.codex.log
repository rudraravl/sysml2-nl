    }

    requirement def DataStorageRequirement {
        doc /* The system shall store frozen ultrasound image frames and associated study metadata in encrypted local storage and support export using a clinical imaging format. */
    }

    requirement primaryFunctionReq : PrimaryFunctionRequirement;
    requirement acousticSafetyReq : AcousticSafetyRequirement;
    requirement imageQualityReq : ImageQualityRequirement;
    requirement patientContactReq : PatientContactRequirement;
    requirement dataStorageReq : DataStorageRequirement;

    satisfy primaryFunctionReq by MedicalUltrasoundSystem;
    satisfy acousticSafetyReq by MedicalUltrasoundSystem::safetyMonitor;
    satisfy imageQualityReq by MedicalUltrasoundSystem::beamformer;
    satisfy imageQualityReq by MedicalUltrasoundSystem::imageProcessor;
    satisfy patientContactReq by MedicalUltrasoundSystem::safetyMonitor;
    satisfy dataStorageReq by MedicalUltrasoundSystem::studyStorage;
}
