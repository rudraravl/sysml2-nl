                in pulse : AcousticPulse;
            }

            action receiveEchoSignals {
                out echo : EchoSignal;
            }

            action beamformEchoData {
                in echo : EchoSignal;
                out data : BeamformedData;
            }

            action processImageFrame {
                in data : BeamformedData;
                out image : UltrasoundImageFrame;
            }

            action updateSafetyStatus {
                in pulse : AcousticPulse;
                in contact : PatientContactStatus;
                out status : SafetyStatus;
            }

            action outputImage {
                in image : UltrasoundImageFrame;
            }
        }
    }

    part def MedicalPowerSupply {
        port inputPower : PowerInputPort;
        out item regulatedPower : ElectricalPower;
        attribute leakageCurrentLimit_mA : Real = 0.1;
        attribute outputVoltage : Voltage_V = 24.0;
    }

    part def OperatorConsole {
        in item operatorCommand : ControlCommand;
        in item power : ElectricalPower;
        out item validatedCommand : ControlCommand;
        attribute supportsTouchInput : Boolean = true;
        attribute supportsProbeSelection : Boolean = true;
    }

    part def ImagingController {
        in item power : ElectricalPower;
        in item controlCommand : ControlCommand;
        in item safetyLimitCommand : ControlCommand;
        out item txSequence : AcousticPulse;
        attribute activeMode : ImagingMode = ImagingMode::BMode;
        attribute transmitFrequency : FrequencyMHz = 5.0;
        attribute imagingDepth : Depth_mm = 160.0;
    }

    part def PulserReceiver {
        in item power : ElectricalPower;
        in item transmitSequence : AcousticPulse;
        in item receivedEcho : EchoSignal;
        out item drivePulse : ElectricalPower;
        out item digitizedEcho : EchoSignal;
        attribute transmitVoltage : Voltage_V = 80.0;
        attribute receiveGain_dB : Real = 42.0;
        attribute analogToDigitalResolution_bits : Integer = 14;
    }

    part def UltrasoundProbe {
        in item electricalDrive : ElectricalPower;
        in item echoAcousticInput : EchoSignal;
        in item patientEchoInput : EchoSignal;
        out item acousticPulse : AcousticPulse;
        out item patientAcousticOutput : AcousticPulse;
        out item rawEchoSignal : EchoSignal;
        attribute elementCount : Integer = 128;
        attribute centerFrequency : FrequencyMHz = 5.0;
        attribute apertureWidth_mm : Real = 38.0;
        attribute maximumSurfaceTemperature : Temperature_C = 43.0;
    }

    part def DigitalBeamformer {
        in item power : ElectricalPower;
        in item echoSamples : EchoSignal;
        out item beamformedOutput : BeamformedData;
        attribute receiveChannelCount : Integer = 128;
        attribute dynamicReceiveFocusingEnabled : Boolean = true;
        attribute nominalAxialResolution : Resolution_mm = 0.6;
        attribute nominalLateralResolution : Resolution_mm = 1.2;
    }

    part def ImageProcessor {
        in item power : ElectricalPower;
        in item beamformedInput : BeamformedData;
        out item imageFrame : UltrasoundImageFrame;
        attribute speckleReductionEnabled : Boolean = true;
        attribute timeGainCompensationEnabled : Boolean = true;
        attribute grayscaleDynamicRange_dB : Real = 72.0;
    }

    part def DiagnosticDisplay {
        in item power : ElectricalPower;
        in item imageFrameInput : UltrasoundImageFrame;
        out item videoOutput : UltrasoundImageFrame;
        attribute displaySize_in : Real = 15.6;
        attribute luminance_cd_per_m2 : Real = 400.0;
        attribute resolutionHorizontal_px : Integer = 1920;
        attribute resolutionVertical_px : Integer = 1080;
    }

    part def AcousticSafetyMonitor {
        in item power : ElectricalPower;
        in item patientContact : PatientContactStatus;
        out item safetyStatus : SafetyStatus;
        out item outputLimitCommand : ControlCommand;
        attribute maximumMechanicalIndex : Real = 1.9;
        attribute maximumThermalIndex : Real = 6.0;
        attribute maximumTransducerTemperature : Temperature_C = 43.0;

        constraint acousticOutputConstraint {
            safetyStatus.mechanicalIndex <= maximumMechanicalIndex;
            safetyStatus.thermalIndex <= maximumThermalIndex;
            safetyStatus.transducerTemperature <= maximumTransducerTemperature;
        }
    }

    part def StudyStorage {
        in item frameInput : UltrasoundImageFrame;
        attribute localStudyCapacity_GB : Real = 512.0;
        attribute supportsDICOMExport : Boolean = true;
        attribute encryptedAtRest : Boolean = true;
    }

    requirement def PrimaryFunctionRequirement {
        doc /* The medical ultrasound system shall provide real-time visualization of internal patient anatomy by emitting controlled ultrasound pulses, receiving tissue echoes, and converting those echoes into diagnostic image frames for clinician interpretation. */
    }

    requirement def AcousticSafetyRequirement {
        doc /* The system shall continuously monitor acoustic output and transducer temperature and shall disable or limit acoustic transmission before mechanical index, thermal index, or surface temperature exceeds configured clinical safety limits. */
    }

    requirement def ImageQualityRequirement {
        doc /* In B-mode imaging, the system shall produce diagnostic image frames with axial resolution no worse than 1.0 mm, lateral resolution no worse than 2.0 mm, and frame rate of at least 30 Hz at imaging depths up to 160 mm. */
    }

    requirement def PatientContactRequirement {
        doc /* The system shall inhibit imaging when probe contact is not confirmed or coupling gel is not detected. */
    }

    requirement def DataStorageRequirement {
        doc /* The system shall store frozen ultrasound image frames and associated study metadata in encrypted local storage and support export using a clinical imaging format. */
    }

    requirement primaryFunctionReq : PrimaryFunctionRequirement;
    requirement acousticSafetyReq : AcousticSafetyRequirement;
    requirement imageQualityReq : ImageQualityRequirement;
    requirement patientContactReq : PatientContactRequirement;
    requirement dataStorageReq : DataStorageRequirement;

    satisfy primaryFunctionReq by MedicalUltrasoundSystem;
    satisfy acousticSafetyReq by MedicalUltrasoundSystem::safetyMonitor;
    satisfy imageQualityReq by MedicalUltrasoundSystem::beamformer;
    satisfy imageQualityReq by MedicalUltrasoundSystem::imageProcessor;
    satisfy patientContactReq by MedicalUltrasoundSystem::safetyMonitor;
    satisfy dataStorageReq by MedicalUltrasoundSystem::studyStorage;
}
