        connect powerSupply.regulatedPower to pulserReceiver.power;
        connect powerSupply.regulatedPower to beamformer.power;
        connect powerSupply.regulatedPower to imageProcessor.power;
        connect powerSupply.regulatedPower to display.power;
        connect powerSupply.regulatedPower to safetyMonitor.power;

        state machine operationalState {
            state off;
            state booting;
            state standby;
            state probeCheck;
            state imaging;
            state frozen;
            state savingStudy;
            state fault;
