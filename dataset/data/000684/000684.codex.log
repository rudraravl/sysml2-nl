        attribute maxImagingDepth : Depth_mm = 240.0;
        attribute nominalFrameRate : FrameRate_Hz = 60.0;
        attribute primaryFunction : String = "Generate real-time diagnostic images of internal patient anatomy by transmitting controlled high-frequency acoustic pulses into tissue, receiving reflected echoes, processing them into image frames, and presenting them safely to a clinician.";

        port powerIn : PowerInputPort;
        port operatorCommandIn : CommandInputPort;
        port patientContactIn : PatientContactPort;
        port imageOut : ImageOutputPort;
