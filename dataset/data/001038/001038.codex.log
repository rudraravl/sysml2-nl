    connect electronInput to cathode.electronIn;
    connect biasInput to divider.supplyIn;
    connect vacuumInput to envelope.vacuumInterface;
    connect thermalInput to envelope.thermalInterface;

    connect divider.cathodeBiasOut to cathode.biasIn;
