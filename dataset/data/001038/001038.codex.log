    port thermalInterface : ThermalPort;

    attribute operatingPressure : Pressure = 1.0e-4 [pascal];
    attribute maximumSafePressure : Pressure = 1.0e-2 [pascal];
    attribute minimumTemperature : Temperature = 253 [kelvin];
    attribute maximumTemperature : Temperature = 333 [kelvin];

    assert operatingPressure <= maximumSafePressure;
  }

  part def ElectronMultiplier {
    port electronInput : ElectronInputPort;
    port signalOutput : PulseOutputPort;
    port biasInput : BiasPort;
    port vacuumInput : VacuumPort;
    port thermalInput : ThermalPort;

    attribute primaryFunction : String =
      "Amplify a single or small number of incident electrons into a measurable electrical pulse by repeated secondary electron emission across biased dynode stages.";

    attribute nominalGain : GainRatio = 1000000;
    attribute minimumGain : GainRatio = 100000;
    attribute maximumGain : GainRatio = 10000000;
    attribute maximumOutputCurrent : ElectricCurrent = 10 [milliampere];
    attribute darkCountRate : DarkCountRate = 10 [hertz];
