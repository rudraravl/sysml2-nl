    connect dynode[1].electronTransfer to dynode[2].electronTransfer;
    connect dynode[2].electronTransfer to dynode[3].electronTransfer;
    connect dynode[3].electronTransfer to dynode[4].electronTransfer;
    connect dynode[4].electronTransfer to dynode[5].electronTransfer;
    connect dynode[5].electronTransfer to dynode[6].electronTransfer;
    connect dynode[6].electronTransfer to dynode[7].electronTransfer;
    connect dynode[7].electronTransfer to dynode[8].electronTransfer;
    connect dynode[8].electronTransfer to dynode[9].electronTransfer;
    connect dynode[9].electronTransfer to dynode[10].electronTransfer;
    connect dynode[10].electronTransfer to anode.avalancheIn;
    connect anode.pulseOut to signalOutput;

    assert nominalGain >= minimumGain;
    assert nominalGain <= maximumGain;
    assert envelope.operatingPressure <= envelope.maximumSafePressure;
    assert anode.collect.pulse.peakCurrent <= maximumOutputCurrent;
  }

  requirement def PrimaryFunctionRequirement {
    subject multiplier : ElectronMultiplier;

    doc
      "The electron multiplier shall convert incident electrons into amplified output current pulses suitable for detection by downstream electronics.";

    require constraint {
      multiplier.nominalGain >= 1000000 [one]
