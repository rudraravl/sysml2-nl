package ElectronMultiplierSystemModel {

  import ScalarValues::*;
  import ISQ::*;
  import SI::*;

  value def ElectronCount {
    unit = count;
  }

  value def GainRatio {
    unit = one;
  }

  value def Voltage {
    unit = volt;
  }

  value def ElectricCurrent {
    unit = ampere;
  }

  value def TimeDuration {
    unit = second;
  }

  value def Pressure {
    unit = pascal;
  }

  value def Temperature {
    unit = kelvin;
  }

  value def Energy {
    unit = electronVolt;
  }

  value def DarkCountRate {
    unit = hertz;
  }

  item def IncidentElectron {
    attribute kineticEnergy : Energy;
    attribute arrivalTime : TimeDuration;
    attribute charge : ElectricCharge = -1.602176634e-19 [coulomb];
  }

  item def SecondaryElectron {
    attribute kineticEnergy : Energy;
    attribute generationStage : Integer;
    attribute charge : ElectricCharge = -1.602176634e-19 [coulomb];
  }

  item def ElectronAvalanche {
    attribute electronCount : ElectronCount;
    attribute meanEnergy : Energy;
    attribute gain : GainRatio;
  }

  item def OutputPulse {
    attribute peakCurrent : ElectricCurrent;
    attribute pulseWidth : TimeDuration;
    attribute collectedCharge : ElectricCharge;
    attribute gain : GainRatio;
    attribute timestamp : TimeDuration;
  }

  item def BiasSupply {
    attribute appliedVoltage : Voltage;
    attribute rippleVoltage : Voltage;
    attribute maxCurrent : ElectricCurrent;
  }

  port def ElectronInputPort {
    in item incidentElectron : IncidentElectron;
  }

  port def ElectronTransferPort {
    in item incomingAvalanche : ElectronAvalanche;
    out item outgoingAvalanche : ElectronAvalanche;
  }

  port def ElectronOutputPort {
    out item amplifiedAvalanche : ElectronAvalanche;
  }

  port def PulseOutputPort {
    out item pulse : OutputPulse;
  }

  port def BiasPort {
    in item bias : BiasSupply;
  }

  port def VacuumPort {
    in attribute chamberPressure : Pressure;
  }

  port def ThermalPort {
    in attribute housingTemperature : Temperature;
  }

  action def ConvertIncidentElectronToSecondaryEmission {
    in item primary : IncidentElectron;
    in attribute conversionVoltage : Voltage;
    out item initialAvalanche : ElectronAvalanche;

    attribute nominalSecondaryYield : GainRatio = 3.5;
    attribute minimumPrimaryEnergy : Energy = 50 [electronVolt];

    assert primary.kineticEnergy >= minimumPrimaryEnergy;

    initialAvalanche.electronCount := 3.5 [count];
    initialAvalanche.meanEnergy := 12 [electronVolt];
    initialAvalanche.gain := nominalSecondaryYield;
  }

  action def MultiplyElectronAvalanche {
    in item inputAvalanche : ElectronAvalanche;
    in attribute stageIndex : Integer;
    in attribute dynodeVoltage : Voltage;
    out item outputAvalanche : ElectronAvalanche;

    attribute stageYield : GainRatio;
    attribute lowVoltageYield : GainRatio = 2.0;
    attribute nominalYield : GainRatio = 4.0;
    attribute highVoltageYield : GainRatio = 5.5;

    if dynodeVoltage < 70 [volt] {
