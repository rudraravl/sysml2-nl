    }

    require constraint {
      multiplier.divider.dividerCurrent >= 50 [microampere]
    }
  }

  requirement def DarkNoiseRequirement {
    subject multiplier : ElectronMultiplier;

    doc
      "The multiplier shall limit spontaneous output pulses when no incident electron is present.";

    require constraint {
      multiplier.darkCountRate <= 25 [hertz]
    }
  }

  part electronMultiplierAssembly : ElectronMultiplier;

  satisfy PrimaryFunctionRequirement by electronMultiplierAssembly;
  satisfy VacuumOperationRequirement by electronMultiplierAssembly;
  satisfy PulseOutputRequirement by electronMultiplierAssembly;
  satisfy BiasStabilityRequirement by electronMultiplierAssembly;
  satisfy DarkNoiseRequirement by electronMultiplierAssembly;
