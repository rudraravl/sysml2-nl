      first Multiplying
      then Ready
      accept pulseDelivered;

    transition Multiplying_to_Saturated
      first Multiplying
      then Saturated
      accept outputCurrentLimitExceeded;

    transition Saturated_to_Ready
      first Saturated
      then Ready
      accept recoveryDelayElapsed;

    transition Ready_to_Fault
