    connect divider.dynodeBiasOut[2] to dynode[2].biasIn;
    connect divider.dynodeBiasOut[3] to dynode[3].biasIn;
    connect divider.dynodeBiasOut[4] to dynode[4].biasIn;
    connect divider.dynodeBiasOut[5] to dynode[5].biasIn;
    connect divider.dynodeBiasOut[6] to dynode[6].biasIn;
    connect divider.dynodeBiasOut[7] to dynode[7].biasIn;
    connect divider.dynodeBiasOut[8] to dynode[8].biasIn;
    connect divider.dynodeBiasOut[9] to dynode[9].biasIn;
    connect divider.dynodeBiasOut[10] to dynode[10].biasIn;
    connect divider.anodeBiasOut to anode.biasIn;

