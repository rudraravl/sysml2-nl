    attribute activeAreaDiameter : Length = 8 [millimeter];

    perform action convert : ConvertIncidentElectronToSecondaryEmission {
      in primary = electronIn.incidentElectron;
      in conversionVoltage = conversionVoltage;
      out initialAvalanche = secondaryOut.outgoingAvalanche;
    }
  }

  part def DynodeStage {
    port electronTransfer : ElectronTransferPort;
    port biasIn : BiasPort;

    attribute stageNumber : Integer;
    attribute dynodeVoltage : Voltage = 110 [volt];
