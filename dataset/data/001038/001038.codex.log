    } else if dynodeVoltage <= 130 [volt] {
      stageYield := nominalYield;
    } else {
      stageYield := highVoltageYield;
    }

    outputAvalanche.electronCount := inputAvalanche.electronCount * stageYield;
    outputAvalanche.meanEnergy := 10 [electronVolt];
    outputAvalanche.gain := inputAvalanche.gain * stageYield;
  }

  action def CollectAvalancheAsPulse {
    in item avalanche : ElectronAvalanche;
    in attribute collectionEfficiency : GainRatio;
    out item pulse : OutputPulse;

    pulse.collectedCharge := avalanche.electronCount * collectionEfficiency * 1.602176634e-19 [coulomb];
