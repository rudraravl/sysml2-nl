      out item deliveredWater : PotableWater;

      first beginStrokeCycle;
      then upStroke;
      then drawWaterThroughFootValve;
      then downStroke;
      then closeFootValveAndOpenCheckValve;
      then raiseWaterColumn;
      then dischargePreparedWater;
      then completeCycle;

      action beginStrokeCycle;
      action upStroke;
      action drawWaterThroughFootValve;
      action downStroke;
      action closeFootValveAndOpenCheckValve;
      action raiseWaterColumn;
      action dischargePreparedWater;
    }
  }

  part def BoreholeInterface {
    attribute staticWaterLevel : ISQ::length = 18 [m];
    attribute boreholeDepth : ISQ::length = 42 [m];
    attribute casingDiameter : ISQ::length = 0.150 [m];

    port aquiferSupply : WaterIntakePort;
  }

  part def ConcretePlatform {
    attribute platformDiameter : ISQ::length = 1.2 [m];
    attribute apronSlope : Real = 0.03;
    attribute drainChannelLength : ISQ::length = 2.0 [m];
  }

  part def IndiaMarkIIHandPump {
    attribute designFlowRate : VolumeFlowRate = 0.00025 [m^3/s];
    attribute nominalStrokeRate : StrokeRate = 0.67 [Hz];
    attribute maximumLiftHead : HydraulicHead = 45 [m];
    attribute primaryFunction : String = "Manually lift groundwater from a borehole and discharge it above ground for community water collection.";

    port humanPowerInput : HandleInputPort;
    port groundwaterInput : WaterIntakePort;
    port potableWaterOutput : WaterDischargePort;

    part handleAssembly : HandPumpHandleAssembly;
    part pumpHead : PumpHead;
    part pumpRods : PumpRodAssembly;
    part riserPipe : RiserPipe;
    part cylinder : PumpCylinder;
    part borehole : BoreholeInterface;
    part platform : ConcretePlatform;

    connect humanPowerInput to handleAssembly.operatorInput;
    connect handleAssembly.rodOutput to pumpRods.motionIn;
    connect pumpRods.motionOut to cylinder.drive;
    connect borehole.aquiferSupply to groundwaterInput;
    connect groundwaterInput to cylinder.suction;
    connect cylinder.delivery to riserPipe.intake;
    connect riserPipe.outlet to pumpHead.discharge;
    connect pumpHead.discharge to potableWaterOutput;

