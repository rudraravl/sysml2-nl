      entry; then idle;

      state idle;
      state priming;
      state pumping;
      state deliveringWater;
      state stopped;
      state maintenanceRequired;

      transition idle_to_priming
        first idle
        accept operatorBeginsStroke
        then priming;

      transition priming_to_pumping
        first priming
        accept waterColumnEstablished
        then pumping;

      transition pumping_to_delivering
        first pumping
        accept dischargeFlowDetected
        then deliveringWater;

      transition delivering_to_pumping
        first deliveringWater
        accept nextStrokeRequested
        then pumping;

      transition pumping_to_stopped
        first pumping
        accept operatorStops
        then stopped;

      transition stopped_to_idle
        first stopped
        accept handleReleased
        then idle;

      transition pumping_to_maintenance
        first pumping
        accept abnormalResistanceDetected
        then maintenanceRequired;
    }

    action def ProvideWater {
      in item humanEnergy : MechanicalEnergy;
      in item aquiferWater : GroundWater;
      out item collectedWater : PotableWater;

      first receiveManualHandleInput;
      then convertHandleMotionToRodMotion;
      then actuateDownholeCylinder;
      then liftWaterThroughRiserPipe;
      then dischargeWaterAtSpout;
      then availableForCollection;

      action receiveManualHandleInput;
      action convertHandleMotionToRodMotion;
      action actuateDownholeCylinder;
      action liftWaterThroughRiserPipe;
      action dischargeWaterAtSpout;
      action availableForCollection;
    }
  }

  requirement def PrimaryFunctionRequirement {
    subject pump : IndiaMarkIIHandPump;

    doc /* The system shall provide a manually operated India Mark II hand pump that lifts groundwater from a borehole and delivers it above ground through a spout for user collection. */

    require constraint {
      pump.designFlowRate >= 0.00020 [m^3/s]
    }

    require constraint {
      pump.maximumLiftHead >= 40 [m]
    }
  }

  requirement def ManualOperationRequirement {
    subject pump : IndiaMarkIIHandPump;

    doc /* The hand pump shall operate using human-applied force at the handle without requiring electrical power or fuel. */

    require constraint {
      pump.handleAssembly.maximumOperatorForce <= 200 [N]
    }
  }

  requirement def CylinderLiftRequirement {
    subject cylinder : PumpCylinder;

    doc /* The downhole cylinder shall convert reciprocating rod motion into suction and delivery cycles that raise groundwater through the riser pipe. */

    require constraint {
      cylinder.maximumOperatingDepth >= 45 [m]
    }
  }

  requirement def CommunityCollectionRequirement {
    subject head : PumpHead;

    doc /* The pump head shall discharge lifted water at a height suitable for filling household containers. */

    require constraint {
      head.spoutHeightAboveGround >= 0.75 [m] and head.spoutHeightAboveGround <= 1.0 [m]
    }
  }

  requirement def DrainageRequirement {
    subject platform : ConcretePlatform;

    doc /* The platform shall direct spilled water away from the borehole to reduce contamination risk. */

    require constraint {
      platform.apronSlope >= 0.02
    }
  }

  part indiaMarkIICommunityPump : IndiaMarkIIHandPump;

  satisfy PrimaryFunctionRequirement by indiaMarkIICommunityPump;
  satisfy ManualOperationRequirement by indiaMarkIICommunityPump;
  satisfy CylinderLiftRequirement by indiaMarkIICommunityPump.cylinder;
  satisfy CommunityCollectionRequirement by indiaMarkIICommunityPump.pumpHead;
  satisfy DrainageRequirement by indiaMarkIICommunityPump.platform;
}
