            first acquirePulse;
            then compareThresholds;
            then rejectNoise if pulse.amplitude < lowerLevelThreshold;
            then acceptPulse if pulse.amplitude >= lowerLevelThreshold and pulse.amplitude <= upperLevelThreshold;
            then estimateEnergy;
            then emitDigitalEvent;

            action acquirePulse;
