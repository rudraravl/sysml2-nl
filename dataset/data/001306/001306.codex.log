}

action def ReceiveVelocityAction {
    in item inputMotion : MechanicalVelocity;
    out item outputFrame : VelocityFrame;

    action senseVelocity;
    action conditionSignal;
    action digitizeSignal;
    action compensateBias;
    action assembleFrame;

    first start then senseVelocity;
    then conditionSignal;
    then digitizeSignal;
    then compensateBias;
    then assembleFrame;
    then done;
}

action def SelfCalibrationAction {
    in item command : CommandMessage;
    out item status : ReceiverStatus;

    action isolateInput;
    action measureZeroBias;
    action updateCalibrationCoefficients;
    action reportCalibrationStatus;

    first start then isolateInput;
    then measureZeroBias;
    then updateCalibrationCoefficients;
    then reportCalibrationStatus;
    then done;
}

state def VelocityReceiverStateMachine {
    state off;
    state standby;
    state calibrating;
    state acquiring;
    state processing;
    state transmitting;
    state fault;

    transition initial then off;

    transition powerApplied
        first off
        then standby;

    transition calibrationRequested
        first standby
        then calibrating;

    transition calibrationComplete
        first calibrating
        then standby;

    transition acquisitionRequested
        first standby
        then acquiring;

    transition sampleAvailable
        first acquiring
        then processing;

    transition frameReady
        first processing
        then transmitting;

    transition transmissionComplete
        first transmitting
        then acquiring;

    transition stopRequested
        first acquiring
        then standby;

    transition processorFault
        first standby
        then fault;

    transition sensorFault
        first acquiring
        then fault;

    transition powerRemoved
        first standby
        then off;

    transition resetComplete
        first fault
        then standby;
}

part def VelocityReceiver {
    port motionInput : VelocityInputPort;
    port powerInput : PowerPort;
    port commandInput : CommandPort;
    port velocityOutput : VelocityFramePort;
    port statusOutput : StatusPort;

    part sensingElement : VelocitySensingElement;
    part analogFrontEnd : AnalogFrontEnd;
    part adc : AnalogToDigitalConverter;
    part processor : VelocityProcessor;
    part communicationInterface : CommunicationInterface;
    part powerConditioner : PowerConditioner;
    part thermalMonitor : ThermalMonitor;

    attribute primaryFunction : String =
        "Receive mechanical velocity along one or more axes, convert the motion into calibrated digital velocity frames, and report receiver health to an external host.";

    attribute minimumDetectableVelocity : Velocity_mps = (value = 0.000001, unit = "m/s");
    attribute maximumMeasuredVelocity : Velocity_mps = (value = 5.0, unit = "m/s");
    attribute operatingBandwidthLow : Frequency_Hz = (value = 0.5, unit = "Hz");
    attribute operatingBandwidthHigh : Frequency_Hz = (value = 1000.0, unit = "Hz");
    attribute nominalFrameRate : Frequency_Hz = (value = 100.0, unit = "Hz");
    attribute receiverMode : ReceiverModeKind = ReceiverModeKind::off;
    attribute receiverHealth : ReceiverHealthKind = ReceiverHealthKind::nominal;

    connection motionPath connect motionInput to sensingElement.motionIn;
    connection sensorToAnalogFrontEnd connect sensingElement.analogOut to analogFrontEnd.analogIn;
    connection conditionedSignalPath connect analogFrontEnd.analogOut to adc.analogIn;
    connection samplePath connect adc.sampleOut to processor.sampleIn;
    connection framePath connect processor.frameOut to communicationInterface.frameIn;
    connection externalFrameOutput connect processor.frameOut to velocityOutput;
    connection externalCommandInput connect commandInput to processor.commandIn;
    connection powerPath connect powerInput to powerConditioner.powerIn;
    connection processorStatusPath connect processor.statusOut to statusOutput;
    connection powerStatusPath connect powerConditioner.statusOut to statusOutput;
    connection thermalStatusPath connect thermalMonitor.statusOut to statusOutput;

    perform action receiveVelocity : ReceiveVelocityAction;
    perform action selfCalibration : SelfCalibrationAction;
    exhibit state receiverStates : VelocityReceiverStateMachine;
}

requirement def VelocityReceiverPrimaryFunctionRequirement {
    subject receiver : VelocityReceiver;

    require constraint {
        receiver.primaryFunction ==
        "Receive mechanical velocity along one or more axes, convert the motion into calibrated digital velocity frames, and report receiver health to an external host."
    }
}

requirement def VelocityMeasurementRangeRequirement {
    subject receiver : VelocityReceiver;

    require constraint {
        receiver.minimumDetectableVelocity.value <= 0.000001 and
        receiver.maximumMeasuredVelocity.value >= 5.0
    }
}

requirement def VelocityBandwidthRequirement {
    subject receiver : VelocityReceiver;

    require constraint {
        receiver.operatingBandwidthLow.value <= 0.5 and
        receiver.operatingBandwidthHigh.value >= 1000.0
    }
}

requirement def VelocityFrameRateRequirement {
    subject receiver : VelocityReceiver;

    require constraint {
        receiver.nominalFrameRate.value >= 100.0
    }
}

requirement def ReceiverHealthReportingRequirement {
    subject receiver : VelocityReceiver;

    require constraint {
        receiver.statusOutput.status.health == ReceiverHealthKind::nominal or
        receiver.statusOutput.status.health == ReceiverHealthKind::degraded or
        receiver.statusOutput.status.health == ReceiverHealthKind::failed
    }
}

part velocityReceiverSystem {
    part receiver : VelocityReceiver;

    satisfy VelocityReceiverPrimaryFunctionRequirement by receiver;
    satisfy VelocityMeasurementRangeRequirement by receiver;
    satisfy VelocityBandwidthRequirement by receiver;
    satisfy VelocityFrameRateRequirement by receiver;
    satisfy ReceiverHealthReportingRequirement by receiver;
}
