  attribute def Power :> ISQ::power {
    unit = "kW";
  }

  attribute def Energy :> ISQ::energy {
    unit = "kWh";
  }

  attribute def Frequency {
    unit = "Hz";
  }

  attribute def Temperature {
    unit = "degC";
  }

  attribute def Latency {
    unit = "ms";
  }

  attribute def StateOfCharge {
    unit = "%";
  }

  item def ElectricalEnergyFlow {
    attribute voltage : Voltage;
    attribute current : Current;
    attribute realPower : Power;
    attribute reactivePower : Power;
    attribute frequency : Frequency;
    attribute source : EnergySourceKind;
  }

  item def TelemetryPacket {
    attribute measuredVoltage : Voltage;
    attribute measuredCurrent : Current;
    attribute measuredPower : Power;
    attribute measuredFrequency : Frequency;
    attribute equipmentTemperature : Temperature;
    attribute batterySoc : StateOfCharge;
    attribute timestampLatency : Latency;
  }

  item def DispatchCommand {
    attribute targetPower : Power;
    attribute targetVoltage : Voltage;
    attribute targetFrequency : Frequency;
    attribute requestedMode : GridModeKind;
  }

  port def PowerPort {
    inout energy : ElectricalEnergyFlow;
  }

  port def TelemetryPort {
    out telemetry : TelemetryPacket;
  }

  port def CommandPort {
    in command : DispatchCommand;
  }

  port def ControlPort {
    in telemetry : TelemetryPacket;
    out command : DispatchCommand;
  }

  part def SolidStateTransformer {
    port gridSide : PowerPort;
    port dcLinkSide : PowerPort;
    port telemetryOut : TelemetryPort;
    port commandIn : CommandPort;

    attribute ratedPower : Power = 250.0;
    attribute nominalGridVoltage : Voltage = 480.0;
    attribute nominalDcVoltage : Voltage = 800.0;
    attribute conversionEfficiency : Real = 0.975;
    attribute maxSwitchingTemperature : Temperature = 95.0;
  }

  part def PhotovoltaicInterface {
    port solarInput : PowerPort;
    port dcOutput : PowerPort;
    port telemetryOut : TelemetryPort;
    port commandIn : CommandPort;

    attribute peakPower : Power = 120.0;
    attribute maximumPowerPointVoltage : Voltage = 650.0;
    attribute minimumOperatingVoltage : Voltage = 300.0;
  }

  part def BatteryStorageInterface {
    port dcBus : PowerPort;
    port telemetryOut : TelemetryPort;
    port commandIn : CommandPort;

    attribute usableCapacity : Energy = 400.0;
    attribute maximumChargePower : Power = 150.0;
    attribute maximumDischargePower : Power = 180.0;
    attribute minimumSoc : StateOfCharge = 15.0;
    attribute maximumSoc : StateOfCharge = 95.0;
  }

  part def VehicleToGridInterface {
    port vehiclePort : PowerPort;
    port dcBus : PowerPort;
    port telemetryOut : TelemetryPort;
    port commandIn : CommandPort;

    attribute maximumBidirectionalPower : Power = 19.2;
    attribute minimumVehicleSocReserve : StateOfCharge = 40.0;
  }

  part def LoadPanelInterface {
    port acInput : PowerPort;
    port criticalLoadOutput : PowerPort;
    port flexibleLoadOutput : PowerPort;
    port telemetryOut : TelemetryPort;
    port commandIn : CommandPort;

    attribute criticalLoadLimit : Power = 80.0;
    attribute flexibleLoadLimit : Power = 160.0;
  }

  part def EdgeAIController {
    port gridTelemetry : ControlPort;
    port solarTelemetry : ControlPort;
    port batteryTelemetry : ControlPort;
    port vehicleTelemetry : ControlPort;
    port loadTelemetry : ControlPort;

    attribute inferenceLatency : Latency = 20.0;
    attribute forecastHorizonHours : Real = 24.0;
    attribute dispatchIntervalSeconds : Real = 1.0;
    attribute currentMode : GridModeKind = GridModeKind::gridFollowing;
  }

  action def SenseAndDispatchEnergy {
    in gridData : TelemetryPacket;
    in solarData : TelemetryPacket;
    in batteryData : TelemetryPacket;
    in loadData : TelemetryPacket;
    out gridCommand : DispatchCommand;
    out batteryCommand : DispatchCommand;
    out loadCommand : DispatchCommand;

    first start;
    then validateTelemetry;
    then forecastGenerationAndDemand;
    then optimizePowerFlow;
    then issueDispatchCommands;
    then done;
  }

  state def AdaptiveRouterStateMachine {
    entry action SenseAndDispatchEnergy;

    state Initializing;
    state GridFollowing;
    state GridForming;
    state IslandedOperation;
    state EmergencyBypass;
    state ControlledShutdown;

    transition first Initializing then GridFollowing;

    transition GridFollowing then GridForming
      accept DispatchCommand
      if command.requestedMode == GridModeKind::gridForming;

    transition GridForming then IslandedOperation
      accept TelemetryPacket
      if telemetry.measuredFrequency < 58.8;

    transition IslandedOperation then GridFollowing
      accept TelemetryPacket
      if telemetry.measuredFrequency >= 59.9;

    transition GridFollowing then EmergencyBypass
      accept TelemetryPacket
      if telemetry.equipmentTemperature > 95.0;

    transition GridForming then EmergencyBypass
      accept TelemetryPacket
      if telemetry.equipmentTemperature > 95.0;

    transition EmergencyBypass then ControlledShutdown
      accept DispatchCommand
      if command.requestedMode == GridModeKind::shutdown;
  }

  part def AdaptiveEnergyRouter {
    attribute primaryFunction : String =
      "Use edge artificial intelligence and bidirectional power electronics to autonomously route electrical energy among the grid, renewable generation, storage, vehicles, and building loads.";

    port utilityGrid : PowerPort;
    port rooftopSolar : PowerPort;
    port stationaryBattery : PowerPort;
    port electricVehicle : PowerPort;
    port criticalLoads : PowerPort;
    port flexibleLoads : PowerPort;

    part transformer : SolidStateTransformer;
    part solarConverter : PhotovoltaicInterface;
    part batteryConverter : BatteryStorageInterface;
    part vehicleConverter : VehicleToGridInterface;
    part loadPanel : LoadPanelInterface;
    part controller : EdgeAIController;

    perform stateMachine : AdaptiveRouterStateMachine;

    connect utilityGrid to transformer.gridSide;
    connect transformer.dcLinkSide to solarConverter.dcOutput;
    connect transformer.dcLinkSide to batteryConverter.dcBus;
    connect transformer.dcLinkSide to vehicleConverter.dcBus;
    connect transformer.gridSide to loadPanel.acInput;
    connect rooftopSolar to solarConverter.solarInput;
    connect stationaryBattery to batteryConverter.dcBus;
    connect electricVehicle to vehicleConverter.vehiclePort;
    connect criticalLoads to loadPanel.criticalLoadOutput;
