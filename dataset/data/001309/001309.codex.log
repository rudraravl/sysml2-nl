    require constraint {
      system.maximumDarkCountRate <= 50000.0
    }
  }

  requirement def CryogenicOperationRequirement {
    subject system : VisibleLightPhotonCounterSystem;
    doc /* The detector shall be regulated near 7 K to support low-noise visible-light photon counting. */
    require constraint {
      system.nominalDetectorTemperature <= 7.5 and
      system.nominalDetectorTemperature >= 6.5
    }
  }

  requirement def BiasStabilityRequirement {
    subject system : VisibleLightPhotonCounterSystem;
    doc /* The detector bias supply shall regulate the detector bias to the commanded nominal value without exceeding the detector maximum bias voltage. */
    require constraint {
