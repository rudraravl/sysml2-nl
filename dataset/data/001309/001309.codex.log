    port controlPort : BiasControlPort;
    port detectorBiasPort : BiasControlPort;
    port statusPort : StatusPort;

    action rampAndRegulateBias {
      in item command : BiasCommand;
      out attribute actualBiasVoltage : Volt;

      first validateCommand;
      then rampVoltage;
      then regulateVoltage;
      then monitorLeakageCurrent;
      then done;
    }
  }

  part def PulseConditioningElectronics {
    attribute transimpedanceGain : Real = 10000.0;
    attribute bandwidth : Hertz = 100000000.0;
    attribute discriminatorThreshold : Volt = 0.015;
    attribute timingJitter : TimeInterval = 0.00000000025;
    attribute minimumPulseSeparation : TimeInterval = 0.00000005;

    port pulseInput : ElectricalPulsePort;
    port eventOutput : DigitalEventPort;
    port statusPort : StatusPort;

    action conditionAndDiscriminatePulse {
      in item rawPulse : AvalanchePulse;
      out item event : DigitalPhotonEvent;

      first amplifyPulse;
      then shapePulse;
      then compareToThreshold;
      then timestampEvent;
      then publishEvent;
      then done;
    }
  }

  part def EventProcessor {
    attribute maximumEventRate : CountRate = 10000000.0;
    attribute integrationWindow : TimeInterval = 0.001;
    attribute backgroundSubtractionEnabled : Boolean = true;
    attribute measuredCountRate : CountRate;
    attribute correctedCountRate : CountRate;

    port eventInput : DigitalEventPort;
    port statusOutput : StatusPort;

    action countAndReportPhotons {
      in item event : DigitalPhotonEvent;
      out item status : HealthStatus;

      first validateEvent;
      then incrementCounter;
      then compensateDeadTime;
      then updateRateEstimate;
      then publishHealthStatus;
      then done;
    }
  }

  part def VisibleLightPhotonCounterSystem {
    attribute primaryFunction : String = "Detect individual visible-light photons and convert each accepted photon into a time-stamped digital event while maintaining cryogenic, bias, and signal-conditioning conditions required for low-noise photon counting.";
    attribute supportedMinimumWavelength : Nanometer = 380.0;
    attribute supportedMaximumWavelength : Nanometer = 750.0;
    attribute nominalDetectorTemperature : Kelvin = 7.0;
    attribute nominalBiasVoltage : Volt = 6.8;
    attribute targetPhotonDetectionEfficiency : Probability = 0.85;
    attribute maximumDarkCountRate : CountRate = 50000.0;
    attribute maximumValidatedEventRate : CountRate = 10000000.0;

    port opticalInput : OpticalInputPort;
    port digitalPhotonEvents : DigitalEventPort;
    port healthStatus : StatusPort;
    port temperatureCommand : TemperatureControlPort;
    port biasCommand : BiasControlPort;

    part optics : OpticalCollectionAssembly {
      attribute apertureDiameter = 25.0;
      attribute numericalAperture = 0.22;
      attribute spectralTransmission = 0.92;
      attribute fieldOfView = 2.0;
    }

    part detector : VisibleLightPhotonCounterDetector {
      attribute activeAreaDiameter = 1.0;
    }

    part thermalController : CryogenicThermalController;
    part biasSupply : BiasSupply;
    part pulseElectronics : PulseConditioningElectronics;
    part eventProcessor : EventProcessor;

    connect opticalInput to optics.opticalInput;
    connect optics.focusedOutput to detector.opticalAbsorption;
    connect detector.chargeGeneration to detector.opticalAbsorption;
    connect detector.avalancheOutput to pulseElectronics.pulseInput;
    connect pulseElectronics.eventOutput to eventProcessor.eventInput;
    connect eventProcessor.statusOutput to healthStatus;
    connect thermalController.detectorThermalPort to detector.thermalInterface;
    connect temperatureCommand to thermalController.commandPort;
    connect biasCommand to biasSupply.controlPort;
    connect biasSupply.detectorBiasPort to detector.biasInterface;
    connect pulseElectronics.eventOutput to digitalPhotonEvents;

    action performPhotonCounting {
      in item incomingPhoton : IncidentPhoton;
      out item photonEvent : DigitalPhotonEvent;
      out item status : HealthStatus;

      first collectPhoton;
      then convertPhoton;
      then conditionPulse;
      then processEvent;
      then reportStatus;
      then done;

      action collectPhoton {
        in item incomingPhoton : IncidentPhoton;
        out item focusedPhoton : IncidentPhoton;
      }

      action convertPhoton {
        in item focusedPhoton : IncidentPhoton;
        out item pulse : AvalanchePulse;
      }

      action conditionPulse {
        in item pulse : AvalanchePulse;
        out item photonEvent : DigitalPhotonEvent;
      }

      action processEvent {
        in item photonEvent : DigitalPhotonEvent;
        out item status : HealthStatus;
      }

      action reportStatus {
        in item status : HealthStatus;
      }
    }

    state def SystemState {
      state unpowered;
      state initializing;
      state cooling;
      state biasing;
      state ready;
      state counting;
      state saturated;
      state degraded;
      state fault;
      state shutdown;

      transition initial then unpowered;

      transition start
        first unpowered
        accept PowerOn
        then initializing;

      transition initialized
        first initializing
        accept SelfTestPassed
        then cooling;

      transition cold
        first cooling
        accept TemperatureStable
        then biasing;

      transition biased
        first biasing
        accept BiasStable
        then ready;

      transition beginCounting
        first ready
        accept AcquisitionStart
        then counting;

      transition pauseCounting
        first counting
        accept AcquisitionStop
        then ready;

      transition highFlux
        first counting
        accept SaturationDetected
        then saturated;

      transition fluxRecovered
        first saturated
        accept FluxReduced
        then counting;

      transition noisyButUsable
        first counting
        accept DarkCountElevated
        then degraded;

      transition recoveredFromDegraded
        first degraded
        accept NoiseRecovered
        then counting;

      transition faultFromReady
        first ready
        accept FaultDetected
        then fault;

      transition faultFromCounting
        first counting
        accept FaultDetected
        then fault;

      transition powerDown
        first ready
        accept PowerOff
        then shutdown;

      transition shutdownComplete
        first shutdown
        accept SafeToRemovePower
        then unpowered;
    }
  }

  requirement def DetectVisiblePhotonsRequirement {
    subject system : VisibleLightPhotonCounterSystem;
    doc /* The system shall detect individual photons in the visible wavelength band and produce one validated digital photon event for each accepted detector pulse. */
    require constraint {
      system.supportedMinimumWavelength <= 380.0 and
      system.supportedMaximumWavelength >= 750.0
    }
  }

  requirement def PhotonDetectionEfficiencyRequirement {
    subject system : VisibleLightPhotonCounterSystem;
    doc /* The system shall provide photon detection efficiency of at least 85 percent at the nominal operating temperature and nominal bias voltage for supported visible wavelengths. */
    require constraint {
      system.targetPhotonDetectionEfficiency >= 0.85
    }
  }

  requirement def DarkCountRequirement {
    subject system : VisibleLightPhotonCounterSystem;
    doc /* The system shall maintain dark count rate at or below 50000 counts per second when the optical input is blocked and the detector temperature is regulated at the nominal setpoint. */
    require constraint {
      system.maximumDarkCountRate <= 50000.0
    }
  }

  requirement def CryogenicOperationRequirement {
    subject system : VisibleLightPhotonCounterSystem;
    doc /* The detector shall be regulated near 7 K to support low-noise visible-light photon counting. */
    require constraint {
      system.nominalDetectorTemperature <= 7.5 and
      system.nominalDetectorTemperature >= 6.5
    }
  }

  requirement def BiasStabilityRequirement {
    subject system : VisibleLightPhotonCounterSystem;
    doc /* The detector bias supply shall regulate the detector bias to the commanded nominal value without exceeding the detector maximum bias voltage. */
    require constraint {
      system.nominalBiasVoltage <= 8.0
    }
  }

  requirement def EventRateRequirement {
    subject system : VisibleLightPhotonCounterSystem;
    doc /* The event processor shall accept and report validated photon events up to 10000000 counts per second. */
    require constraint {
      system.maximumValidatedEventRate >= 10000000.0
    }
  }

  requirement def PrimaryFunctionRequirement {
    subject system : VisibleLightPhotonCounterSystem;
    doc /* The primary function of the Visible Light Photon Counter system is to transform incident visible photons into low-noise, time-stamped digital photon-count events. */
  }

  part vlpcSystem : VisibleLightPhotonCounterSystem;

  satisfy DetectVisiblePhotonsRequirement by vlpcSystem;
  satisfy PhotonDetectionEfficiencyRequirement by vlpcSystem;
  satisfy DarkCountRequirement by vlpcSystem;
  satisfy CryogenicOperationRequirement by vlpcSystem;
  satisfy BiasStabilityRequirement by vlpcSystem;
  satisfy EventRateRequirement by vlpcSystem;
  satisfy PrimaryFunctionRequirement by vlpcSystem;
}
