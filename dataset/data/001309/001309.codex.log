    }
  }

  requirement def EventRateRequirement {
    subject system : VisibleLightPhotonCounterSystem;
    doc /* The event processor shall accept and report validated photon events up to 10000000 counts per second. */
    require constraint {
      system.maximumValidatedEventRate >= 10000000.0
    }
  }

  requirement def PrimaryFunctionRequirement {
    subject system : VisibleLightPhotonCounterSystem;
    doc /* The primary function of the Visible Light Photon Counter system is to transform incident visible photons into low-noise, time-stamped digital photon-count events. */
