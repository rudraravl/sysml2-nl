  attribute def ConfidenceScore :> Probability;
  attribute def RiskScore :> Probability;

  attribute def TemperatureCelsius;
  attribute def PressureKiloPascal;
  attribute def VoltageVolt;
  attribute def CurrentMilliAmpere;
  attribute def PowerWatt;
