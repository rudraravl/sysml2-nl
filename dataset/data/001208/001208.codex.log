        attribute requestedLineRate : LineRate = 240.0;
        attribute healthFault : ScalarValues::Boolean = false;

        port commandIn : CommandPort;
        port telemetryOut : TelemetryPort;

        state def OperatingStateMachine {
            state idle;
            state standby;
            state calibrating;
            state imaging;
            state safe;

            transition idle_to_standby
                first idle
                then standby
                accept ScannerCommand
                if command.requestedMode == ScannerModeKind::standby;

            transition standby_to_calibrating
                first standby
                then calibrating
                accept ScannerCommand
                if command.requestedMode == ScannerModeKind::calibrating;

            transition calibrating_to_imaging
                first calibrating
                then imaging
                accept ScannerCommand
                if command.requestedMode == ScannerModeKind::imaging;

            transition standby_to_imaging
                first standby
                then imaging
                accept ScannerCommand
                if command.requestedMode == ScannerModeKind::imaging;

            transition imaging_to_standby
                first imaging
                then standby
                accept ScannerCommand
                if command.requestedMode == ScannerModeKind::standby;

            transition any_to_safe
                first idle, standby, calibrating, imaging
                then safe
                if healthFault == true;
        }

        action monitorHealth {
            out item status : HealthStatus;
        }
    }

    part def PushBroomScanner {
        attribute primaryFunction : ScalarValues::String =
            "Acquire a continuous two-dimensional image strip by imaging one cross-track line of the scene at a time while platform motion supplies the along-track dimension.";
        attribute swathWidth : ScalarValues::Real = 1024.0 { unit = "m"; }
        attribute groundSampleDistance : GroundSampleDistance = 0.50;
        attribute nominalLineRate : LineRate = 240.0;
        attribute minimumSnr : SignalToNoiseRatio = 45.0;

        port opticalSceneIn : OpticalInputPort;
        port navigationIn : NavigationPort;
        port commandIn : CommandPort;
        port powerIn : PowerPort;
        port imageProductOut : CalibratedLinePort;
        port telemetryOut : TelemetryPort;

        part optics : ForeOptics;
        part slit : SlitAssembly;
        part disperser : SpectralDisperser;
        part detector : LinearDetectorArray;
        part readout : ReadoutElectronics;
        part processor : ImageProcessor;
        part recorder : DataRecorder;
        part motionCompensator : MotionCompensator;
        part thermalControl : ThermalControl;
        part powerConditioning : PowerConditioning;
        part controller : ScannerController;

        connect opticalSceneIn to optics.sceneIn;
        connect optics.photonsOut to slit.photonsIn;
        connect slit.photonsOut to disperser.photonsIn;
        connect disperser.photonsOut to detector.photonsIn;
        connect detector.analogOut to readout.analogIn;
        connect readout.digitalOut to processor.rawLineIn;
        connect navigationIn to processor.navigationIn;
        connect processor.calibratedOut to recorder.lineIn;
        connect processor.calibratedOut to imageProductOut;
        connect navigationIn to motionCompensator.navigationIn;
        connect motionCompensator.commandOut to controller.commandIn;
        connect commandIn to controller.commandIn;
        connect controller.telemetryOut to telemetryOut;
        connect powerIn to powerConditioning.powerIn;

        action acquireImageStrip {
            in item sceneLineRadiance : SceneRadiance;
            in item platformState : NavigationState;
            out item calibratedImageLine : CalibratedImageLine;

            first startExposure;
            then collectPhotons;
            then restrictToSlitLine;
            then disperseSpectrum;
            then convertPhotonsToCharge;
            then digitizeDetectorLine;
            then calibrateAndGeoreference;
            then recordAndTransmitLine;

            action startExposure {
                in item platformState : NavigationState;
            }

            action collectPhotons {
                in item sceneLineRadiance : SceneRadiance;
                out item focusedFlux : PhotonFlux;
            }

            action restrictToSlitLine {
                in item focusedFlux : PhotonFlux;
                out item slitFlux : PhotonFlux;
            }

            action disperseSpectrum {
                in item slitFlux : PhotonFlux;
                out item spectralFlux : PhotonFlux;
            }

            action convertPhotonsToCharge {
                in item spectralFlux : PhotonFlux;
                out item analogLine : AnalogVideoLine;
            }

            action digitizeDetectorLine {
                in item analogLine : AnalogVideoLine;
                out item rawLine : DigitalImageLine;
            }

            action calibrateAndGeoreference {
                in item rawLine : DigitalImageLine;
                in item platformState : NavigationState;
                out item calibratedImageLine : CalibratedImageLine;
            }

            action recordAndTransmitLine {
                in item calibratedImageLine : CalibratedImageLine;
            }
        }
    }

    part def HostPlatform {
        attribute groundSpeed : ScalarValues::Real = 120.0 { unit = "m/s"; }
        attribute altitude : Position = 6000.0;
        attribute attitudeKnowledge : AttitudeAngle = 0.02;

        port navigationOut : NavigationPort;
        port payloadPowerOut : PowerPort;
    }

    part def GroundSystem {
        attribute ingestRate : DataRate = 300.0;
        attribute archiveCapacity : StorageCapacity = 20000.0;

        port imageLineIn : CalibratedLinePort;
        port telemetryIn : TelemetryPort;

        action assembleImageStrip {
            in item calibratedLine : CalibratedImageLine;
        }
    }

    part pushBroomMission {
        part platform : HostPlatform;
        part scanner : PushBroomScanner;
        part groundSystem : GroundSystem;

        connect platform.navigationOut to scanner.navigationIn;
        connect platform.payloadPowerOut to scanner.powerIn;
        connect scanner.imageProductOut to groundSystem.imageLineIn;
        connect scanner.telemetryOut to groundSystem.telemetryIn;
    }

    requirement def PrimaryFunctionRequirement {
        subject scanner : PushBroomScanner;

        doc
        /*
         The scanner shall form an image strip by observing a narrow cross-track line of the scene,
         converting the line radiance into detector samples, and using forward platform motion to
         build the along-track dimension without mechanical cross-track scanning.
        */

        require constraint {
            scanner.nominalLineRate > 0.0
        }
    }

    requirement def CrossTrackSamplingRequirement {
        subject scanner : PushBroomScanner;

        doc
        /*
         The detector shall provide at least 2048 cross-track spatial samples per acquired image line.
        */

        require constraint {
            scanner.detector.crossTrackPixels >= 2048
        }
    }

    requirement def SpectralCoverageRequirement {
        subject scanner : PushBroomScanner;

        doc
        /*
         The optical path shall collect and process scene radiance from 400 nm through 1000 nm.
        */

        require constraint {
            scanner.optics.spectralRangeMin <= 400.0 and
            scanner.optics.spectralRangeMax >= 1000.0
        }
    }

    requirement def LineRateRequirement {
        subject scanner : PushBroomScanner;

        doc
        /*
         The scanner shall support a line rate sufficient to maintain the target along-track
         ground sample distance for the nominal platform ground speed.
        */

        require constraint {
            scanner.nominalLineRate >=
                scanner.motionCompensator.nominalGroundSpeed /
                scanner.motionCompensator.targetAlongTrackGsd
        }
    }

    requirement def RadiometricQualityRequirement {
        subject scanner : PushBroomScanner;

        doc
        /*
         The scanner shall provide calibrated image lines with signal-to-noise ratio of at least
         45 dB under nominal illumination and exposure conditions.
        */

        require constraint {
            scanner.minimumSnr >= 45.0
        }
    }

    requirement def StorageThroughputRequirement {
        subject scanner : PushBroomScanner;

        doc
        /*
         The data recorder shall sustain a write rate greater than the calibrated image output rate.
        */

        require constraint {
            scanner.recorder.sustainedWriteRate >= scanner.processor.outputDataRate
        }
    }

    requirement def ThermalStabilityRequirement {
        subject scanner : PushBroomScanner;

        doc
        /*
         The thermal controller shall maintain the detector at or below minus 20 degrees Celsius
         during imaging to limit dark current and preserve radiometric accuracy.
        */

        require constraint {
            scanner.detector.operatingTemperature <= scanner.thermalControl.detectorSetPoint
        }
    }

    requirement def SafeModeRequirement {
        subject scanner : PushBroomScanner;

        doc
        /*
         The controller shall transition the scanner to safe mode when a health fault is detected.
        */

        require constraint {
            scanner.controller.healthFault implies
            scanner.controller.currentMode == ScannerModeKind::safe
        }
    }

    satisfy PrimaryFunctionRequirement by pushBroomMission.scanner;
    satisfy CrossTrackSamplingRequirement by pushBroomMission.scanner.detector;
    satisfy SpectralCoverageRequirement by pushBroomMission.scanner.optics;
    satisfy LineRateRequirement by pushBroomMission.scanner.motionCompensator;
    satisfy RadiometricQualityRequirement by pushBroomMission.scanner.processor;
    satisfy StorageThroughputRequirement by pushBroomMission.scanner.recorder;
    satisfy ThermalStabilityRequirement by pushBroomMission.scanner.thermalControl;
    satisfy SafeModeRequirement by pushBroomMission.scanner.controller;
}
