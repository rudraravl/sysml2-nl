        first deflated
        accept ControlCommand
        if command.requestedMode == BlockerMode::removed
        then removed;

      transition any_to_fault
        first preparing
        if distalCuff.currentPressure > distalCuff.maximumRecommendedPressure
        then fault;
    }
  }

  part def AirwayAccessAssembly {
