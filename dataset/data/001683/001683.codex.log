    port def EnergySensePort {
        out item reading : EnergyReading;
    }

    port def SecuritySensePort {
        out item reading : SecurityReading;
    }

    port def EnvironmentInputPort {
        in item environmentReading : EnvironmentReading;
        in item energyReading : EnergyReading;
        in item securityReading : SecurityReading;
