    }

    part def SmartLockAndAlarmSystem {
        attribute alarmSoundLevel : Real = 95.0;
        attribute backupBatteryEnergy : Energy = 180000 [J];
        port commandIn : SecurityControlPort;
    }

    part def SmartEnvironmentController {
        attribute targetTemperature : Temperature = 295.15 [K];
        attribute targetHumidity : RelativeHumidity = 45.0;
        attribute targetIlluminance : Illuminance = 450.0;
        attribute maxDemandLimit : Power = 9500 [W];
        attribute minimumComfortIndex : ComfortIndex = 0.85;
        attribute currentMode : EnvironmentMode = EnvironmentMode::unoccupied;

        port sensorInput : EnvironmentInputPort;
        port hvacOutput : HVACControlPort;
        port lightingOutput : LightingControlPort;
        port securityOutput : SecurityControlPort;
        port occupantInterface : OccupantInterfacePort;

        perform action maintainEnvironment : MaintainSmartEnvironment;
        perform state behavior operationState : SmartEnvironmentOperatingStates;
    }

    part def SmartEnvironment {
        attribute floorArea : Area = 185 [m^2];
        attribute designOccupancy : OccupancyCount = 8;
        attribute averageComfortIndex : ComfortIndex;
        attribute currentPowerDemand : Power;
        attribute secured : Boolean;

        part controller : SmartEnvironmentController;
        part temperatureSensors[4] : TemperatureSensor;
        part airQualitySensors[2] : HumidityAirQualitySensor;
        part occupancySensors[3] : OccupancySensor;
        part smartMeter : SmartMeter;
        part securitySensors : SecuritySensorCluster;
        part hvac : HVACUnit;
        part lighting : AdaptiveLightingSystem;
        part locksAndAlarm : SmartLockAndAlarmSystem;

        connect temperatureSensors.dataOut to controller.sensorInput;
        connect airQualitySensors.dataOut to controller.sensorInput;
        connect occupancySensors.dataOut to controller.sensorInput;
        connect smartMeter.dataOut to controller.sensorInput;
        connect securitySensors.dataOut to controller.sensorInput;

        connect controller.hvacOutput to hvac.commandIn;
        connect controller.lightingOutput to lighting.commandIn;
        connect controller.securityOutput to locksAndAlarm.commandIn;
    }

    action def MaintainSmartEnvironment {
        in item environment : EnvironmentReading;
        in item energy : EnergyReading;
        in item security : SecurityReading;
        in item preference : OccupantPreference;

        out item hvacCommand : HVACCommand;
        out item lightingCommand : LightingCommand;
        out item securityCommand : SecurityCommand;
        out item status : EnvironmentStatus;

        attribute calculatedComfort : ComfortIndex;
        attribute effectiveTargetTemperature : Temperature;
        attribute effectiveTargetIlluminance : Illuminance;
        attribute selectedMode : EnvironmentMode;

        first start;

        action classifyMode {
            in item envIn : EnvironmentReading = environment;
            in item secIn : SecurityReading = security;
            out mode : EnvironmentMode;

            if secIn.riskLevel > 0.75 then {
                mode = EnvironmentMode::emergency;
            } else if envIn.occupancy == 0 then {
                mode = EnvironmentMode::unoccupied;
            } else if energy.currentPower > 9000 [W] then {
                mode = EnvironmentMode::occupiedEfficiency;
            } else {
                mode = EnvironmentMode::occupiedComfort;
            }
        }

        then action computeTargets {
            in mode : EnvironmentMode = classifyMode.mode;
            in item pref : OccupantPreference = preference;
            out tempTarget : Temperature;
            out lightTarget : Illuminance;

            if mode == EnvironmentMode::unoccupied then {
                tempTarget = 291.15 [K];
                lightTarget = 75.0;
            } else if mode == EnvironmentMode::occupiedEfficiency then {
                tempTarget = pref.preferredTemperature + 1.5 [K];
                lightTarget = pref.preferredIlluminance * 0.75;
            } else if mode == EnvironmentMode::night then {
                tempTarget = 292.15 [K];
                lightTarget = 25.0;
            } else {
                tempTarget = pref.preferredTemperature;
                lightTarget = pref.preferredIlluminance;
            }
        }

        then action issueHVACCommand {
            in tempTarget : Temperature = computeTargets.tempTarget;
            in item envIn : EnvironmentReading = environment;
            out item command : HVACCommand;

            if envIn.indoorTemperature < tempTarget - 0.5 [K] then {
                command.mode = HVACMode::heating;
            } else if envIn.indoorTemperature > tempTarget + 0.5 [K] then {
                command.mode = HVACMode::cooling;
            } else if envIn.co2 > 900.0 then {
                command.mode = HVACMode::ventilation;
            } else {
                command.mode = HVACMode::energySaving;
            }

            command.targetTemperature = tempTarget;
            command.targetHumidity = 45.0;
            command.ventilationRatePercent = 55.0;
            command.priority = 5;
        }

        then action issueLightingCommand {
            in lightTarget : Illuminance = computeTargets.lightTarget;
            in item envIn : EnvironmentReading = environment;
            out item command : LightingCommand;

            command.targetIlluminance = lightTarget;
            command.dimmingPercent = if envIn.occupancy == 0 then 0.0 else 65.0;
            command.colorTemperatureKelvin = if lightTarget < 100.0 then 2700.0 else 4000.0;
            command.priority = 4;
        }

        then action issueSecurityCommand {
            in item secIn : SecurityReading = security;
            in item envIn : EnvironmentReading = environment;
            out item command : SecurityCommand;

            command.armSystem = envIn.occupancy == 0;
            command.lockDoors = envIn.occupancy == 0 or secIn.riskLevel > 0.5;
            command.notifyOccupants = secIn.riskLevel > 0.75;
            command.priority = if secIn.riskLevel > 0.75 then 10 else 3;
        }

        then action publishStatus {
            out item environmentStatus : EnvironmentStatus;

            environmentStatus.activeMode = classifyMode.mode;
            environmentStatus.comfortIndex = calculatedComfort;
            environmentStatus.currentEnergyPower = energy.currentPower;
            environmentStatus.secured = issueSecurityCommand.command.lockDoors;
            environmentStatus.alertActive = security.riskLevel > 0.75;
        }

        then done;
    }

    state def SmartEnvironmentOperatingStates {
        entry action initializeController;

        state Monitoring;
        state ComfortOptimization;
        state EnergyOptimization;
        state SecurityProtection;
        state EmergencyResponse;
        state MaintenanceMode;

        transition initialToMonitoring first Monitoring;

        transition monitorToComfort
            first Monitoring
            accept when environment.occupancy > 0 and security.riskLevel <= 0.5
            then ComfortOptimization;

        transition comfortToEnergy
            first ComfortOptimization
            accept when energy.currentPower > 9000 [W]
            then EnergyOptimization;

        transition energyToComfort
            first EnergyOptimization
            accept when energy.currentPower <= 8000 [W] and environment.occupancy > 0
            then ComfortOptimization;

        transition anyToSecurity
            first Monitoring
            accept when security.riskLevel > 0.5 and security.riskLevel <= 0.75
            then SecurityProtection;

        transition anyToEmergency
            first Monitoring
            accept when security.riskLevel > 0.75 or environment.airQuality > 150.0
            then EmergencyResponse;

        transition emergencyToMonitoring
            first EmergencyResponse
            accept when security.riskLevel <= 0.25 and environment.airQuality <= 100.0
            then Monitoring;

        transition maintenanceRequested
            first Monitoring
            accept MaintenanceRequest
            then MaintenanceMode;

        transition maintenanceComplete
            first MaintenanceMode
            accept MaintenanceComplete
            then Monitoring;
    }

    requirement def PrimaryFunctionRequirement {
        doc /* The smart environment shall sense occupancy, comfort, energy, and safety conditions, infer the current operating context, and automatically coordinate HVAC, lighting, and security assets to maintain occupant comfort, reduce energy demand, and protect the space. */
        subject environment : SmartEnvironment;
        require constraint {
            environment.averageComfortIndex >= 0.85
        }
    }

    requirement def EnergyDemandRequirement {
        subject environment : SmartEnvironment;
        require constraint {
            environment.currentPowerDemand <= 9500 [W]
        }
    }

    requirement def SecurityRequirement {
        subject environment : SmartEnvironment;
        require constraint {
            environment.secured == true
        }
    }

    requirement def OccupancyResponseRequirement {
        subject controller : SmartEnvironmentController;
        require constraint {
            controller.currentMode != EnvironmentMode::occupiedComfort or controller.minimumComfortIndex >= 0.85
        }
    }

    requirement def AirQualityRequirement {
        subject reading : EnvironmentReading;
        require constraint {
            reading.co2 <= 1000.0 and reading.airQuality <= 100.0
        }
    }

    part smartEnvironment : SmartEnvironment;

    requirement primaryFunction : PrimaryFunctionRequirement {
        subject environment = smartEnvironment;
    }

    requirement energyDemand : EnergyDemandRequirement {
        subject environment = smartEnvironment;
    }

    requirement securityProtection : SecurityRequirement {
        subject environment = smartEnvironment;
    }

    requirement occupancyResponse : OccupancyResponseRequirement {
        subject controller = smartEnvironment.controller;
    }

    satisfy primaryFunction by smartEnvironment.controller;
    satisfy energyDemand by smartEnvironment.controller;
    satisfy securityProtection by smartEnvironment.locksAndAlarm;
    satisfy occupancyResponse by smartEnvironment.controller;
}
