    satisfy OutputRateRequirement by MagnetometerController;
    satisfy CalibrationRequirement by CalibrationProcessor;
    satisfy HealthReportingRequirement by MagnetometerBasedSystem;
    satisfy EnvironmentalRequirement by MagnetometerSensor;

    part systemUnderDesign : MagnetometerBasedSystem {
        attribute nominalSupplyVoltage = 3.3;
        attribute nominalCurrent = 0.015;
    }

}
