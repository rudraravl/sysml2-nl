    attribute chargeDensity : SurfaceChargeDensity;
    attribute bindingFraction : DimensionlessRatio;
    attribute targetMoleculesBound : DigitalCount;
  }

  item def GatePotentialSignal {
    attribute potential : ElectricPotential;
    attribute noiseRms : ElectricPotential;
  }

  item def DrainSourceCurrentSignal {
    attribute current : ElectricCurrent;
    attribute noiseRms : ElectricCurrent;
  }

  item def DigitizedMeasurement {
    attribute rawCode : DigitalCount;
    attribute sampledCurrent : ElectricCurrent;
    attribute sampleTime : TimeDuration;
  }

  item def AnalyteEstimate {
    attribute estimatedConcentration : MolarConcentration;
    attribute confidence : DimensionlessRatio;
    attribute limitOfDetection : MolarConcentration;
    attribute valid : Boolean;
  }

  port def FluidInletPort {
    in item sample : LiquidSample;
  }

  port def FluidOutletPort {
    out item waste : LiquidSample;
  }

  port def ChemicalInterfacePort {
    in item sample : LiquidSample;
    out item surfaceCharge : FunctionalizedSurfaceCharge;
  }

  port def ElectricalGatePort {
    in item gateSignal : GatePotentialSignal;
  }

  port def CurrentPort {
    out item drainSourceCurrent : DrainSourceCurrentSignal;
  }

  port def DigitalMeasurementPort {
    out item measurement : DigitizedMeasurement;
