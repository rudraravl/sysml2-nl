        first Measuring
        then Faulted;

      transition resetAfterFault
        first Faulted
        then Initializing;
    }

    perform operationalBehavior : SystemOperationalStateMachine;
  }

  requirement def PrimaryFunctionRequirement {
    doc /* The Bio-FET analyte sensor system shall convert selective biomolecular binding at a functionalized field-effect transistor gate into a calibrated electrical measurement and report the estimated analyte concentration in a liquid sample. */
  }

  requirement def SelectiveBindingRequirement {
    doc /* The functionalized gate surface shall bind the target analyte and produce a surface charge change that modulates the Bio-FET channel conductance. */
  }

  requirement def ElectricalTransductionRequirement {
    doc /* The Bio-FET transducer shall generate a drain-source current change proportional to the effective gate potential shift caused by bound target molecules. */
  }

  requirement def ConcentrationReportingRequirement {
    doc /* The processor shall estimate analyte concentration from the digitized drain-source current after baseline correction and calibration. */
  }

  requirement def DetectionLimitRequirement {
    attribute requiredLOD : MolarConcentration = 10 [pM];
    doc /* The system shall detect the target analyte at or below the required limit of detection under nominal operating conditions. */
  }

  requirement def AssayTimeRequirement {
    attribute maximumTime : TimeDuration = 120 [s];
    doc /* The system shall complete sample transport, molecular binding, electrical acquisition, and concentration reporting within the maximum assay time. */
  }

  requirement def SampleCompatibilityRequirement {
    attribute allowedPHLow : ScalarValues::Real = 6.0;
    attribute allowedPHHigh : ScalarValues::Real = 8.5;
    attribute maximumIonicStrength : MolarConcentration = 200 [mM];
    doc /* The system shall accept liquid samples within the specified pH and ionic strength limits without invalidating the Bio-FET measurement. */
  }

  requirement def NoiseRequirement {
    attribute maximumReadoutNoise : ElectricCurrent = 10 [pA];
    doc /* The readout electronics shall maintain input-referred current noise below the maximum readout noise during measurement acquisition. */
  }

  satisfy PrimaryFunctionRequirement by BioFETAnalyteSensorSystem;
  satisfy SelectiveBindingRequirement by BioFunctionalLayer;
  satisfy ElectricalTransductionRequirement by BioFETTransducer;
  satisfy ConcentrationReportingRequirement by SignalProcessor;
  satisfy DetectionLimitRequirement by BioFETAnalyteSensorSystem;
  satisfy AssayTimeRequirement by BioFETAnalyteSensorSystem;
  satisfy SampleCompatibilityRequirement by MicrofluidicCartridge;
  satisfy NoiseRequirement by BiasAndReadoutElectronics;

  analysis def BioFETMeasurementPrinciple {
    in attribute analyteConcentration : MolarConcentration;
    in attribute bindingFraction : DimensionlessRatio;
    in attribute surfaceCharge : SurfaceChargeDensity;
    in attribute gatePotentialShift : ElectricPotential;
    out attribute drainCurrentChange : ElectricCurrent;
    out attribute reportedConcentration : MolarConcentration;

    objective {
      doc /* Relate target analyte concentration to receptor binding, surface charge, gate potential modulation, drain-source current change, and reported concentration. */
    }
  }

  verification def AssayTimeVerification {
    subject systemUnderTest : BioFETAnalyteSensorSystem;
    objective {
      doc /* Verify that the complete sensing action produces a valid concentration estimate within 120 seconds. */
    }
  }

  verification def LimitOfDetectionVerification {
    subject systemUnderTest : BioFETAnalyteSensorSystem;
    objective {
      doc /* Verify that samples containing 10 pM target analyte produce a valid concentration estimate with confidence at or above 0.9. */
    }
  }

