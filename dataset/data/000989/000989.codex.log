    port outlet : FluidOutletPort;
    port reactionInterface : ChemicalInterfacePort;

    attribute channelVolume : ISQ::volume = 25 [uL];
    attribute nominalFlowRate : ISQ::volumeFlowRate = 5 [uL] / s;
    attribute maximumPressure : ISQ::pressure = 150 [kPa];

    part sampleChannel {
      attribute width : ISQ::length = 400 [um];
      attribute height : ISQ::length = 80 [um];
      attribute length : ISQ::length = 18 [mm];
    }

    action transportSample {
      in item incomingSample : LiquidSample;
      out item conditionedSample : LiquidSample;
      out item wasteSample : LiquidSample;
    }
  }

  part def BioFunctionalLayer {
    port chemicalPort : ChemicalInterfacePort;

    attribute receptorDensity : DigitalCount = 1000000000000;
    attribute associationRate : ScalarValues::Real = 100000 [L] / (mol * s);
    attribute dissociationRate : ScalarValues::Real = 0.001 / s;
    attribute debyeLength : ISQ::length = 3 [nm];
    attribute maximumBindingFraction : DimensionlessRatio = 0.95;

    action bindAnalyte {
      in item sample : LiquidSample;
      out item surfaceCharge : FunctionalizedSurfaceCharge;
    }

    state def BindingStateMachine {
      state CleanSurface;
      state Equilibrating;
      state Bound;
      state Saturated;
      state Regenerating;

      transition first CleanSurface;
      transition CleanSurface_to_Equilibrating
        first CleanSurface
        then Equilibrating;

      transition Equilibrating_to_Bound
        first Equilibrating
        then Bound;

      transition Bound_to_Saturated
        first Bound
        then Saturated;

      transition Bound_to_Regenerating
        first Bound
        then Regenerating;

      transition Saturated_to_Regenerating
        first Saturated
        then Regenerating;

      transition Regenerating_to_CleanSurface
        first Regenerating
        then CleanSurface;
    }

    perform bindingBehavior : BindingStateMachine;
  }

