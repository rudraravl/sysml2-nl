      attribute gain : DimensionlessRatio = 1000000.0;
      attribute inputReferredNoise : ElectricCurrent = 3 [pA];
      attribute bandwidth : ISQ::frequency = 10 [kHz];
    }

    part analogToDigitalConverter {
      attribute resolutionBits : DigitalCount = 24;
      attribute referenceVoltage : ElectricPotential = 2.5 [V];
      attribute conversionTime : TimeDuration = 2 [ms];
    }

    action applyBias {
      out item gateSignal : GatePotentialSignal;
    }

    action acquireCurrent {
      in item currentSignal : DrainSourceCurrentSignal;
      out item measurement : DigitizedMeasurement;
    }
  }

  part def SignalProcessor {
    port measurementInput : DigitalMeasurementPort;
    port estimateOutput : EstimatePort;
    port control : ControlPort;

    attribute baselineCurrent : ElectricCurrent = 0 [A];
    attribute calibrationSlope : ScalarValues::Real = 1.0;
    attribute calibrationOffset : MolarConcentration = 0 [mol] / L;
    attribute minimumConfidence : DimensionlessRatio = 0.9;
    attribute responseTimeLimit : TimeDuration = 60 [s];

    action removeBaseline {
      in item measurement : DigitizedMeasurement;
      out item correctedMeasurement : DigitizedMeasurement;
    }

    action estimateAnalyteConcentration {
      in item correctedMeasurement : DigitizedMeasurement;
      out item estimate : AnalyteEstimate;
    }

    state def MeasurementProcessingStateMachine {
      state Idle;
      state BaselineAcquisition;
      state SampleMeasurement;
      state ConcentrationEstimation;
      state ResultAvailable;
      state Fault;

      transition initial_to_Idle
        first Idle;

      transition Idle_to_BaselineAcquisition
        first Idle
        then BaselineAcquisition;

      transition BaselineAcquisition_to_SampleMeasurement
        first BaselineAcquisition
        then SampleMeasurement;

      transition SampleMeasurement_to_ConcentrationEstimation
        first SampleMeasurement
        then ConcentrationEstimation;

      transition ConcentrationEstimation_to_ResultAvailable
        first ConcentrationEstimation
        then ResultAvailable;

      transition ResultAvailable_to_Idle
        first ResultAvailable
        then Idle;

      transition Any_to_Fault
        first Idle
        then Fault;
    }

    perform processingBehavior : MeasurementProcessingStateMachine;
  }

  part def BioFETAnalyteSensorSystem {
    port sampleIn : FluidInletPort;
    port wasteOut : FluidOutletPort;
    port resultOut : EstimatePort;
    port externalControl : ControlPort;

    attribute targetAnalyteName : String = "specific charged biomolecular target";
