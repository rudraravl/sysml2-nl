    connect cartridge.outlet to wasteOut;
    connect cartridge.reactionInterface to recognitionLayer.chemicalPort;
    connect recognitionLayer.chemicalPort to transducer.chemicalGate;
    connect readout.gateDrive to transducer.electricalGate;
    connect transducer.currentOutput to readout.currentInput;
    connect readout.digitalOutput to processor.measurementInput;
    connect processor.estimateOutput to resultOut;
    connect externalControl to readout.control;
    connect externalControl to processor.control;

