    attribute measurableRangeHigh : MolarConcentration = 10 [uM];
    attribute requiredLimitOfDetection : MolarConcentration = 10 [pM];
    attribute maximumAssayTime : TimeDuration = 120 [s];
    attribute nominalOperatingTemperature : Temperature = 298.15 [K];

