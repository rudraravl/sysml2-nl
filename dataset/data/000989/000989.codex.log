      attribute height : ISQ::length = 30 [nm];
      attribute carrierType : String = "n-type";
    }

    part gateOxide {
      attribute material : String = "hafnium dioxide";
      attribute thickness : ISQ::length = 8 [nm];
      attribute dielectricConstant : ScalarValues::Real = 20.0;
    }

