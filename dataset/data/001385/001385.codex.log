        attribute planningCycleTime : TimeDuration = 0.1;
        attribute minimumCompanionConfidence : Confidence = 0.75;
        port command : CommandPort;
        port perception : PerceptionPort;
        port navigation : NavigationPort;
        port companion : CompanionCoordinationPort;
        port powerIn : PowerPort;
    }

    part def CompanionRobot {
        attribute name : String = "Companion";
        attribute maximumFollowingDistance : Distance = 2.0;
        attribute preferredHumanDistance : Distance = 1.2;
        attribute speechRecognitionConfidence : Confidence;
        attribute socialEngagementScore : Confidence;
        attribute batteryCharge : Percentage;
        port coordination : CompanionCoordinationPort;
        port perception : PerceptionPort;
        port powerIn : PowerPort;
    }

    part def RoboticPrimaryTaskSystem {
        attribute systemName : String = "Companion Assisted Task Robot";
        attribute safeSpeedNearHuman : Speed = 0.6;
        attribute nominalMissionSpeed : Speed = 1.1;
        attribute minimumBatteryForMission : Percentage = 30.0;
        attribute maximumPayloadMass : Mass = 8.0;

        part battery : BatteryPack;
        part driveBase : DriveBase;
        part sensors : SensorSuite;
        part manipulator : Manipulator;
        part payloadBay : PayloadBay;
        part computer : MissionComputer;
        part companion : CompanionRobot;

        port operatorCommand : CommandPort;
        port payloadAccess : PayloadPort;

        connection batteryToDrive connect battery.powerOut to driveBase.powerIn;
        connection batteryToSensors connect battery.powerOut to sensors.powerIn;
        connection batteryToManipulator connect battery.powerOut to manipulator.powerIn;
        connection batteryToComputer connect battery.powerOut to computer.powerIn;
        connection batteryToCompanion connect battery.powerOut to companion.powerIn;

        connection commandToComputer connect operatorCommand to computer.command;
        connection sensorsToComputer connect sensors.perception to computer.perception;
        connection computerToDrive connect computer.navigation to driveBase.motionIn;
        connection computerToCompanion connect computer.companion to companion.coordination;
        connection companionPerceptionToComputer connect companion.perception to computer.perception;
        connection manipulatorToPayloadBay connect manipulator.payloadInterface to payloadBay.payloadInterface;
        connection externalPayloadAccess connect payloadAccess to payloadBay.payloadInterface;
    }

    action def ReceiveMission {
        in item command : MissionCommand;
        out item acceptedCommand : MissionCommand;
    }

    action def VerifyMissionReadiness {
        in item command : MissionCommand;
        in charge : Percentage;
        in payloadMass : Mass;
        out ready : Boolean;
    }

    action def PairWithCompanion {
        in item command : MissionCommand;
        in item humanIntent : HumanIntent;
        out item companionStatus : CompanionStatus;
        out paired : Boolean;
    }

    action def BuildLocalMap {
        in item sensorFrame : SensorFrame;
        out item map : LocalMap;
    }

    action def PlanRoute {
        in item command : MissionCommand;
        in item map : LocalMap;
        out item goal : NavigationGoal;
    }

    action def NavigateWithCompanion {
        in item goal : NavigationGoal;
        in item companionStatus : CompanionStatus;
        out item motion : MotionCommand;
        out arrived : Boolean;
    }

    action def TransferPayload {
        inout item payload : Payload;
        in item humanIntent : HumanIntent;
        out transferred : Boolean;
    }

    action def ReportMissionStatus {
        in missionState : MissionStateKind;
        in progress : Percentage;
        out item status : TaskStatus;
    }

    action def PerformCompanionAssistedPrimaryTask {
        in item command : MissionCommand;
        inout item payload : Payload;
        out item status : TaskStatus;

