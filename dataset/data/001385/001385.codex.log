            in item command = command;
        }

        action verify : VerifyMissionReadiness {
            in item command = receive.acceptedCommand;
        }

        action pair : PairWithCompanion {
            in item command = receive.acceptedCommand;
        }

        action map : BuildLocalMap;

        action plan : PlanRoute {
            in item command = receive.acceptedCommand;
            in item map = map.map;
        }

        action navigate : NavigateWithCompanion {
            in item goal = plan.goal;
            in item companionStatus = pair.companionStatus;
        }

        action transfer : TransferPayload {
            inout item payload = payload;
        }

        action report : ReportMissionStatus;

        flow receive.acceptedCommand to verify.command;
        flow receive.acceptedCommand to pair.command;
        flow map.map to plan.map;
        flow plan.goal to navigate.goal;
        flow pair.companionStatus to navigate.companionStatus;

        first start;
        then receive;
        then verify;
        then pair if verify.ready;
        then map if pair.paired;
        then plan;
        then navigate;
        then transfer if navigate.arrived;
        then report;
        then done;
    }

    state def CompanionAssistedMissionStateMachine {
        entry action ReportMissionStatus;

        state idle;
        state preparing;
        state pairingWithCompanion;
        state planningRoute;
        state movingWithCompanion;
        state deliveringPayload;
        state returningHome;
        state completed;
        state aborted;
        state faulted;

        transition initial then idle;
        transition acceptMission from idle to preparing accept MissionCommand;
        transition readinessConfirmed from preparing to pairingWithCompanion if batteryCharge >= 30.0;
        transition readinessRejected from preparing to aborted if batteryCharge < 30.0;
        transition companionAvailable from pairingWithCompanion to planningRoute if socialEngagementScore >= 0.75;
        transition companionUnavailable from pairingWithCompanion to aborted if socialEngagementScore < 0.75;
        transition routeReady from planningRoute to movingWithCompanion;
        transition destinationReached from movingWithCompanion to deliveringPayload;
        transition payloadTransferred from deliveringPayload to returningHome;
        transition homeReached from returningHome to completed;
        transition cancelRequested from idle to aborted accept HumanIntent if intent == IntentKind::cancelMission;
        transition obstacleFault from movingWithCompanion to faulted;
        transition powerFault from preparing to faulted if batteryCharge < 10.0;
    }

    requirement def CompanionUseRequirement {
        subject system : RoboticPrimaryTaskSystem;
        require constraint {
            system.companion.availability != AvailabilityKind::unavailable
        }
    }

    requirement def PrimaryTaskRequirement {
        subject system : RoboticPrimaryTaskSystem;
        require constraint {
            system.maximumPayloadMass >= 8.0
        }
    }

    requirement def HumanProximitySafetyRequirement {
        subject system : RoboticPrimaryTaskSystem;
        require constraint {
            system.safeSpeedNearHuman <= 0.6
        }
    }

    requirement def BatteryReadinessRequirement {
        subject system : RoboticPrimaryTaskSystem;
        require constraint {
            system.battery.charge >= system.minimumBatteryForMission
        }
    }

    requirement def CompanionFollowingRequirement {
        subject system : RoboticPrimaryTaskSystem;
        require constraint {
            system.companion.maximumFollowingDistance <= 2.0
        }
    }

    requirement def PayloadProtectionRequirement {
        subject payload : Payload;
        require constraint {
            payload.secure == true
        }
    }

    requirement def NavigationAccuracyRequirement {
        subject goal : NavigationGoal;
        require constraint {
            goal.tolerance <= 0.25
        }
    }

    requirement def EmergencyStopRequirement {
        subject system : RoboticPrimaryTaskSystem;
        require constraint {
            system.driveBase.stoppingDistance <= 0.35
        }
    }

    satisfy CompanionUseRequirement by RoboticPrimaryTaskSystem::companion;
    satisfy PrimaryTaskRequirement by RoboticPrimaryTaskSystem::payloadBay;
    satisfy HumanProximitySafetyRequirement by RoboticPrimaryTaskSystem::driveBase;
    satisfy BatteryReadinessRequirement by RoboticPrimaryTaskSystem::battery;
    satisfy CompanionFollowingRequirement by RoboticPrimaryTaskSystem::companion;
    satisfy EmergencyStopRequirement by RoboticPrimaryTaskSystem::driveBase;
