    }

    requirement def OverPressureProtectionRequirement {
        doc /* The pump shall prevent operation above its rated discharge pressure. */

        require constraint {
            HondaPortableWaterPump::pumpHead.outlet.dischargePressure <= HondaPortableWaterPump::maximumPressure
        }
    }

    requirement def OperatorStopRequirement {
        doc /* The operator shall be able to command pump shutdown through the control interface. */

        require constraint {
            HondaPortableWaterPump::operatorControls.stopCommand == true implies
            HondaPortableWaterPump::engine.running == false
        }
    }

    requirement def PortablePumpSystemRequirement {
        doc /* The Honda-style portable water pump system shall provide a gasoline-powered, self-contained water transfer capability for dewatering, irrigation, and utility service. */

        subject pump : HondaPortableWaterPump;

        require PrimaryFunctionRequirement;
        require PrimeBeforePumpingRequirement;
        require LowFuelProtectionRequirement;
        require OverPressureProtectionRequirement;
        require OperatorStopRequirement;
    }

    analysis def PumpFlowAnalysis {
        subject pump : HondaPortableWaterPump;

        attribute hydraulicPower : Power;
        attribute estimatedEfficiency : Efficiency;

        constraint hydraulicPowerEstimate {
            hydraulicPower == pump.pumpHead.outlet.dischargePressure * pump.pumpHead.outlet.dischargeFlow * estimatedEfficiency
        }

        constraint acceptableEfficiency {
            estimatedEfficiency >= 0.55 and estimatedEfficiency <= 0.75
        }
    }

    part hondaUtilityPump : HondaPortableWaterPump {
        fuelTank.currentFuel = 2.8 [L];
        engine.oilTemperature = 85 [degC];
        engine.running = true;
        pumpHead.primed = true;
        pumpHead.casingWaterVolume = 0.7 [L];
        pumpHead.outlet.dischargeFlow = 540 [L/min];
        pumpHead.outlet.dischargePressure = 260 [kPa];
        operatorInterface.throttleSetting = 0.85;
        operatingMode = PumpOperatingMode::pumping;
    }

}
