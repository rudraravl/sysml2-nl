    connect power.powerOut to comms.powerIn;

    connect safety.stopCommandOut to mobility.stopIn;
    connect safety.stopCommandOut to compute.stopIn;
    connect safety.stopCommandOut to manipulator.stopIn;

    connect compute.telemetryOut to telemetryOut;

    perform behavior MilitaryRobotMissionBehavior;
  }

  part def RuggedChassis {
    attribute armorRating : String = "STANAG fragments and weather protection";
    attribute ingressProtection : String = "IP67";
    attribute maxExternalTemperature : Celsius = 55;
    attribute minExternalTemperature : Celsius = -25;
  }

  part def MobilitySubsystem {
    attribute mode : MobilityMode;
    attribute maxTractionForce : Newton = 4200;
    attribute maxSlopeDeg : Real = 35;
    attribute odometryErrorPer100m : Meter = 1.5;

    port motionCommandIn : CommandPort;
    port stopIn : CommandPort;
    port powerIn : PowerPort;
    port odometryOut : TelemetryPort;

    action driveToWaypoint {
      in waypointX : Meter;
      in waypointY : Meter;
      out arrived : Boolean;
    }

    action holdPosition {
      out stabilized : Boolean;
    }
  }

  part def PowerSubsystem {
    attribute batteryCapacity : WattHour = 5200;
    attribute batteryState : Percent;
    attribute hotSwapCapable : Boolean = true;
    attribute estimatedEndurance : Second = 14400;

    port powerOut : PowerPort;

    action monitorEnergy {
      out reserveBelowLimit : Boolean;
    }
  }

  part def MissionComputer {
    attribute processorHealth : Percent;
    attribute autonomousNavigationEnabled : Boolean = true;
    attribute autonomousUseOfForceEnabled : Boolean = false;
    attribute routeConfidence : Percent;

    port commandIn : CommandPort;
    port motionCommandOut : CommandPort;
    port armCommandOut : CommandPort;
    port odometryIn : TelemetryPort;
    port hazardReportIn : HazardReportPort;
    port telemetryOut : TelemetryPort;
    port stopIn : CommandPort;
    port powerIn : PowerPort;

    action planRoute {
      in destinationX : Meter;
      in destinationY : Meter;
      out routeAccepted : Boolean;
    }

    action classifyMissionObject {
      in scan : LidarScan;
      in frame : VideoFrame;
      out assessment : ThreatAssessment;
      out confidence : Percent;
    }

    action composeTelemetry {
      out telemetry : TelemetryPacket;
    }
  }

  part def PerceptionSubsystem {
    attribute cameraCount : Integer = 6;
    attribute lidarRange : Meter = 80;
    attribute thermalCameraAvailable : Boolean = true;
    attribute lowLightModeAvailable : Boolean = true;

    part dayCamera : OpticalCamera;
    part thermalCamera : ThermalCamera;
    part lidar : LidarSensor;
    part hazardClassifier : HazardClassifier;

    port videoOut : VideoPort;
    port scanOut : ScanPort;
    port hazardReportOut : HazardReportPort;
    port powerIn : PowerPort;

    connect dayCamera.videoOut to videoOut;
    connect thermalCamera.videoOut to videoOut;
    connect lidar.scanOut to scanOut;
    connect hazardClassifier.reportOut to hazardReportOut;
  }

  part def OpticalCamera {
    attribute horizontalFieldOfViewDeg : Real = 120;
    attribute minimumIllumination : Lux = 0.05;
    port videoOut : VideoPort;
  }

  part def ThermalCamera {
    attribute temperatureResolution : Celsius = 0.05;
    attribute detectionRange : Meter = 250;
    port videoOut : VideoPort;
  }

  part def LidarSensor {
    attribute range : Meter = 80;
    attribute scanRateHz : Real = 20;
    port scanOut : ScanPort;
  }

  part def HazardClassifier {
    attribute minimumReportConfidence : Percent = 70;
    attribute requiresHumanReview : Boolean = true;
    port reportOut : HazardReportPort;

    action assessHazard {
      in scan : LidarScan;
      in frame : VideoFrame;
      out report : HazardReport;
    }
  }

  part def ManipulatorArm {
    attribute degreesOfFreedom : Integer = 6;
    attribute reach : Meter = 1.8;
    attribute liftCapacity : Kilogram = 18;
    attribute maxGripForce : Newton = 650;

    port armCommandIn : CommandPort;
    port stopIn : CommandPort;
    port powerIn : PowerPort;
    port sampleOut : SamplePort;

    action inspectObject {
      in standoffDistance : Meter;
      out inspectionComplete : Boolean;
    }

    action collectEvidenceSample {
      out sample : EvidenceSample;
    }

    action placePayload {
      in payload : MissionPayload;
      out delivered : Boolean;
    }
  }

  part def PayloadBay {
    attribute maxPayloadMass : Kilogram = 35;
    attribute sealedCompartment : Boolean = true;
    attribute payloadInstalled : Boolean;

    port payloadIn : PayloadPort;
    port payloadOut : PayloadPort;
    port sampleIn : SamplePort;
  }

  part def SafetySupervisor {
    attribute geofenceEnabled : Boolean = true;
    attribute humanAuthorizationRequired : Boolean = true;
    attribute autonomousWeaponEngagementProhibited : Boolean = true;
    attribute emergencyStopLatency : Second = 0.2;

    port stopCommandOut : CommandPort;

    action validateCommand {
      in command : CommandPacket;
      out accepted : Boolean;
    }

    action triggerEmergencyStop {
      out stopCommand : CommandPacket;
    }
  }

  part def RobotCommunications {
    attribute encrypted : Boolean = true;
    attribute linkStatus : LinkStatus;
    attribute fallbackReturnOnLostLink : Boolean = true;
    attribute lostLinkTimeout : Second = 10;

    port commandIn : CommandPort;
    port commandOut : CommandPort;
    port powerIn : PowerPort;
  }

  // Behavior

  action def AuthorizeMissionCommand {
    in command : CommandPacket;
    out accepted : Boolean;
  }

  action def NavigateToWaypoint {
    in targetX : Meter;
    in targetY : Meter;
    out arrived : Boolean;
    out hazardDetected : Boolean;
  }

  action def InspectSuspectObject {
    in standoffDistance : Meter;
    out report : HazardReport;
  }

  action def CollectEvidence {
    out sample : EvidenceSample;
  }

  action def DeliverNonLethalPayload {
    in payload : MissionPayload;
    out deliveredPayload : MissionPayload;
  }

  action def ReturnToBase {
    out arrivedAtBase : Boolean;
  }

  action def SafeShutdown {
    out shutdownComplete : Boolean;
  }

  state def MilitaryRobotMissionBehavior {
    entry action initializeRobot;
    exit action storeMissionLog;

    state idle;
    state deployment;
    state navigating;
    state inspection;
    state evidenceCollection;
    state payloadDelivery;
    state return;
    state shutdown;
    state emergencyStop;

    initial then idle;

    transition idle_to_deployment
      first idle
      accept CommandPacket
      if command.operatorAuthorization == true
      then deployment;

    transition deployment_to_navigating
      first deployment
      do NavigateToWaypoint
      then navigating;

    transition navigating_to_inspection
      first navigating
      if hazardDetected == true
      then inspection;

    transition navigating_to_payloadDelivery
      first navigating
      if hazardDetected == false
      then payloadDelivery;

    transition inspection_to_evidenceCollection
      first inspection
      if report.assessment == ThreatAssessment::confirmedHazard and report.humanReviewed == true
      then evidenceCollection;

    transition inspection_to_return
      first inspection
      if report.assessment == ThreatAssessment::clear
      then return;

    transition evidenceCollection_to_payloadDelivery
      first evidenceCollection
      if sample.sealed == true
      then payloadDelivery;

    transition payloadDelivery_to_return
      first payloadDelivery
      if deliveredPayload.delivered == true
      then return;

    transition return_to_shutdown
      first return
      if arrivedAtBase == true
      then shutdown;

    transition any_to_emergencyStop
      first idle, deployment, navigating, inspection, evidenceCollection, payloadDelivery, return
      accept CommandPacket
      if command.requestedPhase == MissionPhase::safeShutdown or command.operatorAuthorization == false
      then emergencyStop;

    transition emergencyStop_to_shutdown
      first emergencyStop
      do SafeShutdown
      then shutdown;
  }

  // Requirements

  requirement def PrimaryTaskRequirement {
    id = "REQ-MRS-001";
    text = "The robotic system shall perform remote military support tasks using a military robot for reconnaissance, hazard inspection, evidence collection, and non-lethal payload delivery.";
  }

  requirement def HumanAuthorizationRequirement {
    id = "REQ-MRS-002";
    text = "The military robot shall execute mission phase changes only after receiving authenticated human operator authorization.";
  }

  requirement def NoAutonomousUseOfForceRequirement {
    id = "REQ-MRS-003";
    text = "The military robot shall not perform autonomous use of force or autonomous weapon engagement.";
  }

  requirement def ReturnReserveRequirement {
    id = "REQ-MRS-004";
    text = "The military robot shall begin return-to-base behavior when battery state reaches 25 percent or lower unless overridden by an authenticated emergency command.";
  }

  requirement def LostLinkRequirement {
    id = "REQ-MRS-005";
    text = "The military robot shall enter fallback return-to-base behavior when command link is lost for more than 10 seconds.";
  }

  requirement def HazardReportRequirement {
    id = "REQ-MRS-006";
    text = "The military robot shall produce a hazard report including position, assessment, confidence, and human review status for each suspected hazardous object.";
  }

  requirement def EvidenceContainmentRequirement {
    id = "REQ-MRS-007";
    text = "The military robot shall store collected evidence samples in a sealed compartment and mark contamination status.";
  }

  requirement def EmergencyStopRequirement {
    id = "REQ-MRS-008";
    text = "The military robot shall stop mobility and manipulator motion within 0.2 seconds after receiving an emergency stop command.";
  }

  requirement def OperatingRangeRequirement {
    id = "REQ-MRS-009";
    text = "The military robot shall support operation at distances up to 1500 meters from the operator station through encrypted communications.";
  }

  requirement def PayloadRequirement {
    id = "REQ-MRS-010";
    text = "The military robot shall carry and deliver mission payloads up to 35 kilograms, and payloads shall be marked non-lethal before delivery.";
  }

  satisfy PrimaryTaskRequirement by MilitaryRobotSystem;
  satisfy HumanAuthorizationRequirement by OperatorControlStation;
  satisfy HumanAuthorizationRequirement by SafetySupervisor;
  satisfy NoAutonomousUseOfForceRequirement by MilitaryRobot;
  satisfy ReturnReserveRequirement by PowerSubsystem;
  satisfy LostLinkRequirement by RobotCommunications;
  satisfy HazardReportRequirement by PerceptionSubsystem;
  satisfy EvidenceContainmentRequirement by PayloadBay;
  satisfy EmergencyStopRequirement by SafetySupervisor;
  satisfy OperatingRangeRequirement by CommunicationsRelay;
  satisfy PayloadRequirement by PayloadBay;
}
