        attribute severity : Integer;
        attribute messageCode : String;
    }

    port def SlurryPort {
        inout item slurry : Slurry;
        attribute pressure : PressureHead;
        attribute flowRate : VolumeFlowRate;
    }

    port def PowerPort {
        in item power : ElectricalPower;
