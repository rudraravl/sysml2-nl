        port sensorOutput : SensorDataPort;

        part sideScanSonar {
            attribute operatingFrequency : Real = 600.0;
            attribute maximumRange : Distance = 150.0 [m];
            attribute alongTrackResolution : Distance = 0.25 [m];
        }

