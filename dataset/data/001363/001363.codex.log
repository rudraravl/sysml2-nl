    attribute def Mass;
    attribute def Speed;
    attribute def Duration;
    attribute def Energy;
    attribute def Power;
    attribute def Pressure;
    attribute def Temperature;
    attribute def Angle;
    attribute def Distance;
    attribute def DataRate;

    enum def MissionPhase {
        entry;
        initialization;
        transit;
        survey;
        obstacleAvoidance;
        stationKeeping;
        returnTransit;
        recovery;
        abort;
    }

