    part def UnmannedVehicle {
        doc /* Autonomous unmanned vehicle whose primary high-level function is to execute a mission plan without an onboard human operator by navigating from a start location to a destination, avoiding obstacles, operating a payload, and returning telemetry to a remote operator. */

        attribute operatingMode : VehicleMode = VehicleMode::idle;
        attribute missionStatus : MissionStatus = MissionStatus::notLoaded;
        attribute maximumSpeed : Speed = 18.0;
        attribute cruiseSpeed : Speed = 10.0;
        attribute minimumObstacleClearance : Distance = 5.0;
        attribute maximumRange : Distance = 25000.0;
        attribute endurance : Duration = 3600.0;
        attribute emptyMass : Mass = 42.0;

        port missionPlanIn : MissionPlanPort;
        port commandIn : CommandPort;
        port telemetryOut : TelemetryPort;
        port payloadDataOut : PayloadDataPort;

        part powerSubsystem : PowerSubsystem;
        part propulsionSubsystem : PropulsionSubsystem;
        part navigationSubsystem : NavigationSubsystem;
        part autonomyController : AutonomyController;
        part communicationSubsystem : CommunicationSubsystem;
        part obstacleDetectionSubsystem : ObstacleDetectionSubsystem;
        part payloadSubsystem : PayloadSubsystem;
        part vehicleStructure : VehicleStructure;

