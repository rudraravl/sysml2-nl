            in item navigation : NavigationSolution;
            out item telemetry : TelemetryPacket;
            telemetry.mode = activeMode;
            telemetry.missionStatus = missionState;
            telemetry.latitude = navigation.latitude;
            telemetry.longitude = navigation.longitude;
            telemetry.altitude = navigation.altitude;
            telemetry.speed = navigation.groundSpeed;
        }
    }

    part def CommunicationSubsystem {
        attribute linkStatus : LinkStatus = LinkStatus::nominal;
        attribute commandLatency : Duration = 0.25;
        attribute telemetryRate : Frequency = 5.0;
        attribute maximumRange : Distance = 30000.0;

        port commandIn : CommandPort;
        port commandOut : CommandPort;
        port telemetryIn : TelemetryPort;
        port telemetryOut : TelemetryPort;
        port payloadDataIn : PayloadDataPort;
        port payloadDataOut : PayloadDataPort;

        action relayCommand {
            in item operatorCommand : VehicleCommand;
            out item controllerCommand : VehicleCommand;
            controllerCommand = operatorCommand;
        }

        action transmitTelemetry {
            in item telemetry : TelemetryPacket;
            out item transmittedTelemetry : TelemetryPacket;
            transmittedTelemetry = telemetry;
        }

        action transmitPayloadData {
            in item payloadData : PayloadData;
            out item transmittedPayloadData : PayloadData;
            transmittedPayloadData = payloadData;
        }
    }

    part def PayloadSubsystem {
        attribute payloadMass : Mass = 6.0;
        attribute payloadPowerDraw : Real = 120.0;
        attribute payloadTaskComplete : Boolean = false;
        attribute payloadHealth : HealthStatus = HealthStatus::nominal;

        port payloadDataOut : PayloadDataPort;

        action collectData {
            in item navigation : NavigationSolution;
            out item data : PayloadData;
            data.latitude = navigation.latitude;
            data.longitude = navigation.longitude;
            data.qualityScore = 95.0;
            data.dataSizeBytes = 1048576;
        }

        action completePayloadTask {
            payloadTaskComplete = true;
        }
    }

    part def VehicleStructure {
        attribute frameMass : Mass = 18.0;
        attribute payloadCapacity : Mass = 10.0;
        attribute ingressProtectionRating : String = "IP54";
    }

    requirement def PrimaryFunctionRequirement {
        doc /* The unmanned vehicle shall autonomously execute a loaded mission plan without an onboard human operator by navigating to assigned waypoints, avoiding obstacles, operating its payload, and reporting telemetry. */
    }

    requirement def NavigationAccuracyRequirement {
        doc /* The unmanned vehicle shall maintain position uncertainty less than or equal to 3 meters during autonomous navigation. */
        require constraint {
            navigationSubsystem.positionUncertainty <= 3.0
        }
    }

    requirement def ObstacleAvoidanceRequirement {
        doc /* The unmanned vehicle shall maintain at least 5 meters clearance from detected obstacles during mission execution. */
        require constraint {
            minimumObstacleClearance >= 5.0
        }
    }

    requirement def EnduranceRequirement {
        doc /* The unmanned vehicle shall support mission execution for at least 3600 seconds under nominal payload and cruise conditions. */
        require constraint {
            endurance >= 3600.0
        }
    }

    requirement def TelemetryRequirement {
        doc /* The unmanned vehicle shall transmit telemetry at a rate of at least 1 hertz while powered and connected. */
        require constraint {
            communicationSubsystem.telemetryRate >= 1.0
        }
    }

    requirement def ReturnToBaseRequirement {
        doc /* The unmanned vehicle shall enter return-to-base mode when commanded by the operator, when the destination is reached, or when battery state of charge falls to 20 percent or lower. */
    }

    part unmannedVehicleSystem : UnmannedVehicle {
        satisfy PrimaryFunctionRequirement;
        satisfy NavigationAccuracyRequirement;
        satisfy ObstacleAvoidanceRequirement;
        satisfy EnduranceRequirement;
        satisfy TelemetryRequirement;
        satisfy ReturnToBaseRequirement;
    }
