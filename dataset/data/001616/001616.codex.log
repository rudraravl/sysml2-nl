                first navigating
                if autonomyController.destinationReached == true or powerSubsystem.stateOfCharge <= 20.0
                then returningToBase;

            transition returning_to_idle
                first returningToBase
                if autonomyController.baseReached == true
                then idle;

            transition any_to_emergency
                first idle, planning, navigating, avoidingObstacle, operatingPayload, returningToBase
                if powerSubsystem.health == HealthStatus::critical or communicationSubsystem.linkStatus == LinkStatus::disconnected
                then emergencyRecovery;

            transition emergency_to_shutdown
                first emergencyRecovery
                if autonomyController.safeStopAchieved == true
                then shutdown;
        }

        action executeMission {
            in item plan : MissionPlan;
            out item finalTelemetry : TelemetryPacket;

