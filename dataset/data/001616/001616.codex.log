            action validatePlan {
                assert plan.cruiseSpeed <= maximumSpeed;
                assert plan.maximumMissionDuration <= endurance;
                assert plan.minimumObstacleClearance >= minimumObstacleClearance;
            }

            action navigateRoute {
                operatingMode = VehicleMode::autonomousNavigation;
                missionStatus = MissionStatus::executing;
            }

            action operatePayload {
                operatingMode = VehicleMode::payloadOperation;
            }

            action returnToBase {
                operatingMode = VehicleMode::returnToBase;
            }

            action publishFinalTelemetry {
                missionStatus = MissionStatus::completed;
            }
        }
    }

    part def PowerSubsystem {
        attribute nominalVoltage : ElectricPotential = 48.0;
        attribute maximumCurrent : ElectricCurrent = 120.0;
        attribute capacity : EnergyCapacity = 2400.0;
        attribute stateOfCharge : Percent = 100.0;
        attribute health : HealthStatus = HealthStatus::nominal;

        port propulsionPowerOut : ElectricalPowerPort;

        action providePower {
            out attribute voltage : ElectricPotential;
            out attribute current : ElectricCurrent;
            voltage = nominalVoltage;
            current = maximumCurrent;
        }

        action monitorEnergy {
            if stateOfCharge <= 20.0 {
                health = HealthStatus::warning;
            }
            if stateOfCharge <= 8.0 {
                health = HealthStatus::critical;
            }
        }
    }

    part def PropulsionSubsystem {
        attribute commandedSpeed : Speed = 0.0;
        attribute actualSpeed : Speed = 0.0;
        attribute maximumThrust : Real = 850.0;
        attribute propulsionHealth : HealthStatus = HealthStatus::nominal;

        port powerIn : PropulsionPowerPort;
        port motionCommandIn : CommandPort;

        action regulateMotion {
            in item command : VehicleCommand;
            commandedSpeed = command.commandedSpeed;
            if commandedSpeed <= 18.0 {
                actualSpeed = commandedSpeed;
            }
        }

        action stopMotion {
            commandedSpeed = 0.0;
            actualSpeed = 0.0;
        }
    }

    part def NavigationSubsystem {
        attribute updateRate : Frequency = 20.0;
        attribute currentLatitude : Latitude;
        attribute currentLongitude : Longitude;
        attribute currentAltitude : Altitude;
        attribute currentSpeed : Speed;
        attribute positionUncertainty : Distance = 1.5;
        attribute navigationHealth : HealthStatus = HealthStatus::nominal;

        port navigationOut : NavigationPort;

        action estimatePosition {
            out item solution : NavigationSolution;
            solution.latitude = currentLatitude;
            solution.longitude = currentLongitude;
            solution.altitude = currentAltitude;
            solution.groundSpeed = currentSpeed;
            solution.positionUncertainty = positionUncertainty;
        }
    }

    part def ObstacleDetectionSubsystem {
        attribute sensorRange : Distance = 80.0;
        attribute minimumTrackConfidence : Percent = 70.0;
        attribute currentObstacle : ObstacleReport;
        attribute detectionHealth : HealthStatus = HealthStatus::nominal;

        port obstacleOut : ObstaclePort;

        action scanEnvironment {
            out item report : ObstacleReport;
            report = currentObstacle;
        }
    }

    part def AutonomyController {
        attribute activeMode : VehicleMode = VehicleMode::idle;
        attribute missionState : MissionStatus = MissionStatus::notLoaded;
        attribute atPayloadWaypoint : Boolean = false;
        attribute destinationReached : Boolean = false;
        attribute baseReached : Boolean = false;
        attribute safeStopAchieved : Boolean = false;

        port missionPlanIn : MissionPlanPort;
        port navigationIn : NavigationPort;
        port obstacleIn : ObstaclePort;
        port operatorCommandIn : CommandPort;
        port motionCommandOut : ControlSignalPort;
        port telemetryOut : TelemetryPort;

        action planRoute {
            in item plan : MissionPlan;
            assert plan.cruiseSpeed > 0.0;
            assert plan.minimumObstacleClearance >= 5.0;
            missionState = MissionStatus::loaded;
            activeMode = VehicleMode::missionPlanning;
        }

        action computeMotionCommand {
            in item navigation : NavigationSolution;
            in item obstacle : ObstacleReport;
            out item command : VehicleCommand;

            if obstacle.detected == true and obstacle.range <= 20.0 {
                activeMode = VehicleMode::obstacleAvoidance;
                command.commandedSpeed = 3.0;
                command.commandedHeading = obstacle.bearing + 45.0;
            } else {
                activeMode = VehicleMode::autonomousNavigation;
                command.commandedSpeed = 10.0;
                command.commandedHeading = navigation.heading;
            }
        }

        action handleOperatorCommand {
            in item command : VehicleCommand;
            if command.abortMission == true {
                missionState = MissionStatus::aborted;
                activeMode = VehicleMode::emergencyRecovery;
            }
            if command.returnToBase == true {
                activeMode = VehicleMode::returnToBase;
            }
        }

