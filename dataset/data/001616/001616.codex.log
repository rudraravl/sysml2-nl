                first navigating
                if obstacleDetectionSubsystem.currentObstacle.detected == true
                then avoidingObstacle;

            transition avoiding_to_navigating
                first avoidingObstacle
                if obstacleDetectionSubsystem.currentObstacle.detected == false
                then navigating;

