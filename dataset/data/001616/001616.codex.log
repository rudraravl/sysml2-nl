            from autonomyController.telemetryOut
            to communicationSubsystem.telemetryIn;

        connect payloadDataToCommunication
            from payloadSubsystem.payloadDataOut
            to communicationSubsystem.payloadDataIn;

        connect missionPlanToController
            from missionPlanIn
            to autonomyController.missionPlanIn;

        connect commandToCommunication
            from commandIn
            to communicationSubsystem.commandIn;

