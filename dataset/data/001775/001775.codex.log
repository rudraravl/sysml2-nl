            lowPressureLiquid.phase == WorkingFluidPhase::liquid;
            highPressureLiquid.fluidPressure > lowPressureLiquid.fluidPressure;
        }
    }

    action def RegulateEnginePower {
        in demandedPower : EnergyRate;
        in measuredSpeed : RotationalSpeed;
        in measuredPressure : Pressure;
        out fuelValveCommand : Real;
        out pumpSpeedCommand : Real;
        out expanderAdmissionCommand : Real;

        constraint commandRanges {
            fuelValveCommand >= 0.0;
            fuelValveCommand <= 1.0;
            pumpSpeedCommand >= 0.0;
            pumpSpeedCommand <= 1.0;
            expanderAdmissionCommand >= 0.0;
            expanderAdmissionCommand <= 1.0;
        }
    }

    action def ReduceMechanicalFriction {
        in oilFlowRate : MassFlowRate;
        out frictionReductionEffect : Real;
    }

    action def SupportEngineComponents {
        in mechanicalLoad : Torque;
        out frameDeflection : Real;
    }

    state def ExternalCombustionEngineStateMachine {
        entry action initializeController;

        state off;
        state preheat;
        state starting;
        state running;
        state loadFollowing;
        state shutdown;
        state fault;

        transition initial then off;

        transition off_to_preheat
            first off
            accept StartCommand
            then preheat;

        transition preheat_to_starting
            first preheat
            accept WorkingFluidWarm
            then starting;

        transition starting_to_running
            first starting
            accept StableShaftSpeed
            then running;

        transition running_to_loadFollowing
            first running
            accept LoadDemandChanged
            then loadFollowing;

        transition loadFollowing_to_running
            first loadFollowing
            accept DemandSettled
            then running;

        transition running_to_shutdown
            first running
            accept StopCommand
            then shutdown;

        transition shutdown_to_off
            first shutdown
            accept ShaftStopped
            then off;

        transition any_to_fault
            first off
            accept CriticalFault
            then fault;

        transition fault_to_off
            first fault
            accept FaultCleared
            then off;
    }

    requirement def PrimaryFunctionRequirement {
        doc /* The external combustion engine shall convert heat released by fuel combustion outside the working-fluid expansion chamber into continuous rotary mechanical power at the shaft output. */
        subject engine : ExternalCombustionEngine;

        require constraint {
            engine.shaftOutput.mechanicalPower.power >= 50000 [W];
        }
    }

    requirement def ExternalCombustionRequirement {
        doc /* Fuel combustion shall occur in a combustion chamber physically separated from the working fluid loop. */
        subject engine : ExternalCombustionEngine;

        require constraint {
            engine.combustor != engine.expander;
        }
    }

    requirement def ClosedLoopWorkingFluidRequirement {
        doc /* The working fluid shall remain in a closed loop that receives heat through the heat exchanger, expands through the expansion machine, condenses, and is repressurized by the feed pump. */
        subject engine : ExternalCombustionEngine;

        require constraint {
            engine.workingFluidLoop.nominalHighPressure > engine.workingFluidLoop.nominalLowPressure;
        }
    }

    requirement def ThermalEfficiencyRequirement {
        doc /* The engine shall achieve a nominal thermal efficiency of at least twenty five percent at rated operating conditions. */
        subject engine : ExternalCombustionEngine;

        require constraint {
            engine.nominalThermalEfficiency >= 0.25;
        }
    }

    requirement def PressureProtectionRequirement {
        doc /* The working fluid pressure shall remain below the maximum allowable working pressure during all commanded operating states. */
        subject engine : ExternalCombustionEngine;

        require constraint {
            engine.maximumWorkingPressure <= 1200000 [Pa];
        }
    }

    requirement def TemperatureProtectionRequirement {
        doc /* The working fluid temperature shall remain below the maximum allowable working temperature during all commanded operating states. */
        subject engine : ExternalCombustionEngine;

        require constraint {
            engine.maximumWorkingTemperature <= 750 [K];
        }
    }

    requirement def ExhaustDischargeRequirement {
        doc /* The system shall discharge combustion products through the exhaust outlet after heat has been transferred to the working fluid. */
        subject engine : ExternalCombustionEngine;

        require constraint {
            engine.heatExchanger.hotSideOutletTemperature < engine.heatExchanger.hotSideInletTemperature;
        }
    }

    requirement def ControlRequirement {
        doc /* The controller shall modulate fuel flow, pump speed, and expander admission to maintain demanded shaft power while respecting pressure and temperature limits. */
        subject controller : EngineController;

        require constraint {
            controller.fuelValveCommand >= 0.0 and controller.fuelValveCommand <= 1.0;
            controller.pumpSpeedCommand >= 0.0 and controller.pumpSpeedCommand <= 1.0;
            controller.expanderValveCommand >= 0.0 and controller.expanderValveCommand <= 1.0;
        }
    }

    satisfy PrimaryFunctionRequirement by ExternalCombustionEngine;
    satisfy ExternalCombustionRequirement by ExternalCombustionEngine;
    satisfy ClosedLoopWorkingFluidRequirement by ClosedWorkingFluidLoop;
    satisfy ThermalEfficiencyRequirement by ExternalCombustionEngine;
    satisfy PressureProtectionRequirement by ExternalCombustionEngine;
    satisfy TemperatureProtectionRequirement by ExternalCombustionEngine;
    satisfy ExhaustDischargeRequirement by ExternalHeatExchanger;
    satisfy ControlRequirement by EngineController;

    part externalCombustionEngineSystem : ExternalCombustionEngine {
        :>> ratedOutputPower = 50000 [W];
        :>> nominalThermalEfficiency = 0.28;
        :>> maximumWorkingPressure = 1200000 [Pa];
        :>> maximumWorkingTemperature = 750 [K];
    }
}
