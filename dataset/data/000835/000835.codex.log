        connect classifier.generalOut to generalBranch.input;
        connect classifier.specializedOut to specializedBranch.input;
        connect generalBranch.result to aggregator.generalResult;
        connect specializedBranch.result to aggregator.specializedResult;
        connect aggregator.generalResult to externalResult;

        connect classifier.health to controlUnit.classifierHealth;
        connect generalBranch.health to controlUnit.generalHealth;
        connect specializedBranch.health to controlUnit.specializedHealth;
        connect aggregator.health to controlUnit.aggregatorHealth;
        connect controlUnit.aggregatorHealth to externalHealth;

        connect powerSubsystem.classifierPower to classifier.power;
        connect powerSubsystem.generalPower to generalBranch.power;
        connect powerSubsystem.specializedPower to specializedBranch.power;

        action primaryFunction {
            in item incoming : RawInputItem;
            out item result : ProcessedResult;

            first receiveInput;
            then classifyAgainstYSet;
            then routeToSelectedBranch;
            then processBranchWork;
            then aggregateAndReport;

            action receiveInput {
                in item raw : RawInputItem;
            }

            action classifyAgainstYSet {
                in item raw : RawInputItem;
                out item classified : ClassifiedItem;
            }

            action routeToSelectedBranch {
                in item classified : ClassifiedItem;
            }

            action processBranchWork {
                in item classified : ClassifiedItem;
                out item processed : ProcessedResult;
            }

            action aggregateAndReport {
                in item processed : ProcessedResult;
                out item delivered : ProcessedResult;
            }
        }
    }

    requirement def PrimaryFunctionRequirement {
        subject system : YSetBasedSystem;

        doc /* The system shall use a Y-shaped set structure to accept input through one common stem, classify each input into a defined branch, process the selected branch, and return a unified result. */

        require constraint {
            system.aggregator.deliverySuccessRate >= 99.0
        }
    }

