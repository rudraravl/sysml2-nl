    attribute currentAssessment : PneumoniaAssessment;
    attribute supportInterval : TimeDuration = 300.0;
    attribute batteryCritical : Boolean;
    attribute sensorFailure : Boolean;
  }

  part def PneumoniaRiskEstimator {
    attribute feverWeight : Real = 0.25;
    attribute tachypneaWeight : Real = 0.25;
    attribute hypoxemiaWeight : Real = 0.30;
    attribute abnormalBreathSoundWeight : Real = 0.20;

    port assessmentPort : AssessmentPort;

    action def estimateRisk {
      in sample : PhysiologicalSample;
      out assessment : PneumoniaAssessment;
    }
  }

  part def ChestComfortTherapyModule {
    attribute maximumHeaterPower : Power = 8.0;
    attribute maximumVibrationPower : Power = 2.0;
    attribute defaultTargetChestTemperature : Temperature = 37.0;

    port powerIn : PowerPort;
    port controlIn : TherapyControlPort;

    part heatingPanelLeft : HeatingPanel;
    part heatingPanelRight : HeatingPanel;
    part vibrationPadLeft : VibrationPad;
    part vibrationPadRight : VibrationPad;

    action def applyComfortTherapy {
      in command : TherapyCommand;
      out deliveredHeatPower : Power;
      out deliveredVibrationIntensity : Real;
    }
  }

  part def HeatingPanel {
    attribute targetTemperature : Temperature = 37.0;
    attribute maximumTemperature : Temperature = 41.0;
    attribute powerDraw : Power = 4.0;
    port powerIn : PowerPort;
  }

  part def VibrationPad {
    attribute intensity : Real = 0.4;
    attribute frequency : Real { unit = "Hz"; } = 25.0;
    attribute powerDraw : Power = 1.0;
    port powerIn : PowerPort;
  }

  part def JacketUserInterface {
    port alertIn : AlertPort;
    port powerIn : PowerPort;

    part statusLight : StatusLight;
    part hapticMotor : HapticMotor;
    part acknowledgeButton : Button;

    action def presentAlert {
      in alert : UserAlert;
    }
  }

  part def StatusLight {
    attribute colorCode : Integer;
    attribute blinkRate : Real { unit = "Hz"; } = 1.0;
  }

  part def HapticMotor {
    attribute vibrationStrength : Real = 0.6;
    attribute vibrationDuration : TimeDuration = 2.0;
  }

  part def Button {
    attribute pressed : Boolean;
  }

  part def BatteryPack {
    attribute nominalVoltage : Real { unit = "V"; } = 7.4;
    attribute capacity : Real { unit = "A*h"; } = 4.0;
    attribute chargeRemaining : BatteryCharge = 100.0;
    attribute lowChargeThreshold : BatteryCharge = 15.0;
    attribute criticalChargeThreshold : BatteryCharge = 5.0;

    port powerOut : PowerPort;

    state def BatteryStateMachine {
      state Charged;
      state Discharging;
      state Low;
      state Critical;
      state Charging;

      transition first Charged;
      transition Charged_to_Discharging
        first Charged then Discharging
        accept LoadConnected;

      transition Discharging_to_Low
        first Discharging then Low
        if chargeRemaining <= lowChargeThreshold;

      transition Low_to_Critical
        first Low then Critical
        if chargeRemaining <= criticalChargeThreshold;

      transition Discharging_to_Charging
        first Discharging then Charging
        accept ChargerConnected;

      transition Low_to_Charging
        first Low then Charging
        accept ChargerConnected;

      transition Charging_to_Charged
        first Charging then Charged
        if chargeRemaining >= 99.0;
    }
  }

  part def CommunicationModule {
    attribute bluetoothEnabled : Boolean = true;
    attribute encryptionEnabled : Boolean = true;
    attribute transmitInterval : TimeDuration = 60.0;

    port powerIn : PowerPort;
    port dataIn : WirelessPort;
    port radioPort : WirelessPort;

    action def transmitSummary {
      in assessment : PneumoniaAssessment;
      out packet : WirelessPacket;
    }
  }

  part def DataLogger {
    attribute storageCapacity : Real { unit = "Mbyte"; } = 128.0;
    attribute sampleRetentionTime : Real { unit = "d"; } = 14.0;

    action def storeSample {
      in sample : PhysiologicalSample;
      in assessment : PneumoniaAssessment;
    }
  }

  action def monitorAndSupportPatient {
    in wearerPresent : Boolean;
    out currentAssessment : PneumoniaAssessment;

    action collectPhysiologicalSignals;
    action estimatePneumoniaRisk;
    action maintainChestWarmth;
    action notifyCaregiverWhenNeeded;
  }

  requirement def PrimaryFunctionRequirement {
    doc /* The pneumonia jacket shall continuously monitor respiratory and vital signs of a wearer, estimate pneumonia-related risk indicators, provide gentle chest warming and vibration support, and alert the wearer or caregiver when signs indicate possible deterioration. */

    subject jacket : PneumoniaJacket;

    require constraint {
      jacket.monitoringInterval <= 10.0
    }
  }

  requirement def PhysiologicalMonitoringRequirement {
    doc /* The jacket shall measure body temperature, respiratory rate, oxygen saturation, heart rate, chest expansion, and breath sound features while worn. */

    subject sensors : SensorArray;

    require constraint {
      sensors.temperatureSensor.accuracy <= 0.2 and
      sensors.pulseOximeter.oxygenSaturationAccuracy <= 3.0 and
      sensors.respirationBand.respiratoryRateAccuracy <= 2.0
    }
  }

  requirement def RiskAssessmentRequirement {
    doc /* The controller shall classify fever, tachypnea, hypoxemia, and abnormal breath sounds into a pneumonia risk assessment at least once every monitoring interval. */

    subject controller : EmbeddedController;

    require constraint {
      controller.feverThreshold == 38.0 and
      controller.hypoxemiaThreshold == 92.0 and
      controller.highRiskThreshold == 0.70
    }
  }

  requirement def AlertRequirement {
    doc /* The jacket shall issue a local and wireless alert when the computed pneumonia risk score is high or oxygen saturation falls below the configured hypoxemia threshold. */

    subject controller : EmbeddedController;

    require constraint {
      controller.currentAssessment.alertRequired ==
        (controller.currentAssessment.riskScore >= controller.highRiskThreshold or
         controller.currentAssessment.hypoxemiaDetected)
    }
  }

  requirement def ComfortTherapyRequirement {
    doc /* The jacket shall provide non-invasive chest comfort therapy by warming the chest area below the safe skin contact temperature and applying low-intensity vibration when moderate risk indicators are present. */

    subject therapy : ChestComfortTherapyModule;

    require constraint {
      therapy.heatingPanelLeft.maximumTemperature <= 41.0 and
      therapy.heatingPanelRight.maximumTemperature <= 41.0 and
      therapy.maximumVibrationPower <= 2.0
    }
  }

  requirement def WearabilityRequirement {
    doc /* The jacket shall remain wearable for daily use by limiting total mass and using breathable skin-safe textile layers. */

    subject jacket : PneumoniaJacket;

    require constraint {
      jacket.mass <= 1.0 and
      jacket.textileShell.innerLayer.breathable and
      jacket.textileShell.innerLayer.skinSafe
    }
  }

  requirement def PowerRequirement {
    doc /* The jacket shall support portable operation and warn before battery charge reaches a critical level. */

    subject battery : BatteryPack;

    require constraint {
      battery.capacity >= 3.0 and
      battery.lowChargeThreshold > battery.criticalChargeThreshold
    }
  }

  satisfy PrimaryFunctionRequirement by PneumoniaJacket;
  satisfy PhysiologicalMonitoringRequirement by SensorArray;
  satisfy RiskAssessmentRequirement by EmbeddedController;
  satisfy AlertRequirement by EmbeddedController;
  satisfy ComfortTherapyRequirement by ChestComfortTherapyModule;
  satisfy WearabilityRequirement by PneumoniaJacket;
  satisfy PowerRequirement by BatteryPack;

}
