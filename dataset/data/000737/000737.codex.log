      transition first Charged;
      transition Charged_to_Discharging
        first Charged then Discharging
        accept LoadConnected;

      transition Discharging_to_Low
        first Discharging then Low
        if chargeRemaining <= lowChargeThreshold;

      transition Low_to_Critical
        first Low then Critical
        if chargeRemaining <= criticalChargeThreshold;

      transition Discharging_to_Charging
        first Discharging then Charging
        accept ChargerConnected;

      transition Low_to_Charging
        first Low then Charging
        accept ChargerConnected;

      transition Charging_to_Charged
        first Charging then Charged
        if chargeRemaining >= 99.0;
    }
  }

