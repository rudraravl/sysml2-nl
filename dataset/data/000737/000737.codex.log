    in wearerPresent : Boolean;
    out currentAssessment : PneumoniaAssessment;

    action collectPhysiologicalSignals;
    action estimatePneumoniaRisk;
    action maintainChestWarmth;
    action notifyCaregiverWhenNeeded;
  }

  requirement def PrimaryFunctionRequirement {
    doc /* The pneumonia jacket shall continuously monitor respiratory and vital signs of a wearer, estimate pneumonia-related risk indicators, provide gentle chest warming and vibration support, and alert the wearer or caregiver when signs indicate possible deterioration. */

    subject jacket : PneumoniaJacket;

    require constraint {
      jacket.monitoringInterval <= 10.0
    }
  }

  requirement def PhysiologicalMonitoringRequirement {
    doc /* The jacket shall measure body temperature, respiratory rate, oxygen saturation, heart rate, chest expansion, and breath sound features while worn. */

    subject sensors : SensorArray;

    require constraint {
      sensors.temperatureSensor.accuracy <= 0.2 and
      sensors.pulseOximeter.oxygenSaturationAccuracy <= 3.0 and
      sensors.respirationBand.respiratoryRateAccuracy <= 2.0
    }
  }

  requirement def RiskAssessmentRequirement {
    doc /* The controller shall classify fever, tachypnea, hypoxemia, and abnormal breath sounds into a pneumonia risk assessment at least once every monitoring interval. */

    subject controller : EmbeddedController;

    require constraint {
      controller.feverThreshold == 38.0 and
      controller.hypoxemiaThreshold == 92.0 and
      controller.highRiskThreshold == 0.70
    }
  }

  requirement def AlertRequirement {
    doc /* The jacket shall issue a local and wireless alert when the computed pneumonia risk score is high or oxygen saturation falls below the configured hypoxemia threshold. */

    subject controller : EmbeddedController;

    require constraint {
      controller.currentAssessment.alertRequired ==
        (controller.currentAssessment.riskScore >= controller.highRiskThreshold or
         controller.currentAssessment.hypoxemiaDetected)
    }
  }

  requirement def ComfortTherapyRequirement {
    doc /* The jacket shall provide non-invasive chest comfort therapy by warming the chest area below the safe skin contact temperature and applying low-intensity vibration when moderate risk indicators are present. */

    subject therapy : ChestComfortTherapyModule;

    require constraint {
      therapy.heatingPanelLeft.maximumTemperature <= 41.0 and
      therapy.heatingPanelRight.maximumTemperature <= 41.0 and
      therapy.maximumVibrationPower <= 2.0
    }
  }

  requirement def WearabilityRequirement {
    doc /* The jacket shall remain wearable for daily use by limiting total mass and using breathable skin-safe textile layers. */

    subject jacket : PneumoniaJacket;

    require constraint {
      jacket.mass <= 1.0 and
      jacket.textileShell.innerLayer.breathable and
      jacket.textileShell.innerLayer.skinSafe
    }
  }

  requirement def PowerRequirement {
    doc /* The jacket shall support portable operation and warn before battery charge reaches a critical level. */

    subject battery : BatteryPack;

    require constraint {
      battery.capacity >= 3.0 and
      battery.lowChargeThreshold > battery.criticalChargeThreshold
    }
  }

  satisfy PrimaryFunctionRequirement by PneumoniaJacket;
  satisfy PhysiologicalMonitoringRequirement by SensorArray;
  satisfy RiskAssessmentRequirement by EmbeddedController;
  satisfy AlertRequirement by EmbeddedController;
  satisfy ComfortTherapyRequirement by ChestComfortTherapyModule;
  satisfy WearabilityRequirement by PneumoniaJacket;
  satisfy PowerRequirement by BatteryPack;

}
