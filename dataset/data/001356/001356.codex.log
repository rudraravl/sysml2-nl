  requirement def DeliveryCapacityRequirement {
    subject robot : DeliveryRobot;

    require constraint {
      robot.payloadCapacity >= 8 [kg]
    }
  }

  requirement def FoodSafetyRequirement {
    subject inventory : InventoryManager;

    require constraint {
      inventory.chilledStorageTemperature <= 5 [degC]
    }
  }

  requirement def RestaurantThroughputRequirement {
    subject restaurant : AutomatedRestaurant;

    require constraint {
      restaurant.dailyOrderCapacity >= 600
    }
  }

  satisfy HighLevelFunctionRequirement by AutomatedRestaurant;
  satisfy PaymentRequirement by AutomatedRestaurant::paymentProcessor;
  satisfy KitchenPerformanceRequirement by AutomatedRestaurant::kitchenCell;
  satisfy DeliveryCapacityRequirement by AutomatedRestaurant::deliveryRobot;
  satisfy FoodSafetyRequirement by AutomatedRestaurant::inventoryManager;
  satisfy RestaurantThroughputRequirement by AutomatedRestaurant;
}
