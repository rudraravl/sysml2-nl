    in item proppant : Proppant;
    in item additive : ChemicalAdditive;
    out item slurry : FracturingFluid;
  }

  action def PressurizeAndInject {
    in item slurry : FracturingFluid;
    out item pressurizedSlurry : FracturingFluid;
  }

  action def CreateAndPropFractures {
    in item pressurizedSlurry : FracturingFluid;
    out item stimulatedReservoir : FractureNetwork;
  }

  action def FlowbackAndSeparate {
    in item reservoirFluid : ProducedFluid;
    out item recoveredWater : ProducedFluid;
    out item recoveredHydrocarbon : ProducedFluid;
  }

  state def FracturingJobStateMachine {
    state Idle;
    state SiteRigUp;
    state PressureTest;
    state PadInjection;
    state ProppantRamp;
    state Flush;
    state ShutIn;
    state Flowback;
    state Complete;
    state EmergencyShutdown;

    transition first Idle then SiteRigUp;
    transition SiteRigUp then PressureTest;
    transition PressureTest then PadInjection;
    transition PadInjection then ProppantRamp;
    transition ProppantRamp then Flush;
    transition Flush then ShutIn;
    transition ShutIn then Flowback;
    transition Flowback then Complete;

    transition Idle then EmergencyShutdown;
    transition SiteRigUp then EmergencyShutdown;
    transition PressureTest then EmergencyShutdown;
    transition PadInjection then EmergencyShutdown;
    transition ProppantRamp then EmergencyShutdown;
    transition Flush then EmergencyShutdown;
    transition ShutIn then EmergencyShutdown;
    transition Flowback then EmergencyShutdown;
  }

  part def HydraulicFracturingSystem {
    attribute primaryFunction : String =
      "Blend water, proppant, and additives into fracturing fluid; pump the fluid at controlled high pressure into a completed wellbore; create and prop conductive fractures in the target reservoir; and manage flowback while maintaining pressure, containment, and environmental safeguards.";

    attribute totalDesignedPumpRate : FlowRateValue = 36;
    attribute maximumSurfaceTreatingPressure : PressureValue = 82;
    attribute designedStageVolume : VolumeValue = 3500;
    attribute targetReservoirDepth : DepthValue = 3200;

    part waterStorage : WaterStorageTank;
    part chemicalStorage : ChemicalStorageUnit;
    part proppantStorage : ProppantSilo;
    part blender : HydrationAndBlendingUnit;
    part pump[9] : HighPressurePump;
    part manifold : PumpManifold;
    part wellhead : Wellhead;
    part reservoir : SubsurfaceReservoir;
    part separator : FlowbackSeparator;
    part controller : ClosedLoopControlSystem;
    part safety : SafetyInterlockSystem;
    part jobBehavior : FracturingJobStateMachine;

    connect waterStorage.outlet to blender.waterInlet;
    connect chemicalStorage.outlet to blender.chemicalInlet;
    connect proppantStorage.discharge to blender.proppantInlet;

    connect blender.slurryOutlet to pump.suction;
    connect pump.discharge to manifold.inlet;
    connect manifold.outlet to wellhead.treatmentInlet;
    connect wellhead.treatmentInlet to reservoir.treatmentInlet;
    connect reservoir.producedFluidOutlet to wellhead.producedFluidOutlet;
    connect wellhead.producedFluidOutlet to separator.inlet;

    connect waterStorage.levelTelemetry to controller.flowTelemetry;
    connect blender.telemetry to controller.flowTelemetry;
    connect pump.telemetry to controller.pressureTelemetry;
    connect manifold.telemetry to controller.pressureTelemetry;
    connect wellhead.telemetry to controller.pressureTelemetry;
    connect separator.telemetry to controller.flowTelemetry;

    connect controller.blenderCommand to blender.control;
    connect controller.pumpCommands to pump.control;
    connect controller.wellheadCommand to safety.shutdownCommand;
    connect safety.shutdownCommand to pump.control;
  }

  requirement def PrimaryFunctionRequirement {
    subject system : HydraulicFracturingSystem;
    require constraint {
      system.totalDesignedPumpRate >= 30 and
      system.maximumSurfaceTreatingPressure <= 82
    }
  }

  requirement def PressureContainmentRequirement {
    subject system : HydraulicFracturingSystem;
    require constraint {
      system.wellhead.pressureRating > system.maximumSurfaceTreatingPressure and
      system.manifold.maxOperatingPressure > system.maximumSurfaceTreatingPressure
    }
  }

  requirement def ReservoirProtectionRequirement {
    subject system : HydraulicFracturingSystem;
    require constraint {
      system.maximumSurfaceTreatingPressure <= system.reservoir.maximumAllowableFracturePressure and
      system.reservoir.fractures.containedWithinTargetZone == true
    }
  }

  requirement def BlendQualityRequirement {
    subject system : HydraulicFracturingSystem;
    require constraint {
      system.blender.maxBlendRate >= system.totalDesignedPumpRate / 3 and
      system.blender.targetProppantConcentration >= 0
    }
  }

  requirement def SafetyShutdownRequirement {
    subject system : HydraulicFracturingSystem;
    require constraint {
      system.safety.emergencyShutdownEnabled == true and
      system.safety.highPressureTrip > system.maximumSurfaceTreatingPressure
    }
  }

  requirement def ClosedLoopControlRequirement {
    subject system : HydraulicFracturingSystem;
    require constraint {
      system.controller.samplePeriod <= 1.0 and
      system.controller.emergencyShutdownEnabled == true
    }
  }

  requirement def FlowbackManagementRequirement {
    subject system : HydraulicFracturingSystem;
    require constraint {
      system.separator.maxLiquidRate >= 4
    }
  }

