    unit = "kW";
  }

  item def Water {
    attribute temperature : TemperatureValue;
    attribute dissolvedSolids : ConcentrationValue;
  }

  item def Proppant {
    attribute meshSize : Integer;
    attribute bulkDensity : ConcentrationValue;
  }

  item def ChemicalAdditive {
    attribute additiveType : String;
    attribute dosage : ConcentrationValue;
  }

  item def FracturingFluid {
    attribute pressure : PressureValue;
    attribute flowRate : FlowRateValue;
    attribute slurryDensity : ConcentrationValue;
    attribute proppantConcentration : ConcentrationValue;
    part carrierWater : Water;
    part suspendedProppant : Proppant;
    part additive : ChemicalAdditive[0..*];
  }

  item def ProducedFluid {
    attribute flowRate : FlowRateValue;
    attribute pressure : PressureValue;
    attribute hydrocarbonFraction : Real;
    attribute waterFraction : Real;
    attribute solidsConcentration : ConcentrationValue;
  }

  item def ControlSignal {
    attribute commandName : String;
    attribute targetValue : Real;
    attribute timestamp : String;
  }

  item def SensorReading {
    attribute measuredValue : Real;
    attribute unitSymbol : String;
    attribute timestamp : String;
    attribute valid : Boolean;
  }

  port def FluidInletPort {
    in item fluid : FracturingFluid;
    attribute ratedPressure : PressureValue;
    attribute ratedFlow : FlowRateValue;
  }

  port def FluidOutletPort {
    out item fluid : FracturingFluid;
    attribute ratedPressure : PressureValue;
    attribute ratedFlow : FlowRateValue;
  }

  port def ProducedFluidPort {
    out item producedFluid : ProducedFluid;
    attribute ratedFlow : FlowRateValue;
  }

  port def ControlInputPort {
    in item command : ControlSignal;
  }

  port def TelemetryOutputPort {
    out item reading : SensorReading;
  }

  port def PowerPort {
    in attribute electricalPower : PowerValue;
  }

  connection def FluidConnection {
    end source : FluidOutletPort;
    end target : FluidInletPort;
  }

  connection def ControlConnection {
    end controller : ControlInputPort;
    end controlledEquipment : ControlInputPort;
  }

  part def WaterStorageTank {
    attribute capacity : VolumeValue = 8000;
    attribute currentVolume : VolumeValue;
    port outlet : FluidOutletPort {
      attribute ratedPressure = 1;
      attribute ratedFlow = 12;
    }
    port levelTelemetry : TelemetryOutputPort;
  }

  part def ChemicalStorageUnit {
    attribute additiveCapacity : VolumeValue = 120;
    port outlet : FluidOutletPort {
      attribute ratedPressure = 1;
      attribute ratedFlow = 2;
    }
    port telemetry : TelemetryOutputPort;
  }

  part def ProppantSilo {
    attribute capacity : VolumeValue = 600;
    attribute remainingProppantMass : Real;
    port discharge : FluidOutletPort {
      attribute ratedPressure = 1;
      attribute ratedFlow = 8;
    }
    port telemetry : TelemetryOutputPort;
  }

  part def HydrationAndBlendingUnit {
    attribute maxBlendRate : FlowRateValue = 14;
    attribute targetProppantConcentration : ConcentrationValue;
    port waterInlet : FluidInletPort;
    port chemicalInlet : FluidInletPort;
    port proppantInlet : FluidInletPort;
    port slurryOutlet : FluidOutletPort {
      attribute ratedPressure = 3;
      attribute ratedFlow = 14;
    }
    port control : ControlInputPort;
    port telemetry : TelemetryOutputPort;
  }

  part def HighPressurePump {
    attribute maxDischargePressure : PressureValue = 85;
    attribute maxFlowRate : FlowRateValue = 4;
    attribute ratedPower : PowerValue = 2500;
    port suction : FluidInletPort;
    port discharge : FluidOutletPort {
      attribute ratedPressure = 85;
      attribute ratedFlow = 4;
    }
    port power : PowerPort;
    port control : ControlInputPort;
    port telemetry : TelemetryOutputPort;
  }

  part def PumpManifold {
    attribute maxOperatingPressure : PressureValue = 90;
    port inlet : FluidInletPort[1..12];
    port outlet : FluidOutletPort {
      attribute ratedPressure = 90;
      attribute ratedFlow = 48;
    }
    port telemetry : TelemetryOutputPort;
  }

  part def Wellhead {
    attribute pressureRating : PressureValue = 100;
    attribute surfacePressureLimit : PressureValue = 82;
    port treatmentInlet : FluidInletPort;
    port producedFluidOutlet : ProducedFluidPort;
    port telemetry : TelemetryOutputPort;
  }

  part def Casing {
    attribute innerDiameter : Real;
    attribute cementIntegrityIndex : Real;
    attribute measuredDepth : DepthValue;
  }

  part def PerforatedInterval {
    attribute topDepth : DepthValue;
    attribute bottomDepth : DepthValue;
    attribute perforationCount : Integer;
    attribute formationBreakdownPressure : PressureValue;
  }

  part def FractureNetwork {
    attribute estimatedHalfLength : DepthValue;
    attribute estimatedHeight : DepthValue;
    attribute conductivity : Real;
    attribute containedWithinTargetZone : Boolean;
  }

  part def SubsurfaceReservoir {
    attribute targetDepth : DepthValue = 3200;
    attribute porePressure : PressureValue = 42;
    attribute minimumHorizontalStress : PressureValue = 56;
    attribute maximumAllowableFracturePressure : PressureValue = 78;
    part casing : Casing;
    part interval : PerforatedInterval;
    part fractures : FractureNetwork;
    port treatmentInlet : FluidInletPort;
    port producedFluidOutlet : ProducedFluidPort;
  }

  part def FlowbackSeparator {
    attribute maxLiquidRate : FlowRateValue = 6;
    attribute maxGasRate : Real;
    port inlet : ProducedFluidPort;
    port waterOutlet : ProducedFluidPort;
    port hydrocarbonOutlet : ProducedFluidPort;
    port solidsOutlet : ProducedFluidPort;
    port telemetry : TelemetryOutputPort;
  }

  part def ClosedLoopControlSystem {
    attribute samplePeriod : Real = 0.5;
    attribute pressureSetpoint : PressureValue;
    attribute flowSetpoint : FlowRateValue;
    attribute emergencyShutdownEnabled : Boolean = true;
    port pressureTelemetry : TelemetryOutputPort[0..*];
    port flowTelemetry : TelemetryOutputPort[0..*];
    port pumpCommands : ControlInputPort[0..*];
    port blenderCommand : ControlInputPort;
    port wellheadCommand : ControlInputPort;
  }

  part def SafetyInterlockSystem {
    attribute highPressureTrip : PressureValue = 84;
    attribute lowSuctionPressureTrip : PressureValue = 0.2;
    attribute leakDetected : Boolean;
    attribute emergencyStopRequested : Boolean;
    port telemetryIn : TelemetryOutputPort[0..*];
    port shutdownCommand : ControlInputPort;
  }

  action def PrepareTreatment {
    out item readyCommand : ControlSignal;
  }

  action def BlendFracturingFluid {
