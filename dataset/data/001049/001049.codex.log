        unit = SI::radian;
    }

    attribute def AngularRate :> ISQ::angularVelocity {
        unit = SI::radianPerSecond;
    }

    attribute def Duration :> ISQ::time {
        unit = SI::second;
    }

    attribute def Frequency :> ISQ::frequency {
        unit = SI::hertz;
    }

    attribute def Power :> ISQ::power {
        unit = SI::watt;
