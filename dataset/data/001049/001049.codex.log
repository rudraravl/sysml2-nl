        subject sensingUnit = fineGuidanceSensingUnit;
    }

    requirement thermalOperatingRange : ThermalOperatingRange {
        subject sensingUnit = fineGuidanceSensingUnit;
    }

    requirement validMeasurementQuality : ValidMeasurementQuality {
