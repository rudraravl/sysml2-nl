        }
    }

    requirement def HighWindProtectionRequirement {
        subject rotor : RotorAssembly;

        require constraint {
            rotor.cutOutWindSpeed <= 25.0 [m/s] and
            rotor.pitchAngle <= 85 [deg]
        }
    }

    requirement def EnergyStorageRequirement {
        subject storage : BatteryStorage;

        require constraint {
            storage.nominalCapacity >= 120 [kWh] and
            storage.minimumStateOfCharge >= 0.20 and
            storage.maximumStateOfCharge <= 0.95
        }
    }

    satisfy PrimaryFunctionSatisfaction by WindmillSystem;
    satisfy WindCaptureSatisfaction by RotorAssembly;
    satisfy ElectricalOutputSatisfaction by Generator;
    satisfy WaterDeliverySatisfaction by MechanicalPump;
    satisfy HighWindProtectionSatisfaction by YawAndPitchController;
    satisfy EnergyStorageSatisfaction by BatteryStorage;
}
