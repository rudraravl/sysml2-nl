    doc /* Mobile, rugged, remotely supervised inspection robot whose primary function is to enter hazardous or hard-to-access industrial areas, collect visual, thermal, gas, radiation, acoustic, and positional data, and report actionable inspection findings while reducing human exposure. */

    port commandIn : in CommandMessage;
    port missionPlanIn : in MissionPlan;
    port telemetryOut : out TelemetryFrame;
    port visualOut : out VisualImage;
    port thermalOut : out ThermalImage;
    port gasOut : out GasReading;
    port radiationOut : out RadiationReading;
    port acousticOut : out AcousticReading;
    port findingOut : out InspectionFinding;

    part battery : BatteryPack;
    part driveBase : DriveBase;
    part sensorMast : PanTiltSensorMast;
    part sensorSuite : EnvironmentalSensorSuite;
    part computer : OnboardComputer;
    part emergencyStop : EmergencyStopModule;

    attribute robotIdentifier : String = "Taurob-Inspector-UGV-01";
    attribute ingressProtectionRating : String = "IP65";
    attribute operatingTemperatureMin : TemperatureCelsius = -20.0;
    attribute operatingTemperatureMax : TemperatureCelsius = 50.0;
    attribute nominalMissionEndurance : Time;
    attribute payloadMassCapacity : Mass;
    attribute primaryFunction : String = "Remote hazardous-area inspection and condition assessment";

