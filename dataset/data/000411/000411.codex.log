    connect battery.powerOut to sensorMast.powerIn;
    connect battery.powerOut to sensorSuite.powerIn;
    connect battery.powerOut to computer.powerIn;
    connect computer.motionCommandOut to driveBase.motionCommandIn;
    connect computer.sensorPointingCommandOut to sensorMast.pointingCommandIn;
    connect driveBase.odometryOut to computer.odometryIn;
    connect sensorMast.visualOut to computer.visualIn;
    connect sensorMast.thermalOut to computer.thermalIn;
    connect sensorSuite.gasOut to computer.gasIn;
    connect sensorSuite.radiationOut to computer.radiationIn;
    connect sensorSuite.acousticOut to computer.acousticIn;
    connect computer.telemetryOut to telemetryOut;
    connect computer.visualOut to visualOut;
    connect computer.thermalOut to thermalOut;
    connect computer.gasOut to gasOut;
    connect computer.radiationOut to radiationOut;
    connect computer.acousticOut to acousticOut;
    connect computer.findingOut to findingOut;
  }

  part def IndustrialInspectionSystem {
    doc /* Complete supervised inspection system centered on a Taurob Inspector unmanned ground robot. */

    part operatorStation : OperatorStation;
    part wirelessLink : WirelessLink;
    part inspector : TaurobInspector;

    connect operatorStation.commandOut to wirelessLink.groundCommandIn;
    connect operatorStation.missionPlanOut to wirelessLink.groundMissionPlanIn;
    connect wirelessLink.robotCommandOut to inspector.commandIn;
    connect wirelessLink.robotMissionPlanOut to inspector.missionPlanIn;
    connect inspector.telemetryOut to wirelessLink.robotTelemetryIn;
    connect inspector.findingOut to wirelessLink.robotFindingIn;
    connect inspector.visualOut to wirelessLink.robotVisualIn;
    connect inspector.thermalOut to wirelessLink.robotThermalIn;
    connect inspector.gasOut to wirelessLink.robotGasIn;
    connect inspector.radiationOut to wirelessLink.robotRadiationIn;
    connect inspector.acousticOut to wirelessLink.robotAcousticIn;
    connect wirelessLink.groundTelemetryOut to operatorStation.telemetryIn;
    connect wirelessLink.groundFindingOut to operatorStation.findingsIn;
    connect wirelessLink.groundVisualOut to operatorStation.visualDataIn;
    connect wirelessLink.groundThermalOut to operatorStation.thermalDataIn;
    connect wirelessLink.groundGasOut to operatorStation.gasDataIn;
    connect wirelessLink.groundRadiationOut to operatorStation.radiationDataIn;
    connect wirelessLink.groundAcousticOut to operatorStation.acousticDataIn;
  }

  action def ExecuteInspectionMission {
    in missionPlan : MissionPlan;
    in command : CommandMessage;
    out telemetry : TelemetryFrame;
    out finding : InspectionFinding;

    action initializeRobot;
    action validateMissionPlan;
    action navigateToInspectionArea;
    action scanAssetWithVisualCamera;
    action scanAssetWithThermalCamera;
    action sampleAtmosphere;
    action measureRadiation;
    action listenForAbnormalAcoustics;
    action classifyInspectionResults;
    action transmitTelemetryAndFindings;
    action returnToSafeLocation;

    first start then initializeRobot;
    then validateMissionPlan;
    then navigateToInspectionArea;
    then scanAssetWithVisualCamera;
    fork;
      then scanAssetWithThermalCamera;
      then sampleAtmosphere;
      then measureRadiation;
      then listenForAbnormalAcoustics;
    join;
    then classifyInspectionResults;
    then transmitTelemetryAndFindings;
    then returnToSafeLocation;
    then done;
  }

  state def InspectorOperationalState {
    entry action powerOnSelfTest;
    exit action persistMissionLog;

    state PoweredOff;
    state Standby;
    state MissionReady;
    state TeleoperatedInspection;
    state AutonomousInspection;
    state DataTransmission;
    state ReturnToBase;
    state EmergencyStop;
    state FaultRecovery;

    transition initial then PoweredOff;
    transition PoweredOff then Standby
      accept CommandMessage
      if commandId == "POWER_ON";

    transition Standby then MissionReady
      accept MissionPlan
      if minimumReturnBattery >= 20.0;

    transition MissionReady then TeleoperatedInspection
      accept CommandMessage
      if commandId == "START_TELEOP";

    transition MissionReady then AutonomousInspection
      accept CommandMessage
      if commandId == "START_AUTONOMOUS_INSPECTION";

    transition TeleoperatedInspection then DataTransmission
      accept CommandMessage
      if commandId == "CAPTURE_AND_REPORT";

    transition AutonomousInspection then DataTransmission
      accept CommandMessage
      if commandId == "INSPECTION_POINT_COMPLETE";

    transition DataTransmission then AutonomousInspection
      accept CommandMessage
      if commandId == "CONTINUE_ROUTE";

    transition DataTransmission then ReturnToBase
      accept CommandMessage
      if commandId == "MISSION_COMPLETE";

    transition TeleoperatedInspection then ReturnToBase
      accept CommandMessage
      if commandId == "RETURN_HOME";

    transition AutonomousInspection then ReturnToBase
      accept CommandMessage
      if commandId == "RETURN_HOME";

    transition ReturnToBase then Standby
      accept CommandMessage
      if commandId == "ARRIVED_HOME";

    transition Standby then PoweredOff
      accept CommandMessage
      if commandId == "POWER_OFF";

    transition MissionReady then EmergencyStop
      accept CommandMessage
      if commandId == "E_STOP";

    transition TeleoperatedInspection then EmergencyStop
      accept CommandMessage
      if commandId == "E_STOP";

    transition AutonomousInspection then EmergencyStop
      accept CommandMessage
      if commandId == "E_STOP";

    transition ReturnToBase then EmergencyStop
      accept CommandMessage
      if commandId == "E_STOP";

    transition EmergencyStop then FaultRecovery
      accept CommandMessage
      if commandId == "RESET_E_STOP";

    transition FaultRecovery then Standby
      accept CommandMessage
      if commandId == "RECOVERY_COMPLETE";
  }

  requirement def PrimaryFunctionRequirement {
    doc /* The system shall provide remote inspection of hazardous or hard-to-access industrial environments using the Taurob Inspector robot. */
    subject system : IndustrialInspectionSystem;
    require constraint {
      system.inspector.primaryFunction == "Remote hazardous-area inspection and condition assessment"
    }
  }

  requirement def HumanExposureReductionRequirement {
    doc /* The Taurob Inspector shall collect inspection evidence without requiring a human inspector to enter the hazardous area during normal mission execution. */
    subject robot : TaurobInspector;
    require constraint {
      robot.nominalMissionEndurance > 0 [s]
    }
  }

  requirement def MultiSensorInspectionRequirement {
    doc /* The robot shall provide visual, thermal, gas, radiation, acoustic, and telemetry data to the operator station. */
    subject system : IndustrialInspectionSystem;
    require constraint {
      system.wirelessLink.minimumAvailability >= 95.0
    }
  }

  requirement def MobilityRequirement {
    doc /* The tracked drive base shall support rugged industrial traversal at a useful inspection speed. */
    subject base : DriveBase;
    require constraint {
      base.maximumSpeed >= 1.0 [m / s] and base.obstacleClimbHeight >= 0.20 [m]
    }
  }

  requirement def BatteryReserveRequirement {
    doc /* The battery management strategy shall preserve energy for safe return at the end of the mission. */
    subject battery : BatteryPack;
    require constraint {
      battery.minimumReserveForReturn >= 20.0
    }
  }

  requirement def CommunicationRequirement {
    doc /* The communication system shall provide bidirectional command, telemetry, sensor-data, and finding exchange between the operator station and the robot. */
    subject link : WirelessLink;
    require constraint {
      link.nominalRange >= 500 [m] and link.minimumAvailability >= 95.0
    }
  }

  requirement def EmergencyStopRequirement {
    doc /* The robot shall enter an emergency stopped state when an emergency stop command is received. */
    subject robot : TaurobInspector;
    require constraint {
      robot.emergencyStop.stopResponseTime <= 1 [s]
    }
  }

  satisfy PrimaryFunctionRequirement by IndustrialInspectionSystem;
  satisfy HumanExposureReductionRequirement by TaurobInspector;
  satisfy MultiSensorInspectionRequirement by IndustrialInspectionSystem;
  satisfy MobilityRequirement by DriveBase;
  satisfy BatteryReserveRequirement by BatteryPack;
  satisfy CommunicationRequirement by WirelessLink;
  satisfy EmergencyStopRequirement by EmergencyStopModule;

  exhibit state InspectorOperationalState by TaurobInspector;
  perform action ExecuteInspectionMission by TaurobInspector;
}
