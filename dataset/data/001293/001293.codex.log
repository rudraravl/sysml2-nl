    attribute temperatureRise : Temperature;
    attribute absorbedEnergy : Energy;
    attribute pulseStartTime : Time;
  }

  item def BiasSignal {
    attribute biasCurrent : Current;
    attribute biasVoltage : Voltage;
    attribute biasPower : Power;
