    use case def ReviewAndVerifyArticle {
        subject publisher : ScientificAmericanSystem;
        actor editor;
    }

    use case def PublishMonthlyIssue {
        subject publisher : ScientificAmericanSystem;
        actor subscriber;
    }

    use case def ReadAndEngageWithArticle {
        subject publisher : ScientificAmericanSystem;
        actor reader;
    }
}
