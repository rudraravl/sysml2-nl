            attribute actionService = "messaging";
            attribute actionName = "send_push_message";
            attribute conditionExpression = "{\"forecastProbabilityGreaterThan\":70,\"timeWindowHours\":12}";
            attribute retryLimit = 3;
            attribute timeoutLimit = 15 [SI::s];
        }

        part meetingLightApplet : AppletDefinition {
            attribute appletId = "applet-meeting-light";
            attribute owner = "primary-user";
            attribute enabled = true;
            attribute triggerService = "calendar";
            attribute triggerName = "meeting_started";
            attribute actionService = "smart-light";
            attribute actionName = "set_status_color";
            attribute conditionExpression = "{\"calendarStatus\":\"busy\",\"meetingType\":\"video\"}";
            attribute retryLimit = 2;
            attribute timeoutLimit = 10 [SI::s];
        }

        connect weatherService.triggerOutput to weatherTriggerAdapter.rawTriggerIn;
        connect calendarService.triggerOutput to calendarTriggerAdapter.rawTriggerIn;

        connect weatherTriggerAdapter.normalizedEventOut to automationEngine.normalizedEventIn;
        connect calendarTriggerAdapter.normalizedEventOut to automationEngine.normalizedEventIn;

        connect automationEngine.actionCommandOut to messagingService.commandInput;
        connect automationEngine.actionCommandOut to smartLightService.commandInput;

        connect messagingService.resultOutput to automationEngine.actionResultIn;
        connect smartLightService.resultOutput to automationEngine.actionResultIn;

        connect automationEngine.auditOut to automationEngine.logger.auditIn;
        connect automationEngine.notificationOut to automationEngine.notifier.notificationOut;
    }

    requirement def PrimaryFunctionRequirement {
        subject system : IFTTTLikeAutomationSystem;

        require constraint {
            system.primaryFunction ==
            "Monitor configured trigger services, evaluate user-defined applets, and invoke corresponding action services automatically when trigger conditions are satisfied."
        }
    }

    requirement def TriggerDetectionRequirement {
        subject adapter : TriggerAdapter;

        require constraint {
            adapter.pollingInterval <= 300 [SI::s]
        }
    }

    requirement def EndToEndLatencyRequirement {
        subject engine : AutomationEngine;

        require constraint {
            engine.maximumEndToEndLatency <= 15 [SI::s]
        }
    }

    requirement def AvailabilityRequirement {
        subject system : IFTTTLikeAutomationSystem;

        require constraint {
            system.targetAvailability >= 99.9
        }
    }

    requirement def RetryRequirement {
        subject applet : AppletDefinition;

        require constraint {
            applet.retryLimit >= 1 and applet.retryLimit <= 5
        }
    }

    requirement def AuditabilityRequirement {
        subject logger : AuditLogger;

        require constraint {
            logger.retentionPeriod >= 31536000 [SI::s]
        }
    }

    requirement def PayloadSizeRequirement {
        subject adapter : TriggerAdapter;

        require constraint {
            adapter.maxPayloadSize <= 1048576 [SI::byte]
        }
    }

    requirement def ActionSuccessRequirement {
        subject engine : AutomationEngine;

        require constraint {
            engine.successfulExecutionRatio >= 99.0
        }
    }

    satisfy PrimaryFunctionRequirement by IFTTTLikeAutomationSystem;
    satisfy TriggerDetectionRequirement by TriggerAdapter;
    satisfy EndToEndLatencyRequirement by AutomationEngine;
    satisfy AvailabilityRequirement by IFTTTLikeAutomationSystem;
    satisfy RetryRequirement by AppletDefinition;
    satisfy AuditabilityRequirement by AuditLogger;
    satisfy PayloadSizeRequirement by TriggerAdapter;
    satisfy ActionSuccessRequirement by AutomationEngine;
}
