                    if statusIn.statusSignal.motorTemperature > highMotorTemperatureTrip;
                transition to Faulted
                    if statusIn.statusSignal.statorTemperature > highStatorTemperatureTrip;
                transition to Faulted
                    if not emergencyStopHealthy;
