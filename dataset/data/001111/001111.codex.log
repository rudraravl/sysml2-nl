        connect processor.control.ready to control.ready;
        connect processor.control.activeMode to control.activeMode;

        state def OperationalStateMachine {
            entry action initialize {
                then clearFaults;
                then loadCalibration;
                then biasLedSensor;
            }

            state off;
            state selfTest;
            state idle;
            state measure;
            state process;
            state publish;
            state calibrateDark;
            state fault;

            transition initial then off;

            transition off_to_selfTest
                first off
                accept when control.enable
                then selfTest;

            transition selfTest_to_idle
                first selfTest
                accept after startupTime
                if powerInput.supplyVoltage >= powerConditioner.inputVoltageMin and
                   powerInput.supplyVoltage <= powerConditioner.inputVoltageMax
                then idle;

            transition selfTest_to_fault
                first selfTest
                if powerInput.supplyVoltage < powerConditioner.inputVoltageMin or
                   powerInput.supplyVoltage > powerConditioner.inputVoltageMax
                then fault;

            transition idle_to_measure
                first idle
                accept after updatePeriod
                then measure;

            transition measure_to_process
                first measure
                accept after nominalIntegrationTime
                then process;

            transition process_to_publish
                first process
                then publish;

            transition publish_to_idle
                first publish
                then idle;

            transition idle_to_calibrateDark
                first idle
                accept when control.requestedIntegrationTime == 0.0 [s]
                then calibrateDark;

            transition calibrateDark_to_idle
                first calibrateDark
                accept after 0.100 [s]
                then idle;

            transition any_to_off
                first off, selfTest, idle, measure, process, publish, calibrateDark, fault
                accept when not control.enable
                then off;

            transition any_to_fault
                first idle, measure, process, publish, calibrateDark
                if processor.activeFault != FaultKind::none
                then fault;

            transition fault_to_selfTest
                first fault
                accept when control.reset
                then selfTest;
        }

        perform action sensingCycle {
            first verifySupply;
            then temperatureSensor.measureTemperature;
            then ledSensor.convertLightToPhotocurrent;
            then chargeInterface.integrateLedDischarge;
            then adc.sampleVoltage;
            then processor.computeLightMeasurement;
            then done;
        }
    }

    requirement def MeasureLightUsingLedRequirement {
        subject sensingUnit : LedBasedLightSensingUnit;

        require constraint {
            sensingUnit.ledSensor.photocurrentResponsivity > 0.0 [A] and
            sensingUnit.measurementRangeLow <= 1.0 [lx] and
            sensingUnit.measurementRangeHigh >= 10000.0 [lx]
        }

        doc /* The sensing unit shall use an LED junction as the light-sensitive element, operated without emitting light, to measure incident visible light. */
    }

    requirement def ReverseBiasProtectionRequirement {
        subject led : ReverseBiasedLedSensor;

        require constraint {
            led.reverseBiasVoltage <= led.maxSafeReverseVoltage
        }

        doc /* The LED shall be reverse-biased only below its maximum safe reverse voltage during light measurement. */
    }

    requirement def MeasurementOutputRequirement {
        subject sensingUnit : LedBasedLightSensingUnit;

        require constraint {
            sensingUnit.updatePeriod <= 0.100 [s] and
            sensingUnit.processor.uncertaintyPercent <= 10.0
        }

        doc /* The unit shall publish compensated illuminance and irradiance measurements at least every 100 ms with no more than 10 percent nominal uncertainty across the specified range. */
    }

    requirement def SaturationDiagnosticRequirement {
        subject processor : MeasurementProcessor;

        require constraint {
            processor.calibration.saturationCode < 4096
        }

        doc /* The unit shall report a saturation fault when the digitized LED discharge signal reaches the calibrated upper ADC limit. */
    }

    requirement def DarkCalibrationRequirement {
        subject processor : MeasurementProcessor;

        require constraint {
            processor.calibration.darkOffsetCode >= 0
        }

        doc /* The unit shall maintain a dark offset calibration value used to subtract LED leakage and ADC offset from each light measurement. */
    }

    requirement def SupplyOperatingRequirement {
        subject power : PowerConditioner;

        require constraint {
            power.inputVoltageMin == 2.7 [V] and
            power.inputVoltageMax == 5.5 [V] and
            power.regulatedVoltage == 3.3 [V]
        }

        doc /* The sensing unit shall operate from a 2.7 V to 5.5 V input supply and internally regulate the measurement electronics to 3.3 V. */
    }

    satisfy MeasureLightUsingLedRequirement by LedBasedLightSensingUnit;
    satisfy ReverseBiasProtectionRequirement by ReverseBiasedLedSensor;
    satisfy MeasurementOutputRequirement by LedBasedLightSensingUnit;
    satisfy SaturationDiagnosticRequirement by MeasurementProcessor;
    satisfy DarkCalibrationRequirement by CalibrationStore;
    satisfy SupplyOperatingRequirement by PowerConditioner;
}
