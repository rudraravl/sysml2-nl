        attribute targetDetectionConfidence : Probability = 0.92;

        port fluidInterface : FluidPort;
        port magneticInterface : MagneticControlPort;
        port telemetryInterface : TelemetryPort;
        port drugReleaseInterface : ReleasePort;

        part shell : BiocompatibleShell;
        part propulsion : MagneticPropulsionModule;
        part sensors : MolecularSensorArray;
        part reservoir : DrugReservoir;
        part powerUnit : NanoPowerUnit;
        part controller : OnboardController;

        connect fluidInterface to shell.fluidPort;
        connect fluidInterface to propulsion.fluidPort;
        connect fluidInterface to powerUnit.fluidPort;
        connect magneticInterface to propulsion.controlPort;
        connect magneticInterface to powerUnit.energyInputPort;
        connect magneticInterface to controller.controlPort;
        connect telemetryInterface to controller.telemetryPort;
        connect sensors.sensingPort to controller.sensorPort;
        connect reservoir.payloadPort to controller.payloadPort;
        connect reservoir.releasePort to drugReleaseInterface;

        action performPrimaryFunction {
            objective "Navigate through biological fluid, identify diseased tissue using molecular biomarkers, and release a controlled therapeutic payload only when the target signature is confirmed.";

            first circulateInBloodstream;
            then receiveMagneticGuidance;
            then senseLocalBiomarkers;
            then classifyTarget;
            then releaseDoseIfConfirmed;
            then reportTreatmentStatus;
            then biodegradeAfterMission;

            action circulateInBloodstream;
            action receiveMagneticGuidance;
            action senseLocalBiomarkers;
            action classifyTarget;
            action releaseDoseIfConfirmed;
            action reportTreatmentStatus;
            action biodegradeAfterMission;
        }
    }

    part def NanoroboticTherapySystem {
        attribute treatmentVolume : ScalarValues::Real = 5.0;
        attribute swarmSize : ScalarValues::Integer = 1000000;
        attribute intendedMissionDuration : ScalarValues::Real = 6.0;
        attribute maximumSystemicDose : Dose = 80000000.0;

        part guidanceStation : ExternalMagneticGuidanceStation;
        part robotSwarm : TherapeuticNanorobot[1000000];

        port patientFluidInterface : FluidPort;
        port clinicianTelemetryInterface : TelemetryPort;

        connect patientFluidInterface to robotSwarm.fluidInterface;
        connect guidanceStation.guidancePort to robotSwarm.magneticInterface;
        connect guidanceStation.telemetryPort to robotSwarm.telemetryInterface;
        connect clinicianTelemetryInterface to guidanceStation.telemetryPort;

        action executeTherapyMission {
            first initializeGuidanceField;
            then disperseRobotSwarm;
            then navigateTowardTargetRegion;
            then identifyDiseasedMicroenvironment;
            then deliverTherapeuticPayload;
            then verifyDoseDistribution;
            then commandSafeDegradation;

            action initializeGuidanceField;
            action disperseRobotSwarm;
            action navigateTowardTargetRegion;
            action identifyDiseasedMicroenvironment;
            action deliverTherapeuticPayload;
            action verifyDoseDistribution;
            action commandSafeDegradation;
        }
    }

    /* Requirements */

    requirement def PrimaryFunctionRequirement {
        doc "The nanorobotic therapy system shall provide targeted microscale therapy by navigating nanorobots through biological fluid, detecting disease-associated molecular biomarkers, and releasing a controlled drug payload at confirmed target tissue.";
    }

    requirement def SizeRequirement {
        doc "Each therapeutic nanorobot shall have an outer diameter less than or equal to 1000 nm to permit circulation through capillary-scale biological pathways.";
        require constraint { robotDiameter <= 1000.0 }
    }

    requirement def TargetingRequirement {
        doc "The nanorobot shall release therapeutic payload only when the detected target confidence is greater than or equal to 0.92.";
        require constraint { targetConfidence >= 0.92 }
    }

    requirement def DoseControlRequirement {
        doc "Each release event shall deliver no more than 12 ng of active therapeutic payload.";
        require constraint { releaseDose <= 12.0 }
    }

    requirement def NavigationRequirement {
        doc "The propulsion module shall support controlled motion of at least 100 um/s in blood plasma under external magnetic guidance.";
        require constraint { controlledSpeed >= 100.0 }
    }

    requirement def BiocompatibilityRequirement {
        doc "The shell shall maintain immune evasion probability of at least 0.95 during the active mission interval.";
        require constraint { immuneEvasionProbability >= 0.95 }
    }

    requirement def SafetyRequirement {
        doc "The nanorobot shall enter a faulted or degrading state if operating temperature exceeds 39 degC, payload containment is compromised, or telemetry reports a critical fault.";
    }

    requirement def TelemetryRequirement {
        doc "The nanorobot shall report position estimate, payload remaining, detected biomarker level, power state, and fault code during active operation.";
    }

    requirement def DegradationRequirement {
        doc "After mission completion, the shell and residual structures shall biodegrade into waste products with toxicity index below clinically acceptable limits.";
        require constraint { toxicityIndex < 1.0 }
    }

    satisfy PrimaryFunctionRequirement by NanoroboticTherapySystem;
    satisfy SizeRequirement by TherapeuticNanorobot;
    satisfy TargetingRequirement by OnboardController;
    satisfy DoseControlRequirement by DrugReservoir;
    satisfy NavigationRequirement by MagneticPropulsionModule;
    satisfy BiocompatibilityRequirement by BiocompatibleShell;
    satisfy SafetyRequirement by OnboardController;
    satisfy TelemetryRequirement by OnboardController;
    satisfy DegradationRequirement by BiocompatibleShell;

    /* Analysis Constraints */

    constraint def TargetConfirmationConstraint {
        in attribute marker : Concentration;
        in attribute confidence : Probability;
        in attribute threshold : Probability;
        confidence >= threshold;
    }

    constraint def PayloadReleaseConstraint {
        in attribute requestedDose : Dose;
        in attribute availableDose : Dose;
        in attribute maximumDose : Dose;
        requestedDose <= availableDose and requestedDose <= maximumDose;
    }

    constraint def ThermalSafetyConstraint {
        in attribute localTemperature : Temperature;
        in attribute limit : Temperature;
        localTemperature <= limit;
    }

    constraint def MissionEnergyConstraint {
        in attribute availablePower : Power;
        in attribute propulsionPower : Power;
        in attribute sensingPower : Power;
        in attribute controllerPower : Power;
        availablePower >= propulsionPower + sensingPower + controllerPower;
    }

    /* Use Case */

    use case def TargetedDrugDelivery {
        subject therapySystem : NanoroboticTherapySystem;

        objective "Provide minimally invasive targeted treatment by using magnetically guided nanorobots to locate diseased tissue and deliver therapeutic payload locally.";

        actor clinician;
        actor patient;

        include use case PrepareSwarm;
        include use case NavigateInVasculature;
        include use case ConfirmDiseaseSignature;
        include use case DeliverPayload;
        include use case ReportOutcome;
    }

    use case def PrepareSwarm {
        subject therapySystem : NanoroboticTherapySystem;
    }

    use case def NavigateInVasculature {
        subject therapySystem : NanoroboticTherapySystem;
    }

    use case def ConfirmDiseaseSignature {
        subject therapySystem : NanoroboticTherapySystem;
    }

    use case def DeliverPayload {
        subject therapySystem : NanoroboticTherapySystem;
    }

    use case def ReportOutcome {
        subject therapySystem : NanoroboticTherapySystem;
    }

}
