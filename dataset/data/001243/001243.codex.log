            grid.cellPitch <= 0.005 [m]
        }

        doc /* The sensor grid shall provide spatially distributed measurement coverage through individually addressable sensing cells. */
    }

    requirement def AccuracyRequirement {
        subject calibration : CalibrationProcessor;

        require constraint {
            calibration.confidenceThreshold >= 0.95
        }

        doc /* The calibration processor shall compensate sensor offset, gain, and temperature effects before producing pressure samples. */
    }

    requirement def HealthMonitoringRequirement {
        subject health : HealthMonitor;

        require constraint {
            health.maximumFailedCells <= 32
        }

        require constraint {
            health.minimumSupplyVoltage >= 3.0 [V] and
            health.maximumSupplyVoltage <= 3.6 [V]
        }

        doc /* The sensing unit shall report operational health and detect excessive cell failures, supply faults, and over-temperature conditions. */
    }

    requirement def OutputRequirement {
        subject unit : SensingUnit;

        require constraint {
            unit.mapRows * unit.mapColumns == 256
        }

        doc /* The sensing unit shall output a pressure map and health report through its digital data interface for each completed measurement cycle. */
    }

    satisfy MeasureRelevantQuantityRequirement by SensingUnit;
    satisfy GridCoverageRequirement by SensorGrid;
    satisfy AccuracyRequirement by CalibrationProcessor;
    satisfy HealthMonitoringRequirement by HealthMonitor;
    satisfy OutputRequirement by SensingUnit;

    part sensingUnit : SensingUnit;

