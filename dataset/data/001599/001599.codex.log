        perform action GenerateWarpPlasma {
            in antimatter = AntimatterFuel {
                mass = 1500 [kg];
                containmentStability = 0.99999;
                energyDensity = 8.98755179e16 [J];
            }
            in deuterium = DeuteriumFuel {
                mass = 1500 [kg];
                purity = 0.999;
            }
        }

        perform action ShapeWarpBubble;
        perform action RegulateBubbleStability;
        perform action CollapseWarpBubbleSafely;

        exhibit state WarpDriveOperatingState;
    }

    requirement def PrimaryFunctionRequirement {
        doc /* The system shall provide faster-than-light effective translation by generating a controlled spacetime curvature bubble around the spacecraft. */
        subject system : AlcubierreWarpPropulsionSystem;
        require constraint {
            system.nominalCruiseVelocity > 2.99792458e8 [m/s]
        }
    }

    requirement def LocalInertialFrameRequirement {
        doc /* The system shall keep the spacecraft interior locally inertial during bubble acceleration, cruise, and collapse. */
        subject system : AlcubierreWarpPropulsionSystem;
        require constraint {
            system.isolationGrid.dampingFactor >= 0.999
        }
    }

    requirement def BubbleStabilityRequirement {
        doc /* The generated warp bubble shall maintain sufficient stability during superluminal cruise. */
        subject system : AlcubierreWarpPropulsionSystem;
        require constraint {
            system.minimumBubbleStability >= 0.995
        }
    }

    requirement def ReactorPowerRequirement {
        doc /* The reactor shall provide enough conditioned plasma power to sustain the nominal curvature field. */
        subject system : AlcubierreWarpPropulsionSystem;
        require constraint {
            system.maximumReactorPower >= system.nominalReactorPower
        }
    }

    requirement def ThermalSafetyRequirement {
        doc /* Warp field coils shall remain below their maximum operational temperature during nominal operation. */
        subject system : AlcubierreWarpPropulsionSystem;
        require constraint {
            system.forwardCoil.coilTemperature < system.maximumCoilTemperature and
            system.portCoil.coilTemperature < system.maximumCoilTemperature and
            system.starboardCoil.coilTemperature < system.maximumCoilTemperature and
            system.aftCoil.coilTemperature < system.maximumCoilTemperature
        }
    }

    requirement def EmergencyCollapseRequirement {
        doc /* The system shall collapse the curvature bubble safely when critical instability, containment loss, or coil overtemperature is detected. */
        subject system : AlcubierreWarpPropulsionSystem;
        require constraint {
            system.emergencyShutdown.shutdownDelay <= 0.5 [s]
        }
    }

    requirement def TransitPerformanceRequirement {
        doc /* The system shall support interstellar transit to a nearby star-class destination within the specified maximum duration. */
        subject system : AlcubierreWarpPropulsionSystem;
        require constraint {
            system.navigationComputer.selectedDestinationDistance / system.nominalCruiseVelocity <= system.maximumTransitDuration
        }
    }

    satisfy PrimaryFunctionRequirement by AlcubierreWarpPropulsionSystem;
    satisfy LocalInertialFrameRequirement by AlcubierreWarpPropulsionSystem.isolationGrid;
    satisfy BubbleStabilityRequirement by AlcubierreWarpPropulsionSystem.fieldController;
    satisfy ReactorPowerRequirement by AlcubierreWarpPropulsionSystem.reactor;
    satisfy ThermalSafetyRequirement by AlcubierreWarpPropulsionSystem.forwardCoil;
    satisfy ThermalSafetyRequirement by AlcubierreWarpPropulsionSystem.portCoil;
    satisfy ThermalSafetyRequirement by AlcubierreWarpPropulsionSystem.starboardCoil;
    satisfy ThermalSafetyRequirement by AlcubierreWarpPropulsionSystem.aftCoil;
    satisfy EmergencyCollapseRequirement by AlcubierreWarpPropulsionSystem.emergencyShutdown;
    satisfy TransitPerformanceRequirement by AlcubierreWarpPropulsionSystem.navigationComputer;
}
