    then admitFluid;
    then conditionFluid;
    then regulateFlow;
    then dischargeFluid;
    then reportHealth;

    action startTransfer;
    action admitFluid;
    action conditionFluid;
    action regulateFlow;
    action dischargeFluid;
    action reportHealth;
  }

  state def TubexOperatingState {
    entry action initialize;

    state Idle;
    state Priming;
    state Transferring;
    state Monitoring;
    state Flushing;
    state Faulted;
    state Shutdown;

    transition idleToPriming first Idle then Priming
