                then Off;

            transition Running_to_Faulted
                first Running
                if controller.overloadDetected or controller.emergencyStopActive
                then Faulted;

            transition Starting_to_Faulted
                first Starting
                if controller.overloadDetected or controller.emergencyStopActive
                then Faulted;

            transition Faulted_to_Off
                first Faulted
                accept control.stopCommand
                then Off;
        }
    }

    part def ArchimedesScrewPump {
