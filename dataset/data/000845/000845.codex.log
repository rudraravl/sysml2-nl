        port lowSpeedOutput : ShaftPowerPort;

        perform action ReduceSpeedIncreaseTorque {
            in item highSpeedPower : RotationalMechanicalPower;
            out item lowSpeedPower : RotationalMechanicalPower;
        }
    }

