        port materialOutlet : MaterialOutletPort;
        port electricalSupply : ElectricalPowerPort;
        port control : ControlPort;

        part motor : Motor;
        part reducer : GearReducer;
        part screw : HelicalScrew;
        part trough : Trough;
        part lowerBearing : BearingAssembly;
        part upperBearing : BearingAssembly;
        part frame : SupportFrame;
        part controller : SpeedController;

        connect electricalSupply to motor.electricalInput;
        connect motor.shaftOutput to reducer.highSpeedInput;
        connect reducer.lowSpeedOutput to screw.driveInput;
        connect materialInlet to trough.inlet;
        connect trough.outlet to materialOutlet;
        connect control to controller.controlInterface;

        perform action ConveyMaterialUphill {
            in item feedMaterial : BulkMaterial;
            in attribute requestedSpeed : AngularSpeed;
            out item elevatedMaterial : BulkMaterial;
            out attribute actualFlowRate : VolumetricFlowRate;

            first startMotor;
            then accelerateScrew;
            then captureMaterialAtLowerEnd;
            then liftMaterialAlongInclinedTrough;
            then dischargeMaterialAtUpperEnd;

            action startMotor;
            action accelerateScrew;
            action captureMaterialAtLowerEnd;
            action liftMaterialAlongInclinedTrough;
            action dischargeMaterialAtUpperEnd;
        }

        state def OperatingStateMachine {
            state Off;
            state Starting;
            state Running;
            state Stopping;
            state Faulted;

            initial then Off;

            transition Off_to_Starting
                first Off
                accept control.startCommand
                then Starting;

            transition Starting_to_Running
                first Starting
                if screw.rotationalSpeed >= minimumSpeed
                then Running;

            transition Running_to_Stopping
                first Running
                accept control.stopCommand
                then Stopping;

            transition Stopping_to_Off
