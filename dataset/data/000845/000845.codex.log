        attribute ratedPower : Power = 5500.0;
        attribute ratedSpeed : AngularSpeed = 1750.0;
        attribute efficiency : Efficiency = 0.91;

        port electricalInput : ElectricalPowerPort;
        port shaftOutput : ShaftPowerPort;

        perform action ConvertElectricalToRotationalPower {
            in item electricalInputPower : ElectricalPower;
            out item shaftPower : RotationalMechanicalPower;
        }
    }

    part def GearReducer {
        attribute reductionRatio : Real = 30.0;
        attribute efficiency : Efficiency = 0.94;
        attribute outputSpeed : AngularSpeed;
        attribute outputTorque : Torque;

