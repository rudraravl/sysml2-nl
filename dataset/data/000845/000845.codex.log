        attribute pitch : Length = 0.35;
        attribute length : Length = 4.50;
        attribute flightThickness : Length = 0.008;
        attribute rotationalSpeed : AngularSpeed;
        attribute requiredTorque : Torque;
        attribute fillRatio : FillRatio = 0.42;

        port driveInput : ShaftPowerPort;

        perform action RotateFlights {
            in item shaftPower : RotationalMechanicalPower;
            out attribute screwSpeed : AngularSpeed;
        }
    }

    part def Trough {
        attribute insideDiameter : Diameter = 0.48;
        attribute length : Length = 4.70;
        attribute inclinationAngle : Angle = 32.0;
        attribute linerClearance : Length = 0.015;
        attribute sealed : Boolean = true;

        port inlet : MaterialInletPort;
        port outlet : MaterialOutletPort;
    }

    part def BearingAssembly {
        attribute radialLoadLimit : Real = 12000.0;
        attribute axialLoadLimit : Real = 8000.0;
        attribute lubricationRequired : Boolean = true;
        attribute temperatureLimit : Real = 85.0;
    }

    part def SupportFrame {
        attribute baseLength : Length = 5.20;
        attribute baseWidth : Length = 0.90;
        attribute installedInclination : Angle = 32.0;
        attribute corrosionProtection : Boolean = true;
    }

    part def SpeedController {
        attribute commandedSpeed : AngularSpeed;
        attribute measuredSpeed : AngularSpeed;
        attribute overloadDetected : Boolean;
        attribute emergencyStopActive : Boolean;

        port controlInterface : ControlPort;

        perform action RegulateSpeed {
            in attribute desiredSpeed : AngularSpeed;
            in attribute currentSpeed : AngularSpeed;
            out attribute motorCommand : Real;
        }
    }

    part def ArchimedesScrewConveyor {
        attribute designFlowRate : VolumetricFlowRate = 0.018;
        attribute maximumFlowRate : VolumetricFlowRate = 0.025;
        attribute liftHeight : Length = 2.35;
        attribute inclinationAngle : Angle = 32.0;
        attribute operatingEfficiency : Efficiency = 0.68;
        attribute nominalSpeed : AngularSpeed = 58.0;
        attribute maximumSpeed : AngularSpeed = 72.0;
        attribute minimumSpeed : AngularSpeed = 18.0;

