        connect motor.shaftOutput to reducer.highSpeedInput;
        connect reducer.lowSpeedOutput to screw.driveInput;
        connect control to controller.controlInterface;

        perform action LiftWater {
            in item lowElevationWater : Water;
            in attribute commandedSpeed : AngularSpeed;
            out item raisedWater : Water;
            out attribute deliveredFlowRate : VolumetricFlowRate;

            first rotateScrew;
            then trapWaterBetweenFlights;
            then advanceWaterUpIncline;
            then dischargeWaterAtHigherElevation;

            action rotateScrew;
            action trapWaterBetweenFlights;
            action advanceWaterUpIncline;
            action dischargeWaterAtHigherElevation;
        }
    }

    requirement def PrimaryFunctionRequirement {
        subject screwSystem : ArchimedesScrewConveyor;

        doc /* The system shall use a rotating helical screw within an inclined trough to capture material at a lower inlet, advance it upward along the screw axis, and discharge it at a higher outlet. */

        require constraint {
            screwSystem.designFlowRate >= 0.018 and
            screwSystem.liftHeight >= 2.0 and
            screwSystem.operatingEfficiency >= 0.60
        }
    }

    requirement def SpeedControlRequirement {
        subject screwSystem : ArchimedesScrewConveyor;

        doc /* The controller shall maintain screw rotational speed within the allowable operating range during normal conveying. */

        require constraint {
            screwSystem.nominalSpeed >= screwSystem.minimumSpeed and
            screwSystem.nominalSpeed <= screwSystem.maximumSpeed
        }
    }

    requirement def MechanicalDriveRequirement {
        subject screwSystem : ArchimedesScrewConveyor;

        doc /* The mechanical drive shall convert supplied electrical power into low-speed, high-torque shaft power suitable for rotating the screw under loaded conditions. */

        require constraint {
            screwSystem.motor.ratedPower >= 5000.0 and
            screwSystem.reducer.reductionRatio >= 20.0 and
            screwSystem.reducer.efficiency >= 0.90
        }
    }

    requirement def ContainmentRequirement {
        subject screwSystem : ArchimedesScrewConveyor;

        doc /* The trough shall contain material during upward transport and provide a close clearance around the helical screw to limit backflow and leakage. */

        require constraint {
            screwSystem.trough.insideDiameter > screwSystem.screw.outerDiameter and
            screwSystem.trough.linerClearance <= 0.025
        }
    }

    requirement def FaultResponseRequirement {
        subject screwSystem : ArchimedesScrewConveyor;

        doc /* The system shall transition to a faulted state when overload or emergency stop conditions are detected. */

        require constraint {
            screwSystem.controller.overloadDetected implies screwSystem.control.faultActive
        }
    }

    part archimedesScrewMaterialLiftSystem : ArchimedesScrewConveyor {
        attribute designFlowRate : VolumetricFlowRate = 0.020;
        attribute liftHeight : Length = 2.50;
        attribute inclinationAngle : Angle = 32.0;
        attribute nominalSpeed : AngularSpeed = 58.0;
    }

    satisfy PrimaryFunctionRequirement by archimedesScrewMaterialLiftSystem;
    satisfy SpeedControlRequirement by archimedesScrewMaterialLiftSystem;
    satisfy MechanicalDriveRequirement by archimedesScrewMaterialLiftSystem;
    satisfy ContainmentRequirement by archimedesScrewMaterialLiftSystem;
    satisfy FaultResponseRequirement by archimedesScrewMaterialLiftSystem;

}
