        attribute inclinationAngle : Angle = 28.0;
        attribute nominalSpeed : AngularSpeed = 42.0;
        attribute operatingEfficiency : Efficiency = 0.72;

        port waterInlet : WaterInletPort;
        port waterOutlet : WaterOutletPort;
        port electricalSupply : ElectricalPowerPort;
        port control : ControlPort;

