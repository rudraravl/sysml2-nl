        attribute pulseHeight : DigitalCount;
        attribute eventEnergy : Energy;
        attribute timestamp : Time;
        attribute valid : Boolean;
    }

    item def DetectorStatus {
        attribute detectorTemperature : Temperature;
        attribute biasVoltage : ElectricPotential;
        attribute leakageCurrent : ElectricCurrent;
        attribute countRate : CountRate;
        attribute faultActive : Boolean;
    }

    port def RadiationInputPort {
        in item radiation : IonizingRadiation;
    }

    port def ChargeTransportPort {
        out item chargeCloud : ElectronHolePairs;
