    port def AnalogSignalPort {
        in item chargeCloud : ElectronHolePairs;
        out item pulse : AnalogPulse;
    }

    port def DigitalEventPort {
        out item event : DigitizedEvent;
    }

    port def StatusPort {
        out item status : DetectorStatus;
    }

    port def PowerPort {
        in attribute supplyVoltage : ElectricPotential;
        in attribute supplyCurrent : ElectricCurrent;
    }

    port def ThermalPort {
        out attribute heatLoad : ISQ::power;
        in attribute sinkTemperature : Temperature;
    }

    part def SemiconductorDetectorSystem {
        attribute primaryFunction : String = "Convert incident ionizing radiation into calibrated digital detection events by generating, collecting, amplifying, digitizing, and classifying charge produced in a reverse-biased semiconductor sensor.";

        attribute minimumDetectableEnergy : Energy = 8.0e-16 [SI::joule];
        attribute maximumEventRate : CountRate = 100000 [1 / SI::second];
        attribute nominalBiasVoltage : ElectricPotential = 150 [SI::volt];
        attribute operatingTemperature : Temperature = 253.15 [SI::kelvin];

        port radiationIn : RadiationInputPort;
        port eventOut : DigitalEventPort;
        port statusOut : StatusPort;
        port powerIn : PowerPort;
        port thermalInterface : ThermalPort;

        part sensor : SemiconductorSensor;
        part biasSupply : BiasSupply;
        part preamplifier : ChargeSensitivePreamplifier;
        part shaper : PulseShaper;
        part digitizer : AnalogToDigitalConverter;
        part processor : EventProcessor;
        part thermalController : ThermalController;
        part healthMonitor : HealthMonitor;

        connect radiationIn.radiation to sensor.incidentRadiation.radiation;
        connect biasSupply.biasOutput.supplyVoltage to sensor.biasInput.supplyVoltage;
        connect sensor.chargeOutput.chargeCloud to preamplifier.signalInput.chargeCloud;
        connect preamplifier.pulseOutput.pulse to shaper.rawPulseInput.pulse;
        connect shaper.shapedPulseOutput.pulse to digitizer.analogInput.pulse;
        connect digitizer.digitalOutput.event to processor.rawEventInput.event;
        connect processor.validEventOutput.event to eventOut.event;
        connect sensor.thermalInterface.heatLoad to thermalController.detectorThermalInput.heatLoad;
        connect thermalController.systemThermalOutput.heatLoad to thermalInterface.heatLoad;
        connect healthMonitor.statusOutput.status to statusOut.status;

        action detectRadiation {
            first start;
            then applyBias;
            then waitForRadiation;
            then generateCharge;
            then collectCharge;
            then amplifyPulse;
            then shapePulse;
            then digitizePulse;
            then classifyEvent;
            then publishEvent;
            then updateStatus;
            then done;

            action applyBias {
                out attribute appliedVoltage : ElectricPotential = nominalBiasVoltage;
            }

            action waitForRadiation {
                in item incoming : IonizingRadiation;
            }

            action generateCharge {
                in item incoming : IonizingRadiation;
                out item charge : ElectronHolePairs;
            }

            action collectCharge {
                in item charge : ElectronHolePairs;
                out item collectedCharge : ElectronHolePairs;
            }

            action amplifyPulse {
                in item collectedCharge : ElectronHolePairs;
                out item pulse : AnalogPulse;
            }

            action shapePulse {
                in item pulse : AnalogPulse;
                out item shapedPulse : AnalogPulse;
            }

            action digitizePulse {
                in item shapedPulse : AnalogPulse;
                out item rawEvent : DigitizedEvent;
            }

            action classifyEvent {
                in item rawEvent : DigitizedEvent;
                out item validEvent : DigitizedEvent;
            }

            action publishEvent {
                in item validEvent : DigitizedEvent;
            }

            action updateStatus {
                out item status : DetectorStatus;
            }
        }

        state detectorOperatingState {
            entry; then Off;

            state Off;
            state Initializing;
            state BiasRamp;
            state StabilizingTemperature;
            state Ready;
            state Detecting;
            state Calibrating;
            state Fault;
            state SafeShutdown;

            transition Off_to_Initializing
                first Off
                accept PowerApplied
                then Initializing;

