    }

    part def BiasSupply {
        attribute outputVoltage : ElectricPotential = 0 [SI::volt];
        attribute voltageSetpoint : ElectricPotential = 150 [SI::volt];
        attribute rampRate : ElectricPotential = 10 [SI::volt];
        attribute currentLimit : ElectricCurrent = 50e-6 [SI::ampere];

        port powerInput : PowerPort;
        port biasOutput : PowerPort;

        action rampBias {
            in attribute requestedVoltage : ElectricPotential;
            out attribute deliveredVoltage : ElectricPotential;
        }
    }

    part def ChargeSensitivePreamplifier {
        attribute feedbackCapacitance : ISQ::capacitance = 1.0e-12 [SI::farad];
        attribute equivalentNoiseCharge : ElectricCharge = 1.6e-17 [SI::coulomb];
        attribute gain : Real = 1.0e12;

        port signalInput : AnalogSignalPort;
        port pulseOutput : AnalogSignalPort;

        action integrateCharge {
            in item chargeCloud : ElectronHolePairs;
            out item pulse : AnalogPulse;
        }
    }

    part def PulseShaper {
        attribute shapingTime : Time = 2.0e-6 [SI::second];
        attribute baselineRestorationEnabled : Boolean = true;
        attribute pileupRejectionEnabled : Boolean = true;

        port rawPulseInput : AnalogSignalPort;
        port shapedPulseOutput : AnalogSignalPort;

        action filterPulse {
            in item rawPulse : AnalogPulse;
            out item shapedPulse : AnalogPulse;
        }
    }

    part def AnalogToDigitalConverter {
        attribute resolutionBits : Integer = 14;
        attribute sampleRate : CountRate = 50000000 [1 / SI::second];
        attribute inputRange : ElectricPotential = 2.0 [SI::volt];

        port analogInput : AnalogSignalPort;
        port digitalOutput : DigitalEventPort;

        action sampleAndQuantize {
            in item shapedPulse : AnalogPulse;
            out item event : DigitizedEvent;
        }
    }

    part def EventProcessor {
        attribute lowerEnergyThreshold : Energy = 8.0e-16 [SI::joule];
        attribute upperEnergyThreshold : Energy = 1.6e-12 [SI::joule];
        attribute energyCalibrationValid : Boolean = false;
        attribute deadTimeCorrectionEnabled : Boolean = true;

        port rawEventInput : DigitalEventPort;
        port validEventOutput : DigitalEventPort;

        action classifyAndCalibrate {
            in item rawEvent : DigitizedEvent;
            out item validEvent : DigitizedEvent;
        }
    }

    part def ThermalController {
        attribute detectorTemperature : Temperature = 253.15 [SI::kelvin];
        attribute maximumTemperature : Temperature = 273.15 [SI::kelvin];
        attribute coolingPower : ISQ::power = 5 [SI::watt];

        port detectorThermalInput : ThermalPort;
        port systemThermalOutput : ThermalPort;

        action regulateTemperature {
            in attribute measuredTemperature : Temperature;
            out attribute commandedCoolingPower : ISQ::power;
        }
    }

    part def HealthMonitor {
        attribute selfTestPassed : Boolean = false;
        attribute faultDetected : Boolean = false;
        attribute measuredLeakageCurrent : ElectricCurrent;
        attribute measuredBiasVoltage : ElectricPotential;
        attribute measuredCountRate : CountRate;

        port statusOutput : StatusPort;

        action evaluateHealth {
            in attribute leakageCurrent : ElectricCurrent;
            in attribute biasVoltage : ElectricPotential;
            in attribute countRate : CountRate;
            out item status : DetectorStatus;
        }
    }

    requirement def PrimaryFunctionRequirement {
        doc /* The semiconductor detector system shall detect incident ionizing radiation and provide calibrated digital event records containing event energy, timestamp, channel identity, and validity classification. */
        subject detector : SemiconductorDetectorSystem;
        require constraint {
            detector.primaryFunction == "Convert incident ionizing radiation into calibrated digital detection events by generating, collecting, amplifying, digitizing, and classifying charge produced in a reverse-biased semiconductor sensor."
        }
    }

    requirement def EnergyThresholdRequirement {
        doc /* The system shall reject events below the configured minimum detectable energy. */
        subject detector : SemiconductorDetectorSystem;
        require constraint {
            detector.processor.lowerEnergyThreshold == detector.minimumDetectableEnergy
        }
    }

    requirement def BiasControlRequirement {
        doc /* The bias supply shall provide the nominal reverse-bias voltage required to fully deplete the semiconductor sensor during acquisition. */
        subject detector : SemiconductorDetectorSystem;
        require constraint {
            detector.biasSupply.voltageSetpoint == detector.nominalBiasVoltage
        }
    }

    requirement def ThermalStabilityRequirement {
        doc /* The thermal controller shall maintain the semiconductor sensor at or below the nominal operating temperature before the detector enters acquisition mode. */
        subject detector : SemiconductorDetectorSystem;
        require constraint {
            detector.thermalController.detectorTemperature <= detector.operatingTemperature
        }
    }

    requirement def EventRateRequirement {
        doc /* The detector shall process radiation events up to the specified maximum event rate without disabling event classification. */
        subject detector : SemiconductorDetectorSystem;
        require constraint {
            detector.processor.deadTimeCorrectionEnabled == true and detector.maximumEventRate >= 100000 [1 / SI::second]
        }
    }

    satisfy PrimaryFunctionRequirement by SemiconductorDetectorSystem;
    satisfy EnergyThresholdRequirement by SemiconductorDetectorSystem;
    satisfy BiasControlRequirement by BiasSupply;
    satisfy ThermalStabilityRequirement by ThermalController;
    satisfy EventRateRequirement by EventProcessor;

    part semiconductorDetectorSystem : SemiconductorDetectorSystem;
}
