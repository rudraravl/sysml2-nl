                first Calibrating
                if processor.energyCalibrationValid
                then Ready;

            transition Any_to_Fault
                first Off, Initializing, BiasRamp, StabilizingTemperature, Ready, Detecting, Calibrating
                if healthMonitor.faultDetected
                then Fault;

            transition Fault_to_SafeShutdown
                first Fault
                accept FaultConfirmed
                then SafeShutdown;

            transition SafeShutdown_to_Off
                first SafeShutdown
                if biasSupply.outputVoltage <= 1 [SI::volt]
                then Off;
        }
    }

    part def SemiconductorSensor {
        attribute material : String = "High purity silicon";
        attribute depletionDepth : ISQ::length = 500e-6 [SI::metre];
        attribute activeArea : ISQ::area = 100e-6 [SI::metre * SI::metre];
        attribute electronHoleCreationEnergy : Energy = 5.77e-19 [SI::joule];
