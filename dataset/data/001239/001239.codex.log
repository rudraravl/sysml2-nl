    item def IonizingRadiation {
        attribute particleKind : String;
        attribute incidentEnergy : Energy;
        attribute arrivalTime : Time;
    }

    item def ElectronHolePairs {
        attribute generatedCharge : ElectricCharge;
        attribute pairCount : DigitalCount;
        attribute generationEnergy : Energy;
    }

    item def AnalogPulse {
        attribute amplitude : ElectricPotential;
        attribute riseTime : Time;
        attribute collectedCharge : ElectricCharge;
        attribute timestamp : Time;
    }

    item def DigitizedEvent {
