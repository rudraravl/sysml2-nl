        connect crudeStorage.crudeToDesalter.crude to desalter.crudeFeed.crude;
        connect desalter.desaltedCrudeOut.desaltedCrude to atmosphericDistillation.feed.desaltedCrude;

        connect atmosphericDistillation.residOut.residuum to vacuumDistillation.residFeed.residuum;
        connect atmosphericDistillation.gasOilOut.gasOil to catalyticCracker.feed.gasOil;
        connect vacuumDistillation.vacuumGasOilOut.vacuumGasOil to hydrocracker.feed.gasOil;

        connect atmosphericDistillation.naphthaOut.naphtha to naphthaHydrotreater.naphthaFeed.naphtha;
        connect naphthaHydrotreater.treatedNaphthaOut.naphtha to reformer.naphthaFeed.naphtha;
        connect reformer.reformateOut.reformate to productBlending.reformateIn.reformate;

        connect catalyticCracker.crackedNaphthaOut.naphtha to productBlending.crackedNaphthaIn.crackedNaphtha;
        connect catalyticCracker.crackedGasOut.lightEnds to productBlending.lightEndsIn.lightEnds;
        connect hydrocracker.dieselOut.dieselBlendstock to distillateHydrotreater.feed.distillate;
        connect hydrocracker.jetOut.jetBlendstock to productBlending.jetBlendstockIn.jetBlendstock;
        connect distillateHydrotreater.treatedDistillateOut.treatedDistillate to productBlending.treatedDieselIn.treatedDiesel;

        connect vacuumDistillation.vacuumResidOut.vacuumResiduum to productBlending.fuelOilIn.fuelOilBlendstock;

        connect reformer.hydrogenOut.hydrogen to hydrogenSystem.reformerHydrogenIn.hydrogen;
        connect hydrogenSystem.hydrogenToHydrotreaters.hydrogen to naphthaHydrotreater.hydrogenIn.hydrogen;
        connect hydrogenSystem.hydrogenToHydrotreaters.hydrogen to distillateHydrotreater.hydrogenIn.hydrogen;
        connect hydrogenSystem.hydrogenToHydrocracker.hydrogen to hydrocracker.hydrogenIn.hydrogen;

        connect distillateHydrotreater.sourGasOut.sourGas to sulfurRecovery.sourGasFeed.sourGas;
        connect sulfurRecovery.sulfurOut.sulfur to productBlending.productsOut.sulfur;

        connect utilitySystem.utilityOut.steam to desalter.utilityIn.steam;
        connect utilitySystem.utilityOut.coolingWater to atmosphericDistillation.utilityIn.coolingWater;
        connect utilitySystem.utilityOut.electricity to catalyticCracker.utilityIn.electricity;
        connect utilitySystem.utilityOut.steam to vacuumDistillation.utilityIn.steam;
        connect utilitySystem.utilityOut.electricity to hydrocracker.utilityIn.electricity;

        connect atmosphericDistillation.emissionsOut.emissions to environmentalControls.processEmissionsIn.emissions;
        connect catalyticCracker.emissionsOut.emissions to environmentalControls.processEmissionsIn.emissions;
        connect sulfurRecovery.tailGasOut.emissions to environmentalControls.processEmissionsIn.emissions;
        connect environmentalControls.controlledEmissionsOut.emissions to emissionsDischarge.emissions;

        connect productBlending.productsOut.gasoline to productsShipment.gasoline;
        connect productBlending.productsOut.diesel to productsShipment.diesel;
        connect productBlending.productsOut.jetFuel to productsShipment.jetFuel;
        connect productBlending.productsOut.lpg to productsShipment.lpg;
        connect productBlending.productsOut.fuelOil to productsShipment.fuelOil;
        connect productBlending.productsOut.sulfur to productsShipment.sulfur;

        connect controlInterface.modeCommand to controlSystem.control.modeCommand;
        connect controlSystem.control.operatingMode to controlInterface.operatingMode;
        connect controlSystem.control.alarmSeverity to controlInterface.alarmSeverity;
    }

    requirement def PrimaryFunctionRequirement {
        doc /* The refinery shall transform incoming crude oil into marketable transportation fuels, fuel products, liquefied petroleum gas, and sulfur by separating, converting, treating, and blending hydrocarbon streams while controlling emissions and maintaining safe operation. */
        subject refinery : IntegratedOilRefinery;
        require constraint {
            refinery.nominalCrudeCapacity >= 250000.0
        }
    }

    requirement def ProductSlateRequirement {
        doc /* The refinery shall produce gasoline, diesel, jet fuel, LPG, fuel oil, and sulfur from crude oil feedstock. */
        subject refinery : IntegratedOilRefinery;
        require constraint {
            refinery.productsShipment.gasoline.octane >= 87.0 and
            refinery.productsShipment.diesel.sulfur <= 0.0015 and
            refinery.productsShipment.jetFuel.freezePoint <= -47.0
        }
    }

    requirement def FeedCapacityRequirement {
        doc /* The refinery shall process crude oil at a nominal capacity of 250000 barrels per day during normal operation. */
        subject refinery : IntegratedOilRefinery;
        require constraint {
            refinery.nominalCrudeCapacity == 250000.0
        }
    }

    requirement def DesaltingRequirement {
        doc /* The desalting subsystem shall reduce crude salt content to no more than 1 pound per thousand barrels before atmospheric distillation. */
        subject desalter : Desalter;
        require constraint {
            desalter.outletSaltLimit <= 1.0
        }
    }

    requirement def SulfurControlRequirement {
        doc /* Hydrotreating and sulfur recovery shall reduce sulfur in finished diesel and recover sulfur from sour gas streams. */
        subject refinery : IntegratedOilRefinery;
        require constraint {
            refinery.distillateHydrotreater.dieselSulfurLimit <= 0.0015 and
            refinery.sulfurRecovery.sulfurRecoveryEfficiency >= 99.5
        }
    }

    requirement def EnvironmentalRequirement {
        doc /* Controlled emissions shall remain within permitted sulfur oxides, nitrogen oxides, carbon dioxide, and particulate limits during normal operation. */
        subject controls : EnvironmentalControlSystem;
        require constraint {
            controls.soxPermitLimit <= 12.0 and
            controls.noxPermitLimit <= 9.0 and
            controls.wastewaterOilLimit <= 15.0
        }
    }

    requirement def SafetyShutdownRequirement {
        doc /* The control system shall transition the refinery to emergency shutdown when process pressure or temperature exceeds trip limits. */
        subject controlSystem : RefineryControlSystem;
        require constraint {
            controlSystem.highPressureTripSetpoint <= 17000.0 and
            controlSystem.highTemperatureTripSetpoint <= 760.0
        }
    }

    requirement def AvailabilityRequirement {
        doc /* The integrated refinery shall support an annual mechanical availability target of at least 96 percent. */
        subject refinery : IntegratedOilRefinery;
        require constraint {
            refinery.annualAvailabilityTarget >= 96.0
        }
    }

    satisfy PrimaryFunctionRequirement by IntegratedOilRefinery;
    satisfy ProductSlateRequirement by IntegratedOilRefinery;
    satisfy FeedCapacityRequirement by IntegratedOilRefinery;
    satisfy DesaltingRequirement by Desalter;
    satisfy SulfurControlRequirement by IntegratedOilRefinery;
    satisfy EnvironmentalRequirement by EnvironmentalControlSystem;
    satisfy SafetyShutdownRequirement by RefineryControlSystem;
    satisfy AvailabilityRequirement by IntegratedOilRefinery;

}
