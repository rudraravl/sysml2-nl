        out item diesel : DieselProduct;
        out item jetFuel : JetFuelProduct;
        out item lpg : LPGProduct;
        out item fuelOil : FuelOilProduct;
        out item sulfur : SulfurProduct;

        first start;
        then receive : ReceiveAndStoreCrude;
        then desalting : RemoveWaterSaltAndSolids;
        then distillation : FractionateCrude;
        then conversion : ConvertHeavyFractions;
        then treating : RemoveSulfurAndNitrogen;
        then blending : BlendFinishedProducts;
        then sulfurRecovery : RecoverSulfur;
        then done;
    }

    state def RefineryOperatingStateMachine {
        state offline;
        state starting;
        state running;
        state constrainedOperation;
        state shuttingDown;
        state maintenanceOutage;

        transition first offline;
        transition offline_to_starting
            first offline
            then starting
            accept RefineryOperatingMode::startup;

        transition starting_to_running
            first starting
            then running
            if allRequiredUtilitiesAvailable and feedQualityVerified;

        transition running_to_constrained
            first running
            then constrainedOperation
            if crudeFeedRateBelowMinimum or utilityConstraintActive;

        transition constrained_to_running
            first constrainedOperation
            then running
            if constraintsCleared;

        transition running_to_shutdown
            first running
            then shuttingDown
            accept RefineryOperatingMode::emergencyShutdown;

        transition constrained_to_shutdown
            first constrainedOperation
            then shuttingDown
            accept RefineryOperatingMode::emergencyShutdown;

        transition shutdown_to_offline
            first shuttingDown
            then offline
            if processUnitsDepressurized and firedHeatersIsolated;

        transition offline_to_maintenance
            first offline
            then maintenanceOutage
            accept RefineryOperatingMode::maintenance;

        transition maintenance_to_offline
            first maintenanceOutage
            then offline
            if maintenanceComplete;
    }

    part def IntegratedOilRefinery {
        attribute name : String = "Integrated Crude Oil Refinery";
        attribute nominalCrudeCapacity : FlowRate = 250000.0;
        attribute minimumStableThroughput : FlowRate = 125000.0;
        attribute annualAvailabilityTarget : Availability = 96.0;
        attribute operatingMode : RefineryOperatingMode;

