    }

    part def OdometerDisplay {
        attribute primaryResolution : DistanceValue = (value = 0.1, unit = "km");
        attribute tripResolution : DistanceValue = (value = 0.1, unit = "km");
        attribute brightnessPercent : Real = 80.0;

        port readingIn : ReadingInputPort;
        port frameOut : DisplayOutputPort;
        port diagnosticIn : DiagnosticOutputPort;

        action formatReading {
            in item reading : OdometerReading;
            out item frame : DisplayFrame;
        }

        action showWarning {
            in item diagnostic : DiagnosticCode;
            out item frame : DisplayFrame;
        }
    }

    part def VehiclePowerInterface {
        attribute nominalVoltage : Real = 12.0;
        attribute minimumOperatingVoltage : Real = 9.0;
        attribute maximumOperatingVoltage : Real = 16.0;

        port supplyOut : PowerInputPort;
        port ignitionOut : IgnitionInputPort;

        action conditionPower {
            out item supply : PowerSupply;
        }

        action readIgnition {
            out item ignition : IgnitionStatus;
        }
    }

    part def OdometerSystem {
        attribute primaryFunction : String = "Measure wheel rotation, convert validated movement pulses into accumulated vehicle distance, preserve the lifetime total distance, support resettable trip distance, and present the reading to the driver.";
        attribute requiredAccuracyPercent : Real = 1.0;
        attribute operatingTemperatureMin : Real = -40.0;
        attribute operatingTemperatureMax : Real = 85.0;

        part powerInterface : VehiclePowerInterface;
        part leftFrontSensor : WheelSpeedSensor {
            attribute sensorId = "LF";
        }
        part rightFrontSensor : WheelSpeedSensor {
            attribute sensorId = "RF";
        }
        part pulseConditioner : PulseConditioner;
        part distanceCalculator : DistanceCalculator;
        part controller : OdometerController;
        part memory : NonvolatileMemory;
        part display : OdometerDisplay;

        port resetTripCommandIn : CommandInputPort;
        port displayFrameOut : DisplayOutputPort;
        port diagnosticOut : DiagnosticOutputPort;

        connection power_to_left_sensor
            connect powerInterface.supplyOut to leftFrontSensor.powerIn;

        connection power_to_right_sensor
            connect powerInterface.supplyOut to rightFrontSensor.powerIn;

        connection ignition_to_controller
            connect powerInterface.ignitionOut to controller.ignitionIn;

        connection left_sensor_to_conditioner
            connect leftFrontSensor.pulseOut to pulseConditioner.rawPulseIn;

        connection right_sensor_to_conditioner
            connect rightFrontSensor.pulseOut to pulseConditioner.rawPulseIn;

        connection conditioned_pulse_to_calculator
            connect pulseConditioner.conditionedPulseOut to distanceCalculator.pulseIn;

        connection increment_to_controller
            connect distanceCalculator.incrementOut to controller.incrementIn;

        connection speed_to_controller
            connect distanceCalculator.speedOut to controller.speedIn;

        connection memory_to_controller
            connect memory.readingOut to controller.memoryReadingIn;

        connection controller_to_memory
            connect controller.memoryReadingOut to memory.readingIn;

        connection controller_to_display
            connect controller.readingOut to display.readingIn;

        connection trip_reset_to_controller
            connect resetTripCommandIn to controller.commandIn;

        connection display_to_vehicle
            connect display.frameOut to displayFrameOut;

        connection controller_diagnostic_to_vehicle
            connect controller.diagnosticOut to diagnosticOut;

        connection calculator_diagnostic_to_vehicle
            connect distanceCalculator.diagnosticOut to diagnosticOut;

        connection conditioner_diagnostic_to_vehicle
            connect pulseConditioner.diagnosticOut to diagnosticOut;

        connection memory_diagnostic_to_vehicle
            connect memory.diagnosticOut to diagnosticOut;

        action operateOdometer {
            first start;

            then action readIgnitionState {
                out item ignition : IgnitionStatus;
            }

            then action validatePower {
                in item ignition : IgnitionStatus;
                out item supply : PowerSupply;
            }

            then action receiveWheelPulses {
                out item pulse : WheelRotationPulse;
            }

            then action filterPulses {
                in item pulse : WheelRotationPulse;
                out item conditionedPulse : WheelRotationPulse;
            }

            then action calculateTravel {
                in item conditionedPulse : WheelRotationPulse;
                out item increment : DistanceIncrement;
            }

            then action accumulateReading {
                in item increment : DistanceIncrement;
                out item reading : OdometerReading;
            }

            then action storeReading {
                in item reading : OdometerReading;
            }

            then action displayReading {
                in item reading : OdometerReading;
                out item frame : DisplayFrame;
            }

            then done;
        }
    }

    requirement def PrimaryFunctionRequirement {
        subject odometerSystem : OdometerSystem;
        require constraint {
            odometerSystem.primaryFunction == "Measure wheel rotation, convert validated movement pulses into accumulated vehicle distance, preserve the lifetime total distance, support resettable trip distance, and present the reading to the driver."
        }
    }

    requirement def DistanceAccuracyRequirement {
        subject odometerSystem : OdometerSystem;
        require constraint {
            odometerSystem.requiredAccuracyPercent <= 1.0
        }
    }

    requirement def PersistentTotalDistanceRequirement {
        subject memory : NonvolatileMemory;
        require constraint {
            memory.retentionYears >= 15.0
        }
    }

    requirement def DisplayRangeRequirement {
        subject controller : OdometerController;
        require constraint {
            controller.maximumDisplayDistance.value >= 999999.9
        }
    }

    requirement def TripResetRequirement {
        subject controller : OdometerController;
        require constraint {
            controller.tripDistance.value >= 0.0
        }
    }

    requirement def PowerOperatingRequirement {
        subject powerInterface : VehiclePowerInterface;
        require constraint {
            powerInterface.minimumOperatingVoltage <= 9.0 and powerInterface.maximumOperatingVoltage >= 16.0
        }
    }

    requirement def EnvironmentalRequirement {
        subject odometerSystem : OdometerSystem;
        require constraint {
            odometerSystem.operatingTemperatureMin <= -40.0 and odometerSystem.operatingTemperatureMax >= 85.0
        }
    }

    requirement def PulsePlausibilityRequirement {
        subject calculator : DistanceCalculator;
        require constraint {
            calculator.maximumAcceptedSpeed.value <= 260.0
        }
    }

    requirement primaryFunctionRequirement : PrimaryFunctionRequirement {
        subject odometerSystem = odometer;
    }

    requirement distanceAccuracyRequirement : DistanceAccuracyRequirement {
        subject odometerSystem = odometer;
    }

    requirement persistentTotalDistanceRequirement : PersistentTotalDistanceRequirement {
        subject memory = odometer.memory;
    }

    requirement displayRangeRequirement : DisplayRangeRequirement {
        subject controller = odometer.controller;
    }

    requirement tripResetRequirement : TripResetRequirement {
        subject controller = odometer.controller;
    }

    requirement powerOperatingRequirement : PowerOperatingRequirement {
        subject powerInterface = odometer.powerInterface;
    }

    requirement environmentalRequirement : EnvironmentalRequirement {
        subject odometerSystem = odometer;
    }

    requirement pulsePlausibilityRequirement : PulsePlausibilityRequirement {
        subject calculator = odometer.distanceCalculator;
    }

    part odometer : OdometerSystem;

}
