  part def GalvoScanner {
    attribute maximumScanAngle : Angle = 20 [deg];
    attribute commandBandwidth : Frequency = 1 [kHz];
    port inputBeam : LaserEmissionPort;
    port outputBeam : LaserEmissionPort;
  }

  part def ObjectiveLens {
    attribute focalLength : Length = 10 [mm];
    attribute workingDistance : Length = 15 [mm];
    port inputBeam : LaserEmissionPort;
    port outputBeam : LaserEmissionPort;
  }

  part def PrecisionMotionSubsystem {
    attribute xTravel : Length = 100 [mm];
    attribute yTravel : Length = 100 [mm];
    attribute zTravel : Length = 25 [mm];
    attribute zResolution : Length = 0.1 [um];
    attribute maximumVelocity : Speed = 50 [mm/s];

    port control : MotionControlPort;
    port stageInterface : MotionControlPort;

    part xAxis : LinearAxis;
    part yAxis : LinearAxis;
    part zAxis : LinearAxis;

    connect control to xAxis.control;
    connect control to yAxis.control;
    connect control to zAxis.control;
    connect zAxis.stageOutput to stageInterface;

    action positionSample {
      in attribute requestedThickness : Length;
      out attribute cuttingPlanePosition : Length;
      first readCurrentPosition;
      then calculateLayerIncrement;
      then moveZAxis;
      then stabilizeStage;
      then done;

      action readCurrentPosition;
      action calculateLayerIncrement;
      action moveZAxis;
      action stabilizeStage;
    }
  }

  part def LinearAxis {
    attribute travel : Length;
    attribute resolution : Length = 0.1 [um];
    attribute maximumVelocity : Speed = 50 [mm/s];
    port control : MotionControlPort;
    port stageOutput : MotionControlPort;
  }

  part def SampleHandlingSubsystem {
    attribute clampForce : Pressure = 20 [kPa];
    attribute sampleAreaCapacity : Area = 400 [mm^2];
    attribute currentCutDepth : Length = 0 [um];

    port samplePort : SamplePort;
    port stageControl : MotionControlPort;
    port ablationZone : LaserEmissionPort;
    port debrisOut : DebrisPort;
    port measurementPort : SamplePort;
    port thermalInterface : FluidPort;

    action ablateLayer {
      in item sample : BiologicalSample;
      in item pulse : LaserPulse;
      in attribute targetThickness : Length;
      out item section : TissueSection;
      out item debris : AblationDebris;
      first clampSample;
      then alignSurface;
      then rasterAblateCutPlane;
      then releaseSection;
      then transferSection;
      then done;

      action clampSample;
      action alignSurface;
      action rasterAblateCutPlane;
      action releaseSection;
      action transferSection;
    }
  }

  part def SectionSensingSubsystem {
    attribute thicknessMeasurementResolution : Length = 0.2 [um];
    attribute surfaceTemperatureAccuracy : Temperature = 0.5 [K];

    port sampleObservation : SamplePort;
    port feedbackPort : ControlPort;

    part opticalCoherenceSensor : ThicknessSensor;
    part thermalCamera : ThermalSensor;

    action measureSectionQuality {
      in item section : TissueSection;
      out item status : Status;
      first measureThickness;
      then measureThermalDamage;
      then compareAgainstTolerance;
      then reportStatus;
      then done;

      action measureThickness;
      action measureThermalDamage;
      action compareAgainstTolerance;
      action reportStatus;
    }
  }

  part def ThicknessSensor {
    attribute axialResolution : Length = 0.2 [um];
    attribute scanDepth : Length = 2 [mm];
  }

  part def ThermalSensor {
    attribute temperatureRangeLow : Temperature = 273.15 [K];
    attribute temperatureRangeHigh : Temperature = 373.15 [K];
  }

  part def DebrisExtractionSubsystem {
    attribute suctionFlowSpeed : Speed = 2 [m/s];
    attribute filterParticleLimit : Length = 0.3 [um];

    port debrisIn : DebrisPort;
    port debrisOut : DebrisPort;

    action removeAblationDebris {
      in item debris : AblationDebris;
      out item capturedDebris : AblationDebris;
      first drawAirflowAcrossCut;
      then separateParticles;
      then monitorFilterLoad;
      then done;

      action drawAirflowAcrossCut;
      action separateParticles;
      action monitorFilterLoad;
    }
  }

  part def ThermalControlSubsystem {
    attribute coolantSetpoint : Temperature = 293.15 [K];
    attribute maximumSampleTemperature : Temperature = 310.15 [K];

    port coolantPort : FluidPort;
    port thermalContact : FluidPort;

    action regulateTemperature {
      in item coolant : CoolingFluid;
      out item conditionedCoolant : CoolingFluid;
      first readTemperature;
      then adjustCoolantFlow;
      then rejectHeat;
      then done;

      action readTemperature;
      action adjustCoolantFlow;
      action rejectHeat;
    }
  }

  part def SafetyInterlockSubsystem {
    attribute enclosureClosed : Boolean;
    attribute emergencyStopActive : Boolean;
    attribute laserPermitGranted : Boolean;

    port control : ControlPort;
    port permitSignal : SafetySignalPort;

    action evaluateInterlocks {
      out attribute permit : Boolean;
      first readGuardSwitch;
      then readEmergencyStop;
      then readBeamDumpSensor;
      then computeLaserPermit;
      then done;

      action readGuardSwitch;
      action readEmergencyStop;
      action readBeamDumpSensor;
      action computeLaserPermit;
    }

    state def SafetyState {
      state Open;
      state Ready;
      state Tripped;

      transition first Open;
      transition Open_to_Ready from Open to Ready
        if enclosureClosed == true and emergencyStopActive == false;
      transition Ready_to_Open from Ready to Open
        if enclosureClosed == false;
      transition Ready_to_Tripped from Ready to Tripped
        if emergencyStopActive == true;
      transition Tripped_to_Open from Tripped to Open
        if emergencyStopActive == false;

      entry action setLaserPermitFalse;
      action setLaserPermitFalse;
    }

    exhibit state safetyStates : SafetyState;
  }

  part def MicrotomeController {
    attribute thicknessTolerance : Length = 1 [um];
    attribute thermalDamageLimit : Length = 3 [um];
    attribute defaultScanSpeed : Speed = 10 [mm/s];

    port operatorInterface : ControlPort;
    port laserControl : ControlPort;
    port motionControl : MotionControlPort;
    port sensorFeedback : ControlPort;
    port safetyCommand : ControlPort;

    action executeSectioningCycle {
      in item command : Command;
      in item sample : BiologicalSample;
      out item section : TissueSection;
      out item status : Status;
      first validateCommand;
      then verifySafetyPermit;
      then calculateLaserRecipe;
      then positionCuttingPlane;
      then commandLaserRaster;
      then collectQualityFeedback;
      then acceptOrRejectSection;
      then publishStatus;
      then done;

      action validateCommand;
      action verifySafetyPermit;
      action calculateLaserRecipe;
      action positionCuttingPlane;
      action commandLaserRaster;
      action collectQualityFeedback;
      action acceptOrRejectSection;
      action publishStatus;
    }
  }

  action def LaserMicrotome::cutThinSection {
    in item inputSample : BiologicalSample;
    in item sectioningCommand : Command;
    out item outputSection : TissueSection;
    out item systemStatus : Status;

    first receiveSampleAndCommand;
    then secureSample;
    then verifyInterlocks;
    then configureLaserAndMotion;
    then ablateSectionPlane;
    then extractDebris;
    then measureProducedSection;
    then releaseAcceptedSection;
    then done;

    action receiveSampleAndCommand;
    action secureSample;
    action verifyInterlocks;
    action configureLaserAndMotion;
    action ablateSectionPlane;
    action extractDebris;
    action measureProducedSection;
    action releaseAcceptedSection;
  }

  state def LaserMicrotome::operatingStates {
    state Idle;
    state Loaded;
    state Armed;
    state Sectioning;
    state Inspecting;
    state Complete;
    state Fault;

    transition first Idle;
    transition Idle_to_Loaded from Idle to Loaded
      accept BiologicalSample;
    transition Loaded_to_Armed from Loaded to Armed
      accept Command
      if safetySubsystem.laserPermitGranted == true;
    transition Armed_to_Sectioning from Armed to Sectioning
      accept Command;
    transition Sectioning_to_Inspecting from Sectioning to Inspecting
      after 1 [s];
    transition Inspecting_to_Complete from Inspecting to Complete
      if sensingSubsystem.thicknessMeasurementResolution <= controller.thicknessTolerance;
    transition Inspecting_to_Sectioning from Inspecting to Sectioning
      if sensingSubsystem.thicknessMeasurementResolution > controller.thicknessTolerance;
    transition Complete_to_Idle from Complete to Idle
      accept Command;
    transition Idle_to_Fault from Idle to Fault
      if safetySubsystem.emergencyStopActive == true;
    transition Loaded_to_Fault from Loaded to Fault
      if safetySubsystem.emergencyStopActive == true;
    transition Armed_to_Fault from Armed to Fault
      if safetySubsystem.emergencyStopActive == true;
    transition Sectioning_to_Fault from Sectioning to Fault
      if safetySubsystem.emergencyStopActive == true;
    transition Fault_to_Idle from Fault to Idle
      accept Command
      if safetySubsystem.emergencyStopActive == false;
  }

  requirement def PrimaryFunctionRequirement {
    subject microtome : LaserMicrotome;
    doc
    /*
     The laser microtome shall convert a mounted biological sample into controlled thin tissue sections by using a focused pulsed laser to ablate a precise cutting plane while coordinating sample positioning, debris extraction, thermal control, safety interlocks, and section quality feedback.
    */
    require constraint {
      microtome.minimumSectionThickness <= microtome.nominalSectionThickness and
      microtome.nominalSectionThickness <= microtome.maximumSectionThickness
    }
  }

  requirement def SectionThicknessRequirement {
    subject section : TissueSection;
    attribute targetThickness : Length = 20 [um];
    attribute allowedError : Length = 1 [um];
    require constraint {
      section.thickness >= targetThickness - allowedError and
      section.thickness <= targetThickness + allowedError
    }
  }

  requirement def ThermalDamageRequirement {
    subject section : TissueSection;
    attribute maximumDamageDepth : Length = 3 [um];
    require constraint {
      section.thermalDamageDepth <= maximumDamageDepth
    }
  }

  requirement def SafetyInterlockRequirement {
    subject system : LaserMicrotome;
    require constraint {
      system.safetySubsystem.laserPermitGranted == true implies
      system.safetySubsystem.enclosureClosed == true and
      system.safetySubsystem.emergencyStopActive == false
    }
  }

  requirement def LaserOperatingRequirement {
    subject laser : PulsedLaserSubsystem;
    require constraint {
      laser.averagePower <= 25 [W] and
      laser.wavelength >= 1000 [nm] and
      laser.wavelength <= 1100 [nm]
    }
  }

  requirement def MotionResolutionRequirement {
    subject motion : PrecisionMotionSubsystem;
    require constraint {
      motion.zResolution <= 0.1 [um]
    }
  }

  requirement def DebrisRemovalRequirement {
    subject debrisSystem : DebrisExtractionSubsystem;
    require constraint {
      debrisSystem.suctionFlowSpeed >= 1 [m/s] and
      debrisSystem.filterParticleLimit <= 0.3 [um]
    }
  }

  satisfy PrimaryFunctionRequirement by LaserMicrotome;
  satisfy SectionThicknessRequirement by TissueSection;
  satisfy ThermalDamageRequirement by TissueSection;
  satisfy SafetyInterlockRequirement by LaserMicrotome;
  satisfy LaserOperatingRequirement by PulsedLaserSubsystem;
  satisfy MotionResolutionRequirement by PrecisionMotionSubsystem;
  satisfy DebrisRemovalRequirement by DebrisExtractionSubsystem;

  allocation def ControlAllocation {
    end controller : MicrotomeController;
    end controlledLaser : PulsedLaserSubsystem;
    end controlledMotion : PrecisionMotionSubsystem;
    end monitoredSafety : SafetyInterlockSubsystem;
  }

  allocation controlAllocation : ControlAllocation
    allocate controller to controlledLaser,
             controller to controlledMotion,
             controller to monitoredSafety;

}
