        attribute lastLatency : DurationValue;

        action sendAuthorization {
            in attribute request : TransactionRequest;
            out attribute response : TransactionResponse;
        }
    }

    part def BankHostGateway {
        port atmLink : SecureHostPort;
        attribute hostAvailable : Boolean;
        attribute dailyWithdrawalLimit : MoneyAmount;

        action authorize {
            in attribute request : TransactionRequest;
            out attribute response : TransactionResponse;
        }
    }

    part def SupervisorController {
        attribute sessionActive : Boolean;
        attribute invalidPinAttempts : Integer;
        attribute currentRequest : TransactionRequest;
        attribute currentResponse : TransactionResponse;
        attribute currentReceipt : ReceiptData;

        action startSession {
            in attribute cardData : CardData;
            out item welcome : DisplayMessage;
        }

        action buildTransactionRequest {
            in attribute cardData : CardData;
            in attribute pinBlock : PinBlock;
            in item customerInput : CustomerInput;
            out attribute request : TransactionRequest;
        }

        action evaluateHostResponse {
            in attribute response : TransactionResponse;
            out attribute approved : Boolean;
            out item message : DisplayMessage;
        }

        action closeSession {
            out item finalMessage : DisplayMessage;
        }
    }

    part def AutomatedTellerMachine {
        port customerCardPort : CardSlotPort;
        port customerCashOutPort : CashDispensePort;
        port customerCashInPort : CashDepositPort;
        port customerReceiptPort : ReceiptPort;
        port customerUiPort : UserInterfacePort;
        port hostPort : SecureHostPort;
        port maintenancePort : MaintenancePort;
        port power : PowerPort;

        attribute atmId : Identifier;
        attribute locationId : Identifier;
        attribute maximumWithdrawalPerTransaction : MoneyAmount;
        attribute sessionTimeout : DurationValue;
        attribute operational : Boolean;
        attribute cashAvailable : MoneyAmount;
        attribute receiptPaperAvailable : Boolean;

        part cardReader : CardReader;
        part pinPad : PinPad;
        part display : TouchDisplay;
        part dispenser : CashDispenser;
        part acceptor : CashAcceptor;
        part printer : ReceiptPrinter;
        part security : SecurityModule;
        part network : NetworkAdapter;
        part controller : SupervisorController;

        connect customerCardPort to cardReader.cardSlot;
        connect customerCashOutPort to dispenser.outlet;
        connect customerCashInPort to acceptor.inlet;
        connect customerReceiptPort to printer.receiptOutput;
        connect customerUiPort to display.ui;
        connect hostPort to network.hostLink;

        perform action operateSession {
            first start;
            then awaitCard;
            then authenticateCustomer;
            then selectTransaction;
            then executeTransaction;
            then issueReceipt;
            then returnCard;
            then endSession;
        }

        state def AtmOperationalState {
            state initializing;
            state idle;
            state cardInserted;
            state authenticating;
            state transactionSelection;
            state processing;
            state dispensingCash;
            state acceptingDeposit;
            state printingReceipt;
            state returningCard;
            state outOfService;
            state maintenance;

            entry initializing;
            then initializing to idle if operational;

            transition idle_to_cardInserted
                first idle
                then cardInserted
                accept item insertedCard : BankCard via customerCardPort.insertedCard;

            transition cardInserted_to_authenticating
                first cardInserted
                then authenticating;

            transition authenticating_to_selection
                first authenticating
                then transactionSelection
                if controller.invalidPinAttempts < cardReader.maxInvalidPinAttempts;

            transition authenticating_to_retained
                first authenticating
                then outOfService
                if controller.invalidPinAttempts >= cardReader.maxInvalidPinAttempts;

            transition selection_to_processing
                first transactionSelection
                then processing
                accept item input : CustomerInput via customerUiPort.input;

            transition processing_to_dispensing
                first processing
                then dispensingCash
                if controller.currentRequest.kind == TransactionKind::CashWithdrawal and controller.currentResponse.status == TransactionStatus::Approved;

            transition processing_to_acceptingDeposit
                first processing
                then acceptingDeposit
                if controller.currentRequest.kind == TransactionKind::CashDeposit and controller.currentResponse.status == TransactionStatus::Approved;

            transition processing_to_printing
                first processing
                then printingReceipt
                if controller.currentRequest.kind == TransactionKind::BalanceInquiry;

            transition dispensing_to_printing
                first dispensingCash
                then printingReceipt;

            transition deposit_to_printing
                first acceptingDeposit
                then printingReceipt;

            transition printing_to_returning
                first printingReceipt
                then returningCard;

            transition returning_to_idle
                first returningCard
                then idle;

            transition any_to_outOfService
                first idle
                then outOfService
                if security.tamperDetected or dispenser.jamDetected or not network.online;

            transition outOfService_to_maintenance
                first outOfService
                then maintenance
                if maintenancePort.serviceAuthorized;

            transition maintenance_to_idle
                first maintenance
                then idle
                if operational and network.online and not security.tamperDetected;
        }
    }

    part bankHost : BankHostGateway;

    part atm : AutomatedTellerMachine {
        attribute atmId = Identifier { value = "ATM-CHICAGO-042" };
        attribute locationId = Identifier { value = "BRANCH-LOBBY-17" };
        attribute maximumWithdrawalPerTransaction = MoneyAmount { amount = 500.0; currency = CurrencyCode::USD; };
        attribute sessionTimeout = DurationValue { seconds = 45.0; };
        attribute operational = true;
        attribute cashAvailable = MoneyAmount { amount = 80000.0; currency = CurrencyCode::USD; };
        attribute receiptPaperAvailable = true;
    }

    connect atm.hostPort to bankHost.atmLink;

    action def PrimaryAtmFunction {
        in item customerCard : BankCard;
        in item customerInput : CustomerInput;
        in attribute enteredPin : PinBlock;
        out attribute transactionResult : TransactionResponse;
        out item cashToCustomer : CashBundle;
        out item receiptToCustomer : Receipt;

        first acceptCard;
        then authenticateCardholder;
        then captureTransactionChoice;
        then requestBankAuthorization;
        then completeAuthorizedTransaction;
        then provideCustomerRecord;
        then returnCustomerCard;
    }

    action def WithdrawCash {
        in attribute request : TransactionRequest;
        in attribute response : TransactionResponse;
        out item dispensedCash : CashBundle;
        out attribute updatedAtmCash : MoneyAmount;

        first verifyApproval;
        then verifyCashAvailability;
        then countNotes;
        then presentCash;
        then updateCashInventory;
    }

    action def DepositCash {
        in attribute request : TransactionRequest;
        in item depositedCash : CashBundle;
        out attribute response : TransactionResponse;
        out item rejectedCash : CashBundle;

        first validateNotes;
        then escrowAcceptedNotes;
        then requestDepositPosting;
        then commitOrReturnEscrow;
    }

    action def QueryBalance {
        in attribute request : TransactionRequest;
        out attribute response : TransactionResponse;

        first sendInquiry;
        then receiveAvailableBalance;
        then displayBalance;
    }

    requirement def HighLevelPrimaryFunctionRequirement {
        subject atm : AutomatedTellerMachine;

        doc /* The automated teller machine shall provide unattended customer banking access by accepting a bank card and PIN, communicating securely with the bank host, executing authorized balance inquiry, withdrawal, deposit, and transfer transactions, dispensing or accepting cash when required, printing a customer receipt, and returning or retaining the card according to security rules. */

        require constraint {
            atm.operational == true implies atm.network.online == true
        }
    }

    requirement def SecureAuthenticationRequirement {
        subject atm : AutomatedTellerMachine;

        require constraint {
            atm.security.encryptionEnabled == true
        }

        require constraint {
            atm.cardReader.maxInvalidPinAttempts == 3
        }
    }

    requirement def WithdrawalLimitRequirement {
        subject atm : AutomatedTellerMachine;

        require constraint {
            atm.maximumWithdrawalPerTransaction.amount <= 500.0
        }
    }

    requirement def CashAvailabilityRequirement {
        subject atm : AutomatedTellerMachine;

        require constraint {
            atm.dispenser.availableCash.amount >= atm.dispenser.lowCashThreshold.amount implies atm.operational == true
        }
    }

    requirement def SessionTimeoutRequirement {
        subject atm : AutomatedTellerMachine;

        require constraint {
            atm.sessionTimeout.seconds <= 60.0
        }
    }

    requirement def ReceiptRequirement {
        subject atm : AutomatedTellerMachine;

        require constraint {
            atm.printer.printerReady == true implies atm.receiptPaperAvailable == true
        }
    }

    requirement def HostAuthorizationRequirement {
        subject atm : AutomatedTellerMachine;

        require constraint {
            atm.controller.currentResponse.status == TransactionStatus::Approved implies atm.network.online == true
        }
    }

    requirement def TamperProtectionRequirement {
        subject atm : AutomatedTellerMachine;

        require constraint {
            atm.security.tamperDetected == true implies atm.operational == false
        }
    }

