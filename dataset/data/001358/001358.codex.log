        port outlet : CashDispensePort;
        attribute cassetteCapacityNotes : Integer;
        attribute availableCash : MoneyAmount;
        attribute jamDetected : Boolean;
        attribute lowCashThreshold : MoneyAmount;

        part cassette20;
        part cassette50;
        part presenter;

        action prepareCash {
            in attribute requestedAmount : MoneyAmount;
            out item cash : CashBundle;
        }

        action presentCash {
            in item cash : CashBundle;
            out item dispensed : CashBundle;
        }
    }

    part def CashAcceptor {
        port inlet : CashDepositPort;
        attribute escrowedCash : MoneyAmount;
        attribute rejectedCashCount : Integer;

        action validateDeposit {
            in item deposited : CashBundle;
            out item accepted : CashBundle;
            out item rejected : CashBundle;
        }

        action commitDeposit {
            in item accepted : CashBundle;
        }

        action returnDeposit {
            out item returned : CashBundle;
        }
    }

    part def ReceiptPrinter {
        port receiptOutput : ReceiptPort;
        attribute paperRemainingPercent : PercentageValue;
        attribute printerReady : Boolean;

        action printReceipt {
            in attribute receiptData : ReceiptData;
            out item receipt : Receipt;
        }
    }

    part def SecurityModule {
        attribute encryptionEnabled : Boolean = true;
        attribute tamperDetected : Boolean;
        attribute temperature : TemperatureValue;

        action encryptPin {
            in attribute clearPinToken : Identifier;
            out attribute pinBlock : PinBlock;
        }

        action reportSecurityEvent {
            in attribute kind : SecurityEventKind;
            out item event : SecurityEvent;
        }
