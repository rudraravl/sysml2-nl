        action readCard {
            in item card : BankCard;
            out attribute cardData : CardData;
        }

        action returnCard {
            out item card : BankCard;
        }

        action retainCard {
            out item retained : BankCard;
        }
    }

    part def PinPad {
        attribute pinEntryTimeout : DurationValue;
        attribute encryptedPinAvailable : Boolean;

        action capturePin {
            in item prompt : DisplayMessage;
            out attribute pinBlock : PinBlock;
        }
    }

    part def TouchDisplay {
        port ui : UserInterfacePort;
        attribute diagonalSizeInches : Real;
        attribute brightness : PercentageValue;

        action showMessage {
            in item message : DisplayMessage;
        }

        action collectSelection {
            out item input : CustomerInput;
        }
