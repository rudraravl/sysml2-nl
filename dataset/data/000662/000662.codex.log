        subject scalpel : LaserScalpelSystem;

        require constraint {
            scalpel.laserSource.nominalWavelength == scalpel.nominalTreatmentWavelength
        }
    }

    requirement def CoolingProtectionRequirement {
        subject scalpel : LaserScalpelSystem;

        require constraint {
            scalpel.cooling.nominalFlowRate >= scalpel.cooling.minimumSafeFlowRate
        }
    }

    requirement def BeamAccuracyRequirement {
        subject scalpel : LaserScalpelSystem;

        doc /* Measured optical power shall remain within ten percent of the commanded optical power during enabled emission. */

        require constraint {
            abs(
                scalpel.beamPowerSensor.measuredPower -
                scalpel.laserSource.selectedPower
            ) <= scalpel.laserSource.selectedPower * scalpel.beamPowerSensor.maximumAllowedDeviation
        }
    }

    requirement def ThermalSafetyRequirement {
        subject scalpel : LaserScalpelSystem;

        require constraint {
            scalpel.treatmentSite.carbonizationLimit >
            scalpel.treatmentSite.vaporizationThreshold
        }
    }

    requirement def PlumeEvacuationRequirement {
        subject scalpel : LaserScalpelSystem;

        require constraint {
            scalpel.plumeEvacuation.nominalEvacuationFlow >= 30 [L/min]
        }
    }

    requirement def EmergencyStopRequirement {
        subject scalpel : LaserScalpelSystem;

        doc /* Activation of emergency stop shall disable laser emission and place the system in a fault state. */

        require constraint {
            scalpel.safetyController.emergencyStopPressed implies
            scalpel.safetyController.mode == SystemMode::fault
        }
    }

    satisfy PrimaryFunctionRequirement by LaserScalpelSystem;
    satisfy ControlledEmissionRequirement by LaserScalpelSystem::safetyController;
    satisfy OpticalPowerLimitRequirement by LaserScalpelSystem::laserSource;
    satisfy WavelengthRequirement by LaserScalpelSystem::laserSource;
    satisfy CoolingProtectionRequirement by LaserScalpelSystem::cooling;
    satisfy BeamAccuracyRequirement by LaserScalpelSystem::beamPowerSensor;
    satisfy ThermalSafetyRequirement by LaserScalpelSystem::treatmentSite;
    satisfy PlumeEvacuationRequirement by LaserScalpelSystem::plumeEvacuation;
    satisfy EmergencyStopRequirement by LaserScalpelSystem::safetyController;
}
