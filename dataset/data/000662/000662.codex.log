        part treatmentSite : TreatmentSite;

        connect mainsPower to powerSupply.acInput;
        connect powerSupply.regulatedOutput to laserSource.electricalInput;
        connect laserSource.opticalOutput to handpiece.beamInput;
        connect handpiece.beamOutput to treatmentBeam;
        connect handpiece.beamOutput to beamPowerSensor.sampledBeamInput;
        connect treatmentBeam to treatmentSite.appliedBeam;
        connect treatmentSite.plumeOutput to plumeIntake;
        connect plumeIntake to plumeEvacuation.intake;

        connect cooling.coolantSupply to laserSource.coolingIn;
        connect laserSource.coolingOut to cooling.coolantReturn;

        connect clinicianCommand to userInterface.statusInput;
        connect userInterface.commandOutput to safetyController.uiCommandInput;
        connect safetyController.sourceCommandOutput to laserSource.electricalInput;
        connect beamPowerSensor.sensorOutput to safetyController.beamSensorInput;
        connect safetyController.statusOutput to clinicianStatus;

        perform action initialize : InitializeScalpel {
            in keySwitchEnabled = safetyController.keySwitchEnabled;
            in interlockClosed = safetyController.interlockClosed;
            in coolingFlowVerified = safetyController.coolingFlowVerified;
            out ready;
        }

        perform action treatmentDelivery : DeliverLaserIncision {
            in selectedPower = laserSource.selectedPower;
            in exposureTime = 2 [s];
            in beamDiameter = handpiece.spotDiameterAtFocus;
            in wavelength = laserSource.nominalWavelength;
            out result;
        }

        exhibit state operationalBehavior : LaserScalpelOperationalStates;
    }

    requirement def PrimaryFunctionRequirement {
        subject scalpel : LaserScalpelSystem;

        require constraint {
            scalpel.primaryFunction ==
            "Generate, control, and deliver a focused surgical laser beam to cut or coagulate biological tissue while limiting unintended thermal injury."
        }
    }

    requirement def ControlledEmissionRequirement {
        subject scalpel : LaserScalpelSystem;

        doc /* Laser emission shall occur only when the system is armed, safety interlocks are closed, cooling flow is verified, and the clinician intentionally commands emission through the footswitch. */

        require constraint {
            scalpel.safetyController.interlockClosed and
            scalpel.safetyController.coolingFlowVerified and
            scalpel.safetyController.handpieceReady
        }
    }

    requirement def OpticalPowerLimitRequirement {
        subject scalpel : LaserScalpelSystem;

        require constraint {
            scalpel.laserSource.selectedPower <= scalpel.maximumTreatmentPower
        }
    }

    requirement def WavelengthRequirement {
        subject scalpel : LaserScalpelSystem;

        require constraint {
            scalpel.laserSource.nominalWavelength == scalpel.nominalTreatmentWavelength
        }
    }

    requirement def CoolingProtectionRequirement {
        subject scalpel : LaserScalpelSystem;

        require constraint {
            scalpel.cooling.nominalFlowRate >= scalpel.cooling.minimumSafeFlowRate
        }
    }

    requirement def BeamAccuracyRequirement {
        subject scalpel : LaserScalpelSystem;

        doc /* Measured optical power shall remain within ten percent of the commanded optical power during enabled emission. */

        require constraint {
            abs(
                scalpel.beamPowerSensor.measuredPower -
                scalpel.laserSource.selectedPower
            ) <= scalpel.laserSource.selectedPower * scalpel.beamPowerSensor.maximumAllowedDeviation
        }
    }

    requirement def ThermalSafetyRequirement {
        subject scalpel : LaserScalpelSystem;

        require constraint {
            scalpel.treatmentSite.carbonizationLimit >
            scalpel.treatmentSite.vaporizationThreshold
        }
    }

    requirement def PlumeEvacuationRequirement {
        subject scalpel : LaserScalpelSystem;

        require constraint {
            scalpel.plumeEvacuation.nominalEvacuationFlow >= 30 [L/min]
        }
    }

    requirement def EmergencyStopRequirement {
        subject scalpel : LaserScalpelSystem;

        doc /* Activation of emergency stop shall disable laser emission and place the system in a fault state. */

        require constraint {
            scalpel.safetyController.emergencyStopPressed implies
            scalpel.safetyController.mode == SystemMode::fault
        }
    }

    satisfy PrimaryFunctionRequirement by LaserScalpelSystem;
    satisfy ControlledEmissionRequirement by LaserScalpelSystem::safetyController;
    satisfy OpticalPowerLimitRequirement by LaserScalpelSystem::laserSource;
    satisfy WavelengthRequirement by LaserScalpelSystem::laserSource;
    satisfy CoolingProtectionRequirement by LaserScalpelSystem::cooling;
    satisfy BeamAccuracyRequirement by LaserScalpelSystem::beamPowerSensor;
    satisfy ThermalSafetyRequirement by LaserScalpelSystem::treatmentSite;
    satisfy PlumeEvacuationRequirement by LaserScalpelSystem::plumeEvacuation;
    satisfy EmergencyStopRequirement by LaserScalpelSystem::safetyController;
}
