    requirement def ControlledEmissionRequirement {
        subject scalpel : LaserScalpelSystem;

        doc /* Laser emission shall occur only when the system is armed, safety interlocks are closed, cooling flow is verified, and the clinician intentionally commands emission through the footswitch. */

        require constraint {
            scalpel.safetyController.interlockClosed and
            scalpel.safetyController.coolingFlowVerified and
            scalpel.safetyController.handpieceReady
        }
    }

