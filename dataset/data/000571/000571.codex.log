        out item agent : MicrobubbleContrastAgent;
    }

    port def PatientVascularPort {
        in item agent : MicrobubbleContrastAgent;
        in item pulse : UltrasoundPulse;
        out item echo : EchoSignal;
        out item physiology : PatientPhysiology;
