      in item incoming : Fluid;
      in attribute requestedFlowRate : microliterPerMinute;
      out item meteredFluid : Fluid;

      first startPump;
      then regulatePressure;
      then outputMeteredFluid;

      action startPump;
      action regulatePressure;
      action outputMeteredFluid;
    }
  }

