      in item sample : BiologicalSample;
      in item reagent : BufferReagent;
      out item mixture : Fluid;

      first admitSample;
      then admitReagent;
      then diffuseAndAdvect;
      then releaseMixture;

      action admitSample;
      action admitReagent;
      action diffuseAndAdvect;
      action releaseMixture;
    }
  }

