        :> scalar;
        unit = "degC";
    }

    item def LimbTissue {
        attribute circumference : Length;
        attribute tissueCompliance : Real;
        attribute distalBloodFlow : Real;
    }

    item def AppliedCompression {
        attribute radialPressure : Pressure;
        attribute circumferentialForce : Force;
        attribute applicationDuration : TimeDuration;
    }

    item def OperatorCommand {
        attribute tightenRequested : Boolean;
        attribute loosenRequested : Boolean;
        attribute releaseRequested : Boolean;
    }

