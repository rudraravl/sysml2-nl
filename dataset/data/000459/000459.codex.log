    requirement def PrimaryFunctionRequirement {
        doc
        /* The Impella-based ventricular assist system shall provide temporary mechanical circulatory support by drawing blood from the left ventricle and expelling it into the ascending aorta, thereby increasing forward cardiac output while continuously monitoring pump speed, pressure, purge integrity, flow estimate, and alarm conditions. */

        subject system : ImpellaBasedAssistSystem;

        require constraint {
            system.nominalAssistFlow >= 2.5 and system.nominalAssistFlow <= system.maximumAssistFlow
        }
    }

    requirement def FlowSupportRequirement {
        doc
        /* During active support, the system shall maintain estimated assist flow between 0.5 L/min and 5.0 L/min according to clinician-selected support level and measured hemodynamic load. */

        subject system : ImpellaBasedAssistSystem;

        require constraint {
            system.minimumOperatingFlow >= 0.5 and system.maximumAssistFlow <= 5.0
        }
    }

    requirement def PressureRiseRequirement {
        doc
        /* The pump catheter shall generate a positive pressure rise from ventricular inlet to aortic outlet whenever commanded speed is above the minimum operating speed. */

        subject pump : MicroAxialPumpCatheter;

        require constraint {
            pump.currentSpeed >= 10000.0 implies pump.generatedPressureRise > 0.0
        }
    }

    requirement def SpeedLimitRequirement {
        doc
        /* The controller shall constrain motor commands to the validated pump operating speed range. */

        subject system : ImpellaBasedAssistSystem;

        require constraint {
            system.controller.commandedSpeed >= system.minimumMotorSpeed and
            system.controller.commandedSpeed <= system.maximumMotorSpeed
        }
    }

    requirement def PurgeIntegrityRequirement {
        doc
        /* The purge subsystem shall maintain purge pressure within the configured safe range to reduce blood ingress into the motor region. */

        subject system : ImpellaBasedAssistSystem;

        require constraint {
            system.purgeSystem.purgePressure >= system.minimumPurgePressure and
            system.purgeSystem.purgePressure <= system.maximumPurgePressure
        }
    }

    requirement def ThermalSafetyRequirement {
        doc
        /* The controller and motor shall alarm and limit support when measured temperature exceeds the configured safety threshold. */

        subject system : ImpellaBasedAssistSystem;

        require constraint {
            system.controller.telemetryIn.telemetry.controllerTemperature <= system.maximumControllerTemperature
        }
    }

    requirement def AlarmRequirement {
        doc
        /* The alarm manager shall issue active visual and audible alarm signals for critical low-flow, suction, purge-pressure, power, and overtemperature hazards. */

        subject alarmManager : AlarmManager;

        require constraint {
            alarmManager.audibleEnabled == true and alarmManager.visualEnabled == true
        }
    }

    requirement def BackupPowerRequirement {
        doc
        /* The power subsystem shall provide at least 30 minutes of backup operation when external power is unavailable. */

        subject power : PowerSubsystem;

        require constraint {
            power.availableRuntimeOnBattery >= 1800.0
        }
    }

    satisfy PrimaryFunctionRequirement by ImpellaBasedAssistSystem;
    satisfy FlowSupportRequirement by ImpellaBasedAssistSystem;
    satisfy PressureRiseRequirement by MicroAxialPumpCatheter;
    satisfy SpeedLimitRequirement by BedsideController;
    satisfy PurgeIntegrityRequirement by PurgeSubsystem;
    satisfy ThermalSafetyRequirement by BedsideController;
    satisfy AlarmRequirement by AlarmManager;
    satisfy BackupPowerRequirement by PowerSubsystem;
