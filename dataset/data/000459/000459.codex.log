        attribute purgePressure : Pressure = 650.0;
        attribute purgeFlowRate : FlowRate = 0.03;
        attribute reservoirVolume : BloodVolume = 500.0;

        part purgeReservoir : PurgeReservoir;
        part purgePump : PurgePump;
        part pressureRegulator : PurgePressureRegulator;

        connect purgeReservoir.reservoirOut to purgePump.purgeIn;
        connect purgePump.purgeOut to pressureRegulator.regulatorIn;
        connect pressureRegulator.regulatorOut to purgeOut;
    }

    part def PurgeReservoir {
        port reservoirOut : PurgeFluidPort;
        attribute volumeRemaining : BloodVolume = 500.0;
    }

    part def PurgePump {
        port purgeIn : PurgeFluidPort;
        port purgeOut : PurgeFluidPort;
        attribute commandedPurgeFlow : FlowRate = 0.03;
    }

    part def PurgePressureRegulator {
        port regulatorIn : PurgeFluidPort;
        port regulatorOut : PurgeFluidPort;
        attribute targetPressure : Pressure = 650.0;
    }

    part def HemodynamicSensorSuite {
        port telemetryOut : TelemetryPort;

        attribute measuredInletPressure : Pressure;
        attribute measuredOutletPressure : Pressure;
        attribute measuredMotorCurrent : ElectricCurrent;
        attribute measuredMotorSpeed : RotationalSpeed;
        attribute measuredPurgePressure : Pressure;
        attribute estimatedAssistFlow : FlowRate;

        part inletPressureSensor : PressureSensor;
        part outletPressureSensor : PressureSensor;
        part motorCurrentSensor : CurrentSensor;
        part motorSpeedSensor : SpeedSensor;
        part purgePressureSensor : PressureSensor;
    }

    part def PressureSensor {
        attribute pressure : Pressure;
        attribute accuracy : Pressure = 2.0;
        attribute samplePeriod : TimeDuration = 0.01;
    }

    part def CurrentSensor {
        attribute current : ElectricCurrent;
        attribute accuracy : ElectricCurrent = 0.05;
        attribute samplePeriod : TimeDuration = 0.01;
    }

    part def SpeedSensor {
        attribute speed : RotationalSpeed;
        attribute accuracy : RotationalSpeed = 100.0;
        attribute samplePeriod : TimeDuration = 0.01;
    }

    part def AlarmManager {
        port alarmIn : AlarmPort;
        port alarmOut : AlarmPort;
        attribute audibleEnabled : Boolean = true;
        attribute visualEnabled : Boolean = true;
        attribute highestActiveSeverity : Integer = 0;

        perform action prioritizeAlarms;
    }

    action def assistNativeCardiacOutput {
        in item venousReturnBlood : Blood;
        out item augmentedAorticBlood : Blood;
        attribute requestedFlow : FlowRate;
        attribute achievedFlow : FlowRate;

        first start;
        then drawBloodFromLeftVentricle;
        then impartAxialMomentum;
        then dischargeBloodIntoAscendingAorta;
        then updateSystemTelemetry;
        then done;

        action drawBloodFromLeftVentricle {
            in item ventricularBlood : Blood;
            out item pumpInletBlood : Blood;
        }

        action impartAxialMomentum {
            in item pumpInletBlood : Blood;
            out item pressurizedBlood : Blood;
            attribute impellerSpeed : RotationalSpeed;
            attribute pressureRise : Pressure;
        }

        action dischargeBloodIntoAscendingAorta {
            in item pressurizedBlood : Blood;
            out item aorticBlood : Blood;
        }

        action updateSystemTelemetry {
            out item telemetry : SensorTelemetry;
        }
    }

    action def regulatePumpSpeed {
        in item command : MotorCommand;
        in item telemetry : SensorTelemetry;
        out item motorEnergy : ElectricalEnergy;
        attribute speedError : RotationalSpeed;
        attribute pressureDifferential : Pressure;
        attribute controllerGain : Real = 0.18;

        first readCommand;
        then evaluateHemodynamics;
        then computeTargetSpeed;
        then limitCommand;
        then energizeMotor;
        then done;

        action readCommand;
        action evaluateHemodynamics;
        action computeTargetSpeed;
        action limitCommand;
        action energizeMotor;
    }

    action def estimateAssistFlow {
        in item telemetry : SensorTelemetry;
        out attribute estimatedFlow : FlowRate;
        attribute pressureDifferential : Pressure;
        attribute motorLoad : ElectricCurrent;
    }

    action def detectHazards {
        in item telemetry : SensorTelemetry;
        out item alarm : AlarmSignal;

        first evaluateSuction;
        then evaluatePurgeIntegrity;
        then evaluateOvertemperature;
        then evaluateLowFlow;
        then publishAlarmState;
        then done;

        action evaluateSuction;
        action evaluatePurgeIntegrity;
        action evaluateOvertemperature;
        action evaluateLowFlow;
        action publishAlarmState;
    }

    action def prioritizeAlarms {
        in item alarmInput : AlarmSignal;
        out item alarmOutput : AlarmSignal;
    }

    state def PumpSupportStateMachine {
        entry action initializeController;

        state Off;
        state Priming;
        state Ready;
        state InsertionSupport;
        state ActiveSupport;
        state Weaning;
        state AlarmLimitedSupport;
        state EmergencyStop;

        transition first Off;

        transition Off_to_Priming
            first Off
            accept commandReceived
            if commandReceived.command.requestedSupportLevel == 0
            then Priming;

        transition Priming_to_Ready
            first Priming
            accept purgePressureStable
            if purgePressureStable.telemetry.purgePressure >= 300.0 and purgePressureStable.telemetry.purgePressure <= 1100.0
            then Ready;

        transition Ready_to_InsertionSupport
            first Ready
            accept clinicianStart
            if clinicianStart.command.requestedSupportLevel >= 1
            then InsertionSupport;

        transition InsertionSupport_to_ActiveSupport
            first InsertionSupport
            accept placementConfirmed
            if placementConfirmed.telemetry.bloodFlowEstimate >= 0.5
            then ActiveSupport;

        transition ActiveSupport_to_Weaning
            first ActiveSupport
            accept reduceSupport
            if reduceSupport.command.requestedSupportLevel <= 2
            then Weaning;

        transition Weaning_to_ActiveSupport
            first Weaning
            accept increaseSupport
            if increaseSupport.command.requestedSupportLevel > 2
            then ActiveSupport;

        transition ActiveSupport_to_AlarmLimitedSupport
            first ActiveSupport
            accept hazardDetected
            if hazardDetected.alarm.severity >= 2
            then AlarmLimitedSupport;

        transition AlarmLimitedSupport_to_ActiveSupport
            first AlarmLimitedSupport
            accept hazardCleared
            if hazardCleared.alarm.active == false
            then ActiveSupport;

        transition AlarmLimitedSupport_to_EmergencyStop
            first AlarmLimitedSupport
            accept criticalHazard
            if criticalHazard.alarm.severity >= 4
            then EmergencyStop;

        transition ActiveSupport_to_EmergencyStop
            first ActiveSupport
            accept stopCommand
            if stopCommand.command.requestedSupportLevel == 0
            then EmergencyStop;
    }

    requirement def PrimaryFunctionRequirement {
        doc
        /* The Impella-based ventricular assist system shall provide temporary mechanical circulatory support by drawing blood from the left ventricle and expelling it into the ascending aorta, thereby increasing forward cardiac output while continuously monitoring pump speed, pressure, purge integrity, flow estimate, and alarm conditions. */

        subject system : ImpellaBasedAssistSystem;

        require constraint {
            system.nominalAssistFlow >= 2.5 and system.nominalAssistFlow <= system.maximumAssistFlow
        }
    }

    requirement def FlowSupportRequirement {
        doc
        /* During active support, the system shall maintain estimated assist flow between 0.5 L/min and 5.0 L/min according to clinician-selected support level and measured hemodynamic load. */

        subject system : ImpellaBasedAssistSystem;

        require constraint {
            system.minimumOperatingFlow >= 0.5 and system.maximumAssistFlow <= 5.0
        }
    }

    requirement def PressureRiseRequirement {
        doc
        /* The pump catheter shall generate a positive pressure rise from ventricular inlet to aortic outlet whenever commanded speed is above the minimum operating speed. */

        subject pump : MicroAxialPumpCatheter;

        require constraint {
            pump.currentSpeed >= 10000.0 implies pump.generatedPressureRise > 0.0
        }
    }

    requirement def SpeedLimitRequirement {
        doc
        /* The controller shall constrain motor commands to the validated pump operating speed range. */

        subject system : ImpellaBasedAssistSystem;

        require constraint {
            system.controller.commandedSpeed >= system.minimumMotorSpeed and
            system.controller.commandedSpeed <= system.maximumMotorSpeed
        }
    }

    requirement def PurgeIntegrityRequirement {
        doc
        /* The purge subsystem shall maintain purge pressure within the configured safe range to reduce blood ingress into the motor region. */

        subject system : ImpellaBasedAssistSystem;

        require constraint {
            system.purgeSystem.purgePressure >= system.minimumPurgePressure and
            system.purgeSystem.purgePressure <= system.maximumPurgePressure
        }
    }

    requirement def ThermalSafetyRequirement {
        doc
        /* The controller and motor shall alarm and limit support when measured temperature exceeds the configured safety threshold. */

        subject system : ImpellaBasedAssistSystem;

        require constraint {
            system.controller.telemetryIn.telemetry.controllerTemperature <= system.maximumControllerTemperature
        }
    }

    requirement def AlarmRequirement {
        doc
        /* The alarm manager shall issue active visual and audible alarm signals for critical low-flow, suction, purge-pressure, power, and overtemperature hazards. */

        subject alarmManager : AlarmManager;

        require constraint {
            alarmManager.audibleEnabled == true and alarmManager.visualEnabled == true
        }
    }

    requirement def BackupPowerRequirement {
        doc
        /* The power subsystem shall provide at least 30 minutes of backup operation when external power is unavailable. */

        subject power : PowerSubsystem;

        require constraint {
            power.availableRuntimeOnBattery >= 1800.0
        }
    }

    satisfy PrimaryFunctionRequirement by ImpellaBasedAssistSystem;
    satisfy FlowSupportRequirement by ImpellaBasedAssistSystem;
    satisfy PressureRiseRequirement by MicroAxialPumpCatheter;
    satisfy SpeedLimitRequirement by BedsideController;
    satisfy PurgeIntegrityRequirement by PurgeSubsystem;
    satisfy ThermalSafetyRequirement by BedsideController;
    satisfy AlarmRequirement by AlarmManager;
    satisfy BackupPowerRequirement by PowerSubsystem;
}
