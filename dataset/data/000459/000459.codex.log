        entry action initializeController;

        state Off;
        state Priming;
        state Ready;
        state InsertionSupport;
        state ActiveSupport;
        state Weaning;
        state AlarmLimitedSupport;
        state EmergencyStop;

        transition first Off;

        transition Off_to_Priming
            first Off
            accept commandReceived
            if commandReceived.command.requestedSupportLevel == 0
            then Priming;

        transition Priming_to_Ready
            first Priming
            accept purgePressureStable
            if purgePressureStable.telemetry.purgePressure >= 300.0 and purgePressureStable.telemetry.purgePressure <= 1100.0
            then Ready;

        transition Ready_to_InsertionSupport
