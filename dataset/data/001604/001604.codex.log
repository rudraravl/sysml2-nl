            transition resetAfterEmergencyStop
                first emergencyStopped then idle
                if not safetyController.emergencyStopLatched;
        }
    }

    part def MobilityBase {
        attribute leftWheelVelocity : MeterPerSecond;
        attribute rightWheelVelocity : MeterPerSecond;
        attribute odometryLinearVelocity : MeterPerSecond;
        attribute odometryAngularVelocity : Degree;
        attribute obstacleClearanceM : Real;
        attribute tractionLimitPercent : Percent = 85.0;

        port commandIn : CommandInPort;
        port telemetryOut : TelemetryOutPort;
        port powerIn : PowerLoadPort;

        action drive {
            in velocityCommand : CommandPacket;
            out measuredMotion : TelemetryPacket;
        }
    }

    part def RoboticManipulator {
        attribute jointPosition : Degree[6];
        attribute jointTorque : NewtonMeter[6];
        attribute gripperOpening : Percent;
        attribute endEffectorLoadKg : Real;
