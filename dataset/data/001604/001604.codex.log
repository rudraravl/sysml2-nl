        }

        part depthSensor {
            attribute rangeM : Real = 8.0;
            attribute depthAccuracyM : Real = 0.03;
        }

        part lidar {
            attribute scanRateHz : Real = 10.0;
            attribute rangeM : Real = 30.0;
        }

        action acquireSceneData {
            out frame : VideoFrame;
