            in joystickX : Percent;
            in joystickY : Percent;
            in joystickRotation : Percent;
            in desiredJointAngles : Degree[6];
            in desiredGripperOpening : Percent;
            out command : CommandPacket;
        }

        action displayRemoteSituation {
            in frame : VideoFrame;
            in telemetry : TelemetryPacket;
            in diagnostic : DiagnosticEvent;
        }
    }

    part def CommunicationsLink {
        attribute state : LinkStateKind = LinkStateKind::disconnected;
        attribute uplinkBandwidth : MegabitPerSecond = 8.0;
        attribute downlinkBandwidth : MegabitPerSecond = 20.0;
        attribute roundTripLatency : Millisecond;
        attribute packetLossRate : Percent;
        attribute encryptionEnabled : Boolean = true;

        port commandFromConsole : CommandInPort;
        port commandToRobot : CommandOutPort;
        port telemetryFromRobot : TelemetryInPort;
        port telemetryToConsole : TelemetryOutPort;
        port videoFromRobot : VideoInPort;
        port videoToConsole : VideoOutPort;
        port hapticFromRobot : HapticInPort;
        port hapticToConsole : HapticOutPort;
        port diagnosticFromRobot : DiagnosticInPort;
        port diagnosticToConsole : DiagnosticOutPort;

        action routeCommand {
            in operatorCommand : CommandPacket;
            out robotCommand : CommandPacket;
        }

        action routeFeedback {
            in robotTelemetry : TelemetryPacket;
            in robotVideo : VideoFrame;
            in robotHaptic : HapticFeedback;
            out consoleTelemetry : TelemetryPacket;
            out consoleVideo : VideoFrame;
            out consoleHaptic : HapticFeedback;
        }

        state def LinkManagement {
            state disconnected;
            state acquiring;
            state nominal;
            state degraded;
            state lost;

            transition first disconnected;
            transition disconnected_to_acquiring
                first disconnected then acquiring;

            transition acquiring_to_nominal
                first acquiring then nominal
                if roundTripLatency <= 150.0 and packetLossRate <= 2.0;

            transition nominal_to_degraded
                first nominal then degraded
                if roundTripLatency > 150.0 or packetLossRate > 2.0;

            transition degraded_to_nominal
                first degraded then nominal
                if roundTripLatency <= 150.0 and packetLossRate <= 2.0;

            transition degraded_to_lost
                first degraded then lost
                if packetLossRate >= 25.0;

            transition nominal_to_lost
                first nominal then lost
                if packetLossRate >= 25.0;

            transition lost_to_acquiring
                first lost then acquiring;
        }
    }

    part def MobileManipulatorRobot {
        attribute missionState : RobotMissionStateKind = RobotMissionStateKind::poweredOff;
        attribute maximumLinearVelocity : MeterPerSecond = 2.0;
        attribute safeLinearVelocity : MeterPerSecond = 0.4;
        attribute maximumPayloadMassKg : Real = 8.0;

        port commandIn : CommandInPort;
        port telemetryOut : TelemetryOutPort;
        port videoOut : VideoOutPort;
        port hapticOut : HapticOutPort;
        port diagnosticOut : DiagnosticOutPort;
        port powerIn : PowerLoadPort;

        part mobilityBase : MobilityBase;
        part manipulator : RoboticManipulator;
        part perception : PerceptionSuite;
        part onboardComputer : OnboardControlComputer;
        part safetyController : SafetyController;
        part powerSystem : RobotPowerSystem;

