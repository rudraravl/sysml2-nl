                first teleoperated then autonomousAssist;

            transition disableAssist
                first autonomousAssist then teleoperated;

            transition faultDetectedFromIdle
                first idle then faulted;

            transition faultDetectedFromTeleoperation
                first teleoperated then faulted;

            transition faultDetectedFromAssist
                first autonomousAssist then faulted;

            transition emergencyStopFromAnyOperation
                first teleoperated then emergencyStopped
                if safetyController.emergencyStopLatched;

            transition emergencyStopFromAssist
                first autonomousAssist then emergencyStopped
                if safetyController.emergencyStopLatched;

            transition resetAfterFault
                first faulted then idle
                if not safetyController.faultLatched;

            transition resetAfterEmergencyStop
                first emergencyStopped then idle
                if not safetyController.emergencyStopLatched;
        }
    }

    part def MobilityBase {
        attribute leftWheelVelocity : MeterPerSecond;
        attribute rightWheelVelocity : MeterPerSecond;
        attribute odometryLinearVelocity : MeterPerSecond;
        attribute odometryAngularVelocity : Degree;
        attribute obstacleClearanceM : Real;
        attribute tractionLimitPercent : Percent = 85.0;

        port commandIn : CommandInPort;
        port telemetryOut : TelemetryOutPort;
        port powerIn : PowerLoadPort;

        action drive {
            in velocityCommand : CommandPacket;
            out measuredMotion : TelemetryPacket;
        }
    }

    part def RoboticManipulator {
        attribute jointPosition : Degree[6];
        attribute jointTorque : NewtonMeter[6];
        attribute gripperOpening : Percent;
        attribute endEffectorLoadKg : Real;
        attribute workspaceLimitRadiusM : Real = 1.2;

        port commandIn : CommandInPort;
        port telemetryOut : TelemetryOutPort;
        port hapticOut : HapticOutPort;
        port powerIn : PowerLoadPort;

        action moveJoints {
            in jointTargets : Degree[6];
            in gripperTarget : Percent;
            out measuredJointPositions : Degree[6];
            out contactFeedback : HapticFeedback;
        }
    }

    part def PerceptionSuite {
        attribute frontCameraHealthy : Boolean = true;
        attribute depthCameraHealthy : Boolean = true;
        attribute lidarHealthy : Boolean = true;
        attribute measuredObstacleDistanceM : Real;
        attribute illuminationLevelLux : Real;

        port videoOut : VideoOutPort;
        port telemetryOut : TelemetryOutPort;
        port powerIn : PowerLoadPort;

        part frontCamera {
            attribute horizontalFieldOfViewDeg : Degree = 90.0;
            attribute verticalFieldOfViewDeg : Degree = 60.0;
            attribute frameRateHz : Real = 30.0;
            attribute resolutionWidth : Integer = 1920;
            attribute resolutionHeight : Integer = 1080;
        }

        part depthSensor {
            attribute rangeM : Real = 8.0;
            attribute depthAccuracyM : Real = 0.03;
        }

        part lidar {
            attribute scanRateHz : Real = 10.0;
            attribute rangeM : Real = 30.0;
        }

        action acquireSceneData {
            out frame : VideoFrame;
            out obstacleDistanceM : Real;
        }
    }

    part def OnboardControlComputer {
        attribute processorLoad : Percent;
        attribute commandAge : Millisecond;
        attribute autonomyMode : AutonomyModeKind = AutonomyModeKind::manual;
        attribute watchdogTimeout : Millisecond = 500.0;

        port commandIn : CommandInPort;
        port telemetryIn : TelemetryInPort;
        port commandToMobility : CommandOutPort;
        port commandToManipulator : CommandOutPort;
        port diagnosticOut : DiagnosticOutPort;

        action validateAndDistributeCommand {
            in command : CommandPacket;
            in obstacleDistanceM : Real;
            out mobilityCommand : CommandPacket;
            out manipulatorCommand : CommandPacket;
            out diagnostic : DiagnosticEvent;
        }
    }

    part def SafetyController {
        attribute emergencyStopLatched : Boolean = false;
        attribute faultLatched : Boolean = false;
        attribute minimumObstacleClearanceM : Real = 0.5;
        attribute maximumAllowedLatency : Millisecond = 300.0;
        attribute maximumInternalTemperature : Celsius = 70.0;

        port commandIn : CommandInPort;
        port telemetryIn : TelemetryInPort;
        port diagnosticOut : DiagnosticOutPort;

        action evaluateSafety {
            in command : CommandPacket;
            in telemetry : TelemetryPacket;
            out safeCommand : CommandPacket;
            out event : DiagnosticEvent;
        }
    }

    part def RobotPowerSystem {
        attribute nominalVoltage : Volt = 48.0;
        attribute batteryCapacity : AmpereHour = 60.0;
        attribute stateOfCharge : Percent;
        attribute powerBusHealthy : Boolean = true;

        port powerOut : PowerSourcePort;
        port diagnosticOut : DiagnosticOutPort;

        action managePower {
            out power : PowerFlow;
            out diagnostic : DiagnosticEvent;
        }
    }

    part def TeleroboticsSystem {
        doc /* Primary function: enable a human operator to perceive, command, and safely control a remote mobile manipulator through a communication link while receiving real-time video, telemetry, haptic feedback, and diagnostic status. */

        attribute operatingRangeKm : Real = 5.0;
        attribute requiredAvailability : Percent = 99.0;
        attribute maximumPermittedRoundTripLatency : Millisecond = 300.0;
        attribute minimumVideoFrameRateHz : Real = 15.0;

        part operatorConsole : OperatorConsole;
        part communicationsLink : CommunicationsLink;
        part robot : MobileManipulatorRobot;

        connect operatorConsole.commandOut to communicationsLink.commandFromConsole;
        connect communicationsLink.commandToRobot to robot.commandIn;

        connect robot.telemetryOut to communicationsLink.telemetryFromRobot;
        connect communicationsLink.telemetryToConsole to operatorConsole.telemetryIn;

        connect robot.videoOut to communicationsLink.videoFromRobot;
        connect communicationsLink.videoToConsole to operatorConsole.videoIn;

        connect robot.hapticOut to communicationsLink.hapticFromRobot;
        connect communicationsLink.hapticToConsole to operatorConsole.hapticIn;

        connect robot.diagnosticOut to communicationsLink.diagnosticFromRobot;
        connect communicationsLink.diagnosticToConsole to operatorConsole.diagnosticIn;

        perform action remoteManipulationMission {
            in operatorIntent : CommandPacket;
            out situationalAwareness : VideoFrame;
            out robotStatus : TelemetryPacket;
            out contactCue : HapticFeedback;

            first start;
            then sendCommand;
            then transmitCommand;
            then validateCommand;
            then actuateRobot;
            then senseEnvironment;
            then returnFeedback;
            then updateOperatorAwareness;
            then done;

            action sendCommand : operatorConsole.composeOperatorCommand;
            action transmitCommand : communicationsLink.routeCommand;
            action validateCommand : robot.onboardComputer.validateAndDistributeCommand;
            action actuateRobot : robot.executeRemoteOperation;
            action senseEnvironment : robot.perception.acquireSceneData;
            action returnFeedback : communicationsLink.routeFeedback;
            action updateOperatorAwareness : operatorConsole.displayRemoteSituation;
        }
    }

    requirement def PrimaryFunctionRequirement {
        doc /* The telerobotics system shall allow a remote human operator to command robot mobility and manipulation while receiving sufficient real-time feedback to maintain situational awareness and safe control. */
        subject system : TeleroboticsSystem;

        require constraint {
            system.maximumPermittedRoundTripLatency <= 300.0
        }

        require constraint {
            system.minimumVideoFrameRateHz >= 15.0
        }
    }

    requirement def SafeStopRequirement {
        doc /* The robot shall enter a safe stopped condition when an emergency stop command is received, when communication is lost, or when critical safety limits are exceeded. */
        subject robot : MobileManipulatorRobot;

        require constraint {
            robot.safetyController.maximumAllowedLatency <= 300.0
        }

        require constraint {
            robot.safetyController.minimumObstacleClearanceM >= 0.5
        }
    }

    requirement def FeedbackRequirement {
        doc /* The system shall provide visual, telemetry, diagnostic, and haptic feedback to the operator during remote manipulation. */
        subject system : TeleroboticsSystem;

        require constraint {
            system.communicationsLink.downlinkBandwidth >= 20.0
        }
    }

    requirement def CommandIntegrityRequirement {
        doc /* Operator commands shall be validated before actuation to enforce velocity limits, workspace limits, obstacle clearance, and emergency stop priority. */
        subject computer : OnboardControlComputer;

        require constraint {
            computer.watchdogTimeout <= 500.0
        }
    }

    requirement def PowerEnduranceRequirement {
        doc /* The robot power system shall support sustained remote operation with monitored state of charge and diagnostic reporting. */
        subject power : RobotPowerSystem;

        require constraint {
            power.nominalVoltage == 48.0
        }

        require constraint {
            power.batteryCapacity >= 60.0
        }
    }

    satisfy PrimaryFunctionRequirement by TeleroboticsSystem;
    satisfy SafeStopRequirement by MobileManipulatorRobot;
    satisfy FeedbackRequirement by TeleroboticsSystem;
    satisfy CommandIntegrityRequirement by OnboardControlComputer;
    satisfy PowerEnduranceRequirement by RobotPowerSystem;
}
