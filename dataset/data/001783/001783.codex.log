            out attribute injectionAngle : Angle;

            objective {
                fuelMassPerCycle == manifoldPressure * throttlePosition / targetAirFuelRatio;
                pulseWidth == fuelMassPerCycle / railPressure;
                injectionAngle == 360.0;
            }
        }
    }

