                first opening
                then injecting;

            transition injecting_to_closing
                first injecting
                then closing
                accept ControlSignal
                if commandValue <= 0.0;

            transition closing_to_closed
                first closing
                then closed;

            transition any_to_faulted
                first closed
                then faulted
                if injectionPressure < 2500.0;
        }
