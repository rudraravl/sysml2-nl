    attribute pressure : PressureValue;
    attribute temperature : TemperatureValue;
    attribute contaminationLevel : PercentageValue;
  }

  item def AtomizedSpray {
    attribute coneAngle : Real;
    attribute meanDropletDiameter : Real;
    attribute flowRate : FlowRateValue;
