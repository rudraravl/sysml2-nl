    attribute requestedPulseWidth : DurationValue;
    attribute requestedFlowRate : FlowRateValue;
    attribute enable : Boolean;
  }

  item def InjectionStatus {
    attribute valveOpen : Boolean;
    attribute measuredPressure : PressureValue;
    attribute deliveredVolume : VolumeValue;
    attribute faultActive : Boolean;
