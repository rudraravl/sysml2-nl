            out attribute coolingAvailable : Boolean;
        }
    }

    part def ScannerController {
        port prescriptionPort : PrescriptionPort;
        port gradientCommandPort : GradientCommandPort;
        port rfTransmitPort : RFTransmitPort;
        port safetyStatusPort : SafetyStatusPort;
        port kspacePort : KSpacePort;

        attribute scanState : String;
        attribute interlocksSatisfied : Boolean;
