        }
    }

    part def MRI_System {
        port patientTransferPort : PatientTransferPort;
        port imageOutputPort : ImagePort;
        port facilityPowerPort : PowerPort;

        part table : PatientTable;
        part magnet : MainMagnet;
        part shim : ShimSystem;
        part gradients : GradientSubsystem;
        part rf : RFSubsystem;
        part monitoring : PatientMonitoringSystem;
        part cooling : CoolingSystem;
        part controller : ScannerController;
        part acquisition : DataAcquisitionSystem;
        part reconstruction : ImageReconstructionSystem;
        part console : OperatorConsole;

        attribute primaryFunction : String =
            "Acquire anatomically localized magnetic resonance signals from hydrogen nuclei in a patient and reconstruct non-invasive diagnostic images of the prescribed body region.";
        attribute installedFieldStrength : MagneticFluxDensity = 3.0 [SI::tesla];
        attribute maximumSAR : SpecificAbsorptionRate = 3.2;
        attribute minimumImageResolution : ImageResolution = 0.7;
        attribute maximumPatientMass : PatientMass = 250 [SI::kilogram];

        connect patientTransferPort to table.transferPort;
        connect facilityPowerPort to table.powerPort;
        connect facilityPowerPort to magnet.powerPort;
        connect facilityPowerPort to shim.powerPort;
        connect facilityPowerPort to gradients.powerPort;
        connect facilityPowerPort to rf.powerPort;
        connect facilityPowerPort to cooling.powerPort;
        connect facilityPowerPort to acquisition.powerPort;
        connect facilityPowerPort to reconstruction.powerPort;

        connect cooling.gradientCoolingPort to gradients.coolingPort;
        connect cooling.rfCoolingPort to rf.coolingPort;
        connect cooling.cryogenPort to magnet.cryogenPort;

        connect console.prescriptionPort to controller.prescriptionPort;
        connect controller.gradientCommandPort to gradients.commandPort;
        connect controller.rfTransmitPort to rf.transmitPort;
        connect rf.receivePort to acquisition.receivePort;
        connect acquisition.kspacePort to controller.kspacePort;
        connect acquisition.kspacePort to reconstruction.kspacePort;
        connect reconstruction.imagePort to console.imagePort;
        connect reconstruction.imagePort to imageOutputPort;
        connect monitoring.safetyStatusPort to controller.safetyStatusPort;

        action performDiagnosticMRScan {
            in item patient : Patient;
            in item prescription : ScanPrescription;
            out item image : MRImage;

            first start;
            then validate;

            action validate {
                out attribute accepted : Boolean;
            }

            then position;
            action position {
                out attribute positioned : Boolean;
            }

            then acquire;
            action acquire {
                out item rawData : RawKSpaceData;
            }

            then reconstruct;
            action reconstruct {
                out item reconstructedImage : MRImage;
            }

            then complete;
        }

        state def OperationalState {
            state poweredOff;
            state standby;
            state patientSetup;
            state safetyCheck;
            state shimming;
            state scanning;
            state reconstructing;
            state imageReview;
            state emergencyStop;

            transition initial then poweredOff;
            transition powerApplied first poweredOff then standby;
            transition patientLoaded first standby then patientSetup;
            transition setupComplete first patientSetup then safetyCheck;
            transition interlocksClosed first safetyCheck then shimming;
            transition shimComplete first shimming then scanning;
            transition acquisitionComplete first scanning then reconstructing;
            transition reconstructionComplete first reconstructing then imageReview;
            transition newScanRequested first imageReview then safetyCheck;
            transition patientRemoved first imageReview then standby;
            transition emergencyDetected first standby then emergencyStop;
            transition emergencyDetected first patientSetup then emergencyStop;
            transition emergencyDetected first safetyCheck then emergencyStop;
            transition emergencyDetected first shimming then emergencyStop;
            transition emergencyDetected first scanning then emergencyStop;
            transition emergencyDetected first reconstructing then emergencyStop;
            transition resetAfterEmergency first emergencyStop then standby;
        }
    }

    requirement def PrimaryFunctionRequirement {
        subject mri : MRI_System;
        doc
        /*
         * The MRI system shall non-invasively produce diagnostic cross-sectional images
         * of a prescribed patient anatomy by generating a stable static magnetic field,
         * applying controlled gradient and radio-frequency fields, receiving magnetic
         * resonance signals, and reconstructing those signals into image data.
         */
    }

    requirement def StaticFieldRequirement {
        subject magnet : MainMagnet;
        attribute requiredField : MagneticFluxDensity = 3.0 [SI::tesla];

        require constraint {
            magnet.nominalFieldStrength == requiredField
        }
    }

    requirement def PatientSafetyRequirement {
        subject system : MRI_System;
        attribute sarLimit : SpecificAbsorptionRate = 3.2;

        require constraint {
            system.rf.measuredSAR <= sarLimit and
            system.monitoring.motionDetected == false
        }
    }

    requirement def ImplantScreeningRequirement {
        subject patient : Patient;

        require constraint {
            patient.hasFerromagneticImplant == false
        }
    }

    requirement def GradientPerformanceRequirement {
        subject gradients : GradientSubsystem;
        attribute minimumGradientStrength : MagneticFieldGradient = 40.0;

        require constraint {
            gradients.maximumGradientStrength >= minimumGradientStrength
        }
    }

    requirement def CoolingAvailabilityRequirement {
        subject cooling : CoolingSystem;
        attribute minimumFlow : FlowRate = 25.0;
        attribute maximumSupplyTemperature : Temperature = 22.0 [SI::degreeCelsius];

        require constraint {
            cooling.chilledWaterFlow >= minimumFlow and
            cooling.supplyTemperature <= maximumSupplyTemperature
        }
    }

    requirement def ImageQualityRequirement {
        subject image : MRImage;
        attribute maximumVoxelDimension : ImageResolution = 1.0;

        require constraint {
            image.inPlaneResolution <= maximumVoxelDimension and
            image.sliceThickness <= 5.0
        }
    }

    requirement def PatientTableCapacityRequirement {
        subject table : PatientTable;
        attribute requiredCapacity : PatientMass = 250 [SI::kilogram];

        require constraint {
            table.maximumPatientMass >= requiredCapacity
        }
    }

    satisfy PrimaryFunctionRequirement by MRI_System;
    satisfy StaticFieldRequirement by MainMagnet;
    satisfy PatientSafetyRequirement by MRI_System;
    satisfy GradientPerformanceRequirement by GradientSubsystem;
    satisfy CoolingAvailabilityRequirement by CoolingSystem;
    satisfy PatientTableCapacityRequirement by PatientTable;
}
