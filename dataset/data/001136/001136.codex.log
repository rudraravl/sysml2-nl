        attribute sampleRate : ScalarValues::Real;
        attribute dynamicRange : ScalarValues::Real;

        action digitizeSignal {
            in item signal : MRSignal;
            out item kspace : RawKSpaceData;
        }
    }

    part def ImageReconstructionSystem {
        port kspacePort : KSpacePort;
        port imagePort : ImagePort;
        port powerPort : PowerPort;

        attribute reconstructionAlgorithm : String = "parallel Fourier reconstruction with coil sensitivity correction";
