    subject console : ECMOConsole;

    require constraint {
      console.nominalBloodFlow >= 1.0 [SI::litre / SI::minute] and
      console.nominalBloodFlow <= 7.0 [SI::litre / SI::minute]
    }
  }

  requirement def OxygenationRequirement {
    subject console : ECMOConsole;

    require constraint {
      console.nominalPostOxygenatorSaturation >= 95 [SI::percent]
    }
  }

  requirement def PressureSafetyRequirement {
    subject controller : Controller;

    require constraint {
      controller.minimumVenousPressure >= -100 [SI::millimetreOfMercury] and
      controller.maximumArterialPressure <= 400 [SI::millimetreOfMercury]
    }
  }

  requirement def GasControlRequirement {
    subject console : ECMOConsole;

    require constraint {
      console.nominalSweepGasFlow >= 0.5 [SI::litre / SI::minute] and
      console.nominalSweepGasFlow <= 15.0 [SI::litre / SI::minute]
    }
  }

  requirement def ThermalManagementRequirement {
    subject exchanger : HeatExchanger;

    require constraint {
      exchanger.setPointTemperature >= 35.0 [SI::degreeCelsius] and
      exchanger.setPointTemperature <= 38.0 [SI::degreeCelsius]
    }
  }

  requirement def AlarmRequirement {
    subject console : ECMOConsole;

    require constraint {
      console.controller.minimumVenousPressure < 0 [SI::millimetreOfMercury] and
      console.controller.maximumArterialPressure > 0 [SI::millimetreOfMercury]
    }
  }

  satisfy PrimaryFunctionRequirement by ExtracorporealMembraneOxygenationSystem;
  satisfy BloodFlowRequirement by ECMOConsole;
  satisfy OxygenationRequirement by ECMOConsole;
  satisfy GasControlRequirement by ECMOConsole;
  satisfy PressureSafetyRequirement by Controller;
  satisfy ThermalManagementRequirement by HeatExchanger;
  satisfy AlarmRequirement by ECMOConsole;

}
