        transition synchronized_to_overspeedFault
            first synchronized
            if rotorSpeed > 25200.0
            then overspeedFault;

        transition synchronized_to_underspeedFault
            first synchronized
            if rotorSpeed < 22800.0
            then underspeedFault;

