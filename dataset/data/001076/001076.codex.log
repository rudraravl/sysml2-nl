        port motionIn : MotionInputPort;
        port spinStateIn {
            in item spin : SpinState;
        }
        port rawMeasurementOut {
            out item measuredMotion : AngularMotion;
        }

        attribute measurementRange : AngularRate = 8.73;
        attribute noiseDensity : Real {
            unit = "rad/s/sqrt(Hz)";
        } = 0.00008;
        attribute scaleFactorError : DimensionlessRatio = 0.002;
        attribute biasRate : AngularRate = 0.00035;

        part pickoffElectronics : PickoffElectronics;
        part temperatureSensor : TemperatureSensor;
    }

    part def PickoffElectronics {
        attribute samplePeriod : TimeInterval = 0.001;
        attribute analogBandwidth : Real {
            unit = "Hz";
        } = 250.0;
        attribute quantizationResolution : Integer = 16;
    }

    part def TemperatureSensor {
        attribute measuredTemperature : Temperature;
        attribute accuracy : Temperature = 1.0;
    }

    part def GyroSignalProcessor {
        port powerIn : PowerInputPort;
        port measurementIn {
            in item measuredMotion : AngularMotion;
        }
        port orientationOut : OrientationOutputPort;
        port processingHealthOut {
            out item processingHealth : HealthStatus;
        }
        port controlIn : ControlPort;

        attribute integrationStep : TimeInterval = 0.001;
        attribute filterTimeConstant : TimeInterval = 0.05;
        attribute estimatedRoll : Angle;
        attribute estimatedPitch : Angle;
        attribute estimatedYaw : Angle;
        attribute confidence : DimensionlessRatio;

        action calibrateBias {
            in item stationaryMotion : AngularMotion;
            out attribute rollBias : AngularRate;
            out attribute pitchBias : AngularRate;
            out attribute yawBias : AngularRate;
        }

        action integrateAngularRate {
            in item correctedMotion : AngularMotion;
            in attribute step : TimeInterval;
            out item estimate : OrientationEstimate;
        }

        action filterNoise {
            in item unfilteredMotion : AngularMotion;
            out item filteredMotion : AngularMotion;
        }
    }

    part def HealthMonitor {
        port powerIn : PowerInputPort;
        port spinStateIn {
            in item spin : SpinState;
        }
        port processorHealthIn {
            in item processingHealth : HealthStatus;
        }
        port healthOut : HealthOutputPort;

        attribute undervoltageLimit : Voltage = 4.75;
        attribute overtemperatureLimit : Temperature = 85.0;
        attribute minimumReadySpeed : RotationalSpeed = 23500.0;
        attribute maximumReadySpeed : RotationalSpeed = 24500.0;

        action evaluateHealth {
            in item spin : SpinState;
            out item health : HealthStatus;
        }
    }

    action def InitializeGyroscope {
        in item suppliedPower : ElectricalPower;
        out item initializedHealth : HealthStatus;

        first startPowerRegulation;
        then spinRotor;
        then calibrateSensorBias;
        then reportReady;

        action startPowerRegulation;
        action spinRotor;
        action calibrateSensorBias;
        action reportReady;
    }

    action def EstimateOrientation {
        in item bodyAngularMotion : AngularMotion;
        out item orientation : OrientationEstimate;

        first acquireMotionSample;
        then compensateBiasAndScale;
        then integrateRates;
        then publishOrientation;

        action acquireMotionSample;
        action compensateBiasAndScale;
        action integrateRates;
        action publishOrientation;
    }

    state def RotorStateMachine {
        entry action clearRotorFault;

