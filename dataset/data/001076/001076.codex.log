        transition unpowered_to_initializing
            first unpowered
            if powerIn.power.voltage >= 4.75
            then initializing;

        transition initializing_to_calibrating
            first initializing
            if rotorAssembly.rotorSpeed >= 23500.0
            then calibrating;

        transition calibrating_to_ready
            first calibrating
            if signalProcessor.confidence >= 0.95
            then ready;

        transition ready_to_measuring
            first ready
            accept enableCommand
            then measuring;

        transition measuring_to_degraded
            first measuring
            if healthMonitor.minimumReadySpeed > rotorAssembly.rotorSpeed
            then degraded;

        transition degraded_to_measuring
            first degraded
            if rotorAssembly.rotorSpeed >= 23500.0 and signalProcessor.confidence >= 0.90
            then measuring;

        transition any_to_failed_by_temperature
            first measuring
            if rotorAssembly.bearingSet.temperature > 95.0
            then failed;

        transition failed_to_initializing
            first failed
            accept resetCommand
            then initializing;
    }

    requirement def PrimaryFunctionRequirement {
        doc
        /*
         * The system shall convert sensed angular motion into a stable orientation
         * estimate about roll, pitch, and yaw axes for use by a host controller.
         */

        subject gyro : GyroscopeSystem;

        require constraint {
            gyro.orientationOut.orientation.confidence >= 0.95
        }
    }

    requirement def StartupRequirement {
        subject gyro : GyroscopeSystem;

        require constraint {
            gyro.startupTimeLimit <= 3.0
        }
    }

    requirement def RotorSpeedRequirement {
        subject rotorAssembly : RotorAssembly;

        require constraint {
            rotorAssembly.rotorSpeed >= 23500.0 and rotorAssembly.rotorSpeed <= 24500.0
        }
    }

    requirement def ElectricalPowerRequirement {
        subject gyro : GyroscopeSystem;

        require constraint {
            gyro.powerIn.power.voltage >= 4.75 and gyro.powerIn.power.voltage <= 5.25 and
            gyro.powerIn.power.current <= gyro.maximumCurrent
        }
    }

    requirement def OperatingTemperatureRequirement {
        subject gyro : GyroscopeSystem;

        require constraint {
            gyro.minimumOperatingTemperature <= gyro.rotorAssembly.bearingSet.temperature and
            gyro.rotorAssembly.bearingSet.temperature <= gyro.maximumOperatingTemperature
        }
    }

    requirement def AngularRateMeasurementRequirement {
        subject sensor : AngularMotionSensor;

        require constraint {
            sensor.measurementRange >= 8.73 and
            sensor.scaleFactorError <= 0.002
        }
    }

    requirement def HealthReportingRequirement {
        subject gyro : GyroscopeSystem;

        require constraint {
            gyro.healthOut.health.ready == true implies
            gyro.rotorAssembly.rotorSpeed >= 23500.0 and
            gyro.rotorAssembly.rotorSpeed <= 24500.0
        }
    }

    part gyroscopeNavigationUnit : GyroscopeSystem {
        attribute operatingVoltage = 5.0;
        attribute maximumCurrent = 0.35;
        attribute nominalRotorSpeed = 24000.0;
        attribute angularRateRange = 8.73;
    }

    satisfy PrimaryFunctionRequirement by gyroscopeNavigationUnit;
    satisfy StartupRequirement by gyroscopeNavigationUnit;
    satisfy ElectricalPowerRequirement by gyroscopeNavigationUnit;
    satisfy OperatingTemperatureRequirement by gyroscopeNavigationUnit;
    satisfy HealthReportingRequirement by gyroscopeNavigationUnit;
}
