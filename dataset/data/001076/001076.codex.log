        } = 0.000018;
        attribute angularMomentum : Real {
            unit = "kg*m^2/s";
        }
    }

    part def SpinMotor {
        port powerIn : PowerInputPort;
        port shaftTorqueOut {
            out item torque : Torque;
        }

        attribute motorCurrent : Current;
        attribute commandedTorque : Torque;
        attribute maximumTorque : Torque = 0.006;
    }

    part def LowFrictionBearingSet {
        attribute frictionTorque : Torque = 0.00004;
        attribute temperature : Temperature;
