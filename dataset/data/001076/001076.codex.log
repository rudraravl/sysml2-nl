        connect powerConditioner.conditionedPowerOut to rotorAssembly.powerIn;
        connect powerConditioner.conditionedPowerOut to angularSensor.powerIn;
        connect powerConditioner.conditionedPowerOut to signalProcessor.powerIn;
        connect powerConditioner.conditionedPowerOut to healthMonitor.powerIn;

        connect bodyMotionIn to frameAssembly.motionIn;
        connect frameAssembly.relativeMotionOut to angularSensor.motionIn;
        connect rotorAssembly.spinStateOut to angularSensor.spinStateIn;
        connect angularSensor.rawMeasurementOut to signalProcessor.measurementIn;
        connect signalProcessor.orientationOut to orientationOut;
        connect rotorAssembly.spinStateOut to healthMonitor.spinStateIn;
        connect signalProcessor.processingHealthOut to healthMonitor.processorHealthIn;
        connect healthMonitor.healthOut to healthOut;
        connect controlIn to signalProcessor.controlIn;
        connect controlIn to rotorAssembly.controlIn;

        perform action initializeSystem : InitializeGyroscope;
        perform action estimateOrientation : EstimateOrientation;
        perform state gyroOperationalStates : GyroscopeOperatingStateMachine;
    }

    part def PowerConditioner {
        port rawPowerIn : PowerInputPort;
        port conditionedPowerOut : PowerInputPort;

        attribute inputVoltage : Voltage;
        attribute regulatedVoltage : Voltage = 5.0;
        attribute rippleLimit : Voltage = 0.02;
        attribute efficiency : DimensionlessRatio = 0.90;
    }

    part def RotorAssembly {
        port powerIn : PowerInputPort;
        port controlIn : ControlPort;
