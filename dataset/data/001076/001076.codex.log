         * High-level primary function:
         * The gyroscope system senses angular motion about three orthogonal axes and
         * produces a stable orientation estimate for a host vehicle, instrument,
         * or navigation controller.
         */

        port powerIn : PowerInputPort;
        port bodyMotionIn : MotionInputPort;
        port orientationOut : OrientationOutputPort;
        port healthOut : HealthOutputPort;
        port controlIn : ControlPort;

        attribute operatingVoltage : Voltage = 5.0;
        attribute maximumCurrent : Current = 0.35;
        attribute nominalRotorSpeed : RotationalSpeed = 24000.0;
        attribute startupTimeLimit : TimeInterval = 3.0;
        attribute angularRateRange : AngularRate = 8.73;
        attribute biasStability : AngularRate = 0.00035;
        attribute maximumOperatingTemperature : Temperature = 85.0;
        attribute minimumOperatingTemperature : Temperature = -40.0;

        part powerConditioner : PowerConditioner;
        part rotorAssembly : RotorAssembly;
        part frameAssembly : GimbalFrameAssembly;
        part angularSensor : AngularMotionSensor;
