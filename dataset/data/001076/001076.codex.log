        attribute messageCode : Integer;
        attribute temperatureMargin : Temperature;
    }

    port def PowerInputPort {
        in item power : ElectricalPower;
    }

    port def MotionInputPort {
        in item motion : AngularMotion;
    }

    port def OrientationOutputPort {
        out item orientation : OrientationEstimate;
    }

    port def HealthOutputPort {
