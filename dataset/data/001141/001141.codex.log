        part vacuumProcess : VacuumProcessPort;
        part gauge : McLeodGauge;
        part operator : GaugeOperator;

        connect vacuumProcess.processGasPort to gauge.vacuumConnection;
        connect operator.commandPort to gauge.userControl;
        connect gauge.indicatedPressure to operator.readingPort;

        attribute primaryFunction : String =
            "Isolate a known volume of low-pressure gas from a vacuum process, compress it with a mercury column, observe the mercury height difference, and infer the original absolute pressure using the gas compression ratio.";

        action performSingleMeasurement {
            first start;
            then commandSampling;
            action commandSampling {
                operator.commandPort.command.requestedMode := "sample";
                operator.commandPort.command.targetReservoirAngle := operator.requestedReservoirAngle;
                operator.commandPort.command.isolateSample := true;
            }
            then gaugeCycle;
            action gaugeCycle {
                perform gauge.admitSample;
                perform gauge.isolateSample;
                perform gauge.compressSample(operator.requestedReservoirAngle);
                perform gauge.measurePressure;
            }
            then acceptReading;
            action acceptReading {
                operator.acceptedPressure := gauge.currentReading.measuredPressure;
            }
            then reset;
            action reset {
                perform gauge.resetGauge;
            }
            then done;
        }
    }

    requirement def PrimaryFunctionRequirement {
        doc
        /* The system shall measure absolute pressure in a vacuum process by trapping a known gas volume, compressing that gas with mercury, measuring the resulting mercury column height difference, and calculating the original pressure from Boyle's law. */

        subject system : McLeodGaugeVacuumMeasurementSystem;

        require constraint {
            system.gauge.currentReading.measuredPressure >= system.gauge.measurementRangeLow and
            system.gauge.currentReading.measuredPressure <= system.gauge.measurementRangeHigh
        }
    }

    requirement def SampleIsolationRequirement {
        doc
        /* The inlet valve shall isolate the gas sample before mercury compression begins so that the measured gas quantity remains fixed. */

        subject gauge : McLeodGauge;

        require constraint {
            gauge.inletValve.isClosed == true implies gauge.bulb.isSampleTrapped == true
        }
    }

    requirement def CompressionMeasurementRequirement {
        doc
        /* The gauge shall determine pressure from the measured mercury height difference and the ratio of compressed gas volume to calibrated initial sample volume. */

        subject gauge : McLeodGauge;

        require constraint {
            gauge.calculator.calculatedPressure ==
            gauge.calculator.mercuryDensity *
            gauge.calculator.gravitationalAcceleration *
            gauge.calculator.heightDifference *
            gauge.calculator.compressionRatio
        }
    }

    requirement def NonCondensableGasRequirement {
        doc
        /* The measurement shall be valid only for non-condensable gases whose pressure is above the mercury vapor pressure contribution under the measurement temperature. */

        subject sample : GasSample;

        require constraint {
            sample.pressure > 0.17 [SI::pascal]
        }
    }

    satisfy PrimaryFunctionRequirement by McLeodGaugeVacuumMeasurementSystem;
    satisfy SampleIsolationRequirement by McLeodGauge;
    satisfy CompressionMeasurementRequirement by PressureCalculator;

}
