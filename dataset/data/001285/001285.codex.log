        }
    }

    requirement def SamplingRateRequirement {
        doc "The sensing unit shall sample both throttle position sensor tracks at no less than 1000 hertz.";
        subject converter : AnalogToDigitalConverter;

        require constraint {
            converter.sampleRate >= 1000.0
        }
    }

    requirement def OperatingTemperatureRequirement {
        doc "The throttle position sensor shall operate from minus 40 degrees Celsius to 125 degrees Celsius.";
        subject sensor : ThrottlePositionSensor;

        require constraint {
            sensor.operatingTemperatureMinimum <= -40.0 and
            sensor.operatingTemperatureMaximum >= 125.0
        }
    }

    satisfy MeasureThrottlePositionRequirement by ThrottlePositionSensingUnit;
    satisfy AccuracyRequirement by ThrottlePositionSensingUnit;
    satisfy LatencyRequirement by ThrottlePositionSensingUnit;
    satisfy RedundantTrackDiagnosticRequirement by PositionComputationProcessor;
    satisfy SensorSupplyRequirement by PowerRegulator;
    satisfy ElectricalRangeDiagnosticRequirement by PositionComputationProcessor;
    satisfy SamplingRateRequirement by AnalogToDigitalConverter;
    satisfy OperatingTemperatureRequirement by ThrottlePositionSensor;
