            attribute inferredAngle : Degree;
            attribute trackDifference : Percent;
            attribute selectedFault : SensorFaultCode;

            first readConvertedSignals;
            then scaleTrack1ToPercent;
            then scaleTrack2ToPercent;
            then compareRedundantTracks;
            then validateElectricalRange;
            then fusePositionEstimate;
            then generateDiagnosticReport;
            then publishMeasurement;
            then done;

            action readConvertedSignals;
            action scaleTrack1ToPercent;
            action scaleTrack2ToPercent;
            action compareRedundantTracks;
            action validateElectricalRange;
            action fusePositionEstimate;
            action generateDiagnosticReport;
            action publishMeasurement;
        }

        state def ProcessorOperatingState {
            entry action initializeDiagnostics;
            state initializing;
            state measuring;
            state degraded;
            state failed;

            transition first initializing
                then measuring;

            transition measuring_to_degraded
                first measuring
                accept SensorFaultCode::excessiveNoise
                then degraded;

            transition measuring_to_failed
                first measuring
                accept SensorFaultCode::openCircuit
                then failed;

            transition measuring_to_failed_short
                first measuring
                accept SensorFaultCode::shortToSupply
                then failed;

            transition degraded_to_measuring
                first degraded
                accept SensorFaultCode::noFault
                then measuring;

            transition degraded_to_failed
                first degraded
                accept SensorFaultCode::dualTrackMismatch
                then failed;

            transition failed_to_initializing
                first failed
                accept SensorFaultCode::noFault
                then initializing;
        }
    }

    part def PowerRegulator {
        attribute inputVoltageMinimum : Volt = 9.0;
        attribute inputVoltageMaximum : Volt = 16.0;
        attribute outputVoltage : Volt = 5.0;
        attribute outputTolerance : Percent = 2.0;
        attribute maximumOutputCurrent : Ampere = 0.05;

        port regulatedOutput : PowerInputPort;

        action regulateSupply {
            in attribute vehicleBatteryVoltage : Volt;
            out item sensorSupply : RegulatedSupply;
            out item sensorGround : GroundReference;

            first monitorInputVoltage;
            then regulateToFiveVolts;
            then limitCurrent;
            then outputSensorPower;
            then done;

            action monitorInputVoltage;
            action regulateToFiveVolts;
            action limitCurrent;
            action outputSensorPower;
        }
    }

    part def ThrottlePositionSensingUnit {
        attribute measurementRangeMinimum : Percent = 0.0;
        attribute measurementRangeMaximum : Percent = 100.0;
        attribute angularRangeMinimum : Degree = 0.0;
        attribute angularRangeMaximum : Degree = 90.0;
        attribute measurementAccuracy : Percent = 2.0;
        attribute updateRate : Hertz = 1000.0;
        attribute endToEndLatencyLimit : MilliSecond = 10.0;
        attribute health : SensingUnitHealth = SensingUnitHealth::ok;

        port throttleAngleInput : MechanicalAnglePort;
        port batterySupplyInput : PowerInputPort;
        port throttlePositionOutput : MeasurementOutputPort;
        port diagnosticOutput : DiagnosticOutputPort;
        port calibrationInput : CalibrationPort;

        part regulator : PowerRegulator;
        part sensor : ThrottlePositionSensor;
        part conditioner : SignalConditioner;
        part converter : AnalogToDigitalConverter;
        part processor : PositionComputationProcessor;

        connect throttleAngleInput to sensor.mechanicalInput;
        connect regulator.regulatedOutput to sensor.powerInput;
        connect sensor.track1Output to conditioner.track1Input;
        connect sensor.track2Output to conditioner.track2Input;
        connect conditioner.track1ConditionedOutput to converter.track1AnalogInput;
        connect conditioner.track2ConditionedOutput to converter.track2AnalogInput;
        connect processor.measurementOutput to throttlePositionOutput;
        connect processor.diagnosticOutput to diagnosticOutput;
        connect calibrationInput to processor.calibrationInput;

        action measureRelevantQuantityUsingThrottlePositionSensor {
            in item actualThrottleAngle : ThrottleShaftAngle;
            in attribute vehicleBatteryVoltage : Volt;
            out item measuredThrottlePosition : ThrottlePositionMeasurement;
            out item diagnostics : DiagnosticReport;

            first powerUp;
            then acquireSensorVoltages;
            then conditionVoltages;
            then digitizeVoltages;
            then computePosition;
            then publishOutputs;
            then done;

            action powerUp {
                in attribute vehicleBatteryVoltage : Volt;
                out item sensorSupply : RegulatedSupply;
            }

            action acquireSensorVoltages {
                in item actualThrottleAngle : ThrottleShaftAngle;
                out item rawTrack1Voltage : SensorAnalogVoltage;
                out item rawTrack2Voltage : SensorAnalogVoltage;
            }

            action conditionVoltages {
                in item rawTrack1Voltage : SensorAnalogVoltage;
                in item rawTrack2Voltage : SensorAnalogVoltage;
                out item conditionedTrack1Voltage : SensorAnalogVoltage;
                out item conditionedTrack2Voltage : SensorAnalogVoltage;
            }

            action digitizeVoltages {
                in item conditionedTrack1Voltage : SensorAnalogVoltage;
                in item conditionedTrack2Voltage : SensorAnalogVoltage;
                out attribute track1Counts : Integer;
                out attribute track2Counts : Integer;
            }

            action computePosition {
                in attribute track1Counts : Integer;
                in attribute track2Counts : Integer;
                out item measuredThrottlePosition : ThrottlePositionMeasurement;
                out item diagnostics : DiagnosticReport;
            }

            action publishOutputs {
                in item measuredThrottlePosition : ThrottlePositionMeasurement;
                in item diagnostics : DiagnosticReport;
            }
        }

        state def SensingUnitLifecycle {
            entry action performSelfTest;
            state off;
            state startupSelfTest;
            state normalMeasurement;
            state degradedMeasurement;
            state faultLatched;

            transition initialToOff
                first off;

            transition powerApplied
                first off
                then startupSelfTest;

            transition selfTestPassed
                first startupSelfTest
                then normalMeasurement;

            transition recoverableFaultDetected
                first normalMeasurement
                then degradedMeasurement;

            transition unrecoverableFaultDetected
                first normalMeasurement
                then faultLatched;

            transition degradedFaultCleared
                first degradedMeasurement
                then normalMeasurement;

            transition degradedFaultEscalated
                first degradedMeasurement
                then faultLatched;

            transition powerRemoved
                first faultLatched
                then off;
        }
    }

    requirement def MeasureThrottlePositionRequirement {
        doc "The sensing unit shall measure throttle position using a throttle position sensor and output the measured position as a percentage of full throttle travel.";
        subject sensingUnit : ThrottlePositionSensingUnit;

        require constraint {
            sensingUnit.measurementRangeMinimum == 0.0 and
            sensingUnit.measurementRangeMaximum == 100.0
        }
    }

    requirement def AccuracyRequirement {
        doc "The sensing unit shall report throttle position with accuracy within plus or minus 2 percent of full-scale travel over the calibrated angular range.";
        subject sensingUnit : ThrottlePositionSensingUnit;

        require constraint {
            sensingUnit.measurementAccuracy <= 2.0
        }
    }

    requirement def LatencyRequirement {
        doc "The sensing unit shall provide a new throttle position measurement within 10 milliseconds after a change in throttle shaft angle.";
        subject sensingUnit : ThrottlePositionSensingUnit;

        require constraint {
            sensingUnit.endToEndLatencyLimit <= 10.0
        }
    }

    requirement def RedundantTrackDiagnosticRequirement {
        doc "The sensing unit shall diagnose a fault when redundant throttle position sensor tracks differ by more than 5 percent of full-scale travel.";
        subject processor : PositionComputationProcessor;

        require constraint {
            processor.trackMismatchLimit <= 5.0
        }
    }

    requirement def SensorSupplyRequirement {
        doc "The throttle position sensor shall be supplied by a regulated 5 volt reference with tolerance no greater than 2 percent.";
        subject regulator : PowerRegulator;

        require constraint {
            regulator.outputVoltage == 5.0 and
            regulator.outputTolerance <= 2.0
        }
    }

    requirement def ElectricalRangeDiagnosticRequirement {
        doc "The sensing unit shall identify open circuit, short to ground, short to supply, and out-of-range sensor signal conditions.";
        subject processor : PositionComputationProcessor;

        require constraint {
            processor.track1MinimumValidVoltage >= 0.25 and
            processor.track1MaximumValidVoltage <= 4.75 and
            processor.track2MinimumValidVoltage >= 0.25 and
            processor.track2MaximumValidVoltage <= 4.75
        }
    }

    requirement def SamplingRateRequirement {
        doc "The sensing unit shall sample both throttle position sensor tracks at no less than 1000 hertz.";
        subject converter : AnalogToDigitalConverter;

        require constraint {
            converter.sampleRate >= 1000.0
        }
    }

    requirement def OperatingTemperatureRequirement {
        doc "The throttle position sensor shall operate from minus 40 degrees Celsius to 125 degrees Celsius.";
        subject sensor : ThrottlePositionSensor;

        require constraint {
            sensor.operatingTemperatureMinimum <= -40.0 and
            sensor.operatingTemperatureMaximum >= 125.0
        }
    }

    satisfy MeasureThrottlePositionRequirement by ThrottlePositionSensingUnit;
    satisfy AccuracyRequirement by ThrottlePositionSensingUnit;
    satisfy LatencyRequirement by ThrottlePositionSensingUnit;
    satisfy RedundantTrackDiagnosticRequirement by PositionComputationProcessor;
    satisfy SensorSupplyRequirement by PowerRegulator;
    satisfy ElectricalRangeDiagnosticRequirement by PositionComputationProcessor;
    satisfy SamplingRateRequirement by AnalogToDigitalConverter;
    satisfy OperatingTemperatureRequirement by ThrottlePositionSensor;
}
