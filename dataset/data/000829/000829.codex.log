    connect therapyManager.shockCommandPort to energySubsystem.commandPort;
    connect energySubsystem.eventPort to eventRecorder.eventInputPort;
    connect monitorController.eventPort to eventRecorder.eventInputPort;
    connect therapyManager.eventPort to eventRecorder.eventInputPort;
    connect eventRecorder.dataPort to clinicalDataPort;
    connect communicationsModule.dataPort to clinicalDataPort;
    connect selfTestManager.servicePort to servicePort;

    perform action monitorAndTreat;
    exhibit state machine operationalStates;
