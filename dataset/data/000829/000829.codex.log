    attribute nominalShockEnergy : Joule = 100.0;
    attribute arrhythmiaConfirmationWindow : Second = 45.0;
    attribute patientResponseWindow : Second = 30.0;
    attribute minimumECGSignalQuality : Percent = 70.0;
    attribute operatingTemperatureMin : Celsius = 0.0;
    attribute operatingTemperatureMax : Celsius = 45.0;

