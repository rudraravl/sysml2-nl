    part electrodeSet : SensingElectrodeSet;
    part therapyPadSet : DefibrillationTherapyPadSet;
    part monitorController : MonitorController;
    part arrhythmiaDetector : ArrhythmiaDetectionProcessor;
    part therapyManager : TherapyManager;
    part energySubsystem : ShockEnergySubsystem;
