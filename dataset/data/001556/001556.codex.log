    }

    requirement def MapResolutionRequirement {
        subject system : RoboticMappingSystem;

        require constraint {
            system.requiredMapResolution <= 0.05 [SI::metre]
        }
    }

    requirement def CoverageRequirement {
        subject system : RoboticMappingSystem;

        require constraint {
            system.requiredCoverageRatio >= 0.95
        }
    }

    requirement def SensorRangeRequirement {
        subject scanner : LidarScanner;

        require constraint {
            scanner.maximumRange >= 20 [SI::metre]
        }
    }

    requirement def MissionDurationRequirement {
        subject system : RoboticMappingSystem;

        require constraint {
            system.nominalMissionDuration <= 1800 [SI::second]
        }
    }

    requirement def LocalizationQualityRequirement {
        subject localizer : LocalizationProcessor;

        require constraint {
            localizer.maximumPoseUncertainty <= 0.25
        }
    }

    requirement def PowerEnduranceRequirement {
        subject power : PowerSubsystem;

        require constraint {
            power.storedEnergy >= 600000 [SI::joule]
        }
    }

    satisfy PrimaryFunctionRequirement by RoboticMappingSystem;
    satisfy MapResolutionRequirement by RoboticMappingSystem;
    satisfy CoverageRequirement by RoboticMappingSystem;
    satisfy SensorRangeRequirement by LidarScanner;
    satisfy MissionDurationRequirement by RoboticMappingSystem;
    satisfy LocalizationQualityRequirement by LocalizationProcessor;
    satisfy PowerEnduranceRequirement by PowerSubsystem;

}
