        attribute maximumTcpSpeed : MillimeterPerSecond = 2000.0;
        attribute installedMass : Kilogram = 42.0;

        port powerInput : PowerInputPort;
        port commandInput : CommandPort;
        port telemetryOutput : TelemetryPort;
        port safetyInput : SafetyPort;
        port workpiecePort : WorkpiecePort;

        part controller : RobotController {
            cycleTime = 4.0;
            servoPowerEnabled = false;
            automaticModeEnabled = true;
        }

        part baseJoint : ServoJoint {
            jointId = 1;
            minimumAngle = -170.0;
            maximumAngle = 170.0;
            maximumTorque = 150.0;
            maximumVelocity = 180.0;
            gearRatio = 120.0;
        }

        part shoulderJoint : ServoJoint {
            jointId = 2;
            minimumAngle = -120.0;
            maximumAngle = 120.0;
            maximumTorque = 140.0;
            maximumVelocity = 160.0;
            gearRatio = 130.0;
        }

        part elbowJoint : ServoJoint {
            jointId = 3;
            minimumAngle = -150.0;
            maximumAngle = 150.0;
            maximumTorque = 100.0;
            maximumVelocity = 190.0;
            gearRatio = 110.0;
        }

        part wristPitchJoint : ServoJoint {
            jointId = 4;
            minimumAngle = -180.0;
            maximumAngle = 180.0;
            maximumTorque = 45.0;
            maximumVelocity = 240.0;
            gearRatio = 80.0;
        }

        part wristYawJoint : ServoJoint {
            jointId = 5;
            minimumAngle = -125.0;
            maximumAngle = 125.0;
            maximumTorque = 35.0;
            maximumVelocity = 240.0;
            gearRatio = 75.0;
        }

        part wristRollJoint : ServoJoint {
            jointId = 6;
            minimumAngle = -360.0;
            maximumAngle = 360.0;
            maximumTorque = 25.0;
            maximumVelocity = 300.0;
            gearRatio = 60.0;
        }

        part gripper : EndEffector {
            maximumGripForce = 60.0;
            maximumOpening = 85.0;
            currentOpening = 85.0;
            objectSecured = false;
            ratedPayload = 5.0;
        }

        part safetySystem : SafetySystem {
            emergencyStopLatched = false;
            protectiveStopRequested = false;
            workspaceScannerRange = 1500.0;
            safeSpeedLimit = 250.0;
        }

        connect commandInput to controller.operatorCommand;
        connect telemetryOutput to controller.telemetryOutput;
        connect safetyInput to safetySystem.safetyPort;
        connect safetySystem.safetyPort to controller.safetyInterface;

        connect controller.joint1Control to baseJoint.control;
        connect controller.joint2Control to shoulderJoint.control;
        connect controller.joint3Control to elbowJoint.control;
        connect controller.joint4Control to wristPitchJoint.control;
        connect controller.joint5Control to wristYawJoint.control;
        connect controller.joint6Control to wristRollJoint.control;
        connect controller.toolControl to gripper.toolControl;
        connect workpiecePort to gripper.workpieceInterface;

        constraint payloadWithinRating {
            gripper.ratedPayload <= ratedPayload
        }

        constraint reachSupportsProgrammedWorkspace {
            reach >= 800.0
        }

        constraint repeatabilitySupportsPrecisePlacement {
            repeatability <= 0.10
        }

        constraint sixAxisConfiguration {
            axisCount == 6
        }
    }

    requirement def PrimaryFunctionRequirement {
        subject arm : RoboticArm;

        require constraint {
            arm.axisCount == 6 and
            arm.ratedPayload >= 5.0 and
            arm.reach >= 800.0
        }

        doc /* The robotic arm shall provide six-axis controlled motion for positioning an end effector to pick, transfer, orient, and place workpieces within its rated payload and reachable workspace. */
    }

    requirement def PlacementAccuracyRequirement {
        subject arm : RoboticArm;

        require constraint {
            arm.repeatability <= 0.10
        }

        doc /* The robotic arm shall repeatedly place workpieces with repeatability of 0.10 mm or better. */
    }

    requirement def PayloadRequirement {
        subject arm : RoboticArm;

        require constraint {
            arm.ratedPayload >= 5.0
        }

        doc /* The robotic arm shall handle workpieces up to at least 5 kg at the tool center point. */
    }

    requirement def SafetyStopRequirement {
        subject arm : RoboticArm;

        require constraint {
            arm.safetySystem.safeSpeedLimit <= 250.0
        }

        doc /* The robotic arm shall enter protective stop when a human is detected in the monitored workspace and shall remain stopped during an active emergency stop. */
    }

    requirement def ToolControlRequirement {
        subject arm : RoboticArm;

        require constraint {
            arm.gripper.maximumGripForce >= 50.0 and
            arm.gripper.maximumOpening >= 80.0
        }

        doc /* The end effector shall grip and release workpieces using commanded force and opening width while reporting object detection and applied force. */
    }

    requirement def JointTelemetryRequirement {
        subject arm : RoboticArm;

        require constraint {
            arm.baseJoint.maximumTorque > 0.0 and
            arm.shoulderJoint.maximumTorque > 0.0 and
            arm.elbowJoint.maximumTorque > 0.0 and
            arm.wristPitchJoint.maximumTorque > 0.0 and
            arm.wristYawJoint.maximumTorque > 0.0 and
            arm.wristRollJoint.maximumTorque > 0.0
        }

        doc /* Each servo joint shall report angular position, velocity, torque, temperature, and encoder health for closed-loop control and diagnostics. */
    }

    part roboticArmSystem : RoboticArm;

    satisfy PrimaryFunctionRequirement by roboticArmSystem;
    satisfy PlacementAccuracyRequirement by roboticArmSystem;
    satisfy PayloadRequirement by roboticArmSystem;
    satisfy SafetyStopRequirement by roboticArmSystem;
    satisfy ToolControlRequirement by roboticArmSystem;
    satisfy JointTelemetryRequirement by roboticArmSystem;
}
