    }

    item def ElectricalPower {
        attribute voltage : Volt;
        attribute current : Ampere;
        attribute frequency : Hertz;
    }

    item def MotorCommand {
        attribute targetAngle : Degree;
        attribute targetVelocity : Degree;
        attribute targetTorque : NewtonMeter;
        attribute enable : Boolean;
    }

    item def JointTelemetry {
        attribute actualAngle : Degree;
        attribute actualVelocity : Degree;
        attribute actualTorque : NewtonMeter;
        attribute motorTemperature : Celsius;
        attribute encoderHealthy : Boolean;
    }

    item def ToolCommand {
        attribute gripForce : NewtonMeter;
        attribute openWidth : Millimeter;
        attribute vacuumEnabled : Boolean;
        attribute releaseObject : Boolean;
    }

    item def ToolTelemetry {
