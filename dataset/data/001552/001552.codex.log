    port def ToolControlPort {
        out item command : ToolCommand;
        in item telemetry : ToolTelemetry;
    }

    port def SafetyPort {
        in item safetyInput : SafetySignal;
        out item safetyOutput : SafetySignal;
    }

    port def WorkpiecePort {
        inout item handledItem : Workpiece;
    }

    part def ServoJoint {
        attribute jointId : Integer;
        attribute minimumAngle : Degree;
        attribute maximumAngle : Degree;
        attribute maximumTorque : NewtonMeter;
        attribute maximumVelocity : Degree;
        attribute gearRatio : Real;
        attribute holdingBrakeEngaged : Boolean;
        attribute currentAngle : Degree;
        attribute commandedAngle : Degree;

        port control : JointControlPort;

        action def MoveToTarget {
            in targetAngle : Degree;
            in targetVelocity : Degree;
            out reachedTarget : Boolean;

            first start;
            then validateRange;
            then releaseBrake;
            then driveMotor;
            then verifyPosition;
            then done;

            action validateRange {
                assert constraint {
                    targetAngle >= minimumAngle and targetAngle <= maximumAngle
                }
            }

            action releaseBrake {
                holdingBrakeEngaged = false;
            }

            action driveMotor {
                commandedAngle = targetAngle;
            }

            action verifyPosition {
                reachedTarget = true;
            }
        }

        state def JointOperatingState {
            state Disabled;
            state Enabled;
            state Moving;
            state Holding;
            state Faulted;

            entry action initialize {
                holdingBrakeEngaged = true;
            }

            transition first Disabled;
            transition Disabled to Enabled
                accept MotorCommand
                if control.command.enable == true;

            transition Enabled to Moving
                accept MotorCommand
                if control.command.targetAngle != currentAngle;

            transition Moving to Holding
                if currentAngle == commandedAngle;

            transition Holding to Moving
                accept MotorCommand
                if control.command.targetAngle != currentAngle;

            transition Enabled to Faulted
                if control.telemetry.encoderHealthy == false;

            transition Moving to Faulted
                if control.telemetry.motorTemperature > 85.0;

            transition Holding to Disabled
                accept MotorCommand
                if control.command.enable == false;
        }
    }

    part def EndEffector {
        attribute maximumGripForce : NewtonMeter;
        attribute maximumOpening : Millimeter;
        attribute currentOpening : Millimeter;
        attribute objectSecured : Boolean;
        attribute ratedPayload : Kilogram;

        port toolControl : ToolControlPort;
        port workpieceInterface : WorkpiecePort;

        action def GraspObject {
            in object : Workpiece;
            in desiredForce : NewtonMeter;
            out grasped : Boolean;

            first approach;
            then closeFingers;
            then confirmObject;
            then done;

            action approach {
                currentOpening = object.width + 5.0;
            }

            action closeFingers {
                assert constraint {
                    desiredForce <= maximumGripForce
                }
                currentOpening = object.width;
            }

            action confirmObject {
                objectSecured = true;
                grasped = true;
            }
        }

        action def ReleaseObject {
            out released : Boolean;

            first openFingers;
            then clearObject;
            then done;

            action openFingers {
                currentOpening = maximumOpening;
            }

            action clearObject {
                objectSecured = false;
                released = true;
            }
        }

        state def ToolState {
            state Open;
            state Closing;
            state HoldingObject;
            state Releasing;
            state ToolFault;

            transition first Open;

            transition Open to Closing
                accept ToolCommand
                if toolControl.command.openWidth < currentOpening;

            transition Closing to HoldingObject
                if toolControl.telemetry.objectDetected == true;

            transition HoldingObject to Releasing
                accept ToolCommand
                if toolControl.command.releaseObject == true;

            transition Releasing to Open
                if objectSecured == false;

            transition Closing to ToolFault
                if toolControl.telemetry.appliedForce > maximumGripForce;
        }
    }

    part def RobotController {
        attribute cycleTime : Millisecond;
        attribute activeProgramId : Integer;
        attribute plannedPose : CartesianPose;
        attribute actualPose : CartesianPose;
        attribute servoPowerEnabled : Boolean;
        attribute automaticModeEnabled : Boolean;

        port operatorCommand : CommandPort;
        port telemetryOutput : TelemetryPort;
        port safetyInterface : SafetyPort;

        port joint1Control : JointControlPort;
        port joint2Control : JointControlPort;
        port joint3Control : JointControlPort;
        port joint4Control : JointControlPort;
        port joint5Control : JointControlPort;
        port joint6Control : JointControlPort;
        port toolControl : ToolControlPort;

        action def ExecutePickAndPlace {
            in plan : MotionPlan;
            in workpiece : Workpiece;
            out completed : Boolean;

            first receivePlan;
            then checkSafety;
            then moveToPickPose;
            then closeTool;
            then liftWorkpiece;
            then moveToPlacePose;
            then releaseTool;
            then returnHome;
            then done;

            action receivePlan {
                plannedPose = plan.goalPose;
            }

            action checkSafety {
                assert constraint {
                    safetyInterface.safetyInput.emergencyStopActive == false and
                    safetyInterface.safetyInput.protectiveStopActive == false and
                    safetyInterface.safetyInput.humanInWorkspace == false
                }
            }

            action moveToPickPose {
                servoPowerEnabled = true;
            }

            action closeTool {
                toolControl.command.gripForce = 18.0;
                toolControl.command.releaseObject = false;
            }

            action liftWorkpiece {
                assert constraint {
                    workpiece.mass <= plan.maximumPayload
                }
            }

            action moveToPlacePose {
                plannedPose = plan.goalPose;
            }

            action releaseTool {
                toolControl.command.releaseObject = true;
            }

            action returnHome {
                completed = true;
            }
        }

        state def ControllerState {
            state Booting;
            state Idle;
            state Planning;
            state ExecutingMotion;
            state Paused;
            state ProtectiveStop;
            state EmergencyStop;
            state FaultRecovery;

            transition first Booting;
            transition Booting to Idle
                if servoPowerEnabled == false;

            transition Idle to Planning
                accept MotionPlan
                if automaticModeEnabled == true;

            transition Planning to ExecutingMotion
                if safetyInterface.safetyInput.protectiveStopActive == false;

            transition ExecutingMotion to Idle
                if actualPose == plannedPose;

            transition ExecutingMotion to ProtectiveStop
                if safetyInterface.safetyInput.humanInWorkspace == true;

            transition ExecutingMotion to EmergencyStop
                if safetyInterface.safetyInput.emergencyStopActive == true;

            transition ProtectiveStop to Paused
                if safetyInterface.safetyInput.humanInWorkspace == false;

            transition Paused to ExecutingMotion
                accept MotionPlan
                if safetyInterface.safetyInput.protectiveStopActive == false;

            transition EmergencyStop to FaultRecovery
                if safetyInterface.safetyInput.emergencyStopActive == false;

            transition FaultRecovery to Idle
                if safetyInterface.safetyInput.faultCode == 0;
        }
    }

    part def SafetySystem {
        attribute emergencyStopLatched : Boolean;
        attribute protectiveStopRequested : Boolean;
        attribute workspaceScannerRange : Millimeter;
        attribute safeSpeedLimit : MillimeterPerSecond;

        port safetyPort : SafetyPort;

        action def EvaluateSafety {
            in currentSafety : SafetySignal;
            out resultingSafety : SafetySignal;

            first readInputs;
            then determineStopMode;
            then publishStatus;
            then done;

            action readInputs {
                emergencyStopLatched = currentSafety.emergencyStopActive;
                protectiveStopRequested = currentSafety.humanInWorkspace;
            }

            action determineStopMode {
                resultingSafety.emergencyStopActive = emergencyStopLatched;
                resultingSafety.protectiveStopActive = protectiveStopRequested;
            }

            action publishStatus {
                safetyPort.safetyOutput = resultingSafety;
            }
        }

        state def SafetyState {
            state Clear;
            state HumanDetected;
            state ProtectiveStopped;
            state EmergencyStopped;

            transition first Clear;

            transition Clear to HumanDetected
