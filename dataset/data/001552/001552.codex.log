    }

    port def PowerInputPort {
        in item power : ElectricalPower;
    }

    port def CommandPort {
        in item motionPlan : MotionPlan;
        in item toolCommand : ToolCommand;
    }

    port def TelemetryPort {
        out item endEffectorPose : CartesianPose;
        out item jointStatus : JointTelemetry;
        out item toolStatus : ToolTelemetry;
        out item safetyStatus : SafetySignal;
    }

    port def JointControlPort {
