        state alarmHandlingState {
            entry; then monitoring;

            state monitoring;
            state alarmReceived;
            state alarmNotified;
            state acknowledged;
            state escalated;
            state resolved;

            transition monitoring_to_alarmReceived first monitoring then alarmReceived;
            transition alarmReceived_to_alarmNotified first alarmReceived then alarmNotified;
            transition alarmNotified_to_acknowledged first alarmNotified then acknowledged;
            transition alarmNotified_to_escalated first alarmNotified then escalated;
            transition acknowledged_to_resolved first acknowledged then resolved;
            transition escalated_to_resolved first escalated then resolved;
            transition resolved_to_monitoring first resolved then monitoring;
        }
    }

    part def ClinicianMobileConsole {
        attribute consoleIdentifier : String;
        attribute authenticatedUserIdentifier : String;
        attribute sessionTimeout : Millisecond;

        port alarmNotifications : AlarmInPort;
        port commandInterface : CommandOutPort;

        action acknowledgeAlarm {
            in item alarm : ClinicalAlarm;
            out item acknowledgement : Acknowledgement;
        }

        action issueDeviceCommand {
            out item command : DeviceCommand;
        }
    }

    part def MedicalDeviceConnectivityPlatform {
        attribute systemIdentifier : String = "MDC-Platform-01";
        attribute primaryFunction : String = "Securely collect, normalize, route, and record real-time medical device data and alarms so clinicians and hospital systems have timely, traceable patient information.";
        attribute requiredAvailability : Percent = 99.9 [%];
        attribute maximumClinicalDataLatency : Millisecond = 2000 [ms];
        attribute minimumNetworkThroughput : MegabitPerSecond = 10 [Mb/s];

        part bedsideMonitor : PatientMonitor {
            attribute deviceIdentifier = "MON-BED-101";
            attribute protocol = ConnectivityProtocol::ieee11073;
            attribute sampleLatency = 250 [ms];
            attribute batteryVoltage = 14.4 [V];
            attribute nominalPower = 18 [W];
            attribute heartRateLowLimit = 45 [1/min];
            attribute heartRateHighLimit = 130 [1/min];
            attribute oxygenSaturationLowLimit = 90 [%];
        }

        part infusionPump : InfusionPump {
            attribute deviceIdentifier = "PUMP-BED-101";
            attribute protocol = ConnectivityProtocol::wifi;
            attribute sampleLatency = 1000 [ms];
            attribute batteryVoltage = 12 [V];
            attribute nominalPower = 22 [W];
            attribute programmedRateMilliliterPerHour = 75.0;
            attribute occlusionPressureLimit = 600 [mmHg];
        }

        part gateway : ConnectivityGateway {
            attribute gatewayIdentifier = "GW-ICU-01";
            attribute supportedProtocols = (ConnectivityProtocol::bluetoothLowEnergy, ConnectivityProtocol::wifi, ConnectivityProtocol::ethernet, ConnectivityProtocol::ieee11073);
            attribute maxDeviceCount = 64;
            attribute networkThroughput = 100 [Mb/s];
            attribute maximumEndToEndLatency = 1000 [ms];
        }

        part ehrAdapter : ElectronicHealthRecordAdapter {
            attribute adapterIdentifier = "FHIR-ADAPTER-01";
            attribute fhirEndpointUri = "https://ehr.example.org/fhir";
            attribute acceptedLatency = 2000 [ms];
        }

        part alarmManager : ClinicalAlarmManager {
            attribute alarmManagerIdentifier = "ALARM-MGR-01";
            attribute highPriorityEscalationDelay = 30000 [ms];
            attribute lifeCriticalEscalationDelay = 5000 [ms];
        }

        part clinicianConsole : ClinicianMobileConsole {
            attribute consoleIdentifier = "CLIN-CONSOLE-01";
            attribute authenticatedUserIdentifier = "RN-2941";
            attribute sessionTimeout = 900000 [ms];
        }

        connect bedsideMonitor.measurements to gateway.deviceMeasurementIn;
        connect bedsideMonitor.alarms to gateway.deviceAlarmIn;
        connect bedsideMonitor.status to gateway.deviceStatusIn;
        connect gateway.deviceCommandOut to bedsideMonitor.commands;

        connect infusionPump.measurements to gateway.deviceMeasurementIn;
        connect infusionPump.alarms to gateway.deviceAlarmIn;
        connect infusionPump.status to gateway.deviceStatusIn;
        connect gateway.deviceCommandOut to infusionPump.commands;

        connect gateway.hospitalNetwork to ehrAdapter.clinicalDataIn;
        connect gateway.deviceAlarmIn to alarmManager.alarmInput;
        connect alarmManager.alarmOutput to clinicianConsole.alarmNotifications;
        connect clinicianConsole.commandInterface to gateway.deviceCommandOut;

        action performPrimaryConnectivityFunction {
            first start;
            then collectMeasurements;
            then normalizeAndValidate;
            then routeClinicalAlarms;
            then persistObservations;
            then notifyClinician;
            then done;

            action collectMeasurements {
                in item monitorMeasurement : PhysiologicalMeasurement;
                in item pumpStatus : DeviceStatusMessage;
                out item collectedMeasurement : PhysiologicalMeasurement;
            }

            action normalizeAndValidate {
                in item collectedMeasurement : PhysiologicalMeasurement;
                out item validMeasurement : PhysiologicalMeasurement;
            }

            action routeClinicalAlarms {
                in item validMeasurement : PhysiologicalMeasurement;
                out item alarm : ClinicalAlarm;
            }

            action persistObservations {
                in item validMeasurement : PhysiologicalMeasurement;
                out item ehrAcknowledgement : Acknowledgement;
            }

            action notifyClinician {
                in item alarm : ClinicalAlarm;
                out item notificationAcknowledgement : Acknowledgement;
            }
        }
    }

    requirement def PrimaryFunctionRequirement {
        doc /* The medical device connectivity system shall securely acquire patient measurements, device status, and clinical alarms from connected bedside devices, normalize the data, distribute alarms to clinicians, and record validated observations in the electronic health record. */
    }

    requirement def DataLatencyRequirement {
        doc /* The system shall deliver validated physiological measurements from a connected medical device to the electronic health record adapter within 2000 ms during normal operation. */
        attribute maximumAllowedLatency : Millisecond = 2000 [ms];
    }

    requirement def AlarmLatencyRequirement {
        doc /* The system shall deliver life-critical alarms from a connected medical device to the clinician console within 5000 ms. */
        attribute maximumAllowedLatency : Millisecond = 5000 [ms];
    }

    requirement def DeviceAuthenticationRequirement {
        doc /* The connectivity gateway shall authenticate each medical device before accepting measurements, commands, alarms, or status messages from that device. */
    }

    requirement def DataIntegrityRequirement {
        doc /* The system shall mark each physiological measurement with patient identifier, device identifier, timestamp, and data integrity status before distribution to downstream clinical systems. */
    }

    requirement def CommandAcknowledgementRequirement {
        doc /* The system shall return an acknowledgement for every remote device command indicating whether the command was accepted or rejected and the reason for rejection when applicable. */
    }

    requirement def AvailabilityRequirement {
        doc /* The platform shall maintain at least 99.9 percent availability for medical device data ingestion and alarm routing during clinical operation. */
        attribute requiredAvailability : Percent = 99.9 [%];
    }

    requirement def CybersecurityLockoutRequirement {
        doc /* The gateway shall enter cybersecurity lockout when repeated authentication failures or malformed command messages exceed the configured safety threshold. */
    }

    satisfy PrimaryFunctionRequirement by MedicalDeviceConnectivityPlatform;
    satisfy DataLatencyRequirement by MedicalDeviceConnectivityPlatform::gateway;
    satisfy AlarmLatencyRequirement by MedicalDeviceConnectivityPlatform::alarmManager;
    satisfy DeviceAuthenticationRequirement by MedicalDeviceConnectivityPlatform::gateway;
    satisfy DataIntegrityRequirement by MedicalDeviceConnectivityPlatform::gateway;
    satisfy CommandAcknowledgementRequirement by MedicalDeviceConnectivityPlatform::gateway;
    satisfy AvailabilityRequirement by MedicalDeviceConnectivityPlatform;
    satisfy CybersecurityLockoutRequirement by MedicalDeviceConnectivityPlatform::gateway;

    constraint def LatencyBudgetConstraint {
        in gatewayLatency : Millisecond;
        in ehrAdapterLatency : Millisecond;
        in maximumLatency : Millisecond;
        gatewayLatency + ehrAdapterLatency <= maximumLatency;
    }

    constraint def AlarmEscalationConstraint {
        in elapsedUnacknowledgedTime : Millisecond;
        in escalationDelay : Millisecond;
        elapsedUnacknowledgedTime >= escalationDelay;
    }

    constraint def VitalSignRangeConstraint {
        in heartRate : BeatsPerMinute;
        in oxygenSaturation : Percent;
        heartRate >= 20 [1/min] and heartRate <= 240 [1/min] and oxygenSaturation >= 50 [%] and oxygenSaturation <= 100 [%];
    }

    allocation def MeasurementProcessingAllocation {
        allocate MedicalDeviceConnectivityPlatform::performPrimaryConnectivityFunction::collectMeasurements to MedicalDeviceConnectivityPlatform::gateway;
        allocate MedicalDeviceConnectivityPlatform::performPrimaryConnectivityFunction::normalizeAndValidate to MedicalDeviceConnectivityPlatform::gateway;
        allocate MedicalDeviceConnectivityPlatform::performPrimaryConnectivityFunction::persistObservations to MedicalDeviceConnectivityPlatform::ehrAdapter;
        allocate MedicalDeviceConnectivityPlatform::performPrimaryConnectivityFunction::routeClinicalAlarms to MedicalDeviceConnectivityPlatform::alarmManager;
        allocate MedicalDeviceConnectivityPlatform::performPrimaryConnectivityFunction::notifyClinician to MedicalDeviceConnectivityPlatform::clinicianConsole;
    }
}
