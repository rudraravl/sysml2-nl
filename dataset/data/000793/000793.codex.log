    out item permittedPulse : UltrasoundPulse;

    assert constraint mechanicalIndexWithinLimit {
      requestedPulse.acousticPressure <= 1.9 [MPa]
    }
  }

  action def GenerateDiagnosticReport {
    in item measurement : DiagnosticMeasurement;
    out item report : DiagnosticReport;
  }

  state def TissueDopplerImagingSessionStateMachine {
    entry action initializeSystem : PrepareProbe;

    state Standby;
    state ProbeContactCheck;
    state BModeLocalization;
    state TissueDopplerAcquisition;
    state VelocityEstimation;
    state ImageDisplay;
    state Measurement;
    state ReportReady;
    state SafetyLimited;
    state Shutdown;

    initial then Standby;

    transition startExam
      first Standby
      accept operatorStartCommand
      then ProbeContactCheck;

    transition contactEstablished
      first ProbeContactCheck
      accept adequateAcousticCoupling
      then BModeLocalization;

    transition tissueDopplerModeSelected
      first BModeLocalization
      accept tissueDopplerCommand
      then TissueDopplerAcquisition;

    transition echoesAvailable
      first TissueDopplerAcquisition
      accept rfEchoFrameReceived
      then VelocityEstimation;

    transition velocityFrameComputed
      first VelocityEstimation
      accept velocityMapReady
      then ImageDisplay;

    transition requestMeasurement
      first ImageDisplay
      accept measurementCommand
      then Measurement;

    transition measurementCompleted
      first Measurement
      accept diagnosticValuesReady
      then ReportReady;

    transition continueImaging
      first ImageDisplay
      accept nextFrameRequested
      then TissueDopplerAcquisition;

    transition acousticLimitExceeded
      first TissueDopplerAcquisition
      accept safetyLimitEvent
      then SafetyLimited;

    transition reduceOutputAndResume
      first SafetyLimited
      accept outputReduced
      then TissueDopplerAcquisition;

    transition endExam
      first ReportReady
      accept operatorEndCommand
      then Shutdown;
  }

  requirement def PrimaryFunctionRequirement {
    subject system : TissueDopplerEchocardiographySystem;

    doc
      /* The system shall provide a high-level clinical function of noninvasively estimating and displaying myocardial tissue motion by transmitting ultrasound, receiving tissue echoes, calculating Doppler velocity, and presenting tissue Doppler images and measurements to the operator. */

    require constraint primaryFunctionPresent {
      system.nominalTransmitFrequency >= 2.0 [MHz] and
      system.nominalTransmitFrequency <= 7.0 [MHz] and
      system.nominalFrameRate >= 40 [Hz]
    }
  }

  requirement def TissueVelocityMeasurementRequirement {
    subject processor : TissueDopplerProcessor;

    doc
      /* The tissue Doppler processor shall estimate axial myocardial tissue velocity from phase shift in sequential IQ echo samples while suppressing high-velocity blood-flow components. */

    require constraint velocityRangeAdequate {
      processor.aliasingLimit >= 0.20 [m/s]
    }
  }

  requirement def AcousticSafetyRequirement {
    subject monitor : AcousticSafetyMonitor;

    doc
      /* Acoustic output shall be limited so that mechanical and thermal exposure remain within diagnostic ultrasound safety limits during tissue Doppler operation. */

    require constraint acousticLimits {
      monitor.maximumMechanicalIndex <= 1.9 and
      monitor.maximumThermalIndex <= 1.0
    }
  }

  requirement def DisplayRequirement {
    subject renderer : DopplerImageRenderer;

    doc
      /* The renderer shall display myocardial tissue velocity as a color-coded overlay on anatomical reference imagery at an update rate suitable for real-time cardiac motion assessment. */

    require constraint realTimeDisplay {
      renderer.displayedFrameRate >= 30 [Hz]
    }
  }

  satisfy PrimaryFunctionRequirement by TissueDopplerEchocardiographySystem;
  satisfy TissueVelocityMeasurementRequirement by TissueDopplerProcessor;
  satisfy AcousticSafetyRequirement by AcousticSafetyMonitor;
  satisfy DisplayRequirement by DopplerImageRenderer;
}
