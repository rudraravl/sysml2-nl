    }
  }

  action def RejectHeatToAmbient {
    in item distributedHeat : ThermalEnergyFlow;
    in part sink : HeatSink;
    in part fanUnit : Fan;
    out item rejectedHeat : ThermalEnergyFlow;
  }

  action def RegulateCooling {
    in item hotSpotSample : TemperatureSample;
    in item edgeSample : TemperatureSample;
    inout part controller : ThermalController;
    out item command : ControlCommand;

    if hotSpotSample.valid == false then {
      controller.lastFault = FaultKind::sensorFailure;
      controller.mode = OperatingMode::fault;
      command.alarmEnabled = true;
      command.fanDutyCycle = Percent { value = 100.0; unit = "%"; }
      command.requestedMode = OperatingMode::fault;
    } else if hotSpotSample.measuredTemperature.value >= controller.criticalTemperatureThreshold.value then {
      controller.lastFault = FaultKind::overTemperature;
      controller.mode = OperatingMode::fault;
      command.alarmEnabled = true;
      command.fanDutyCycle = Percent { value = 100.0; unit = "%"; }
      command.requestedMode = OperatingMode::fault;
    } else if hotSpotSample.measuredTemperature.value >= controller.highTemperatureThreshold.value then {
      controller.mode = OperatingMode::boostedCooling;
      command.alarmEnabled = false;
      command.fanDutyCycle = Percent { value = 85.0; unit = "%"; }
      command.requestedMode = OperatingMode::boostedCooling;
    } else if hotSpotSample.measuredTemperature.value <= controller.recoveryTemperatureThreshold.value then {
      controller.mode = OperatingMode::heatSpreading;
      command.alarmEnabled = false;
      command.fanDutyCycle = Percent { value = 35.0; unit = "%"; }
      command.requestedMode = OperatingMode::heatSpreading;
    } else {
      controller.mode = OperatingMode::heatSpreading;
      command.alarmEnabled = false;
      command.fanDutyCycle = Percent { value = 55.0; unit = "%"; }
      command.requestedMode = OperatingMode::heatSpreading;
    }
  }

  state def GrapheneThermalSystemStateMachine {
    attribute currentMode : OperatingMode;
    attribute activeFault : FaultKind;

    state off;
    state standby;
    state heatSpreading;
    state boostedCooling;
    state degraded;
    state fault;

    transition initial then off;

    transition powerApplied
      first off
      then standby
      effect {
        currentMode = OperatingMode::standby;
        activeFault = FaultKind::none;
      }

    transition heatLoadDetected
      first standby
      then heatSpreading
      effect {
        currentMode = OperatingMode::heatSpreading;
      }

    transition temperatureHigh
      first heatSpreading
      then boostedCooling
      guard currentMode == OperatingMode::heatSpreading
      effect {
        currentMode = OperatingMode::boostedCooling;
      }

    transition temperatureRecovered
      first boostedCooling
      then heatSpreading
      guard activeFault == FaultKind::none
      effect {
        currentMode = OperatingMode::heatSpreading;
      }

    transition coolingCapacityReduced
      first heatSpreading
      then degraded
      effect {
        currentMode = OperatingMode::degraded;
        activeFault = FaultKind::fanFailure;
      }

    transition criticalFaultDetected
      first heatSpreading
      then fault
      effect {
        currentMode = OperatingMode::fault;
      }

    transition boostedCriticalFaultDetected
      first boostedCooling
      then fault
      effect {
        currentMode = OperatingMode::fault;
      }

    transition degradedCriticalFaultDetected
      first degraded
      then fault
      effect {
        currentMode = OperatingMode::fault;
      }

    transition resetAfterFault
      first fault
      then standby
      guard activeFault == FaultKind::none
      effect {
        currentMode = OperatingMode::standby;
      }

    transition powerRemovedFromStandby
      first standby
      then off
      effect {
        currentMode = OperatingMode::off;
      }

    transition powerRemovedFromOperating
      first heatSpreading
      then off
      effect {
        currentMode = OperatingMode::off;
      }

    transition powerRemovedFromBoosted
      first boostedCooling
      then off
      effect {
        currentMode = OperatingMode::off;
      }

    transition powerRemovedFromFault
      first fault
      then off
      effect {
        currentMode = OperatingMode::off;
      }
  }

  requirement def PrimaryFunctionRequirement {
    subject system : GrapheneThermalSpreaderSystem;

    require constraint {
      system.primaryFunction ==
      "Use a high-conductivity graphene layer to spread concentrated heat from an electronic heat source across a larger heat rejection surface, reducing local hot spots and maintaining the protected device below its allowable operating temperature."
    }
  }

  requirement def HeatLoadRequirement {
    subject system : GrapheneThermalSpreaderSystem;

    require constraint {
      system.ratedHeatLoad.value >= 35.0 and
      system.maximumHeatLoad.value >= 55.0
    }
  }

  requirement def JunctionTemperatureRequirement {
    subject system : GrapheneThermalSpreaderSystem;

    require constraint {
      system.sourceInterface.maximumAllowedTemperature.value <= 358.15
    }
  }

  requirement def GrapheneConductivityRequirement {
    subject graphene : GrapheneLayer;

    require constraint {
      graphene.inPlaneThermalConductivity.value >= 1000.0 and
      graphene.crossPlaneThermalConductivity.value >= 8.0
    }
  }

  requirement def ThermalInterfaceRequirement {
    subject interfaceMaterial : ThermalInterfaceMaterial;

    require constraint {
      interfaceMaterial.thermalResistance.value <= 0.15 and
      interfaceMaterial.voidFraction.value <= 5.0
    }
  }

  requirement def CoolingControlRequirement {
    subject controller : ThermalController;

    require constraint {
      controller.highTemperatureThreshold.value < controller.criticalTemperatureThreshold.value and
      controller.recoveryTemperatureThreshold.value < controller.highTemperatureThreshold.value
    }
  }

  requirement def SensorCoverageRequirement {
    subject system : GrapheneThermalSpreaderSystem;

    require constraint {
      system.hotSpotSensor.healthy == true and
      system.edgeSensor.healthy == true
    }
  }

  requirement def FailSafeCoolingRequirement {
    subject system : GrapheneThermalSpreaderSystem;

    require constraint {
      system.controller.lastFault == FaultKind::none or
      system.fan.dutyCycle.value == 100.0
    }
  }

  requirement def MassLimitRequirement {
    subject system : GrapheneThermalSpreaderSystem;

    require constraint {
      system.totalMass.value <= 0.250
    }
  }

  part systemUnderSpecification : GrapheneThermalSpreaderSystem {
    attribute ratedHeatLoad = HeatFlowRate { value = 35.0; unit = "W"; }
    attribute maximumHeatLoad = HeatFlowRate { value = 55.0; unit = "W"; }
    attribute targetJunctionTemperature = Temperature { value = 343.15; unit = "K"; }
    attribute ambientDesignTemperature = Temperature { value = 313.15; unit = "K"; }
    attribute totalMass = Mass { value = 0.185; unit = "kg"; }
  }

  satisfy PrimaryFunctionRequirement by systemUnderSpecification;
  satisfy HeatLoadRequirement by systemUnderSpecification;
  satisfy JunctionTemperatureRequirement by systemUnderSpecification.sourceInterface;
  satisfy GrapheneConductivityRequirement by systemUnderSpecification.grapheneSheet;
  satisfy ThermalInterfaceRequirement by systemUnderSpecification.interfaceMaterial;
  satisfy CoolingControlRequirement by systemUnderSpecification.controller;
  satisfy SensorCoverageRequirement by systemUnderSpecification;
  satisfy FailSafeCoolingRequirement by systemUnderSpecification;
  satisfy MassLimitRequirement by systemUnderSpecification;
}
