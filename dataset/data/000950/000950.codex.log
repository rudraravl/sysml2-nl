        }

        require constraint {
            subsystem.turbopump.bearings.tripTemperature <= 373 [K]
        }
    }

    requirement def LeakageRequirement {
        subject pump : Turbopump;

        require constraint {
            pump.seal.allowableLeakageFlow <= 0.05 [l / min]
        }
    }

    part pumpingSubsystem : PumpingSubsystem {
        attribute requiredNominalFlowRate = 240 [l / min];
        attribute requiredPressureRise = 8.0 [bar];
        attribute maximumInletTemperature = 333 [K];
        attribute minimumInletPressure = 1.2 [bar];
        attribute maximumOutletPressure = 14 [bar];

        part turbopump {
            attribute ratedFlowRate = 260 [l / min];
            attribute minimumContinuousFlowRate = 55 [l / min];
            attribute ratedPressureRise = 8.5 [bar];
            attribute maximumDischargePressure = 14 [bar];
            attribute netPositiveSuctionHeadRequired = 0.75 [bar];
            attribute overallEfficiency = 0.72;

            part motor {
                attribute ratedPower = 22 [kW];
                attribute ratedSpeed = 3600 [rev / min];
                attribute maximumSpeed = 4200 [rev / min];
                attribute motorEfficiency = 0.92;
            }

            part impeller {
                attribute diameter = 0.16 [m];
                attribute bladeCount = 7;
                attribute designFlowRate = 240 [l / min];
                attribute designPressureRise = 8.0 [bar];
                attribute hydraulicEfficiency = 0.78;
            }
        }
    }

    satisfy PumpingSubsystemRequirement by pumpingSubsystem;
