        connect turbopump.fluidOut to dischargeCheckValve.inlet;
        connect dischargeCheckValve.outlet to dischargeOutlet;
        connect electricalSupply to turbopump.electricalPower;
        connect externalCommand to controller.commandIn;
        connect controller.motorCommand to turbopump.command;
        connect controller.inletValveCommand to isolationValve.control;
        connect turbopump.telemetry to controller.telemetryOut;
        connect controller.telemetryOut to subsystemTelemetry;
        connect turbopump.drain to drainOutlet;

        exhibit state operatingState : PumpOperatingState;
    }

    requirement def PumpingSubsystemRequirement {
        subject subsystem : PumpingSubsystem;

        require constraint {
            subsystem.requiredNominalFlowRate == 240 [l / min]
        }

        require constraint {
            subsystem.requiredPressureRise >= 8.0 [bar]
        }

        require constraint {
            subsystem.maximumOutletPressure <= 14 [bar]
        }

        require constraint {
            subsystem.turbopump.minimumContinuousFlowRate <= subsystem.allowableFlowRateRangeLow
        }

        require constraint {
            subsystem.turbopump.ratedFlowRate >= subsystem.requiredNominalFlowRate
        }

        require constraint {
            subsystem.turbopump.ratedPressureRise >= subsystem.requiredPressureRise
        }
    }

    requirement def CavitationProtectionRequirement {
        subject pump : Turbopump;

        require constraint {
            pump.netPositiveSuctionHeadRequired <= 0.8 [bar]
        }

        require constraint {
            pump.dryRunPermitted == false
        }
    }

    requirement def SafetyShutdownRequirement {
        subject subsystem : PumpingSubsystem;

        require constraint {
