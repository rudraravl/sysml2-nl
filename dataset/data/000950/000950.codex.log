        part impeller : Impeller;
        part casing : VoluteCasing;
        part seal : SealAssembly;
        part bearings : BearingAssembly;
        part inletPressureSensor : PressureSensor;
        part outletPressureSensor : PressureSensor;
        part flowSensor : FlowSensor;
        part temperatureSensor : TemperatureSensor;

        attribute ratedFlowRate : VolumetricFlowRate = 240 [l / min];
        attribute minimumContinuousFlowRate : VolumetricFlowRate = 60 [l / min];
        attribute ratedPressureRise : Pressure = 8.0 [bar];
        attribute maximumDischargePressure : Pressure = 14 [bar];
        attribute netPositiveSuctionHeadRequired : Pressure = 0.8 [bar];
        attribute overallEfficiency : Efficiency = 0.72;
        attribute dryRunPermitted : Boolean = false;

        connect electricalPower to motor.electricalPower;
        connect command to motor.control;
        connect motor.shaft to impeller.shaftInput;
        connect fluidIn to casing.inlet;
        connect casing.inlet to impeller.fluidInlet;
        connect impeller.fluidOutlet to casing.outlet;
        connect casing.outlet to fluidOut;
        connect casing.drain to drain;
        connect seal.drain to drain;
        connect fluidIn to inletPressureSensor.sensedFluid;
        connect fluidOut to outletPressureSensor.sensedFluid;
        connect fluidOut to flowSensor.sensedFluid;
        connect fluidIn to temperatureSensor.sensedFluid;
        connect motor.telemetry to telemetry;
        connect inletPressureSensor.telemetry to telemetry;
        connect outletPressureSensor.telemetry to telemetry;
        connect flowSensor.telemetry to telemetry;
        connect temperatureSensor.telemetry to telemetry;

        perform action start : StartPump;
        perform action stop : StopPump;
    }

    part def PumpingSubsystem {
        port suctionInlet : FluidInletPort;
        port dischargeOutlet : FluidOutletPort;
        port electricalSupply : ElectricalPowerPort;
        port externalCommand : ControlInputPort;
        port subsystemTelemetry : TelemetryOutputPort;
        port drainOutlet : VentDrainPort;

        part suctionFilter : Filter;
        part isolationValve : InletValve;
        part turbopump : Turbopump;
        part dischargeCheckValve : OutletCheckValve;
        part controller : PumpController;

        attribute requiredNominalFlowRate : VolumetricFlowRate = 240 [l / min];
        attribute allowableFlowRateRangeLow : VolumetricFlowRate = 60 [l / min];
        attribute allowableFlowRateRangeHigh : VolumetricFlowRate = 300 [l / min];
        attribute requiredPressureRise : Pressure = 8.0 [bar];
        attribute maximumInletTemperature : Temperature = 333 [K];
        attribute minimumInletPressure : Pressure = 1.2 [bar];
        attribute maximumOutletPressure : Pressure = 14 [bar];
        attribute continuousDutyCycle : Boolean = true;

        connect suctionInlet to suctionFilter.inlet;
        connect suctionFilter.outlet to isolationValve.upstream;
        connect isolationValve.downstream to turbopump.fluidIn;
        connect turbopump.fluidOut to dischargeCheckValve.inlet;
        connect dischargeCheckValve.outlet to dischargeOutlet;
        connect electricalSupply to turbopump.electricalPower;
        connect externalCommand to controller.commandIn;
        connect controller.motorCommand to turbopump.command;
        connect controller.inletValveCommand to isolationValve.control;
        connect turbopump.telemetry to controller.telemetryOut;
        connect controller.telemetryOut to subsystemTelemetry;
        connect turbopump.drain to drainOutlet;

        exhibit state operatingState : PumpOperatingState;
    }

    requirement def PumpingSubsystemRequirement {
        subject subsystem : PumpingSubsystem;

        require constraint {
            subsystem.requiredNominalFlowRate == 240 [l / min]
        }

        require constraint {
            subsystem.requiredPressureRise >= 8.0 [bar]
        }

        require constraint {
            subsystem.maximumOutletPressure <= 14 [bar]
        }

        require constraint {
            subsystem.turbopump.minimumContinuousFlowRate <= subsystem.allowableFlowRateRangeLow
        }

        require constraint {
            subsystem.turbopump.ratedFlowRate >= subsystem.requiredNominalFlowRate
        }

        require constraint {
            subsystem.turbopump.ratedPressureRise >= subsystem.requiredPressureRise
        }
    }

    requirement def CavitationProtectionRequirement {
        subject pump : Turbopump;

        require constraint {
            pump.netPositiveSuctionHeadRequired <= 0.8 [bar]
        }

        require constraint {
            pump.dryRunPermitted == false
        }
    }

    requirement def SafetyShutdownRequirement {
        subject subsystem : PumpingSubsystem;

        require constraint {
            subsystem.turbopump.maximumDischargePressure <= subsystem.maximumOutletPressure
        }

        require constraint {
            subsystem.turbopump.motor.overTemperatureLimit <= 413 [K]
        }

        require constraint {
            subsystem.turbopump.bearings.tripTemperature <= 373 [K]
        }
    }

    requirement def LeakageRequirement {
        subject pump : Turbopump;

        require constraint {
            pump.seal.allowableLeakageFlow <= 0.05 [l / min]
        }
    }

    part pumpingSubsystem : PumpingSubsystem {
        attribute requiredNominalFlowRate = 240 [l / min];
        attribute requiredPressureRise = 8.0 [bar];
        attribute maximumInletTemperature = 333 [K];
        attribute minimumInletPressure = 1.2 [bar];
        attribute maximumOutletPressure = 14 [bar];

        part turbopump {
            attribute ratedFlowRate = 260 [l / min];
            attribute minimumContinuousFlowRate = 55 [l / min];
            attribute ratedPressureRise = 8.5 [bar];
            attribute maximumDischargePressure = 14 [bar];
            attribute netPositiveSuctionHeadRequired = 0.75 [bar];
            attribute overallEfficiency = 0.72;

            part motor {
                attribute ratedPower = 22 [kW];
                attribute ratedSpeed = 3600 [rev / min];
                attribute maximumSpeed = 4200 [rev / min];
                attribute motorEfficiency = 0.92;
            }

            part impeller {
                attribute diameter = 0.16 [m];
                attribute bladeCount = 7;
                attribute designFlowRate = 240 [l / min];
                attribute designPressureRise = 8.0 [bar];
                attribute hydraulicEfficiency = 0.78;
            }
        }
    }

    satisfy PumpingSubsystemRequirement by pumpingSubsystem;
    satisfy CavitationProtectionRequirement by pumpingSubsystem.turbopump;
    satisfy SafetyShutdownRequirement by pumpingSubsystem;
    satisfy LeakageRequirement by pumpingSubsystem.turbopump;
}
