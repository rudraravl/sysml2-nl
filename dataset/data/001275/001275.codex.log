        subject sensingUnit : TactileSensingUnit;

        require constraint {
            sensingUnit.tactileSensor.forceRangeMax >= sensingUnit.measurementRangeForceMax
        }

        doc /* The sensing unit shall use a tactile sensor as the primary transducer for the measured contact quantity. */
    }

