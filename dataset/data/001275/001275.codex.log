        subject sensingUnit = tactileSensingUnit;
    }

    requirement diagnostics : DiagnosticRequirement {
        subject sensingUnit = tactileSensingUnit;
    }

    requirement startup : StartupRequirement {
        subject sensingUnit = tactileSensingUnit;
    }

    satisfy measureContactForce by tactileSensingUnit;
