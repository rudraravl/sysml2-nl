                first Unpowered
                accept PowerApplied
                then PoweringUp;

            transition startupComplete
                first PoweringUp
                accept StartupTimerExpired
                then SelfTest;

            transition selfTestPassed
                first SelfTest
                accept DiagnosticsPass
                then Ready;

            transition selfTestWarning
                first SelfTest
                accept DiagnosticsWarning
                then Degraded;

            transition selfTestFailed
                first SelfTest
                accept DiagnosticsFail
                then Failed;

            transition contactBegins
                first Ready
                accept ContactDetected
                then Sensing;

            transition contactEnds
                first Sensing
                accept ContactReleased
                then Ready;

            transition sensingWarning
                first Sensing
                accept MeasurementConfidenceLow
                then Degraded;

            transition degradedRecovered
                first Degraded
                accept DiagnosticsPass
                then Ready;

            transition hardFault
                first Ready
                accept CriticalFault
                then Failed;

            transition sensingFault
                first Sensing
                accept CriticalFault
                then Failed;

            transition powerRemoved
                first Ready
                accept PowerRemoved
                then Unpowered;
        }

        exhibit stateMachine : UnitOperatingStateMachine;
    }

    requirement def MeasureContactForceRequirement {
        subject sensingUnit : TactileSensingUnit;

        require constraint {
            sensingUnit.measurementRangeForceMin <= 0.0 [SI::newton] and
            sensingUnit.measurementRangeForceMax >= 50.0 [SI::newton]
        }

