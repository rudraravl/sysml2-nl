        part signalConditioner : SignalConditioner;
        part adc : AnalogToDigitalConverter;
        part processor : MeasurementProcessor;
        part powerSupply : RegulatedPowerSupply;

        connect contactInterface to tactileSensor.contactPort;
        connect tactileSensor.analogOut to signalConditioner.analogIn;
        connect signalConditioner.conditionedOut to adc.analogIn;
        connect adc.sampleOut to processor.sampleIn;
        connect processor.measurementOut to measurementOutput;
        connect processor.diagnosticOut to diagnosticOutput;

        connect powerInput to powerSupply.externalPower;
        connect powerSupply.sensorPower to tactileSensor.powerIn;
        connect powerSupply.electronicsPower to signalConditioner.powerIn;
        connect powerSupply.electronicsPower to adc.powerIn;

        action performMeasurementCycle {
            in item contact : ContactStimulus;
            out item measurement : TactileMeasurement;
            out item status : DiagnosticStatus;

            first tactileSensor.transduceContact(contact, rawSignal);
            then signalConditioner.amplifyAndFilter(rawSignal, conditionedSignal);
            then adc.convert(conditionedSignal, digitalSample);
            then processor.compensateAndValidate(digitalSample, measurement, status);
        }

        state def UnitOperatingStateMachine {
            state initial Unpowered;

            state PoweringUp;
            state SelfTest;
            state Ready;
            state Sensing;
            state Degraded;
            state Failed;

