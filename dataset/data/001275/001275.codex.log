        subject sensingUnit : TactileSensingUnit;

        require constraint {
            sensingUnit.outputUpdateRate >= 500.0 [SI::hertz]
        }

        doc /* The sensing unit shall publish validated tactile measurements at no less than 500 Hz while sensing contact. */
    }

