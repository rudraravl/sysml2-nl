    }

    requirement def MeasureContactPressureRequirement {
        subject sensingUnit : TactileSensingUnit;

        require constraint {
            sensingUnit.measurementRangePressureMax >= 125000.0 [SI::pascal]
        }

        require constraint {
            sensingUnit.accuracyPressure <= 1500.0 [SI::pascal]
        }

        doc /* The sensing unit shall derive contact pressure from the tactile sensor output and calibrated sensing area. */
    }

