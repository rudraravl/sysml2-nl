package TactileSensingUnitModel {

    import ScalarValues::*;
    import ISQ::*;
    import SI::*;

    attribute def ForceValue :> ISQ::force {
        unit = SI::newton;
    }

    attribute def PressureValue :> ISQ::pressure {
        unit = SI::pascal;
    }

    attribute def VoltageValue :> ISQ::voltage {
        unit = SI::volt;
    }

    attribute def CurrentValue :> ISQ::electricCurrent {
        unit = SI::ampere;
    }

    attribute def TemperatureValue :> ISQ::thermodynamicTemperature {
        unit = SI::kelvin;
    }

    attribute def TimeValue :> ISQ::time {
        unit = SI::second;
    }

    attribute def FrequencyValue :> ISQ::frequency {
        unit = SI::hertz;
    }

    attribute def DigitalCount :> ScalarValues::Integer;

    item def ContactStimulus {
        attribute normalForce : ForceValue;
        attribute contactPressure : PressureValue;
        attribute contactDuration : TimeValue;
        attribute contactTemperature : TemperatureValue;
    }

    item def AnalogTactileSignal {
        attribute bridgeVoltage : VoltageValue;
        attribute excitationCurrent : CurrentValue;
        attribute sensorTemperature : TemperatureValue;
        attribute timestamp : TimeValue;
    }

    item def FilteredTactileSample {
        attribute force : ForceValue;
        attribute pressure : PressureValue;
        attribute confidence : Real;
        attribute timestamp : TimeValue;
    }

    item def TactileMeasurement {
        attribute measuredForce : ForceValue;
        attribute measuredPressure : PressureValue;
        attribute sampleTime : TimeValue;
        attribute valid : Boolean;
    }

    item def DiagnosticStatus {
        attribute sensorConnected : Boolean;
        attribute adcHealthy : Boolean;
        attribute calibrationValid : Boolean;
        attribute overRangeDetected : Boolean;
        attribute statusCode : DigitalCount;
    }

    port def ContactSurfacePort {
        in item contact : ContactStimulus;
    }

    port def AnalogSignalPort {
        out item signal : AnalogTactileSignal;
    }

    port def AnalogInputPort {
        in item signal : AnalogTactileSignal;
    }

    port def DigitalSamplePort {
        out item sample : FilteredTactileSample;
    }

    port def MeasurementOutputPort {
        out item measurement : TactileMeasurement;
    }

    port def DiagnosticPort {
        out item status : DiagnosticStatus;
    }

    port def PowerInputPort {
        in attribute supplyVoltage : VoltageValue;
        in attribute supplyCurrent : CurrentValue;
    }

    port def PowerOutputPort {
        out attribute regulatedVoltage : VoltageValue;
        out attribute availableCurrent : CurrentValue;
    }

    part def TactileSensor {
        attribute sensingArea = 0.0004 [SI::squareMetre];
        attribute forceRangeMin = 0.0 [SI::newton];
        attribute forceRangeMax = 50.0 [SI::newton];
        attribute pressureRangeMax = 125000.0 [SI::pascal];
        attribute sensitivity = 0.08 [SI::volt / SI::newton];
        attribute responseTime = 0.008 [SI::second];
        attribute operatingTemperatureMin = 253.15 [SI::kelvin];
        attribute operatingTemperatureMax = 358.15 [SI::kelvin];

        port contactPort : ContactSurfacePort;
        port analogOut : AnalogSignalPort;
        port powerIn : PowerInputPort;

        action transduceContact {
            in item stimulus : ContactStimulus;
            out item analog : AnalogTactileSignal;

            constraint forceWithinSensorRange {
                stimulus.normalForce >= forceRangeMin and stimulus.normalForce <= forceRangeMax
            }

            constraint pressureWithinSensorRange {
                stimulus.contactPressure >= 0.0 [SI::pascal] and stimulus.contactPressure <= pressureRangeMax
            }
        }
    }

    part def SignalConditioner {
        attribute gain : Real = 12.5;
        attribute lowPassCutoff = 120.0 [SI::hertz];
        attribute noiseFloor = 0.015 [SI::volt];
        attribute outputVoltageMin = 0.0 [SI::volt];
        attribute outputVoltageMax = 3.3 [SI::volt];

        port analogIn : AnalogInputPort;
        port conditionedOut : AnalogSignalPort;
        port powerIn : PowerInputPort;

        action amplifyAndFilter {
            in item rawSignal : AnalogTactileSignal;
            out item conditionedSignal : AnalogTactileSignal;
        }
    }

    part def AnalogToDigitalConverter {
        attribute resolutionBits : DigitalCount = 16;
        attribute referenceVoltage = 3.3 [SI::volt];
        attribute sampleRate = 1000.0 [SI::hertz];
        attribute conversionLatency = 0.00025 [SI::second];

        port analogIn : AnalogInputPort;
        port sampleOut : DigitalSamplePort;
        port powerIn : PowerInputPort;

        action convert {
            in item conditionedSignal : AnalogTactileSignal;
            out item digitalSample : FilteredTactileSample;
        }
    }

    part def MeasurementProcessor {
        attribute calibrationOffsetForce = 0.0 [SI::newton];
        attribute calibrationScaleForce : Real = 1.0;
        attribute calibrationOffsetPressure = 0.0 [SI::pascal];
        attribute calibrationScalePressure : Real = 1.0;
        attribute minimumConfidence : Real = 0.95;
        attribute measurementPeriod = 0.001 [SI::second];

        port sampleIn {
            in item sample : FilteredTactileSample;
        }

        port measurementOut : MeasurementOutputPort;
        port diagnosticOut : DiagnosticPort;

        action compensateAndValidate {
            in item sample : FilteredTactileSample;
            out item measurement : TactileMeasurement;
            out item status : DiagnosticStatus;

            constraint confidenceAccepted {
                sample.confidence >= minimumConfidence
            }
        }

        state def ProcessorStateMachine {
            state initial Off;

            state Idle;
            state Calibrating;
            state Measuring;
            state Fault;

            transition first Off then Idle;

            transition idleToCalibrating
                first Idle
                accept CalibrateCommand
                then Calibrating;

            transition calibrationComplete
                first Calibrating
                accept CalibrationValid
                then Idle;

            transition idleToMeasuring
                first Idle
                accept ContactDetected
                then Measuring;

            transition measuringToIdle
                first Measuring
                accept ContactReleased
                then Idle;

            transition measuringFault
                first Measuring
                accept InvalidMeasurement
                then Fault;

            transition calibrationFault
                first Calibrating
                accept CalibrationInvalid
                then Fault;

            transition resetFault
                first Fault
                accept ResetCommand
                then Idle;
        }

        exhibit stateMachine : ProcessorStateMachine;
    }

    part def RegulatedPowerSupply {
        attribute inputVoltageNominal = 5.0 [SI::volt];
        attribute sensorRailVoltage = 3.3 [SI::volt];
        attribute maxOutputCurrent = 0.2 [SI::ampere];
        attribute rippleVoltageMax = 0.01 [SI::volt];

        port externalPower : PowerInputPort;
        port sensorPower : PowerOutputPort;
        port electronicsPower : PowerOutputPort;

        action regulatePower {
            in attribute supplyVoltage : VoltageValue;
            out attribute regulatedVoltage : VoltageValue;
        }
    }

    part def TactileSensingUnit {
        attribute measurementRangeForceMin = 0.0 [SI::newton];
        attribute measurementRangeForceMax = 50.0 [SI::newton];
        attribute measurementRangePressureMax = 125000.0 [SI::pascal];
        attribute accuracyForce = 0.5 [SI::newton];
        attribute accuracyPressure = 1500.0 [SI::pascal];
        attribute outputUpdateRate = 500.0 [SI::hertz];
        attribute startupTimeMax = 0.5 [SI::second];

        port contactInterface : ContactSurfacePort;
        port powerInput : PowerInputPort;
        port measurementOutput : MeasurementOutputPort;
        port diagnosticOutput : DiagnosticPort;

