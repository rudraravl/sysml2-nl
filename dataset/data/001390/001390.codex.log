  port def ScorePort {
    out item scoreCard : ScoreCard;
  }

  port def ReportOutputPort {
    out item report : CritiqueReport;
  }

  part def ArtifactRepository {
    port artifactIn : ArtifactInputPort;
    port artifactOut {
