                accept item power : ElectricalPower
                if power.voltage >= inputVoltageMin
                then Regulating;
        }
    }

    part def DigitalController {
        attribute activeOutputDataRate : Frequency = 100.0 [SI::hertz];
        attribute measurementRange : MagneticFluxDensity = 0.008 [SI::tesla];
        attribute lowPassCutoff : Frequency = 40.0 [SI::hertz];
        attribute warmupTime : TimeDuration = 0.025 [SI::second];

        port configurationIn : ConfigurationPort;
        port sampleIn {
            in item measurement : CalibratedMagneticField;
        }
        port measurementOut : MagneticMeasurementOutputPort;
        port statusOut : StatusOutputPort;

        action manageMeasurementCycle {
            first initializeRegisters;
            then waitForSensorReady;
            then requestSample;
            then receiveCalibratedField;
            then applyOutputRateLimit;
            then publishFieldMeasurement;
            then done;

            action initializeRegisters;
            action waitForSensorReady;
            action requestSample;
            action receiveCalibratedField;
            action applyOutputRateLimit;
            action publishFieldMeasurement;
        }

        state controllerState {
            state Boot;
            state Configure;
            state Idle;
            state Acquire;
            state Publish;
            state Diagnostics;
            state Fault;

            entry; then Boot;

            transition bootComplete
                first Boot
                after warmupTime
                then Configure;

            transition configured
                first Configure
                accept item command : ConfigurationCommand
                then Idle;

            transition acquireSample
                first Idle
                after 0.010 [SI::second]
                then Acquire;

            transition publishSample
                first Acquire
                accept item measurement : CalibratedMagneticField
                if measurement.valid
                then Publish;

            transition publishComplete
                first Publish
                then Idle;

            transition runDiagnostics
                first Idle
                after 1.000 [SI::second]
                then Diagnostics;

            transition diagnosticsComplete
                first Diagnostics
                then Idle;

            transition controllerFault
                first Acquire
                if statusOut.status.communicationFault or statusOut.status.supplyFault
                then Fault;
        }
    }

    part def MagneticSensingUnit {
        attribute specifiedRange : MagneticFluxDensity = 0.006 [SI::tesla];
        attribute maximumTotalError : MagneticFluxDensity = 0.0000008 [SI::tesla];
        attribute minimumOutputRate : Frequency = 50.0 [SI::hertz];
        attribute maximumStartupTime : TimeDuration = 0.100 [SI::second];

        port fieldInput : MagneticFieldInputPort;
        port powerInput : PowerInputPort;
        port configurationInput : ConfigurationPort;
        port magneticMeasurementOutput : MagneticMeasurementOutputPort;
        port diagnosticOutput : StatusOutputPort;

        part regulator : PowerRegulator;
        part memsSensor : MEMSMagneticFieldSensor;
        part analogFrontEnd : AnalogFrontEnd;
        part adc : AnalogToDigitalConverter;
        part calibrationProcessor : CalibrationProcessor;
        part controller : DigitalController;

        connect powerInput to regulator.externalPower;
        connect regulator.regulatedPower to memsSensor.electricalPower;
        connect regulator.regulatedPower to analogFrontEnd.powerIn;

        connect fieldInput to memsSensor.magneticInput;
        connect memsSensor.rawSampleOut to analogFrontEnd.rawSensorIn;
        connect analogFrontEnd.conditionedSampleOut to adc.analogSampleIn;
        connect adc.digitalSampleOut to calibrationProcessor.digitalSampleIn;
        connect calibrationProcessor.calibratedOut to controller.sampleIn;
        connect controller.measurementOut to magneticMeasurementOutput;

        connect configurationInput to controller.configurationIn;

        connect regulator.statusOut to diagnosticOutput;
        connect memsSensor.healthOut to diagnosticOutput;
        connect adc.statusOut to diagnosticOutput;
        connect calibrationProcessor.statusOut to diagnosticOutput;
        connect controller.statusOut to diagnosticOutput;

        action measureMagneticField {
            in item environmentalField : MagneticFieldVector;
            in item supply : ElectricalPower;
            in item configuration : ConfigurationCommand;
            out item reportedField : CalibratedMagneticField;
            out item diagnostic : DiagnosticStatus;

            first applyPower;
            then configureOutputRangeAndRate;
            then stabilizeMEMSSensor;
            then captureMagneticField;
            then conditionAnalogResponse;
            then digitizeResponse;
            then calibrateFieldVector;
            then verifyMeasurementQuality;
            then publishMeasurementAndStatus;
            then done;

            action applyPower;
            action configureOutputRangeAndRate;
            action stabilizeMEMSSensor;
            action captureMagneticField;
            action conditionAnalogResponse;
            action digitizeResponse;
            action calibrateFieldVector;
            action verifyMeasurementQuality;
            action publishMeasurementAndStatus;
        }

        state unitOperationalState {
            state Unpowered;
            state Startup;
            state Configured;
            state Measuring;
            state Reporting;
            state Degraded;
            state Failed;

            entry; then Unpowered;

            transition powerApplied
                first Unpowered
                accept item power : ElectricalPower
                if power.voltage >= regulator.inputVoltageMin and power.voltage <= regulator.inputVoltageMax
                then Startup;

            transition startupComplete
                first Startup
                after maximumStartupTime
                then Configured;

            transition configurationAccepted
                first Configured
                accept item command : ConfigurationCommand
                then Measuring;

            transition sampleValid
                first Measuring
                accept item measurement : CalibratedMagneticField
                if measurement.valid
                then Reporting;

            transition reportComplete
                first Reporting
                then Measuring;

            transition saturationOrNoise
                first Measuring
                if diagnosticOutput.status.saturationDetected or diagnosticOutput.status.noiseLevel < 40.0
                then Degraded;

            transition degradedRecovered
                first Degraded
                if not diagnosticOutput.status.saturationDetected and diagnosticOutput.status.noiseLevel >= 40.0
                then Measuring;

            transition unrecoverableFault
                first Startup
                if diagnosticOutput.status.supplyFault or diagnosticOutput.status.communicationFault
                then Failed;
        }
    }

    requirement def MagneticFieldMeasurementRequirement {
        subject sensingUnit : MagneticSensingUnit;

        require constraint {
            sensingUnit.specifiedRange >= 0.006 [SI::tesla]
        }

        require constraint {
            sensingUnit.maximumTotalError <= 0.0000008 [SI::tesla]
        }

        require constraint {
            sensingUnit.minimumOutputRate >= 50.0 [SI::hertz]
        }
    }

    requirement def MEMSSensorRequirement {
        subject sensor : MEMSMagneticFieldSensor;

        require constraint {
            sensor.fullScaleRange >= 0.006 [SI::tesla]
        }

        require constraint {
            sensor.noiseDensity <= 0.0000002 [SI::tesla]
        }
    }

    requirement def StartupRequirement {
        subject sensingUnit : MagneticSensingUnit;

        require constraint {
            sensingUnit.maximumStartupTime <= 0.100 [SI::second]
        }
    }

    requirement def SupplyRequirement {
        subject regulator : PowerRegulator;

        require constraint {
            regulator.inputVoltageMin <= 3.0 [SI::volt]
        }

        require constraint {
            regulator.inputVoltageMax >= 5.0 [SI::volt]
        }

        require constraint {
            regulator.regulatedVoltage == 3.3 [SI::volt]
        }
    }

    requirement def DiagnosticRequirement {
        subject sensingUnit : MagneticSensingUnit;

        require constraint {
            sensingUnit.diagnosticOutput.status.sensorReady implies
            not sensingUnit.diagnosticOutput.status.supplyFault
        }

        require constraint {
            sensingUnit.diagnosticOutput.status.calibrationValid implies
            not sensingUnit.diagnosticOutput.status.saturationDetected
        }
    }

    part magneticSensingUnit : MagneticSensingUnit;

    requirement magneticMeasurementRequirement : MagneticFieldMeasurementRequirement {
        subject sensingUnit = magneticSensingUnit;
    }

    requirement memsSensorRequirement : MEMSSensorRequirement {
        subject sensor = magneticSensingUnit.memsSensor;
    }

    requirement startupRequirement : StartupRequirement {
        subject sensingUnit = magneticSensingUnit;
    }

    requirement supplyRequirement : SupplyRequirement {
        subject regulator = magneticSensingUnit.regulator;
    }

    requirement diagnosticRequirement : DiagnosticRequirement {
        subject sensingUnit = magneticSensingUnit;
    }

    satisfy magneticMeasurementRequirement by magneticSensingUnit;
    satisfy memsSensorRequirement by magneticSensingUnit.memsSensor;
    satisfy startupRequirement by magneticSensingUnit;
    satisfy supplyRequirement by magneticSensingUnit.regulator;
    satisfy diagnosticRequirement by magneticSensingUnit;
}
