            then reconstruct : processor.reconstructDepthProfile;
            then render : displayStorage.renderImage;
            then store : displayStorage.storeImage;
            then status : controller.reportStatus;
        }

        state def OperatingStateMachine {
            state off;
            state initializing;
            state ready;
            state scanning;
            state processing;
            state displaying;
            state fault;

