        connect battery.powerOut to powerUnit.powerIn;
        connect powerUnit.logicPowerOut to sensor.powerIn;
        connect powerUnit.logicPowerOut to processor.powerIn;
        connect powerUnit.logicPowerOut to thermalMonitor.powerIn;
        connect powerUnit.opticalPowerOut to emitterArray.powerIn;
        connect powerUnit.projectorPowerOut to projector.powerIn;

