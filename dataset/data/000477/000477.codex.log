        port statusOut : StatusPort;
    }

    part def PatientTissue {
        attribute targetDepth : Distance = 5 [SI::millimetre];
        attribute nominalWorkingDistance : Distance = 300 [SI::millimetre];

        port illuminationIn : OpticalReceivePort;
        port reflectedOut : OpticalReceivePort;
        port overlayIn : ProjectionPort;
    }

    part def NearInfraredVeinFinder {
        attribute primaryFunction : ScalarValues::String =
            "Illuminate superficial tissue with near-infrared light, capture reflected contrast caused by hemoglobin absorption, process the image to locate subcutaneous veins, and project a visible vein map onto the skin to support peripheral venous access.";

