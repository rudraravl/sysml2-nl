            emitter.centerWavelength >= 760 [SI::nanometre] and
            emitter.centerWavelength <= 940 [SI::nanometre] and
            emitter.maximumSkinIrradiance <= 25 [SI::watt / SI::metre^2]
        }
    }

    requirement def RealTimeImageProcessingRequirement {
        doc
        /* The image processing path shall produce a registered vein map with latency low enough for hand-held clinical positioning. */

        subject processor : VeinImageProcessor;

        require constraint {
            processor.maximumProcessingLatency <= 0.1 [SI::second]
        }
    }

    requirement def ProjectionAlignmentRequirement {
        doc
        /* The visible projection module shall align the displayed vein overlay with the corresponding vein location on skin. */

        subject projector : VisibleProjectionModule;

        require constraint {
            projector.maximumAlignmentError <= 2.0 [SI::millimetre] and
            projector.projectionRefreshRate >= 30 [SI::hertz]
        }
    }

    requirement def ThermalSafetyRequirement {
        doc
        /* The system shall enter a thermal-limit state before emitter or projector surfaces exceed safe operating thresholds. */

        subject monitor : ThermalMonitor;

        require constraint {
            monitor.emitterShutdownTemperature <= 42 [SI::degreeCelsius] and
            monitor.projectorShutdownTemperature <= 45 [SI::degreeCelsius]
        }
    }

    requirement def PortablePowerRequirement {
        doc
        /* The system shall operate from an internal rechargeable battery with regulated outputs for logic, illumination, and projection subsystems. */

        subject battery : BatteryPack;

        require constraint {
            battery.nominalVoltage >= 7.0 [SI::volt] and
            battery.capacity >= 3.0 [SI::ampereHour]
        }
    }

    satisfy PrimaryFunctionRequirement by NearInfraredVeinFinder;
    satisfy NearInfraredIlluminationRequirement by NearInfraredVeinFinder::emitterArray;
    satisfy RealTimeImageProcessingRequirement by NearInfraredVeinFinder::processor;
    satisfy ProjectionAlignmentRequirement by NearInfraredVeinFinder::projector;
    satisfy ThermalSafetyRequirement by NearInfraredVeinFinder::thermalMonitor;
    satisfy PortablePowerRequirement by NearInfraredVeinFinder::battery;
}
