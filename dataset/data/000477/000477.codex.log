        part powerUnit : PowerManagementUnit;
        part emitterArray : NearInfraredEmitterArray;
        part filter : OpticalFilter;
        part sensor : ImageSensor;
        part processor : VeinImageProcessor;
        part projector : VisibleProjectionModule;
        part userInterface : UserInterface;
        part thermalMonitor : ThermalMonitor;
        part tissue : PatientTissue;

