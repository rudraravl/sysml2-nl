            action energizeMotor;
            action monitorTravel;
            action stopMotor;
            action reportStatus;
        }

        state def ShutterState {
            state stopped;
            state opening;
            state closing;
            state fullyOpen;
            state fullyClosed;
            state faulted;

            transition first stopped;
            transition stopped then opening accept DeviceCommand if position < 100 [%];
            transition stopped then closing accept DeviceCommand if position > 0 [%];
            transition opening then fullyOpen accept after 20 [s] if position == 100 [%];
            transition closing then fullyClosed accept after 20 [s] if position == 0 [%];
            transition opening then stopped accept DeviceCommand;
            transition closing then stopped accept DeviceCommand;
            transition stopped then faulted if health == DeviceHealth::faulted;
            transition opening then faulted if health == DeviceHealth::faulted;
            transition closing then faulted if health == DeviceHealth::faulted;
        }

        exhibit state shutterState: ShutterState;
    }

    part def ThermostatController {
        attribute deviceId: DeviceIdentifier;
        attribute address: OpenWebNetAddress;
        attribute zone: ZoneIdentifier;
        attribute measuredTemperature: Celsius;
        attribute setpoint: Celsius;
        attribute comfortBand: Celsius = 0.5 [degC];
        attribute health: DeviceHealth;

        port controlPort: DeviceCommandPort;

        action regulateTemperature {
            in item command: DeviceCommand;
            out item status: TemperatureStatus;

            first start;
            then readSetpoint;
            then compareTemperature;
            then commandHeatingCooling;
            then reportStatus;
            then done;

            action readSetpoint;
            action compareTemperature;
            action commandHeatingCooling;
            action reportStatus;
        }

        state def ThermalControlState {
            state idle;
            state heating;
            state cooling;
            state faulted;

            transition first idle;
            transition idle then heating if measuredTemperature < setpoint - comfortBand;
            transition idle then cooling if measuredTemperature > setpoint + comfortBand;
            transition heating then idle if measuredTemperature >= setpoint;
            transition cooling then idle if measuredTemperature <= setpoint;
            transition idle then faulted if health == DeviceHealth::faulted;
            transition heating then faulted if health == DeviceHealth::faulted;
            transition cooling then faulted if health == DeviceHealth::faulted;
        }

        exhibit state thermalState: ThermalControlState;
    }

    part def EnergyMeter {
        attribute deviceId: DeviceIdentifier;
        attribute address: OpenWebNetAddress;
        attribute zone: ZoneIdentifier;
        attribute measuredVoltage: VoltAC;
        attribute measuredPower: Watt;
        attribute health: DeviceHealth;

        port controlPort: DeviceCommandPort;

        action reportEnergy {
            out item status: EnergyStatus;

            first start;
            then sampleVoltage;
            then sampleCurrentDerivedPower;
            then accumulateDailyEnergy;
            then publishEnergyStatus;
            then done;

            action sampleVoltage;
            action sampleCurrentDerivedPower;
            action accumulateDailyEnergy;
            action publishEnergyStatus;
        }
    }

    part def OpenWebNetInstallation {
        attribute installationName: String = "OpenWebNet Integrated Building Control System";
        attribute primaryFunction: String =
            "Provide high-level coordination, monitoring, and control of building automation devices by translating user intentions into OpenWebNet frames and routing device status back to users and supervisory services.";
        attribute nominalBusVoltage: VoltAC = 230 [V];
        attribute commandResponseObjective: Millisecond = 500 [ms];

        part gateway: OpenWebNetGateway {
            attribute gatewayAddress = "*#13**";
            attribute supportedDomains = (
                OpenWebNetDomain::lighting,
                OpenWebNetDomain::automation,
                OpenWebNetDomain::temperatureControl,
                OpenWebNetDomain::energyManagement,
                OpenWebNetDomain::diagnostics
            );
        }

        part livingRoomLight: LightingActuator {
            attribute deviceId = "LR-LIGHT-01";
            attribute address = "*1*11##";
            attribute zone = "LivingRoom";
            attribute ratedPower = 18 [W];
            attribute currentLevel = 0 [%];
            attribute health = DeviceHealth::online;
        }

        part kitchenLight: LightingActuator {
            attribute deviceId = "KT-LIGHT-01";
            attribute address = "*1*21##";
            attribute zone = "Kitchen";
            attribute ratedPower = 24 [W];
            attribute currentLevel = 0 [%];
            attribute health = DeviceHealth::online;
        }

        part livingRoomShutter: ShutterActuator {
            attribute deviceId = "LR-SHUTTER-01";
            attribute address = "*2*31##";
            attribute zone = "LivingRoom";
            attribute position = 50 [%];
            attribute motorPower = 120 [W];
            attribute health = DeviceHealth::online;
        }

        part hallwayThermostat: ThermostatController {
            attribute deviceId = "HW-THERMO-01";
            attribute address = "*4*41##";
            attribute zone = "Hallway";
            attribute measuredTemperature = 21.0 [degC];
            attribute setpoint = 21.5 [degC];
            attribute health = DeviceHealth::online;
        }

        part mainEnergyMeter: EnergyMeter {
            attribute deviceId = "MAIN-METER-01";
            attribute address = "*18*51##";
            attribute zone = "MainPanel";
            attribute measuredVoltage = 230 [V];
            attribute measuredPower = 650 [W];
            attribute health = DeviceHealth::online;
        }

        connect gateway.busPort to livingRoomLight.controlPort;
        connect gateway.busPort to kitchenLight.controlPort;
        connect gateway.busPort to livingRoomShutter.controlPort;
        connect gateway.busPort to hallwayThermostat.controlPort;
        connect gateway.busPort to mainEnergyMeter.controlPort;

        action executeUserRequest {
            in item intent: UserIntent;
            out item resultingStatus: DeviceStatus;

            first receiveIntent;
            then translateIntentViaGateway;
            then transmitOpenWebNetFrame;
            then actuateTargetDevice;
            then collectDeviceStatus;
            then returnStatus;
            then done;

            action receiveIntent;
            action translateIntentViaGateway;
            action transmitOpenWebNetFrame;
            action actuateTargetDevice;
            action collectDeviceStatus;
            action returnStatus;
        }

        action synchronizeInstallationStatus {
            out item statusSummary: DeviceStatus[1..*];

            first start;
            then pollLighting;
            then pollAutomation;
            then pollTemperature;
            then pollEnergy;
            then aggregateStatus;
            then done;

            action pollLighting;
            action pollAutomation;
            action pollTemperature;
            action pollEnergy;
            action aggregateStatus;
        }
    }

    requirement def PrimaryFunctionRequirement {
        subject installation: OpenWebNetInstallation;

        doc
            /*
             The system shall provide a unified OpenWebNet-based building automation
             function that accepts user or supervisory intents, converts them to
             valid OpenWebNet command frames, routes those frames to addressed
             building devices, and reports device status for monitoring and feedback.
             */

        require constraint {
            installation.commandResponseObjective <= 500 [ms]
        }
    }

    requirement def OpenWebNetFrameValidityRequirement {
        subject frame: OpenWebNetFrame;

        doc
            /*
             Every command frame transmitted by the gateway shall include a source,
             destination, domain, payload, priority, and valid checksum indication.
             */

        require constraint {
            frame.checksumValid == true
        }
    }

    requirement def DeviceStatusReportingRequirement {
        subject deviceStatus: DeviceStatus;

        doc
            /*
             Each controlled device shall report its address, domain, health state,
             and latest update time after command processing or diagnostic polling.
             */

        require constraint {
            deviceStatus.lastUpdateTime >= 0 [s]
        }
    }

    requirement def LightingControlRequirement {
        subject light: LightingActuator;

        doc
            /*
             Lighting actuators shall support switching and dimming commands over
             OpenWebNet and shall report resulting light level and health state.
             */

        require constraint {
            light.currentLevel >= 0 [%] and light.currentLevel <= 100 [%]
        }
    }

    requirement def ShutterControlRequirement {
        subject shutter: ShutterActuator;

        doc
            /*
             Shutter actuators shall support OpenWebNet position commands and shall
             stop within the requested travel range between fully closed and fully open.
             */

        require constraint {
            shutter.position >= 0 [%] and shutter.position <= 100 [%]
        }
    }

    requirement def TemperatureControlRequirement {
        subject thermostat: ThermostatController;

        doc
            /*
             Thermostat controllers shall use OpenWebNet commands and reports to
             maintain zone temperature within a configurable comfort band around
             the requested setpoint.
             */

        require constraint {
            thermostat.comfortBand > 0 [degC]
        }
    }

    requirement def EnergyMonitoringRequirement {
        subject meter: EnergyMeter;

        doc
            /*
             The energy meter shall publish voltage and active power measurements
             through the OpenWebNet system for supervisory monitoring.
             */

        require constraint {
            meter.measuredVoltage > 0 [V] and meter.measuredPower >= 0 [W]
        }
    }

    satisfy PrimaryFunctionRequirement by OpenWebNetInstallation;
    satisfy LightingControlRequirement by OpenWebNetInstallation::livingRoomLight;
    satisfy LightingControlRequirement by OpenWebNetInstallation::kitchenLight;
    satisfy ShutterControlRequirement by OpenWebNetInstallation::livingRoomShutter;
    satisfy TemperatureControlRequirement by OpenWebNetInstallation::hallwayThermostat;
    satisfy EnergyMonitoringRequirement by OpenWebNetInstallation::mainEnergyMeter;
}
