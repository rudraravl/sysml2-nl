    flow dose.washSolution to heat.waterIn;
    flow heat.heatedWater to agitate.washSolution;
    flow agitate.loosenedSoilLoad to rinse.washedLoad;
    flow rinse.rinsedLoad to spin.wetLoad;
    flow spin.dampCleanLoad to cleanLaundry;
    flow rinse.rinseWaste to wasteWater;
  }

  state def WashingMachineState {
    entry; then Off;

