    attribute maximumWaterUsePerCycle : VolumeL = 80.0;
    attribute maximumSpinSpeed : SpeedRpm = 1200.0;
    attribute maximumWashTemperature : TemperatureC = 60.0;
    attribute standbyPower : PowerW = 2.0;

