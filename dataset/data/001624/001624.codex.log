    connect tub.drainOut to drainPump.inlet;
    connect drainPump.outlet to householdDrain;

    connect laundryDoor to door.laundryAccess;
    connect door.laundryAccess to drum.laundryAccess;

    connect userPanel to controller.ui;
    connect controller.actuatorControl to motor.control;
    connect controller.actuatorControl to inletValve.control;
    connect controller.actuatorControl to drainPump.control;
    connect controller.actuatorControl to heater.control;
    connect sensors.feedback to controller.sensorFeedback;
  }

  requirement def PrimaryFunctionRequirement {
    subject machine : WashingMachine;

    doc /*
      The washing machine shall clean a user-provided laundry load by accepting soiled laundry,
      mixing water and detergent, agitating the load, rinsing away soil and detergent, extracting
      excess water by spinning, and returning a damp clean load to the user.
    */

    require constraint {
      machine.maximumDryLoad >= 8.0 and
      machine.maximumWaterUsePerCycle <= 80.0 and
      machine.maximumSpinSpeed >= 1000.0
    }
  }

  requirement def DoorSafetyRequirement {
    subject machine : WashingMachine;

    doc /*
      The washing machine shall prevent drum rotation above 50 rpm unless the door is closed and locked.
    */

    require constraint {
      machine.door.closed and machine.door.locked or machine.drum.currentSpeed <= 50.0
    }
  }

  requirement def WaterContainmentRequirement {
    subject machine : WashingMachine;

    doc /*
      The washing machine shall contain wash and rinse water within the tub and door seal during all fill,
      wash, rinse, drain, and spin states.
    */

    require constraint {
      machine.door.leakSealIntegrity >= 0.95 and
      machine.tub.currentWaterVolume <= machine.tub.maximumWaterVolume
    }
  }

  requirement def TemperatureProtectionRequirement {
    subject machine : WashingMachine;

    doc /*
      The washing machine shall not heat wash water above the selected program limit or the fabric care limit.
    */

    require constraint {
      machine.tub.waterTemperature <= machine.maximumWashTemperature
    }
  }

  requirement def LoadCapacityRequirement {
    subject machine : WashingMachine;

    doc /*
      The washing machine shall process a dry laundry load up to the rated capacity without exceeding
      the rated motor power or tub water volume.
    */

    require constraint {
      machine.maximumDryLoad == machine.drum.ratedDryLoadCapacity and
      machine.motor.ratedPower <= 650.0
    }
  }

  part washingMachineSystem : WashingMachine;

  satisfy PrimaryFunctionRequirement by washingMachineSystem;
  satisfy DoorSafetyRequirement by washingMachineSystem;
  satisfy WaterContainmentRequirement by washingMachineSystem;
  satisfy TemperatureProtectionRequirement by washingMachineSystem;
  satisfy LoadCapacityRequirement by washingMachineSystem;
}
