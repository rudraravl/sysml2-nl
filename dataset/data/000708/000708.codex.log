        connect liftPort to bridle.liftPort;
        connect inspectionPort to label.inspectionPort;

        action secureCasualty {
            in casualty : Casualty;
            in condition : EnvironmentalCondition;
            out secured : SecuredCasualty;

            first start;
            then inspectStretcher;
            then positionStretcher;
            then placeCasualtyOnBody;
            then supportHeadAndFeet;
            then wrapFlexibleBody;
            then fastenChestStrap;
            then fastenPelvisStrap;
            then fastenThighAndLegStraps;
            then fastenForeheadStrap;
            then verifyImmobilization;
            then outputSecuredCasualty;
            then done;

            action inspectStretcher {
                out inspection : InspectionStatus;
            }

            action positionStretcher {
                in confinedSpace : Boolean = condition.confinedSpace;
            }

            action placeCasualtyOnBody {
                in bodyMass : MassValue = casualty.bodyMass;
            }

            action supportHeadAndFeet;
            action wrapFlexibleBody;
            action fastenChestStrap;
            action fastenPelvisStrap;
            action fastenThighAndLegStraps;
            action fastenForeheadStrap;

            action verifyImmobilization {
                out immobilized : Boolean;
            }

            action outputSecuredCasualty {
                out secured : SecuredCasualty {
                    :>> containedMass = casualty.bodyMass;
                    :>> immobilized = true;
                    :>> readyForLift = true;
                }
            }
        }

        action transportCasualty {
            in secured : SecuredCasualty;
            in command : RescueTeamCommand;
            out transported : Boolean;

            first selectTransportMode;
            then applyManualCarryOrHoist;
            then maintainCasualtyOrientation;
            then monitorStrapSecurity;
            then deliverCasualtyToHandoverPoint;
            then done;

            action selectTransportMode {
                out mode : String;
            }

            action applyManualCarryOrHoist {
                in loadMass : MassValue = secured.containedMass;
            }

            action maintainCasualtyOrientation {
                attribute maximumTilt : AngleValue = (scalar = 30.0, unit = "deg");
            }

            action monitorStrapSecurity;
            action deliverCasualtyToHandoverPoint;
        }

        state def OperationalStateMachine {
            state stowed;
            state deployed;
            state loading;
            state secured;
            state lifting;
            state carrying;
            state handover;
            state outOfService;

            transition initial then stowed;

            transition stowed_to_deployed
                first stowed
                accept command : RescueTeamCommand
                if command.commandText == "deploy"
                then deployed;

            transition deployed_to_loading
                first deployed
                accept casualty : Casualty
                if casualty.immobilizationRequired
                then loading;

            transition loading_to_secured
                first loading
                accept securedCasualty : SecuredCasualty
                if securedCasualty.immobilized and securedCasualty.readyForLift
                then secured;

            transition secured_to_lifting
                first secured
                accept command : RescueTeamCommand
                if command.commandText == "hoist"
                then lifting;

            transition secured_to_carrying
                first secured
                accept command : RescueTeamCommand
                if command.commandText == "carry"
                then carrying;

            transition lifting_to_handover
                first lifting
                accept command : RescueTeamCommand
                if command.commandText == "handover"
                then handover;

            transition carrying_to_handover
                first carrying
                accept command : RescueTeamCommand
                if command.commandText == "handover"
                then handover;

            transition any_to_outOfService
                first deployed
                accept status : InspectionStatus
                if not status.serviceable
                then outOfService;
        }
    }

    part def RescueOperation {
        attribute operationName : String = "Confined space casualty extraction using Neil Robertson stretcher";
        attribute objective : String = "Provide high-level casualty immobilization and transport capability where rigid stretchers are difficult to maneuver.";

        part stretcher : NeilRobertsonStretcher;
        part casualty : Casualty {
            :>> bodyMass = (scalar = 82.0, unit = "kg");
            :>> shoulderBreadth = (scalar = 0.48, unit = "m");
            :>> bodyLength = (scalar = 1.78, unit = "m");
            :>> injuryStatus = "suspected spinal or limb injury";
            :>> immobilizationRequired = true;
        }

        part environment : EnvironmentalCondition {
            :>> confinedSpace = true;
            :>> wetSurface = true;
            :>> ambientTemperature = 12.0;
        }

        connect stretcher.environmentPort.condition to environment;
        connect stretcher.casualtyPort.casualty to casualty;
    }

    requirement def PrimaryFunctionRequirement {
        doc /* The Neil Robertson stretcher system shall secure and immobilize a casualty for extraction from confined, vertical, or difficult access environments. */
        subject stretcher : NeilRobertsonStretcher;

        require constraint {
            stretcher.primaryFunction == "Immobilize, secure, and transport a casualty through confined or difficult access spaces while permitting manual carry, horizontal lift, or vertical hoist."
        }
    }

    requirement def CasualtyContainmentRequirement {
        doc /* The stretcher shall retain a casualty with a body mass up to 150 kg during manual carrying and hoisting. */
        subject stretcher : NeilRobertsonStretcher;

        require constraint {
            stretcher.operationalLoadRating.maxWorkingLoad.scalar >= 150.0
        }
    }

    requirement def ImmobilizationRequirement {
        doc /* The stretcher shall provide head, torso, pelvis, thigh, and lower leg restraint to reduce casualty motion during extraction. */
        subject stretcher : NeilRobertsonStretcher;

        require constraint {
            stretcher.straps.minimumNumberSecured >= 5
        }
    }

    requirement def ConfinedSpaceRequirement {
        doc /* The stretcher shall be flexible enough to wrap around the casualty and compact enough for use in confined access routes. */
        subject stretcher : NeilRobertsonStretcher;

        require constraint {
            stretcher.stowedDiameter.scalar <= 0.30 and stretcher.stowedLength.scalar <= 1.00
        }
    }

    requirement def HoistInterfaceRequirement {
        doc /* The stretcher shall provide rated lifting attachment points for vertical or horizontal rescue hoist operations. */
        subject stretcher : NeilRobertsonStretcher;

        require constraint {
            stretcher.bridle.verticalLiftPermitted and
            stretcher.bridle.horizontalLiftPermitted and
            stretcher.bridle.attachmentPointCount >= 4
        }
    }

    requirement def ManualCarryRequirement {
        doc /* The stretcher shall provide multiple handholds to permit coordinated manual carrying by rescue personnel. */
        subject stretcher : NeilRobertsonStretcher;

        require constraint {
            stretcher.handles.leftShoulderHandle.handleRating.scalar >= 1000.0 and
            stretcher.handles.rightShoulderHandle.handleRating.scalar >= 1000.0 and
            stretcher.handles.leftHipHandle.handleRating.scalar >= 1000.0 and
            stretcher.handles.rightHipHandle.handleRating.scalar >= 1000.0
        }
    }

    requirement def InspectionRequirement {
        doc /* The stretcher shall carry identification, rated load, and inspection status information before use. */
        subject stretcher : NeilRobertsonStretcher;

        require constraint {
            stretcher.label.ratedLoad.maxWorkingLoad.scalar >= 150.0
        }
    }

    satisfy PrimaryFunctionRequirement by NeilRobertsonStretcher;
    satisfy CasualtyContainmentRequirement by NeilRobertsonStretcher;
    satisfy ImmobilizationRequirement by NeilRobertsonStretcher;
    satisfy ConfinedSpaceRequirement by NeilRobertsonStretcher;
    satisfy HoistInterfaceRequirement by NeilRobertsonStretcher;
    satisfy ManualCarryRequirement by NeilRobertsonStretcher;
    satisfy InspectionRequirement by NeilRobertsonStretcher;
}
