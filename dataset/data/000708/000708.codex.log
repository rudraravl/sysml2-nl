    }

    part def NeilRobertsonStretcher {
        attribute primaryFunction : String = "Immobilize, secure, and transport a casualty through confined or difficult access spaces while permitting manual carry, horizontal lift, or vertical hoist.";
        attribute emptyMass : MassValue = (scalar = 8.0, unit = "kg");
        attribute stowedLength : LengthValue = (scalar = 0.95, unit = "m");
        attribute stowedDiameter : LengthValue = (scalar = 0.28, unit = "m");
        attribute operationalLoadRating : LoadRating;
        attribute reusable : Boolean = true;

