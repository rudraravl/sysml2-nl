        in item supportLoad : UserMotion;
    }

    port def GripPort {
        in item handForce : UserMotion;
    }

    port def ContactPort {
        out item surfaceContact : UserMotion;
    }

    action def ProvideCostumeProtection {
        in item ambientAir : AmbientAir;
        in item wearerMotion : UserMotion;
        out item filteredAir : FilteredAir;
        out item exhaledAir : ExhaledAir;
        out item costumeStatus : CostumeStatusSignal;

        action filterInhaledAir;
        action shieldBodyFromDroplets;
        action preserveFieldOfView;
        action supportHistoricalIdentification;
        action allowSpeechTransmission;
