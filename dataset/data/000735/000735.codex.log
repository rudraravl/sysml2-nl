        attribute dropletRepellency : FiltrationEfficiency = 88 [SI::percent];

        port collarSealPort : SealPort;
        port handSealPort : SealPort;
        port footSealPort : SealPort;
        port waistSupportPort : MechanicalSupportPort;
        port thermalVentPort : ThermalPort;

