        }

        require constraint {
            costume.totalMass <= 6.0 [SI::kilogram]
        }

        require constraint {
            costume.nominalUseDuration >= 120 [SI::minute]
        }
    }

    requirement def BreathingProtectionRequirement {
        subject mask : BeakedMask;

        require constraint {
            mask.inhalationFlowCapacity >= 40 [SI::litre / SI::minute]
        }

        require constraint {
            mask.filterEfficiency >= 90 [SI::percent]
        }
    }

    requirement def MobilityRequirement {
        subject interface : WearerInterface;

        require constraint {
            interface.minimumStrideAllowance >= 600 [SI::millimetre]
        }

        require constraint {
            interface.maximumHeadRotation >= 60 [SI::degree]
        }
    }

    requirement def CoverageRequirement {
        subject robe : OuterRobe;

        require constraint {
            robe.dropletRepellency >= 85 [SI::percent]
        }

        require constraint {
            robe.fabricThickness >= 1.0 [SI::millimetre]
        }
    }

    requirement def UseDurationRequirement {
        subject monitoring : CostumeMonitoringModule;

        require constraint {
            monitoring.batteryDuration >= 180 [SI::minute]
        }

        require constraint {
            monitoring.filterRemainingTime >= 90 [SI::minute]
        }
    }

    satisfy PrimaryFunctionRequirement by PlagueDoctorCostume;
    satisfy BreathingProtectionRequirement by BeakedMask;
    satisfy MobilityRequirement by WearerInterface;
    satisfy CoverageRequirement by OuterRobe;
    satisfy UseDurationRequirement by CostumeMonitoringModule;
}
