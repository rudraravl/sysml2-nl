        connect mask.filteredBreathPort to breathing;
        connect vision to mask.eyeLensPort;
        connect voice to mask.voiceOutletPort;
        connect heatRelease to robe.thermalVentPort;
        connect mobility to wearerInterface.motionInputPort;
        connect monitoring.statusPort to statusOut;

        connect hood.neckSealPort to mask.neckSealPort;
        connect hood.shoulderSealPort to robe.collarSealPort;
        connect robe.handSealPort to gloves.wristSealPort;
        connect robe.footSealPort to boots.ankleSealPort;
        connect belt.supportPort to robe.waistSupportPort;
        connect hat.headSupportPort to hood.hatSupportPort;
        connect cane.userGripPort to gloves.gripPort;

        perform action provideCostumeProtection;
        exhibit state costumeOperationalState;
    }

