    }

    part def OverlapClosure {
        attribute overlapWidth : ISQ::length = 90 [SI::millimetre];
    }

    part def PassiveVentilationSlits {
        attribute heatRejectionCapacity : ISQ::power = 45 [SI::watt];
        port heatPort : ThermalPort;
    }

    part def ProtectiveGloves {
        attribute gloveMass : Mass = 0.35 [SI::kilogram];
