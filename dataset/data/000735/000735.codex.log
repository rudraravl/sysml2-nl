        part mask : BeakedMask;
        part hood : ProtectiveHood;
        part robe : OuterRobe;
        part gloves : ProtectiveGloves;
        part boots : ProtectiveBoots;
        part hat : WideBrimHat;
        part belt : UtilityBelt;
        part cane : DistanceCane;
        part wearerInterface : WearerInterface;
