    }

    part def WideBrimHat {
        attribute brimRadius : ISQ::length = 220 [SI::millimetre];
        attribute hatMass : Mass = 0.4 [SI::kilogram];

        port headSupportPort : MechanicalSupportPort;
    }

    part def UtilityBelt {
        attribute beltMass : Mass = 0.25 [SI::kilogram];
        attribute pouchCount : ScalarValues::Integer = 3;

        port supportPort : MechanicalSupportPort;
    }

    part def DistanceCane {
        attribute caneLength : ISQ::length = 1.2 [SI::metre];
        attribute caneMass : Mass = 0.55 [SI::kilogram];

        port userGripPort : GripPort;
        port contactTipPort : ContactPort;
    }

    part def WearerInterface {
        attribute minimumStrideAllowance : ISQ::length = 650 [SI::millimetre];
