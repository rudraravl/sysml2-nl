            then switchSValveToCylinderA;
            then dischargeCylinderAWhileFillingCylinderB;
            then switchSValveToCylinderB;
        }

        state def SubsystemOperatingStates {
            state Deenergized;
            state Standby;
            state PumpingConcrete;
            state ReverseClearing;
            state PressureFault;
            state LowHopperFault;
            state EmergencyStop;

            transition first Deenergized then Standby
