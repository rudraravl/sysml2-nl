            transition first Ready then Pumping
                accept ControlCommand
                if commandInput.command.enablePump and commandInput.command.requestedFlowRate >= minimumFlowRate
                do regulateMotorSpeed;

            transition first Pumping then Reverse
                accept ControlCommand
                if commandInput.command.reverseStroke
                do reverseHydraulicStroke;

            transition first Reverse then Ready
                accept after 2 [s]
                do stopReverseStroke;

            transition first Pumping then Fault
                if pressureFeedback.value > 8000000
                do openPressureRelief;

            transition first Pumping then Fault
                if levelFeedback.value < 0.15
                do stopPumpForLowLevel;

            transition first Off then EmergencyStopped
                accept ControlCommand
                if commandInput.command.emergencyStop
                do deenergizeAllActuators;

            transition first Priming then EmergencyStopped
                accept ControlCommand
                if commandInput.command.emergencyStop
                do deenergizeAllActuators;

            transition first Ready then EmergencyStopped
                accept ControlCommand
                if commandInput.command.emergencyStop
                do deenergizeAllActuators;

            transition first Pumping then EmergencyStopped
                accept ControlCommand
                if commandInput.command.emergencyStop
                do deenergizeAllActuators;

            transition first Fault then Off
                accept ControlCommand
                if not commandInput.command.enablePump
                do resetFaultLatch;
        }

        action regulateMotorSpeed {
            in attribute requested : FlowRate;
            out attribute motorCommandValue : Real;
            first boundFlowRequest;
            then computeHydraulicDemand;
            then commandMotorSpeed;
        }

        action coordinateCylinderStroke {
            first selectDischargeCylinder;
            then commandOppositeCylinderFill;
            then switchSValveAtStrokeEnd;
            then updateDeliveredFlowEstimate;
        }
    }

    part def ConcretePumpSubsystem {
        attribute commandedFlowRate : FlowRate;
        attribute deliveredFlowRate : FlowRate;
        attribute maximumDischargePressure : Pressure = 8000000 [Pa];
        attribute nominalDischargePressure : Pressure = 5000000 [Pa];
        attribute maximumAggregateSize : Length = 0.032 [m];
        attribute nominalStrokeRate : Real = 28.0;
        attribute readyToPump : Boolean;

        port concreteSupply : ConcreteInletPort;
        port concreteDelivery : ConcreteOutletPort;
        port electricalSupply : ElectricalPowerPort;
        port operatorCommand : CommandPort;
        port subsystemStatus : StatusPort;

        part hopper : Hopper;
        part valve : SValve;
        part cylinderA : PumpCylinder;
        part cylinderB : PumpCylinder;
        part hydraulicUnit : HydraulicPowerUnit;
        part motor : DriveMotor;
        part dischargeLine : DischargeLine;
        part pressureSensor : PressureSensor;
        part levelSensor : LevelSensor;
        part controller : PumpController;

        connect concreteSupply to hopper.concreteInput;
        connect hopper.concreteToValve to valve.fromHopper;
        connect valve.toCylinderA to cylinderA.concretePort;
        connect valve.toCylinderB to cylinderB.concretePort;
        connect valve.toDischargeLine to dischargeLine.inlet;
        connect dischargeLine.outlet to concreteDelivery;

        connect electricalSupply to motor.electricInput;
        connect electricalSupply to hydraulicUnit.electricInput;
        connect hydraulicUnit.hydraulicOutput to cylinderA.hydraulicPort;
        connect hydraulicUnit.hydraulicOutput to cylinderB.hydraulicPort;

        connect operatorCommand to controller.commandInput;
        connect controller.statusOutput to subsystemStatus;
        connect controller.motorCommand to motor.speedCommand;
        connect controller.valveCommand to valve.actuatorCommand;
        connect controller.cylinderACommand to cylinderA.pistonCommand;
        connect controller.cylinderBCommand to cylinderB.pistonCommand;

        connect dischargeLine.pressureSignal to controller.pressureFeedback;
        connect pressureSensor.sensingPort to controller.pressureFeedback;
        connect levelSensor.sensingPort to controller.levelFeedback;
        connect motor.speedSignal to controller.motorSpeedFeedback;

        requirement concretePumpFunctionRequirement {
            doc /* The subsystem shall move concrete slurry from the hopper inlet to the discharge outlet using a concrete piston pump. */
            subject subsystem : ConcretePumpSubsystem;
            require constraint { deliveredFlowRate >= commandedFlowRate * 0.90 }
        }

        requirement flowCapacityRequirement {
            doc /* The subsystem shall deliver concrete slurry at an adjustable flow rate from 0.0002 m^3/s to 0.0018 m^3/s. */
            subject subsystem : ConcretePumpSubsystem;
            require constraint {
                deliveredFlowRate >= 0.0002 [m^3/s] and deliveredFlowRate <= 0.0018 [m^3/s]
            }
        }

        requirement pressureCapabilityRequirement {
            doc /* The subsystem shall maintain pumping operation at discharge pressures up to 8 MPa. */
            subject subsystem : ConcretePumpSubsystem;
            require constraint { maximumDischargePressure >= 8000000 [Pa] }
        }

        requirement aggregateCompatibilityRequirement {
            doc /* The subsystem shall pump concrete slurry containing aggregate up to 32 mm nominal size. */
            subject slurry : ConcreteSlurry;
            require constraint { slurry.aggregateSize <= 0.032 [m] }
        }

        requirement noDryRunRequirement {
            doc /* The subsystem shall prevent piston stroking when the hopper level is below the minimum operating level. */
            subject subsystem : ConcretePumpSubsystem;
            require constraint { hopper.currentLevel >= hopper.minimumOperatingLevel implies readyToPump == true }
        }

        requirement emergencyStopRequirement {
            doc /* The subsystem shall remove motor, valve, and cylinder actuator commands within 1 s of emergency stop command receipt. */
            subject controller : PumpController;
            require constraint { true }
        }

        requirement overPressureProtectionRequirement {
            doc /* The subsystem shall transition to Fault and stop concrete displacement when discharge pressure exceeds 8 MPa. */
            subject controller : PumpController;
            require constraint { controller.maximumDischargePressure <= 8000000 [Pa] }
        }

        requirement statusReportingRequirement {
            doc /* The subsystem shall report actual flow rate, discharge pressure, hopper level, motor speed, readiness, and active fault status. */
            subject status : PumpStatus;
            require constraint { true }
        }

        action pumpConcrete {
            in item incomingConcrete : ConcreteSlurry;
            in item command : ControlCommand;
            out item deliveredConcrete : ConcreteSlurry;
            out item status : PumpStatus;

            first receiveConcreteInHopper;
            then verifyHopperLevel;
            then startHydraulicPowerUnit;
            then alternateCylinderStrokes;
            then routeConcreteThroughSValve;
            then dischargeConcreteToLine;
            then monitorPressureAndFlow;
            then publishSubsystemStatus;
        }

        action alternateCylinderStrokes {
            first fillCylinderAWhileDischargingCylinderB;
            then switchSValveToCylinderA;
            then dischargeCylinderAWhileFillingCylinderB;
            then switchSValveToCylinderB;
        }

        state def SubsystemOperatingStates {
            state Deenergized;
            state Standby;
            state PumpingConcrete;
            state ReverseClearing;
            state PressureFault;
            state LowHopperFault;
            state EmergencyStop;

            transition first Deenergized then Standby
                accept ControlCommand
                if operatorCommand.command.enablePump and not operatorCommand.command.emergencyStop;

            transition first Standby then PumpingConcrete
                accept ControlCommand
                if operatorCommand.command.requestedFlowRate > 0.0 [m^3/s];

            transition first PumpingConcrete then ReverseClearing
                accept ControlCommand
                if operatorCommand.command.reverseStroke;

            transition first ReverseClearing then Standby
                accept after 2 [s];

            transition first PumpingConcrete then PressureFault
                if dischargeLine.actualPressure > maximumDischargePressure;

            transition first PumpingConcrete then LowHopperFault
                if hopper.currentLevel < hopper.minimumOperatingLevel;

            transition first Standby then EmergencyStop
                accept ControlCommand
                if operatorCommand.command.emergencyStop;

            transition first PumpingConcrete then EmergencyStop
                accept ControlCommand
                if operatorCommand.command.emergencyStop;

            transition first PressureFault then Deenergized
                accept ControlCommand
                if not operatorCommand.command.enablePump;

            transition first LowHopperFault then Standby
                accept ControlCommand
                if hopper.currentLevel >= hopper.minimumOperatingLevel;
        }
    }

    part concretePumpSubsystem : ConcretePumpSubsystem {
        attribute commandedFlowRate = 0.0012 [m^3/s];
        attribute deliveredFlowRate = 0.00115 [m^3/s];
        attribute readyToPump = true;
    }
}
