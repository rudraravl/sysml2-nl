    value type Volume :> ISQ::volume {
        unit = SI::millilitre;
    }

    value type Force :> ISQ::force {
        unit = SI::newton;
    }

    value type Pressure :> ISQ::pressure {
        unit = SI::kilopascal;
    }

    value type Time :> ISQ::time {
        unit = SI::second;
